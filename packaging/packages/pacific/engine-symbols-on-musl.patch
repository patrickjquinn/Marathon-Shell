Look up the engine's wpe_sfos_* entry points in libWPEWebKit itself.

Qt loads the WebView plugin RTLD_LOCAL, and musl's dlsym(RTLD_DEFAULT)
only searches the global scope, which a local dlopen's dependencies never
join: every lookup came back null on Marathon, so pinch zoom, safe-area
and obscured insets, dark mode, sensors and the clipboard hook were off.

diff --git a/shoal/pacific/webview/src/bridges.cpp b/shoal/pacific/webview/src/bridges.cpp
index 45b7db36..215febd0 100644
--- a/shoal/pacific/webview/src/bridges.cpp
+++ b/shoal/pacific/webview/src/bridges.cpp
@@ -114,9 +114,9 @@ const SensorAbi& sensorAbi()
 {
     static const SensorAbi abi = [] {
         SensorAbi a;
-        a.setCallback = reinterpret_cast<SetSensorsCallbackFn>(dlsym(RTLD_DEFAULT, "wpe_sfos_set_device_sensors_callback"));
-        a.orientation = reinterpret_cast<OrientationChangedFn>(dlsym(RTLD_DEFAULT, "wpe_sfos_device_orientation_changed"));
-        a.motion = reinterpret_cast<MotionChangedFn>(dlsym(RTLD_DEFAULT, "wpe_sfos_device_motion_changed"));
+        a.setCallback = reinterpret_cast<SetSensorsCallbackFn>(engineSymbol("wpe_sfos_set_device_sensors_callback"));
+        a.orientation = reinterpret_cast<OrientationChangedFn>(engineSymbol("wpe_sfos_device_orientation_changed"));
+        a.motion = reinterpret_cast<MotionChangedFn>(engineSymbol("wpe_sfos_device_motion_changed"));
         if (!a.setCallback || !a.orientation || !a.motion)
             a = SensorAbi();
         return a;
@@ -300,7 +300,7 @@ bool ClipboardBridge::ensure()
         if (qEnvironmentVariableIntValue("PACIFIC_DISABLE_CLIPBOARD_BRIDGE") == 1)
             return false;
         using HookFn = void (*)(void (*)(const char*));
-        auto hook = reinterpret_cast<HookFn>(dlsym(RTLD_DEFAULT, "wpe_qt_set_clipboard_write_hook"));
+        auto hook = reinterpret_cast<HookFn>(engineSymbol("wpe_qt_set_clipboard_write_hook"));
         if (!hook)
             return false;
         // Called on the GUI thread, where the pasteboard IPC is dispatched.
diff --git a/shoal/pacific/webview/src/bridges.h b/shoal/pacific/webview/src/bridges.h
index 4b8b63ab..1b74f916 100644
--- a/shoal/pacific/webview/src/bridges.h
+++ b/shoal/pacific/webview/src/bridges.h
@@ -18,8 +18,17 @@
 
 #include <QObject>
 
+#include <dlfcn.h>
 #include <wpe/webkit.h>
 
+// An engine entry point. Qt loads this plugin RTLD_LOCAL, and musl's
+// RTLD_DEFAULT does not search the libraries it brought in.
+inline void* engineSymbol(const char* name)
+{
+    static void* const engine = dlopen("libWPEWebKit-2.0.so.1", RTLD_NOW | RTLD_NOLOAD);
+    return dlsym(engine ? engine : RTLD_DEFAULT, name);
+}
+
 class QGeoPositionInfo;
 class QGeoPositionInfoSource;
 class QAccelerometer;
