From 9b7d20604a19e3222a43d8391fa17c6d79887d54 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:26:34 +0000
Subject: [PATCH 079/214] dt-bindings: mfd: mediatek,mt6363: Add MT6369

The MT6369 is the second SPMI PMIC on MT6858 phones (codec, accessory
detection and the LDOs for the vibrator, fingerprint sensor and SD card).
Add it, with a regulators child described by its own binding, of which
the vibrator LDO so far.
---
 .../bindings/mfd/mediatek,mt6363.yaml         |  6 ++++
 .../regulator/mediatek,mt6369-regulator.yaml  | 29 +++++++++++++++++++
 2 files changed, 35 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/mediatek,mt6369-regulator.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
index c418391e4..78d529ada 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
@@ -30,6 +30,7 @@ properties:
   compatible:
     enum:
       - mediatek,mt6363
+      - mediatek,mt6369
       - mediatek,mt6373
 
   reg:
@@ -58,7 +59,12 @@ patternProperties:
     type: object
     $ref: /schemas/input/mediatek,pmic-keys.yaml#
 
+  "^regulators$":
+    type: object
+    $ref: /schemas/regulator/mediatek,mt6369-regulator.yaml#
+
   "^regulators@[0-9a-f]+$":
+
     type: object
     oneOf:
       - $ref: /schemas/regulator/mediatek,mt6363-regulator.yaml#
diff --git a/Documentation/devicetree/bindings/regulator/mediatek,mt6369-regulator.yaml b/Documentation/devicetree/bindings/regulator/mediatek,mt6369-regulator.yaml
new file mode 100644
index 000000000..2bf81b3a0
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/mediatek,mt6369-regulator.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/mediatek,mt6369-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6369 PMIC Regulators
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The MT6369 is the second SPMI PMIC of MT6858 phones. Its LDOs are
+  children of the PMIC node; only the vibrator LDO is described so far.
+
+properties:
+  compatible:
+    const: mediatek,mt6369-regulator
+
+patternProperties:
+  "^vibr$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+
+additionalProperties: false
-- 
2.55.0

