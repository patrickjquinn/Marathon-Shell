From 92de4bc013234ae7c2ae49f9338768be62040720 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 21:50:15 +0000
Subject: [PATCH 220/231] arm64: dts: mediatek: mt6858-jolla-jp2601: Release
 the I2S1 pull-downs when on

The off state pulls the I2S1 pads down, and the on state only changed
their function, so the pull-downs stayed on the BCK and LRCK lines to
both amplifiers while I2S ran. Take the stock on state: Schmitt inputs
and no bias.
---
 arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 962d3e4f5..afb906a85 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -1051,6 +1051,8 @@ pins-i2s1 {
 				 <PINMUX_GPIO42__FUNC_I2SIN1_LRCK>,
 				 <PINMUX_GPIO43__FUNC_I2SOUT1_DO>,
 				 <PINMUX_GPIO44__FUNC_I2SIN1_DI>;
+			input-schmitt-enable;
+			bias-disable;
 		};
 	};
 
