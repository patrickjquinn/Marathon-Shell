From 44dd57a548090740ec951a60f1ef4e0604b7a010 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 22:50:32 +0000
Subject: [PATCH 198/214] dt-bindings: clock: Add the MediaTek MT6685 clock
 buffers

The MT6685 PMIC buffers the 26 MHz crystal to the other chips on the
board. The MT6369 audio codec on the Jolla Phone (2026) runs from its
XO_BBCK5 output, which software must switch on before the codec's
audio clocks run.

The indices follow the xo-id numbering of MediaTek's downstream device
trees, so a buffer keeps the number board files already use for it.
---
 .../clock/mediatek,mt6685-clkbuf.yaml         | 40 +++++++++++++++++++
 .../clock/mediatek,mt6685-clkbuf.h            | 24 +++++++++++
 2 files changed, 64 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/mediatek,mt6685-clkbuf.yaml
 create mode 100644 include/dt-bindings/clock/mediatek,mt6685-clkbuf.h

diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6685-clkbuf.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6685-clkbuf.yaml
new file mode 100644
index 000000000..296223852
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6685-clkbuf.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6685-clkbuf.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6685 clock buffers
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description: |
+  The MT6685 PMIC buffers its 26 MHz crystal oscillator to the other chips
+  on the board, such as the SoC, the modem and the audio codec. Each buffer
+  output is either switched by a hardware request line or by software.
+
+  This node is a child of the MT6685 SPMI PMIC node, described in
+  Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml.
+
+  The clock indices are in include/dt-bindings/clock/mediatek,mt6685-clkbuf.h.
+
+properties:
+  compatible:
+    const: mediatek,mt6685-clkbuf
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller {
+      compatible = "mediatek,mt6685-clkbuf";
+      #clock-cells = <1>;
+    };
diff --git a/include/dt-bindings/clock/mediatek,mt6685-clkbuf.h b/include/dt-bindings/clock/mediatek,mt6685-clkbuf.h
new file mode 100644
index 000000000..3675ec17f
--- /dev/null
+++ b/include/dt-bindings/clock/mediatek,mt6685-clkbuf.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2026 Patrick Quinn <patrick.jm.quinn@gmail.com>
+ */
+
+#ifndef _DT_BINDINGS_CLK_MEDIATEK_MT6685_CLKBUF_H
+#define _DT_BINDINGS_CLK_MEDIATEK_MT6685_CLKBUF_H
+
+/* The 26 MHz crystal oscillator buffer outputs */
+#define MT6685_CLK_XO_BBCK1		0
+#define MT6685_CLK_XO_BBCK2		1
+#define MT6685_CLK_XO_BBCK3		2
+#define MT6685_CLK_XO_BBCK4		3
+#define MT6685_CLK_XO_BBCK5		4
+#define MT6685_CLK_XO_RFCK1A		5
+#define MT6685_CLK_XO_RFCK1B		6
+#define MT6685_CLK_XO_RFCK1C		7
+#define MT6685_CLK_XO_RFCK2A		8
+#define MT6685_CLK_XO_RFCK2B		9
+#define MT6685_CLK_XO_RFCK2C		10
+#define MT6685_CLK_XO_CONCK1		11
+#define MT6685_CLK_XO_CONCK2		12
+
+#endif
