From 4edcaf3ab1646cf25c52530e59eeef8d2b1f3667 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 18:07:37 +0000
Subject: [PATCH 012/165] arm64: configs: Add an MT6858 first-boot fragment

The arm64 defconfig builds the MT6858 pinctrl and power domains but
leaves the XS-PHY, UFS PHY, watchdog, simpledrm and ramoops out or as
modules, and builds DRM and USB configfs as modules. A first boot on an
MT6858 phone has no module-loading root and, on most boards, no UART,
so build in what it takes to reach an initramfs with a USB ACM or NCM
console, a console on LK's framebuffer and a log in ramoops.

simpledrm rather than simplefb drives the framebuffer so that userspace
gets a KMS device before the display pipeline is supported.

Use it as: make defconfig mt6858.config

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/configs/mt6858.config | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)
 create mode 100644 arch/arm64/configs/mt6858.config

diff --git a/arch/arm64/configs/mt6858.config b/arch/arm64/configs/mt6858.config
new file mode 100644
index 000000000..d80ec12f9
--- /dev/null
+++ b/arch/arm64/configs/mt6858.config
@@ -0,0 +1,30 @@
+# MT6858 first-boot fragment: make defconfig mt6858.config
+# Everything needed to reach an initramfs with a USB console is built in.
+CONFIG_ARCH_MEDIATEK=y
+CONFIG_PINCTRL_MT6858=y
+CONFIG_MTK_SCPSYS_PM_DOMAINS=y
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_8250_MT6577=y
+CONFIG_SERIAL_EARLYCON=y
+CONFIG_WATCHDOG=y
+CONFIG_MEDIATEK_WATCHDOG=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_DRM=y
+CONFIG_DRM_SIMPLEDRM=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_SCSI_UFSHCD=y
+CONFIG_SCSI_UFSHCD_PLATFORM=y
+CONFIG_SCSI_UFS_MEDIATEK=y
+CONFIG_PHY_MTK_UFS=y
+CONFIG_USB_MTU3=y
+CONFIG_PHY_MTK_XSPHY=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_ACM=y
+CONFIG_USB_CONFIGFS_NCM=y
+CONFIG_PSTORE=y
+CONFIG_PSTORE_RAM=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
