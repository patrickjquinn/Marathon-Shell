From c5ef59ab91b83e1d422b2915a649e160601929be Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 02:58:27 +0000
Subject: [PATCH 229/231] ASoC: dt-bindings: Add the MediaTek MT6369 codec

The MT6369 PMIC's audio codec takes its 26 MHz from a clock-buffer
output and needs the type of each of its three microphone inputs, as
the MT6359's does. It is a child of the MT6369 node.
---
 .../bindings/mfd/mediatek,mt6363.yaml         |  4 ++
 .../bindings/sound/mediatek,mt6369-codec.yaml | 53 +++++++++++++++++++
 2 files changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6369-codec.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
index f8415bb5c..f6d0310a6 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
@@ -56,6 +56,10 @@ patternProperties:
     type: object
     $ref: /schemas/iio/adc/mediatek,mt6359-auxadc.yaml#
 
+  "^audio-codec$":
+    type: object
+    $ref: /schemas/sound/mediatek,mt6369-codec.yaml#
+
   "^clock-controller$":
     type: object
     $ref: /schemas/clock/mediatek,mt6685-clkbuf.yaml#
diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6369-codec.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6369-codec.yaml
new file mode 100644
index 000000000..d1eeae421
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6369-codec.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6369-codec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6369 audio codec
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The audio codec of the MT6369 PMIC, connected to the SoC's audio front
+  end over MTKAIF. It is a child of the MT6369 node, described in
+  Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml.
+
+properties:
+  compatible:
+    const: mediatek,mt6369-codec
+
+  clocks:
+    items:
+      - description: The 26 MHz clock-buffer output the codec runs on
+
+  mediatek,mic-type:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      The microphone type on AIN0, AIN1 and AIN2. 0 is idle, 1 ACC, 2 DMIC,
+      3 DCC, 4 DCC with an ECM differential input and 5 DCC with an ECM
+      single-ended input.
+    minItems: 3
+    maxItems: 3
+    items:
+      maximum: 5
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - clocks
+  - '#sound-dai-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    audio-codec {
+      compatible = "mediatek,mt6369-codec";
+      clocks = <&mt6685_clkbuf 4>;
+      mediatek,mic-type = <1 1 1>;
+      #sound-dai-cells = <0>;
+    };
-- 
