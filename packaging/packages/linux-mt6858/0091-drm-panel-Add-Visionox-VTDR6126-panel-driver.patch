+
+/* In power-on order; vsp follows vsn after a longer delay in prepare(). */
+static const struct regulator_bulk_data visionox_vtdr6126_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vsn" },
+	{ .supply = "vsp" },
+};
+
+static inline struct visionox_vtdr6126 *to_visionox_vtdr6126(struct drm_panel *panel)
+{
+	return container_of(panel, struct visionox_vtdr6126, panel);
+}
