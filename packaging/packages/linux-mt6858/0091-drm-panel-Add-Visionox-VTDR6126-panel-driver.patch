+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xc3, 0x11, 0x08, 0x40, 0x20,
+					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+					 0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xe0, 0x31, 0x8a, 0x41, 0x85,
+					 0x05, 0x12, 0x0a, 0x13, 0x04, 0xa0,
+					 0x22, 0x16, 0xf9, 0x52, 0xf9);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xe1, 0xdf, 0x7d, 0xff, 0xb9,
+					 0xcd, 0x62, 0xd5, 0x07, 0x2e, 0x2e,
+					 0x53, 0xd4, 0xf5, 0x3a, 0x55);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xe2, 0xcf, 0x3f, 0x5a, 0xd6,
+					 0x93, 0x96, 0x2d, 0x4d, 0x5e, 0x78,
