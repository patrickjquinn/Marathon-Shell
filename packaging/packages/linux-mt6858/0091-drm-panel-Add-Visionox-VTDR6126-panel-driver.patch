+	return dsi_ctx.accum_err;
+}
+
+static void visionox_vtdr6126_off(struct visionox_vtdr6126 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+}
+
+static int visionox_vtdr6126_prepare(struct drm_panel *panel)
+{
+	struct visionox_vtdr6126 *ctx = to_visionox_vtdr6126(panel);
+	int ret;
+
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret)
+		return ret;
+	usleep_range(5000, 6000);
+
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret)
+		goto err_vddio;
+	usleep_range(5000, 6000);
+
+	ret = regulator_enable(ctx->supplies[2].consumer);
+	if (ret)
+		goto err_vsn;
+	usleep_range(10000, 15000);
+
+	visionox_vtdr6126_reset(ctx);
+
+	ret = visionox_vtdr6126_on(ctx);
+	if (ret) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		goto err_vsp;
+	}
+
+	return 0;
+
+err_vsp:
+	regulator_disable(ctx->supplies[2].consumer);
+err_vsn:
+	regulator_disable(ctx->supplies[1].consumer);
+err_vddio:
+	regulator_disable(ctx->supplies[0].consumer);
+	return ret;
+}
+
+static int visionox_vtdr6126_unprepare(struct drm_panel *panel)
+{
+	struct visionox_vtdr6126 *ctx = to_visionox_vtdr6126(panel);
+
+	visionox_vtdr6126_off(ctx);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+	regulator_disable(ctx->supplies[2].consumer);
+	usleep_range(5000, 6000);
+	regulator_disable(ctx->supplies[1].consumer);
+	usleep_range(5000, 6000);
+	regulator_disable(ctx->supplies[0].consumer);
+
+	return 0;
+}
+
+/*
+ * One line clock for both rates: 90 Hz shortens the vertical front porch
+ * (and the panel is told with DCS 6Ch).
+ */
+static const struct drm_display_mode visionox_vtdr6126_modes[] = {
+	{
+		.clock = 336839,
+		.hdisplay = 1032,
+		.hsync_start = 1032 + 156,
+		.hsync_end = 1032 + 156 + 4,
+		.htotal = 1032 + 156 + 4 + 20,
+		.vdisplay = 2272,
+		.vsync_start = 2272 + 2336,
+		.vsync_end = 2272 + 2336 + 4,
+		.vtotal = 2272 + 2336 + 4 + 20,
+		.width_mm = 66,
+		.height_mm = 159,
+	},
+	{
+		.clock = 336839,
+		.hdisplay = 1032,
+		.hsync_start = 1032 + 156,
+		.hsync_end = 1032 + 156 + 4,
+		.htotal = 1032 + 156 + 4 + 20,
+		.vdisplay = 2272,
+		.vsync_start = 2272 + 792,
+		.vsync_end = 2272 + 792 + 4,
+		.vtotal = 2272 + 792 + 4 + 20,
+		.width_mm = 66,
+		.height_mm = 159,
+	},
+};
+
+static int visionox_vtdr6126_get_modes(struct drm_panel *panel,
+				       struct drm_connector *connector)
+{
+	const struct drm_display_mode *m = &visionox_vtdr6126_modes[refresh == 90];
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, m);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs visionox_vtdr6126_panel_funcs = {
+	.prepare = visionox_vtdr6126_prepare,
+	.unprepare = visionox_vtdr6126_unprepare,
+	.get_modes = visionox_vtdr6126_get_modes,
+};
+
+static int visionox_vtdr6126_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+
+	return mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+}
+
+static const struct backlight_ops visionox_vtdr6126_bl_ops = {
+	.update_status = visionox_vtdr6126_bl_update_status,
+};
+
+static int visionox_vtdr6126_probe(struct mipi_dsi_device *dsi)
+{
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 2047,
+		.max_brightness = 4095,
+	};
+	struct device *dev = &dsi->dev;
+	struct visionox_vtdr6126 *ctx;
+	int ret;
+
+	if (refresh != 60 && refresh != 90)
+		return dev_err_probe(dev, -EINVAL, "refresh must be 60 or 90\n");
+
+	ctx = devm_drm_panel_alloc(dev, struct visionox_vtdr6126, panel,
+				   &visionox_vtdr6126_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(visionox_vtdr6126_supplies),
+					    visionox_vtdr6126_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	/* Left as the bootloader set it: the panel may still be scanning out */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->dsc = visionox_vtdr6126_dsc;
+	dsi->dsc = &ctx->dsc;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET;
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							      dev, dsi,
+							      &visionox_vtdr6126_bl_ops,
+							      &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret)
+		return ret;
+
+	return devm_mipi_dsi_attach(dev, dsi);
+}
+
+static const struct of_device_id visionox_vtdr6126_of_match[] = {
+	{ .compatible = "visionox,vtdr6126" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, visionox_vtdr6126_of_match);
+
+static struct mipi_dsi_driver visionox_vtdr6126_driver = {
+	.probe = visionox_vtdr6126_probe,
+	.driver = {
+		.name = "panel-visionox-vtdr6126",
+		.of_match_table = visionox_vtdr6126_of_match,
+	},
+};
+module_mipi_dsi_driver(visionox_vtdr6126_driver);
+
+MODULE_DESCRIPTION("Panel driver for the Visionox VTDR6126 AMOLED DSI panel");
+MODULE_LICENSE("GPL");
