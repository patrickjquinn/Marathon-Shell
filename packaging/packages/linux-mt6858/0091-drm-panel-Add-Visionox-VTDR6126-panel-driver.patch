+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x65, 0x0a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf9, 0xa8);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0x81);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x65, 0x02);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf4, 0x27);
