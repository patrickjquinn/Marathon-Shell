From 503a24adbac11963749a1e0f4a04ad13b86560a4 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 03:04:28 +0000
Subject: [PATCH 232/237] dt-bindings: leds: Add the Awinic AW36515 flash LED
 driver

The AW36515 drives one flash LED from one or both of its current
sources over I2C. The LED node says which sources it is on and its
torch, flash and timeout limits.
---
 .../bindings/leds/awinic,aw36515.yaml         | 83 +++++++++++++++++++
 1 file changed, 83 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/awinic,aw36515.yaml

diff --git a/Documentation/devicetree/bindings/leds/awinic,aw36515.yaml b/Documentation/devicetree/bindings/leds/awinic,aw36515.yaml
new file mode 100644
index 000000000..070878e89
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/awinic,aw36515.yaml
@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/awinic,aw36515.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW36515 dual flash LED driver
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The AW36515 drives a flash LED from two current sources, each up to
+  2 A in flash and 500 mA in torch mode, through a boost converter. It is
+  controlled over I2C.
+
+properties:
+  compatible:
+    const: awinic,aw36515
+
+  reg:
+    maxItems: 1
+
+  led:
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      led-sources:
+        description: The current sources the LED is on, LED1 (0) and LED2 (1).
+        minItems: 1
+        maxItems: 2
+        items:
+          enum: [0, 1]
+
+      led-max-microamp:
+        minimum: 980
+        maximum: 500000
+
+      flash-max-microamp:
+        minimum: 3910
+        maximum: 2000000
+
+      flash-max-timeout-us:
+        minimum: 40000
+        maximum: 1600000
+
+    required:
+      - led-sources
+      - led-max-microamp
+      - flash-max-microamp
+      - flash-max-timeout-us
+
+required:
+  - compatible
+  - reg
+  - led
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/leds/common.h>
+
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      flash-led@63 {
+        compatible = "awinic,aw36515";
+        reg = <0x63>;
+
+        led {
+          function = LED_FUNCTION_FLASH;
+          color = <LED_COLOR_ID_WHITE>;
+          led-sources = <0>, <1>;
+          led-max-microamp = <100000>;
+          flash-max-microamp = <1000000>;
+          flash-max-timeout-us = <600000>;
+        };
+      };
+    };
-- 
