From 6abd454a23daf81fa044b23e297f6a952d5d42cc Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 11:48:31 +0000
Subject: [PATCH 274/286] media: dt-bindings: Add the Sony IMX616 image sensor

The IMX616 is a 32 MP quad Bayer sensor with four D-PHY data lanes,
the front camera of the Jolla Phone JP2601.
---
 .../bindings/media/i2c/sony,imx616.yaml       | 109 ++++++++++++++++++
 1 file changed, 109 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml
new file mode 100644
index 000000000..b13234ddd
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx616.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX616 32MP CMOS Digital Image Sensor
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The IMX616 is a Sony quad Bayer CMOS image sensor with an active array of
+  6560x4928 pixels, programmable over I2C. Image data is sent over MIPI CSI-2,
+  on four D-PHY data lanes.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx616
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: INCK, 24 MHz
+    maxItems: 1
+
+  reset-gpios:
+    description: XCLR, active low
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue power supply (2.9 V)
+
+  dvdd-supply:
+    description: Digital core power supply (1.1 V)
+
+  dovdd-supply:
+    description: Digital I/O power supply (1.8 V)
+
+  port:
+    additionalProperties: false
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/media/video-interfaces.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx616";
+            reg = <0x1a>;
+            clocks = <&camtg>;
+            reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&cam_avdd>;
+            dvdd-supply = <&cam_dvdd>;
+            dovdd-supply = <&cam_dovdd>;
+            orientation = <0>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <426947368>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
+...
-- 
2.55.0

