From f2a34448c73104ff788e182fd26e5b9a46af8d83 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 22:44:04 +0000
Subject: [PATCH 018/202] arm64: dts: mediatek: mt6858-jolla-jp2601: Force VBUS
 in the USB PHY

VBUS reaches the charger and the Type-C controller, not the U2 PHY:
without mediatek,force-vbus on the port the gadget never connects.
---
 arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index c20a2ce35..af040a810 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -297,3 +297,8 @@ &ufsphy {
 &xsphy {
 	status = "okay";
 };
+
+&u2port0 {
+	/* VBUS reaches the charger and Type-C controller, not the PHY. */
+	mediatek,force-vbus;
+};
-- 
