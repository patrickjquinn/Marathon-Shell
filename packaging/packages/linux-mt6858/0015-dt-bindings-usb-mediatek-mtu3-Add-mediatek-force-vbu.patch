From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 20:33:09 +0000
Subject: [PATCH 15/17] dt-bindings: usb: mediatek,mtu3: Add
 mediatek,force-vbus

On some phones VBUS is not wired to the SSUSB block's VBUS detection:
the charger and the Type-C controller sense it. The controller then never
sees VBUS valid and, as a device, never connects. Add a property that
says so, as MediaTek's own trees for these SoCs do.
---
 Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
index 353366c57..5ddf1fd1e 100644
--- a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
+++ b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
@@ -212,6 +212,12 @@ properties:
     description: The mask to disable u3ports, bit0 for u3port0,
       bit1 for u3port1, ... etc
 
+  mediatek,force-vbus:
+    type: boolean
+    description: VBUS is not wired to the controller's VBUS detection (a
+      charger or Type-C controller senses it instead), so the controller
+      has to be told that VBUS is valid when it works as a device.
+
   mediatek,u2p-dis-msk:
     $ref: /schemas/types.yaml#/definitions/uint32
     description: The mask to disable u2ports, bit0 for u2port0,
