From 10bdfcd3ed531e51a39cf1a54cb74ec713ca1041 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 11:53:17 +0000
Subject: [PATCH 148/206] drm/mediatek: mtk_dsi: Program MT6858 DSI0 like the
 bootloader

Three MT6858 DSI0 settings differ from what the bootloader leaves for
the panel it lights (JP2601, VTDR6126 at 880 Mbit/s per lane):

- D-PHY timings: the mainline formulas give TIMECON0-3 = 0a0b0907
  0f1c091a 071c0100 000e0f07, the bootloader 0a0d0709 0d2d0d24 0a1e0100
  000d0e07 (longer LPX, HS-zero, turnaround and clock-zero).
- DSI_HSTX_CKL_WC (0x64): the per-frame-LP formula gives 0x190, the
  bootloader 0x10000, beyond the field mainline assumes.
- DSI_TXRX_CTRL[23:20]: the vendor driver sets 1 before starting video
  on this SoC (0x0011003c); mainline leaves it 0.

Let the SoC data supply fixed PHY timings, a fixed clock-lane word count
and the TXRX field for video, and give MT6858 the bootloader's values.
The timing-derived video registers (HS_VB_PS_WC) then follow the fixed
timings too.
---
 drivers/gpu/drm/mediatek/mtk_dsi.c | 36 ++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
index 35030e64b..cca95fbd9 100644
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -70,6 +70,7 @@
 #define EXT_TE_EDGE			BIT(10)
 #define MAX_RTN_SIZE			GENMASK(15, 12)
 #define HSTX_CKLP_EN			BIT(16)
+#define TXRX_VDO_SEL			GENMASK(23, 20)
 
 #define DSI_PSCTRL		0x1c
 #define DSI_PS_WC			GENMASK(13, 0)
@@ -199,6 +200,10 @@ struct mtk_dsi_driver_data {
 	bool cmdq_long_packet_ctl;
 	bool support_per_frame_lp;
 	bool dsc_ps_dt;
+	/* Fixed D-PHY timings and clock lane word count instead of computed */
+	const struct mtk_phy_timing *phy_timing;
+	u32 hstx_ckl_wc;
+	u32 vdo_txrx_sel;
 };
 
 struct mtk_dsi {
@@ -255,6 +260,11 @@ static void mtk_dsi_phy_timconfig(struct mtk_dsi *dsi)
 	u32 data_rate_mhz = DIV_ROUND_UP(dsi->data_rate, HZ_PER_MHZ);
 	struct mtk_phy_timing *timing = &dsi->phy_timing;
 
+	if (dsi->driver_data->phy_timing) {
+		*timing = *dsi->driver_data->phy_timing;
+		goto write;
+	}
+
 	timing->lpx = (60 * data_rate_mhz / (8 * 1000)) + 1;
 	timing->da_hs_prepare = (80 * data_rate_mhz + 4 * 1000) / 8000;
 	timing->da_hs_zero = (170 * data_rate_mhz + 10 * 1000) / 8000 + 1 -
@@ -272,6 +282,7 @@ static void mtk_dsi_phy_timconfig(struct mtk_dsi *dsi)
 	timing->clk_hs_zero = timing->clk_hs_trail * 4;
 	timing->clk_hs_exit = 2 * timing->clk_hs_trail;
 
+write:
 	timcon0 = FIELD_PREP(LPX, timing->lpx) |
 		  FIELD_PREP(HS_PREP, timing->da_hs_prepare) |
 		  FIELD_PREP(HS_ZERO, timing->da_hs_zero) |
@@ -545,6 +556,8 @@ static void mtk_dsi_config_vdo_timing_per_frame_lp(struct mtk_dsi *dsi)
 			   ps_wc), dsi->lanes) + da_hs_trail + 1) * dsi->lanes / 6 - 1;
 
 	hstx_cklp_wc = FIELD_PREP(HSTX_CKL_WC, (hstx_cklp_wc_min + hstx_cklp_wc_max) / 2);
+	if (dsi->driver_data->hstx_ckl_wc)
+		hstx_cklp_wc = dsi->driver_data->hstx_ckl_wc;
 	writel(hstx_cklp_wc, dsi->regs + DSI_HSTX_CKL_WC);
 
 	hs_vb_ps_wc = ps_wc - (dsi->phy_timing.lpx + dsi->phy_timing.da_hs_exit +
@@ -911,6 +924,9 @@ static void mtk_output_dsi_enable(struct mtk_dsi *dsi)
 	if (dsi->enabled)
 		return;
 
+	if (dsi->driver_data->vdo_txrx_sel)
+		mtk_dsi_mask(dsi, DSI_TXRX_CTRL, TXRX_VDO_SEL,
+			     FIELD_PREP(TXRX_VDO_SEL, dsi->driver_data->vdo_txrx_sel));
 	mtk_dsi_set_mode(dsi);
 	mtk_dsi_start(dsi);
 
@@ -1426,6 +1442,23 @@ static void mtk_dsi_remove(struct platform_device *pdev)
 	mipi_dsi_host_unregister(&dsi->host);
 }
 
+/* The bootloader's values for the 880 Mbit/s lanes of the JP2601 panel */
+static const struct mtk_phy_timing mt6858_phy_timing = {
+	.lpx = 9,
+	.da_hs_prepare = 7,
+	.da_hs_zero = 13,
+	.da_hs_trail = 10,
+	.ta_go = 36,
+	.ta_sure = 13,
+	.ta_get = 45,
+	.da_hs_exit = 13,
+	.clk_hs_zero = 30,
+	.clk_hs_trail = 10,
+	.clk_hs_prepare = 7,
+	.clk_hs_post = 14,
+	.clk_hs_exit = 13,
+};
+
 static const struct mtk_dsi_driver_data mt6858_dsi_driver_data = {
 	.reg_cmdq_off = 0xd00,
 	.reg_vm_cmd_off = 0x200,
@@ -1435,6 +1468,9 @@ static const struct mtk_dsi_driver_data mt6858_dsi_driver_data = {
 	.cmdq_long_packet_ctl = true,
 	.support_per_frame_lp = true,
 	.dsc_ps_dt = true,
+	.phy_timing = &mt6858_phy_timing,
+	.hstx_ckl_wc = 0x10000,
+	.vdo_txrx_sel = 1,
 };
 
 static const struct mtk_dsi_driver_data mt8173_dsi_driver_data = {
-- 
