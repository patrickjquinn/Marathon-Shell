+			reg = <0 0x11c01000 0 0x1000>,
+			      <0 0x11300780 0 0x100>;
+			interrupts = <GIC_SPI 601 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&impes CLK_IMPES_I2C7>, <&pericfg_ao CLK_PERAO_P_DMA_B>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
