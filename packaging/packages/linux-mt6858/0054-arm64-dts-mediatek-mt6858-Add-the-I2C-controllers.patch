From 211c0b48e807827d6e77a6e9cf69b32014e14d35 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 06:56:30 +0000
Subject: [PATCH 054/181] arm64: dts: mediatek: mt6858: Add the I2C controllers

Add the twelve plain I2C controllers and their imp_iic_wrap clock
controllers, with the addresses, interrupts and AP DMA channels of the
vendor device tree. I2C0 (0x11d00000) is an I3C controller and is left
out.
---
 arch/arm64/boot/dts/mediatek/mt6858.dtsi | 174 +++++++++++++++++++++++
 1 file changed, 174 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858.dtsi b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
index c40116bb5..3a02b4189 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
@@ -407,6 +407,90 @@ ssusb: usb@11201000 {
 			status = "disabled";
 		};
 
+		i2c1: i2c@11280000 {
+			compatible = "mediatek,mt6858-i2c", "mediatek,mt8188-i2c";
+			reg = <0 0x11280000 0 0x1000>,
+			      <0 0x11300380 0 0x80>;
+			interrupts = <GIC_SPI 595 IRQ_TYPE_LEVEL_HIGH 0>;
+			clocks = <&impc CLK_IMPC_I2C1>, <&pericfg_ao CLK_PERAO_P_DMA_B>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		i2c3: i2c@11281000 {
+			compatible = "mediatek,mt6858-i2c", "mediatek,mt8188-i2c";
