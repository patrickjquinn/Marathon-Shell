+			compatible = "mediatek,mt6858-imp-iic-wrap-c", "syscon";
+			reg = <0 0x11286000 0 0x1000>;
+			#clock-cells = <1>;
+		};
+
 		ufsphy: ufs-phy@112a0000 {
 			compatible = "mediatek,mt8183-ufsphy";
 			reg = <0 0x112a0000 0 0x10000>;
@@ -428,6 +512,96 @@ ufshci: ufshci@112b0000 {
 			status = "disabled";
 		};
 
