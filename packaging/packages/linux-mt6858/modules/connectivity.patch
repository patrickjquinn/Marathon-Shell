new file mode 100644
index 0000000..dd06d0b
--- /dev/null
+++ b/connadp/common/connadp.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The part of MediaTek's connectivity adapter (connadp) that the MT6858
+ * conninfra, gen4m and bt_drv modules call. The vendor's version also
+ * bridges to Android-only frameworks (SCP connectivity, CPU boost, MMC,
+ * the MT6306 GPIO expander); those calls do nothing here.
+ * Original (c) 2019 MediaTek Inc.
+ */
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+
+#include "conn_dbg.h"
+#include "connectivity_build_in_adapter.h"
+#include "wmt_build_in_adapter.h"
+
+void connectivity_export_show_stack(struct task_struct *tsk, unsigned long *sp)
+{
+	sched_show_task(tsk);
+}
+EXPORT_SYMBOL(connectivity_export_show_stack);
+
+/* There is no SCP connectivity firmware to tell about CONNSYS. */
+void connectivity_export_conap_scp_init(unsigned int chip_info, phys_addr_t emi_phy_addr)
+{
+}
+EXPORT_SYMBOL(connectivity_export_conap_scp_init);
+
+void connectivity_export_conap_scp_deinit(void)
+{
+}
+EXPORT_SYMBOL(connectivity_export_conap_scp_deinit);
+
+void connectivity_export_conap_scp_trigger_cmd(enum conn_hif_dbg_drv_type drv_type,
+					       enum conn_hif_dbg_cmd cmd, int param)
+{
+}
+EXPORT_SYMBOL(connectivity_export_conap_scp_trigger_cmd);
+
+/*
+ * conninfra registers callbacks here for platform code (thermal, the
+ * Android debug node) that this kernel does not have; keep them anyway.
+ */
+static struct wmt_platform_bridge platform_bridge;
+static const struct wmt_platform_dbg_bridge *platform_dbg_bridge;
+
+void wmt_export_platform_bridge_register(struct wmt_platform_bridge *cb)
+{
+	if (cb)
+		platform_bridge = *cb;
+}
+EXPORT_SYMBOL(wmt_export_platform_bridge_register);
+
+void wmt_export_platform_bridge_unregister(void)
+{
+	memset(&platform_bridge, 0, sizeof(platform_bridge));
+}
+EXPORT_SYMBOL(wmt_export_platform_bridge_unregister);
+
+void wmt_export_platform_dbg_bridge_register(const struct wmt_platform_dbg_bridge *cb)
+{
+	platform_dbg_bridge = cb;
+}
+EXPORT_SYMBOL(wmt_export_platform_dbg_bridge_register);
+
+void wmt_export_platform_dbg_bridge_unregister(void)
+{
+	platform_dbg_bridge = NULL;
+}
+EXPORT_SYMBOL(wmt_export_platform_dbg_bridge_unregister);
+
+/* The vendor keeps these in a debug ring; the kernel log does here. */
+int conn_dbg_add_log(enum conn_dbg_log_type type, const char *buf)
+{
+	pr_info("connsys[%d]: %s\n", type, buf);
+	return 0;
+}
+EXPORT_SYMBOL(conn_dbg_add_log);
+
+MODULE_DESCRIPTION("MediaTek connectivity adapter (MT6858 subset)");
+MODULE_LICENSE("GPL");
