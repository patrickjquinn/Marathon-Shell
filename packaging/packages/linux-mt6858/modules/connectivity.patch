diff --git a/compat/include/mtk_conn_compat.h b/compat/include/mtk_conn_compat.h
new file mode 100644
index 0000000..2818ee8
--- /dev/null
+++ b/compat/include/mtk_conn_compat.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Kernel API changes between the vendor's 6.12 base and 7.4. */
+#ifndef _MTK_CONN_COMPAT_H
+#define _MTK_CONN_COMPAT_H
+
+#include <linux/string.h>
+#include <linux/timer.h>
+
+#ifndef from_timer
+#define from_timer(var, t, field) timer_container_of(var, t, field)
+/* gen4m indicates events through wireless extensions, which 7.4 builds without. */
+#include <net/iw_handler.h>
+#if !IS_ENABLED(CONFIG_WEXT_CORE)
+#define wireless_send_event(dev, cmd, wrqu, extra) \
+	((void)(dev), (void)(cmd), (void)(wrqu), (void)(extra))
+#endif
+
+#endif
+
+/* Vendor SiP calls; the stock TF-A implements them. */
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+#define MTK_SIP_KERNEL_CONNSYS_CONTROL	MTK_SIP_SMC_CMD(0x534)
+#define MTK_SIP_KERNEL_WLAN_CONTROL	MTK_SIP_SMC_CMD(0x535)
+#define MTK_SIP_KERNEL_BT_CONTROL	MTK_SIP_SMC_CMD(0x536)
+#define MTK_SIP_KERNEL_GPS_CONTROL	MTK_SIP_SMC_CMD(0x537)
+
+#define alarm_start(alarm, ktime) alarm_start_timer(alarm, ktime, false)
+#define alarm_start_relative(alarm, ktime) alarm_start_timer(alarm, ktime, true)
+
+/* 7.4 dropped strncpy(); the vendor code relies on its zero padding. */
+static inline char *mtk_compat_strncpy(char *dst, const char *src, size_t n)
+{
+	size_t len = strnlen(src, n);
+
+	memcpy(dst, src, len);
+	memset(dst + len, 0, n - len);
+	return dst;
+}
+#define strncpy mtk_compat_strncpy
+
+/* gen4m indicates events through wireless extensions, which 7.4 builds without. */
+#include <net/iw_handler.h>
+#if !IS_ENABLED(CONFIG_WEXT_CORE)
+#define wireless_send_event(dev, cmd, wrqu, extra) \
+	((void)(dev), (void)(cmd), (void)(wrqu), (void)(extra))
+#endif
+
+#endif
