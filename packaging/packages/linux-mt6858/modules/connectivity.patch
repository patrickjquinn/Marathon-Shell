diff --git a/bt/btmtk_main.c b/bt/btmtk_main.c
index cc2f7aa..23952c5 100644
--- a/bt/btmtk_main.c
+++ b/bt/btmtk_main.c
@@ -3384,6 +3384,22 @@ unsigned long dummy_func(const char *ptr) {
 	return 0;
 }
 
+#if CFG_SUPPORT_BLUEZ
+/* MediaTek's vendor command, as for the MT79xx in drivers/bluetooth/btmtk.c */
+static int bt_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
+{
+	struct sk_buff *skb;
+
+	skb = __hci_cmd_sync(hdev, 0xfc1a, 6, bdaddr, HCI_INIT_TIMEOUT);
+	if (IS_ERR(skb)) {
+		bt_dev_err(hdev, "setting the address failed (%ld)", PTR_ERR(skb));
+		return PTR_ERR(skb);
+	}
+	kfree_skb(skb);
+	return 0;
+}
+#endif
+
 static int bt_open(struct hci_dev *hdev)
 {
 	int ret = -1;
@@ -3758,6 +3774,20 @@ int btmtk_allocate_hci_device(struct btmtk_dev *bdev, int hci_bus_type)
 	hdev->flush    = bt_flush;
 	hdev->send	   = bt_send_frame;
 	hdev->setup    = bt_setup;
+#if CFG_SUPPORT_BLUEZ
+	/*
+	 * The controller sets the synchronization train LMP feature on page 2
+	 * but answers HCI Read Synchronization Train Parameters with "unknown
+	 * command", which fails BlueZ's init. Don't read page 2.
+	 */
+	hci_set_quirk(hdev, HCI_QUIRK_BROKEN_LOCAL_EXT_FEATURES_PAGE_2);
+	/*
+	 * The controller's own address is a placeholder: stay unconfigured
+	 * until user space sets the factory one from the NVRAM.
+	 */
+	hci_set_quirk(hdev, HCI_QUIRK_INVALID_BDADDR);
+	hdev->set_bdaddr = bt_set_bdaddr;
+#endif
 
 	init_waitqueue_head(&bdev->p_wait_event_q);
 
