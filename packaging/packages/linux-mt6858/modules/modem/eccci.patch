diff --git a/compat/linux/of_gpio.h b/compat/linux/of_gpio.h
new file mode 100644
index 0000000..558b710
--- /dev/null
+++ b/compat/linux/of_gpio.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Linux 7.4 dropped of_get_named_gpio(). The modem's RPC asks for GPIO
+ * values by name from the gpio_usage_mapping node (<&pio pin md_pin>), so
+ * resolve the phandle to a global GPIO number here.
+ */
+#ifndef _ECCCI_COMPAT_OF_GPIO_H
+#define _ECCCI_COMPAT_OF_GPIO_H
+#include <linux/errno.h>
+#include <linux/gpio.h>
+#include <linux/gpio/driver.h>
+#include <linux/of.h>
+
+static inline int of_get_named_gpio(const struct device_node *np, const char *name, int index)
+{
+	struct of_phandle_args args;
+	struct gpio_device *gdev;
+	int ret;
+
+	ret = of_parse_phandle_with_fixed_args(np, name, 2, index, &args);
+	if (ret)
+		return ret;
+	gdev = gpio_device_find_by_fwnode(of_fwnode_handle(args.np));
+	of_node_put(args.np);
+	if (!gdev)
+		return -EPROBE_DEFER;
+	ret = gpio_device_get_base(gdev) + args.args[0];
+	gpio_device_put(gdev);
+	return ret;
+}
+#endif
