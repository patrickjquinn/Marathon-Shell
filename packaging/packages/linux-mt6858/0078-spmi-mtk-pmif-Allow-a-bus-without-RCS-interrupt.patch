From 582baa8b5ce45b68adf9b151dff4ed38b3b8fb55 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:25:14 +0000
Subject: [PATCH 078/214] spmi: mtk-pmif: Allow a bus without RCS interrupt

On the MT6858 only SPMI-M has an RCS interrupt; SPMI-P's requests share
it. The driver requires an "rcs" interrupt on every SPMI 2 bus, so
SPMI-P cannot be described without either failing its probe or claiming
SPMI-M's interrupt a second time, which would replace SPMI-M's chained
handler.

Treat a bus with no "rcs" interrupt like an SPMI 1 bus: no interrupt
domain, just register access.
---
 drivers/spmi/spmi-mtk-pmif.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/spmi/spmi-mtk-pmif.c b/drivers/spmi/spmi-mtk-pmif.c
index b1c147c3e..fe2cc7d16 100644
--- a/drivers/spmi/spmi-mtk-pmif.c
+++ b/drivers/spmi/spmi-mtk-pmif.c
@@ -672,8 +672,14 @@ static int mtk_spmi_irq_init(struct device_node *node,
 	struct pmif *arb = to_mtk_pmif(pbus->ctrl);
 	unsigned int i;
 
-	/* No interrupts required for SPMI 1.x controller */
-	if (pdata->spmi_ver < 2) {
+	/*
+	 * No interrupts required for SPMI 1.x controller, nor on a bus whose
+	 * RCS interrupt is not described (MT6858's SPMI-P, which shares
+	 * SPMI-M's).
+
+	 */
+	if (pdata->spmi_ver < 2 ||
+	    of_property_match_string(node, "interrupt-names", "rcs") < 0) {
 		pbus->dom = NULL;
 		return 0;
 	}
