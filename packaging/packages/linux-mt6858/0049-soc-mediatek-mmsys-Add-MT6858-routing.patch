From c5c832024985196593e3116db32eecc4a8bb5cd1 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 05:45:33 +0000
Subject: [PATCH 049/181] soc: mediatek: mmsys: Add MT6858 routing

MT6858 connects its display engines through crossbars. The bootloader
and the vendor driver use OVL0..2_2L, then the resizer, sharpness,
colour, 3D LUT, AAL, gamma, postmask and dither engines, then DSC0 and
DSI0. Mainline has no drivers for the resizer, sharpness or 3D LUT
engines. Instead, the PQ0_IN_CB0 crossbar can send the overlay output
straight to PQ0_OUT_CB4, past the whole picture-quality chain.

Add routes for a primary path of OVL_2L1 -> OVL_2L2 -> DSC0 -> DSI0,
and OVL_2L2 -> DSI0 without compression, through that bypass.

The register values come from the vendor driver's connection
functions and match what the bootloader leaves set on the phone. The
vendor driver also sets bit 0 at 0xc00 and bits 16-23 at 0xc0c on
every connection; the routes from the overlays do the same.

Each multiple-output register is written as a whole field, and routes
clear the crossbar outputs that would otherwise drive the same input.
The routes then work after the bootloader's full picture-quality path.
---
 drivers/soc/mediatek/mt6858-mmsys.h | 122 ++++++++++++++++++++++++++++
 drivers/soc/mediatek/mtk-mmsys.c    |   8 ++
 2 files changed, 130 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6858-mmsys.h

diff --git a/drivers/soc/mediatek/mt6858-mmsys.h b/drivers/soc/mediatek/mt6858-mmsys.h
new file mode 100644
index 000000000..8b2253481
--- /dev/null
+++ b/drivers/soc/mediatek/mt6858-mmsys.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6858_MMSYS_H
+#define __SOC_MEDIATEK_MT6858_MMSYS_H
+
+/*
+ * MT6858 links its display engines through crossbars. The primary path
+ * here is OVL_2L1 -> OVL_2L2 -> PQ0_IN_CB0 -> PQ0_OUT_CB4, which skips
+ * the picture-quality engines, then SPLIT_OUT_CB2 -> [DSC0] -> DSI0.
+ * Each multiple-output register is written as a whole field, so that
+ * switching from the bootloader's path clears its other outputs.
+ */
+#define MT6858_MMSYS_OVL_CON0			0xc00
+#define MT6858_MMSYS_OVL_MOUT_EN		0xc08
+#define MT6858_MMSYS_OVL_CON3			0xc0c
+#define MT6858_DISP_OVL1_2L_BG_MOUT_EN		0xc14
+#define MT6858_DISP_OVL2_2L_MOUT_EN		0xc3c
+#define MT6858_DISP_PQ0_IN_CB0_MOUT_EN		0xd00
+#define MT6858_DISP_PQ0_OUT_CB0_MOUT_EN		0xd20
+#define MT6858_DISP_PQ0_OUT_CB4_MOUT_EN		0xd30
+#define MT6858_DISP_SPLIT_OUT_CB2_MOUT_EN	0xd54
+#define MT6858_DISP_DSC0_MOUT_EN		0xd74
+#define MT6858_DISP_COMP0_OUT_CB2_MOUT_EN	0xd7c
+
+/* Set by the vendor driver on every connection */
+#define MT6858_OVL_CON0_EN			BIT(0)
+#define MT6858_OVL_CON3_EN			GENMASK(23, 16)
+
+#define MT6858_OVL1_2L_GO_BLEND			BIT(4)
+#define MT6858_OVL1_2L_GO_BG			BIT(5)
+#define MT6858_OVL1_2L_MASK			GENMASK(5, 4)
+#define MT6858_OVL2_2L_GO_BLEND			BIT(6)
+#define MT6858_OVL2_2L_GO_BG			BIT(7)
+#define MT6858_OVL2_2L_MASK			GENMASK(7, 6)
+
+#define MT6858_OVL_BG_MOUT_MASK			GENMASK(3, 0)
+#define MT6858_OVL1_2L_BG_TO_OVL2_2L		BIT(2)
+#define MT6858_OVL_MOUT_MASK			GENMASK(3, 0)
+#define MT6858_OVL2_2L_TO_PQ0_IN_CB0		BIT(0)
+#define MT6858_PQ0_IN_CB_MASK			GENMASK(4, 0)
+#define MT6858_PQ0_IN_CB0_TO_PQ0_OUT_CB4	BIT(2)
+#define MT6858_PQ0_OUT_CB_MASK			GENMASK(3, 0)
+#define MT6858_PQ0_OUT_CB4_TO_SPLIT_OUT_CB2	BIT(1)
+#define MT6858_SPLIT_OUT_CB_MASK		GENMASK(4, 0)
+#define MT6858_SPLIT_OUT_CB2_TO_DSC0		BIT(0)
+#define MT6858_SPLIT_OUT_CB2_TO_COMP0_OUT_CB2	BIT(2)
+#define MT6858_COMP0_OUT_MASK			GENMASK(2, 0)
+#define MT6858_DSC0_TO_DSI0			BIT(0)
+#define MT6858_COMP0_OUT_CB2_TO_DSI0		BIT(0)
+
+static const struct mtk_mmsys_routes mmsys_mt6858_routing_table[] = {
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6858_MMSYS_OVL_CON0, MT6858_OVL_CON0_EN,
+		    MT6858_OVL_CON0_EN),
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6858_MMSYS_OVL_CON3, MT6858_OVL_CON3_EN,
+		    MT6858_OVL_CON3_EN),
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6858_MMSYS_OVL_MOUT_EN, MT6858_OVL1_2L_MASK,
+		    MT6858_OVL1_2L_GO_BG),
+	MMSYS_ROUTE(OVL_2L, 1, OVL_2L, 2,
+		    MT6858_DISP_OVL1_2L_BG_MOUT_EN, MT6858_OVL_BG_MOUT_MASK,
+		    MT6858_OVL1_2L_BG_TO_OVL2_2L),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_MMSYS_OVL_CON0, MT6858_OVL_CON0_EN,
+		    MT6858_OVL_CON0_EN),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_MMSYS_OVL_CON3, MT6858_OVL_CON3_EN,
+		    MT6858_OVL_CON3_EN),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_MMSYS_OVL_MOUT_EN, MT6858_OVL2_2L_MASK,
+		    MT6858_OVL2_2L_GO_BLEND),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_DISP_OVL2_2L_MOUT_EN, MT6858_OVL_MOUT_MASK,
+		    MT6858_OVL2_2L_TO_PQ0_IN_CB0),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_DISP_PQ0_IN_CB0_MOUT_EN, MT6858_PQ0_IN_CB_MASK,
+		    MT6858_PQ0_IN_CB0_TO_PQ0_OUT_CB4),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_DISP_PQ0_OUT_CB0_MOUT_EN, MT6858_PQ0_OUT_CB_MASK, 0),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_DISP_PQ0_OUT_CB4_MOUT_EN, MT6858_PQ0_OUT_CB_MASK,
+		    MT6858_PQ0_OUT_CB4_TO_SPLIT_OUT_CB2),
+	MMSYS_ROUTE(OVL_2L, 2, DSC, 0,
+		    MT6858_DISP_SPLIT_OUT_CB2_MOUT_EN, MT6858_SPLIT_OUT_CB_MASK,
+		    MT6858_SPLIT_OUT_CB2_TO_DSC0),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_MMSYS_OVL_CON0, MT6858_OVL_CON0_EN,
+		    MT6858_OVL_CON0_EN),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_MMSYS_OVL_CON3, MT6858_OVL_CON3_EN,
+		    MT6858_OVL_CON3_EN),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_MMSYS_OVL_MOUT_EN, MT6858_OVL2_2L_MASK,
+		    MT6858_OVL2_2L_GO_BLEND),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_OVL2_2L_MOUT_EN, MT6858_OVL_MOUT_MASK,
+		    MT6858_OVL2_2L_TO_PQ0_IN_CB0),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_PQ0_IN_CB0_MOUT_EN, MT6858_PQ0_IN_CB_MASK,
+		    MT6858_PQ0_IN_CB0_TO_PQ0_OUT_CB4),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_PQ0_OUT_CB0_MOUT_EN, MT6858_PQ0_OUT_CB_MASK, 0),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_PQ0_OUT_CB4_MOUT_EN, MT6858_PQ0_OUT_CB_MASK,
+		    MT6858_PQ0_OUT_CB4_TO_SPLIT_OUT_CB2),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_SPLIT_OUT_CB2_MOUT_EN, MT6858_SPLIT_OUT_CB_MASK,
+		    MT6858_SPLIT_OUT_CB2_TO_COMP0_OUT_CB2),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_COMP0_OUT_CB2_MOUT_EN, MT6858_COMP0_OUT_MASK,
+		    MT6858_COMP0_OUT_CB2_TO_DSI0),
+	MMSYS_ROUTE(OVL_2L, 2, DSI, 0,
+		    MT6858_DISP_DSC0_MOUT_EN, MT6858_COMP0_OUT_MASK, 0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6858_DISP_DSC0_MOUT_EN, MT6858_COMP0_OUT_MASK,
+		    MT6858_DSC0_TO_DSI0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6858_DISP_COMP0_OUT_CB2_MOUT_EN, MT6858_COMP0_OUT_MASK, 0),
+};
+
+#endif /* __SOC_MEDIATEK_MT6858_MMSYS_H */
diff --git a/drivers/soc/mediatek/mtk-mmsys.c b/drivers/soc/mediatek/mtk-mmsys.c
index bfcd93830..ebe764773 100644
--- a/drivers/soc/mediatek/mtk-mmsys.c
+++ b/drivers/soc/mediatek/mtk-mmsys.c
@@ -14,6 +14,7 @@
 #include <linux/soc/mediatek/mtk-mmsys.h>
 
 #include "mtk-mmsys.h"
+#include "mt6858-mmsys.h"
 #include "mt8167-mmsys.h"
 #include "mt8173-mmsys.h"
 #include "mt8183-mmsys.h"
@@ -53,6 +54,12 @@ static const struct mtk_mmsys_driver_data mt6797_mmsys_driver_data = {
 	.clk_driver = "clk-mt6797-mm",
 };
 
+static const struct mtk_mmsys_driver_data mt6858_mmsys_driver_data = {
+	.clk_driver = "clk-mt6858-mm",
+	.routes = mmsys_mt6858_routing_table,
+	.num_routes = ARRAY_SIZE(mmsys_mt6858_routing_table),
+};
+
 static const struct mtk_mmsys_driver_data mt8167_mmsys_driver_data = {
 	.clk_driver = "clk-mt8167-mm",
 	.routes = mt8167_mmsys_routing_table,
@@ -463,6 +470,7 @@ static const struct of_device_id of_match_mtk_mmsys[] = {
 	{ .compatible = "mediatek,mt6779-mmsys", .data = &mt6779_mmsys_driver_data },
 	{ .compatible = "mediatek,mt6795-mmsys", .data = &mt6795_mmsys_driver_data },
 	{ .compatible = "mediatek,mt6797-mmsys", .data = &mt6797_mmsys_driver_data },
+	{ .compatible = "mediatek,mt6858-mmsys", .data = &mt6858_mmsys_driver_data },
 	{ .compatible = "mediatek,mt8167-mmsys", .data = &mt8167_mmsys_driver_data },
 	{ .compatible = "mediatek,mt8173-mmsys", .data = &mt8173_mmsys_driver_data },
 	{ .compatible = "mediatek,mt8183-mmsys", .data = &mt8183_mmsys_driver_data },
