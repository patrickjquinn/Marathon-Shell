+static int imx616_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx616 *imx616 = to_imx616(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx616->supplies),
+				    imx616->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(imx616->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(imx616->supplies),
+				       imx616->supplies);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(imx616->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+}
+
+static int imx616_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx616 *imx616 = to_imx616(sd);
+
+	gpiod_set_value_cansleep(imx616->reset_gpio, 1);
+	clk_disable_unprepare(imx616->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(imx616->supplies), imx616->supplies);
+
+	return 0;
+}
+
+static int imx616_check_hwcfg(struct imx616 *imx616)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(imx616->dev), NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX616_DATA_LANES) {
+		dev_err(imx616->dev, "%u data lanes, only %u are supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes,
+			IMX616_DATA_LANES);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx616->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx616_link_freq_menu,
+				       ARRAY_SIZE(imx616_link_freq_menu),
+				       &freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int imx616_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx616 *imx616;
+	unsigned int i;
+	u64 val;
+	int ret;
+
+	imx616 = devm_kzalloc(dev, sizeof(*imx616), GFP_KERNEL);
+	if (!imx616)
+		return -ENOMEM;
+
+	imx616->dev = dev;
+	v4l2_i2c_subdev_init(&imx616->sd, client, &imx616_subdev_ops);
+
+	imx616->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx616->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx616->regmap),
+				     "failed to init CCI\n");
+
+	imx616->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx616->mclk))
+		return dev_err_probe(dev, PTR_ERR(imx616->mclk),
+				     "failed to get the clock\n");
+	if (clk_get_rate(imx616->mclk) != IMX616_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "unsupported clock rate %lu\n",
+				     clk_get_rate(imx616->mclk));
+
+	ret = imx616_check_hwcfg(imx616);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad endpoint configuration\n");
+
+	imx616->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx616->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx616->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(imx616_supply_names); i++)
+		imx616->supplies[i].supply = imx616_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx616->supplies),
+				      imx616->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	ret = imx616_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(imx616->regmap, IMX616_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to read the chip ID\n");
+		goto err_power_off;
+	}
+	if (val != IMX616_CHIP_ID) {
+		ret = dev_err_probe(dev, -ENODEV, "chip ID %#llx is not %#x\n",
+				    val, IMX616_CHIP_ID);
+		goto err_power_off;
+	}
+
+	imx616->mode = &imx616_modes[0];
+
+	ret = imx616_init_controls(imx616);
+	if (ret)
+		goto err_power_off;
+
+	imx616->sd.internal_ops = &imx616_internal_ops;
+	imx616->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx616->sd.entity.ops = &imx616_entity_ops;
+	imx616->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx616->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx616->sd.entity, 1, &imx616->pad);
+	if (ret)
+		goto err_ctrls;
+
+	imx616->sd.state_lock = imx616->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx616->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx616->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register the subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&imx616->sd);
+err_entity:
+	media_entity_cleanup(&imx616->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&imx616->ctrl_handler);
+err_power_off:
+	imx616_power_off(dev);
+	return ret;
+}
+
+static void imx616_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx616 *imx616 = to_imx616(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx616->ctrl_handler);
+
+	pm_runtime_disable(imx616->dev);
+	if (!pm_runtime_status_suspended(imx616->dev))
+		imx616_power_off(imx616->dev);
+	pm_runtime_set_suspended(imx616->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx616_pm_ops, imx616_power_off,
+				 imx616_power_on, NULL);
+
+static const struct of_device_id imx616_of_match[] = {
+	{ .compatible = "sony,imx616" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx616_of_match);
+
+static struct i2c_driver imx616_i2c_driver = {
+	.driver = {
+		.name = "imx616",
+		.of_match_table = imx616_of_match,
+		.pm = pm_ptr(&imx616_pm_ops),
+	},
+	.probe = imx616_probe,
+	.remove = imx616_remove,
+};
+module_i2c_driver(imx616_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX616 image sensor driver");
+MODULE_LICENSE("GPL");
