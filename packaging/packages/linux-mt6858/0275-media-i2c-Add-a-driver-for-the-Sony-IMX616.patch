+/*
+ * Sony IMX616 image sensor driver
+ *
+ * The register settings are taken from MediaTek's GPLv2 imgsensor driver
+ * (imx616_mipi_raw) as shipped for the Jolla Phone JP2601. Only the 2x2
+ * binned 3280x2464 mode is supported; the full 6560x4928 quad Bayer
+ * readout needs remosaicing.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define IMX616_MCLK_FREQ		(24 * HZ_PER_MHZ)
+/* OP PLL: 24 MHz / 19 * 1352 / 2 = 853.9 Mbit/s per lane */
+#define IMX616_LINK_FREQ		426947368ULL
+/* VT pixel clock of the stock mode, as LINE_LENGTH_PCK counts it */
+#define IMX616_PIXEL_RATE		528000000ULL
+#define IMX616_DATA_LANES		4
+
+#define IMX616_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX616_CHIP_ID			0x0616
+
+#define IMX616_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX616_MODE_STREAMING		BIT(0)
+
+#define IMX616_REG_ORIENTATION		CCI_REG8(0x0101)
+#define IMX616_HFLIP			BIT(0)
+#define IMX616_VFLIP			BIT(1)
+
+#define IMX616_REG_HOLD			CCI_REG8(0x0104)
+
+#define IMX616_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX616_EXPOSURE_MIN		8
+#define IMX616_EXPOSURE_MARGIN		48
+
+#define IMX616_REG_AGAIN		CCI_REG16(0x0204)
+/* Analogue gain is 1024 / (1024 - code), 1x to 16x */
+#define IMX616_AGAIN_MIN		0
+#define IMX616_AGAIN_MAX		960
+#define IMX616_AGAIN_DEFAULT		0
+
+#define IMX616_REG_DGAIN		CCI_REG16(0x020e)
+#define IMX616_DGAIN_MIN		0x0100
+#define IMX616_DGAIN_MAX		0x0fff
+#define IMX616_DGAIN_DEFAULT		0x0100
+
+#define IMX616_REG_VTS			CCI_REG16(0x0340)
+#define IMX616_VTS_MAX			0xffff
+
+#define IMX616_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_imx616(_sd)			container_of(_sd, struct imx616, sd)
+
+static const s64 imx616_link_freq_menu[] = {
+	IMX616_LINK_FREQ,
+};
+
+/* Bayer order for the four flip states, no flip first */
+static const u32 imx616_mbus_formats[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+static const char * const imx616_supply_names[] = {
+	"avdd",		/* analogue, 2.9 V */
+	"dvdd",		/* digital core, 1.1 V */
+	"dovdd",	/* digital I/O, 1.8 V */
+};
+
+static const char * const imx616_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+struct imx616_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx616 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx616_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	const struct imx616_mode *mode;
+};
