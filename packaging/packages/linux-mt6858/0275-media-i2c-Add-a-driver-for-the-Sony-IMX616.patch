+static u32 imx616_get_format_code(struct imx616 *imx616)
+{
+	unsigned int i = (imx616->vflip->val ? 2 : 0) |
+			 (imx616->hflip->val ? 1 : 0);
+
+	return imx616_mbus_formats[i];
+}
+
+static int imx616_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx616 *imx616 = container_of(ctrl->handler, struct imx616,
+					     ctrl_handler);
+	const struct imx616_mode *mode = imx616->mode;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exposure_max = mode->height + ctrl->val -
+				   IMX616_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(imx616->exposure,
+					 imx616->exposure->minimum,
+					 exposure_max, imx616->exposure->step,
+					 min(imx616->exposure->default_value,
+					     exposure_max));
+	}
+
+	if (!pm_runtime_get_if_active(imx616->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(imx616->regmap, IMX616_REG_AGAIN, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = cci_write(imx616->regmap, IMX616_REG_DGAIN, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(imx616->regmap, IMX616_REG_EXPOSURE, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(imx616->regmap, IMX616_REG_VTS,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(imx616->regmap, IMX616_REG_ORIENTATION,
+				(imx616->hflip->val ? IMX616_HFLIP : 0) |
+				(imx616->vflip->val ? IMX616_VFLIP : 0), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx616->regmap, IMX616_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx616->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx616_ctrl_ops = {
+	.s_ctrl = imx616_set_ctrl,
+};
+
+static int imx616_init_controls(struct imx616 *imx616)
+{
+	struct v4l2_ctrl_handler *hdl = &imx616->ctrl_handler;
+	const struct imx616_mode *mode = imx616->mode;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	s64 hblank, vblank;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &imx616_ctrl_ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(imx616_link_freq_menu) - 1, 0,
+				      imx616_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  IMX616_PIXEL_RATE, IMX616_PIXEL_RATE, 1,
+			  IMX616_PIXEL_RATE);
+
+	hblank = mode->hts - mode->width;
+	ctrl = v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops, V4L2_CID_HBLANK,
+				 hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	imx616->vblank = v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   IMX616_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	imx616->exposure = v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX616_EXPOSURE_MIN,
+					     mode->vts - IMX616_EXPOSURE_MARGIN,
+					     1, 2514);
+
+	v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX616_AGAIN_MIN, IMX616_AGAIN_MAX, 1,
+			  IMX616_AGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX616_DGAIN_MIN, IMX616_DGAIN_MAX, 1,
+			  IMX616_DGAIN_DEFAULT);
+
+	imx616->hflip = v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx616->hflip)
+		imx616->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx616->vflip = v4l2_ctrl_new_std(hdl, &imx616_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx616->vflip)
+		imx616->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx616_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx616_test_pattern_menu) - 1,
+				     0, 0, imx616_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(imx616->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx616_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	imx616->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int imx616_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx616 *imx616 = to_imx616(sd);
+	const struct imx616_mode *mode = imx616->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx616->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(imx616->regmap, imx616_init_regs,
+			    ARRAY_SIZE(imx616_init_regs), &ret);
+	cci_multi_reg_write(imx616->regmap, mode->regs, mode->num_regs, &ret);
+	if (ret)
+		goto err;
+
+	ret = __v4l2_ctrl_handler_setup(imx616->sd.ctrl_handler);
+	if (ret)
+		goto err;
+
+	ret = cci_write(imx616->regmap, IMX616_REG_MODE_SELECT,
+			IMX616_MODE_STREAMING, NULL);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	dev_err(imx616->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(imx616->dev);
+	return ret;
+}
+
+static int imx616_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx616 *imx616 = to_imx616(sd);
+	int ret;
+
+	ret = cci_write(imx616->regmap, IMX616_REG_MODE_SELECT, 0, NULL);
+	if (ret)
+		dev_err(imx616->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx616->dev);
+
+	return ret;
+}
+
+static void imx616_update_pad_format(struct imx616 *imx616,
+				     const struct imx616_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = imx616_get_format_code(imx616);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx616_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx616 *imx616 = to_imx616(sd);
+	const struct imx616_mode *mode;
+
+	mode = v4l2_find_nearest_size(imx616_modes, ARRAY_SIZE(imx616_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	imx616_update_pad_format(imx616, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		imx616->mode = mode;
+
+	return 0;
+}
+
+static int imx616_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx616 *imx616 = to_imx616(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx616_get_format_code(imx616);
+
+	return 0;
+}
+
+static int imx616_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx616 *imx616 = to_imx616(sd);
+
+	if (fse->index >= ARRAY_SIZE(imx616_modes) ||
+	    fse->code != imx616_get_format_code(imx616))
+		return -EINVAL;
+
+	fse->min_width = imx616_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx616_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx616_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 6560;
+		sel->r.height = 4928;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx616_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = imx616_modes[0].width,
+			.height = imx616_modes[0].height,
+		},
+	};
+
+	return imx616_set_pad_format(sd, NULL, state, &fmt);
+}
