From 87167c6a15ad096dd6576fa89e953e9dbdb25971 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 11:48:31 +0000
Subject: [PATCH 275/286] media: i2c: Add a driver for the Sony IMX616

Add a V4L2 subdev driver for the IMX616 in its 2x2 binned 3280x2464
mode at 30 fps over four D-PHY lanes (853.9 Mbit/s per lane), with
exposure, analogue and digital gain, vertical blanking, flips and the
test patterns. The register settings are those of MediaTek's GPLv2
imgsensor driver for the sensor (imx616_mipi_raw), from the Jolla
Phone JP2601's stock kernel modules.

Tested on the Jolla Phone JP2601: the chip ID (0x0616) reads at probe,
and the stream reaches the MT6858 SENINF as whole 3280x2464 RAW10
frames with no CSI-2 CRC or ECC errors.
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx616.c | 1016 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1028 insertions(+)
 create mode 100644 drivers/media/i2c/imx616.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 11c302525..77baeeeee 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -321,6 +321,17 @@ config VIDEO_IMX576
           To compile this driver as a module, choose M here: the
           module will be called imx576.
 
+config VIDEO_IMX616
+	tristate "Sony IMX616 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX616 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx616.
+
 config VIDEO_IMX678
 	tristate "Sony IMX678 sensor support"
 	depends on GPIOLIB
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 59e31af45..140c63a58 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -64,6 +64,7 @@ obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
 obj-$(CONFIG_VIDEO_IMX576) += imx576.o
+obj-$(CONFIG_VIDEO_IMX616) += imx616.o
 obj-$(CONFIG_VIDEO_IMX678) += imx678.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
diff --git a/drivers/media/i2c/imx616.c b/drivers/media/i2c/imx616.c
new file mode 100644
index 000000000..c3732ebb6
--- /dev/null
+++ b/drivers/media/i2c/imx616.c
@@ -0,0 +1,1016 @@
