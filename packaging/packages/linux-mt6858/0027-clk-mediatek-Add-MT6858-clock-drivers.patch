From 94dbecad4735a0f09bc30f437f074460ce181b64 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 03:25:40 +0000
Subject: [PATCH 027/167] clk: mediatek: Add MT6858 clock drivers

Add drivers for the MT6858 apmixedsys PLLs, the topckgen dividers and
muxes, and the pericfg_ao and infracfg_ao gates. The tables come from
MediaTek's GPLv2 MT6858 clock driver.

The muxes and gates follow MT8196: most muxes have a FENC status bit,
and the display, multimedia, SPI, video and camera muxes and the
pericfg_ao SPI gates are voted through the hardware voter. The audio
composite clocks and the vlp_cksys muxes are left for later.
---
 drivers/clk/mediatek/Kconfig                 |  10 +
 drivers/clk/mediatek/Makefile                |   2 +
 drivers/clk/mediatek/clk-mt6858-apmixedsys.c | 110 +++
 drivers/clk/mediatek/clk-mt6858-infra_ao.c   | 113 +++
 drivers/clk/mediatek/clk-mt6858-peri_ao.c    | 131 +++
 drivers/clk/mediatek/clk-mt6858-topckgen.c   | 858 +++++++++++++++++++
 6 files changed, 1224 insertions(+)
 create mode 100644 drivers/clk/mediatek/clk-mt6858-apmixedsys.c
 create mode 100644 drivers/clk/mediatek/clk-mt6858-infra_ao.c
 create mode 100644 drivers/clk/mediatek/clk-mt6858-peri_ao.c
 create mode 100644 drivers/clk/mediatek/clk-mt6858-topckgen.c

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index ba1ca9c90..ad6d3888c 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -469,6 +469,16 @@ config COMMON_CLK_MT7988
 	  This driver supports MediaTek MT7988 basic clocks and clocks
 	  required for various periperals found on this SoC.
 
+config COMMON_CLK_MT6858
+	tristate "Clock driver for MediaTek MT6858"
+	depends on ARM64 || COMPILE_TEST
+	select COMMON_CLK_MEDIATEK
+	select REGMAP_MMIO
+	default ARCH_MEDIATEK
+	help
+	  This driver supports the MediaTek MT6858 apmixedsys, topckgen,
+	  pericfg_ao and infracfg_ao clocks.
+
 config COMMON_CLK_MT8135
 	tristate "Clock driver for MediaTek MT8135"
 	depends on (ARCH_MEDIATEK && ARM) || COMPILE_TEST
