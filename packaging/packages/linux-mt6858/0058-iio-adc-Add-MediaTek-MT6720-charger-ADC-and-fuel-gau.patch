 drivers/iio/adc/Makefile        |   1 +
 drivers/iio/adc/mt6720-adc.c    | 225 ++++++++++++++++++++++++++++++++
 drivers/iio/adc/mt6720-auxadc.c | 173 ++++++++++++++++++++++++
 4 files changed, 410 insertions(+)
 create mode 100644 drivers/iio/adc/mt6720-adc.c
 create mode 100644 drivers/iio/adc/mt6720-auxadc.c

