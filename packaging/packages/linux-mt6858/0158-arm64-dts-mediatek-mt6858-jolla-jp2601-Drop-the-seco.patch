From 5b0452fe941b659ea3dab028887336a7f3a0b9e6 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 12:15:09 +0000
Subject: [PATCH 158/165] arm64: dts: mediatek: mt6858-jolla-jp2601: Drop the
 second home key

The stock firmware maps both MT6363 home keys to volume down, but on
the phone only HOMEKEY ever fires (hwirq 49/52); HOMEKEY2, on the
PMIC's KPCOL0 pad, stayed silent through every key test. Describe
volume down as HOMEKEY alone.
---
 arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 4ee854721..f779925c1 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -646,21 +646,13 @@ power {
 			wakeup-source;
 		};
 
-		/* Volume down: like the stock firmware, take both home keys. */
+		/* Volume down is the PMIC's HOMEKEY */
 		home {
 			interrupts = <4 49 IRQ_TYPE_LEVEL_HIGH>,
 				     <4 52 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "homekey", "homekey_r";
 			linux,keycodes = <KEY_VOLUMEDOWN>;
 		};
-
-		home2-key {
-			interrupts = <4 50 IRQ_TYPE_LEVEL_HIGH>,
-				     <4 53 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "homekey", "homekey_r";
-			linux,keycodes = <KEY_VOLUMEDOWN>;
-			wakeup-source;
-		};
 	};
 };
 
