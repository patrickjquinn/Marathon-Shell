From 6fcfdd89f8dd10dd4ce9788a79508baf07cbc2a0 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:29:24 +0000
Subject: [PATCH 090/206] dt-bindings: display: panel: Add Visionox VTDR6126

The VTDR6126 is a 1032x2272 AMOLED panel on a 4-lane DSI link in video
mode with DSC, fitted to the Jolla Phone (JP2601). Besides reset it has
three switched supplies, brought up in order: the I/O supply, then the
negative and the positive bias.
---
 .../display/panel/visionox,vtdr6126.yaml      | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/visionox,vtdr6126.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/visionox,vtdr6126.yaml b/Documentation/devicetree/bindings/display/panel/visionox,vtdr6126.yaml
new file mode 100644
index 000000000..62dfa798b
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/visionox,vtdr6126.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/visionox,vtdr6126.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Visionox VTDR6126 AMOLED DSI Panel
+
+description:
+  A 1032x2272 AMOLED panel driven over a 4-lane MIPI DSI link in video
+  mode with Display Stream Compression, at 60 or 90 Hz.
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: visionox,vtdr6126
+
+  reg:
+    maxItems: 1
+    description: DSI virtual channel
+
+  vddio-supply:
+    description: I/O and logic supply, switched on first
+
+  vsn-supply:
+    description: Negative bias supply enable
+
+  vsp-supply:
+    description: Positive bias supply enable
+
+  port: true
+  reset-gpios: true
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vsn-supply
+  - vsp-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        panel@0 {
+            compatible = "visionox,vtdr6126";
+            reg = <0>;
+
+            vddio-supply = <&panel_vddio>;
+            vsn-supply = <&panel_vsn>;
+            vsp-supply = <&panel_vsp>;
+
+            reset-gpios = <&pio 97 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel0_in: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+...
-- 
