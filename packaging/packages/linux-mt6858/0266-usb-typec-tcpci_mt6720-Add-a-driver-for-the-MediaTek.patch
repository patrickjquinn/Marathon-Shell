@@ -46,6 +46,17 @@ config TYPEC_TCPCI_MT6370
 	  This driver can also be built as a module. The module
 	  will be called "tcpci_mt6370".
 
+config TYPEC_TCPCI_MT6720
+	tristate "MediaTek MT6720 Type-C driver"
