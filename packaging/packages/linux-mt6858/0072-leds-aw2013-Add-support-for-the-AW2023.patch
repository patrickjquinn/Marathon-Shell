From 5da3e089b37346eab54b79b7baab403b17824722 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:21:07 +0000
Subject: [PATCH 072/214] leds: aw2013: Add support for the AW2023

The AW2023 keeps the AW2013's channel, brightness and pattern registers
but sets currents differently: GCR2[1:0] selects one maximum current for
all channels (15, 30, 5 or 10 mA), and LCFGx[3:0] gives each channel
IMAX * CUR / 15. Its chip ID is 0x09.

Pick the smallest maximum that covers every channel's led-max-microamp
and the nearest step below it for each channel. The pattern timings
follow another table than the AW2013's, so leave blinking to the LED
core instead of programming the AW2013's.
---
 drivers/leds/Kconfig       |  6 +--
 drivers/leds/leds-aw2013.c | 76 ++++++++++++++++++++++++++++++++++++--
 2 files changed, 75 insertions(+), 7 deletions(-)

diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index 7ec2c8d78..35fd5d829 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -138,12 +138,12 @@ config LEDS_AW200XX
 	  will be called leds-aw200xx.
 
 config LEDS_AW2013
-	tristate "LED support for Awinic AW2013"
+	tristate "LED support for Awinic AW2013 and AW2023"
 	depends on LEDS_CLASS && I2C && OF
 	select REGMAP_I2C
 	help
-	  This option enables support for the AW2013 3-channel
-	  LED driver.
+	  This option enables support for the AW2013 and AW2023 3-channel
+	  LED drivers.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called leds-aw2013.
diff --git a/drivers/leds/leds-aw2013.c b/drivers/leds/leds-aw2013.c
index 457f1cb17..f565e8fc4 100644
--- a/drivers/leds/leds-aw2013.c
+++ b/drivers/leds/leds-aw2013.c
@@ -15,11 +15,16 @@
 #define AW2013_RSTR 0x00
 #define AW2013_RSTR_RESET 0x55
 #define AW2013_RSTR_CHIP_ID 0x33
+#define AW2023_RSTR_CHIP_ID 0x09
 
 /* Global control register */
 #define AW2013_GCR 0x01
 #define AW2013_GCR_ENABLE BIT(0)
 
+/* AW2023: global maximum current register */
+#define AW2023_GCR2 0x04
+#define AW2023_GCR2_IMAX_MASK GENMASK(1, 0)
+
 /* LED channel enable register */
 #define AW2013_LCTR 0x30
 #define AW2013_LCTR_LE(x) BIT((x))
@@ -27,6 +32,7 @@
 /* LED channel control registers */
 #define AW2013_LCFG(x) (0x31 + (x))
 #define AW2013_LCFG_IMAX_MASK (BIT(0) | BIT(1)) // Should be 0-3
+#define AW2023_LCFG_CUR_MASK GENMASK(3, 0) // Io = IMAX * CUR / 15
 #define AW2013_LCFG_MD BIT(4)
 #define AW2013_LCFG_FI BIT(5)
 #define AW2013_LCFG_FO BIT(6)
@@ -53,6 +59,12 @@
 
 struct aw2013;
 
+struct aw2013_chip_info {
+	unsigned int chip_id;
+	/* AW2023: one maximum current for all channels, a fraction per channel */
+	bool global_imax;
+};
+
 struct aw2013_led {
 	struct aw2013 *chip;
 	struct led_classdev cdev;
@@ -61,15 +73,20 @@ struct aw2013_led {
 };
 
 struct aw2013 {
+	const struct aw2013_chip_info *info;
 	struct mutex mutex; /* held when writing to registers */
 	struct regulator_bulk_data regulators[2];
 	struct i2c_client *client;
 	struct aw2013_led leds[AW2013_MAX_LEDS];
 	struct regmap *regmap;
 	int num_leds;
+	unsigned int imax; /* AW2023 GCR2 IMAX */
 	bool enabled;
 };
 
+/* AW2023 GCR2 IMAX codes, in microamps */
+static const unsigned int aw2023_imax_ua[] = { 15000, 30000, 5000, 10000 };
+
 static int aw2013_chip_init(struct aw2013 *chip)
 {
 	int i, ret;
@@ -81,10 +98,21 @@ static int aw2013_chip_init(struct aw2013 *chip)
 		return ret;
 	}
 
+	if (chip->info->global_imax) {
+		ret = regmap_update_bits(chip->regmap, AW2023_GCR2,
+					 AW2023_GCR2_IMAX_MASK, chip->imax);
+		if (ret) {
+			dev_err(&chip->client->dev,
+				"Failed to set maximum current: %d\n", ret);
+			return ret;
+		}
+	}
+
 	for (i = 0; i < chip->num_leds; i++) {
 		ret = regmap_update_bits(chip->regmap,
 					 AW2013_LCFG(chip->leds[i].num),
-					 AW2013_LCFG_IMAX_MASK,
+					 chip->info->global_imax ?
+					 AW2023_LCFG_CUR_MASK : AW2013_LCFG_IMAX_MASK,
 					 chip->leds[i].imax);
 		if (ret) {
 			dev_err(&chip->client->dev,
@@ -261,10 +289,33 @@ static int aw2013_blink_set(struct led_classdev *cdev,
 	return ret;
 }
 
+/*
+ * The AW2023 takes the smallest maximum current that covers every channel,
+ * and each channel's current as a fifteenth of it.
+ */
+static void aw2023_set_currents(struct aw2013 *chip, const u32 *ua)
+{
+	unsigned int code, best = 1, i, max = 0;
+
+	for (i = 0; i < chip->num_leds; i++)
+		max = max_t(u32, max, ua[i]);
+
+	for (code = 0; code < ARRAY_SIZE(aw2023_imax_ua); code++)
+		if (aw2023_imax_ua[code] >= max &&
+		    aw2023_imax_ua[code] < aw2023_imax_ua[best])
+			best = code;
+
+	chip->imax = best;
+	for (i = 0; i < chip->num_leds; i++)
+		chip->leds[i].imax = clamp(DIV_ROUND_CLOSEST(ua[i] * 15,
+							     aw2023_imax_ua[best]), 1U, 15U);
+}
+
 static int aw2013_probe_dt(struct aw2013 *chip)
 {
 	struct device_node *np = dev_of_node(&chip->client->dev);
 	int count, ret = 0, i = 0;
+	u32 ua[AW2013_MAX_LEDS];
 	struct aw2013_led *led;
 
 	count = of_get_available_child_count(np);
@@ -294,13 +345,17 @@ static int aw2013_probe_dt(struct aw2013 *chip)
 		if (!of_property_read_u32(child, "led-max-microamp", &imax)) {
 			led->imax = min_t(u32, imax / 5000, 3);
 		} else {
+			imax = 5000;
 			led->imax = 1; // 5mA
 			dev_info(&chip->client->dev,
 				 "DT property led-max-microamp is missing\n");
 		}
+		ua[i] = imax;
 
 		led->cdev.brightness_set_blocking = aw2013_brightness_set;
-		led->cdev.blink_set = aw2013_blink_set;
+		/* The AW2023's pattern timings differ: let the LED core blink it */
+		if (!chip->info->global_imax)
+			led->cdev.blink_set = aw2013_blink_set;
 
 		ret = devm_led_classdev_register_ext(&chip->client->dev,
 						     &led->cdev, &init_data);
@@ -314,6 +369,8 @@ static int aw2013_probe_dt(struct aw2013 *chip)
 		return -EINVAL;
 
 	chip->num_leds = i;
+	if (chip->info->global_imax)
+		aw2023_set_currents(chip, ua);
 
 	return 0;
 }
@@ -346,6 +403,7 @@ static int aw2013_probe(struct i2c_client *client)
 	mutex_lock(&chip->mutex);
 
 	chip->client = client;
+	chip->info = i2c_get_match_data(client);
 	i2c_set_clientdata(client, chip);
 
 	chip->regmap = devm_regmap_init_i2c(client, &aw2013_regmap_config);
@@ -383,7 +441,7 @@ static int aw2013_probe(struct i2c_client *client)
 		goto error_reg;
 	}
 
-	if (chipid != AW2013_RSTR_CHIP_ID) {
+	if (chipid != chip->info->chip_id) {
 		dev_err(&client->dev, "Chip reported wrong ID: %x\n",
 			chipid);
 		ret = -ENODEV;
@@ -419,8 +477,18 @@ static int aw2013_probe(struct i2c_client *client)
 	return ret;
 }
 
+static const struct aw2013_chip_info aw2013_info = {
+	.chip_id = AW2013_RSTR_CHIP_ID,
+};
+
+static const struct aw2013_chip_info aw2023_info = {
+	.chip_id = AW2023_RSTR_CHIP_ID,
+	.global_imax = true,
+};
+
 static const struct of_device_id aw2013_match_table[] = {
-	{ .compatible = "awinic,aw2013", },
+	{ .compatible = "awinic,aw2013", .data = &aw2013_info },
+	{ .compatible = "awinic,aw2023", .data = &aw2023_info },
 	{ /* sentinel */ },
 };
 
-- 
2.55.0

