From 8b3449b45aba6d093e6f52113f0df2aee135c877 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 06:47:09 +0000
Subject: [PATCH 242/250] arm64: dts: mediatek: mt6858-jolla-jp2601: Describe
 the NFC controller

The ST21NFCD sits on I2C3 at 0x08, with its interrupt on GPIO4 and its
reset on GPIO5 as in the stock device tree. It has no crystal: XO_BBCK4
from the MT6685 is its reference clock.
---
 arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 18b7baf4b..84f5408e8 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -814,6 +814,15 @@ &i2c3 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c3_pins>;
 	status = "okay";
+
+	nfc@8 {
+		compatible = "st,st21nfcd-i2c";
+		reg = <0x08>;
+		interrupt-parent = <&pio>;
+		interrupts = <4 IRQ_TYPE_LEVEL_HIGH>;
+		reset-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
+		clocks = <&mt6685_clkbuf MT6685_CLK_XO_BBCK4>;
+	};
 };
 
 &i2c4 {
-- 
2.55.0

