From 9bfababb34f7d0123424f29e46a8a4a0ca76598c Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 11:48:43 +0000
Subject: [PATCH 276/286] media: dt-bindings: Add the Sony IMX766 image sensor

The IMX766 is a 50 MP quad Bayer sensor sending over three C-PHY
trios, the main rear camera of the Jolla Phone JP2601.
---
 .../bindings/media/i2c/sony,imx766.yaml       | 112 ++++++++++++++++++
 1 file changed, 112 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
new file mode 100644
index 000000000..b90a40d67
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx766.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx766.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX766 50MP CMOS Digital Image Sensor
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The IMX766 is a Sony quad Bayer CMOS image sensor with an active array of
+  8192x6144 pixels, programmable over I2C. Image data is sent over MIPI CSI-2,
+  on three C-PHY trios.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx766
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: INCK, 24 MHz
+    maxItems: 1
+
+  reset-gpios:
+    description: XCLR, active low
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue power supply (2.8 V)
+
+  dvdd-supply:
+    description: Digital core power supply (1.1 V)
+
+  dovdd-supply:
+    description: Digital I/O power supply (1.8 V)
+
+  port:
+    additionalProperties: false
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/media/video-interfaces.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@29 {
+            compatible = "sony,imx766";
+            reg = <0x29>;
+            clocks = <&camtg>;
+            reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&cam_avdd>;
+            dvdd-supply = <&cam_dvdd>;
+            dovdd-supply = <&cam_dovdd>;
+            orientation = <1>;
+            rotation = <90>;
+
+            port {
+                endpoint {
+                    bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+                    data-lanes = <1 2 3>;
+                    link-frequencies = /bits/ 64 <1164000000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
+...
-- 
2.55.0

