From e3a60460fabb3dc29251c35c3c3534a7c0565874 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 23:59:44 +0000
Subject: [PATCH 209/214] thermal/drivers/mediatek/lvts: Add the MT6858

The MT6858's preloader runs its LVTS controllers: four in the MCU
domain (the big cores with two sensors each, the little cores, the
DSU) and two in the AP domain (three sensors at the top of the SoC,
two at the bottom). Its GPU controller sits in the GPU's power domain
and is left out.

Read their averaged (ATP) results with the MT8195 coefficients, as the
vendor kernel does. MT6858's efuse calibration is not reachable here,
so use the vendor kernel's default golden temperature, 60 degC. The
preloader's thermal reset threshold, PROTTC 0x2a47, converts to
115.0 degC with it, which is the threshold the vendor kernel programs.

On the Jolla Phone (2026), idle at a 28.5 degC battery, the sensors
read 34 to 37 degC.
---
 drivers/thermal/mediatek/lvts_thermal.c | 96 +++++++++++++++++++++++++
 1 file changed, 96 insertions(+)

diff --git a/drivers/thermal/mediatek/lvts_thermal.c b/drivers/thermal/mediatek/lvts_thermal.c
index 3506d823f..7fc2ceaf7 100644
--- a/drivers/thermal/mediatek/lvts_thermal.c
+++ b/drivers/thermal/mediatek/lvts_thermal.c
@@ -1606,6 +1606,74 @@ static void lvts_remove(struct platform_device *pdev)
 		lvts_ctrl_set_enable(&lvts_td->lvts_ctrl[i], false);
 }
 
+/* The vendor kernel's MT6858 controller and sensor layout */
+static const struct lvts_ctrl_data mt6858_lvts_mcu_data_ctrl[] = {
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_MCU_BIG_CPU0_0 },
+			{ .dt_id = MT6858_MCU_BIG_CPU0_1 },
+			{ .dt_id = MT6858_MCU_BIG_CPU1_0 },
+			{ .dt_id = MT6858_MCU_BIG_CPU1_1 }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.offset = 0x0,
+		.mode = LVTS_MSR_ATP_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_MCU_BIG_CPU2_0 },
+			{ .dt_id = MT6858_MCU_BIG_CPU2_1 },
+			{ .dt_id = MT6858_MCU_BIG_CPU3_0 },
+			{ .dt_id = MT6858_MCU_BIG_CPU3_1 }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.offset = 0x100,
+		.mode = LVTS_MSR_ATP_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_MCU_LITTLE_CPU0 },
+			{ .dt_id = MT6858_MCU_LITTLE_CPU1 },
+			{ .dt_id = MT6858_MCU_LITTLE_CPU2 },
+			{ .dt_id = MT6858_MCU_LITTLE_CPU3 }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 1),
+		.offset = 0x200,
+		.mode = LVTS_MSR_ATP_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_MCU_DSU0 },
+			{ .dt_id = MT6858_MCU_DSU1 }
+		},
+		VALID_SENSOR_MAP(1, 1, 0, 0),
+		.offset = 0x300,
+		.mode = LVTS_MSR_ATP_MODE,
+	}
+};
+
+static const struct lvts_ctrl_data mt6858_lvts_ap_data_ctrl[] = {
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_AP_TOP0 },
+			{ .dt_id = MT6858_AP_TOP1 },
+			{ .dt_id = MT6858_AP_TOP2 }
+		},
+		VALID_SENSOR_MAP(1, 1, 1, 0),
+		.offset = 0x0,
+		.mode = LVTS_MSR_ATP_MODE,
+	},
+	{
+		.lvts_sensor = {
+			{ .dt_id = MT6858_AP_BOT0 },
+			{ .dt_id = MT6858_AP_BOT1 }
+		},
+		VALID_SENSOR_MAP(1, 1, 0, 0),
+		.offset = 0x100,
+		.mode = LVTS_MSR_ATP_MODE,
+	}
+};
+
 static const struct lvts_ctrl_data mt7987_lvts_ap_data_ctrl[] = {
 	{
 		.lvts_sensor = {
@@ -2116,6 +2184,32 @@ static const struct lvts_platform_ops lvts_platform_ops_mt8196 = {
 	.lvts_temp_to_raw = lvts_temp_to_raw_mt8196,
 };
 
+/*
+ * The vendor kernel's default golden temperature, which the preloader's
+ * 115 degC reset threshold (PROTTC 0x2a47) matches on the Jolla Phone.
+ */
+#define LVTS_GOLDEN_TEMP_MT6858		60
+
+static const struct lvts_data mt6858_lvts_mcu_data = {
+	.lvts_ctrl	= mt6858_lvts_mcu_data_ctrl,
+	.num_lvts_ctrl	= ARRAY_SIZE(mt6858_lvts_mcu_data_ctrl),
+	.temp_factor	= LVTS_COEFF_A_MT8195,
+	.temp_offset	= LVTS_COEFF_B_MT8195,
+	.ops		= &lvts_platform_ops_mt7988,
+	.fw_configured	= true,
+	.def_golden_temp = LVTS_GOLDEN_TEMP_MT6858,
+};
+
+static const struct lvts_data mt6858_lvts_ap_data = {
+	.lvts_ctrl	= mt6858_lvts_ap_data_ctrl,
+	.num_lvts_ctrl	= ARRAY_SIZE(mt6858_lvts_ap_data_ctrl),
+	.temp_factor	= LVTS_COEFF_A_MT8195,
+	.temp_offset	= LVTS_COEFF_B_MT8195,
+	.ops		= &lvts_platform_ops_mt7988,
+	.fw_configured	= true,
+	.def_golden_temp = LVTS_GOLDEN_TEMP_MT6858,
+};
+
 static const struct lvts_data mt7987_lvts_ap_data = {
 	.lvts_ctrl	= mt7987_lvts_ap_data_ctrl,
 	.num_lvts_ctrl	= ARRAY_SIZE(mt7987_lvts_ap_data_ctrl),
@@ -2273,6 +2367,8 @@ static const struct lvts_data mt8196_lvts_ap_data = {
 };
 
 static const struct of_device_id lvts_of_match[] = {
+	{ .compatible = "mediatek,mt6858-lvts-mcu", .data = &mt6858_lvts_mcu_data },
+	{ .compatible = "mediatek,mt6858-lvts-ap", .data = &mt6858_lvts_ap_data },
 	{ .compatible = "mediatek,mt7987-lvts-ap", .data = &mt7987_lvts_ap_data },
 	{ .compatible = "mediatek,mt7988-lvts-ap", .data = &mt7988_lvts_ap_data },
 	{ .compatible = "mediatek,mt8186-lvts", .data = &mt8186_lvts_data },
