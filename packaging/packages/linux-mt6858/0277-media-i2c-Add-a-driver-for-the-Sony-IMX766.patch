+static u32 imx766_get_format_code(struct imx766 *imx766)
+{
+	unsigned int i = (imx766->vflip->val ? 2 : 0) |
+			 (imx766->hflip->val ? 1 : 0);
+
+	return imx766_mbus_formats[i];
+}
+
+static int imx766_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx766 *imx766 = container_of(ctrl->handler, struct imx766,
+					     ctrl_handler);
+	const struct imx766_mode *mode = imx766->mode;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exposure_max = mode->height + ctrl->val -
+				   IMX766_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(imx766->exposure,
+					 imx766->exposure->minimum,
+					 exposure_max, imx766->exposure->step,
+					 min(imx766->exposure->default_value,
+					     exposure_max));
+	}
+
+	if (!pm_runtime_get_if_active(imx766->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(imx766->regmap, IMX766_REG_AGAIN, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = cci_write(imx766->regmap, IMX766_REG_DGAIN, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(imx766->regmap, IMX766_REG_EXPOSURE, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(imx766->regmap, IMX766_REG_VTS,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(imx766->regmap, IMX766_REG_ORIENTATION,
+				(imx766->hflip->val ? IMX766_HFLIP : 0) |
+				(imx766->vflip->val ? IMX766_VFLIP : 0), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx766->regmap, IMX766_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx766->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx766_ctrl_ops = {
+	.s_ctrl = imx766_set_ctrl,
+};
+
+static int imx766_init_controls(struct imx766 *imx766)
+{
+	struct v4l2_ctrl_handler *hdl = &imx766->ctrl_handler;
+	const struct imx766_mode *mode = imx766->mode;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	s64 hblank, vblank;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, &imx766_ctrl_ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(imx766_link_freq_menu) - 1, 0,
+				      imx766_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  IMX766_PIXEL_RATE, IMX766_PIXEL_RATE, 1,
+			  IMX766_PIXEL_RATE);
+
+	hblank = mode->hts - mode->width;
+	ctrl = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_HBLANK,
+				 hblank, hblank, 1, hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	imx766->vblank = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   IMX766_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	imx766->exposure = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX766_EXPOSURE_MIN,
+					     mode->vts - IMX766_EXPOSURE_MARGIN,
+					     1, 3168);
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX766_AGAIN_MIN, IMX766_AGAIN_MAX, 1,
+			  IMX766_AGAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX766_DGAIN_MIN, IMX766_DGAIN_MAX, 1,
+			  IMX766_DGAIN_DEFAULT);
+
+	imx766->hflip = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx766->hflip)
+		imx766->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx766->vflip = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx766->vflip)
+		imx766->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx766_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx766_test_pattern_menu) - 1,
+				     0, 0, imx766_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(imx766->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx766_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	imx766->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int imx766_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	const struct imx766_mode *mode = imx766->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx766->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(imx766->regmap, imx766_init_regs,
+			    ARRAY_SIZE(imx766_init_regs), &ret);
+	cci_multi_reg_write(imx766->regmap, mode->regs, mode->num_regs, &ret);
+	if (ret)
+		goto err;
+
+	ret = __v4l2_ctrl_handler_setup(imx766->sd.ctrl_handler);
+	if (ret)
+		goto err;
+
+	ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT,
+			IMX766_MODE_STREAMING, NULL);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	dev_err(imx766->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(imx766->dev);
+	return ret;
+}
+
+static int imx766_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = cci_write(imx766->regmap, IMX766_REG_MODE_SELECT, 0, NULL);
+	if (ret)
+		dev_err(imx766->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx766->dev);
+
+	return ret;
+}
+
+static void imx766_update_pad_format(struct imx766 *imx766,
+				     const struct imx766_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = imx766_get_format_code(imx766);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx766_set_pad_format(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+	const struct imx766_mode *mode;
+
+	mode = v4l2_find_nearest_size(imx766_modes, ARRAY_SIZE(imx766_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	imx766_update_pad_format(imx766, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		imx766->mode = mode;
+
+	return 0;
+}
+
+static int imx766_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx766_get_format_code(imx766);
+
+	return 0;
+}
+
+static int imx766_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx766 *imx766 = to_imx766(sd);
+
+	if (fse->index >= ARRAY_SIZE(imx766_modes) ||
+	    fse->code != imx766_get_format_code(imx766))
+		return -EINVAL;
+
+	fse->min_width = imx766_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = imx766_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx766_get_selection(struct v4l2_subdev *sd,
+				const struct v4l2_subdev_client_info *ci,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 8192;
+		sel->r.height = 6144;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx766_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = imx766_modes[0].width,
+			.height = imx766_modes[0].height,
+		},
+	};
+
+	return imx766_set_pad_format(sd, NULL, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx766_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx766_pad_ops = {
+	.set_fmt = imx766_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = imx766_get_selection,
+	.enum_mbus_code = imx766_enum_mbus_code,
+	.enum_frame_size = imx766_enum_frame_size,
+	.enable_streams = imx766_enable_streams,
+	.disable_streams = imx766_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx766_subdev_ops = {
+	.video = &imx766_video_ops,
+	.pad = &imx766_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx766_internal_ops = {
+	.init_state = imx766_init_state,
+};
+
+static const struct media_entity_operations imx766_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int imx766_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *imx766 = to_imx766(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx766->supplies),
+				    imx766->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(imx766->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(imx766->supplies),
+				       imx766->supplies);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(imx766->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+}
+
+static int imx766_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *imx766 = to_imx766(sd);
+
+	gpiod_set_value_cansleep(imx766->reset_gpio, 1);
+	clk_disable_unprepare(imx766->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(imx766->supplies), imx766->supplies);
+
+	return 0;
+}
+
+static int imx766_check_hwcfg(struct imx766 *imx766)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	struct fwnode_handle *ep;
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(imx766->dev), NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX766_DATA_LANES) {
+		dev_err(imx766->dev, "%u trios, only %u are supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes,
+			IMX766_DATA_LANES);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx766->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx766_link_freq_menu,
+				       ARRAY_SIZE(imx766_link_freq_menu),
+				       &freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int imx766_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx766 *imx766;
+	unsigned int i;
+	u64 val;
+	int ret;
+
+	imx766 = devm_kzalloc(dev, sizeof(*imx766), GFP_KERNEL);
+	if (!imx766)
+		return -ENOMEM;
+
+	imx766->dev = dev;
+	v4l2_i2c_subdev_init(&imx766->sd, client, &imx766_subdev_ops);
+
+	imx766->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx766->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx766->regmap),
+				     "failed to init CCI\n");
+
+	imx766->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx766->mclk))
+		return dev_err_probe(dev, PTR_ERR(imx766->mclk),
+				     "failed to get the clock\n");
+	if (clk_get_rate(imx766->mclk) != IMX766_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "unsupported clock rate %lu\n",
+				     clk_get_rate(imx766->mclk));
+
+	ret = imx766_check_hwcfg(imx766);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad endpoint configuration\n");
+
+	imx766->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx766->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx766->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(imx766_supply_names); i++)
+		imx766->supplies[i].supply = imx766_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx766->supplies),
+				      imx766->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	ret = imx766_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(imx766->regmap, IMX766_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to read the chip ID\n");
+		goto err_power_off;
+	}
+	if (val != IMX766_CHIP_ID) {
+		ret = dev_err_probe(dev, -ENODEV, "chip ID %#llx is not %#x\n",
+				    val, IMX766_CHIP_ID);
+		goto err_power_off;
+	}
+
+	imx766->mode = &imx766_modes[0];
+
+	ret = imx766_init_controls(imx766);
+	if (ret)
+		goto err_power_off;
+
+	imx766->sd.internal_ops = &imx766_internal_ops;
+	imx766->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx766->sd.entity.ops = &imx766_entity_ops;
+	imx766->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx766->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx766->sd.entity, 1, &imx766->pad);
+	if (ret)
+		goto err_ctrls;
+
+	imx766->sd.state_lock = imx766->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx766->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx766->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register the subdev\n");
+		goto err_pm;
+	}
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&imx766->sd);
+err_entity:
+	media_entity_cleanup(&imx766->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&imx766->ctrl_handler);
+err_power_off:
+	imx766_power_off(dev);
+	return ret;
+}
+
+static void imx766_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx766 *imx766 = to_imx766(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx766->ctrl_handler);
+
+	pm_runtime_disable(imx766->dev);
+	if (!pm_runtime_status_suspended(imx766->dev))
+		imx766_power_off(imx766->dev);
+	pm_runtime_set_suspended(imx766->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx766_pm_ops, imx766_power_off,
+				 imx766_power_on, NULL);
+
+static const struct of_device_id imx766_of_match[] = {
+	{ .compatible = "sony,imx766" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx766_of_match);
+
+static struct i2c_driver imx766_i2c_driver = {
+	.driver = {
+		.name = "imx766",
+		.of_match_table = imx766_of_match,
+		.pm = pm_ptr(&imx766_pm_ops),
+	},
+	.probe = imx766_probe,
+	.remove = imx766_remove,
+};
+module_i2c_driver(imx766_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX766 image sensor driver");
+MODULE_LICENSE("GPL");
