From b38feb862905b039165c7af7ff104ef16614af31 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 11:48:43 +0000
Subject: [PATCH 277/286] media: i2c: Add a driver for the Sony IMX766

Add a V4L2 subdev driver for the IMX766 in its 2x2 binned 4096x3072
mode at 30 fps over three C-PHY trios (1164 Msym/s per trio), with
exposure, analogue and digital gain, vertical blanking, flips and the
test patterns. The register settings are those of MediaTek's GPLv2
imgsensor driver for the sensor (imx766_mipi_raw), from the Jolla
Phone JP2601's stock kernel modules.

Tested on the Jolla Phone JP2601 so far only up to probe: the chip ID
(0x0766) reads at the module's I2C address 0x29.
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx766.c | 1538 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1550 insertions(+)
 create mode 100644 drivers/media/i2c/imx766.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 77baeeeee..cfd257f1b 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -343,6 +343,17 @@ config VIDEO_IMX678
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx678.
 
+config VIDEO_IMX766
+	tristate "Sony IMX766 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX766 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx766.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 140c63a58..363d60d6e 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -66,6 +66,7 @@ obj-$(CONFIG_VIDEO_IMX471) += imx471.o
 obj-$(CONFIG_VIDEO_IMX576) += imx576.o
 obj-$(CONFIG_VIDEO_IMX616) += imx616.o
 obj-$(CONFIG_VIDEO_IMX678) += imx678.o
+obj-$(CONFIG_VIDEO_IMX766) += imx766.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
 obj-$(CONFIG_VIDEO_IT6625) += it6625.o
diff --git a/drivers/media/i2c/imx766.c b/drivers/media/i2c/imx766.c
new file mode 100644
index 000000000..15702838c
--- /dev/null
+++ b/drivers/media/i2c/imx766.c
@@ -0,0 +1,1538 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX766 image sensor driver
+ *
+ * The register settings are taken from MediaTek's GPLv2 imgsensor driver
+ * (imx766_mipi_raw) as shipped for the Jolla Phone JP2601. Only the 2x2
+ * binned 4096x3072 mode over three C-PHY trios is supported; the full
+ * 8192x6144 quad Bayer readout needs remosaicing.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define IMX766_MCLK_FREQ		(24 * HZ_PER_MHZ)
+/* OP PLL: 24 MHz / 3 * 291 / 2 = 1164 Msym/s per trio */
+#define IMX766_LINK_FREQ		1164000000ULL
+/* VT pixel clock of the stock mode, as LINE_LENGTH_PCK counts it */
+#define IMX766_PIXEL_RATE		1507200000ULL
+#define IMX766_DATA_LANES		3
+
+#define IMX766_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX766_CHIP_ID			0x0766
+
+#define IMX766_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX766_MODE_STREAMING		BIT(0)
+
+#define IMX766_REG_ORIENTATION		CCI_REG8(0x0101)
+#define IMX766_HFLIP			BIT(0)
+#define IMX766_VFLIP			BIT(1)
+
+#define IMX766_REG_HOLD			CCI_REG8(0x0104)
+
+#define IMX766_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX766_EXPOSURE_MIN		8
+#define IMX766_EXPOSURE_MARGIN		48
+
+#define IMX766_REG_AGAIN		CCI_REG16(0x0204)
+/* Analogue gain is 1024 / (1024 - code), 1x to 16x */
+#define IMX766_AGAIN_MIN		0
+#define IMX766_AGAIN_MAX		960
+#define IMX766_AGAIN_DEFAULT		0
+
+#define IMX766_REG_DGAIN		CCI_REG16(0x020e)
+#define IMX766_DGAIN_MIN		0x0100
+#define IMX766_DGAIN_MAX		0x0fff
+#define IMX766_DGAIN_DEFAULT		0x0100
+
+#define IMX766_REG_VTS			CCI_REG16(0x0340)
+#define IMX766_VTS_MAX			0xffff
+
+#define IMX766_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_imx766(_sd)			container_of(_sd, struct imx766, sd)
+
+static const s64 imx766_link_freq_menu[] = {
+	IMX766_LINK_FREQ,
+};
+
+/* Bayer order for the four flip states, no flip first */
+static const u32 imx766_mbus_formats[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+static const char * const imx766_supply_names[] = {
+	"avdd",		/* analogue, 2.8 V */
+	"dvdd",		/* digital core, 1.1 V */
+	"dovdd",	/* digital I/O, 1.8 V */
+};
+
+static const char * const imx766_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+struct imx766_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx766 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx766_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	const struct imx766_mode *mode;
+};
