 sound/soc/codecs/Makefile |   2 +
 sound/soc/codecs/mt6369.c | 953 ++++++++++++++++++++++++++++++++++++++
 sound/soc/codecs/mt6369.h | 204 ++++++++
 4 files changed, 1167 insertions(+)
 create mode 100644 sound/soc/codecs/mt6369.c
 create mode 100644 sound/soc/codecs/mt6369.h

