+/* The codec is a child of the PMIC, as an MFD cell or a node of its own */
+static struct regmap *mt6369_get_pmic_regmap(struct device *dev)
+{
+	struct device_node *np __free(device_node) = of_get_parent(dev->of_node);
+	struct spmi_device *sdev;
+	struct regmap *regmap;
+
+	regmap = dev_get_regmap(dev->parent, NULL);
+	if (regmap || !np)
+		return regmap;
+
+	sdev = spmi_find_device_by_of_node(np);
+	if (!sdev)
+		return NULL;
+
+	regmap = dev_get_regmap(&sdev->dev, NULL);
+	put_device(&sdev->dev);
+
+	return regmap;
+}
+
+static int mt6369_platform_driver_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6369_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	priv->regmap = mt6369_get_pmic_regmap(dev);
+	if (!priv->regmap)
+		return dev_err_probe(dev, -EPROBE_DEFER, "no PMIC regmap\n");
+
+	priv->clk_xo = devm_clk_get(dev, NULL);
+	if (IS_ERR(priv->clk_xo))
+		return dev_err_probe(dev, PTR_ERR(priv->clk_xo),
+				     "failed to get the 26 MHz clock\n");
+
+	/* Analog microphones, AC coupled, unless the board says otherwise */
+	for (int i = 0; i < MT6369_MIC_NUM; i++)
+		priv->mic_type[i] = MIC_TYPE_MUX_ACC;
+	ret = device_property_read_u32_array(dev, "mediatek,mic-type",
+					     priv->mic_type, MT6369_MIC_NUM);
+	if (ret && ret != -EINVAL)
+		return dev_err_probe(dev, ret, "invalid mediatek,mic-type\n");
+
+	/* The AFE side defaults to protocol 1 until it calibrates the link */
+	priv->mtkaif_protocol = MT6369_MTKAIF_PROTOCOL_1;
+
+	platform_set_drvdata(pdev, priv);
+
+	return devm_snd_soc_register_component(dev,
+					       &mt6369_soc_component_driver,
+					       mt6369_dai_driver,
+					       ARRAY_SIZE(mt6369_dai_driver));
+}
+
+static const struct of_device_id mt6369_of_match[] = {
+	{ .compatible = "mediatek,mt6369-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6369_of_match);
+
+static struct platform_driver mt6369_platform_driver = {
+	.driver = {
+		.name = "mt6369-sound",
+		.of_match_table = mt6369_of_match,
+	},
+	.probe = mt6369_platform_driver_probe,
+};
+module_platform_driver(mt6369_platform_driver);
+
+MODULE_DESCRIPTION("MT6369 ALSA SoC codec driver");
+MODULE_LICENSE("GPL");
