+static int mt6369_codec_probe(struct snd_soc_component *cmpnt)
+{
+	struct mt6369_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	snd_soc_component_init_regmap(cmpnt, priv->regmap);
+
+	return mt6369_codec_init_reg(priv);
+}
