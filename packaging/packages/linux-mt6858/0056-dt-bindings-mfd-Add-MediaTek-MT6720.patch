From 0af6b5e7f993c4ac569e778d51bb0498188b2bce Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 07:58:20 +0000
Subject: [PATCH 056/206] dt-bindings: mfd: Add MediaTek MT6720

The MT6720 is the single cell sibling of the MT6379: a switching
charger with an ADC, a fuel gauge with its own AUXADC and a USB Type-C
and PD port controller, at ten I2C addresses. Describe the core and the
ADC, AUXADC, charger and fuel gauge functions the Jolla Phone uses.
---
 .../bindings/mfd/mediatek,mt6720.yaml         | 147 ++++++++++++++++++
 1 file changed, 147 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml
new file mode 100644
index 000000000..3942c4f2c
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/mediatek,mt6720.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6720 SubPMIC
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The MT6720 is a single cell switching charger with an ADC, a fuel gauge
+  with its own AUXADC, and a USB Type-C and PD port controller. Its
+  registers are split into banks, each at its own I2C address; the node's
+  address is the first bank.
+
+properties:
+  compatible:
+    const: mediatek,mt6720
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 1
+
+  adc:
+    type: object
+    additionalProperties: false
+    description: Charger ADC.
+    properties:
+      compatible:
+        const: mediatek,mt6720-adc
+      '#io-channel-cells':
+        const: 1
+        description: The hardware channel number.
+    required:
+      - compatible
+      - '#io-channel-cells'
+
+  auxadc:
+    type: object
+    additionalProperties: false
+    description: Fuel gauge AUXADC (0 battery voltage, 1 thermistor, 2 reference).
+    properties:
+      compatible:
+        const: mediatek,mt6720-auxadc
+      '#io-channel-cells':
+        const: 1
+    required:
+      - compatible
+      - '#io-channel-cells'
+
+  charger:
+    type: object
+    $ref: /schemas/power/supply/power-supply.yaml#
+    unevaluatedProperties: false
+    properties:
+      compatible:
+        const: mediatek,mt6720-charger
+      io-channels:
+        items:
+          - description: VBUS voltage
+          - description: VBUS current
+      io-channel-names:
+        items:
+          - const: vbus
+          - const: ibus
+    required:
+      - compatible
+      - io-channels
+      - io-channel-names
+
+  fuel-gauge:
+    type: object
+    $ref: /schemas/power/supply/power-supply.yaml#
+    unevaluatedProperties: false
+    properties:
+      compatible:
+        const: mediatek,mt6720-gauge
+      io-channels:
+        items:
+          - description: battery voltage
+          - description: battery thermistor
+          - description: thermistor reference
+          - description: battery charge current
+      io-channel-names:
+        items:
+          - const: batsns
+          - const: baton
+          - const: vref
+          - const: ibat
+      monitored-battery: true
+    required:
+      - compatible
+      - io-channels
+      - io-channel-names
+      - monitored-battery
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@34 {
+            compatible = "mediatek,mt6720";
+            reg = <0x34>;
+
+            mt6720_adc: adc {
+                compatible = "mediatek,mt6720-adc";
+                #io-channel-cells = <1>;
+            };
+
+            mt6720_auxadc: auxadc {
+                compatible = "mediatek,mt6720-auxadc";
+                #io-channel-cells = <1>;
+            };
+
+            mt6720_charger: charger {
+                compatible = "mediatek,mt6720-charger";
+                io-channels = <&mt6720_adc 11>, <&mt6720_adc 5>;
+                io-channel-names = "vbus", "ibus";
+            };
+
+            fuel-gauge {
+                compatible = "mediatek,mt6720-gauge";
+                io-channels = <&mt6720_auxadc 0>, <&mt6720_auxadc 1>,
+                              <&mt6720_auxadc 2>, <&mt6720_adc 6>;
+                io-channel-names = "batsns", "baton", "vref", "ibat";
+                monitored-battery = <&battery>;
+                power-supplies = <&mt6720_charger>;
+            };
+        };
+    };
-- 
