From e92c0f2b9ff74e128ecaf6f2cfe3bee70fb7d36c Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:38:34 +0000
Subject: [PATCH 114/214] arm64: dts: mediatek: mt6858-jolla-jp2601: Enable the
 GPU

LK loads the GPUEB firmware and starts it. The first 16 KiB of the EB's
reserved memory (gpueb-mem-table: MEM_ID_GPUFREQ, 0x4000 bytes) are its
GPU-DVFS shared status; give that part its own node for the gpufreq
power domain, and keep the rest reserved.
---
 .../boot/dts/mediatek/mt6858-jolla-jp2601.dts | 23 +++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 4dde1bebb..ceb58e219 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -188,8 +188,14 @@ sspm-shared@7f9e0000 {
 			no-map;
 		};
 
-		gpueb-shared@7faf0000 {
-			reg = <0 0x7faf0000 0 0x180000>;
+		/* The first 16 KiB are the GPUEB's GPU-DVFS shared status. */
+		gpufreq_shmem: gpufreq-shared@7faf0000 {
+			reg = <0 0x7faf0000 0 0x4000>;
+			no-map;
+		};
+
+		gpueb-shared@7faf4000 {
+			reg = <0 0x7faf4000 0 0x17c000>;
 			no-map;
 		};
 
@@ -400,6 +406,19 @@ &dsi0 {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpueb_mbox {
+	status = "okay";
+};
+
+&gpufreq {
+	memory-region = <&gpufreq_shmem>;
+	status = "okay";
+};
+
 &i2c1 {
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
-- 
2.55.0

