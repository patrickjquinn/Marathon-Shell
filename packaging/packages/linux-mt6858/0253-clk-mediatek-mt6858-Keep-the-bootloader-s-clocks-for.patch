+ * The modem's AP interfaces (CCIF, CLDMA, DPMAIF). The bootloader starts
+ * MD1 with them running and ECCCI takes no clocks: keep them on.
+ */
 #define GATE_INFRA_INFRACFG_AO_REG0(_id, _name, _parent, _shift) {	\
 		.id = _id,				\
 		.name = _name,				\
 		.parent_name = _parent,			\
 		.regs = &infra_infracfg_ao_reg0_cg_regs,		\
 		.shift = _shift,			\
+		.flags = CLK_IGNORE_UNUSED,		\
 		.ops = &mtk_clk_gate_ops_setclr,	\
 	}
 
