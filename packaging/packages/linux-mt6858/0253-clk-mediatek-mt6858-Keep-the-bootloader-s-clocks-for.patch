 		.parent_name = _parent,			\
 		.regs = &infra_infracfg_ao_reg1_cg_regs,		\
 		.shift = _shift,			\
+		.flags = CLK_IGNORE_UNUSED,		\
 		.ops = &mtk_clk_gate_ops_setclr,	\
