From 0b9fb5ef2dd62bfae18c6b096c9ce217f78de9b2 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 03:02:28 +0000
Subject: [PATCH 20/24] dt-bindings: input: touchscreen: Add Hynitron CST66xx

The CST66xx series are Hynitron touchscreen controllers on SPI, as used
in the Jolla Phone (JP2601).
---
 .../input/touchscreen/hynitron,cst66xx.yaml   | 61 +++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/hynitron,cst66xx.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/hynitron,cst66xx.yaml b/Documentation/devicetree/bindings/input/touchscreen/hynitron,cst66xx.yaml
new file mode 100644
index 000000000..6ff1dc967
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/hynitron,cst66xx.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/hynitron,cst66xx.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Hynitron CST66xx series SPI touchscreen controllers
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: hynitron,cst66xx
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  vdd-supply: true
+
+  vddio-supply: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "hynitron,cst66xx";
+            reg = <0>;
+            spi-max-frequency = <1000000>;
+            spi-cs-setup-delay-ns = <20000>;
+            interrupt-parent = <&pio>;
+            interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&pio 137 GPIO_ACTIVE_LOW>;
+            touchscreen-size-x = <1032>;
+            touchscreen-size-y = <2272>;
+        };
+    };
-- 
