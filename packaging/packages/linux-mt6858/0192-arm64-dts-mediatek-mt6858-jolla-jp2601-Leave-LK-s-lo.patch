From a3965b81817c6a5e46c02c803b755d3054b88e93 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 22:38:46 +0000
Subject: [PATCH 192/202] arm64: dts: mediatek: mt6858-jolla-jp2601: Leave LK's
 log store unmapped

The 512 KiB log store holds the current boot's LK and preloader logs.
As reserved System RAM, STRICT_DEVMEM keeps /dev/mem out of it, so
nothing in Linux can read those logs. Mark it no-map, as its neighbours
are, so it is no longer System RAM and /dev/mem can read it.
---
 arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 68a34faf8..962d3e4f5 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -536,8 +536,10 @@ gz-ffa-mailbox@33ff60000 {
 			no-map;
 		};
 
+		/* LK's and the preloader's log, readable through /dev/mem */
 		log-store@33ff70000 {
 			reg = <0x3 0x3ff70000 0 0x80000>;
+			no-map;
 		};
 
 		dramc-rk1@33fff0000 {
-- 
2.55.0

