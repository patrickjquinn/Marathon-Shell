From 7b4fd2ab7989e980f01a014726d72067283cc5f1 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 17:59:30 +0000
Subject: [PATCH 004/165] dt-bindings: mfd: mediatek,mt8195-scpsys: Add MT6858

The MT6858 SCPSYS block at 0x1c001000 holds the MTCMOS controls that the
merged mediatek,mt6858-power-controller drives. Add its compatible so the
power controller can sit under it as on the other MediaTek SoCs.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 .../devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml          | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
index 9f073d0c2..82959fa96 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt8195-scpsys.yaml
@@ -20,6 +20,7 @@ properties:
     items:
       - enum:
           - mediatek,mt6795-scpsys
+          - mediatek,mt6858-scpsys
           - mediatek,mt6893-scpsys
           - mediatek,mt8167-scpsys
           - mediatek,mt8173-scpsys
-- 
2.55.0

