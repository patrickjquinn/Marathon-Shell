# What a Marathon image needs on top of defconfig and mt6858.config.
CONFIG_LOCALVERSION="-mt6858"
# CONFIG_LOCALVERSION_AUTO is not set
# systemd-boot starts /linux.efi from the ESP.
CONFIG_EFI_ZBOOT=y
# The initramfs mounts the ESP with iocharset=ascii.
CONFIG_NLS_ASCII=y
# U-Boot's EFI framebuffer is LK's panel again: simpledrm, from the DT
# node U-Boot fills in, is the only driver for it, so Plymouth and the
# shell find one DRM card.
# CONFIG_FB_EFI is not set
# The encrypted /home (docs/ENCRYPTION.md).
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_DM_VERITY=m
CONFIG_EROFS_FS=m
CONFIG_ZRAM=m
# systemd-oomd and Android's lmkd read pressure.
CONFIG_PSI=y
# The app runners' sandbox (crates/marathon-app-native/src/confine.rs).
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
# Deckard: Android in an LXC container, as on the Q25.
# Mainline's binder is the Rust one, with binderfs built in.
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY_SELINUX=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
# Android's netd programs legacy iptables tables.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
# The matches and targets netd's rules use, as on the Q25 (connection
# marks, idle timers, quotas, MSS clamping for tethering, NFLOG).
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
# The host's iptables is iptables-nft: Deckard's bridge rules (filter,
# nat MASQUERADE, mangle CHECKSUM) need the ip/ip6/inet families and the
# nat chain type, as on the Q25.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_DUMMY=m

# Virtual input: the shell's touch and key tools (marathon-touchctl) and
# Bluetooth HID; the image loads both modules at boot.
CONFIG_INPUT_UINPUT=m
CONFIG_UHID=m
