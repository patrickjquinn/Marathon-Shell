From 329030d2297ebf8ad897cd4c715c7fb929ebe111 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 05:45:34 +0000
Subject: [PATCH 050/167] soc: mediatek: mutex: Add MT6858

Add the MT6858 display mutex. It has the MT8183 register layout. The
module bits and the SOF/EOF encoding come from MediaTek's GPLv2 display
driver. The bootloader leaves the same SOF value (DSI0 | EOF DSI0 <<
6) in mutex 0.
---
 drivers/soc/mediatek/mtk-mutex.c | 48 ++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/drivers/soc/mediatek/mtk-mutex.c b/drivers/soc/mediatek/mtk-mutex.c
index 6d4e475cb..564e14d04 100644
--- a/drivers/soc/mediatek/mtk-mutex.c
+++ b/drivers/soc/mediatek/mtk-mutex.c
@@ -66,6 +66,24 @@
 #define MT8186_MUTEX_EOF_DSI0			(MT8186_MUTEX_SOF_DSI0 << 6)
 #define MT8186_MUTEX_EOF_DPI0			(MT8186_MUTEX_SOF_DPI0 << 6)
 
+#define MT6858_MUTEX_MOD_DISP_OVL0_2L		0
+#define MT6858_MUTEX_MOD_DISP_OVL1_2L		1
+#define MT6858_MUTEX_MOD_DISP_OVL2_2L		2
+#define MT6858_MUTEX_MOD_DISP_COLOR0		9
+#define MT6858_MUTEX_MOD_DISP_CCORR0		10
+#define MT6858_MUTEX_MOD_DISP_AAL0		12
+#define MT6858_MUTEX_MOD_DISP_GAMMA0		13
+#define MT6858_MUTEX_MOD_DISP_POSTMASK0		14
+#define MT6858_MUTEX_MOD_DISP_DITHER0		15
+#define MT6858_MUTEX_MOD_DISP_DSC0		23
+#define MT6858_MUTEX_MOD_DISP_WDMA1		27
+#define MT6858_MUTEX_MOD_DISP_PWM0		28
+
+#define MT6858_MUTEX_SOF_DSI0			1
+#define MT6858_MUTEX_SOF_DSI1			2
+#define MT6858_MUTEX_EOF_DSI0			(MT6858_MUTEX_SOF_DSI0 << 6)
+#define MT6858_MUTEX_EOF_DSI1			(MT6858_MUTEX_SOF_DSI1 << 6)
+
 #define MT8167_MUTEX_MOD_DISP_PWM		1
 #define MT8167_MUTEX_MOD_DISP_OVL0		6
 #define MT8167_MUTEX_MOD_DISP_OVL1		7
@@ -554,6 +572,21 @@ static const u8 mt8188_mdp_mutex_table_mod[MUTEX_MOD_IDX_MAX] = {
 	[MUTEX_MOD_IDX_MDP_WROT3] = MT8195_MUTEX_MOD_MDP_WROT3,
 };
 
+static const u8 mt6858_mutex_mod[DDP_COMPONENT_ID_MAX] = {
+	[DDP_COMPONENT_AAL0] = MT6858_MUTEX_MOD_DISP_AAL0,
+	[DDP_COMPONENT_CCORR] = MT6858_MUTEX_MOD_DISP_CCORR0,
+	[DDP_COMPONENT_COLOR0] = MT6858_MUTEX_MOD_DISP_COLOR0,
+	[DDP_COMPONENT_DITHER0] = MT6858_MUTEX_MOD_DISP_DITHER0,
+	[DDP_COMPONENT_DSC0] = MT6858_MUTEX_MOD_DISP_DSC0,
+	[DDP_COMPONENT_GAMMA] = MT6858_MUTEX_MOD_DISP_GAMMA0,
+	[DDP_COMPONENT_OVL_2L0] = MT6858_MUTEX_MOD_DISP_OVL0_2L,
+	[DDP_COMPONENT_OVL_2L1] = MT6858_MUTEX_MOD_DISP_OVL1_2L,
+	[DDP_COMPONENT_OVL_2L2] = MT6858_MUTEX_MOD_DISP_OVL2_2L,
+	[DDP_COMPONENT_POSTMASK0] = MT6858_MUTEX_MOD_DISP_POSTMASK0,
+	[DDP_COMPONENT_PWM0] = MT6858_MUTEX_MOD_DISP_PWM0,
+	[DDP_COMPONENT_WDMA1] = MT6858_MUTEX_MOD_DISP_WDMA1,
+};
+
 static const u8 mt8192_mutex_mod[DDP_COMPONENT_ID_MAX] = {
 	[DDP_COMPONENT_AAL0] = MT8192_MUTEX_MOD_DISP_AAL0,
 	[DDP_COMPONENT_CCORR] = MT8192_MUTEX_MOD_DISP_CCORR0,
@@ -685,6 +718,12 @@ static const u16 mt8167_mutex_sof[DDP_MUTEX_SOF_MAX] = {
 	[MUTEX_SOF_DPI1] = MT8167_MUTEX_SOF_DPI1,
 };
 
+static const u16 mt6858_mutex_sof[DDP_MUTEX_SOF_MAX] = {
+	[MUTEX_SOF_SINGLE_MODE] = MUTEX_SOF_SINGLE_MODE,
+	[MUTEX_SOF_DSI0] = MT6858_MUTEX_SOF_DSI0 | MT6858_MUTEX_EOF_DSI0,
+	[MUTEX_SOF_DSI1] = MT6858_MUTEX_SOF_DSI1 | MT6858_MUTEX_EOF_DSI1,
+};
+
 /* Add EOF setting so overlay hardware can receive frame done irq */
 static const u16 mt8183_mutex_sof[DDP_MUTEX_SOF_MAX] = {
 	[MUTEX_SOF_SINGLE_MODE] = MUTEX_SOF_SINGLE_MODE,
@@ -754,6 +793,14 @@ static const struct mtk_mutex_data mt6795_mutex_driver_data = {
 	.mutex_sof_reg = MT2701_MUTEX0_SOF0,
 };
 
+static const struct mtk_mutex_data mt6858_mutex_driver_data = {
+	.mutex_mod = mt6858_mutex_mod,
+	.mutex_sof = mt6858_mutex_sof,
+	.mutex_mod_reg = MT8183_MUTEX0_MOD0,
+	.mutex_mod1_reg = MT8183_MUTEX0_MOD1,
+	.mutex_sof_reg = MT8183_MUTEX0_SOF0,
+};
+
 static const struct mtk_mutex_data mt8167_mutex_driver_data = {
 	.mutex_mod = mt8167_mutex_mod,
 	.mutex_sof = mt8167_mutex_sof,
@@ -1134,6 +1181,7 @@ static const struct of_device_id mutex_driver_dt_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-mutex", .data = &mt2701_mutex_driver_data },
 	{ .compatible = "mediatek,mt2712-disp-mutex", .data = &mt2712_mutex_driver_data },
 	{ .compatible = "mediatek,mt6795-disp-mutex", .data = &mt6795_mutex_driver_data },
+	{ .compatible = "mediatek,mt6858-disp-mutex", .data = &mt6858_mutex_driver_data },
 	{ .compatible = "mediatek,mt8167-disp-mutex", .data = &mt8167_mutex_driver_data },
 	{ .compatible = "mediatek,mt8173-disp-mutex", .data = &mt8173_mutex_driver_data },
 	{ .compatible = "mediatek,mt8183-disp-mutex", .data = &mt8183_mutex_driver_data },
-- 
2.55.0

