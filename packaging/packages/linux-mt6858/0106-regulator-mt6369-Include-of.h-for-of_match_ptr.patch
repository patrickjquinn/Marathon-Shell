From b842a1770194e416f9b89dc09b30e98d4c6e104b Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 10:09:29 +0000
Subject: [PATCH 106/181] regulator: mt6369: Include of.h for of_match_ptr()

None of the other headers the driver includes brings in of.h, so
of_match_ptr() is undeclared and the driver does not build.
---
 drivers/regulator/mt6369-regulator.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/regulator/mt6369-regulator.c b/drivers/regulator/mt6369-regulator.c
index 4241988b4..fc3eec7a9 100644
--- a/drivers/regulator/mt6369-regulator.c
+++ b/drivers/regulator/mt6369-regulator.c
@@ -8,6 +8,7 @@
 
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/regulator/driver.h>
