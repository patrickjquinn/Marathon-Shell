From 1df3436f21ebf968676abf443c4faf02715f27a1 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 10:47:54 +0000
Subject: [PATCH 117/165] drm/panthor: Drop the MediaTek MT6858 compatible

The MT6858's Mali-G610 is an arch 10 GPU, which cannot take a custom
ASN hash: with the MT8196 SoC data, Panthor logs "Custom ASN hash not
supported by the device" at every power-up. The vendor device tree's
#l2-hash-values is a leftover of its kbase integration. Without SoC
data, the MT6858 GPU matches the generic arm,mali-valhall-csf entry,
which is all it needs.

This reverts commit cb4d073fd ("drm/panthor: Add the MediaTek MT6858
compatible").
---
 drivers/gpu/drm/panthor/panthor_drv.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/gpu/drm/panthor/panthor_drv.c b/drivers/gpu/drm/panthor/panthor_drv.c
index 63f84636e..dc8d0191a 100644
--- a/drivers/gpu/drm/panthor/panthor_drv.c
+++ b/drivers/gpu/drm/panthor/panthor_drv.c
@@ -1878,7 +1878,6 @@ static const struct panthor_soc_data soc_data_mediatek_mt8196 = {
 };
 
 static const struct of_device_id dt_match[] = {
-	{ .compatible = "mediatek,mt6858-mali", .data = &soc_data_mediatek_mt8196, },
 	{ .compatible = "mediatek,mt8196-mali", .data = &soc_data_mediatek_mt8196, },
 	{ .compatible = "rockchip,rk3588-mali" },
 	{ .compatible = "arm,mali-valhall-csf" },
