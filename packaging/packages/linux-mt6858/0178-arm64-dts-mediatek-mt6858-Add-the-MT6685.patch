From 5bdc41ed1ed8e50333c0fd7feea48135b2205725 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 19:37:07 +0000
Subject: [PATCH 178/181] arm64: dts: mediatek: mt6858: Add the MT6685

The MT6685 is the clock-buffer and RTC PMIC at SID 9 on the main SPMI
bus. Its XO_BBCK5 buffer is the MT6369 audio codec's 26 MHz clock, and
the connectivity and modem blocks draw on its other buffers, so give it
a node that their consumers can reference.
---
 arch/arm64/boot/dts/mediatek/mt6858.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858.dtsi b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
index a610a8619..d52dbfcae 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
@@ -914,6 +914,13 @@ mt6363: pmic@4 {
 					#size-cells = <0>;
 				};
 
+				/* Clock buffers (XO_BBCKn) and RTC */
+				mt6685: pmic@9 {
+					compatible = "mediatek,mt6685";
+					reg = <0x9 SPMI_USID>;
+					#clock-cells = <1>;
+				};
+
 				/*
 				 * Wired to the SPMI-P pads, but the downstream driver
 				 * reaches it through this PMIF (spmi-dev-mask = 0).
-- 
2.55.0

