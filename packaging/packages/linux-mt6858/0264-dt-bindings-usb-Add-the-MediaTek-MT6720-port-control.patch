From 507852e71e41121a4708434bdb973821a76b1d30 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 10:56:28 +0000
Subject: [PATCH 264/271] dt-bindings: usb: Add the MediaTek MT6720 port
 controller

The MT6720 SubPMIC has a TCPCI Type-C and PD port controller and an OTG
boost that sources VBUS. Describe the port controller as a child of the
MT6720 with its connector, and the boost as a regulator under the
charger.
---
 .../bindings/mfd/mediatek,mt6720.yaml         | 32 +++++++++++++++++
 .../bindings/usb/mediatek,mt6720-tcpc.yaml    | 36 +++++++++++++++++++
 2 files changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/mediatek,mt6720-tcpc.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml
index 3f6eb3304..2adfce57d 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6720.yaml
@@ -81,6 +81,11 @@ properties:
         items:
           - const: vbus
           - const: ibus
+      usb-otg-vbus-regulator:
+        type: object
+        $ref: /schemas/regulator/regulator.yaml#
+        unevaluatedProperties: false
+        description: OTG boost, supplying VBUS from the battery.
     required:
       - compatible
       - io-channels
@@ -113,6 +118,11 @@ properties:
       - io-channel-names
       - monitored-battery
 
+  tcpc:
+    type: object
+    $ref: /schemas/usb/mediatek,mt6720-tcpc.yaml#
+    unevaluatedProperties: false
+
 required:
   - compatible
   - reg
@@ -151,6 +161,12 @@ examples:
                 io-channels = <&mt6720_adc 11>, <&mt6720_adc 5>;
                 io-channel-names = "vbus", "ibus";
                 monitored-battery = <&battery>;
+
+                usb-otg-vbus-regulator {
+                    regulator-name = "mt6720-usb-otg-vbus";
+                    regulator-min-microvolt = <5000000>;
+                    regulator-max-microvolt = <5000000>;
+                };
             };
 
             fuel-gauge {
@@ -161,5 +177,21 @@ examples:
                 monitored-battery = <&battery>;
                 power-supplies = <&mt6720_charger>;
             };
+
+            tcpc {
+                compatible = "mediatek,mt6720-tcpc";
+                interrupts = <104>;
+
+                connector {
+                    compatible = "usb-c-connector";
+                    label = "USB-C";
+                    data-role = "dual";
+                    power-role = "dual";
+                    try-power-role = "sink";
+                    source-pdos = <0x26019096>;
+                    sink-pdos = <0x260190c8>;
+                    op-sink-microwatt = <10000000>;
+                };
+            };
         };
     };
diff --git a/Documentation/devicetree/bindings/usb/mediatek,mt6720-tcpc.yaml b/Documentation/devicetree/bindings/usb/mediatek,mt6720-tcpc.yaml
new file mode 100644
index 000000000..3961fbe4c
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/mediatek,mt6720-tcpc.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/mediatek,mt6720-tcpc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6720 USB Type-C and Power Delivery port controller
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The TCPCI port controller in the MediaTek MT6720 SubPMIC. It is a child
+  of the MT6720 node, whose interrupt controller carries its alert.
+
+properties:
+  compatible:
+    const: mediatek,mt6720-tcpc
+
+  interrupts:
+    maxItems: 1
+
+  vdd-vbus-supply:
+    description: Supply that sources VBUS when the port is a source.
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - interrupts
+  - connector
+
+additionalProperties: false
-- 
2.55.0

