From 97e60937e5ba8295828d5e946145a14ed5cddd75 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 07:58:23 +0000
Subject: [PATCH 059/167] power: supply: Add MediaTek MT6720 charger and
 battery monitor

The charger supply reports power-good, whether the buck and charging
are enabled, the charge current and voltage, input current and voltage
limits and termination current (register fields and ranges from
MediaTek's mt6379-chg driver with its MT6720 overrides), and VBUS
voltage and current from the ADC. It changes nothing: the bootloader's
settings stay until the driver can manage charging safely.

The battery supply reports the cell voltage, the charge current, the
thermistor temperature and a capacity estimated from the monitored
battery's OCV table after the drop across its internal resistance. The
thermistor is a 10 kOhm NTC pulled up through 24 kOhm to the AUXADC
reference, with the Murata NCP15XH103 table, as in MediaTek's stock gauge
(fg_temp_table, RBAT_PULL_UP_R). The coulomb counter is not used yet.
---
 drivers/power/supply/Kconfig          |  13 ++
 drivers/power/supply/Makefile         |   1 +
 drivers/power/supply/mt6720-battery.c | 270 ++++++++++++++++++++++++++
 drivers/power/supply/mt6720-charger.c | 238 +++++++++++++++++++++++
 4 files changed, 522 insertions(+)
 create mode 100644 drivers/power/supply/mt6720-battery.c
 create mode 100644 drivers/power/supply/mt6720-charger.c

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index ee7dc5f26..243c0f76b 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -731,6 +731,19 @@ config CHARGER_MT6370
 	  This driver can also be built as a module. If so, the module
 	  will be called "mt6370-charger".
 
+config CHARGER_MT6720
+	tristate "MediaTek MT6720 charger and battery monitor"
+	depends on MFD_MT6720
+	depends on IIO
+	select LINEAR_RANGES
+	help
+	  Say Y here to enable the MediaTek MT6720 charger and battery
+	  power supplies: charger state and settings, battery voltage,
+	  charge current, temperature and an OCV-based capacity.
+
+	  This driver can also be built as modules. If so, the modules
+	  will be called "mt6720-charger" and "mt6720-battery".
+
 config CHARGER_QCOM_SMBB
 	tristate "Qualcomm Switch-Mode Battery Charger and Boost"
 	depends on MFD_SPMI_PMIC || COMPILE_TEST
