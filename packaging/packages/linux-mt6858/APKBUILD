# MT6858 kernel, one for every board on the SoC: mainline at 4dce97c6c
# (after v7.4-rc4) with the MT6858 series below, built from arm64 defconfig,
# the series' mt6858.config and marathon.config. The patches are
# git format-patch 4dce97c6c..d2c834312 of the jp2601/initial branch
# plus 0185-0186 from jp2601/deckard and git format-patch
# d2c834312..93ee882fe of jp2601/modem (the audio and flash LED series, the
# battery fix, then the MD1 modem) from 0215, and git format-patch
# 7b28de873..95d6c37c9 of jp2601/camera-r21 (the IMX616 and IMX766 sensors,
# CAM_MAIN's bus protection, the camera SMI path, the MM IOMMU and its
# GenieZone hyp-MMU sync) from 0274, then 0288 from jp2601/power-r23
# (the GPUEB mailbox RX race)
# (devices/jolla/jp2601/BRINGUP.md says what each one is).
pkgname=linux-mt6858
pkgver=7.4.0_rc4_git20261124
pkgrel=23
_commit=4dce97c6c265544342e716e62fd24bbb232590c5
_release=7.4.0-rc4-mt6858
# MediaTek's CONNSYS (Wi-Fi, Bluetooth, GNSS) drivers that modules/ builds:
