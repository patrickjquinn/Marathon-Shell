prepare() {
	default_prepare
	cp "$srcdir/marathon.config" arch/arm64/configs/marathon.config
	make ARCH=arm64 LLVM=1 defconfig mt6858.config marathon.config
	# A fragment line the config dropped is a dependency it lacks.
	local line missing=
	while read -r line; do
		case $line in CONFIG_*=*) ;; *) continue ;; esac
		grep -qxF "$line" .config || missing="$missing $line"
	done < "$srcdir/marathon.config"
	[ -z "$missing" ] || { error "not in .config:$missing"; return 1; }
}

_dtbs() {
	local d
	for d in arch/arm64/boot/dts/mediatek/mt6858-*.dts; do
		echo "mediatek/$(basename "$d" .dts).dtb"
	done
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
	make ARCH=arm64 LLVM=1 Image vmlinuz.efi modules $(_dtbs)
	[ "$(cat include/config/kernel.release)" = "$_release" ]
}

package() {
	make ARCH=arm64 LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
	rm -f "$pkgdir"/usr/lib/modules/$_release/build
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/linux.efi
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/usr/lib/modules/$_release/vmlinuz
	local dtb
	for dtb in $(_dtbs); do
		install -Dm644 "arch/arm64/boot/dts/$dtb" "$pkgdir/boot/dtbs/$dtb"
	done
	install -Dm644 include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/mt6858/kernel.release
}

