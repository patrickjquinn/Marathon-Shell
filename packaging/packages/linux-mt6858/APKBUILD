# MT6858 kernel, one for every board on the SoC: mainline at 4dce97c6c
# (after v7.4-rc4) with the MT6858 series below, built from arm64 defconfig,
# the series' mt6858.config and marathon.config. The patches are
# git format-patch 4dce97c6c..c4392f89b of the jp2601/initial branch
# (devices/jolla/jp2601/BRINGUP.md says what each one is).
pkgname=linux-mt6858
pkgver=7.4.0_rc4_git20261124
pkgrel=0
_commit=4dce97c6c265544342e716e62fd24bbb232590c5
_release=7.4.0-rc4-mt6858
pkgdesc="MediaTek Dimensity 7100 (MT6858) kernel"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
# LLVM=1: the Rust binder Deckard needs (marathon.config).
makedepends="
	bash
	bc
	bison
	clang
	coreutils
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
	rust
	rust-bindgen
	rust-src
	zstd
"
source="linux-$_commit.tar.gz::https://github.com/torvalds/linux/archive/$_commit.tar.gz
	0001-dt-bindings-vendor-prefixes-Add-Jolla-Mobile-Ltd.patch
	0002-dt-bindings-arm-mediatek-Add-Jolla-Phone-JP2601.patch
	0003-dt-bindings-mfd-syscon-Add-MT6858-bus-protection-blo.patch
	0004-dt-bindings-mfd-mediatek-mt8195-scpsys-Add-MT6858.patch
	0005-dt-bindings-serial-mediatek-uart-Add-MT6858.patch
	0006-dt-bindings-watchdog-mediatek-mtk-wdt-Add-MT6858.patch
	0007-dt-bindings-usb-mediatek-mtu3-Add-MT6858.patch
	0008-dt-bindings-phy-mediatek-xsphy-Add-MT6858.patch
	0009-arm64-dts-mediatek-Add-MT6858-SoC.patch
	0010-arm64-dts-mediatek-mt6858-Add-UFS-and-USB-on-a-stand.patch
	0011-arm64-dts-mediatek-Add-Jolla-Phone-JP2601.patch
	0012-arm64-configs-Add-an-MT6858-first-boot-fragment.patch
	0013-arm64-configs-mt6858-Leave-KVM-out.patch
	0014-arm64-configs-mt6858-Add-the-16x32-console-font.patch
	0015-dt-bindings-usb-mediatek-mtu3-Add-mediatek-force-vbu.patch
	0016-usb-mtu3-Force-VBUS-valid-for-device-mode-when-it-is.patch
	0017-arm64-dts-mediatek-mt6858-jolla-jp2601-Force-VBUS-fo.patch
	marathon.config
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/marathon.config" arch/arm64/configs/marathon.config
	make ARCH=arm64 LLVM=1 defconfig mt6858.config marathon.config
	# A fragment line the config dropped is a dependency it lacks.
	local line missing=
	while read -r line; do
		case $line in CONFIG_*=*) ;; *) continue ;; esac
		grep -qxF "$line" .config || missing="$missing $line"
	done < "$srcdir/marathon.config"
	[ -z "$missing" ] || { error "not in .config:$missing"; return 1; }
}

_dtbs() {
	local d
	for d in arch/arm64/boot/dts/mediatek/mt6858-*.dts; do
		echo "mediatek/$(basename "$d" .dts).dtb"
	done
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
	make ARCH=arm64 LLVM=1 Image vmlinuz.efi modules $(_dtbs)
	[ "$(cat include/config/kernel.release)" = "$_release" ]
}

package() {
	make ARCH=arm64 LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
	rm -f "$pkgdir"/usr/lib/modules/$_release/build
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/linux.efi
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/usr/lib/modules/$_release/vmlinuz
	local dtb
	for dtb in $(_dtbs); do
		install -Dm644 "arch/arm64/boot/dts/$dtb" "$pkgdir/boot/dtbs/$dtb"
	done
	install -Dm644 include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/mt6858/kernel.release
}

