From 9915b08a1a62a6808e8f5dbdeafb95f891b090a3 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 12:03:33 +0000
Subject: [PATCH 152/181] soc: mediatek: mtk-mutex: Add the MT6858 DSI0 as a
 mutex module

On MT6858 the DSI is not only the mutex's start-of-frame source but also
one of its modules (bit 25 of MOD0): the vendor mutex table maps DSI0 to
BIT(25), and the bootloader's working pipeline runs with MOD0 =
0x1280f7c7, DSI0 included. Without the bit the DSI ran its video timing
but took no pixels (INTSTA buffer underrun) while OVL and DSC stalled
after the first ~20 lines of the frame, so no frame ever completed.

Let the SoC data mark the interface as a mutex module as well, and do
so for MT6858.
---
 drivers/soc/mediatek/mtk-mutex.c | 41 +++++++++++++++++++-------------
 1 file changed, 25 insertions(+), 16 deletions(-)

diff --git a/drivers/soc/mediatek/mtk-mutex.c b/drivers/soc/mediatek/mtk-mutex.c
index dbf6ea07b..c757121f9 100644
--- a/drivers/soc/mediatek/mtk-mutex.c
+++ b/drivers/soc/mediatek/mtk-mutex.c
@@ -76,6 +76,7 @@
 #define MT6858_MUTEX_MOD_DISP_POSTMASK0		14
 #define MT6858_MUTEX_MOD_DISP_DITHER0		15
 #define MT6858_MUTEX_MOD_DISP_DSC0		23
+#define MT6858_MUTEX_MOD_DISP_DSI0		25
 #define MT6858_MUTEX_MOD_DISP_WDMA1		27
 #define MT6858_MUTEX_MOD_DISP_PWM0		28
 
@@ -374,6 +375,8 @@ struct mtk_mutex_data {
 	const u16 mutex_mod1_reg;
 	const u16 mutex_sof_reg;
 	const bool no_clk;
+	/* The interface that sets the SOF is also a module of the mutex */
+	const bool intf_is_mod;
 };
 
 struct mtk_mutex_ctx {
@@ -578,6 +581,7 @@ static const u8 mt6858_mutex_mod[DDP_COMPONENT_ID_MAX] = {
 	[DDP_COMPONENT_COLOR0] = MT6858_MUTEX_MOD_DISP_COLOR0,
 	[DDP_COMPONENT_DITHER0] = MT6858_MUTEX_MOD_DISP_DITHER0,
 	[DDP_COMPONENT_DSC0] = MT6858_MUTEX_MOD_DISP_DSC0,
+	[DDP_COMPONENT_DSI0] = MT6858_MUTEX_MOD_DISP_DSI0,
 	[DDP_COMPONENT_GAMMA] = MT6858_MUTEX_MOD_DISP_GAMMA0,
 	[DDP_COMPONENT_OVL_2L0] = MT6858_MUTEX_MOD_DISP_OVL0_2L,
 	[DDP_COMPONENT_OVL_2L1] = MT6858_MUTEX_MOD_DISP_OVL1_2L,
@@ -799,6 +803,7 @@ static const struct mtk_mutex_data mt6858_mutex_driver_data = {
 	.mutex_mod_reg = MT8183_MUTEX0_MOD0,
 	.mutex_mod1_reg = MT8183_MUTEX0_MOD1,
 	.mutex_sof_reg = MT8183_MUTEX0_SOF0,
+	.intf_is_mod = true,
 };
 
 static const struct mtk_mutex_data mt8167_mutex_driver_data = {
@@ -953,14 +958,25 @@ void mtk_mutex_unprepare(struct mtk_mutex *mutex)
 }
 EXPORT_SYMBOL_GPL(mtk_mutex_unprepare);
 
+static void mtk_mutex_set_mod(struct mtk_mutex_ctx *mtx, unsigned int mutex_id,
+			      enum mtk_ddp_comp_id id, bool set)
+{
+	unsigned int offset = DISP_REG_MUTEX_MOD(mtx, mtx->data->mutex_mod[id], mutex_id);
+	unsigned int reg = readl_relaxed(mtx->regs + offset);
+
+	if (set)
+		reg |= BIT(mtx->data->mutex_mod[id] % 32);
+	else
+		reg &= ~BIT(mtx->data->mutex_mod[id] % 32);
+	writel_relaxed(reg, mtx->regs + offset);
+}
+
 void mtk_mutex_add_comp(struct mtk_mutex *mutex,
 			enum mtk_ddp_comp_id id)
 {
 	struct mtk_mutex_ctx *mtx = container_of(mutex, struct mtk_mutex_ctx,
 						 mutex[mutex->id]);
-	unsigned int reg;
-	unsigned int sof_id, mod_id;
-	unsigned int offset;
+	unsigned int sof_id;
 
 	WARN_ON(&mtx->mutex[mutex->id] != mutex);
 
@@ -990,17 +1006,15 @@ void mtk_mutex_add_comp(struct mtk_mutex *mutex,
 		sof_id = MUTEX_SOF_DP_INTF1;
 		break;
 	default:
-		offset = DISP_REG_MUTEX_MOD(mtx, mtx->data->mutex_mod[id], mutex->id);
-		mod_id = mtx->data->mutex_mod[id] % 32;
-		reg = readl_relaxed(mtx->regs + offset);
-		reg |= BIT(mod_id);
-		writel_relaxed(reg, mtx->regs + offset);
+		mtk_mutex_set_mod(mtx, mutex->id, id, true);
 		return;
 	}
 
 	writel_relaxed(mtx->data->mutex_sof[sof_id],
 		       mtx->regs +
 		       DISP_REG_MUTEX_SOF(mtx->data->mutex_sof_reg, mutex->id));
+	if (mtx->data->intf_is_mod)
+		mtk_mutex_set_mod(mtx, mutex->id, id, true);
 }
 EXPORT_SYMBOL_GPL(mtk_mutex_add_comp);
 
@@ -1009,9 +1023,6 @@ void mtk_mutex_remove_comp(struct mtk_mutex *mutex,
 {
 	struct mtk_mutex_ctx *mtx = container_of(mutex, struct mtk_mutex_ctx,
 						 mutex[mutex->id]);
-	unsigned int reg;
-	unsigned int mod_id;
-	unsigned int offset;
 
 	WARN_ON(&mtx->mutex[mutex->id] != mutex);
 
@@ -1028,13 +1039,11 @@ void mtk_mutex_remove_comp(struct mtk_mutex *mutex,
 			       mtx->regs +
 			       DISP_REG_MUTEX_SOF(mtx->data->mutex_sof_reg,
 						  mutex->id));
+		if (mtx->data->intf_is_mod)
+			mtk_mutex_set_mod(mtx, mutex->id, id, false);
 		break;
 	default:
-		offset = DISP_REG_MUTEX_MOD(mtx, mtx->data->mutex_mod[id], mutex->id);
-		mod_id = mtx->data->mutex_mod[id] % 32;
-		reg = readl_relaxed(mtx->regs + offset);
-		reg &= ~BIT(mod_id);
-		writel_relaxed(reg, mtx->regs + offset);
+		mtk_mutex_set_mod(mtx, mutex->id, id, false);
 		break;
 	}
 }
-- 
