From 94825a1bf16ed249149631dca2e34ae27b318438 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 05:16:10 +0000
Subject: [PATCH 043/165] clk: mediatek: mt6858: Add the vlpckgen clocks

Add the MT6858 VLP clock generator's muxes and its oscillator divider,
generated from the tables of MediaTek's GPLv2 MT6858 clock driver.
Among them are the clocks of the PMIC wrapper and the SPMI masters.
---
 drivers/clk/mediatek/Kconfig               |   2 +-
 drivers/clk/mediatek/Makefile              |   3 +-
 drivers/clk/mediatek/clk-mt6858-vlpckgen.c | 340 +++++++++++++++++++++
 3 files changed, 343 insertions(+), 2 deletions(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6858-vlpckgen.c

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index ad6d3888c..8c6c44a2a 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -477,7 +477,7 @@ config COMMON_CLK_MT6858
 	default ARCH_MEDIATEK
 	help
 	  This driver supports the MediaTek MT6858 apmixedsys, topckgen,
-	  pericfg_ao and infracfg_ao clocks.
+	  vlpckgen, pericfg_ao and infracfg_ao clocks.
 
 config COMMON_CLK_MT8135
 	tristate "Clock driver for MediaTek MT8135"
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 761d7c290..9ef0d4dfe 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -30,7 +30,8 @@ obj-$(CONFIG_COMMON_CLK_MT6795_MMSYS) += clk-mt6795-mm.o
 obj-$(CONFIG_COMMON_CLK_MT6795_VDECSYS) += clk-mt6795-vdecsys.o
 obj-$(CONFIG_COMMON_CLK_MT6795_VENCSYS) += clk-mt6795-vencsys.o
 obj-$(CONFIG_COMMON_CLK_MT6858) += clk-mt6858-apmixedsys.o clk-mt6858-topckgen.o \
-				   clk-mt6858-peri_ao.o clk-mt6858-infra_ao.o
+				   clk-mt6858-peri_ao.o clk-mt6858-infra_ao.o \
+				   clk-mt6858-vlpckgen.o
 obj-$(CONFIG_COMMON_CLK_MT6797) += clk-mt6797.o
 obj-$(CONFIG_COMMON_CLK_MT6797_IMGSYS) += clk-mt6797-img.o
 obj-$(CONFIG_COMMON_CLK_MT6797_MMSYS) += clk-mt6797-mm.o
