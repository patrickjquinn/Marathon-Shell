From 15f6ce14546c4662d7a516e5ad8195eec5dd2091 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 21:42:28 +0000
Subject: [PATCH 216/237] ASoC: dt-bindings: Add the MediaTek MT6858 AFE

The MT6858 audio front end is the MT8189's design without its I2S0,
TDM, HDMI and DMIC blocks. It takes the same topckgen, APLL and pericfg
clocks; the I2SIN1 master-clock divider and mux are optional, as only
codecs that take a master clock need them.
---
 .../sound/mediatek,mt6858-afe-pcm.yaml        | 117 ++++++++++++++++++
 1 file changed, 117 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6858-afe-pcm.yaml

diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6858-afe-pcm.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6858-afe-pcm.yaml
new file mode 100644
index 000000000..df6d67659
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6858-afe-pcm.yaml
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6858-afe-pcm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek Audio Front End PCM controller for MT6858
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+properties:
+  compatible:
+    const: mediatek,mt6858-afe-pcm
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  clocks:
+    minItems: 14
+    items:
+      - description: mux for audio intbus
+      - description: mux for audio engen1
+      - description: mux for audio engen2
+      - description: mux for audio h
+      - description: audio apll1 clock
+      - description: audio apll2 clock
+      - description: audio apll1 divide4
+      - description: audio apll2 divide4
+      - description: mux for audio apll1
+      - description: mux for audio apll2
+      - description: 26m clock
+      - description: audio slv clock
+      - description: audio mst clock
+      - description: audio intbus clock
+      - description: audio apll12 divide for i2sin1
+      - description: audio apll12 divide for i2sout1
+      - description: mux for i2sin1 mck
+      - description: mux for i2sout1 mck
+
+  clock-names:
+    minItems: 14
+    items:
+      - const: top_aud_intbus
+      - const: top_aud_eng1
+      - const: top_aud_eng2
+      - const: top_aud_h
+      - const: apll1
+      - const: apll2
+      - const: apll1_d4
+      - const: apll2_d4
+      - const: top_apll1
+      - const: top_apll2
+      - const: clk26m
+      - const: aud_slv_ck_peri
+      - const: aud_mst_ck_peri
+      - const: aud_intbus_ck_peri
+      - const: apll12_div_i2sin1
+      - const: apll12_div_i2sout1
+      - const: top_i2sin1
+      - const: top_i2sout1
+
+  i2sin1-share:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: The I2S interface whose clocks I2SIN1 runs on
+
+  i2sout1-share:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: The I2S interface whose clocks I2SOUT1 runs on
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - power-domains
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        audio-controller@11050000 {
+            compatible = "mediatek,mt6858-afe-pcm";
+            reg = <0 0x11050000 0 0x10000>;
+            interrupts = <GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH 0>;
+            power-domains = <&spm 2>;
+            clocks = <&topckgen 19>, <&topckgen 28>, <&topckgen 29>,
+                     <&topckgen 38>, <&topckgen 98>, <&topckgen 102>,
+                     <&topckgen 100>, <&topckgen 104>, <&topckgen 32>,
+                     <&topckgen 33>, <&topckgen 112>, <&pericfg_ao 25>,
+                     <&pericfg_ao 26>, <&pericfg_ao 27>;
+            clock-names = "top_aud_intbus", "top_aud_eng1", "top_aud_eng2",
+                          "top_aud_h", "apll1", "apll2", "apll1_d4",
+                          "apll2_d4", "top_apll1", "top_apll2", "clk26m",
+                          "aud_slv_ck_peri", "aud_mst_ck_peri",
+                          "aud_intbus_ck_peri";
+        };
+    };
+
+...
-- 
