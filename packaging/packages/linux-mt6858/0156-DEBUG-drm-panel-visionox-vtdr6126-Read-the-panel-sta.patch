From c1b45eef7539e9f94048cab36dd50dc31e2550d6 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 12:13:36 +0000
Subject: [PATCH 156/181] DEBUG: drm/panel: visionox-vtdr6126: Read the panel
 status back

Bring-up only: after the init, after display-on and 3 s later, read the
power mode, MADCTL, pixel format, image and signal mode, self
diagnostics, DSI error count, brightness and ID bytes with BTA, and log
them.
---
 .../gpu/drm/panel/panel-visionox-vtdr6126.c   | 46 +++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6126.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6126.c
index d7b647f45..d8779df83 100644
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6126.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6126.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 
 #include <drm/display/drm_dsc.h>
 #include <drm/drm_mipi_dsi.h>
@@ -29,6 +30,7 @@ struct visionox_vtdr6126 {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	struct drm_dsc_config dsc;
+	struct delayed_work dbg_work;
 };
 
 /* In power-on order; vsp follows vsn after a longer delay in prepare(). */
@@ -314,6 +316,44 @@ static int visionox_vtdr6126_on(struct visionox_vtdr6126 *ctx)
 	return dsi_ctx.accum_err;
 }
 
+/*
+ * DEBUG (bring-up only): read the panel's status registers back with BTA:
+ * power mode, MADCTL, pixel format, image mode, signal mode, self
+ * diagnostics, DSI error count, brightness and the three ID bytes.
+ */
+static void visionox_vtdr6126_dbg_read(struct visionox_vtdr6126 *ctx, const char *when)
+{
+	static const u8 regs[] = { 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x05,
+				   0x52, 0xda, 0xdb, 0xdc };
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long flags = dsi->mode_flags;
+	char buf[128];
+	int n = 0, ret;
+	u8 v;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_set_maximum_return_packet_size(dsi, 1);
+	n += scnprintf(buf + n, sizeof(buf) - n, "max-ret %d:", ret);
+	for (int i = 0; i < ARRAY_SIZE(regs); i++) {
+		v = 0;
+		ret = mipi_dsi_dcs_read(dsi, regs[i], &v, 1);
+		if (ret == 1)
+			n += scnprintf(buf + n, sizeof(buf) - n, " %02x=%02x", regs[i], v);
+		else
+			n += scnprintf(buf + n, sizeof(buf) - n, " %02x:%d", regs[i], ret);
+	}
+	dsi->mode_flags = flags;
+	dev_info(&dsi->dev, "dbg read %s:%s\n", when, buf);
+}
+
+static void visionox_vtdr6126_dbg_work(struct work_struct *work)
+{
+	struct visionox_vtdr6126 *ctx = container_of(work, struct visionox_vtdr6126,
+						     dbg_work.work);
+
+	visionox_vtdr6126_dbg_read(ctx, "3 s after enable");
+}
+
 /* Sleep out and display on once the host sends video, as the vendor does */
 static int visionox_vtdr6126_enable(struct drm_panel *panel)
 {
@@ -329,6 +369,9 @@ static int visionox_vtdr6126_enable(struct drm_panel *panel)
 
 	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
+	visionox_vtdr6126_dbg_read(ctx, "after display on");
+	schedule_delayed_work(&ctx->dbg_work, 3 * HZ);
+
 	return dsi_ctx.accum_err;
 }
 
@@ -337,6 +380,7 @@ static int visionox_vtdr6126_disable(struct drm_panel *panel)
 	struct visionox_vtdr6126 *ctx = to_visionox_vtdr6126(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
+	cancel_delayed_work_sync(&ctx->dbg_work);
 	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
@@ -372,6 +416,7 @@ static int visionox_vtdr6126_prepare(struct drm_panel *panel)
 	visionox_vtdr6126_reset(ctx);
 
 	ret = visionox_vtdr6126_on(ctx);
+	visionox_vtdr6126_dbg_read(ctx, "after init");
 	if (ret) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 		goto err_vsp;
@@ -510,6 +555,7 @@ static int visionox_vtdr6126_probe(struct mipi_dsi_device *dsi)
 
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
+	INIT_DELAYED_WORK(&ctx->dbg_work, visionox_vtdr6126_dbg_work);
 
 	ctx->dsc = visionox_vtdr6126_dsc;
 	dsi->dsc = &ctx->dsc;
-- 
