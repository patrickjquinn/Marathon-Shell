From c610b32c63ae34b3640a5383e173b1272efa8db7 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:37:25 +0000
Subject: [PATCH 111/202] dt-bindings: gpu: mali-valhall-csf: Add MediaTek
 MT6858

The MT6858 (Dimensity 7100) has a Mali-G610 MC2, integrated like the
MT8196's GPU: power and clocks come from the GPUEB power domain, and the
usable shader cores from its nvmem cell.
---
 .../devicetree/bindings/gpu/arm,mali-valhall-csf.yaml        | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-valhall-csf.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-valhall-csf.yaml
index 8eccd4338..233d9fe40 100644
--- a/Documentation/devicetree/bindings/gpu/arm,mali-valhall-csf.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-valhall-csf.yaml
@@ -18,6 +18,7 @@ properties:
     oneOf:
       - items:
           - enum:
+              - mediatek,mt6858-mali
               - mediatek,mt8196-mali
               - nxp,imx95-mali            # G310
               - rockchip,rk3588-mali
@@ -127,7 +128,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: mediatek,mt8196-mali
+            enum:
+              - mediatek,mt6858-mali
+              - mediatek,mt8196-mali
     then:
       properties:
         mali-supply: false
-- 
2.55.0

