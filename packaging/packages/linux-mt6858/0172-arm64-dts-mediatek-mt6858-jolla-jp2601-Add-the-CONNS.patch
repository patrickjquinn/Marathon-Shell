From 45d2308a1ce5bc0be78905131148e2ca8fbb7396 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 19:35:01 +0000
Subject: [PATCH 172/181] arm64: dts: mediatek: mt6858-jolla-jp2601: Add the
 CONNSYS supplies

The stock conninfra driver powers the MT6858 CONNSYS and its MT6631
A-die from the MT6363's VRFIO18 and the MT6369's VCN33_1 and VCN33_2.
Describe them at the stock voltages: VCN33_1 at 3.3 V and VCN33_2 at
2.8 V, as that driver sets them, and VRFIO18 as the preloader leaves it
(1.80 V selected, +20 mV trim), in a range the regulator core keeps.
The MT6363's other LDOs are not described and so stay as they are.
---
 .../boot/dts/mediatek/mt6858-jolla-jp2601.dts | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index f779925c1..5509d212d 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -654,6 +654,23 @@ home {
 			linux,keycodes = <KEY_VOLUMEDOWN>;
 		};
 	};
+
+	regulators@30 {
+		compatible = "mediatek,mt6363-regulator";
+		reg = <0x30>;
+
+		mt6363_vrfio18: vrf-io18 {
+			regulator-name = "vrf-io18";
+			/*
+			 * CONNSYS I/O. The preloader sets 1.80 V with a +20 mV
+			 * trim and the stock driver never changes it; the range
+			 * keeps the trim.
+			 */
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1820000>;
+			regulator-enable-ramp-delay = <180>;
+		};
+	};
 };
 
 &mt6369 {
@@ -683,6 +700,21 @@ mt6369_vibr: vibr {
 			regulator-max-microvolt = <2800000>;
 			regulator-enable-ramp-delay = <680>;
 		};
+
+		/* CONNSYS: the stock driver sets VCN33_1 to 3.3 V, VCN33_2 to 2.8 V */
+		mt6369_vcn33_1: vcn33-1 {
+			regulator-name = "vcn33-1";
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-enable-ramp-delay = <680>;
+		};
+
+		mt6369_vcn33_2: vcn33-2 {
+			regulator-name = "vcn33-2";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-enable-ramp-delay = <680>;
+		};
 	};
 };
 
