From 4a8ad41604f37bf62e478e6eac15126411843b18 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 06:48:39 +0000
Subject: [PATCH 244/250] iio: magnetometer: mmc5633: Report the zero-field
 offset

The 20-bit field outputs are unsigned and read 2^19 at zero field, but
the driver reports them without an offset, so every axis appears to see
about +32 G. Report the offset, so that userspace reads the field.

On the MMC5603 of a Jolla JP2601, a SET/RESET differential measured
(-2.00, -1.21, 11.38) G, stable across readings, with a bridge offset
below 0.42 G. Raw readings minus 2^19 now give that field, negated: the
driver measures in the RESET state.
---
 drivers/iio/magnetometer/mmc5633.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/iio/magnetometer/mmc5633.c b/drivers/iio/magnetometer/mmc5633.c
index b651f01e1..b84f6c0f1 100644
--- a/drivers/iio/magnetometer/mmc5633.c
+++ b/drivers/iio/magnetometer/mmc5633.c
@@ -97,7 +97,8 @@ static int mmc5633_samp_freq[][2] = {
 	.address = MMC5633_AXIS_ ## _axis, \
 	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW), \
 	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SAMP_FREQ) | \
-				    BIT(IIO_CHAN_INFO_SCALE), \
+				    BIT(IIO_CHAN_INFO_SCALE) | \
+				    BIT(IIO_CHAN_INFO_OFFSET), \
 }
 
 static const struct iio_chan_spec mmc5633_channels[] = {
@@ -320,7 +321,9 @@ static int mmc5633_read_raw(struct iio_dev *indio_dev,
 			*val = -75;
 			return IIO_VAL_INT;
 		}
-		return -EINVAL;
+		/* The 20-bit output reads 2^19 at zero field */
+		*val = -(1 << 19);
+		return IIO_VAL_INT;
 	case IIO_CHAN_INFO_SAMP_FREQ:
 		scoped_guard(mutex, &data->mutex) {
 			ret = regmap_read(data->regmap, MMC5633_REG_CTRL1, &reg);
-- 
