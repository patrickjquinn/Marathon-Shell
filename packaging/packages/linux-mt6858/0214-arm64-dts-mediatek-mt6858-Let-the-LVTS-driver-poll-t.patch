From d2c834312e8ac026bbf39ff241fc2d595037241a Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 00:16:50 +0000
Subject: [PATCH 214/214] arm64: dts: mediatek: mt6858: Let the LVTS driver
 poll the thermal zones

The LVTS driver now updates every zone of a firmware-run domain from one
work every 5 s, so the zones' own idle polling would only add wakeups:
set it to 0. Past a trip, the core still polls each zone every 250 ms.
This is 0.2 wakeups a second, down from about 1.3.
---
 arch/arm64/boot/dts/mediatek/mt6858.dtsi | 27 ++++++++++++------------
 1 file changed, 14 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858.dtsi b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
index d5d5ec8fa..b0dbd1814 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6858.dtsi
@@ -1103,12 +1103,13 @@ timer {
 	/*
 	 * One zone for the hotter sensor of each core and of the DSU, the top
 	 * and the bottom of the SoC. The controllers belong to the preloader,
-	 * so the zones are polled, slowly while cool to spare idle wakeups;
-	 * its own thermal reset stays at 115 degC.
+	 * so the LVTS driver polls every zone at once every 5 s, and the core
+	 * every 250 ms past a trip; the preloader's thermal reset stays at
+	 * 115 degC.
 	 */
 	thermal-zones {
 		cpu-big0-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_BIG_CPU0_1>;
 
@@ -1138,7 +1139,7 @@ map0 {
 		};
 
 		cpu-big1-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_BIG_CPU1_1>;
 
@@ -1168,7 +1169,7 @@ map0 {
 		};
 
 		cpu-big2-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_BIG_CPU2_1>;
 
@@ -1198,7 +1199,7 @@ map0 {
 		};
 
 		cpu-big3-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_BIG_CPU3_1>;
 
@@ -1228,7 +1229,7 @@ map0 {
 		};
 
 		cpu-little0-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_LITTLE_CPU0>;
 
@@ -1258,7 +1259,7 @@ map0 {
 		};
 
 		cpu-little1-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_LITTLE_CPU1>;
 
@@ -1288,7 +1289,7 @@ map0 {
 		};
 
 		cpu-little2-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_LITTLE_CPU2>;
 
@@ -1318,7 +1319,7 @@ map0 {
 		};
 
 		cpu-little3-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_LITTLE_CPU3>;
 
@@ -1348,7 +1349,7 @@ map0 {
 		};
 
 		dsu-thermal {
-			polling-delay = <10000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_mcu MT6858_MCU_DSU1>;
 
@@ -1382,7 +1383,7 @@ map0 {
 		};
 
 		soc-top-thermal {
-			polling-delay = <5000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_ap MT6858_AP_TOP2>;
 
@@ -1417,7 +1418,7 @@ map0 {
 		};
 
 		soc-bot-thermal {
-			polling-delay = <5000>;
+			polling-delay = <0>;
 			polling-delay-passive = <250>;
 			thermal-sensors = <&lvts_ap MT6858_AP_BOT1>;
 
