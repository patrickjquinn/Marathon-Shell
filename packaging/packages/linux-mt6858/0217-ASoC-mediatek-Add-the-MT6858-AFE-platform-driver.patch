+static const struct of_device_id mt6858_afe_pcm_dt_match[] = {
+	{ .compatible = "mediatek,mt6858-afe-pcm", },
+	{},
+};
+MODULE_DEVICE_TABLE(of, mt6858_afe_pcm_dt_match);
+
+static const struct dev_pm_ops mt6858_afe_pm_ops = {
+	SET_RUNTIME_PM_OPS(mt6858_afe_runtime_suspend,
+			   mt6858_afe_runtime_resume, NULL)
+};
+
+static struct platform_driver mt6858_afe_pcm_driver = {
+	.driver = {
+		.name = "mt6858-afe-pcm",
+		.of_match_table = mt6858_afe_pcm_dt_match,
+		.pm = &mt6858_afe_pm_ops,
+	},
+	.probe = mt6858_afe_pcm_dev_probe,
+	.remove = mt6858_afe_pcm_dev_remove,
+};
+module_platform_driver(mt6858_afe_pcm_driver);
