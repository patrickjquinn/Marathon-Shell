+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mt6858-afe-clk.h  --  Mediatek 6858 afe clock ctrl definition
+ *
+ * Copyright (c) 2025 MediaTek Inc.
+ * Author: Darren Ye <darren.ye@mediatek.com>
+ */
+
+#ifndef _MT6858_AFE_CLOCK_CTRL_H_
+#define _MT6858_AFE_CLOCK_CTRL_H_
+
+/* APLL */
+#define APLL1_W_NAME "APLL1"
+#define APLL2_W_NAME "APLL2"
+
+enum {
+	MT6858_APLL1,
+	MT6858_APLL2,
+};
+
+enum {
+	MT6858_CLK_TOP_MUX_AUDIOINTBUS,
+	MT6858_CLK_TOP_MUX_AUD_ENG1,
+	MT6858_CLK_TOP_MUX_AUD_ENG2,
+	MT6858_CLK_TOP_MUX_AUDIO_H,
+	/* pll */
+	MT6858_CLK_TOP_APLL1_CK,
+	MT6858_CLK_TOP_APLL2_CK,
+	/* divider */
+	MT6858_CLK_TOP_APLL1_D4,
+	MT6858_CLK_TOP_APLL2_D4,
+	MT6858_CLK_TOP_APLL12_DIV_I2SIN1,
+	MT6858_CLK_TOP_APLL12_DIV_I2SOUT1,
+	/* mux */
+	MT6858_CLK_TOP_MUX_AUD_1,
+	MT6858_CLK_TOP_MUX_AUD_2,
+	MT6858_CLK_TOP_I2SIN1_M_SEL,
+	MT6858_CLK_TOP_I2SOUT1_M_SEL,
+	/* top 26m */
+	MT6858_CLK_TOP_CLK26M,
+	/* peri */
+	MT6858_CLK_PERAO_AUDIO_SLV_CK_PERI,
+	MT6858_CLK_PERAO_AUDIO_MST_CK_PERI,
+	MT6858_CLK_PERAO_INTBUS_CK_PERI,
+	MT6858_CLK_NUM,
+};
+
+struct mtk_base_afe;
+
+int mt6858_mck_enable(struct mtk_base_afe *afe, int mck_id, int rate);
+int mt6858_mck_disable(struct mtk_base_afe *afe, int mck_id);
+int mt6858_get_apll_rate(struct mtk_base_afe *afe, int apll);
+int mt6858_get_apll_by_rate(struct mtk_base_afe *afe, int rate);
+int mt6858_get_apll_by_name(struct mtk_base_afe *afe, const char *name);
+int mt6858_init_clock(struct mtk_base_afe *afe);
+int mt6858_afe_enable_clk(struct mtk_base_afe *afe, struct clk *clk);
+void mt6858_afe_disable_clk(struct mtk_base_afe *afe, struct clk *clk);
+int mt6858_apll1_enable(struct mtk_base_afe *afe);
+void mt6858_apll1_disable(struct mtk_base_afe *afe);
+int mt6858_apll2_enable(struct mtk_base_afe *afe);
+void mt6858_apll2_disable(struct mtk_base_afe *afe);
+int mt6858_afe_enable_main_clock(struct mtk_base_afe *afe);
+void mt6858_afe_disable_main_clock(struct mtk_base_afe *afe);
+int mt6858_afe_enable_reg_rw_clk(struct mtk_base_afe *afe);
+int mt6858_afe_disable_reg_rw_clk(struct mtk_base_afe *afe);
+
+#endif
diff --git a/sound/soc/mediatek/mt6858/mt6858-afe-common.h b/sound/soc/mediatek/mt6858/mt6858-afe-common.h
new file mode 100644
index 000000000..a3470ffac
--- /dev/null
+++ b/sound/soc/mediatek/mt6858/mt6858-afe-common.h
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mt6858-afe-common.h  --  Mediatek 6858 audio driver definitions
+ *
+ *  Copyright (c) 2025 MediaTek Inc.
+ *  Author: Darren Ye <darren.ye@mediatek.com>
+ */
+
+#ifndef _MT_6858_AFE_COMMON_H_
+#define _MT_6858_AFE_COMMON_H_
+
+#include <linux/regmap.h>
+
+#include <sound/soc.h>
+
+#include "mt6858-reg.h"
+#include "../common/mtk-base-afe.h"
+
+enum {
+	MTK_AFE_RATE_8K,
+	MTK_AFE_RATE_11K,
+	MTK_AFE_RATE_12K,
+	MTK_AFE_RATE_384K,
+	MTK_AFE_RATE_16K,
+	MTK_AFE_RATE_22K,
+	MTK_AFE_RATE_24K,
+	MTK_AFE_RATE_352K,
+	MTK_AFE_RATE_32K,
+	MTK_AFE_RATE_44K,
+	MTK_AFE_RATE_48K,
+	MTK_AFE_RATE_88K,
