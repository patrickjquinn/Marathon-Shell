+/* Above about 11.29 Mbit/s the latch must follow the word length */
+static unsigned int get_etdm_in2latch_time(unsigned int rate,
+					   unsigned int channels,
+					   snd_pcm_format_t format)
+{
+	unsigned int wlen = get_etdm_wlen(format);
+
+	if (rate * channels * (wlen + 1) >= 11289600 && wlen >= 2)
+		return wlen - 2;
+
+	return 0x6;
+}
