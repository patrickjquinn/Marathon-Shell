index 000000000..7a3511418
--- /dev/null
+++ b/sound/soc/mediatek/mt6858/mt6858-reg.h
@@ -0,0 +1,8648 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mt6858-reg.h  --  Mediatek 6858 audio driver reg definition
+ *
+ *  Copyright (c) 2025 MediaTek Inc.
+ *  Author: Darren Ye <darren.ye@mediatek.com>
+ */
+
+#ifndef _MT6858_REG_H_
+#define _MT6858_REG_H_
+
+ /* reg bit enum */
+enum {
+	MT6858_MEMIF_PBUF_SIZE_32_BYTES,
+	MT6858_MEMIF_PBUF_SIZE_64_BYTES,
+	MT6858_MEMIF_PBUF_SIZE_128_BYTES,
+	MT6858_MEMIF_PBUF_SIZE_256_BYTES,
+	MT6858_MEMIF_PBUF_SIZE_NUM,
+};
+
+/*****************************************************************************
+ * R E G I S T E R  D E F I N I T I O N
+ *****************************************************************************/
+/* AUDIO_TOP_CON0 */
+#define PDN_HW_GAIN01_SFT                                     21
+#define PDN_HW_GAIN01_MASK                                    0x1
+#define PDN_HW_GAIN01_MASK_SFT                                (0x1 << 21)
+#define PDN_HW_GAIN23_SFT                                     20
+#define PDN_HW_GAIN23_MASK                                    0x1
+#define PDN_HW_GAIN23_MASK_SFT                                (0x1 << 20)
