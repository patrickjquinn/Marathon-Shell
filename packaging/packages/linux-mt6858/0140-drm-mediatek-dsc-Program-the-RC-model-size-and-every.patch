From 62d97a12cfa9e5c0ac8cd286f7211540df6f26ec Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 11:11:42 +0000
Subject: [PATCH 140/181] drm/mediatek: dsc: Program the RC model size and
 every second RC range

PPS6 was written with the flatness QPs only, leaving the RC model size
at zero, and each RC range parameter set was built in a u16 that was
then shifted left by 16 for the odd-numbered sets, so those were always
zero. Against the MT6858 bootloader's working values (PPS6 0x20001007,
PPS12 0x01040900) the encoder got 0x00001007 and 0x00000900, and it
stalls after 23 lines.
---
 drivers/gpu/drm/mediatek/mtk_disp_dsc.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
index 527326fa1..121b93efb 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
@@ -210,6 +210,7 @@ static void mtk_dsc_pps_setup(struct mtk_dsc *disp_dsc, struct drm_dsc_config *d
 	/* PPS 6 */
 	data = FIELD_PREP(DSC_P6_FLATNESS_MIN_QP, dsc_cfg->flatness_min_qp);
 	data |= FIELD_PREP(DSC_P6_FLATNESS_MAX_QP, dsc_cfg->flatness_max_qp);
+	data |= FIELD_PREP(DSC_P6_RC_MODEL_SIZE, dsc_cfg->rc_model_size);
 	writel(data, disp_dsc->reg + DISP_REG_DSC_PPS(6));
 
 	/* PPS 7 */
@@ -247,7 +248,7 @@ static void mtk_dsc_pps_setup(struct mtk_dsc *disp_dsc, struct drm_dsc_config *d
 		for (j = 0; j < 2; j++) {
 			u8 buf_index = block_num + j;
 			u8 data_shift = j * 16;
-			u16 range_data;
+			u32 range_data;
 
 			range_data = FIELD_PREP(DSC_P12_RC_RANGE_MIN_QP,
 						 rcrp[buf_index].range_min_qp);
-- 
