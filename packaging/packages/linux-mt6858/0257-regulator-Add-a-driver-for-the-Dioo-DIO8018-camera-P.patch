From c5f6bf56a9983fe6dfde0906995fb1a3b458bd9f Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 27 Nov 2026 10:47:10 +0000
Subject: [PATCH 257/272] regulator: Add a driver for the Dioo DIO8018 camera
 PMIC

Add a regmap driver for the seven LDOs of the Dioo DIO8018. The register
layout is taken from MediaTek's GPLv2 camldo_dio8018 driver: chip ID 0x04
at register 0x00, one enable bit per LDO in register 0x03 next to a
master enable in bit 7, and one voltage selector per LDO from register
0x04. LDO1 and LDO2 start at 504 mV (selector 0x3e), LDO3 to LDO7 at
1.5 V (selector 0x10), all in 8 mV steps.

The master enable is set with the first LDO and cleared with the last,
as the vendor driver does.

Tested on the Jolla Phone JP2601: chip ID 0x04 read at probe, all seven
LDOs registered with their DT voltages.
---
 drivers/regulator/Kconfig             |  11 ++
 drivers/regulator/Makefile            |   1 +
 drivers/regulator/dio8018-regulator.c | 169 ++++++++++++++++++++++++++
 3 files changed, 181 insertions(+)
 create mode 100644 drivers/regulator/dio8018-regulator.c

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 687bdd7d9..a78eb85f7 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -387,6 +387,17 @@ config REGULATOR_DA9121
 	  This driver can also be built as a module. If so, the module
 	  will be called da9121-regulator.
 
+config REGULATOR_DIO8018
+	tristate "Dioo DIO8018 camera regulator"
+	depends on I2C && OF
+	select REGMAP_I2C
+	help
+	  Say y here to support the seven LDOs of the Dioo DIO8018 camera
+	  power management IC.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called dio8018-regulator.
+
 config REGULATOR_DA9210
 	tristate "Dialog Semiconductor DA9210 regulator"
 	depends on I2C
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index c62c8d042..911c3de81 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -48,6 +48,7 @@ obj-$(CONFIG_REGULATOR_DA9063)	+= da9063-regulator.o
 obj-$(CONFIG_REGULATOR_DA9121) += da9121-regulator.o
 obj-$(CONFIG_REGULATOR_DA9210) += da9210-regulator.o
 obj-$(CONFIG_REGULATOR_DA9211) += da9211-regulator.o
+obj-$(CONFIG_REGULATOR_DIO8018) += dio8018-regulator.o
 obj-$(CONFIG_REGULATOR_DBX500_PRCMU) += dbx500-prcmu.o
 obj-$(CONFIG_REGULATOR_DB8500_PRCMU) += db8500-prcmu.o
 obj-$(CONFIG_REGULATOR_FAN53555) += fan53555.o
diff --git a/drivers/regulator/dio8018-regulator.c b/drivers/regulator/dio8018-regulator.c
new file mode 100644
index 000000000..c452c1312
--- /dev/null
+++ b/drivers/regulator/dio8018-regulator.c
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Dioo DIO8018 seven-channel camera LDO regulator driver.
+ *
+ * Register layout from MediaTek's GPLv2 camldo_dio8018 driver: LDO1/LDO2
+ * (DVDD) start at 504 mV and LDO3..LDO7 (AVDD) at 1500 mV, all in 8 mV steps.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define DIO8018_CHIP_ID			0x00
+#define DIO8018_CHIP_ID_VALUE		0x04
+#define DIO8018_LDO_EN			0x03
+#define DIO8018_LDO_VOUT(n)		(0x03 + (n))
+#define DIO8018_SYS_EN			BIT(7)
+#define DIO8018_LDO_EN_MASK		GENMASK(6, 0)
+
+static int dio8018_enable(struct regulator_dev *rdev)
+{
+	/* SYS_EN gates every output and has to be set with the LDO bit. */
+	return regmap_update_bits(rdev->regmap, DIO8018_LDO_EN,
+				  DIO8018_SYS_EN | rdev->desc->enable_mask,
+				  DIO8018_SYS_EN | rdev->desc->enable_mask);
+}
+
+static int dio8018_disable(struct regulator_dev *rdev)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, DIO8018_LDO_EN, &val);
+	if (ret)
+		return ret;
+
+	val &= ~rdev->desc->enable_mask;
+	if (!(val & DIO8018_LDO_EN_MASK))
+		val = 0;
+
+	return regmap_write(rdev->regmap, DIO8018_LDO_EN, val);
+}
+
+static int dio8018_is_enabled(struct regulator_dev *rdev)
+{
+	unsigned int mask = DIO8018_SYS_EN | rdev->desc->enable_mask;
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, DIO8018_LDO_EN, &val);
+	if (ret)
+		return ret;
+
+	return (val & mask) == mask;
+}
+
+static const struct regulator_ops dio8018_ops = {
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.enable = dio8018_enable,
+	.disable = dio8018_disable,
+	.is_enabled = dio8018_is_enabled,
+};
+
+#define DIO8018_LDO(_num, _supply, _min_uV, _min_sel) {		\
+	.name = "ldo" #_num,					\
+	.of_match = "ldo" #_num,				\
+	.regulators_node = "regulators",			\
+	.id = (_num) - 1,					\
+	.type = REGULATOR_VOLTAGE,				\
+	.owner = THIS_MODULE,					\
+	.ops = &dio8018_ops,					\
+	.supply_name = _supply,					\
+	.min_uV = _min_uV,					\
+	.uV_step = 8000,					\
+	.linear_min_sel = _min_sel,				\
+	.n_voltages = 256,					\
+	.vsel_reg = DIO8018_LDO_VOUT(_num),			\
+	.vsel_mask = 0xff,					\
+	.enable_reg = DIO8018_LDO_EN,				\
+	.enable_mask = BIT((_num) - 1),				\
+	.enable_time = 150,					\
+}
+
+static const struct regulator_desc dio8018_regulators[] = {
+	DIO8018_LDO(1, "vin12", 504000, 0x3e),
+	DIO8018_LDO(2, "vin12", 504000, 0x3e),
+	DIO8018_LDO(3, "vin34", 1500000, 0x10),
+	DIO8018_LDO(4, "vin34", 1500000, 0x10),
+	DIO8018_LDO(5, "vin5", 1500000, 0x10),
+	DIO8018_LDO(6, "vin6", 1500000, 0x10),
+	DIO8018_LDO(7, "vin7", 1500000, 0x10),
+};
+
+static const struct regmap_config dio8018_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x20,
+};
+
+static void dio8018_reset(void *data)
+{
+	gpiod_set_value_cansleep(data, 1);
+}
+
+static int dio8018_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { .dev = dev };
+	struct regulator_dev *rdev;
+	struct gpio_desc *reset;
+	unsigned int id;
+	int ret, i;
+
+	reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset), "Failed to get reset GPIO\n");
+
+	if (reset) {
+		ret = devm_add_action_or_reset(dev, dio8018_reset, reset);
+		if (ret)
+			return ret;
+		fsleep(1000);
+	}
+
+	config.regmap = devm_regmap_init_i2c(client, &dio8018_regmap_config);
+	if (IS_ERR(config.regmap))
+		return dev_err_probe(dev, PTR_ERR(config.regmap),
+				     "Failed to create regmap\n");
+
+	ret = regmap_read(config.regmap, DIO8018_CHIP_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to read chip ID\n");
+	if (id != DIO8018_CHIP_ID_VALUE)
+		return dev_err_probe(dev, -ENODEV, "Unexpected chip ID: %#x\n", id);
+
+	for (i = 0; i < ARRAY_SIZE(dio8018_regulators); i++) {
+		rdev = devm_regulator_register(dev, &dio8018_regulators[i], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "Failed to register LDO%d\n", i + 1);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id dio8018_of_match[] = {
+	{ .compatible = "dioo,dio8018" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dio8018_of_match);
+
+static struct i2c_driver dio8018_driver = {
+	.driver = {
+		.name = "dio8018",
+		.of_match_table = dio8018_of_match,
+	},
+	.probe = dio8018_probe,
+};
+module_i2c_driver(dio8018_driver);
+
+MODULE_DESCRIPTION("Dioo DIO8018 camera regulator driver");
+MODULE_LICENSE("GPL");
-- 
2.55.0

