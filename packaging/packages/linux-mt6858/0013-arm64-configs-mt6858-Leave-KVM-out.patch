From 7b37f97f6f99b35aea151d5d96e5f29b333c38b8 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 19:55:55 +0000
Subject: [PATCH 013/168] arm64: configs: mt6858: Leave KVM out

On the Jolla Phone, a U-Boot started by the stock LK runs at EL1: LK's
hypervisor keeps EL2, so the kernel U-Boot starts runs at EL1 too and
KVM can never initialise. Leave it out of the first-boot fragment.
---
 arch/arm64/configs/mt6858.config | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/mt6858.config b/arch/arm64/configs/mt6858.config
index d80ec12f9..64c51adfe 100644
--- a/arch/arm64/configs/mt6858.config
+++ b/arch/arm64/configs/mt6858.config
@@ -28,3 +28,5 @@ CONFIG_PSTORE=y
 CONFIG_PSTORE_RAM=y
 CONFIG_PSTORE_CONSOLE=y
 CONFIG_PSTORE_PMSG=y
+# LK's hypervisor keeps EL2, so the kernel runs at EL1: no KVM.
+# CONFIG_KVM is not set
-- 
2.55.0

