From a301bdcd617e109d179577f54967dedb2a9b8bca Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 09:19:27 +0000
Subject: [PATCH 070/128] arm64: dts: mediatek: mt6858-jolla-jp2601: Add the
 hall sensor and privacy switch

The phone has a hall sensor on GPIO13 for a flip cover's magnet and a
privacy slide switch on GPIO1, both plain inputs that the stock firmware
reads with interrupts on both edges. Report them as switches through
gpio-keys: the hall sensor as SW_LID, the slide switch as SW_MUTE_DEVICE.

The hall input idles high with no magnet near, so it is active low. The
slide switch's polarity is not known yet.
---
 .../boot/dts/mediatek/mt6858-jolla-jp2601.dts | 29 ++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
index 5e3ec65a7..d542b5965 100644
--- a/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6858-jolla-jp2601.dts
@@ -88,7 +88,7 @@ framebuffer@fe450000 {
 	gpio-keys {
 		compatible = "gpio-keys";
 		pinctrl-names = "default";
-		pinctrl-0 = <&volume_up_pins>;
+		pinctrl-0 = <&volume_up_pins>, <&switch_pins>;
 
 		key-volume-up {
 			label = "Volume Up";
@@ -97,6 +97,25 @@ key-volume-up {
 			debounce-interval = <16>;
 			wakeup-source;
 		};
+
+		/* The hall sensor for a flip cover's magnet */
+		switch-lid {
+			label = "Hall";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
+			debounce-interval = <100>;
+			wakeup-source;
+		};
+
+		/* The privacy slide switch on the side */
+		switch-privacy {
+			label = "Privacy";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_MUTE_DEVICE>;
+			gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <15>;
+		};
 	};
 
 	memory@40000000 {
@@ -612,6 +631,14 @@ pins-key {
 		};
 	};
 
+	switch_pins: switch-pins {
+		pins-switch {
+			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>,
+				 <PINMUX_GPIO13__FUNC_GPIO13>;
+			input-enable;
+		};
+	};
+
 	ts_pins: touchscreen-pins {
 		pins-irq {
 			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
-- 
