From da0ae16756d24b2112c362c52ce5ee9ac7ae68e8 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 25 Nov 2026 18:00:04 +0000
Subject: [PATCH 007/167] dt-bindings: usb: mediatek,mtu3: Add MT6858

The MT6858 has one dual-role USB 2.0 controller of the MTU3 family at
0x11201000, with its IPPC at 0x11203e00. Add its compatible.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
index d148e938d..353366c57 100644
--- a/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
+++ b/Documentation/devicetree/bindings/usb/mediatek,mtu3.yaml
@@ -22,6 +22,7 @@ properties:
     items:
       - enum:
           - mediatek,mt2712-mtu3
+          - mediatek,mt6858-mtu3
           - mediatek,mt8173-mtu3
           - mediatek,mt8183-mtu3
           - mediatek,mt8186-mtu3
-- 
2.55.0

