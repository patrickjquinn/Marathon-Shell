#!/bin/sh
# Q25 GPU readiness for the Panfrost session; devfreq scales the clock.
# No direct regulator/MMIO writes.
set -eu
state=/run/q25-gpu
gpu=/sys/devices/platform/soc/13000000.gpu
df=/sys/class/devfreq/13000000.gpu
install -d -m 0755 "$state"
rm -f "$state/ready"
fail() { echo "q25-gpu: $*; software fallback" >&2; exit 1; }
[ ! -e /etc/q25/gpu-disabled ] || fail 'disabled by recovery override'
case " $(cat /proc/cmdline) " in *' q25.gpu=off '*) fail 'disabled by command line';; esac
[ "$(cat /sys/devices/system/cpu/cpu0/online)" = 0 ] || fail 'CPU0 quarantine absent'
sha256sum -c /usr/lib/q25-gpu/SHA256SUMS || fail 'artifact identity mismatch'
[ -e "$gpu/of_node" ] || fail 'native GPU node absent'
modprobe panfrost
[ "$(basename "$(readlink "$gpu/driver")")" = panfrost ] || fail 'Panfrost not bound'
[ -c /dev/dri/card0 ] && [ -c /dev/dri/renderD128 ] || fail 'DRM nodes missing'
[ "$(basename "$(readlink /sys/class/drm/card0/device/driver)")" = simple-framebuffer ] || fail 'display is not SimpleDRM'
# Keep genpd suppliers enabled: a later SRAM first-enable can reset coupling.
echo on > "$gpu/power/control"
[ "$(cat "$gpu/power/runtime_status")" = active ] || fail 'GPU is not active'
printf '%s\n' "Panfrost devfreq $(cat "$df/governor") PM-on noafbc KMSRO" > "$state/ready"
chmod 0644 "$state/ready"
echo 'q25-gpu: accepted power state ready; GPU render path enabled'
