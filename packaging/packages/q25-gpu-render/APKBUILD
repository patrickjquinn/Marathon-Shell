# Q25 Panfrost render path: prepares the GPU (q25-mfg-only-v2 from
# q25-kernel-modules, the kernel's panfrost) and selects the GPU session.
pkgname=q25-gpu-render
pkgver=7.0.0
pkgrel=6
pkgdesc="Q25 accepted guarded Panfrost390MHz PM-on render path"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="GPL-2.0-only AND MIT"
options="!check !strip !tracedeps"
depends="kmod q25-kernel-modules>=7.0.0-r24 mesa=26.2.6-r0 mesa-dri-gallium=26.2.6-r0"
install="$pkgname.post-install $pkgname.post-upgrade"
source="q25-gpu-prepare q25-gpu-prepare.service 80-q25-gpu-prepare.conf
 q25-shell-session.gpu GPU-SHA256SUMS eglfs-kms.json simpledrm_dri.so simpledrm_dri.c
 q25-render-only-blacklist.conf GPU-SOURCE-PROVENANCE.json"
package() {
    local private="$pkgdir/usr/lib/q25-gpu"
    install -d "$private"
    install -Dm644 "$srcdir/GPU-SHA256SUMS" "$private/SHA256SUMS"
    install -Dm755 "$srcdir/q25-gpu-prepare" "$pkgdir/usr/libexec/marathon/q25-gpu-prepare"
    install -Dm755 "$srcdir/q25-shell-session.gpu" "$pkgdir/usr/libexec/marathon/q25-shell-session.gpu"
    install -Dm644 "$srcdir/q25-gpu-prepare.service" "$pkgdir/usr/lib/systemd/system/q25-gpu-prepare.service"
    install -Dm644 "$srcdir/80-q25-gpu-prepare.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/80-q25-gpu-prepare.conf"
    install -Dm644 "$srcdir/eglfs-kms.json" "$pkgdir/etc/q25/eglfs-kms.json"
    # Keep the accepted shim byte-exact in a package-owned private path.
    install -Dm755 "$srcdir/simpledrm_dri.so" "$pkgdir/usr/lib/q25-gpu/dri/simpledrm_dri.so"
    install -Dm644 "$srcdir/q25-render-only-blacklist.conf" "$pkgdir/usr/lib/modprobe.d/q25-render-only.conf"
    local doc="$pkgdir/usr/share/doc/$pkgname"
    install -d "$doc/source"
    install -m644 "$srcdir/simpledrm_dri.c" "$doc/source/"
    install -m644 "$srcdir/GPU-SOURCE-PROVENANCE.json" "$doc/"
}
