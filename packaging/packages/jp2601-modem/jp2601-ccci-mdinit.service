[Unit]
Description=JP2601 MD1: ccci_mdinit (boots and supervises the modem)
Requires=jp2601-ccci-rpcd.service jp2601-ccci-fsd.service
After=jp2601-ccci-rpcd.service jp2601-ccci-fsd.service
PartOf=jp2601-modem.target

[Service]
# The kernel takes DO_START_MD only from a process named ccci_mdinit.
ExecStart=/usr/libexec/jp2601-modem/ccci_mdinit 0
Restart=on-failure
RestartSec=5
