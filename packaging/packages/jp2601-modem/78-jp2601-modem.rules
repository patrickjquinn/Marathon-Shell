# JP2601 MD1 (MT6858 ECCCI): AT on the ttyC0 CCCI character device, data on
# ccmni, for ModemManager's mtk-ccci plugin (modemmanager-mtk-ccci). Never tag
# ccci_fs/ccci_rpc/ccci_monitor/ccci_aud. The physdev must be the bound
# mddriver device, or MM filters the plugin and falls back to generic.
SUBSYSTEM=="ccci_node", KERNEL=="ttyC0", \
	ENV{ID_MM_CANDIDATE}="1", \
	ENV{ID_MM_CCCI_AT_PORT}="1", \
	ENV{ID_MM_MTK_CCCI}="1", \
	ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1", \
	ENV{ID_MM_PHYSDEV_SYSFS_PATH}="/sys/devices/platform/soc/d180000.mddriver", \
	ENV{ID_MM_PHYSDEV_UID}="jp2601-md1"
SUBSYSTEM=="net", ACTION=="add|change|move", KERNEL=="ccmni[0-9]", \
	ENV{ID_MM_CANDIDATE}="1", \
	ENV{ID_MM_MTK_CCCI}="1", \
	ENV{ID_MM_PHYSDEV_SYSFS_PATH}="/sys/devices/platform/soc/d180000.mddriver", \
	ENV{ID_MM_PHYSDEV_UID}="jp2601-md1"
# The DTB's mddriver node: bring the stack up at boot.
SUBSYSTEM=="platform", ACTION=="add", ENV{OF_FULLNAME}=="/soc/mddriver@d180000", \
	TAG+="systemd", ENV{SYSTEMD_WANTS}+="jp2601-modem.target"
