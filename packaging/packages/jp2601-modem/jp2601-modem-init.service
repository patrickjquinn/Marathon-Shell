[Unit]
Description=JP2601 MD1: SIM power-up and LTE attach APN, before ModemManager takes ttyC0
Requires=jp2601-ccci-mdinit.service
After=jp2601-ccci-mdinit.service
Before=ModemManager.service
PartOf=jp2601-modem.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/bin/systemctl stop ModemManager.service
ExecStartPre=/usr/libexec/jp2601-modem/jp2601-modem-up wait
ExecStart=/usr/libexec/jp2601-modem/q25-modem-init
ExecStartPost=/bin/systemctl start --no-block ModemManager.service
TimeoutStartSec=300
Restart=on-failure
RestartSec=10
