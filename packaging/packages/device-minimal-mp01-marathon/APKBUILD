# MP01 session, UI profile and board policy; the SoC's shared services are
# mt6789-platform's, and the kernel, firmware and image layout are separate.
pkgname=device-minimal-mp01-marathon
pkgver=1.0.0
pkgrel=4
pkgdesc="Minimal Phone MP01 Marathon session, UI profile and board policy"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0"
options="!check"
# Marathon's Mesa, as the Q25's: Panfrost without importing every client
# buffer into mediatek-drm.
depends="device-minimal-mp01 mp01-kernel-modules q25-connsys-firmware marathon-base-config marathon-shell greetd mt6789-platform
 mesa=26.2.6-r100 mesa-dri-gallium=26.2.6-r100 alsa-ucm-conf alsa-utils"
source="device-profile.conf mp01-shell-session greetd-mp01.toml 50-mp01-session.conf eglfs-kms.json
 60-mp01-display.rules 60-mp01-keyboard.rules mp01-mt6366.conf HiFi.conf
 50-mp01-shutdown.conf mp01-audio.modprobe.conf"
package() {
    install -Dm644 "$srcdir/device-profile.conf" "$pkgdir/etc/marathon/device-profile.conf"
    install -Dm755 "$srcdir/mp01-shell-session" "$pkgdir/usr/libexec/marathon/mp01-shell-session"
    install -Dm644 "$srcdir/greetd-mp01.toml" "$pkgdir/etc/greetd/mp01-config.toml"
    install -Dm644 "$srcdir/50-mp01-session.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/50-mp01-session.conf"
    install -Dm644 "$srcdir/eglfs-kms.json" "$pkgdir/etc/mp01/eglfs-kms.json"
    install -Dm644 "$srcdir/60-mp01-display.rules" "$pkgdir/usr/lib/udev/rules.d/60-mp01-display.rules"
    install -Dm644 "$srcdir/60-mp01-keyboard.rules" "$pkgdir/usr/lib/udev/rules.d/60-mp01-keyboard.rules"
    install -Dm644 "$srcdir/mp01-mt6366.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/mp01-mt6366/mp01-mt6366.conf"
    install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Minimal/MP01/HiFi.conf"
    install -Dm644 "$srcdir/mp01-audio.modprobe.conf" "$pkgdir/usr/lib/modprobe.d/mp01-audio.conf"
    local t
    for t in reboot poweroff halt; do
        install -Dm644 "$srcdir/50-mp01-shutdown.conf" "$pkgdir/usr/lib/systemd/system/$t.target.d/50-mp01-shutdown.conf"
    done
}
