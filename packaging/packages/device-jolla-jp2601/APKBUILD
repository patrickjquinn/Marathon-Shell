# JP2601 deviceinfo and kernel command line. The kernel is the SoC's
# (linux-mt6858); scripts/build-image.sh builds the one named here.
#
# The command line: splash comes first (the initramfs takes the first splash
# word it finds); Plymouth uses simpledrm, the only display driver; fbcon
# leaves VT1, so with no DRM master after Plymouth lets go it cannot put its
# frame back over the shell's, and the kernel's lines (loglevel 7) stay off
# the splash but still reach ramoops, which U-Boot shows after a crash. No
# clock or PMIC drivers yet: clk_ignore_unused and pd_ignore_unused keep
# what LK left running.
pkgname=device-jolla-jp2601
pkgdesc="Jolla Phone (2026)"
pkgver=1
pkgrel=0
url="https://github.com/patrickjquinn/Marathon-Shell"
license="MIT"
arch="aarch64"
options="!check !archcheck"
_kernel=linux-mt6858
depends="
	$_kernel>=7.4.0_rc4
	postmarketos-base
	systemd-boot
	python3
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	jp2601-mark-boot-successful
	jp2601-mark-boot-successful.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# LK falls back to the other slot once slot B's tries run out, unless the
	# booted slot is marked successful in misc.
	install -Dm755 "$srcdir/jp2601-mark-boot-successful" "$pkgdir/usr/libexec/marathon/jp2601-mark-boot-successful"
	install -Dm644 "$srcdir/jp2601-mark-boot-successful.service" "$pkgdir/usr/lib/systemd/system/jp2601-mark-boot-successful.service"
	install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
	ln -s ../jp2601-mark-boot-successful.service "$pkgdir/usr/lib/systemd/system/graphical.target.wants/jp2601-mark-boot-successful.service"
}

