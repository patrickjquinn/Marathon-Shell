# JP2601 deviceinfo and kernel command line. The kernel is the SoC's
# (linux-mt6858); scripts/build-image.sh builds the one named here.
pkgname=device-jolla-jp2601
pkgdesc="Jolla Phone (2026)"
pkgver=1
pkgrel=0
url="https://github.com/patrickjquinn/Marathon-Shell"
license="MIT"
arch="aarch64"
options="!check !archcheck"
_kernel=linux-mt6858
depends="
	$_kernel>=7.4.0_rc4
	postmarketos-base
	systemd-boot
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

