# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-raspberry-pi5-marathon
pkgdesc="Raspberry Pi 5 / CM5 — Marathon OS base port (no enclosure)"
pkgver=1.0.0
pkgrel=15
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
# Override /boot/usercfg.txt that device-raspberry-pi5 ships (a stub
# that just suggests where user configs go). We need ours to take
# precedence so the KMS overlay + boost knobs land in /boot.
replaces="device-raspberry-pi5"
# This package is the GENERIC Pi 5 / CM5 base. HackberryPi enclosure
# specifics (HyperPixel panel, MAX17048 fuel gauge, BBQ keyboard
# requirements) live in device-hackberrypi-cm5-marathon, which depends
# on this and layers its own DT overlay + usercfg-hackberrypi.txt on
# top via the include directive at the bottom of our usercfg.txt.
#
# Notes on the depends list:
#   - device-raspberry-pi5 pulls postmarketos-base + raspberrypi-bootloader
#     + linux-rpi, which linux-rpi-marathon provides. The CM5 uses the same
#     BCM2712 as the Pi 5.
#   - marathon-shell + marathon-base-config + marathon-boot-logo +
#     marathon-plymouth-theme + plymouth + the runtime stack mirror the
#     OnePlus 6 / Librem 5 overlay aports for consistency.
#   - iwd intentionally absent — NetworkManager uses wpa_supplicant,
#     and iwd auto-enables a colliding nl80211 client (see
#     marathon-base-config preset).
depends="
	device-raspberry-pi5
	linux-rpi-marathon
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	greetd
	greetd-systemd
	networkmanager
	networkmanager-wifi
	networkmanager-cli
	modemmanager
	upower
	wireless-tools
	wpa_supplicant
	bluez
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
	mesa-vulkan-broadcom
"
makedepends=""
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	usercfg.txt
	device-profile.conf
	50-marathon-wifi-powersave.conf
	"

package() {
	# greetd autologin → marathon-shell-session. Drop ONLY the Marathon-
	# specific config; the greetd.service systemd unit comes from the
	# greetd-systemd subpackage we depend on (don't ship our own).
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# Let Marathon Shell own the power button (logind hands off)
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"

	# HyperPixel + KMS overlay activation via standard Raspberry Pi
	# firmware include chain (raspberrypi-bootloader's /boot/config.txt
	# sources /boot/usercfg.txt). device-raspberry-pi5 ships a stub
	# usercfg.txt; we OVERRIDE it (replaces= directive above).
	#
	# The file ends with `include usercfg-hackberrypi.txt` — Pi firmware
	# silently skips missing includes, so the line is a no-op on a
	# vanilla Pi 5 / CM5 and activates HackberryPi panel + battery + USB
	# OTG overrides when device-hackberrypi-cm5-marathon is installed.
	install -Dm644 "$srcdir/usercfg.txt" \
		"$pkgdir/boot/usercfg.txt"

	# Generated from devices/raspberry/pi5/device.toml.
	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf"
	install -Dm644 "$srcdir/50-marathon-wifi-powersave.conf" \
		"$pkgdir/usr/lib/NetworkManager/conf.d/50-marathon-wifi-powersave.conf"
}

