+
+	/* CONNSYS (WMT) and the AXI Wi-Fi core, values from the stock vendor DT. */
+	consys: consys@18002000 {
+		compatible = "mediatek,mt6789-consys";
+		/* Order is CONSYS_BASE_ADDRESS_INDEX in mtk_wcn_consys_hw.h. */
+		reg = <0 0x18002000 0 0x1000>,
+		      <0 0x10007000 0 0x100>,
+		      <0 0x10001000 0 0x1000>,
+		      <0 0x10006000 0 0x1000>,
+		      <0 0x18007000 0 0x1000>,
+		      <0 0x180b1000 0 0x1000>,
+		      <0 0x180a3000 0 0x1000>,
+		      <0 0x180a5000 0 0x800>,
+		      <0 0x180c1000 0 0x1000>,
+		      <0 0x18004000 0 0x1000>,
+		      <0 0x1024c000 0 0x40>,
+		      <0 0x10003000 0 0x1000>;
+		interrupts = <GIC_SPI 410 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 411 IRQ_TYPE_LEVEL_HIGH 0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_CONN>;
+		clocks = <&infracfg_ao CLK_IFRAO_CCIF4_AP>;
+		clock-names = "ccif";
+		resets = <&toprgu 12>;
+		vcn18-supply = <&mt6366_vcn18_reg>;
+		vcn28-supply = <&mt6366_vcn28_reg>;
+		vcn33-supply = <&mt6366_vcn33_reg>;
+		pmic = <&pmic>;
+		memory-region = <&consys_emi>;
+		emi-addr = <0x7e000000>;
+		emi-size = <0x500000>;
+		emi-alignment = <0x1000000>;
+		emi-max-addr = <0x80000000>;
+		/* No "default" state: the pins stay GPIO until WMT powers the A-die. */
+		pinctrl-names = "on", "off";
+		pinctrl-0 = <&conn_adie_on_pins>;
+		pinctrl-1 = <&conn_adie_off_pins>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	wifi@18000000 {
+		compatible = "mediatek,wifi";
+		reg = <0 0x18000000 0 0x100000>;
+		interrupts = <GIC_SPI 409 IRQ_TYPE_LEVEL_HIGH 0>;
+		memory-region = <&wifi_mem>;
+		emi-size = <0x600000>;
+	};
+
+	/* WMT/STP transport to CONNSYS. */
+	btif@1100c000 {
+		compatible = "mediatek,btif";
+		reg = <0 0x1100c000 0 0x1000>,
