+		mediatek,infracfg = <&infracfg_ao>;
+		mediatek,topckgen = <&topckgen>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_AUDIO>;
+		clocks = <&afe CLK_AFE_AFE>,
+			 <&afe CLK_AFE_DAC>,
+			 <&afe CLK_AFE_DAC_PREDIS>,
+			 <&afe CLK_AFE_ADC>,
+			 <&afe CLK_AFE_22M>,
+			 <&afe CLK_AFE_24M>,
+			 <&afe CLK_AFE_APLL_TUNER>,
+			 <&afe CLK_AFE_APLL2_TUNER>,
+			 <&afe CLK_AFE_TML>,
+			 <&afe CLK_AFE_NLE>,
+			 <&afe CLK_AFE_DAC_HIRES>,
+			 <&afe CLK_AFE_ADC_HIRES>,
+			 <&afe CLK_AFE_ADC_HIRES_TML>,
+			 <&afe CLK_AFE_I2S1_BCLK>,
+			 <&afe CLK_AFE_I2S2_BCLK>,
