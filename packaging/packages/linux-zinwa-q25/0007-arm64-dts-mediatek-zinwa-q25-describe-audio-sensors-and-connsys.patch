+		/* LK reserves the CONSYS EMI at 0x7e000000; 0x7d000000 was the vicky value. */
+		consys_emi:   consys_emi@7e000000  { reg = <0 0x7e000000 0 0x500000>;  no-map; };
+		q25_held:     q25-held@7d000000    { reg = <0 0x7d000000 0 0x500000>;  no-map; };
 		sspm_ap_mem:  sspm_ap@9f560000     { reg = <0 0x9f560000 0 0x110000>;  no-map; };
 		apmdc_mem:    ap_md_c_smem@8c000000  { reg = <0 0x8c000000 0 0x16a0000>; no-map; };
 		apmdnc_mem:   ap_md_nc_smem@8e000000 { reg = <0 0x8e000000 0 0xe00000>;  no-map; };
@@ -135,6 +140,13 @@
 	 * The voltage gauge polls the ADC independently, so it needs no supply
 	 * notifications. Do not re-add the link.
 	 */
+	sound {
+		compatible = "zinwa,q25-mt6366-sound";
+		model = "Zinwa Q25";
+		mediatek,platform = <&afe_pcm>;
+		mediatek,speaker-amp = <&speaker_amp>;
+	};
+
 	fuel_gauge: fuel-gauge {
 		compatible = "adc-battery";
 		io-channels = <&pmic_adc MT6358_AUXADC_BATADC>;
@@ -615,6 +627,17 @@
 	};
 };
 
+/* Speaker amplifier: OCA72390 (AW87390 register clone). */
+&i2c3 {
+	status = "okay";
+
+	speaker_amp: amplifier@58 {
+		compatible = "ocs,oca72390";
+		reg = <0x58>;
+		sound-name-prefix = "Speaker";
+	};
+};
+
 /* RP2040 QWERTY keyboard and its light (q25-bbq-keys, q25-keyboard-led). */
 &i2c6 {
 	status = "okay";
@@ -634,6 +657,196 @@
 	status = "okay";
 };
 
+#define Q25_PINMUX(pin, func)	(((pin) << 8) | (func))
+
+&pio {
+	aud_clk_mosi_off: aud-clk-mosi-off {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(169, 0)>;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
+	aud_clk_mosi_on: aud-clk-mosi-on {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(169, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+	};
+
+	aud_clk_miso_off: aud-clk-miso-off {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(173, 0)>;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
+	aud_clk_miso_on: aud-clk-miso-on {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(173, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+	};
+
+	aud_dat_mosi_off: aud-dat-mosi-off {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(171, 0)>;
+			input-enable;
+			bias-pull-down;
+		};
+
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(172, 0)>;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
+	aud_dat_mosi_on: aud-dat-mosi-on {
+		pins-cmd0-dat {
+			pinmux = <Q25_PINMUX(171, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(172, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+	};
+
+	aud_dat_miso0_off: aud-dat-miso0-off {
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(175, 0)>;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
+	aud_dat_miso0_on: aud-dat-miso0-on {
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(175, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+	};
+
+	aud_dat_miso1_off: aud-dat-miso1-off {
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(176, 0)>;
+			input-enable;
+			bias-disable;
+		};
+	};
+
+	aud_dat_miso1_on: aud-dat-miso1-on {
+		pins-cmd1-dat {
+			pinmux = <Q25_PINMUX(176, 1)>;
+			input-schmitt-enable;
+			bias-disable;
+		};
+	};
+
+	/* The SCP sensor buses, handed to AP controllers (mode 2 -> 1). */
+	i2c1_sensor_pins: i2c1-sensor-default-state {
+		pins-bus {
+			pinmux = <Q25_PINMUX(132, 1)>, <Q25_PINMUX(133, 1)>;
+			bias-pull-up;
+		};
+	};
+
+	i2c9_sensor_pins: i2c9-sensor-default-state {
+		pins-bus {
+			pinmux = <Q25_PINMUX(148, 1)>, <Q25_PINMUX(149, 1)>;
+			bias-pull-up;
+		};
+	};
+
+	spi2_sensor_pins: spi2-sensor-default-state {
+		pins-spi {
+			pinmux = <Q25_PINMUX(38, 1)>, <Q25_PINMUX(39, 1)>,
+				 <Q25_PINMUX(40, 1)>;
+			bias-disable;
+		};
+
+		pins-spi-mi {
+			pinmux = <Q25_PINMUX(41, 1)>;
+			bias-pull-down;
+		};
+	};
+
+	/* GPIO177-185: CONN_TOP_CLK/DATA, BT_CLK/DATA, HRST_B, WB_PTA, WF_CTRL0-2. */
+	conn_adie_on_pins: conn-adie-on-pins {
+		pins {
+			pinmux = <Q25_PINMUX(177, 1)>, <Q25_PINMUX(178, 1)>,
+				 <Q25_PINMUX(179, 1)>, <Q25_PINMUX(180, 1)>,
+				 <Q25_PINMUX(181, 1)>, <Q25_PINMUX(182, 1)>,
+				 <Q25_PINMUX(183, 1)>, <Q25_PINMUX(184, 1)>,
+				 <Q25_PINMUX(185, 1)>;
+		};
+	};
+
+	conn_adie_off_pins: conn-adie-off-pins {
+		pins {
+			pinmux = <Q25_PINMUX(177, 0)>, <Q25_PINMUX(178, 0)>,
+				 <Q25_PINMUX(179, 0)>, <Q25_PINMUX(180, 0)>,
+				 <Q25_PINMUX(181, 0)>, <Q25_PINMUX(182, 0)>,
+				 <Q25_PINMUX(183, 0)>, <Q25_PINMUX(184, 0)>,
+				 <Q25_PINMUX(185, 0)>;
+		};
+	};
+};
+
+/* Magnetometer: MMC5603 (stock SCP bus 0). */
+&i2c1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_sensor_pins>;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	magnetometer@30 {
+		compatible = "memsic,mmc5603";
+		reg = <0x30>;
+	};
+};
+
+/* Ambient light and proximity: HX32062SE (stock SCP bus 2). */
+&i2c9 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c9_sensor_pins>;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	light-sensor@2b {
+		compatible = "tyhx,hx32062se";
+		reg = <0x2b>;
+		proximity-near-level = <3800>;
+	};
+};
+
+/* IMU: ICM-42607-P (stock SCP SPI1); the drivers poll, GPIO2 is not wired. */
+&spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi2_sensor_pins>;
+	status = "okay";
+
+	imu@0 {
+		compatible = "invensense,icm42607p";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+	};
+};
+
+/* CONN MCU reset (WDT_SWSYSRST, bit 12) is provided by q25-conn-pd. */
+&toprgu {
+	#reset-cells = <1>;
+};
+
 /* ------------------------------------------------------------------ *
  * Charger — Unisemipower UPM6922 on I2C5 @ 0x6B (stock DTBO fragment@36).
  * Register-compatible BQ25601 clone (REG0B PN=2), driven by the mainline
@@ -738,6 +951,165 @@
 		regulator-boot-on;
 		regulator-always-on;
 	};
+
