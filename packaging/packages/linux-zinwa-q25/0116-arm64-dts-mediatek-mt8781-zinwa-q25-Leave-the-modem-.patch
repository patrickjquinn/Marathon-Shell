From f60fdc7a1e5a878ba4703ed68e21f054f3d9ecbc Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 8 Nov 2026 13:18:48 +0000
Subject: [PATCH 116/119] arm64: dts: mediatek: mt8781-zinwa-q25: Leave the
 modem's MSDC0 gate alone

The modem owner held the MD MSDC0 gate for as long as MD1 was powered,
which kept MSDC0's mux and MSDCPLL running and with them the SoC out of
its 26 MHz-off idle. The stock modem node claims only the CCIF2 gates,
and with MD MSDC0 gated the modem stayed registered and attached.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index e740a8022..a0f9477e7 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -1280,9 +1280,8 @@ md1_owner: md1-owner {
 		firmware-name = "q25-md1/md1img.img";
 		clocks = <&infracfg_ao CLK_IFRAO_CCIF2_AP>,
 			 <&infracfg_ao CLK_IFRAO_CCIF2_MD>,
-			 <&infracfg_ao CLK_IFRAO_CLDMA_BCLK>,
-			 <&infracfg_ao CLK_IFRAO_MD_MSDC0>;
-		clock-names = "ccif2-ap", "ccif2-md", "cldma", "md-msdc0";
+			 <&infracfg_ao CLK_IFRAO_CLDMA_BCLK>;
+		clock-names = "ccif2-ap", "ccif2-md", "cldma";
 		#power-domain-cells = <0>;
 		phandle = <0x90>;
 	};
-- 
