From 105c7591b995d9a3635cd9c75e8b0dd26ecd8b4e Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Fri, 6 Nov 2026 09:45:37 +0000
Subject: [PATCH] arm64: dts: mediatek: mt6789: Add the CPU idle states

Without idle states an idle core can only wait in WFI: it keeps its
power, and the clusters never power down.

Describe the CPU-off and cluster-off states that the MT6789 firmware
implements as PSCI CPU_SUSPEND power states, with the suspend
parameters and latencies of the stock base device tree. They match
the MT8186 states, a SoC with the same 2x Cortex-A76 + 6x Cortex-A55
layout, except for the cluster suspend parameters, which this firmware
numbers 0x01010101 and 0x01010102.

The firmware implements platform-coordinated mode only (OSI is not
supported), so the states are a flat list per CPU. The MT6789 system
timer is already the tick broadcast device for local-timer-stop.

The stock tree's deeper mcusys and system states are left out: they
rely on MediaTek's SPM, which has no mainline driver, and asking for
them saved nothing over cluster-off.

Tested on a Zinwa Q25 (MT8781): at idle the cores spend 96-100% of
their time in cluster-off, with almost no rejected entries.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6789.dtsi | 48 ++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6789.dtsi b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
index a45e24c5..d92d95b6 100644
--- a/arch/arm64/boot/dts/mediatek/mt6789.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
@@ -41,6 +41,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x000>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -58,6 +59,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x100>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -75,6 +77,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x200>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -92,6 +95,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x300>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -109,6 +113,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x400>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -126,6 +131,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x500>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -143,6 +149,7 @@
 			compatible = "arm,cortex-a76";
 			reg = <0x600>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
 			clock-frequency = <2200000000>;
 			capacity-dmips-mhz = <1024>;
 			performance-domains = <&performance 1>;
@@ -160,6 +167,7 @@
 			compatible = "arm,cortex-a76";
 			reg = <0x700>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
 			clock-frequency = <2200000000>;
 			capacity-dmips-mhz = <1024>;
 			performance-domains = <&performance 1>;
@@ -209,6 +217,46 @@
 			};
 		};
 
+		idle-states {
+			entry-method = "psci";
+
+			cpu_off_l: cpu-off-l {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x00010001>;
+				local-timer-stop;
+				entry-latency-us = <50>;
+				exit-latency-us = <100>;
+				min-residency-us = <1600>;
+			};
+
+			cpu_off_b: cpu-off-b {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x00010002>;
+				local-timer-stop;
+				entry-latency-us = <50>;
+				exit-latency-us = <100>;
+				min-residency-us = <1400>;
+			};
+
+			cluster_off_l: cluster-off-l {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010101>;
+				local-timer-stop;
+				entry-latency-us = <100>;
+				exit-latency-us = <250>;
+				min-residency-us = <2100>;
+			};
+
+			cluster_off_b: cluster-off-b {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010102>;
+				local-timer-stop;
+				entry-latency-us = <100>;
+				exit-latency-us = <250>;
+				min-residency-us = <1900>;
+			};
+		};
+
 		l2_0: l2-cache0 {
 			compatible = "cache";
 			cache-level = <2>;
-- 
