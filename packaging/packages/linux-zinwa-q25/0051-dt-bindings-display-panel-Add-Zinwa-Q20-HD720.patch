From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 09:47:13 +0000
Subject: [PATCH] dt-bindings: display: panel: Add Zinwa Q20 HD720

Add the 720x720 two-lane video-mode DSI panel of the Zinwa Q25. Its
illumination follows the bias rails, so the binding takes both bias
supplies and no separate backlight.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 .../display/panel/zinwa,q20-hd720.yaml        | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/zinwa,q20-hd720.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/zinwa,q20-hd720.yaml b/Documentation/devicetree/bindings/display/panel/zinwa,q20-hd720.yaml
new file mode 100644
index 00000000..d87bbda1
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/zinwa,q20-hd720.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/zinwa,q20-hd720.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Zinwa Q20 HD720 720x720 MIPI-DSI panel
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The 3.1" 720x720 video-mode DSI panel of the Zinwa Q25, on two data
+  lanes. It has no brightness control of its own; its light follows the
+  source driver's positive and negative bias voltages.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: zinwa,q20-hd720
+
+  reg:
+    maxItems: 1
+
+  avdd-supply:
+    description: Positive source driver bias, 4.0 V to 6.0 V
+
+  avee-supply:
+    description: Negative source driver bias, -4.0 V to -6.0 V
+
+  enable-gpios: true
+  reset-gpios: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - avdd-supply
+  - avee-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "zinwa,q20-hd720";
+            reg = <0>;
+
+            avdd-supply = <&bias_pos>;
+            avee-supply = <&bias_neg>;
+            enable-gpios = <&pio 156 GPIO_ACTIVE_HIGH>;
+            reset-gpios = <&pio 85 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi_out>;
+                };
+            };
+        };
+    };
+...
