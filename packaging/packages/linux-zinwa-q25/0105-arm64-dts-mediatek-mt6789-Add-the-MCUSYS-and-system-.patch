-			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
+			cpu-idle-states = <&cpu_off_b &cluster_off_b &mcusys_off &system_mem &system_pll &system_bus>;
 			clock-frequency = <2200000000>;
 			capacity-dmips-mhz = <1024>;
 			performance-domains = <&performance 1>;
@@ -167,7 +167,7 @@
 			compatible = "arm,cortex-a76";
 			reg = <0x700>;
 			enable-method = "psci";
-			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
+			cpu-idle-states = <&cpu_off_b &cluster_off_b &mcusys_off &system_mem &system_pll &system_bus>;
 			clock-frequency = <2200000000>;
 			capacity-dmips-mhz = <1024>;
 			performance-domains = <&performance 1>;
@@ -255,6 +255,42 @@
 				exit-latency-us = <250>;
 				min-residency-us = <1900>;
 			};
+
+			mcusys_off: cluster-mcusys-off {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010701>;
+				local-timer-stop;
+				entry-latency-us = <450>;
+				exit-latency-us = <600>;
+				min-residency-us = <4000>;
+			};
+
+			system_mem: cluster-system-mem {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010f01>;
+				local-timer-stop;
+				entry-latency-us = <700>;
+				exit-latency-us = <850>;
+				min-residency-us = <4000>;
+			};
+
+			system_pll: cluster-system-pll {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010f02>;
+				local-timer-stop;
+				entry-latency-us = <800>;
+				exit-latency-us = <950>;
