From 2354a144708f44e9d0d653d5156fe26148d0b1d7 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Fri, 6 Nov 2026 15:01:48 +0000
Subject: [PATCH 105/105] arm64: dts: mediatek: mt6789: Add the MCUSYS and
 system idle states

Describe the deeper PSCI power states the MT6789 firmware implements
past cluster-off: MCUSYS off and the three system states (memory, PLL
and bus), with the suspend parameters and latencies of the stock base
device tree.

BL31 only enters them when the SPM firmware is loaded, which the
bootloader does (FW_INIT through MTK_SIP_BL_LPM_CONTROL), together with
the DPM firmware that keeps DRAM in self-refresh. Without the SPM
firmware BL31 falls back to a cluster power-down, so the states are
harmless on a bootloader that does not load it.

Tested on a Zinwa Q25 with both firmwares loaded: the phone boots and
stays up, and at idle the cores spend 75-86% of their time in the
system-bus state.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6789.dtsi | 52 ++++++++++++++++++++----
 1 file changed, 44 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6789.dtsi b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
index 59c30e37..9c2df072 100644
--- a/arch/arm64/boot/dts/mediatek/mt6789.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
@@ -41,7 +41,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x000>;
 			enable-method = "psci";
-			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
+			cpu-idle-states = <&cpu_off_l &cluster_off_l &mcusys_off &system_mem &system_pll &system_bus>;
 			clock-frequency = <2000000000>;
 			capacity-dmips-mhz = <578>;
 			performance-domains = <&performance 0>;
@@ -59,7 +59,7 @@
 			compatible = "arm,cortex-a55";
 			reg = <0x100>;
