+			};
+
+			system_bus: cluster-system-bus {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x01010f03>;
+				local-timer-stop;
+				entry-latency-us = <1300>;
+				exit-latency-us = <2800>;
+				min-residency-us = <4000>;
+			};
 		};
 
 		l2_0: l2-cache0 {
