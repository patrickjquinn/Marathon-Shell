+/* Q25 bring-up: PCM2 internal loopbacks for testing the modem path without the modem */
+static const char * const q25_pcm2_lpbk_str[] = {
+	"Off", "Buffer", "Parallel", "Serial", "DAI_PCM", "I2S_PCM",
+};
+static const unsigned int q25_pcm2_lpbk_bit[] = {
+	0, PCM2_BUFFER_LOOPBACK_SFT, PCM2_PARALLEL_LOOPBACK_SFT,
+	PCM2_SERIAL_LOOPBACK_SFT, PCM2_DAI_PCM_LOOPBACK_SFT, PCM2_I2S_PCM_LOOPBACK_SFT,
+};
+#define Q25_PCM2_LPBK_MASK (GENMASK(22, 18))
+
+static int q25_pcm2_lpbk_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kc);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(c);
+	unsigned int v = 0, i;
+
+	regmap_read(afe->regmap, PCM2_INTF_CON, &v);
+	uc->value.enumerated.item[0] = 0;
+	for (i = 1; i < ARRAY_SIZE(q25_pcm2_lpbk_bit); i++)
+		if (v & BIT(q25_pcm2_lpbk_bit[i]))
+			uc->value.enumerated.item[0] = i;
+	return 0;
+}
+
+static int q25_pcm2_lpbk_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kc);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(c);
+	unsigned int i = uc->value.enumerated.item[0];
+
+	if (i >= ARRAY_SIZE(q25_pcm2_lpbk_bit))
+		return -EINVAL;
+	regmap_update_bits(afe->regmap, PCM2_INTF_CON, Q25_PCM2_LPBK_MASK,
+			   i ? BIT(q25_pcm2_lpbk_bit[i]) : 0);
+	dev_info(afe->dev, "q25 PCM2 loopback -> %s\n", q25_pcm2_lpbk_str[i]);
+	return 1;
+}
+
+static const struct soc_enum q25_pcm2_lpbk_enum =
+	SOC_ENUM_SINGLE_EXT(ARRAY_SIZE(q25_pcm2_lpbk_str), q25_pcm2_lpbk_str);
+
+static const struct snd_kcontrol_new mtk_dai_pcm_controls[] = {
+	SOC_ENUM_EXT("Q25 PCM2 Loopback", q25_pcm2_lpbk_enum,
+		     q25_pcm2_lpbk_get, q25_pcm2_lpbk_put),
+};
