+/* Hostless front ends (speech, echo ref) have no memif behind their DAI id. */
+static snd_pcm_uframes_t mt6789_afe_pcm_pointer(struct snd_soc_component *component,
+						struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id >= afe->memif_size)
+		return 0;
+	return mtk_afe_pcm_pointer(component, substream);
+}
+
+static int mt6789_afe_component_probe(struct snd_soc_component *component)
+{
+	mtk_afe_add_sub_dai_control(component);
+	mt6789_add_misc_control(component);
+
+	return 0;
+}
