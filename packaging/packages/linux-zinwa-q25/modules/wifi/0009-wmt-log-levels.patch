--- a/wmt_drv/common_main/linux/osal.c
+++ b/wmt_drv/common_main/linux/osal.c
@@ -219,6 +219,22 @@
 	return ret;
 }
 
+INT32 osal_info_print(const PINT8 str, ...)
+{
+	va_list args;
+	INT32 ret;
+	INT8 tempString[DBG_LOG_STR_SIZE];
+
+	va_start(args, str);
+	ret = vsnprintf(tempString, DBG_LOG_STR_SIZE, str, args);
+	va_end(args);
+
+	if (ret > 0)
+		pr_info("%s", tempString);
+
+	return ret;
+}
