From: patrickjquinn <patrick.jm.quinn@gmail.com>
Subject: [PATCH] wmt: log info and debug messages at their own levels

The WMT, HIF-SDIO and STP log macros sent their info ([I]), debug ([D]),
loud ([L]) and trace lines through osal_warn_print(), so every routine
"[WMT-CORE][I]" or "[HIF-SDIO][I]" line reached the console at
KERN_WARNING, and turning the debug level up flooded it the same way.

Add osal_info_print() next to osal_dbg_print() and route the macros by
their tag: info lines at KERN_INFO, debug, loud and trace lines through
pr_debug. The macros' own runtime level gates are unchanged; warnings
and errors keep their levels.
---
--- a/include/drivers/misc/mediatek/connectivity/common/common_main/include/wmt_exp.h
+++ b/include/drivers/misc/mediatek/connectivity/common/common_main/include/wmt_exp.h
@@ -44,12 +44,12 @@
 #define WMT_LOUD_FUNC(fmt, arg...) \
 do { \
 	if (gWmtDbgLvl >= WMT_LOG_LOUD) \
-		osal_warn_print(DFT_TAG "[L]%s:"  fmt, __func__, ##arg); \
+		osal_dbg_print(DFT_TAG "[L]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_INFO_FUNC(fmt, arg...)  \
 do { \
 	if (gWmtDbgLvl >= WMT_LOG_INFO) \
-		osal_warn_print(DFT_TAG "[I]%s:"  fmt, __func__, ##arg); \
+		osal_info_print(DFT_TAG "[I]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_WARN_FUNC(fmt, arg...) \
 do { \
@@ -64,12 +64,12 @@
 #define WMT_DBG_FUNC(fmt, arg...) \
 do { \
 	if (gWmtDbgLvl >= WMT_LOG_DBG) \
-		osal_warn_print(DFT_TAG "[D]%s:"  fmt, __func__, ##arg); \
+		osal_dbg_print(DFT_TAG "[D]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_TRC_FUNC(f) \
 do { \
 	if (gWmtDbgLvl >= WMT_LOG_DBG) \
-		osal_warn_print(DFT_TAG "<%s> <%d>\n", __func__, __LINE__); \
+		osal_dbg_print(DFT_TAG "<%s> <%d>\n", __func__, __LINE__); \
 } while (0)
 
 #endif
--- a/include/drivers/misc/mediatek/connectivity/common/common_main/linux/include/osal.h
+++ b/include/drivers/misc/mediatek/connectivity/common/common_main/linux/include/osal.h
@@ -302,6 +302,7 @@
 INT32 osal_snprintf(PINT8 buf, UINT32 len, const PINT8 fmt, ...);
 INT32 osal_err_print(const PINT8 str, ...);
 INT32 osal_dbg_print(const PINT8 str, ...);
+INT32 osal_info_print(const PINT8 str, ...);
 INT32 osal_warn_print(const PINT8 str, ...);
 
 INT32 osal_dbg_assert(INT32 expr, const PINT8 file, INT32 line);
