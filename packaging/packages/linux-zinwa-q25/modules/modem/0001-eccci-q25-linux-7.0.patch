--- /dev/null
+++ b/ccci_util_lib/q25_ccci_smc.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Q25 boot chain: U-Boot sits in LK's place and never issues
+ * MTK_SIP_KERNEL_BOOT, so the installed BL31 (v2.4 8605b7e34f7) keeps
+ * dispatching Linux SiP calls to its BL33 table. The kernel CCCI ID returns
+ * SMC_UNK there; the LK CCCI ID (0x40B) is served. Try the kernel ID first so
+ * a fixed boot chain needs no change, then map the boot-path requests onto
+ * their LK-table equivalents (decoded from the BL31 handlers).
+ */
+#include <linux/arm-smccc.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include "q25_ccci_smc.h"
+
+#define SIP_KERNEL_CCCI		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+						   ARM_SMCCC_OWNER_SIP, 0x505)
+#define SIP_LK_CCCI		ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+						   ARM_SMCCC_OWNER_SIP, 0x40b)
+
+/* modem_secure_base.h */
+#define MD_POWER_CONFIG		6
+#define MD_KERNEL_BOOT_UP	0
+#define MD_CHECK_FLAG		2
+#define MD_CHECK_DONE		3
+#define MD_BOOT_STATUS		4
+#define MD_LK_BOOT_PLAT		8
+/* LK2 ccci_ld_md_sec.h */
+#define LK_BOOT_UP		1
+#define LK_GET_BOOT_UP_STATUS	7
+
+void q25_ccci_smc(unsigned long a1, unsigned long a2, unsigned long a3, unsigned long a4,
+		  unsigned long a5, unsigned long a6, unsigned long a7,
+		  struct arm_smccc_res *res)
+{
+	struct arm_smccc_res lk;
+
+	arm_smccc_smc(SIP_KERNEL_CCCI, a1, a2, a3, a4, a5, a6, a7, res);
+	if (res->a0 != SMCCC_RET_NOT_SUPPORTED && res->a0 != ~0UL)
+		return;
+	if (a1 != MD_POWER_CONFIG) {
+		pr_debug_ratelimited("q25-ccci: SiP CCCI %lu/%lu unavailable on this boot chain\n",
+				     a1, a2);
+		return;
+	}
+	switch (a2) {
+	case MD_KERNEL_BOOT_UP:
+		arm_smccc_smc(SIP_LK_CCCI, MD_POWER_CONFIG, LK_BOOT_UP, 0, 0, 0, 0, 0, res);
+		break;
+	case MD_LK_BOOT_PLAT:
+		arm_smccc_smc(SIP_LK_CCCI, MD_POWER_CONFIG, MD_LK_BOOT_PLAT, a3, 0, 0, 0, 0, res);
+		break;
+	case MD_CHECK_FLAG:
+	case MD_CHECK_DONE:
+	case MD_BOOT_STATUS:
+		arm_smccc_smc(SIP_LK_CCCI, MD_POWER_CONFIG, LK_GET_BOOT_UP_STATUS, 0, 0, 0, 0, 0,
+			      &lk);
+		if (lk.a0) {
+			*res = lk;
+			break;
+		}
+		if (a2 == MD_BOOT_STATUS) {
+			/* kernel layout: a1/a2 = the two boot status words */
+			res->a0 = 0;
+			res->a1 = lk.a1 >> 32;
+			res->a2 = lk.a1 & 0xffffffff;
+			res->a3 = 0;
+		} else {
+			/* four BROM check flags; all 1 means pass */
+			res->a1 = lk.a2 & 0xffffffff;
+			res->a2 = lk.a3 >> 32;
+			res->a3 = lk.a3 & 0xffffffff;
+			if (a2 == MD_CHECK_FLAG)
+				res->a0 = lk.a2 >> 32;
+			else
+				res->a0 = !(lk.a2 == 0x100000001UL && lk.a3 == 0x100000001UL);
+		}
+		break;
+	default:
+		break;
+	}
+}
+EXPORT_SYMBOL_GPL(q25_ccci_smc);
