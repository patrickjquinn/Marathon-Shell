+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Q25: the MediaTek display driver that retunes DSI/OSC clocks on modem RF
+ * notifications is not present (mainline mediatek-drm/simpledrm). The modem's
+ * desense requests are logged and acknowledged as unsupported.
+ */
+#include <linux/printk.h>
+
+void mtk_disp_mipi_clk_change(int msg, unsigned int en);
+void mtk_disp_mipi_ccci_callback(unsigned int para0, unsigned int para1);
+void mtk_disp_osc_ccci_callback(unsigned int para0, unsigned int para1);
+
+void mtk_disp_mipi_clk_change(int msg, unsigned int en)
+{
+	pr_debug("ccci: MIPI clock hop request %d/%u ignored\n", msg, en);
+}
+
+void mtk_disp_mipi_ccci_callback(unsigned int para0, unsigned int para1)
+{
+	pr_debug("ccci: MIPI_CLK RF notify %u/%u ignored\n", para0, para1);
+}
+
