 drivers/pmdomain/mediatek/mtk-pm-domains.c    |   5 +
 include/linux/soc/mediatek/infracfg.h         |  23 ++
 3 files changed, 256 insertions(+)
 create mode 100644 drivers/pmdomain/mediatek/mt6789-pm-domains.h

