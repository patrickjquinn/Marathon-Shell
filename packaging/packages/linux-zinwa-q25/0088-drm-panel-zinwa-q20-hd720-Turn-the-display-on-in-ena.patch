From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 4 Nov 2026 07:29:24 +0000
Subject: [PATCH] drm/panel: zinwa-q20-hd720: Turn the display on in enable

display-on was sent in prepare, before the DSI host streams video, so
the panel showed its blank frame memory, a white flash, on every wake.
Send it in enable, once video runs, and display-off in disable.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c | 32 ++++++++++++++++---
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c b/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c
index e30124d8..e858d9f4 100644
--- a/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c
+++ b/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c
@@ -94,8 +94,6 @@ static int q20_prepare(struct drm_panel *panel)
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 120);
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 20);
 	if (dsi_ctx.accum_err) {
 		dev_err(dev, "Failed to initialize panel: %d\n", dsi_ctx.accum_err);
 		ret = dsi_ctx.accum_err;
@@ -111,14 +109,38 @@ err_avdd:
 	return ret;
 }
 
-static int q20_unprepare(struct drm_panel *panel)
+/*
+ * Display on once the host sends video: turned on before, the panel shows
+ * its blank frame memory, a white flash on every wake.
+ */
+static int q20_enable(struct drm_panel *panel)
+{
+	struct q20_panel *ctx = to_q20_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static int q20_disable(struct drm_panel *panel)
 {
 	struct q20_panel *ctx = to_q20_panel(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
-	/* Sleep in before the bias goes, or the panel ghosts. */
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static int q20_unprepare(struct drm_panel *panel)
+{
+	struct q20_panel *ctx = to_q20_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* Sleep in before the bias goes, or the panel ghosts. */
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 120);
 	if (dsi_ctx.accum_err)
@@ -139,6 +161,8 @@ static int q20_get_modes(struct drm_panel *panel,
 
 static const struct drm_panel_funcs q20_panel_funcs = {
 	.prepare = q20_prepare,
+	.enable = q20_enable,
+	.disable = q20_disable,
 	.unprepare = q20_unprepare,
 	.get_modes = q20_get_modes,
 };
-- 
