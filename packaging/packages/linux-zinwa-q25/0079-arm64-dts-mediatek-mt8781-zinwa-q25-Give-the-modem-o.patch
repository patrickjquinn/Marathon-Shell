From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 23:00:43 +0000
Subject: [PATCH] arm64: dts: mediatek: mt8781-zinwa-q25: Give the modem owner
 its infra clocks

The CCIF2, CLDMA and MD MSDC0 infra gates are on at boot and the running
modem uses them, but nothing in the board description consumed them, so
the unused-clock sweep would gate them under the modem. Hand them to the
MD1 owner, which enables them whenever it powers MD1.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index c9664f52..f38b5ece 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -1259,6 +1259,11 @@
 	md1_owner: md1-owner {
 		compatible = "zinwa,q25-md1-owner";
 		firmware-name = "q25-md1/md1img.img";
+		clocks = <&infracfg_ao CLK_IFRAO_CCIF2_AP>,
+			 <&infracfg_ao CLK_IFRAO_CCIF2_MD>,
+			 <&infracfg_ao CLK_IFRAO_CLDMA_BCLK>,
+			 <&infracfg_ao CLK_IFRAO_MD_MSDC0>;
+		clock-names = "ccif2-ap", "ccif2-md", "cldma", "md-msdc0";
 		#power-domain-cells = <0>;
 		phandle = <0x90>;
 	};
-- 
