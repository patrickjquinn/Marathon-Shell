From 5a2fcec833a29ac2134a80f20501bbb60c117580 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 5 Nov 2026 09:56:10 +0000
Subject: [PATCH] arm64: dts: mediatek: mt8781-zinwa-q25: Give the keypad pull
 a value

Pins 66 and 67 are of the R1R0 pull type, for which the MT6789 pinctrl
driver wants the resistor pair in bias-pull-up. Without one it fails
with "Invalid pull argument", and the keypad never probes, which leaves
volume down and the assistant key dead.

Use MTK_PUPD_SET_R1R0_01, as other MT6789 boards do for inputs.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index 872ba341..230466e3 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -1465,7 +1465,7 @@
 		pins-cols {
 			pinmux = <Q25_PINMUX(66, 1)>, <Q25_PINMUX(67, 1)>;
 			input-enable;
-			bias-pull-up;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
 		};
 	};
 };
-- 
2.55.0

