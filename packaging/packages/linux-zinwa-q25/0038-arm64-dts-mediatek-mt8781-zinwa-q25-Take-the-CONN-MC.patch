From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 09:38:29 +0000
Subject: [PATCH] arm64: dts: mediatek: mt8781-zinwa-q25: Take the CONN MCU
 reset from the TOPRGU

The SoC dtsi now describes the TOPRGU as a reset controller, so the
board no longer adds #reset-cells for a private driver, and CONNSYS
names its reset by index.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index 293595bb..f5a0e904 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -862,11 +862,6 @@
 	};
 };
 
-/* CONN MCU reset (WDT_SWSYSRST, bit 12) is provided by q25-conn-pd. */
-&toprgu {
-	#reset-cells = <1>;
-};
-
 /* ------------------------------------------------------------------ *
  * Charger — Unisemipower UPM6922 on I2C5 @ 0x6B (stock DTBO fragment@36).
  * Register-compatible BQ25601 clone (REG0B PN=2), driven by the mainline
@@ -1101,7 +1096,7 @@
 		power-domains = <&spm MT6789_POWER_DOMAIN_CONN>;
 		clocks = <&infracfg_ao CLK_IFRAO_CCIF4_AP>;
 		clock-names = "ccif";
-		resets = <&toprgu 12>;
+		resets = <&toprgu MT6789_TOPRGU_CONN_MCU_SW_RST>;
 		vcn18-supply = <&mt6366_vcn18_reg>;
 		vcn28-supply = <&mt6366_vcn28_reg>;
 		vcn33-supply = <&mt6366_vcn33_reg>;
