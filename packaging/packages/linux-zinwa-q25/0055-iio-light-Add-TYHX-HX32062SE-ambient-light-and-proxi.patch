 drivers/iio/light/Kconfig     |  11 +
 drivers/iio/light/Makefile    |   1 +
 drivers/iio/light/hx32062se.c | 417 ++++++++++++++++++++++++++++++++++
 4 files changed, 430 insertions(+)
 create mode 100644 drivers/iio/light/hx32062se.c

