builddir="$srcdir/mtk_g99-mainline-$_commit"

unpack() {
	tar -C "$srcdir" -xzf "$SRCDEST/mtk_g99-mainline-$_commit.tar.gz"
	tar -C "$srcdir" -xzf "$SRCDEST/android_kernel_ikko_mindone-$_mindone.tar.gz" \
		"android_kernel_ikko_mindone-$_mindone/mindone/modules"
}

prepare() {
	default_prepare
	cp "$srcdir/config-zinwa-q25.aarch64" .config
	make ARCH=arm64 LLVM=1 olddefconfig
	local afe="$srcdir/mt6789-sound/sound/soc/mediatek/mt6789" f
	mkdir -p "$afe"
	for f in $_afe; do
		cp "$srcdir/$f" "$afe/"
	done
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
	make ARCH=arm64 LLVM=1 Image vmlinuz.efi modules mediatek/mt8781-zinwa-q25.dtb
	[ "$(cat include/config/kernel.release)" = "$_release" ]
	# The camera overlay resolves its targets through the base's symbols.
	scripts/dtc/dtc -q -I dtb -O dts arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dtb |
		grep -q "__symbols__ {"
	MT6789_SOUND="$srcdir/mt6789-sound" JOBS="${JOBS:-2}" \
		sh "$startdir/modules/build.sh" "$builddir" "$builddir" \
		"$srcdir/android_kernel_ikko_mindone-$_mindone" "$srcdir/q25-modules"
}

package() {
	make ARCH=arm64 LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/usr/lib/modules/$_release/build
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/linux.efi
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/usr/lib/modules/$_release/vmlinuz
	install -Dm644 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dtb \
		"$pkgdir"/boot/dtbs/mediatek/mt8781-zinwa-q25.dtb
	install -Dm644 include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/zinwa-q25/kernel.release
}

# Out-of-tree modules by directory under extra/; every built module is listed.
_extra="q25-md1-owner
	q25-haptic"
_connsys="connadp btif_drv wmt_drv wmt_chrdev_wifi wlan_drv_gen4m_6789
	q25-btmtk-stp mtk-connsys-gnss"
_audio="snd-soc-mt6358 snd-soc-mtk-common snd-soc-mt6789-afe
	q25-mt6366-card q25-mt6358-accdet"
_camera="q25-cam-dt wl2868c-regulator videobuf2-common videobuf2-memops
	videobuf2-v4l2 videobuf2-dma-contig phy-mtk-mipi-csi-2-1 mtk-seninf6s mtk-camsv6s"
_modem="ccci_util_lib ccmni ccci_md_all ccci_ccif ccci_dpmaif"

_modules() {
	pkgdesc="Zinwa Q25 out-of-tree drivers for linux-zinwa-q25"
	depends="kmod $pkgname=$pkgver-r$pkgrel"
	local out="$srcdir/q25-modules" extra="$subpkgdir/usr/lib/modules/$_release/extra"
	local d m n=0
	for d in extra connsys audio camera modem; do
		local dir="$extra/q25-$d" list
		eval "list=\$_$d"
		[ "$d" = extra ] && dir="$extra"
		for m in $list; do
			install -Dm644 "$out/modules/$m.ko" "$dir/$m.ko"
			n=$((n + 1))
		done
	done
	[ "$n" = "$(ls "$out"/modules/*.ko | wc -l)" ]
	install -Dm644 "$out/firmware/q25-camera.dtbo" \
		"$subpkgdir"/usr/lib/firmware/q25-camera.dtbo
}

