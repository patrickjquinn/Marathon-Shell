# Zinwa Q25 kernel: ellyq's mtk_g99-mainline at the commit the phone runs,
# with its config. g99-* and panel-zinwa-q20-hd720.c are the MT6789 display,
# charger and pinctrl changes the phone's kernel was built with; 0001-0011
# are the Q25's (devices/zinwa/q25/kernel/README.md). The release keeps the
# -q25-cfi-test suffix q25-kernel-modules, q25-modem and q25-gpu-render were
# built for, and only the in-tree modules the phone boots with are built.
pkgname=linux-zinwa-q25
pkgver=7.0.0
pkgrel=0
_commit=978b8b672d68e43b08c891132b974255489889aa
_release=7.0.0-q25-cfi-test
pkgdesc="Zinwa Q25 Pro kernel"
url="https://gitlab.nura.eco/ellyq/mtk_g99-mainline"
arch="aarch64"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
makedepends="
	bison
	clang
	findutils
	flex
	kmod
	lld
	llvm
	openssl-dev
	perl
	python3
	zstd
"
# The prebuilt kernel package this one takes over from.
replaces="linux-postmarketos-mediatek-g99"
_modules="
	drivers/input/evdev.ko
	drivers/input/rmi4/rmi_core.ko
	drivers/input/rmi4/rmi_i2c.ko
	drivers/md/dm-bufio.ko
	drivers/md/dm-verity.ko
	drivers/misc/rpmb-core.ko
	drivers/ufs/core/ufshcd-core.ko
	drivers/ufs/host/ufs-mediatek.ko
	drivers/ufs/host/ufshcd-pltfrm.ko
	drivers/usb/gadget/function/u_ether.ko
	drivers/usb/gadget/function/u_serial.ko
	drivers/usb/gadget/function/usb_f_acm.ko
	drivers/usb/gadget/function/usb_f_mass_storage.ko
	drivers/usb/gadget/function/usb_f_ncm.ko
	drivers/usb/gadget/function/usb_f_rndis.ko
	drivers/usb/gadget/libcomposite.ko
	drivers/usb/storage/usb-storage.ko
	fs/binfmt_misc.ko
	fs/erofs/erofs.ko
	fs/netfs/netfs.ko
	fs/nls/nls_iso8859-1.ko
	fs/nls/nls_utf8.ko
	fs/overlayfs/overlay.ko
	fs/xfs/xfs.ko
"
source="mtk_g99-mainline-$_commit.tar.gz::https://gitlab.nura.eco/ellyq/mtk_g99-mainline/-/archive/$_commit/mtk_g99-mainline-$_commit.tar.gz
	config-zinwa-q25.aarch64
	panel-zinwa-q20-hd720.c
	g99-0001-drm-mediatek-add-mt6789-display-support.patch
	g99-0003-power-supply-bq256xx-ensure-charging-enabled-at-probe.patch
	g99-0004-pinctrl-mt6789-guard-sleep-pm-ops.patch
	0001-iio-adc-mt6359-include-resolution-in-scale.patch
	0003-net-wwan-q25-rpc-metadata-validator.patch
	0005-arm64-dts-mediatek-add-the-Zinwa-Q25-board.patch
	0006-arm64-dts-mediatek-zinwa-q25-match-the-accepted-boot.patch
	0007-arm64-dts-mediatek-zinwa-q25-describe-audio-sensors-and-connsys.patch
	0008-arm64-dts-mediatek-zinwa-q25-let-the-panel-sleep-in-Doze.patch
	0009-mfd-mt6358-fix-AUD-and-MISC-top-status-bits.patch
	0010-arm64-dts-mediatek-zinwa-q25-reserve-a-camera-pool.patch
	0011-arm64-dts-mediatek-zinwa-q25-describe-the-MD1-modem.patch
"
builddir="$srcdir/mtk_g99-mainline-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/panel-zinwa-q20-hd720.c" drivers/gpu/drm/panel/
	echo 'obj-$(CONFIG_DRM_PANEL_ZINWA_Q20_HD720) += panel-zinwa-q20-hd720.o' \
		>> drivers/gpu/drm/panel/Makefile
	printf '\nconfig DRM_PANEL_ZINWA_Q20_HD720\n\ttristate "Zinwa Q25 q20_v12 720x720 DSI panel"\n\tdepends on OF\n\tdepends on DRM_MIPI_DSI\n\tdepends on BACKLIGHT_CLASS_DEVICE\n' \
		>> drivers/gpu/drm/panel/Kconfig
	cp "$srcdir/config-zinwa-q25.aarch64" .config
	make ARCH=arm64 LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
	make ARCH=arm64 LLVM=1 Image vmlinuz.efi mediatek/mt6789-zinwa-q25.dtb
	# modpost resolves the modules against vmlinux.symvers.
	make ARCH=arm64 LLVM=1 $_modules
	[ "$(cat include/config/kernel.release)" = "$_release" ]
	# Single-module targets leave no modules.order for modules_install.
	for m in $_modules; do echo "${m%.ko}.o"; done > modules.order
}

package() {
	make ARCH=arm64 LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/usr/lib/modules/$_release/build
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/linux.efi
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/usr/lib/modules/$_release/vmlinuz
	install -Dm644 arch/arm64/boot/dts/mediatek/mt6789-zinwa-q25.dtb \
		"$pkgdir"/boot/dtbs/mediatek/mt6789-zinwa-q25.dtb
	install -Dm644 include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/zinwa-q25/kernel.release
}

