# Zinwa Q25 kernel: ellyq's mtk_g99-mainline (the MT6789 tree) at 978b8b67
# with the Q25 series below and its config, plus the Q25 out-of-tree drivers
# (modules/, built against this tree into q25-kernel-modules). The patches
# are a git format-patch series; devices/zinwa/q25/kernel/README.md says
# where each one stands upstream. pkgrel continues q25-kernel-modules'
# numbering, which this package now builds.
pkgname=linux-zinwa-q25
pkgver=7.0.0
pkgrel=25
_commit=978b8b672d68e43b08c891132b974255489889aa
# Vendor CONNSYS/ECCCI sources (mindone/modules) and the MT6789 AFE
# (adomerle/mt6789-sound) that modules/ builds.
_mindone=9cd73c15f312cfd1e40a22d871de65a2fb2c5791
_sound=996ec48145f6746ecc664e92c6e5892b6978e3ae
_afe="
