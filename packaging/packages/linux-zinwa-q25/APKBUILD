# Zinwa Q25 kernel: ellyq's mtk_g99-mainline (the MT6789 tree) at 978b8b67
# with the Q25 series below and its config. Every configured module is built
# here; only Q25 shims and vendor drivers ship out of tree
# (devices/zinwa/q25/modules). The patches are a git format-patch series;
# devices/zinwa/q25/kernel/README.md says where each one stands upstream.
pkgname=linux-zinwa-q25
pkgver=7.0.0
pkgrel=2
_commit=978b8b672d68e43b08c891132b974255489889aa
_release=7.0.0-q25
pkgdesc="Zinwa Q25 Pro kernel"
url="https://gitlab.nura.eco/ellyq/mtk_g99-mainline"
arch="aarch64"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
makedepends="
	bison
	clang
	findutils
	flex
	kmod
	lld
	llvm
	openssl-dev
	perl
	python3
	zstd
"
# The prebuilt kernel package this one takes over from.
replaces="linux-postmarketos-mediatek-g99"
source="mtk_g99-mainline-$_commit.tar.gz::https://gitlab.nura.eco/ellyq/mtk_g99-mainline/-/archive/$_commit/mtk_g99-mainline-$_commit.tar.gz
