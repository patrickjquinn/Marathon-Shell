Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
index 05c121b0..d74a691d 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6397.yaml
@@ -107,6 +107,11 @@ properties:
     $ref: /schemas/iio/adc/mediatek,mt6359-auxadc.yaml#
     unevaluatedProperties: false
 
+  fuel-gauge:
+    type: object
+    $ref: /schemas/power/supply/mediatek,mt6358-gauge.yaml#
+    unevaluatedProperties: false
+
   audio-codec:
     type: object
     description:
