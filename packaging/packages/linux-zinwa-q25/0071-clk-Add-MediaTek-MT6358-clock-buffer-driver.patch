 drivers/clk/Kconfig      |  11 +++
 drivers/clk/Makefile     |   1 +
 drivers/clk/clk-mt6358.c | 173 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 186 insertions(+)
 create mode 100644 drivers/clk/clk-mt6358.c

