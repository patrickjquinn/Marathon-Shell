From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 18:27:49 +0000
Subject: [PATCH] dt-bindings: iio: light: Add TYHX HX32062SE

The TYHX HX32062SE is an ambient light and infrared proximity sensor
with an I2C interface and an interrupt output. It sits on the Zinwa Q25.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 .../bindings/iio/light/tyhx,hx32062se.yaml    | 56 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 62 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/light/tyhx,hx32062se.yaml

diff --git a/Documentation/devicetree/bindings/iio/light/tyhx,hx32062se.yaml b/Documentation/devicetree/bindings/iio/light/tyhx,hx32062se.yaml
new file mode 100644
index 00000000..7dbef7d7
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/light/tyhx,hx32062se.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/light/tyhx,hx32062se.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TYHX HX32062SE ambient light and proximity sensor
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  Ambient light and infrared proximity sensor with an I2C interface and an
+  interrupt output.
+
+allOf:
+  - $ref: ../common.yaml#
+
+properties:
+  compatible:
+    const: tyhx,hx32062se
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vdd-supply: true
+
+  proximity-near-level: true
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        light-sensor@2b {
+            compatible = "tyhx,hx32062se";
+            reg = <0x2b>;
+            interrupt-parent = <&gpio1>;
+            interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
+            vdd-supply = <&reg_3v3>;
+            proximity-near-level = <600>;
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 358eeee4..fdd3bc10 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -26987,6 +26987,12 @@ W:	http://linuxtv.org
 T:	git git://linuxtv.org/media.git
 F:	drivers/media/pci/tw686x/
 
+TYHX HX32062SE AMBIENT LIGHT AND PROXIMITY SENSOR DRIVER
+M:	Patrick Quinn <patrick.jm.quinn@gmail.com>
+L:	linux-iio@vger.kernel.org
+S:	Maintained
+F:	Documentation/devicetree/bindings/iio/light/tyhx,hx32062se.yaml
+
 U-BOOT ENVIRONMENT VARIABLES
 M:	Rafał Miłecki <rafal@milecki.pl>
 S:	Maintained
