From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 20:33:54 +0000
Subject: [PATCH] dt-bindings: power: supply: Add MediaTek MT6358 fuel gauge

The MT6358 and MT6366 PMICs have a fuel gauge that measures the battery
current across an external shunt and integrates it in a coulomb counter.
It reads the battery voltage through the PMIC's AUXADC.

The effective shunt resistance is a board property; vendor trees carry
it as a nominal value plus a separate tuning factor, which folds into
the one resistance.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 .../power/supply/mediatek,mt6358-gauge.yaml   | 52 +++++++++++++++++++
 MAINTAINERS                                   |  6 +++
 2 files changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/mediatek,mt6358-gauge.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/mediatek,mt6358-gauge.yaml b/Documentation/devicetree/bindings/power/supply/mediatek,mt6358-gauge.yaml
new file mode 100644
index 00000000..fb51f579
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6358-gauge.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6358-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6358 PMIC fuel gauge
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The fuel gauge of the MediaTek MT6358 and MT6366 PMICs measures the
+  battery current across an external shunt resistor and integrates it in a
+  coulomb counter. It is a child of the PMIC node and takes the battery
+  voltage from the PMIC's AUXADC.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6358-gauge
+
+  io-channels:
+    items:
+      - description: Battery voltage
+
+  shunt-resistor-micro-ohms:
+    description:
+      Effective resistance of the current sense shunt, including any
+      calibration of its tolerance.
+
+required:
+  - compatible
+  - io-channels
+  - monitored-battery
+  - shunt-resistor-micro-ohms
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/iio/adc/mediatek,mt6358-auxadc.h>
+
+    fuel-gauge {
+        compatible = "mediatek,mt6358-gauge";
+        io-channels = <&pmic_adc MT6358_AUXADC_BATADC>;
+        monitored-battery = <&battery>;
+        power-supplies = <&charger>;
+        shunt-resistor-micro-ohms = <990>;
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index c0d2a007..6633cf0c 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -16269,6 +16269,12 @@ S:	Maintained
 F:	Documentation/devicetree/bindings/mmc/mtk-sd.yaml
 F:	drivers/mmc/host/mtk-sd.c
 
+MEDIATEK MT6358 FUEL GAUGE DRIVER
