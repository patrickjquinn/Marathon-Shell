diff --git a/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c b/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c
new file mode 100644
index 00000000..e30124d8
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Zinwa Q20 HD720 720x720 MIPI-DSI panel (Zinwa Q25).
+ *
+ * The panel has no brightness register: its light follows the source
+ * driver bias, so the backlight device sets the AVDD/AVEE voltage.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#define Q20_BIAS_MIN_UV		4000000
+#define Q20_BIAS_STEP_UV	100000
+#define Q20_BRIGHTNESS_MAX	20
+#define Q20_BRIGHTNESS_DEFAULT	14
+
+struct q20_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *avdd;
+	struct regulator *avee;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct q20_panel *to_q20_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct q20_panel, panel);
+}
+
+/*
+ * The bootloader's timing: two lanes at 652 Mbit/s, the rate the panel
+ * needs to lock, and these porches give 70.93 Hz.
+ */
+static const struct drm_display_mode q20_mode = {
+	.clock = 51400,
+	.hdisplay = 720,
+	.hsync_start = 720 + 60,
+	.hsync_end = 720 + 60 + 50,
+	.htotal = 720 + 60 + 50 + 40,
+	.vdisplay = 720,
+	.vsync_start = 720 + 68,
+	.vsync_end = 720 + 68 + 5,
+	.vtotal = 720 + 68 + 5 + 40,
+	.width_mm = 62,
+	.height_mm = 62,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int q20_set_bias(struct q20_panel *ctx, int level)
+{
+	int uv = Q20_BIAS_MIN_UV + level * Q20_BIAS_STEP_UV;
+	int ret;
+
+	ret = regulator_set_voltage(ctx->avdd, uv, uv);
+	if (ret)
+		return ret;
+
+	return regulator_set_voltage(ctx->avee, uv, uv);
+}
+
+static int q20_prepare(struct drm_panel *panel)
+{
+	struct q20_panel *ctx = to_q20_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+
+	ret = regulator_enable(ctx->avdd);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable(ctx->avee);
+	if (ret)
+		goto err_avdd;
+
+	msleep(20);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(120);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	if (dsi_ctx.accum_err) {
+		dev_err(dev, "Failed to initialize panel: %d\n", dsi_ctx.accum_err);
+		ret = dsi_ctx.accum_err;
+		goto err_avee;
+	}
+
+	return 0;
+
+err_avee:
+	regulator_disable(ctx->avee);
+err_avdd:
+	regulator_disable(ctx->avdd);
+	return ret;
+}
+
+static int q20_unprepare(struct drm_panel *panel)
+{
+	struct q20_panel *ctx = to_q20_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* Sleep in before the bias goes, or the panel ghosts. */
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	if (dsi_ctx.accum_err)
+		dev_err(&ctx->dsi->dev, "Failed to sleep panel: %d\n",
+			dsi_ctx.accum_err);
+
+	regulator_disable(ctx->avee);
+	regulator_disable(ctx->avdd);
+
+	return 0;
+}
+
+static int q20_get_modes(struct drm_panel *panel,
+			 struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &q20_mode);
+}
+
+static const struct drm_panel_funcs q20_panel_funcs = {
+	.prepare = q20_prepare,
+	.unprepare = q20_unprepare,
+	.get_modes = q20_get_modes,
+};
+
+static int q20_bl_update_status(struct backlight_device *bl)
+{
+	struct q20_panel *ctx = bl_get_data(bl);
+
+	if (backlight_is_blank(bl))
+		return 0;
+
+	return q20_set_bias(ctx, backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops q20_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = q20_bl_update_status,
+};
+
+static int q20_bias_level(struct q20_panel *ctx)
+{
+	int uv = regulator_get_voltage(ctx->avdd);
+
+	if (uv < Q20_BIAS_MIN_UV)
+		return Q20_BRIGHTNESS_DEFAULT;
+
+	return min((uv - Q20_BIAS_MIN_UV) / Q20_BIAS_STEP_UV,
+		   Q20_BRIGHTNESS_MAX);
+}
+
+static int q20_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = Q20_BRIGHTNESS_MAX,
+	};
+	struct q20_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct q20_panel, panel,
+				   &q20_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(ctx->avdd))
+		return dev_err_probe(dev, PTR_ERR(ctx->avdd),
+				     "Failed to get avdd\n");
+
+	ctx->avee = devm_regulator_get(dev, "avee");
+	if (IS_ERR(ctx->avee))
+		return dev_err_probe(dev, PTR_ERR(ctx->avee),
+				     "Failed to get avee\n");
+
+	/* The bootloader leaves the panel lit: do not glitch its pins. */
+	ctx->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 2;
+	dsi->hs_rate = 652000000;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	props.brightness = q20_bias_level(ctx);
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							      dev, ctx,
+							      &q20_bl_ops,
+							      &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void q20_remove(struct mipi_dsi_device *dsi)
+{
+	struct q20_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id q20_of_match[] = {
+	{ .compatible = "zinwa,q20-hd720" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, q20_of_match);
+
+static struct mipi_dsi_driver q20_driver = {
+	.probe = q20_probe,
+	.remove = q20_remove,
+	.driver = {
+		.name = "panel-zinwa-q20-hd720",
+		.of_match_table = q20_of_match,
+	},
+};
+module_mipi_dsi_driver(q20_driver);
+
+MODULE_AUTHOR("Patrick Quinn <patrick.jm.quinn@gmail.com>");
+MODULE_DESCRIPTION("Zinwa Q20 HD720 MIPI-DSI panel driver");
+MODULE_LICENSE("GPL");
