 drivers/gpu/drm/panel/Kconfig                 |  14 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c | 263 ++++++++++++++++++
 4 files changed, 284 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-zinwa-q20-hd720.c

