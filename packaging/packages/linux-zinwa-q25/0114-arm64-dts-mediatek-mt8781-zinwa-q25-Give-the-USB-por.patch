From c13bd8fe7f1bca89cec1513f51a1a68d8c871ad7 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 8 Nov 2026 12:34:28 +0000
Subject: [PATCH 114/119] arm64: dts: mediatek: mt8781-zinwa-q25: Give the USB
 port its VBUS supply

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index 6afef8d04..e740a8022 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -1458,6 +1458,8 @@ &usb2 {
 	status = "okay";
 	dr_mode = "peripheral";
 	maximum-speed = "high-speed";
+	/* VBUS, which the port's PHY forces in device mode. */
+	power-supplies = <&charger>;
 };
 
