From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 18:29:23 +0000
Subject: [PATCH] arm64: dts: mediatek: mt8781-zinwa-q25: Use the aw87390
 binding for the amplifier

Describe the speaker amplifier with the zinwa,q25-amp compatible so the
aw87390 driver binds to it, and add the #sound-dai-cells the binding
requires.

Signed-off-by: patrickjquinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
index 7f6f6a33..83b1ae44 100644
--- a/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-zinwa-q25.dts
@@ -699,8 +699,9 @@
 	status = "okay";
 
 	speaker_amp: amplifier@58 {
-		compatible = "ocs,oca72390";
+		compatible = "zinwa,q25-amp", "ocs,oca72390";
 		reg = <0x58>;
+		#sound-dai-cells = <0>;
 		sound-name-prefix = "Speaker";
 	};
 };
