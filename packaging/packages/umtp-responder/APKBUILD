# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# uMTP-Responder: the MTP server for USB file transfer over FunctionFS.
# marathon-usb-mode writes its configuration and starts it per connection.
pkgname=umtp-responder
pkgver=1.8.1
pkgrel=0
pkgdesc="Lightweight USB Media Transfer Protocol (MTP) responder"
url="https://github.com/viveris/uMTP-Responder"
arch="all"
license="GPL-3.0-or-later"
makedepends="linux-headers"
options="!check"
source="$pkgname-$pkgver.tar.gz::https://github.com/viveris/uMTP-Responder/archive/refs/tags/umtprd-$pkgver.tar.gz
	0001-opensession-already-open-parameter-size.patch
	"
builddir="$srcdir/uMTP-Responder-umtprd-$pkgver"

build() {
	make USE_SYSLOG=1
}

package() {
	install -Dm755 umtprd "$pkgdir"/usr/bin/umtprd
}

