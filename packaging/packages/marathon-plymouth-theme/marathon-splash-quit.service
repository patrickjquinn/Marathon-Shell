[Unit]
Description=Hand the boot splash over to Marathon Shell

[Service]
Type=oneshot
RemainAfterExit=yes
# The shell's first frame replaced the splash: leave it. No frame by the
# timer: take the splash down.
ExecStart=-/bin/sh -c 'if ls /run/user/*/marathon-shell-ready >/dev/null 2>&1; then exec plymouth quit --retain-splash; fi; exec plymouth quit'
TimeoutStartSec=20
