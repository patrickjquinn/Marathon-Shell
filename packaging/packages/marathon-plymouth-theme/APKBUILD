# Maintainer: Patrick Quinn <patrick@jquinn.com>
pkgname=marathon-plymouth-theme
pkgver=1.0.0
pkgrel=7
pkgdesc="Marathon OS boot splash for plymouth"
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="noarch"
options="!check"
depends="plymouth"
# We override /usr/share/plymouth/plymouthd.defaults (owned by the
# upstream plymouth package AND by postmarketos-bootsplash, the latter
# pulled in transitively by postmarketos-duranium-initramfs). apk needs
# explicit replaces= permission for the overlap.
replaces="plymouth postmarketos-bootsplash"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	marathon.plymouth
	marathon.script
	marathon-logo.png
	progress-track.png
	progress-fill.png
	"

package() {
	# Install the theme files into plymouth's themes directory.
	install -Dm644 "$srcdir/marathon.plymouth" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon.plymouth"
	install -Dm644 "$srcdir/marathon.script" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon.script"
	install -Dm644 "$srcdir/marathon-logo.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon-logo.png"
	install -Dm644 "$srcdir/progress-track.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/progress-track.png"
	install -Dm644 "$srcdir/progress-fill.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/progress-fill.png"

	# Override /usr/share/plymouth/plymouthd.defaults with our theme
	# selection. This file is Plymouth's last-resort default lookup
	# (after /etc/plymouth/plymouthd.conf which doesn't exist on first
	# boot before systemd-tmpfiles runs). The apk's `replaces=plymouth`
	# directive above grants permission to overwrite the upstream
	# plymouth package's copy.
	#
	# Why /usr/share/plymouth/plymouthd.defaults rather than the
	# initramfs: Plymouth on Duranium starts from the rootfs path after
	# /usr is verity-mounted, NOT from a baked-in initramfs theme. The
	# pre-built linux-rpi kernel apk doesn't carry a plymouth theme
	# selection so the resolution falls through to plymouthd.defaults
	# which is exactly where we want our override.
	install -d "$pkgdir/usr/share/plymouth"
	cat > "$pkgdir/usr/share/plymouth/plymouthd.defaults" <<-EOF
		[Daemon]
		Theme=marathon
		ShowDelay=0
		DeviceTimeout=8
		# On the HackberryPi CM5 + HyperPixel, plymouth's auto-renderer picks
		# /dev/dri/card0 (vc4 HDMI, disconnected) instead of /dev/dri/card2
		# (rp1-dpi, the actual HyperPixel) because card0 sorts first. The
		# drm renderer then can't find a CRTC and silently falls back to no
		# visible output. Setting Renderer=fbdev tells plymouth to render
		# into /dev/fb0 instead — that fb is wired to fbcon on the rp1-dpi
		# panel, so the Marathon splash lands directly on the HyperPixel.
		Renderer=fbdev
	EOF
	chmod 644 "$pkgdir/usr/share/plymouth/plymouthd.defaults"

	# Belt-and-braces: factory→/etc/plymouth/plymouthd.conf for second
	# boot onward, when /etc has been provisioned. Plymouth reads /etc
	# in preference to /usr/share so this becomes the user-visible
	# config and matches what plymouth-set-default-theme would write.
	install -d "$pkgdir/usr/share/factory/etc/plymouth"
	cat > "$pkgdir/usr/share/factory/etc/plymouth/plymouthd.conf" <<-EOF
		[Daemon]
		Theme=marathon
		Renderer=fbdev
	EOF
	chmod 644 "$pkgdir/usr/share/factory/etc/plymouth/plymouthd.conf"

	install -d "$pkgdir/usr/lib/tmpfiles.d"
	cat > "$pkgdir/usr/lib/tmpfiles.d/marathon-plymouth.conf" <<-EOF
		C /etc/plymouth/plymouthd.conf 0644 - - - /usr/share/factory/etc/plymouth/plymouthd.conf
	EOF
	chmod 644 "$pkgdir/usr/lib/tmpfiles.d/marathon-plymouth.conf"
}

