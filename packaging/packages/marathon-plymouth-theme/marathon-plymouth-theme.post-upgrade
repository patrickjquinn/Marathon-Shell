#!/bin/sh
# Re-set theme + rebuild initramfs on upgrade in case the user changed
# their default theme via plymouth-set-default-theme.
set -e

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R marathon || true
fi
touch /var/lib/marathon-plymouth-pending-initrd-rebuild

exit 0
