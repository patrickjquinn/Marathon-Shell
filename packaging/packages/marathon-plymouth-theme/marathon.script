// Marathon OS boot splash — implements docs/redesign/marathonos/project/screens-shell.jsx
// BootSplash component as a Plymouth theme. Matches: black background, centered
// 96px M-in-teal-circle with subtle glow, "MARATHON" tracked uppercase below,
// 140x2 teal progress bar near the bottom.
//
// Plymouth scripting reference:
//   https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/

// ── Window setup ──────────────────────────────────────────────────────
// Solid black — matches the JSX `background: '#000'`.
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// ── Logo (the M-in-teal-circle, pre-rendered with halo) ───────────────
logo.image = Image("marathon-logo.png");
logo_w = logo.image.GetWidth();
logo_h = logo.image.GetHeight();
logo.sprite = Sprite(logo.image);
// Vertically biased slightly above center to match the JSX layout (the
// "MARATHON" wordmark sits 28px below the circle; vertical centering of
// the *group* puts the circle a bit above true-center).
logo.sprite.SetX(screen_width / 2 - logo_w / 2);
logo.sprite.SetY(screen_height / 2 - logo_h / 2 - 24);
logo.sprite.SetZ(10);

// ── MARATHON wordmark (tracked uppercase) ─────────────────────────────
// Plymouth's `Image.Text(text, r, g, b, a, font)` rasterizes via pango/cairo.
// "Inter 14 weight 300" with letter-spacing approximated by font name; the
// pango `letter-spacing` attribute isn't available in Plymouth's Text fn,
// so we use a wider font and accept the small visual delta vs. CSS.
wordmark.image = Image.Text("M A R A T H O N", 1.0, 1.0, 1.0, 1.0, "Sans 14");
wordmark.sprite = Sprite(wordmark.image);
wordmark.sprite.SetX(screen_width / 2 - wordmark.image.GetWidth() / 2);
wordmark.sprite.SetY(screen_height / 2 + logo_h / 2 - 24);
wordmark.sprite.SetZ(10);

// ── Progress bar (140x2, teal-on-translucent-white) ───────────────────
// Bottom: 110px in the JSX → from-bottom 110.
PROGRESS_BAR_WIDTH  = 140;
PROGRESS_BAR_HEIGHT = 2;

// Track (the 8% white background pill).
progress_track.image = Image("progress-track.png");
progress_track.sprite = Sprite(progress_track.image);
progress_track.sprite.SetX(screen_width / 2 - progress_track.image.GetWidth() / 2);
progress_track.sprite.SetY(screen_height - 110);
progress_track.sprite.SetZ(10);

// Fill (animated; starts 0-width, grows with plymouth's boot progress).
progress_fill.image = Image("progress-fill.png");
progress_fill.sprite = Sprite(progress_fill.image);
progress_fill.sprite.SetX(screen_width / 2 - progress_track.image.GetWidth() / 2);
progress_fill.sprite.SetY(screen_height - 110);
progress_fill.sprite.SetZ(11);
// Start at 0% by clipping width to 0; updated each callback.
progress_fill.current_width = 0;

// ── Boot progress ─────────────────────────────────────────────────────
// Plymouth's progress (0..1, an estimate from earlier boots) fills the first
// half of the bar. The shell fills the second half: greetd sends the
// "marathon-handover" status as the shell starts, the bar stops at exactly
// half, and the shell's first frame draws this splash at half and carries on.
HANDOVER = 0.5;
handed_over = 0;

fun set_fill(fraction) {
    target_width = Math.Int(PROGRESS_BAR_WIDTH * fraction);
    if (progress_fill.current_width != target_width) {
        progress_fill.current_width = target_width;
        // Plymouth doesn't have an in-place clip; reslice the fill image.
        progress_fill.sliced = progress_fill.image.Scale(target_width, PROGRESS_BAR_HEIGHT);
        progress_fill.sprite.SetImage(progress_fill.sliced);
    }
}

fun progress_callback(duration, progress) {
    if (!handed_over)
        set_fill(Math.Min(progress, 1) * HANDOVER);
}
Plymouth.SetBootProgressFunction(progress_callback);

// ── Charging screen (marathon-charger: a charger turned the phone on) ──
// "marathon-charge-<percent>-<charging|full>" swaps the splash for a
// battery in the progress bar's colours.
BATTERY_W = 96;
BATTERY_H = 168;
CAP_W = 40;
CAP_H = 10;
battery_body.sprite = Sprite();
battery_cap.sprite = Sprite();
battery_fill.sprite = Sprite();
battery_text.sprite = Sprite();
battery_label.sprite = Sprite();

fun show_charge(percent, full) {
    logo.sprite.SetOpacity(0);
    set_boot_chrome_opacity(0);
    message.sprite.SetOpacity(0);
    left = screen_width / 2 - BATTERY_W / 2;
    top = screen_height / 2 - BATTERY_H / 2 - 32;
    battery_body.sprite.SetImage(progress_track.image.Scale(BATTERY_W, BATTERY_H));
    battery_body.sprite.SetPosition(left, top, 10);
    battery_cap.sprite.SetImage(progress_track.image.Scale(CAP_W, CAP_H));
    battery_cap.sprite.SetPosition(screen_width / 2 - CAP_W / 2, top - CAP_H - 4, 10);
    fill_h = Math.Int(BATTERY_H * percent / 100);
    if (fill_h > 0) {
        battery_fill.sprite.SetImage(progress_fill.image.Scale(BATTERY_W, fill_h));
        battery_fill.sprite.SetPosition(left, top + BATTERY_H - fill_h, 11);
        battery_fill.sprite.SetOpacity(1);
    } else {
        battery_fill.sprite.SetOpacity(0);
    }
    battery_text.image = Image.Text(percent + "%", 1.0, 1.0, 1.0, 1.0, "Sans 24");
    battery_text.sprite.SetImage(battery_text.image);
    battery_text.sprite.SetPosition(screen_width / 2 - battery_text.image.GetWidth() / 2, top + BATTERY_H + 24, 10);
    label = "Charging";
    if (full)
        label = "Charged";
    battery_label.image = Image.Text(label, 1.0, 1.0, 1.0, 0.7, "Sans 12");
    battery_label.sprite.SetImage(battery_label.image);
    battery_label.sprite.SetPosition(screen_width / 2 - battery_label.image.GetWidth() / 2,
                                     top + BATTERY_H + 24 + battery_text.image.GetHeight() + 8, 10);
}

fun update_status_callback(status) {
    if (status == "marathon-handover") {
        handed_over = 1;
        set_fill(HANDOVER);
    }
    percent = 0;
    while (percent <= 100) {
        if (status == "marathon-charge-" + percent + "-charging") {
            show_charge(percent, 0);
            percent = 100;
        } else if (status == "marathon-charge-" + percent + "-full") {
            show_charge(percent, 1);
            percent = 100;
        }
        percent = percent + 1;
    }
}
Plymouth.SetUpdateStatusFunction(update_status_callback);

// ── Optional: passive glow pulse on the logo, very subtle, 4-second loop ─
// Plymouth's Window.SetRefreshRate defaults to 50 Hz; we cap with a divisor.
fun refresh_callback() {
    // Render-only callback; keep the splash framerate down to ~10 fps to
    // avoid hogging the CPU during boot. The progress fill is driven by
    // progress_callback, not here.
}
Plymouth.SetRefreshFunction(refresh_callback);

// ── Message above the progress bar ("Finishing update…" after an OS
// update; `plymouth display-message`) ───────────────────────────────────
message.sprite = Sprite();
message.sprite.SetZ(10);

fun display_message_callback(text) {
    message.image = Image.Text(text, 1.0, 1.0, 1.0, 0.7, "Sans 12");
    message.sprite.SetImage(message.image);
    message.sprite.SetX(screen_width / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(screen_height - 110 - 16 - message.image.GetHeight());
    message.sprite.SetOpacity(1);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun hide_message_callback(text) {
    message.sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);

// ── Quit handling — fades out cleanly when boot completes ─────────────
fun quit_callback() {
    logo.sprite.SetOpacity(0);
    wordmark.sprite.SetOpacity(0);
    progress_track.sprite.SetOpacity(0);
    progress_fill.sprite.SetOpacity(0);
    message.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);

// ── PIN prompt for the encrypted data partition (docs/ENCRYPTION.md) ──
// The prompt replaces the wordmark and progress bar; one teal dot per
// character typed.
MAX_DOTS = 24;
dot_image = Image("pin-dot.png");
DOT_PITCH = dot_image.GetWidth() * 2;
prompt.sprite = Sprite();
prompt.sprite.SetZ(10);
prompt.sprite.SetOpacity(0);
i = 0;
while (i < MAX_DOTS) {
    dots[i] = Sprite(dot_image);
    dots[i].SetZ(10);
    dots[i].SetOpacity(0);
    i = i + 1;
}

fun set_boot_chrome_opacity(opacity) {
    wordmark.sprite.SetOpacity(opacity);
    progress_track.sprite.SetOpacity(opacity);
    progress_fill.sprite.SetOpacity(opacity);
}

fun display_password_callback(text, bullets) {
    set_boot_chrome_opacity(0);
    message.sprite.SetOpacity(0);
    prompt.image = Image.Text(text, 1.0, 1.0, 1.0, 1.0, "Sans 14");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(screen_width / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(screen_height / 2 + logo_h / 2 - 24);
    prompt.sprite.SetOpacity(1);
    shown = Math.Min(bullets, MAX_DOTS);
    row_x = Math.Int(screen_width / 2 - (shown * DOT_PITCH - dot_image.GetWidth()) / 2);
    row_y = screen_height / 2 + logo_h / 2 - 24 + prompt.image.GetHeight() + 24;
    i = 0;
    while (i < MAX_DOTS) {
        dots[i].SetX(row_x + i * DOT_PITCH);
        dots[i].SetY(row_y);
        if (i < shown)
            dots[i].SetOpacity(1);
        else
            dots[i].SetOpacity(0);
        i = i + 1;
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    i = 0;
    while (i < MAX_DOTS) {
        dots[i].SetOpacity(0);
        i = i + 1;
    }
    set_boot_chrome_opacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
