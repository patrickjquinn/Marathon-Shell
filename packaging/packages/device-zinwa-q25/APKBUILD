# Q25 deviceinfo, initramfs modules and kernel command line, in place of
# the generic device-mediatek-g99's bring-up console options.
pkgname=device-zinwa-q25
pkgdesc="Zinwa Q25 Pro"
pkgver=1
pkgrel=9
url="https://github.com/patrickjquinn/Marathon-Shell"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-zinwa-q25>=7.0.0-r39
	postmarketos-base
	make-dynpart-mappings
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	q25-carrier.hook
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/q25-carrier.hook" \
		"$pkgdir/usr/share/mkinitfs/hooks-cleanup/50-q25-carrier.sh"
}

