#!/bin/sh
# Keep the splash on screen until the shell shows its own frame, then let
# Plymouth go: the shell marks its first frame (marathon-shell-ready), which
# has replaced Plymouth's on the display by then.
i=0
while [ $i -lt 150 ]; do
	ls /run/user/*/marathon-shell-ready > /dev/null 2>&1 && break
	sleep 0.1
	i=$((i + 1))
done
# Nothing to hand over when Plymouth has already gone.
/usr/bin/plymouth --ping || exit 0
exec /usr/bin/plymouth quit --retain-splash
