#!/bin/sh
# Keep the splash on screen until the shell has the framebuffer open, then
# let Plymouth go: the shell draws into simpledrm's fbdev, which shows once
# Plymouth no longer holds the card.
i=0
while [ $i -lt 150 ]; do
	for fd in /proc/[0-9]*/fd/*; do
		[ "$(readlink "$fd" 2> /dev/null)" = /dev/fb0 ] || continue
		pid=${fd#/proc/}
		pid=${pid%%/*}
		case $(cat "/proc/$pid/comm" 2> /dev/null) in marathon-shell*) exec /usr/bin/plymouth quit ;; esac
	done
	sleep 0.1
	i=$((i + 1))
done
exec /usr/bin/plymouth quit
