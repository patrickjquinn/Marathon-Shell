# JP2601 session, UI profile, boot splash and board policy. The carrier
# runtime (encrypted /home, root growth, over-the-air root install) is
# marathon-carrier's; the kernel and image layout are separate.
pkgname=device-jolla-jp2601-marathon
pkgver=1.0.0
pkgrel=16
pkgdesc="Jolla Phone (2026) Marathon session, UI profile and board policy"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0"
options="!check"
depends="device-jolla-jp2601 marathon-base-config marathon-shell marathon-carrier greetd
 plymouth marathon-plymouth-theme deckard deckard-images mesa-vulkan-panfrost linux-firmware-arm
 jp2601-modem mt6858-platform jp2601-connsys-firmware alsa-ucm-conf"
source="device-profile.conf jp2601-shell-session greetd-jp2601.toml 50-jp2601-session.conf
 jp2601-plymouth.files jp2601-plymouth-newroot.hook
 jp2601-splash-handover jp2601-splash-handover.service jp2601-splash-greetd.conf
 jp2601-splash-plymouth-quit.conf jp2601-splash-plymouth-quit-wait.conf jp2601-splash-plymouth-start.conf
 jp2601.preset unudhcpd-usb0.conf jp2601-usb.nm.conf jp2601-usb-gadget jp2601-usb-gadget.service
 deckard.cfg marathon-deckard.tmpfiles 50-marathon-deckard.rules jp2601-deckard.modules-load.conf
 eglfs-kms.json 60-jp2601-display.rules jp2601-gpu.files jp2601-power.sysctl
 jp2601-mt6369.conf HiFi.conf jp2601-logind.conf jp2601-upower.conf"

package() {
	install -Dm644 "$srcdir/device-profile.conf" "$pkgdir/etc/marathon/device-profile.conf"
	install -Dm755 "$srcdir/jp2601-shell-session" "$pkgdir/usr/libexec/marathon/jp2601-shell-session"
	install -Dm644 "$srcdir/greetd-jp2601.toml" "$pkgdir/etc/greetd/jp2601-config.toml"
	install -Dm644 "$srcdir/50-jp2601-session.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/50-jp2601-session.conf"

	# The GPU session's KMS device, and Panthor's firmware where the
	# built-in driver finds it at boot.
	install -Dm644 "$srcdir/eglfs-kms.json" "$pkgdir/etc/jp2601/eglfs-kms.json"
	install -Dm644 "$srcdir/60-jp2601-display.rules" "$pkgdir/usr/lib/udev/rules.d/60-jp2601-display.rules"
	install -Dm644 "$srcdir/jp2601-gpu.files" "$pkgdir/usr/share/mkinitfs/files/50-jp2601-gpu.files"

	install -Dm644 "$srcdir/jp2601-logind.conf" "$pkgdir/usr/lib/systemd/logind.conf.d/50-jp2601.conf"
	install -Dm644 "$srcdir/jp2601-upower.conf" "$pkgdir/etc/UPower/UPower.conf.d/90-jp2601.conf"

	# The microphones' ALSA use case (capture only until the amplifiers work).
	install -Dm644 "$srcdir/jp2601-mt6369.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/mt6858-mt6369/mt6858-mt6369.conf"
	install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Jolla/JP2601/HiFi.conf"

	# Fewer idle wakeups, as on the Q25.
	install -Dm644 "$srcdir/jp2601-power.sysctl" "$pkgdir/usr/lib/sysctl.d/60-jp2601-power.conf"

	# One Plymouth from the initramfs to the shell. It outlives switch_root,
	# so its font and plugins come from the real root.
	install -Dm644 "$srcdir/jp2601-plymouth.files" "$pkgdir/usr/share/mkinitfs/files/50-jp2601-plymouth.files"
	install -Dm755 "$srcdir/jp2601-plymouth-newroot.hook" "$pkgdir/usr/share/mkinitfs/hooks-cleanup/90-jp2601-plymouth-newroot.sh"
	install -d "$pkgdir/usr/share/fonts"
	ln -s marathon/Sora-Regular.ttf "$pkgdir/usr/share/fonts/Plymouth.ttf"
	install -Dm644 "$srcdir/jp2601-splash-plymouth-start.conf" "$pkgdir/usr/lib/systemd/system/plymouth-start.service.d/60-jp2601-initramfs.conf"
	install -Dm644 "$srcdir/jp2601-splash-greetd.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/60-jp2601-splash.conf"
	install -Dm644 "$srcdir/jp2601-splash-plymouth-quit.conf" "$pkgdir/usr/lib/systemd/system/plymouth-quit.service.d/60-jp2601-splash.conf"
	install -Dm644 "$srcdir/jp2601-splash-plymouth-quit-wait.conf" "$pkgdir/usr/lib/systemd/system/plymouth-quit-wait.service.d/60-jp2601-splash.conf"
	install -Dm644 "$srcdir/jp2601-splash-handover.service" "$pkgdir/usr/lib/systemd/system/jp2601-splash-handover.service"
	install -Dm755 "$srcdir/jp2601-splash-handover" "$pkgdir/usr/libexec/marathon/jp2601-splash-handover"

	# USB networking starts when the gadget's usb0 appears and stops when it
	# goes; the preset keeps it out of multi-user.target, which would
	# otherwise wait for the device at boot. unudhcpd serves usb0, so
	# NetworkManager leaves it alone.
	install -Dm644 "$srcdir/jp2601.preset" "$pkgdir/usr/lib/systemd/system-preset/05-jp2601.preset"
	install -Dm644 "$srcdir/unudhcpd-usb0.conf" "$pkgdir/usr/lib/systemd/system/unudhcpd@usb0.service.d/50-jp2601-usb0.conf"
	install -d "$pkgdir/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants"
	ln -s ../unudhcpd@.service "$pkgdir/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants/unudhcpd@usb0.service"
	install -Dm644 "$srcdir/jp2601-usb.nm.conf" "$pkgdir/usr/lib/NetworkManager/conf.d/90-jp2601-usb.conf"
	# The initramfs makes the USB network gadget only if a UDC exists when it
	# looks; make it here if it did not.
	install -Dm755 "$srcdir/jp2601-usb-gadget" "$pkgdir/usr/libexec/marathon/jp2601-usb-gadget"
	install -Dm644 "$srcdir/jp2601-usb-gadget.service" "$pkgdir/usr/lib/systemd/system/jp2601-usb-gadget.service"
	install -d "$pkgdir/usr/lib/systemd/system/usb-gadget.target.wants"
	ln -s ../jp2601-usb-gadget.service "$pkgdir/usr/lib/systemd/system/usb-gadget.target.wants/jp2601-usb-gadget.service"

	# Deckard: Android's display geometry, its data directory, the user may
	# start it, and the legacy iptables modules its netd cannot load.
	install -Dm644 "$srcdir/deckard.cfg" "$pkgdir/usr/share/marathon/deckard.cfg"
	install -Dm644 "$srcdir/marathon-deckard.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/marathon-deckard.conf"
	install -Dm644 "$srcdir/50-marathon-deckard.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-marathon-deckard.rules"
	install -Dm644 "$srcdir/jp2601-deckard.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/jp2601-deckard.conf"
}

