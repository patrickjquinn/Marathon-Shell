[Unit]
Description=MT6858 CONNSYS: copy the factory Wi-Fi/BT NVRAM from nvdata
ConditionPathExists=!/var/lib/mt6858-connsys/WIFI
Requires=dev-disk-by\x2dpartlabel-nvdata.device
After=dev-disk-by\x2dpartlabel-nvdata.device multi-user.target
Before=mt6858-wifi.service mt6858-bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/marathon/mt6858-connsys-nvram
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
