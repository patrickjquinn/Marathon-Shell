[Unit]
Description=MT6858 Wi-Fi (gen4m over conninfra)
Wants=mt6858-connsys-nvram.service mt6858-bluetooth.service
After=mt6858-connsys-nvram.service mt6858-bluetooth.service systemd-modules-load.service
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/modprobe -a wlan_drv_gen4m_6858 wmt_chrdev_wifi_connac2
ExecStart=/usr/libexec/marathon/mt6858-wifi-on
ExecStop=/bin/sh -c 'echo 0 > /dev/wmtWifi'
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
