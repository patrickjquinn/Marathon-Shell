[Unit]
Description=MT6858 Bluetooth (bt_drv over conninfra) and its factory address
Wants=mt6858-connsys-nvram.service
# bluetoothd takes hci0 once the address configures it.
After=multi-user.target mt6858-connsys-nvram.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/modprobe bt_drv_6858
ExecStart=/usr/libexec/marathon/mt6858-bt-address
TimeoutStartSec=60

[Install]
WantedBy=bluetooth.target multi-user.target
