# Reference: https://postmarketos.org/uipkg
# Marathon Shell UI meta-package for postmarketOS.
#
# Modeled on postmarketos-ui-plasma-mobile (pmaports/main/). Marathon ships
# as a UI variant alongside phosh / plasma-mobile / sxmo. Builds clean as
# either a mutable pmOS image OR a Duranium (immutable) image -- /etc files
# already migrated to /usr/share/factory/ tmpfiles symlinks in marathon-
# shell pkgrel 23.

maintainer="Patrick Quinn <patrick@jquinn.com>"
pkgname=postmarketos-ui-marathon
pkgver=1.0.0
pkgrel=12
pkgdesc="Marathon Shell — Qt 6 Wayland phone shell"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0"

# Pacific is closed; marathon-shipwright-apps brings it in when the image
# has it (packaging/vendor/shipwright.lock). Pilot is part of the UI.
# Everything the shell needs to function as the system UI. Compositor +
# session manager + low-level services that the shell consumes via D-Bus.
depends="
	marathon-shell
	marathon-base-config
	shoal-pilot
	keel-mcp
	greetd
	networkmanager
	modemmanager
	mmsd-tng
	mobile-broadband-provider-info
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
	bluez
	upower
	iio-sensor-proxy
	geoclue
	udisks2
	at-spi2-core
	polkit
	dbus
	xdg-desktop-portal
	xdg-desktop-portal-gtk
	xdg-desktop-portal-wlr
	flatpak
	"

source="
	flathub.flatpakrepo
	marathon-flathub.conf
	marathon-flatpak-overrides
	marathon-flatpak-theming.conf
	marathon-flatpak-theming-user.conf
	marathon-geoclue.conf
	marathon-flatpak-prewarm.service
	marathon-flatpak-prewarm.timer
	"
options="!check pmb:drm pmb:systemd"
install="$pkgname.post-install"

package() {
	# Flathub remote — installed under /etc/flatpak/remotes.d/ so flatpak
	# picks it up automatically on first run. On Duranium this gets
	# tmpfiles-symlinked back to /usr/share/factory/etc/... but for now
	# the standard mutable layout is fine; flatpak's own state lives in
	# /var anyway.
	install -Dm644 "$srcdir/flathub.flatpakrepo" \
		"$pkgdir/etc/flatpak/remotes.d/flathub.flatpakrepo"

	# tmpfiles snippet adds the Flathub remote at first boot via
	# flatpak remote-add. Idempotent.
	install -Dm644 "$srcdir/marathon-flathub.conf" \
		"$pkgdir/usr/lib/tmpfiles.d/marathon-flathub.conf"

	# Global Flatpak override exposing the shell's generated GTK styling
	# and selecting KDE's platform theme, linked in for the system and the
	# per-user installation (docs/NATIVE_APP_THEMING.md).
	install -Dm644 "$srcdir/marathon-flatpak-overrides" \
		"$pkgdir/usr/share/marathon/flatpak-overrides"
	install -Dm644 "$srcdir/marathon-flatpak-theming.conf" \
		"$pkgdir/usr/lib/tmpfiles.d/marathon-flatpak-theming.conf"
	install -Dm644 "$srcdir/marathon-flatpak-theming-user.conf" \
		"$pkgdir/usr/share/user-tmpfiles.d/marathon-flatpak-theming.conf"

	install -Dm644 "$srcdir/marathon-geoclue.conf" \
		"$pkgdir/etc/geoclue/conf.d/90-marathon.conf"

	# Flatpak's helper and portals otherwise all cold-start during the first
	# native app launch. Warm them just after the shell becomes interactive.
	install -Dm644 "$srcdir/marathon-flatpak-prewarm.service" \
		"$pkgdir/usr/lib/systemd/user/marathon-flatpak-prewarm.service"
	install -Dm644 "$srcdir/marathon-flatpak-prewarm.timer" \
		"$pkgdir/usr/lib/systemd/user/marathon-flatpak-prewarm.timer"
	install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -sf ../marathon-flatpak-prewarm.timer \
		"$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/marathon-flatpak-prewarm.timer"
}
sha512sums="
SKIP  flathub.flatpakrepo
SKIP  marathon-flathub.conf
SKIP  marathon-flatpak-overrides
SKIP  marathon-flatpak-theming.conf
SKIP  marathon-flatpak-theming-user.conf
SKIP  marathon-geoclue.conf
SKIP  marathon-flatpak-prewarm.service
SKIP  marathon-flatpak-prewarm.timer
"
