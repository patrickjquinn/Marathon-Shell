# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# Deckard (Android apps as Marathon apps) from Marathon-Deckard:
# deckard-bridge, the host end of the system bridge; deckard-containerd, the
# Rust root container manager that replaces Waydroid's Python one; the Rust
# session, launcher and helpers; and the Android-side files mounted over
# Android's system partition. Those include prebuilt, signed APKs: Alpine has no Android SDK, so they are built on a developer
# host (image/tools/build-apk.sh) and committed to Marathon-Deckard.
# scripts/qemu/lib/build-deckard-apk.sh stages a local checkout.
pkgname=deckard
pkgver=0.1.0
pkgrel=13
_commit=47c97521f84be90dd78c3773cbbc3cb31c70f188
pkgdesc="Android notifications, media and system integration for Marathon"
url="https://github.com/patrickjquinn/Marathon-Deckard"
arch="aarch64 x86_64"
license="Apache-2.0 AND GPL-3.0-only"
# deckard-containerd runs lxc-*, dnsmasq, iptables and modprobe (kmod);
# deckard-boot-evidence runs ss and nsenter.
depends="lxc dnsmasq iptables kmod iproute2-ss util-linux-misc libgcc"
# The overlay carries Android ELF files (the patched composer HAL) that link
# Android's libc++, so the Rust binaries' libgcc_s is listed above instead.
options="!tracedeps net"
makedepends="cargo unzip"
checkdepends="dbus"
# microG's signed releases, unchanged (Marathon-Deckard docs/microg.md).
_microg=v0.3.17.252432
_gms=com.google.android.gms-252432034.apk
_vending=com.android.vending-84022634.apk
source="deckard-$_commit.tar.gz::https://github.com/patrickjquinn/Marathon-Deckard/archive/$_commit.tar.gz
	$_gms::https://github.com/microg/GmsCore/releases/download/$_microg/$_gms
	$_vending::https://github.com/microg/GmsCore/releases/download/$_microg/$_vending
	"
builddir="$srcdir/Marathon-Deckard-$_commit"

prepare() {
	default_prepare
	# The pinned Deckard commit must include the Rust workspace and lockfile.
	[ -f Cargo.toml ] && [ -f Cargo.lock ] &&
		[ -f host/deckard-host-tools/Cargo.toml ] &&
		[ -f host/deckard-fonts-sync/Cargo.toml ] &&
	[ -f host/deckard-overlay-sync/Cargo.toml ] &&
	[ -f host/deckard-runtime/Cargo.toml ] &&
	[ -f host/deckard-launch/Cargo.toml ] &&
	[ -f host/deckard-container/Cargo.toml ] &&
	[ -f host/deckard-host-tools/src/reset.rs ] &&
	[ -f host/deckard-bridge/Cargo.toml ] ||
		die "pin a Deckard commit containing the native host tools"
}

build() {
	export CARGO_TARGET_DIR="$builddir/target"
	export RUSTFLAGS="-C target-feature=-crt-static"
	cargo build --release --locked -p deckard-host-tools \
		-p deckard-fonts-sync -p deckard-overlay-sync \
		-p deckard-runtime -p deckard-launch -p deckard-container \
		-p deckard-bridge
}

check() {
	export CARGO_TARGET_DIR="$builddir/target"
	export RUSTFLAGS="-C target-feature=-crt-static"
	dbus-run-session -- env DECKARD_BRIDGE_PRIVATE_BUS=1 \
		DECKARD_RUNTIME_PRIVATE_BUS=1 DECKARD_IME_PRIVATE_BUS=1 \
		cargo test --locked -p deckard-host-tools -p deckard-fonts-sync \
		-p deckard-overlay-sync -p deckard-runtime -p deckard-launch \
		-p deckard-container -p deckard-bridge -p deckard-core \
		-p deckard-mpris -p deckard-packages
}

package() {
	local p=host/packaging
	install -Dm755 target/release/deckard-bridge "$pkgdir"/usr/libexec/deckard-bridge
	install -Dm644 $p/deckard-bridge.service \
		"$pkgdir"/usr/lib/systemd/user/deckard-bridge.service
	install -d "$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants
	ln -s ../deckard-bridge.service \
		"$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants/deckard-bridge.service
	install -Dm644 $p/deckard-bridge.service.json \
		"$pkgdir"/usr/share/marathon-shell/services/deckard-bridge.service.json
	install -Dm755 target/release/deckard-overlay-sync \
		"$pkgdir"/usr/libexec/deckard-overlay-sync
	install -Dm755 target/release/deckard-open-apk "$pkgdir"/usr/libexec/deckard-open-apk
	install -Dm755 $p/deckard-container-limits "$pkgdir"/usr/libexec/deckard-container-limits
	install -Dm644 $p/org.marathonos.deckard.apk.desktop \
		"$pkgdir"/usr/share/applications/org.marathonos.deckard.apk.desktop
	install -Dm755 target/release/deckard-fonts-sync \
		"$pkgdir"/usr/libexec/deckard-fonts-sync
	install -Dm755 target/release/deckard-reset "$pkgdir"/usr/libexec/deckard-reset
	install -Dm755 target/release/deckard-shared-folders \
		"$pkgdir"/usr/libexec/deckard-shared-folders
	install -Dm755 target/release/deckard-runtime \
		"$pkgdir"/usr/libexec/deckard-runtime
	install -Dm755 target/release/deckard-launch \
		"$pkgdir"/usr/libexec/deckard-launch
	install -d "$pkgdir"/usr/bin
	ln -s ../libexec/deckard-launch "$pkgdir"/usr/bin/deckard-launch
	install -Dm644 $p/deckard-session.service \
		"$pkgdir"/usr/lib/systemd/user/deckard-session.service
	install -Dm755 target/release/deckard-containerd \
		"$pkgdir"/usr/libexec/deckard-containerd
	install -Dm644 $p/deckard-container.service \
		"$pkgdir"/usr/lib/systemd/system/deckard-container.service
	install -Dm644 $p/id.waydro.Container.service \
		"$pkgdir"/usr/share/dbus-1/system-services/id.waydro.Container.service
	install -Dm644 $p/id.waydro.Container.conf \
		"$pkgdir"/usr/share/dbus-1/system.d/id.waydro.Container.conf
	install -Dm644 $p/id.waydro.Container.policy \
		"$pkgdir"/usr/share/polkit-1/actions/id.waydro.Container.policy
	[ ! -f $p/deckard-boot-evidence ] ||
		install -Dm755 $p/deckard-boot-evidence "$pkgdir"/usr/libexec/deckard-boot-evidence
	install -Dm644 $p/org.marathonos.deckard.policy \
		"$pkgdir"/usr/share/polkit-1/actions/org.marathonos.deckard.policy
	for f in fonts.xml fonts_customization.xml host-fonts.txt android-fonts.txt hidden-fonts.txt; do
		install -Dm644 image/vendor_deckard/fonts/$f "$pkgdir"/usr/share/deckard/fonts/$f
	done

	install -d "$pkgdir"/usr/share/deckard
	cp -r image/overlay "$pkgdir"/usr/share/deckard/overlay
	if [ -x image/microg/install.sh ]; then
		case "$CARCH" in
		aarch64) _abi=arm64-v8a ;;
		x86_64) _abi=x86_64 ;;
		esac
		image/microg/install.sh "$srcdir/$_gms" "$srcdir/$_vending" \
			"$pkgdir"/usr/share/deckard/overlay $_abi
	fi
	chmod -R u=rwX,go=rX "$pkgdir"/usr/share/deckard/overlay
	[ ! -f image/whiteouts ] ||
		install -Dm644 image/whiteouts "$pkgdir"/usr/share/deckard/whiteouts
	[ ! -f image/waydroid.prop ] ||
		install -Dm644 image/waydroid.prop "$pkgdir"/usr/share/deckard/waydroid.prop

	install -Dm644 host/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/Apache-2.0
	install -Dm644 image/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/GPL-3.0
}

sha512sums="
SKIP  deckard-$_commit.tar.gz
0b2f77e87aea3f97e0958f8d02b2d0859ad413347181eee3e45949cf1fb23b8eadc3654472ef802030a15707b85245b22af6d74ebb85667a960d707fea223e27  com.google.android.gms-252432034.apk
8a0297a6e2ee648f456480309c41b84ead67ffb2a28ac907e764077012d28f5826a7994f9a39e4202b1b7382030bd7cd45d6368930faa84773f0b4695f9c7af6  com.android.vending-84022634.apk
"
