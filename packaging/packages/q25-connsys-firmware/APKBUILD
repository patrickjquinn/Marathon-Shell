# MediaTek CONNSYS firmware for the Q25 (MT6789 SOC2_1X1, A-die MT6631 "d"
# and MT6635 "e" flavours). These are proprietary and never committed:
# copy them from the phone's own stock /vendor/firmware into this directory
# before building (packaging/packages/q25-connsys-firmware/.gitignore).
pkgname=q25-connsys-firmware
pkgver=20261030
pkgrel=0
pkgdesc="Q25 Wi-Fi/Bluetooth CONNSYS firmware from the stock vendor partition"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="noarch"
license="custom:proprietary"
options="!check !strip !tracedeps"
source="WIFI_RAM_CODE_soc2_2_1d_1.bin WIFI_RAM_CODE_soc2_2_1e_1.bin
 soc2_2_ram_mcu_1d_1_hdr.bin soc2_2_ram_mcu_1e_1_hdr.bin
 soc2_2_ram_wifi_1d_1_hdr.bin soc2_2_ram_wifi_1e_1_hdr.bin
 soc2_2_ram_bt_1d_1_hdr.bin soc2_2_ram_bt_1e_1_hdr.bin WMT_SOC.cfg"
package() {
    local f
    for f in $source; do
        install -Dm644 "$srcdir/$f" "$pkgdir/usr/lib/firmware/$f"
    done
}
