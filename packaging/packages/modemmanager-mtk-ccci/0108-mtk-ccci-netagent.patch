+/* +EIF: <id>, ifup, <type>, <address>: the address as the modem writes it,
+ * "FE:80:...:DA" or "10.1.2.3", in standard notation */
+static gchar *
+ifup_address (GPtrArray *fields)
+{
+    g_auto(GStrv) parts = NULL;
+    const gchar  *str;
+    guint8        bytes[16];
+    gchar         buf[INET6_ADDRSTRLEN];
+    guint         i;
+
+    if (fields->len < 4)
+        return NULL;
+    str = g_ptr_array_index (fields, 3);
+    if (inet_pton (AF_INET, str, bytes) == 1)
+        return g_strdup (str);
+    parts = g_strsplit (str, ":", -1);
+    if (g_strv_length (parts) != 16)
+        return NULL;
+    for (i = 0; i < 16; i++) {
+        gchar  *end = NULL;
+        gulong  v = strtoul (parts[i], &end, 16);
+
+        if (!parts[i][0] || *end || v > 255)
+            return NULL;
+        bytes[i] = (guint8) v;
+    }
+    return inet_ntop (AF_INET6, bytes, buf, sizeof (buf)) ? g_strdup (buf) : NULL;
+}
+
+/* This PDN's interface is the one reported with its address; any other
+ * +EIF: ifup in the activation's reply goes to the modem's NetAgent */
+static void
+choose_ifup (MMBroadbandBearerMtkCcci *self,
+             ConnectContext           *ctx)
+{
+    const gchar *v4 = ctx->ipv4_config ? mm_bearer_ip_config_get_address (ctx->ipv4_config) : NULL;
+    const gchar *v6 = ctx->ipv6_config ? mm_bearer_ip_config_get_address (ctx->ipv6_config) : NULL;
+    guint        own = 0;
+    guint        i;
+
+    for (i = 0; i < ctx->ifups->len; i++) {
+        g_autofree gchar *address = ifup_address (g_ptr_array_index (ctx->ifups, i));
+
+        if (address && (!g_strcmp0 (address, v4) || !g_strcmp0 (address, v6))) {
+            own = i;
+            break;
+        }
+    }
+    if (i == ctx->ifups->len && ctx->ifups->len > 1)
+        mm_obj_warn (self, "no interface reported with PDN aid %u's address, taking the first", ctx->aid);
+
+    for (i = 0; i < ctx->ifups->len; i++) {
+        GPtrArray *fields = g_ptr_array_index (ctx->ifups, i);
+        guint      id = 0;
+        guint      type = 3;
+
+        mm_get_uint_from_str (g_ptr_array_index (fields, 0), &id);
+        if (fields->len >= 3)
+            mm_get_uint_from_str (g_ptr_array_index (fields, 2), &type);
+        if (i == own) {
+            ctx->eif_id = id;
+            ctx->eif_type = type;
+            ctx->ifid = id % 100;
+        } else {
+            mm_broadband_modem_mtk_ccci_netagent_ifup (MM_BROADBAND_MODEM_MTK_CCCI (ctx->modem), id, type,
+                                                       fields->len >= 4 ? g_ptr_array_index (fields, 3) : NULL);
+        }
+    }
+}
