@@ -79,6 +105,224 @@ eif_ifdown_received (MMPortSerialAt          *port,
                                 GINT_TO_POINTER ((gint) (id % 100)));
 }
 
+/*****************************************************************************/
+/* NetAgent
+ *
+ * The modem brings some PDNs up by itself, the IMS one among them, and
+ * reports each with +EIF: <id>, ifup, <type>, <address>, where <address> is
+ * the IPv4 address or the IPv6 link-local one with the network's interface
+ * identifier. The stock NetAgent then configures the interface, confirms it
+ * (AT+EIF=<id>, "ifst", "up", <type>) and reports the global IPv6 address
+ * SLAAC gives it (AT+EIF=<id>, "ipupdate", 2, "<address>/<prefix>"); for
+ * IMS the modem's IMS manager then asks the host to confirm the bearer
+ * (+EIMSPDN: "notify", <aid>, <action>, ...), which the stock RIL does when
+ * nothing above it listens (AT+EIMSPDN= "confirm", <aid>, 0). Data PDNs
+ * come up inside their bearer's +EAPNACT and stay with the bearer. */
+
+/* "FE:80:...:DA" (16 hex bytes) or "10.1.2.3" */
+static gboolean
+parse_eif_address (const gchar     *str,
+                   gint            *family,
+                   struct in6_addr *ipv6,
+                   struct in_addr  *ipv4)
+{
+    g_auto(GStrv) parts = NULL;
+    guint         i;
+
+    if (inet_pton (AF_INET, str, ipv4) == 1) {
+        *family = AF_INET;
+        return TRUE;
+    }
+    parts = g_strsplit (str, ":", -1);
+    if (g_strv_length (parts) != 16)
+        return FALSE;
+    for (i = 0; i < 16; i++) {
+        gchar *end = NULL;
+        gulong v = strtoul (parts[i], &end, 16);
+
+        if (!parts[i][0] || *end || v > 255)
+            return FALSE;
+        ipv6->s6_addr[i] = (guint8) v;
+    }
+    *family = AF_INET6;
+    return TRUE;
+}
+
+static void
+netagent_pdn_down (MMBroadbandModemMtkCcci *self,
+                   guint                    id)
+{
+    NetagentPdn *pdn;
+
+    pdn = self->priv->pdns ? g_hash_table_lookup (self->priv->pdns, GUINT_TO_POINTER (id)) : NULL;
+    if (!pdn)
+        return;
+    mm_obj_msg (self, "PDN interface %u (%s) down", id, pdn->ifname);
+    mm_netagent_mtk_ccci_down (self->priv->netagent, pdn->ifname);
+    g_hash_table_remove (self->priv->pdns, GUINT_TO_POINTER (id));
+}
+
+static void
+netagent_ipupdate (MMBroadbandModemMtkCcci *self,
+                   NetagentPdn             *pdn,
+                   const struct in6_addr   *address,
+                   guint                    prefix)
+{
+    g_autoptr(GString) hex = g_string_new (NULL);
+    g_autofree gchar  *command = NULL;
+    guint              i;
+
+    for (i = 0; i < 16; i++)
+        g_string_append_printf (hex, i ? ":%02X" : "%02X", address->s6_addr[i]);
+    command = g_strdup_printf ("+EIF=%u, \"ipupdate\", 2, \"%s/%u\"", pdn->id, hex->str, prefix);
+    mm_obj_msg (self, "PDN interface %u (%s) has its global IPv6 address", pdn->id, pdn->ifname);
+    pdn->ip_updated = TRUE;
+    mm_base_modem_at_command (MM_BASE_MODEM (self), command, 10, FALSE, NULL, NULL);
+}
+
+static void
+netagent_address (guint                  ifindex,
+                  const struct in6_addr *address,
+                  guint                  prefix,
+                  gpointer               user_data)
+{
+    MMBroadbandModemMtkCcci *self = user_data;
+    GHashTableIter           iter;
+    NetagentPdn             *pdn;
+
+    g_hash_table_iter_init (&iter, self->priv->pdns);
+    while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &pdn)) {
+        /* The network's prefix with the modem's interface identifier */
+        if (pdn->ifindex == ifindex && pdn->has_link_local && !pdn->ip_updated &&
+            !memcmp (&address->s6_addr[8], &pdn->link_local.s6_addr[8], 8))
+            netagent_ipupdate (self, pdn, address, prefix);
+    }
+}
+
+void
+mm_broadband_modem_mtk_ccci_netagent_ifup (MMBroadbandModemMtkCcci *self,
+                                           guint                    id,
+                                           guint                    type,
+                                           const gchar             *address)
+{
+    g_autoptr(GError)  error = NULL;
+    g_autofree gchar  *command = NULL;
+    NetagentPdn       *pdn;
+    struct in_addr     ipv4;
+    gint               family = 0;
+
+    if (!self->priv->netagent) {
+        self->priv->netagent = mm_netagent_mtk_ccci_new (netagent_address, self, &error);
+        if (!self->priv->netagent) {
+            mm_obj_warn (self, "can't bring PDN interfaces up: %s", error->message);
+            return;
+        }
+    }
+
+    netagent_pdn_down (self, id);
+    pdn = g_new0 (NetagentPdn, 1);
+    pdn->id = id;
+    pdn->type = type;
+    g_snprintf (pdn->ifname, sizeof (pdn->ifname), "ccmni%u", id % 100);
+    if (address && !parse_eif_address (address, &family, &pdn->link_local, &ipv4))
+        mm_obj_warn (self, "PDN interface %u: unexpected address '%s'", id, address);
+    pdn->has_link_local = (family == AF_INET6);
+
+    pdn->ifindex = mm_netagent_mtk_ccci_up (self->priv->netagent, pdn->ifname,
+                                            pdn->has_link_local ? &pdn->link_local : NULL, &error);
+    if (pdn->ifindex && family == AF_INET &&
+        !mm_netagent_mtk_ccci_add_ipv4 (self->priv->netagent, pdn->ifname, &ipv4, &error))
+        pdn->ifindex = 0;
+    if (!pdn->ifindex) {
+        mm_obj_warn (self, "couldn't bring PDN interface %u (%s) up: %s", id, pdn->ifname, error->message);
+        g_free (pdn);
+        return;
+    }
+    g_hash_table_insert (self->priv->pdns, GUINT_TO_POINTER (id), pdn);
+    mm_obj_msg (self, "PDN interface %u up on %s", id, pdn->ifname);
+    command = g_strdup_printf ("+EIF=%u, \"ifst\", \"up\", %u", id, type);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), command, 10, FALSE, NULL, NULL);
+}
+
+static void
+eif_ifup_received (MMPortSerialAt          *port,
+                   GMatchInfo              *match_info,
+                   MMBroadbandModemMtkCcci *self)
+{
+    g_autofree gchar *address = NULL;
+    guint             id;
+    guint             type;
+
+    if (!mm_get_uint_from_match_info (match_info, 1, &id) ||
+        !mm_get_uint_from_match_info (match_info, 2, &type))
+        return;
+    address = g_match_info_fetch (match_info, 3);
+    mm_broadband_modem_mtk_ccci_netagent_ifup (self, id, type, address);
+}
+
+/* An address the PDN gained later, e.g. its IPv4 one */
+static void
+eif_ifchg_received (MMPortSerialAt          *port,
+                    GMatchInfo              *match_info,
+                    MMBroadbandModemMtkCcci *self)
+{
+    g_autoptr(GError)  error = NULL;
+    g_autofree gchar  *address = NULL;
+    NetagentPdn       *pdn;
+    struct in6_addr    ipv6;
+    struct in_addr     ipv4;
+    gint               family = 0;
+    guint              id;
+
+    if (!mm_get_uint_from_match_info (match_info, 1, &id))
+        return;
+    pdn = g_hash_table_lookup (self->priv->pdns, GUINT_TO_POINTER (id));
+    address = g_match_info_fetch (match_info, 2);
+    if (!pdn || !address || !parse_eif_address (address, &family, &ipv6, &ipv4) || family != AF_INET)
+        return;
+    if (!mm_netagent_mtk_ccci_add_ipv4 (self->priv->netagent, pdn->ifname, &ipv4, &error))
+        mm_obj_warn (self, "couldn't add IPv4 address to %s: %s", pdn->ifname, error->message);
+}
+
+static void
+eimspdn_received (MMPortSerialAt          *port,
+                  GMatchInfo              *match_info,
+                  MMBroadbandModemMtkCcci *self)
+{
+    g_autofree gchar *command = NULL;
+    guint             aid;
+    guint             action;
+
+    if (!mm_get_uint_from_match_info (match_info, 1, &aid) ||
+        !mm_get_uint_from_match_info (match_info, 2, &action))
+        return;
+    mm_obj_msg (self, "confirming IMS bearer %s of PDN aid %u", action ? "activation" : "release", aid);
+    command = g_strdup_printf ("+EIMSPDN= \"confirm\", %u, 0", aid);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), command, 10, FALSE, NULL, NULL);
+}
+
