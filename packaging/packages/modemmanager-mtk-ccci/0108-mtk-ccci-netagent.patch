diff --git a/src/plugins/mtk-ccci/mm-netagent-mtk-ccci.c b/src/plugins/mtk-ccci/mm-netagent-mtk-ccci.c
new file mode 100644
index 0000000..a5a0fdd
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-netagent-mtk-ccci.c
@@ -0,0 +1,303 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Patrick Quinn <patrick.jm.quinn@gmail.com>
+ */
+
+#include <config.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <net/if.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <linux/if_addr.h>
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+
+#include <glib-unix.h>
+#include <gio/gio.h>
+
+#include "mm-netagent-mtk-ccci.h"
+
+struct _MMNetagentMtkCcci {
+    MMNetagentMtkCcciAddressFn  callback;
+    gpointer                    user_data;
+    gint                        monitor_fd;
+    guint                       monitor_id;
+    guint32                     seq;
+};
+
+/*****************************************************************************/
+/* rtnetlink requests */
+
+#define NLMSG_TAIL(nmsg) ((struct rtattr *) (((guint8 *) (nmsg)) + NLMSG_ALIGN ((nmsg)->nlmsg_len)))
+
+typedef struct {
+    struct nlmsghdr hdr;
+    union {
+        struct ifinfomsg ifi;
+        struct ifaddrmsg ifa;
+    };
+    guint8          attrs[64];
+} Request;
+
+static void
+add_attr (struct nlmsghdr *hdr,
+          gushort          type,
+          gconstpointer    data,
+          gsize            len)
+{
+    struct rtattr *rta = NLMSG_TAIL (hdr);
+
+    rta->rta_type = type;
+    rta->rta_len = RTA_LENGTH (len);
+    memcpy (RTA_DATA (rta), data, len);
+    hdr->nlmsg_len = NLMSG_ALIGN (hdr->nlmsg_len) + RTA_ALIGN (rta->rta_len);
+}
+
+/* Send one request and wait for its acknowledgement */
+static gboolean
+rtnl_request (MMNetagentMtkCcci  *self,
+              struct nlmsghdr    *hdr,
+              GError            **error)
+{
+    struct sockaddr_nl  kernel = { .nl_family = AF_NETLINK };
+    guint8              buf[512];
+    gint                fd;
+    gssize              n;
+    gboolean            ok = FALSE;
+
+    fd = socket (AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+    if (fd < 0) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "netlink: %s", g_strerror (errno));
+        return FALSE;
+    }
+    hdr->nlmsg_flags |= NLM_F_REQUEST | NLM_F_ACK;
+    hdr->nlmsg_seq = ++self->seq;
+    if (sendto (fd, hdr, hdr->nlmsg_len, 0, (struct sockaddr *) &kernel, sizeof (kernel)) < 0) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "netlink send: %s", g_strerror (errno));
+        goto out;
+    }
+    while ((n = recv (fd, buf, sizeof (buf), 0)) > 0) {
+        struct nlmsghdr *h;
+
+        for (h = (struct nlmsghdr *) buf; NLMSG_OK (h, (guint) n); h = NLMSG_NEXT (h, n)) {
+            struct nlmsgerr *err;
+
+            if (h->nlmsg_seq != hdr->nlmsg_seq || h->nlmsg_type != NLMSG_ERROR)
+                continue;
+            err = NLMSG_DATA (h);
+            if (err->error && err->error != -EEXIST) {
+                g_set_error (error, G_IO_ERROR, g_io_error_from_errno (-err->error),
+                             "netlink: %s", g_strerror (-err->error));
+                goto out;
+            }
+            ok = TRUE;
+            goto out;
+        }
+    }
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "netlink: no acknowledgement");
+out:
+    close (fd);
+    return ok;
+}
+
+static gboolean
+set_link_up (MMNetagentMtkCcci  *self,
+             guint               ifindex,
+             gboolean            up,
+             GError            **error)
+{
+    Request req = { 0 };
+
+    req.hdr.nlmsg_len = NLMSG_LENGTH (sizeof (struct ifinfomsg));
+    req.hdr.nlmsg_type = RTM_NEWLINK;
+    req.ifi.ifi_family = AF_UNSPEC;
+    req.ifi.ifi_index = (gint) ifindex;
+    req.ifi.ifi_flags = up ? IFF_UP : 0;
+    req.ifi.ifi_change = IFF_UP;
+    return rtnl_request (self, &req.hdr, error);
+}
+
+static gboolean
+add_address (MMNetagentMtkCcci  *self,
+             guint               ifindex,
+             gint                family,
+             gconstpointer       address,
+             guint               prefix,
+             guint8              scope,
+             GError            **error)
+{
+    Request req = { 0 };
+    gsize   len = (family == AF_INET6) ? 16 : 4;
+
+    req.hdr.nlmsg_len = NLMSG_LENGTH (sizeof (struct ifaddrmsg));
+    req.hdr.nlmsg_type = RTM_NEWADDR;
+    req.hdr.nlmsg_flags = NLM_F_CREATE | NLM_F_REPLACE;
+    req.ifa.ifa_family = family;
+    req.ifa.ifa_prefixlen = prefix;
+    req.ifa.ifa_scope = scope;
+    req.ifa.ifa_index = ifindex;
+    /* A raw IP point-to-point link: nothing to detect a duplicate with */
+    req.ifa.ifa_flags = (family == AF_INET6) ? IFA_F_NODAD : 0;
+    add_attr (&req.hdr, IFA_LOCAL, address, len);
+    add_attr (&req.hdr, IFA_ADDRESS, address, len);
+    return rtnl_request (self, &req.hdr, error);
+}
+
+/*****************************************************************************/
+
+static gboolean
+write_sysctl (const gchar  *ifname,
+              const gchar  *key,
+              const gchar  *value,
+              GError      **error)
+{
+    g_autofree gchar *path = NULL;
+
+    path = g_strdup_printf ("/proc/sys/net/ipv6/conf/%s/%s", ifname, key);
+    return g_file_set_contents_full (path, value, -1, G_FILE_SET_CONTENTS_NONE, 0644, error);
+}
+
+guint
+mm_netagent_mtk_ccci_up (MMNetagentMtkCcci      *self,
+                         const gchar            *ifname,
+                         const struct in6_addr  *link_local,
+                         GError                **error)
+{
+    guint ifindex;
+
+    ifindex = if_nametoindex (ifname);
+    if (!ifindex) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "%s: %s", ifname, g_strerror (errno));
+        return 0;
+    }
+    /* Taking IPv6 off and on again drops what an earlier PDN left; the
+     * interface identifier is the modem's, not one the kernel makes up */
+    if (!write_sysctl (ifname, "disable_ipv6", "1", error) ||
+        !write_sysctl (ifname, "addr_gen_mode", "1", error) ||
+        !write_sysctl (ifname, "use_tempaddr", "0", error) ||
+        !write_sysctl (ifname, "accept_ra", "2", error) ||
+        !write_sysctl (ifname, "accept_ra_defrtr", "0", error) ||
+        !write_sysctl (ifname, "disable_ipv6", link_local ? "0" : "1", error) ||
+        !set_link_up (self, ifindex, TRUE, error))
+        return 0;
+    if (link_local &&
+        !add_address (self, ifindex, AF_INET6, link_local, 64, RT_SCOPE_LINK, error))
+        return 0;
+    return ifindex;
+}
+
+gboolean
+mm_netagent_mtk_ccci_add_ipv4 (MMNetagentMtkCcci     *self,
+                               const gchar           *ifname,
+                               const struct in_addr  *address,
+                               GError               **error)
+{
+    guint ifindex;
+
+    ifindex = if_nametoindex (ifname);
+    if (!ifindex) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "%s: %s", ifname, g_strerror (errno));
+        return FALSE;
+    }
+    return add_address (self, ifindex, AF_INET, address, 32, RT_SCOPE_UNIVERSE, error);
+}
+
+void
+mm_netagent_mtk_ccci_down (MMNetagentMtkCcci *self,
+                           const gchar       *ifname)
+{
+    guint ifindex;
+
+    ifindex = if_nametoindex (ifname);
+    if (ifindex)
+        set_link_up (self, ifindex, FALSE, NULL);
+}
+
+/*****************************************************************************/
+/* Global IPv6 addresses from router advertisements */
+
+static gboolean
+monitor_readable (gint          fd,
+                  GIOCondition  condition,
+                  gpointer      user_data)
+{
+    MMNetagentMtkCcci *self = user_data;
+    guint8             buf[4096];
+    gssize             n;
+
+    while ((n = recv (fd, buf, sizeof (buf), MSG_DONTWAIT)) > 0) {
+        struct nlmsghdr *h;
+
+        for (h = (struct nlmsghdr *) buf; NLMSG_OK (h, (guint) n); h = NLMSG_NEXT (h, n)) {
+            struct ifaddrmsg      *ifa;
+            struct rtattr         *rta;
+            const struct in6_addr *address = NULL;
+            guint32                flags;
+            gint                   len;
+
+            if (h->nlmsg_type != RTM_NEWADDR)
+                continue;
+            ifa = NLMSG_DATA (h);
+            if (ifa->ifa_family != AF_INET6 || ifa->ifa_scope != RT_SCOPE_UNIVERSE)
+                continue;
+            flags = ifa->ifa_flags;
+            len = IFA_PAYLOAD (h);
+            for (rta = IFA_RTA (ifa); RTA_OK (rta, len); rta = RTA_NEXT (rta, len)) {
+                if (rta->rta_type == IFA_ADDRESS)
+                    address = RTA_DATA (rta);
+                else if (rta->rta_type == IFA_FLAGS)
+                    flags = *(guint32 *) RTA_DATA (rta);
+            }
+            if (address && !(flags & (IFA_F_TENTATIVE | IFA_F_DEPRECATED)))
+                self->callback (ifa->ifa_index, address, ifa->ifa_prefixlen, self->user_data);
+        }
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+MMNetagentMtkCcci *
+mm_netagent_mtk_ccci_new (MMNetagentMtkCcciAddressFn   callback,
+                          gpointer                     user_data,
+                          GError                     **error)
+{
+    MMNetagentMtkCcci  *self;
+    struct sockaddr_nl  local = { .nl_family = AF_NETLINK, .nl_groups = RTMGRP_IPV6_IFADDR };
+
+    self = g_new0 (MMNetagentMtkCcci, 1);
+    self->callback = callback;
+    self->user_data = user_data;
+    self->monitor_fd = socket (AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC | SOCK_NONBLOCK, NETLINK_ROUTE);
+    if (self->monitor_fd < 0 || bind (self->monitor_fd, (struct sockaddr *) &local, sizeof (local)) < 0) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                     "netlink address monitor: %s", g_strerror (errno));
+        mm_netagent_mtk_ccci_free (self);
+        return NULL;
+    }
+    self->monitor_id = g_unix_fd_add (self->monitor_fd, G_IO_IN, monitor_readable, self);
+    return self;
+}
+
+void
+mm_netagent_mtk_ccci_free (MMNetagentMtkCcci *self)
+{
+    if (!self)
+        return;
+    if (self->monitor_id)
+        g_source_remove (self->monitor_id);
+    if (self->monitor_fd >= 0)
+        close (self->monitor_fd);
+    g_free (self);
+}
