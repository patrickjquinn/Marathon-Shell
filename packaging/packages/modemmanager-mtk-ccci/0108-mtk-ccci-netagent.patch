+
+#include <glib.h>
+#include <netinet/in.h>
+
+/* The host side of a PDN interface the modem brings up by itself (IMS):
+ * what the stock NetAgent and netd do for it, without AT commands. */
+
+typedef struct _MMNetagentMtkCcci MMNetagentMtkCcci;
+
+/* A global IPv6 address appeared on a watched interface */
+typedef void (*MMNetagentMtkCcciAddressFn) (guint                   ifindex,
+                                           const struct in6_addr  *address,
+                                           guint                   prefix,
+                                           gpointer                user_data);
+
+MMNetagentMtkCcci *mm_netagent_mtk_ccci_new      (MMNetagentMtkCcciAddressFn   callback,
+                                                  gpointer                     user_data,
+                                                  GError                     **error);
+void               mm_netagent_mtk_ccci_free     (MMNetagentMtkCcci           *self);
+
+/* Bring an interface up for a PDN: with an IPv6 link-local address (the
+ * modem's interface identifier), router advertisements for its prefix but
+ * not as a default route, no temporary addresses. Returns the ifindex, 0 on
+ * error. */
+guint              mm_netagent_mtk_ccci_up       (MMNetagentMtkCcci           *self,
+                                                  const gchar                 *ifname,
+                                                  const struct in6_addr       *link_local,
+                                                  GError                     **error);
+gboolean           mm_netagent_mtk_ccci_add_ipv4 (MMNetagentMtkCcci           *self,
+                                                  const gchar                 *ifname,
+                                                  const struct in_addr        *address,
+                                                  GError                     **error);
+/* Down takes its addresses with it */
+void               mm_netagent_mtk_ccci_down     (MMNetagentMtkCcci           *self,
+                                                  const gchar                 *ifname);
+
+#endif /* MM_NETAGENT_MTK_CCCI_H */
