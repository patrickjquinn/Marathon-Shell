From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Sun, 15 Nov 2026 12:00:00 +0000
Subject: [PATCH] mtk-ccci: support low power with +CFUN=4

The plugin had no power-down, so SetPowerState(LOW) failed as
unsupported and a disabled modem kept its radio on: in airplane mode
it stayed registered, and its unsolicited messages filled the AT
port's queue with nothing reading it. Power down with +CFUN=4, which
turns the radio off and leaves the SIM powered, so the generic
power-up's +CFUN=1 on enable needs no SIM bring-up again.
---
diff --git a/src/plugins/mtk-ccci/mm-broadband-modem-mtk-ccci.c b/src/plugins/mtk-ccci/mm-broadband-modem-mtk-ccci.c
--- a/src/plugins/mtk-ccci/mm-broadband-modem-mtk-ccci.c
+++ b/src/plugins/mtk-ccci/mm-broadband-modem-mtk-ccci.c
@@ -192,6 +192,33 @@
 }
 
 /*****************************************************************************/
+/* Powering down the modem (Modem interface)
+ *
+ * Low power is the radio off with the SIM left powered (+CFUN=4), as for
+ * airplane mode; the generic power-up's +CFUN=1 turns it back on. */
+
+static gboolean
+modem_power_down_finish (MMIfaceModem  *self,
+                         GAsyncResult  *res,
+                         GError       **error)
+{
+    return !!mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+}
+
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+CFUN=4",
+                              30,
+                              FALSE,
+                              callback,
+                              user_data);
+}
+
+/*****************************************************************************/
 
 MMBroadbandModemMtkCcci *
 mm_broadband_modem_mtk_ccci_new (const gchar  *device,
@@ -246,6 +273,8 @@
 {
     iface->create_bearer = modem_create_bearer;
     iface->create_bearer_finish = modem_create_bearer_finish;
+    iface->modem_power_down = modem_power_down;
+    iface->modem_power_down_finish = modem_power_down_finish;
 }
 
 static void
