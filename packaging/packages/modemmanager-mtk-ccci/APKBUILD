# ModemManager with MediaTek CCCI support, for the Zinwa Q25 only: Alpine's
# community/modemmanager at the same snapshot plus the Moto G06 (lagos)
# postmarketOS port's 0100 (ccci_node AT ports) and 0101 (mtk-ccci plugin).
# It provides modemmanager, so installing it (q25-modem depends on it)
# replaces Alpine's daemon; nothing else pulls it in. libmm-glib stays
# Alpine's. Keep pkgver and _commit in sync with Alpine's modemmanager.
pkgname=modemmanager-mtk-ccci
pkgver=1.25.95_git20261005
pkgrel=0
_commit=7f0bf17ab518cd78925cf7e53cc0d5c42f88b41a
pkgdesc="ModemManager with MediaTek CCCI (SoC modem) support"
url="https://www.freedesktop.org/wiki/Software/ModemManager"
arch="aarch64"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
depends="dbus libmm-glib mobile-broadband-provider-info polkit"
makedepends="
	dbus-dev
	elogind-dev
	glib-dev
	libgudev-dev
	libmbim-dev
	libqmi-dev
	linux-headers
	meson
	polkit-dev
	"
provides="modemmanager=$pkgver-r$pkgrel"
replaces="modemmanager modemmanager-systemd modemmanager-udev"
options="!check"
source="https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$_commit/ModemManager-$_commit.tar.gz
	modemmanager.rules
	0001-intel-XMM7360-fix-big-endian-handling-of-ASN-integer.patch
	0100-support-mediatek-ccci-at-ports.patch
	0101-plugins-new-mtk-ccci-plugin.patch
	"
builddir="$srcdir"/ModemManager-$_commit

build() {
	abuild-meson \
		-Db_lto=true \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Ddbus_policy_dir=/usr/share/dbus-1/system.d \
		-Dgtk_doc=false \
		-Dpolkit=permissive \
		-Dsystemd_journal=false \
		-Dsystemd_suspend_resume=true \
		-Dintrospection=false \
		-Dvapi=false \
		-Dbash_completion=false \
		-Dplugin_mtk_ccci=enabled \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -m644 -D "$srcdir/modemmanager.rules" \
		"$pkgdir/usr/share/polkit-1/rules.d/01-org.freedesktop.ModemManager.rules"
	# Alpine's libmm-glib, -dev, -doc and -lang packages keep providing these.
	rm -rf "$pkgdir"/usr/lib/libmm-glib.so* "$pkgdir"/usr/lib/pkgconfig \
		"$pkgdir"/usr/include "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale \
		"$pkgdir"/usr/share/doc
}
