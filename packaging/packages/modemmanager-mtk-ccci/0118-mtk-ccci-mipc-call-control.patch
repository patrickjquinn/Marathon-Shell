+
+/*****************************************************************************/
+/* Call control over MIPC (Voice interface)
+ *
+ * NR modems hand incoming calls to a MIPC client for approval, as
+ * CALL_APPROVE_INCOMING_CMD, and report call progress as CALL_STATUS_IND,
+ * none of it on the AT port; unapproved, a call rings at the caller and
+ * never reaches the host. Calls are listed over MIPC too, while dialling,
+ * answering and hanging up stay on the AT port. */
+
+/* CALL_APPROVE_INCOMING_CMD and _RSP TLVs */
+#define APPROVE_CMD_CALLID 0x100
+#define APPROVE_CMD_SEQ_NO 0x103
+#define APPROVE_RSP_APPROVE 0x100
+#define APPROVE_RSP_CALLID  0x102
+#define APPROVE_RSP_SEQ_NO  0x103
+
+#define INTERNAL_REGISTER_REQ_MSG_ID 0x100
+
+static void
+mipc_approve_incoming (MMPortMipc              *port,
+                       MipcMessage             *command,
+                       MMBroadbandModemMtkCcci *self)
+{
+    g_autoptr(MipcMessage) response = NULL;
+    g_autoptr(GError)      error = NULL;
+    guint32                id;
+    guint32                seq;
+
+    if (!mipc_message_get_u32 (command, APPROVE_CMD_CALLID, 0, &id) ||
+        !mipc_message_get_u32 (command, APPROVE_CMD_SEQ_NO, 0, &seq)) {
+        mm_obj_warn (self, "incoming call approval without call id or sequence number");
+        return;
+    }
+
+    mm_obj_dbg (self, "allowing incoming call %u (seq %u)", id, seq);
+    response = mipc_message_new_reply (command);
+    mipc_message_add_u8 (response, APPROVE_RSP_APPROVE, TRUE);
+    mipc_message_add_u32 (response, APPROVE_RSP_CALLID, id);
+    mipc_message_add_u32 (response, APPROVE_RSP_SEQ_NO, seq);
+    if (!mm_port_mipc_send (port, response, &error))
+        mm_obj_warn (self, "couldn't allow incoming call %u: %s", id, error->message);
+}
+
+static void
+mipc_call_progress (MMPortMipc              *port,
+                    MipcMessage             *indication,
+                    MMBroadbandModemMtkCcci *self)
+{
+    mm_iface_modem_voice_reload_all_calls (MM_IFACE_MODEM_VOICE (self), NULL, NULL);
+}
+
+/* Closing the session drops the modem's registrations */
+static void
+mipc_teardown (MMBroadbandModemMtkCcci *self)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (self->priv->mipc_handlers); i++) {
+        if (self->priv->mipc_handlers[i])
+            mm_port_mipc_remove_handler (self->priv->mipc, self->priv->mipc_handlers[i]);
+        self->priv->mipc_handlers[i] = 0;
+    }
+    mm_port_mipc_close (self->priv->mipc);
+}
+
+typedef enum {
+    MIPC_SETUP_STEP_PARENT,
+    MIPC_SETUP_STEP_OPEN,
+    MIPC_SETUP_STEP_REGISTER_APPROVE,
+    MIPC_SETUP_STEP_REGISTER_STATUS,
+    MIPC_SETUP_STEP_REGISTER_EVENT,
+    MIPC_SETUP_STEP_LAST,
+} MipcSetupStep;
+
+static void mipc_setup_step (GTask *task);
+
+static gboolean
+modem_voice_setup_unsolicited_events_finish (MMIfaceModemVoice  *self,
+                                             GAsyncResult       *res,
+                                             GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+mipc_setup_failed (GTask  *task,
+                   GError *error)
+{
+    MMBroadbandModemMtkCcci *self = g_task_get_source_object (task);
+
+    /* Calls stay with the AT port */
+    mm_obj_warn (self, "couldn't set up call control over MIPC: %s", error->message);
+    g_error_free (error);
+    mipc_teardown (self);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+mipc_register_ready (MMPortMipc   *port,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    g_autoptr(MipcMessage)  confirmation = NULL;
+    GError                 *error = NULL;
+    MipcSetupStep          *step;
+
+    confirmation = mm_port_mipc_request_finish (port, res, &error);
+    if (!confirmation) {
+        mipc_setup_failed (task, error);
+        return;
+    }
+    step = g_task_get_task_data (task);
+    (*step)++;
+    mipc_setup_step (task);
+}
+
+static void
+mipc_open_ready (MMPortMipc   *port,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    GError        *error = NULL;
+    MipcSetupStep *step;
+
+    if (!mm_port_mipc_open_finish (port, res, &error)) {
+        mipc_setup_failed (task, error);
+        return;
+    }
+    step = g_task_get_task_data (task);
+    (*step)++;
+    mipc_setup_step (task);
+}
+
+static void
+parent_voice_setup_unsolicited_events_ready (MMIfaceModemVoice *self,
+                                             GAsyncResult      *res,
+                                             GTask             *task)
+{
+    GError        *error = NULL;
+    MipcSetupStep *step;
+
+    if (!iface_modem_voice_parent->setup_unsolicited_events_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    step = g_task_get_task_data (task);
+    (*step)++;
+    mipc_setup_step (task);
+}
+
+static void
+mipc_register (GTask   *task,
+               guint16  request_id,
+               guint8   sim_ps,
+               guint16  message_id)
+{
+    MMBroadbandModemMtkCcci *self = g_task_get_source_object (task);
+    g_autoptr(MipcMessage)   request = NULL;
+
+    request = mipc_message_new (request_id, sim_ps);
+    mipc_message_add_u16 (request, INTERNAL_REGISTER_REQ_MSG_ID, message_id);
+    mm_port_mipc_request (self->priv->mipc, request, 5,
+                          (GAsyncReadyCallback) mipc_register_ready, task);
+}
+
+static void
+mipc_setup_step (GTask *task)
+{
+    MMBroadbandModemMtkCcci *self = g_task_get_source_object (task);
+    MipcSetupStep           *step = g_task_get_task_data (task);
+
+    switch (*step) {
+    case MIPC_SETUP_STEP_PARENT:
+        iface_modem_voice_parent->setup_unsolicited_events (
+            MM_IFACE_MODEM_VOICE (self),
+            (GAsyncReadyCallback) parent_voice_setup_unsolicited_events_ready,
+            task);
+        return;
+    case MIPC_SETUP_STEP_OPEN:
+        if (!self->priv->mipc) {
+            g_task_return_boolean (task, TRUE);
+            g_object_unref (task);
+            return;
+        }
+        mm_port_mipc_open (self->priv->mipc, (GAsyncReadyCallback) mipc_open_ready, task);
+        return;
+    case MIPC_SETUP_STEP_REGISTER_APPROVE:
+        self->priv->mipc_handlers[0] =
+            mm_port_mipc_add_handler (self->priv->mipc, MIPC_MESSAGE_CALL_APPROVE_INCOMING_CMD,
+                                      (MMPortMipcMessageFn) mipc_approve_incoming, self);
+        mipc_register (task, MIPC_MESSAGE_INTERNAL_REGISTER_CMD_REQ, MIPC_SIM_PS_ALL,
+                       MIPC_MESSAGE_CALL_APPROVE_INCOMING_CMD);
+        return;
+    case MIPC_SETUP_STEP_REGISTER_STATUS:
+        self->priv->mipc_handlers[1] =
+            mm_port_mipc_add_handler (self->priv->mipc, MIPC_MESSAGE_CALL_STATUS_IND,
+                                      (MMPortMipcMessageFn) mipc_call_progress, self);
+        mipc_register (task, MIPC_MESSAGE_INTERNAL_REGISTER_IND_REQ, MIPC_SIM_PS_SIM0,
+                       MIPC_MESSAGE_CALL_STATUS_IND);
+        return;
+    case MIPC_SETUP_STEP_REGISTER_EVENT:
+        self->priv->mipc_handlers[2] =
+            mm_port_mipc_add_handler (self->priv->mipc, MIPC_MESSAGE_CALL_EVENT_IND,
+                                      (MMPortMipcMessageFn) mipc_call_progress, self);
+        mipc_register (task, MIPC_MESSAGE_INTERNAL_REGISTER_IND_REQ, MIPC_SIM_PS_SIM0,
+                       MIPC_MESSAGE_CALL_EVENT_IND);
+        return;
+    case MIPC_SETUP_STEP_LAST:
+        /* Every change of a call is indicated: no polling, and the AT
+         * port's call reports only trigger a reload */
+        g_object_set (self,
+                      MM_IFACE_MODEM_VOICE_PERIODIC_CALL_LIST_CHECK_DISABLED,   TRUE,
+                      MM_IFACE_MODEM_VOICE_INDICATION_CALL_LIST_RELOAD_ENABLED, TRUE,
+                      NULL);
+        mm_obj_msg (self, "call control over MIPC port %s", mm_port_get_device (MM_PORT (self->priv->mipc)));
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+static void
+modem_voice_setup_unsolicited_events (MMIfaceModemVoice   *self,
+                                      GAsyncReadyCallback  callback,
+                                      gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, g_new0 (MipcSetupStep, 1), g_free);
+    mipc_setup_step (task);
+}
+
+static gboolean
+modem_voice_cleanup_unsolicited_events_finish (MMIfaceModemVoice  *self,
+                                               GAsyncResult       *res,
+                                               GError            **error)
+{
+    return iface_modem_voice_parent->cleanup_unsolicited_events_finish (self, res, error);
+}
+
+static void
+modem_voice_cleanup_unsolicited_events (MMIfaceModemVoice   *_self,
+                                        GAsyncReadyCallback  callback,
+                                        gpointer             user_data)
+{
+    MMBroadbandModemMtkCcci *self = MM_BROADBAND_MODEM_MTK_CCCI (_self);
+
+    if (self->priv->mipc)
+        mipc_teardown (self);
+
+    iface_modem_voice_parent->cleanup_unsolicited_events (_self, callback, user_data);
 }
 
 static void
 iface_modem_voice_init (MMIfaceModemVoiceInterface *iface)
 {
+    iface_modem_voice_parent = g_type_interface_peek_parent (iface);
+
     /* +CLCC: <id>,<dir>,<stat>,20, */
     if (!ims_voice_mode_regex)
         ims_voice_mode_regex = g_regex_new ("(\\+CLCC:\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+)\\s*,\\s*20\\s*,",
                                             G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
     iface->load_call_list = load_call_list;
     iface->load_call_list_finish = load_call_list_finish;
+    iface->setup_unsolicited_events = modem_voice_setup_unsolicited_events;
+    iface->setup_unsolicited_events_finish = modem_voice_setup_unsolicited_events_finish;
+    iface->cleanup_unsolicited_events = modem_voice_cleanup_unsolicited_events;
+    iface->cleanup_unsolicited_events_finish = modem_voice_cleanup_unsolicited_events_finish;
 }
 
 /*****************************************************************************/
@@ -771,6 +1123,16 @@ mm_broadband_modem_mtk_ccci_init (MMBroadbandModemMtkCcci *self)
     self->priv->pdns = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL, g_free);
 }
 
+static void
+dispose (GObject *object)
+{
+    MMBroadbandModemMtkCcci *self = MM_BROADBAND_MODEM_MTK_CCCI (object);
+
+    g_clear_object (&self->priv->mipc);
+
+    G_OBJECT_CLASS (mm_broadband_modem_mtk_ccci_parent_class)->dispose (object);
+}
+
 static void
 finalize (GObject *object)
 {
@@ -848,6 +1210,7 @@ mm_broadband_modem_mtk_ccci_class_init (MMBroadbandModemMtkCcciClass *klass)
 
     g_type_class_add_private (object_class, sizeof (MMBroadbandModemMtkCcciPrivate));
 
+    object_class->dispose = dispose;
     object_class->finalize = finalize;
     broadband_modem_class->setup_ports = setup_ports;
     broadband_modem_class->enabling_started = enabling_started;
