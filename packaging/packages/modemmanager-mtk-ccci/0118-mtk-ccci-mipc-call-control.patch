+/* CALL_GET_CALL_STATUS_CNF TLVs, one array element per call */
+#define CALL_STATUS_CNF_CALLID     0x10b
+#define CALL_STATUS_CNF_DIRECTION  0x10c
+#define CALL_STATUS_CNF_CLCC_STATE 0x10e
+#define CALL_STATUS_CNF_NUMBER     0x8111
+
+static void
+mipc_call_status_ready (MMPortMipc   *port,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    g_autoptr(MipcMessage)  confirmation = NULL;
+    GList                  *list = NULL;
+    GError                 *error = NULL;
+    guint                   n;
+    guint                   i;
+
+    confirmation = mm_port_mipc_request_finish (port, res, &error);
+    if (!confirmation) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    n = mipc_message_get_count (confirmation, CALL_STATUS_CNF_CALLID);
+    for (i = 0; i < n; i++) {
+        MMCallInfo *info;
+        guint32     id;
+        guint32     direction;
+        guint32     state;
+
+        if (!mipc_message_get_u32 (confirmation, CALL_STATUS_CNF_CALLID, i, &id) ||
+            !mipc_message_get_u32 (confirmation, CALL_STATUS_CNF_DIRECTION, i, &direction) ||
+            !mipc_message_get_u32 (confirmation, CALL_STATUS_CNF_CLCC_STATE, i, &state)) {
+            mm_obj_warn (g_task_get_source_object (task), "incomplete status of call %u", i);
+            continue;
+        }
+
+        info = g_new0 (MMCallInfo, 1);
+        info->index = id;
+        info->direction = direction ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+        /* The +CLCC states */
+        switch (state) {
+        case 0: info->state = MM_CALL_STATE_ACTIVE; break;
+        case 1: info->state = MM_CALL_STATE_HELD; break;
+        case 2: info->state = MM_CALL_STATE_DIALING; break;
+        case 3: info->state = MM_CALL_STATE_RINGING_OUT; break;
+        case 4: info->state = MM_CALL_STATE_RINGING_IN; break;
+        case 5: info->state = MM_CALL_STATE_WAITING; break;
+        default:
+            mm_obj_warn (g_task_get_source_object (task), "unknown state %u of call %u", state, id);
+            g_free (info);
+            continue;
+        }
+        info->number = mipc_message_dup_string (confirmation, CALL_STATUS_CNF_NUMBER, i);
+        list = g_list_append (list, info);
+    }
+
+    g_task_return_pointer (task, list, (GDestroyNotify) mm_3gpp_call_info_list_free);
+    g_object_unref (task);
+}
+
 static void
