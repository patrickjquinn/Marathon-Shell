index 0000000..c19065d
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-port-mipc.c
@@ -0,0 +1,541 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Patrick Quinn <patrick.jm.quinn@gmail.com>
+ */
+
+#include <config.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <glib-unix.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-port-mipc.h"
+
+#define OPEN_REQUEST_TIMEOUT 5
+#define READ_SIZE            4096
+
+/* INTERNAL_OPEN_REQ TLVs */
+#define OPEN_REQ_VERSION      0x100
+#define OPEN_REQ_CLIENT_NAME  0x101
+#define OPEN_REQ_USIR_SUPPORT 0x102
+
+struct _MMPortMipc {
+    MMPort      parent;
+    gint        fd;
+    guint       watch_id;
+    gboolean    session;
+    GByteArray *buffer;
+    guint16     next_txid;
+    /* Requests waiting for their confirmation, by transaction id */
+    GHashTable *pending;
+    GList      *handlers;
+    guint       next_handler_id;
+};
+
+G_DEFINE_TYPE (MMPortMipc, mm_port_mipc, MM_TYPE_PORT)
+
+typedef struct {
+    guint               id;
+    guint16             message_id;
+    MMPortMipcMessageFn callback;
+    gpointer            user_data;
+} Handler;
+
+typedef struct {
+    MMPortMipc *self;
+    guint16     txid;
+    guint16     message_id;
+    guint       timeout_id;
+} Pending;
+
+/*****************************************************************************/
+
+/* Takes the request's task out of the pending table and stops its timeout */
+static GTask *
+pending_steal (MMPortMipc *self,
+               guint16     txid)
+{
+    gpointer  key;
+    gpointer  task;
+    Pending  *pending;
+
+    if (!g_hash_table_steal_extended (self->pending, GUINT_TO_POINTER (txid), &key, &task))
+        return NULL;
+    pending = g_task_get_task_data (task);
+    if (pending->timeout_id) {
+        g_source_remove (pending->timeout_id);
+        pending->timeout_id = 0;
+    }
+    return task;
+}
+
+static void
+complete_all_pending (MMPortMipc  *self,
+                      const gchar *message)
+{
+    g_autoptr(GList) txids = NULL;
+    GList           *l;
+
+    txids = g_hash_table_get_keys (self->pending);
+    for (l = txids; l; l = l->next) {
+        GTask *task;
+
+        task = pending_steal (self, GPOINTER_TO_UINT (l->data));
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_ABORTED, "%s", message);
+        g_object_unref (task);
+    }
+}
+
+/*****************************************************************************/
+
+static void
+dispatch (MMPortMipc  *self,
+          MipcMessage *message)
+{
+    g_autofree gchar *description = NULL;
+    GList            *l;
+
+    description = mipc_message_describe (message);
+    mm_obj_dbg (self, "<-- %s", description);
+
+    if (mipc_message_get_kind (message) == MIPC_MESSAGE_KIND_REQUEST) {
+        GTask   *task;
+        Pending *pending;
+
+        task = pending_steal (self, mipc_message_get_txid (message));
+        if (!task) {
+            mm_obj_dbg (self, "confirmation of no pending request, ignored");
+            return;
+        }
+        pending = g_task_get_task_data (task);
+        if (mipc_message_get_id (message) != MIPC_MESSAGE_REPLY_ID (pending->message_id))
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "unexpected reply 0x%04x to request 0x%04x",
+                                     mipc_message_get_id (message), pending->message_id);
+        else
+            g_task_return_pointer (task, mipc_message_ref (message), (GDestroyNotify) mipc_message_unref);
+        g_object_unref (task);
+        return;
+    }
+
+    for (l = self->handlers; l; l = l->next) {
+        Handler *handler = l->data;
+
+        if (handler->message_id == mipc_message_get_id (message)) {
+            handler->callback (self, message, handler->user_data);
+            return;
+        }
+    }
+}
+
+static void
+process_buffer (MMPortMipc *self)
+{
+    while (self->buffer->len) {
+        g_autoptr(MipcMessage) message = NULL;
+        g_autoptr(GError)      error = NULL;
+        gsize                  consumed;
+
+        message = mipc_message_parse (self->buffer->data, self->buffer->len, &consumed, &error);
+        if (error) {
+            mm_obj_warn (self, "dropping invalid data: %s", error->message);
+            /* The device delivers whole messages; resynchronize on the next read */
+            g_byte_array_set_size (self->buffer, 0);
+            return;
+        }
+        if (!message)
+            return;
+        g_byte_array_remove_range (self->buffer, 0, consumed);
+        /* A handler may close the port */
+        g_object_ref (self);
+        dispatch (self, message);
+        g_object_unref (self);
+        if (self->fd < 0)
+            return;
+    }
+}
+
+static gboolean
+data_available (gint          fd,
+                GIOCondition  condition,
+                MMPortMipc   *self)
+{
+    guint8  buf[READ_SIZE];
+    gssize  n;
+
+    n = (condition & (G_IO_HUP | G_IO_ERR)) ? 0 : read (fd, buf, sizeof (buf));
+    if (n < 0) {
+        if (errno != EAGAIN && errno != EINTR)
+            mm_obj_warn (self, "read failed: %s", g_strerror (errno));
+        return G_SOURCE_CONTINUE;
+    }
+    if (n == 0) {
+        mm_obj_warn (self, "port hung up");
+        self->watch_id = 0;
+        mm_port_mipc_close (self);
+        return G_SOURCE_REMOVE;
+    }
+    g_byte_array_append (self->buffer, buf, n);
+    process_buffer (self);
+    return G_SOURCE_CONTINUE;
+}
+
+/*****************************************************************************/
+
+static gboolean
+write_message (MMPortMipc   *self,
+               MipcMessage  *message,
+               GError      **error)
+{
+    g_autofree gchar *description = NULL;
+    const guint8     *raw;
+    gsize             len;
+    gssize            n;
+
+    if (self->fd < 0) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE, "port is closed");
+        return FALSE;
+    }
+
+    description = mipc_message_describe (message);
+    mm_obj_dbg (self, "--> %s", description);
+
+    /* The device takes one message per write */
+    raw = mipc_message_get_raw (message, &len);
+    n = write (self->fd, raw, len);
+    if (n < 0) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                     "write failed: %s", g_strerror (errno));
+        return FALSE;
+    }
+    if ((gsize) n != len) {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                     "short write: %" G_GSSIZE_FORMAT " of %" G_GSIZE_FORMAT " bytes", n, len);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+gboolean
+mm_port_mipc_send (MMPortMipc   *self,
+                   MipcMessage  *message,
+                   GError      **error)
+{
+    return write_message (self, message, error);
+}
+
+static gboolean
+request_timed_out (GTask *task)
+{
+    Pending *pending = g_task_get_task_data (task);
+
+    pending->timeout_id = 0;
+    task = pending_steal (pending->self, pending->txid);
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_TIMEOUT,
+                             "request 0x%04x timed out", pending->message_id);
+    g_object_unref (task);
+    return G_SOURCE_REMOVE;
+}
+
+void
+mm_port_mipc_request (MMPortMipc          *self,
+                      MipcMessage         *request,
+                      guint                timeout_seconds,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    GTask   *task;
+    Pending *pending;
+    GError  *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    /* 0xffff marks indications */
+    do {
+        self->next_txid = (self->next_txid % 0xfffe) + 1;
+    } while (g_hash_table_contains (self->pending, GUINT_TO_POINTER (self->next_txid)));
+    mipc_message_set_txid (request, self->next_txid);
+
+    if (!write_message (self, request, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    pending = g_new0 (Pending, 1);
+    pending->self = self;
+    pending->txid = self->next_txid;
+    pending->message_id = mipc_message_get_id (request);
+    g_task_set_task_data (task, pending, g_free);
+    g_hash_table_insert (self->pending, GUINT_TO_POINTER (pending->txid), task);
+
+    pending->timeout_id = g_timeout_add_seconds (timeout_seconds, (GSourceFunc) request_timed_out, task);
+}
+
+MipcMessage *
+mm_port_mipc_request_finish (MMPortMipc    *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    g_autoptr(MipcMessage) confirmation = NULL;
+    guint32                result;
+
+    confirmation = g_task_propagate_pointer (G_TASK (res), error);
+    if (!confirmation)
+        return NULL;
+    if (!mipc_message_get_result (confirmation, &result)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "confirmation without a result");
+        return NULL;
+    }
+    if (result) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "request failed with result 0x%x", result);
+        return NULL;
+    }
+    return g_steal_pointer (&confirmation);
+}
+
+/*****************************************************************************/
+
+guint
+mm_port_mipc_add_handler (MMPortMipc          *self,
+                          guint16              message_id,
+                          MMPortMipcMessageFn  callback,
+                          gpointer             user_data)
+{
+    Handler *handler;
+
+    handler = g_new0 (Handler, 1);
+    handler->id = ++self->next_handler_id;
+    handler->message_id = message_id;
+    handler->callback = callback;
+    handler->user_data = user_data;
+    self->handlers = g_list_append (self->handlers, handler);
+    return handler->id;
+}
+
+void
+mm_port_mipc_remove_handler (MMPortMipc *self,
+                             guint       handler_id)
+{
+    GList *l;
+
+    for (l = self->handlers; l; l = l->next) {
+        Handler *handler = l->data;
+
+        if (handler->id == handler_id) {
+            self->handlers = g_list_delete_link (self->handlers, l);
+            g_free (handler);
+            return;
+        }
+    }
+}
+
+/*****************************************************************************/
+/* Session: the modem answers a test request once its MIPC task runs, then
+ * takes the client's open request. */
+
+typedef enum {
+    OPEN_STEP_TEST,
+    OPEN_STEP_OPEN,
+    OPEN_STEP_DONE,
+} OpenStep;
+
+static void open_step (GTask *task);
+
+static void
+open_request_ready (MMPortMipc   *self,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    g_autoptr(MipcMessage) confirmation = NULL;
+    GError                *error = NULL;
+    OpenStep              *step;
+
+    confirmation = mm_port_mipc_request_finish (self, res, &error);
+    if (!confirmation) {
+        mm_port_mipc_close (self);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    step = g_task_get_task_data (task);
+    (*step)++;
+    open_step (task);
+}
+
+static void
+open_step (GTask *task)
+{
+    MMPortMipc             *self = g_task_get_source_object (task);
+    OpenStep               *step = g_task_get_task_data (task);
+    g_autoptr(MipcMessage)  request = NULL;
+    g_autofree gchar       *client_name = NULL;
+
+    switch (*step) {
+    case OPEN_STEP_TEST:
+        request = mipc_message_new (MIPC_MESSAGE_INTERNAL_TEST_REQ, MIPC_SIM_PS_ALL);
+        break;
+    case OPEN_STEP_OPEN:
+        client_name = g_strdup_printf ("/dev/%s", mm_port_get_device (MM_PORT (self)));
+        request = mipc_message_new (MIPC_MESSAGE_INTERNAL_OPEN_REQ, MIPC_SIM_PS_ALL);
+        mipc_message_add_u32 (request, OPEN_REQ_VERSION, MIPC_VERSION);
+        mipc_message_add_string (request, OPEN_REQ_CLIENT_NAME, client_name);
+        mipc_message_add_u8 (request, OPEN_REQ_USIR_SUPPORT, TRUE);
+        break;
+    case OPEN_STEP_DONE:
+        self->session = TRUE;
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    default:
+        g_assert_not_reached ();
+    }
+
+    mm_port_mipc_request (self, request, OPEN_REQUEST_TIMEOUT,
+                          (GAsyncReadyCallback) open_request_ready, task);
+}
+
+void
+mm_port_mipc_open (MMPortMipc          *self,
+                   GAsyncReadyCallback  callback,
+                   gpointer             user_data)
+{
+    g_autofree gchar *path = NULL;
+    GTask            *task;
+    OpenStep         *step;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (self->fd >= 0) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE, "port already open");
+        g_object_unref (task);
+        return;
+    }
+
+    path = g_strdup_printf ("/dev/%s", mm_port_get_device (MM_PORT (self)));
+    self->fd = open (path, O_RDWR | O_NOCTTY | O_NONBLOCK | O_CLOEXEC);
+    if (self->fd < 0) {
+        g_task_return_new_error (task, G_IO_ERROR, g_io_error_from_errno (errno),
+                                 "couldn't open %s: %s", path, g_strerror (errno));
+        g_object_unref (task);
+        return;
+    }
+    self->watch_id = g_unix_fd_add (self->fd, G_IO_IN | G_IO_HUP | G_IO_ERR,
+                                    (GUnixFDSourceFunc) data_available, self);
+
+    step = g_new0 (OpenStep, 1);
+    g_task_set_task_data (task, step, g_free);
+    open_step (task);
+}
+
+gboolean
+mm_port_mipc_open_finish (MMPortMipc    *self,
+                          GAsyncResult  *res,
+                          GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+gboolean
+mm_port_mipc_is_open (MMPortMipc *self)
+{
+    return self->session;
+}
+
+void
+mm_port_mipc_close (MMPortMipc *self)
+{
+    if (self->fd < 0)
+        return;
+
+    /* The modem drops the client's registrations with the session */
+    if (self->session) {
+        g_autoptr(MipcMessage) request = NULL;
+        g_autoptr(GError)      error = NULL;
+
+        request = mipc_message_new (MIPC_MESSAGE_INTERNAL_CLOSE_REQ, MIPC_SIM_PS_ALL);
+        mipc_message_set_txid (request, (self->next_txid % 0xfffe) + 1);
+        if (!write_message (self, request, &error))
+            mm_obj_dbg (self, "couldn't close the session: %s", error->message);
+        self->session = FALSE;
+    }
+
+    if (self->watch_id) {
+        g_source_remove (self->watch_id);
+        self->watch_id = 0;
+    }
+    close (self->fd);
+    self->fd = -1;
+    g_byte_array_set_size (self->buffer, 0);
+    complete_all_pending (self, "port closed");
+}
+
+/*****************************************************************************/
+
+MMPortMipc *
+mm_port_mipc_new (const gchar *name)
+{
+    return g_object_new (MM_TYPE_PORT_MIPC,
+                         MM_PORT_DEVICE, name,
+                         MM_PORT_SUBSYS, MM_PORT_SUBSYS_WWAN,
+                         MM_PORT_TYPE,   MM_PORT_TYPE_MIPC,
+                         NULL);
+}
+
+static void
+mm_port_mipc_init (MMPortMipc *self)
+{
+    self->fd = -1;
+    self->buffer = g_byte_array_new ();
+    self->pending = g_hash_table_new (g_direct_hash, g_direct_equal);
+}
+
+static void
+dispose (GObject *object)
+{
+    MMPortMipc *self = MM_PORT_MIPC (object);
+
+    mm_port_mipc_close (self);
+    g_list_free_full (g_steal_pointer (&self->handlers), g_free);
+
+    G_OBJECT_CLASS (mm_port_mipc_parent_class)->dispose (object);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMPortMipc *self = MM_PORT_MIPC (object);
+
+    g_hash_table_unref (self->pending);
+    g_byte_array_unref (self->buffer);
+
+    G_OBJECT_CLASS (mm_port_mipc_parent_class)->finalize (object);
+}
+
+static void
+mm_port_mipc_class_init (MMPortMipcClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    object_class->dispose = dispose;
+    object_class->finalize = finalize;
+}
