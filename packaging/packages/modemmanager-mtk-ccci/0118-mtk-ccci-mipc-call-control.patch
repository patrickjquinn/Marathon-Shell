+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Patrick Quinn <patrick.jm.quinn@gmail.com>
+ */
+
+#include <string.h>
+
+#include <gio/gio.h>
+
+#include "mm-mipc-protocol.h"
+
+#define MIPC_MAGIC        0x24541984
+#define TLV_HEADER_SIZE   4
+#define ARRAY_HEADER_SIZE 12
+#define TLV_ALIGN(len)    (((len) + 7) & ~((gsize) 7))
+
+/* Header field offsets */
+#define OFFSET_MAGIC  0
+#define OFFSET_SIM_PS 8
+#define OFFSET_FLAGS  9
+#define OFFSET_ID     10
+#define OFFSET_TXID   12
+#define OFFSET_LENGTH 14
+
+struct _MipcMessage {
+    gint        refcount;
+    GByteArray *raw;
+};
+
+static guint16
+read_u16 (const guint8 *p)
+{
+    return (guint16) (p[0] | (p[1] << 8));
+}
+
+static guint32
+read_u32 (const guint8 *p)
+{
+    return (guint32) p[0] | ((guint32) p[1] << 8) | ((guint32) p[2] << 16) | ((guint32) p[3] << 24);
+}
+
+static void
+write_u16 (guint8 *p, guint16 value)
+{
+    p[0] = value & 0xff;
+    p[1] = value >> 8;
+}
+
+static void
+write_u32 (guint8 *p, guint32 value)
+{
+    write_u16 (p, value & 0xffff);
+    write_u16 (p + 2, value >> 16);
+}
+
+/*****************************************************************************/
+
+static MipcMessage *
+message_new_raw (void)
+{
+    MipcMessage *self;
+
+    self = g_new0 (MipcMessage, 1);
+    self->refcount = 1;
+    self->raw = g_byte_array_sized_new (64);
+    return self;
+}
+
+MipcMessage *
+mipc_message_new (guint16 id,
+                  guint8  sim_ps)
+{
+    MipcMessage *self;
+    guint8       header[MIPC_HEADER_SIZE] = { 0 };
+
+    write_u32 (header + OFFSET_MAGIC, MIPC_MAGIC);
+    header[OFFSET_SIM_PS] = sim_ps;
+    write_u16 (header + OFFSET_ID, id);
+    /* Indications carry no transaction */
+    if ((id & MIPC_MESSAGE_KIND_MASK) == MIPC_MESSAGE_KIND_INDICATION)
+        write_u16 (header + OFFSET_TXID, 0xffff);
+
+    self = message_new_raw ();
+    g_byte_array_append (self->raw, header, sizeof (header));
+    return self;
+}
+
+MipcMessage *
+mipc_message_new_reply (const MipcMessage *command)
+{
+    MipcMessage *self;
+
+    self = mipc_message_new (MIPC_MESSAGE_REPLY_ID (mipc_message_get_id (command)),
+                             mipc_message_get_sim_ps (command));
+    mipc_message_set_txid (self, mipc_message_get_txid (command));
+    return self;
+}
+
+MipcMessage *
+mipc_message_ref (MipcMessage *self)
+{
+    g_atomic_int_inc (&self->refcount);
+    return self;
+}
+
+void
+mipc_message_unref (MipcMessage *self)
+{
+    if (g_atomic_int_dec_and_test (&self->refcount)) {
+        g_byte_array_unref (self->raw);
+        g_free (self);
+    }
+}
+
+guint16
+mipc_message_get_id (const MipcMessage *self)
+{
+    return read_u16 (self->raw->data + OFFSET_ID);
+}
+
+guint16
+mipc_message_get_txid (const MipcMessage *self)
+{
+    return read_u16 (self->raw->data + OFFSET_TXID);
+}
+
+void
+mipc_message_set_txid (MipcMessage *self,
+                       guint16      txid)
+{
+    write_u16 (self->raw->data + OFFSET_TXID, txid);
+}
+
+guint8
+mipc_message_get_sim_ps (const MipcMessage *self)
+{
+    return self->raw->data[OFFSET_SIM_PS];
+}
+
+MipcMessageKind
+mipc_message_get_kind (const MipcMessage *self)
+{
+    return mipc_message_get_id (self) & MIPC_MESSAGE_KIND_MASK;
+}
+
+const guint8 *
+mipc_message_get_raw (const MipcMessage *self,
+                      gsize             *len)
+{
+    *len = self->raw->len;
+    return self->raw->data;
+}
+
+/*****************************************************************************/
+
+static void
+add_tlv (MipcMessage   *self,
+         guint16        type,
+         gconstpointer  value,
+         guint16        len)
+{
+    static const guint8 padding[8] = { 0 };
+    guint8              header[TLV_HEADER_SIZE];
+    gsize               start;
+
+    g_assert (len > 0);
+    start = self->raw->len;
+    write_u16 (header, type);
+    write_u16 (header + 2, len);
+    g_byte_array_append (self->raw, header, sizeof (header));
+    g_byte_array_append (self->raw, value, len);
+    g_byte_array_append (self->raw, padding, TLV_ALIGN (self->raw->len - start) - (self->raw->len - start));
+    write_u16 (self->raw->data + OFFSET_LENGTH, self->raw->len - MIPC_HEADER_SIZE);
+}
+
+void
+mipc_message_add_u8 (MipcMessage *self,
+                     guint16      type,
+                     guint8       value)
+{
+    add_tlv (self, type, &value, 1);
+}
+
+void
+mipc_message_add_u16 (MipcMessage *self,
+                      guint16      type,
+                      guint16      value)
+{
+    guint8 buf[2];
+
+    write_u16 (buf, value);
+    add_tlv (self, type, buf, sizeof (buf));
+}
+
+void
+mipc_message_add_u32 (MipcMessage *self,
+                      guint16      type,
+                      guint32      value)
+{
+    guint8 buf[4];
+
+    write_u32 (buf, value);
+    add_tlv (self, type, buf, sizeof (buf));
+}
+
+void
+mipc_message_add_string (MipcMessage *self,
+                         guint16      type,
+                         const gchar *value)
+{
+    add_tlv (self, type, value, strlen (value) + 1);
+}
+
+/*****************************************************************************/
+
+MipcMessage *
+mipc_message_parse (const guint8  *data,
+                    gsize          len,
+                    gsize         *consumed,
+                    GError       **error)
+{
+    MipcMessage *self;
+    gsize        total;
+    gsize        offset;
+
+    *consumed = 0;
+    if (len < 4)
+        return NULL;
+    if (read_u32 (data + OFFSET_MAGIC) != MIPC_MAGIC) {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                     "not a MIPC message (magic 0x%08x)", read_u32 (data + OFFSET_MAGIC));
+        return NULL;
+    }
+    if (len < MIPC_HEADER_SIZE)
+        return NULL;
+    total = MIPC_HEADER_SIZE + read_u16 (data + OFFSET_LENGTH);
+    if (len < total)
+        return NULL;
+
+    /* Each TLV must fit; the last one's padding may be cut short */
+    for (offset = MIPC_HEADER_SIZE; offset < total;) {
+        guint16 vlen;
+
+        if (total - offset < TLV_HEADER_SIZE) {
+            g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                         "truncated TLV header at offset %" G_GSIZE_FORMAT, offset);
+            *consumed = total;
+            return NULL;
+        }
+        vlen = read_u16 (data + offset + 2);
+        if (!vlen)
+            vlen = ARRAY_HEADER_SIZE;
+        if (total - offset - TLV_HEADER_SIZE < vlen) {
+            g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                         "TLV 0x%04x overruns the message", read_u16 (data + offset));
+            *consumed = total;
+            return NULL;
+        }
+        offset += TLV_ALIGN (TLV_HEADER_SIZE + vlen);
+    }
+
+    self = message_new_raw ();
+    g_byte_array_append (self->raw, data, total);
+    *consumed = total;
+    return self;
+}
+
+/* The value of the TLV of @type (bit 15 ignored), its length 0 for an
+ * array header */
+static const guint8 *
+find_tlv (const MipcMessage *self,
+          guint16            type,
+          guint16           *len)
+{
+    gsize offset;
+
+    type &= MIPC_TLV_TYPE_MASK;
+    for (offset = MIPC_HEADER_SIZE; offset + TLV_HEADER_SIZE <= self->raw->len;) {
+        const guint8 *tlv = self->raw->data + offset;
+        guint16       vlen;
+
+        vlen = read_u16 (tlv + 2);
+        if ((read_u16 (tlv) & MIPC_TLV_TYPE_MASK) == type) {
+            *len = vlen;
+            return tlv + TLV_HEADER_SIZE;
+        }
+        offset += TLV_ALIGN (TLV_HEADER_SIZE + (vlen ? vlen : ARRAY_HEADER_SIZE));
+    }
+    return NULL;
+}
+
+static const guint8 *
+find_element (const MipcMessage *self,
+              guint16            type,
+              guint              index,
+              guint16           *len)
+{
+    const guint8 *value;
+
+    value = find_tlv (self, type, len);
+    if (!value)
+        return NULL;
+    if (*len)
+        return index == 0 ? value : NULL;
+    if (index >= read_u16 (value + 10))
+        return NULL;
+    return find_tlv (self, read_u16 (value + 8) + index, len);
+}
+
+guint
+mipc_message_get_count (const MipcMessage *self,
+                        guint16            type)
+{
+    const guint8 *value;
+    guint16       len;
+
+    value = find_tlv (self, type, &len);
+    if (!value)
+        return 0;
+    return len ? 1 : read_u16 (value + 10);
+}
+
+gboolean
+mipc_message_get_u8 (const MipcMessage *self,
+                     guint16            type,
+                     guint              index,
+                     guint8            *out)
+{
+    const guint8 *value;
+    guint16       len;
+
+    value = find_element (self, type, index, &len);
+    if (!value || len != 1)
+        return FALSE;
+    *out = value[0];
+    return TRUE;
+}
+
+gboolean
+mipc_message_get_u32 (const MipcMessage *self,
+                      guint16            type,
+                      guint              index,
+                      guint32           *out)
+{
+    const guint8 *value;
+    guint16       len;
+
+    value = find_element (self, type, index, &len);
+    if (!value || len != 4)
+        return FALSE;
+    *out = read_u32 (value);
+    return TRUE;
+}
+
+gchar *
+mipc_message_dup_string (const MipcMessage *self,
+                         guint16            type,
+                         guint              index)
+{
+    const guint8 *value;
+    guint16       len;
+
+    value = find_element (self, type, index, &len);
+    if (!value || !len)
+        return NULL;
+    return g_strndup ((const gchar *) value, len);
+}
+
+gboolean
+mipc_message_get_result (const MipcMessage *self,
+                         guint32           *result)
+{
+    return mipc_message_get_u32 (self, MIPC_TLV_RESULT, 0, result);
+}
+
+gchar *
+mipc_message_describe (const MipcMessage *self)
+{
+    GString *str;
+    gsize    offset;
+
+    str = g_string_new (NULL);
+    g_string_append_printf (str, "id 0x%04x txid 0x%04x sim/ps 0x%02x",
+                            mipc_message_get_id (self),
+                            mipc_message_get_txid (self),
+                            mipc_message_get_sim_ps (self));
+    for (offset = MIPC_HEADER_SIZE; offset + TLV_HEADER_SIZE <= self->raw->len;) {
+        const guint8 *tlv = self->raw->data + offset;
+        guint16       vlen = read_u16 (tlv + 2);
+        guint16       i;
+
+        g_string_append_printf (str, " %04x=", read_u16 (tlv));
+        if (!vlen) {
+            g_string_append_printf (str, "[array 0x%04x x%u]",
+                                    read_u16 (tlv + TLV_HEADER_SIZE + 8),
+                                    read_u16 (tlv + TLV_HEADER_SIZE + 10));
+            vlen = ARRAY_HEADER_SIZE;
+        } else {
+            for (i = 0; i < vlen && offset + TLV_HEADER_SIZE + i < self->raw->len; i++)
+                g_string_append_printf (str, "%02x", tlv[TLV_HEADER_SIZE + i]);
+        }
+        offset += TLV_ALIGN (TLV_HEADER_SIZE + vlen);
+    }
+    return g_string_free (str, FALSE);
+}
diff --git a/src/plugins/mtk-ccci/mm-mipc-protocol.h b/src/plugins/mtk-ccci/mm-mipc-protocol.h
new file mode 100644
index 0000000..1f9e293
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mipc-protocol.h
@@ -0,0 +1,134 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 Patrick Quinn <patrick.jm.quinn@gmail.com>
+ */
+
+#ifndef MM_MIPC_PROTOCOL_H
+#define MM_MIPC_PROTOCOL_H
+
+#include <glib.h>
+
+/*
+ * MIPC, MediaTek's modem control protocol (MIPC ports of SoC CCCI modems
+ * and of t7xx PCIe modems). Little-endian messages:
+ *
+ *   u32 magic, u16 reserved[2], u8 sim/ps mask, u8 flags, u16 message id,
+ *   u16 transaction id, u16 payload length, then the payload as TLVs:
+ *   u16 type, u16 length, value, each padded to 8 bytes.
+ *
+ * The top two bits of the message id give its kind. A TLV of length 0 is an
+ * array header (u32 0, u32 0, u16 first element type, u16 element count)
+ * whose elements are TLVs of the following types.
+ */
+
+#define MIPC_HEADER_SIZE 16
+#define MIPC_VERSION     2
+
+typedef enum { /*< underscore_name=mipc_message_kind >*/
+    MIPC_MESSAGE_KIND_REQUEST    = 0x0000, /* host to modem, answered by a confirmation */
+    MIPC_MESSAGE_KIND_INDICATION = 0x4000, /* modem to host */
+    MIPC_MESSAGE_KIND_COMMAND    = 0x8000, /* modem to host, answered by a response */
+    MIPC_MESSAGE_KIND_MASK       = 0xc000,
+} MipcMessageKind;
+
+typedef enum { /*< underscore_name=mipc_message_id >*/
+    MIPC_MESSAGE_SYS_AT_REQ                 = 0x0003,
+    MIPC_MESSAGE_INTERNAL_OPEN_REQ          = 0x0301,
+    MIPC_MESSAGE_INTERNAL_CLOSE_REQ         = 0x0303,
+    MIPC_MESSAGE_INTERNAL_TEST_REQ          = 0x0305,
+    MIPC_MESSAGE_INTERNAL_REGISTER_IND_REQ  = 0x0307,
+    MIPC_MESSAGE_INTERNAL_REGISTER_CMD_REQ  = 0x030b,
+    MIPC_MESSAGE_CALL_GET_CALL_STATUS_REQ   = 0x0909,
+    MIPC_MESSAGE_CALL_STATUS_IND            = 0x4901,
+    MIPC_MESSAGE_CALL_EVENT_IND             = 0x4902,
+    MIPC_MESSAGE_CALL_APPROVE_INCOMING_CMD  = 0x8901,
+    MIPC_MESSAGE_CALL_APPROVE_INCOMING_RSP  = 0x8902,
+} MipcMessageId;
+
+/* A request's confirmation and a command's response take the next id */
+#define MIPC_MESSAGE_REPLY_ID(id) ((guint16) ((id) + 1))
+
+/* Bit 15 of a TLV type marks a variable-size value; lookups ignore it */
+#define MIPC_TLV_TYPE_MASK 0x7fff
+
+#define MIPC_TLV_RESULT 0x0000
+
+typedef enum { /*< underscore_name=mipc_sim_ps >*/
+    MIPC_SIM_PS_SIM0 = 1 << 0,
+    MIPC_SIM_PS_PS0  = 1 << 4,
+    MIPC_SIM_PS_ALL  = 0xff,
+} MipcSimPs;
+
+typedef struct _MipcMessage MipcMessage;
+
+MipcMessage *mipc_message_new          (guint16            id,
+                                        guint8             sim_ps);
+MipcMessage *mipc_message_new_reply    (const MipcMessage *command);
+MipcMessage *mipc_message_ref          (MipcMessage       *self);
+void         mipc_message_unref        (MipcMessage       *self);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MipcMessage, mipc_message_unref)
+
+guint16      mipc_message_get_id       (const MipcMessage *self);
+guint16      mipc_message_get_txid     (const MipcMessage *self);
+void         mipc_message_set_txid     (MipcMessage       *self,
+                                        guint16            txid);
+guint8       mipc_message_get_sim_ps   (const MipcMessage *self);
+MipcMessageKind mipc_message_get_kind  (const MipcMessage *self);
+
+void         mipc_message_add_u8       (MipcMessage       *self,
+                                        guint16            type,
+                                        guint8             value);
+void         mipc_message_add_u16      (MipcMessage       *self,
+                                        guint16            type,
+                                        guint16            value);
+void         mipc_message_add_u32      (MipcMessage       *self,
+                                        guint16            type,
+                                        guint32            value);
+void         mipc_message_add_string   (MipcMessage       *self,
+                                        guint16            type,
+                                        const gchar       *value);
+
+/* The serialized message (header and TLVs) */
+const guint8 *mipc_message_get_raw     (const MipcMessage *self,
+                                        gsize             *len);
+
+/* Parses the message at the start of @data. Returns NULL with @consumed 0
+ * while the message is incomplete, or NULL with an error if it isn't MIPC. */
+MipcMessage *mipc_message_parse        (const guint8      *data,
+                                        gsize              len,
+                                        gsize             *consumed,
+                                        GError           **error);
+
+/* Value lookups. @index picks an array element; a single value counts as
+ * an array of one, so index 0 always works. */
+guint        mipc_message_get_count    (const MipcMessage *self,
+                                        guint16            type);
+gboolean     mipc_message_get_u8       (const MipcMessage *self,
+                                        guint16            type,
+                                        guint              index,
+                                        guint8            *out);
+gboolean     mipc_message_get_u32      (const MipcMessage *self,
+                                        guint16            type,
+                                        guint              index,
+                                        guint32           *out);
+gchar       *mipc_message_dup_string   (const MipcMessage *self,
+                                        guint16            type,
+                                        guint              index);
+
+/* The confirmation's result TLV: MIPC_RESULT_SUCCESS (0) or a cause */
+gboolean     mipc_message_get_result   (const MipcMessage *self,
+                                        guint32           *result);
+
+gchar       *mipc_message_describe     (const MipcMessage *self);
+
+#endif /* MM_MIPC_PROTOCOL_H */
