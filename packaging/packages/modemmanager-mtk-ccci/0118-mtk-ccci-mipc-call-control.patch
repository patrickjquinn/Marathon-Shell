+
+#include <string.h>
+
+#include <glib.h>
+#include <gio/gio.h>
+
+#include "mm-mipc-protocol.h"
+
+/* Messages exchanged with an MT6858 (MOLY.NR17) modem on ttyCMIPC1 */
+
+/* INTERNAL_OPEN_REQ, txid 0x0102: version 2, client "/dev/ttyCMIPC1", USIR */
+static const guint8 open_req[] = {
+    0x84, 0x19, 0x54, 0x24, 0x00, 0x00, 0x00, 0x00, 0xff, 0x00, 0x01, 0x03, 0x02, 0x01, 0x28, 0x00,
+    0x00, 0x01, 0x04, 0x00, 0x02, 0x00, 0x00, 0x00,
+    0x01, 0x01, 0x0f, 0x00, 0x2f, 0x64, 0x65, 0x76, 0x2f, 0x74, 0x74, 0x79, 0x43, 0x4d, 0x49, 0x50,
+    0x43, 0x31, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x02, 0x01, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00,
+};
+
+/* INTERNAL_OPEN_CNF, txid 0x0102: result 0, version 0, timeout 300000 ms */
+static const guint8 open_cnf[] = {
+    0x84, 0x19, 0x54, 0x24, 0x00, 0x00, 0x00, 0x00, 0xff, 0x02, 0x02, 0x03, 0x02, 0x01, 0x18, 0x00,
+    0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x01, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x01, 0x01, 0x04, 0x00, 0xe0, 0x93, 0x04, 0x00,
+};
+
+/* INTERNAL_REGISTER_IND_CNF, txid 0x0105, SIM 0: result 0 */
+static const guint8 register_cnf[] = {
+    0x84, 0x19, 0x54, 0x24, 0x00, 0x00, 0x00, 0x00, 0x01, 0x02, 0x08, 0x03, 0x05, 0x01, 0x08, 0x00,
+    0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+/* CALL_GET_CALL_STATUS_CNF listing two calls: result 0, count 2, call ids
+ * 1 and 2 (array 0x7ffe-0x7fff), numbers "0851234567" and "12" (array
+ * 0x7ffc-0x7ffd) */
+static const guint8 call_status_cnf[] = {
+    0x84, 0x19, 0x54, 0x24, 0x00, 0x00, 0x00, 0x00, 0x01, 0x02, 0x0a, 0x09, 0x07, 0x01, 0x60, 0x00,
+    0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x01, 0x04, 0x00, 0x02, 0x00, 0x00, 0x00,
+    0x0b, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xfe, 0x7f, 0x02, 0x00,
+    0xfe, 0x7f, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00,
+    0xff, 0x7f, 0x04, 0x00, 0x02, 0x00, 0x00, 0x00,
+    0x11, 0x81, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xfc, 0xff, 0x02, 0x00,
+    0xfc, 0xff, 0x0b, 0x00, 0x30, 0x38, 0x35, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x00, 0x00,
+    0xfd, 0xff, 0x03, 0x00, 0x31, 0x32, 0x00, 0x00,
+    0x0e, 0x01, 0x04, 0x00, 0x04, 0x00, 0x00, 0x00,
+};
+
+/*****************************************************************************/
+
+static void
+test_build_open_request (void)
+{
+    g_autoptr(MipcMessage)  message = NULL;
+    const guint8           *raw;
+    gsize                   len;
+
+    message = mipc_message_new (MIPC_MESSAGE_INTERNAL_OPEN_REQ, MIPC_SIM_PS_ALL);
+    mipc_message_set_txid (message, 0x0102);
+    mipc_message_add_u32 (message, 0x100, MIPC_VERSION);
+    mipc_message_add_string (message, 0x101, "/dev/ttyCMIPC1");
+    mipc_message_add_u8 (message, 0x102, TRUE);
+
+    raw = mipc_message_get_raw (message, &len);
+    g_assert_cmpmem (raw, len, open_req, sizeof (open_req));
+}
+
+static void
+test_build_reply (void)
+{
+    g_autoptr(MipcMessage) command = NULL;
+    g_autoptr(MipcMessage) reply = NULL;
+
+    command = mipc_message_new (MIPC_MESSAGE_CALL_APPROVE_INCOMING_CMD, MIPC_SIM_PS_SIM0);
+    mipc_message_set_txid (command, 0x2a);
+    reply = mipc_message_new_reply (command);
+    g_assert_cmpuint (mipc_message_get_id (reply), ==, MIPC_MESSAGE_CALL_APPROVE_INCOMING_RSP);
+    g_assert_cmpuint (mipc_message_get_txid (reply), ==, 0x2a);
+    g_assert_cmpuint (mipc_message_get_sim_ps (reply), ==, MIPC_SIM_PS_SIM0);
+    g_assert_cmpuint (mipc_message_get_kind (reply), ==, MIPC_MESSAGE_KIND_COMMAND);
+}
+
+static void
+test_build_indication_txid (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+
+    message = mipc_message_new (MIPC_MESSAGE_CALL_STATUS_IND, MIPC_SIM_PS_SIM0);
+    g_assert_cmpuint (mipc_message_get_txid (message), ==, 0xffff);
+}
+
+static void
+test_parse_open_confirmation (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+    g_autoptr(GError)      error = NULL;
+    gsize                  consumed;
+    guint32                value;
+
+    message = mipc_message_parse (open_cnf, sizeof (open_cnf), &consumed, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (message);
+    g_assert_cmpuint (consumed, ==, sizeof (open_cnf));
+    g_assert_cmpuint (mipc_message_get_id (message), ==, MIPC_MESSAGE_REPLY_ID (MIPC_MESSAGE_INTERNAL_OPEN_REQ));
+    g_assert_cmpuint (mipc_message_get_txid (message), ==, 0x0102);
+    g_assert_cmpuint (mipc_message_get_kind (message), ==, MIPC_MESSAGE_KIND_REQUEST);
+    g_assert_true (mipc_message_get_result (message, &value));
+    g_assert_cmpuint (value, ==, 0);
+    g_assert_true (mipc_message_get_u32 (message, 0x101, 0, &value));
+    g_assert_cmpuint (value, ==, 300000);
+    g_assert_false (mipc_message_get_u32 (message, 0x101, 1, &value));
+    g_assert_false (mipc_message_get_u8 (message, 0x101, 0, (guint8 *) &value));
+    g_assert_false (mipc_message_get_u32 (message, 0x102, 0, &value));
+}
+
+static void
+test_parse_incomplete (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+    g_autoptr(GError)      error = NULL;
+    gsize                  len;
+    gsize                  consumed = 1;
+
+    for (len = 0; len < sizeof (open_cnf); len++) {
+        message = mipc_message_parse (open_cnf, len, &consumed, &error);
+        g_assert_no_error (error);
+        g_assert_null (message);
+        g_assert_cmpuint (consumed, ==, 0);
+    }
+}
+
+static void
+test_parse_two_messages (void)
+{
+    g_autoptr(MipcMessage) first = NULL;
+    g_autoptr(MipcMessage) second = NULL;
+    g_autoptr(GByteArray)  buffer = NULL;
+    g_autoptr(GError)      error = NULL;
+    gsize                  consumed;
+
+    buffer = g_byte_array_new ();
+    g_byte_array_append (buffer, register_cnf, sizeof (register_cnf));
+    g_byte_array_append (buffer, open_cnf, sizeof (open_cnf));
+
+    first = mipc_message_parse (buffer->data, buffer->len, &consumed, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (consumed, ==, sizeof (register_cnf));
+    g_assert_cmpuint (mipc_message_get_txid (first), ==, 0x0105);
+    g_assert_cmpuint (mipc_message_get_sim_ps (first), ==, MIPC_SIM_PS_SIM0);
+
+    second = mipc_message_parse (buffer->data + consumed, buffer->len - consumed, &consumed, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (consumed, ==, sizeof (open_cnf));
+    g_assert_cmpuint (mipc_message_get_txid (second), ==, 0x0102);
+}
+
+static void
+test_parse_not_mipc (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+    g_autoptr(GError)      error = NULL;
+    gsize                  consumed;
+
+    message = mipc_message_parse ((const guint8 *) "\r\nOK\r\n", 6, &consumed, &error);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_assert_null (message);
+}
+
+static void
+test_parse_overrun (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+    g_autoptr(GError)      error = NULL;
+    guint8                 broken[sizeof (register_cnf)];
+    gsize                  consumed;
+
+    /* The result TLV claims 8 bytes where the message has 4 */
+    memcpy (broken, register_cnf, sizeof (broken));
+    broken[18] = 8;
+    message = mipc_message_parse (broken, sizeof (broken), &consumed, &error);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_assert_null (message);
+    g_assert_cmpuint (consumed, ==, sizeof (broken));
+}
+
+static void
+test_parse_arrays (void)
+{
+    g_autoptr(MipcMessage) message = NULL;
+    g_autoptr(GError)      error = NULL;
+    g_autofree gchar      *number0 = NULL;
+    g_autofree gchar      *number1 = NULL;
+    gsize                  consumed;
+    guint32                value;
+
+    message = mipc_message_parse (call_status_cnf, sizeof (call_status_cnf), &consumed, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (message);
+
+    g_assert_true (mipc_message_get_u32 (message, 0x100, 0, &value));
+    g_assert_cmpuint (value, ==, 2);
+
+    g_assert_cmpuint (mipc_message_get_count (message, 0x10b), ==, 2);
+    g_assert_true (mipc_message_get_u32 (message, 0x10b, 0, &value));
+    g_assert_cmpuint (value, ==, 1);
+    g_assert_true (mipc_message_get_u32 (message, 0x10b, 1, &value));
+    g_assert_cmpuint (value, ==, 2);
+    g_assert_false (mipc_message_get_u32 (message, 0x10b, 2, &value));
+
+    /* Bit 15 marks variable-size types, set or not in the lookup */
+    g_assert_cmpuint (mipc_message_get_count (message, 0x111), ==, 2);
+    number0 = mipc_message_dup_string (message, 0x8111, 0);
+    number1 = mipc_message_dup_string (message, 0x111, 1);
+    g_assert_cmpstr (number0, ==, "0851234567");
+    g_assert_cmpstr (number1, ==, "12");
+
+    /* A single value is an array of one */
+    g_assert_cmpuint (mipc_message_get_count (message, 0x10e), ==, 1);
+    g_assert_true (mipc_message_get_u32 (message, 0x10e, 0, &value));
+    g_assert_cmpuint (value, ==, 4);
+
+    g_assert_cmpuint (mipc_message_get_count (message, 0x10c), ==, 0);
+}
+
+int main (int argc, char **argv)
+{
+    g_test_init (&argc, &argv, NULL);
+
+    g_test_add_func ("/MM/mipc/build/open-request", test_build_open_request);
+    g_test_add_func ("/MM/mipc/build/reply", test_build_reply);
+    g_test_add_func ("/MM/mipc/build/indication-txid", test_build_indication_txid);
+    g_test_add_func ("/MM/mipc/parse/open-confirmation", test_parse_open_confirmation);
+    g_test_add_func ("/MM/mipc/parse/incomplete", test_parse_incomplete);
+    g_test_add_func ("/MM/mipc/parse/two-messages", test_parse_two_messages);
+    g_test_add_func ("/MM/mipc/parse/not-mipc", test_parse_not_mipc);
+    g_test_add_func ("/MM/mipc/parse/overrun", test_parse_overrun);
+    g_test_add_func ("/MM/mipc/parse/arrays", test_parse_arrays);
+
+    return g_test_run ();
+}
