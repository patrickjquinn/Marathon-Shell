+
+#ifndef MM_PORT_MIPC_H
+#define MM_PORT_MIPC_H
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+
+#include "mm-port.h"
+#include "mm-mipc-protocol.h"
+
+#define MM_TYPE_PORT_MIPC mm_port_mipc_get_type ()
+G_DECLARE_FINAL_TYPE (MMPortMipc, mm_port_mipc, MM, PORT_MIPC, MMPort)
+
+/* Handlers of indications and commands; a command's handler sends its
+ * response with mm_port_mipc_send() */
+typedef void (* MMPortMipcMessageFn) (MMPortMipc  *self,
+                                      MipcMessage *message,
+                                      gpointer     user_data);
+
+MMPortMipc  *mm_port_mipc_new            (const gchar          *name);
+
+/* Opens the device and the MIPC session */
+void         mm_port_mipc_open           (MMPortMipc           *self,
+                                          GAsyncReadyCallback   callback,
+                                          gpointer              user_data);
+gboolean     mm_port_mipc_open_finish    (MMPortMipc           *self,
+                                          GAsyncResult         *res,
+                                          GError              **error);
+gboolean     mm_port_mipc_is_open        (MMPortMipc           *self);
+void         mm_port_mipc_close          (MMPortMipc           *self);
+
+/* Sends a request and returns its confirmation; fails unless the
+ * confirmation's result is success */
+void         mm_port_mipc_request        (MMPortMipc           *self,
+                                          MipcMessage          *request,
+                                          guint                 timeout_seconds,
+                                          GAsyncReadyCallback   callback,
+                                          gpointer              user_data);
+MipcMessage *mm_port_mipc_request_finish (MMPortMipc           *self,
+                                          GAsyncResult         *res,
+                                          GError              **error);
+
+/* Sends a message that has no reply: a command's response */
+gboolean     mm_port_mipc_send           (MMPortMipc           *self,
+                                          MipcMessage          *message,
+                                          GError              **error);
+
+guint        mm_port_mipc_add_handler    (MMPortMipc           *self,
+                                          guint16               message_id,
+                                          MMPortMipcMessageFn   callback,
+                                          gpointer              user_data);
+void         mm_port_mipc_remove_handler (MMPortMipc           *self,
+                                          guint                 handler_id);
+
+#endif /* MM_PORT_MIPC_H */
