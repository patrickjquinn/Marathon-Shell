+
+#include <config.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <arpa/inet.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-mtk-ccci.h"
+#include "mm-log.h"
+#include "mm-modem-helpers.h"
+#include "mm-bind.h"
+
+/*
+ * MediaTek SoC modems (MT6768 and friends) don't bind +CGACT contexts to the
+ * ccmni network interfaces. The stock RIL (libmtk-ril.so) activates PDNs
+ * with MediaTek's own commands, which this bearer follows:
+ *
+ *   AT+EDALLOW=1                        allow data on this SIM
+ *   AT+EAPNACT=1,"<apn>","default",0    activate a PDN; the modem picks the
+ *                                       interface and reports it in
+ *                                       +EIF: <id>, ifup, ... where
+ *                                       <id> % 100 is the ccmni index
+ *   AT+EIF=<id>, "ifst", "up", <type>  confirm the interface is up (the
+ *                                       modem module confirms "down")
+ *   AT+CGCONTRDP                        find the activated id (aid) and DNS
+ *   AT+EPDN=<aid>,"addr"                IPv4 address / IPv6 link-local
+ *   AT+EAPNACT=0,<aid>,0                deactivate
+ *
+ * On LTE the network already set up the default bearer on attach (APN from
+ * AT+EIAAPN), so activating the same APN just binds it to the interface.
+ */
+
+#define UNKNOWN_AID G_MAXUINT
+
+G_DEFINE_TYPE (MMBroadbandBearerMtkCcci, mm_broadband_bearer_mtk_ccci, MM_TYPE_BROADBAND_BEARER)
+
+struct _MMBroadbandBearerMtkCcciPrivate {
+    guint aid;
+};
+
+/*****************************************************************************/
+/* Helpers */
+
+/* Split an AT response line into its comma separated fields, unquoted */
+static GPtrArray *
+split_fields (const gchar *str)
+{
+    GPtrArray *fields;
+    GString   *field;
+    gboolean   quoted = FALSE;
+
+    fields = g_ptr_array_new_with_free_func (g_free);
+    field = g_string_new (NULL);
+    for (; *str; str++) {
+        if (*str == '"')
+            quoted = !quoted;
+        else if (*str == ',' && !quoted) {
+            g_ptr_array_add (fields, g_strstrip (g_string_free (field, FALSE)));
+            field = g_string_new (NULL);
+        } else
+            g_string_append_c (field, *str);
+    }
+    g_ptr_array_add (fields, g_strstrip (g_string_free (field, FALSE)));
+    return fields;
+}
+
+/* The modem prints IPv6 addresses as 16 dotted decimal bytes, with an
+ * optional "/prefix". Returns a printable address, or NULL. */
+static gchar *
+parse_address (const gchar *str,
+               guint       *out_prefix,
+               gboolean    *out_ipv6)
+{
+    g_auto(GStrv)  parts = NULL;
+    g_autofree gchar *addr = NULL;
+    const gchar   *slash;
+    guint8         bytes[16];
+    gchar          buf[INET6_ADDRSTRLEN];
+    guint          n, i;
+
+    if (!str || !str[0])
+        return NULL;
+
+    slash = strchr (str, '/');
+    addr = slash ? g_strndup (str, slash - str) : g_strdup (str);
+    if (out_prefix)
+        *out_prefix = slash ? (guint) atoi (slash + 1) : 0;
+
+    parts = g_strsplit (addr, ".", -1);
+    n = g_strv_length (parts);
+    if (n != 4 && n != 16)
+        return NULL;
+    for (i = 0; i < n; i++) {
+        guint v;
+
+        if (!mm_get_uint_from_str (parts[i], &v) || v > 255)
+            return NULL;
+        bytes[i] = v;
+    }
+    if (!inet_ntop (n == 4 ? AF_INET : AF_INET6, bytes, buf, sizeof (buf)))
+        return NULL;
+    if (out_ipv6)
+        *out_ipv6 = (n == 16);
+    return g_strdup (buf);
+}
+
+/*****************************************************************************/
+/* 3GPP Connect sequence */
+
+typedef enum {
+    CONNECT_STEP_FIRST,
+    CONNECT_STEP_EDALLOW,
+    CONNECT_STEP_STALE_CHECK,
+    CONNECT_STEP_STALE_DEACTIVATE,
+    CONNECT_STEP_EAPNACT,
+    CONNECT_STEP_CONFIRM_UP,
+    CONNECT_STEP_CGCONTRDP,
+    CONNECT_STEP_EPDN_ADDR,
+    CONNECT_STEP_LAST,
+} ConnectStep;
+
+typedef struct {
+    MMBaseModem      *modem;
+    MMPortSerialAt   *primary;
+    MMPort           *data;
+    ConnectStep       step;
+    gchar            *apn;
+    gint              ifid;
+    guint             eif_id;
+    guint             eif_type;
+    guint             stale_aid;
+    guint             aid;
+    MMBearerIpConfig *ipv4_config;
+    MMBearerIpConfig *ipv6_config;
+    GPtrArray        *dns4;
+    GPtrArray        *dns6;
+} ConnectContext;
+
+static void
+connect_context_free (ConnectContext *ctx)
+{
+    g_clear_object (&ctx->ipv4_config);
+    g_clear_object (&ctx->ipv6_config);
+    g_ptr_array_unref (ctx->dns4);
+    g_ptr_array_unref (ctx->dns6);
+    g_free (ctx->apn);
+    g_clear_object (&ctx->data);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (ConnectContext, ctx);
+}
+
+static MMBearerConnectResult *
+connect_3gpp_finish (MMBroadbandBearer  *self,
+                     GAsyncResult       *res,
+                     GError            **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void connect_step (GTask *task);
+
+static void
+edallow_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    ConnectContext   *ctx;
+    g_autoptr(GError) error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    /* Not fatal: data may already be allowed */
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't allow data: %s", error->message);
+    ctx->step++;
+    connect_step (task);
+}
+
+static void
+eapnact_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    ConnectContext *ctx;
+    const gchar    *response;
+    const gchar    *eif;
+    GError         *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        g_prefix_error (&error, "PDN activation failed: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* The +EIF URC comes before the OK, so it is part of the response */
+    for (eif = strstr (response, "+EIF:"); eif; eif = strstr (eif + 1, "+EIF:")) {
+        g_autofree gchar     *line = NULL;
+        g_autoptr(GPtrArray)  fields = NULL;
+        guint                 id;
+
+        line = g_strndup (eif + strlen ("+EIF:"), strcspn (eif, "\r\n") - strlen ("+EIF:"));
+        fields = split_fields (line);
+        if (fields->len >= 2 &&
+            !g_strcmp0 (g_ptr_array_index (fields, 1), "ifup") &&
+            mm_get_uint_from_str (g_ptr_array_index (fields, 0), &id)) {
+            ctx->eif_id = id;
+            ctx->ifid = id % 100;
+            if (fields->len < 3 || !mm_get_uint_from_str (g_ptr_array_index (fields, 2), &ctx->eif_type))
+                ctx->eif_type = 3;
+            break;
+        }
+    }
+    if (ctx->ifid < 0) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "PDN activated but the modem reported no interface");
+        g_object_unref (task);
+        return;
+    }
+
+    ctx->step++;
+    connect_step (task);
+}
+
+/* +CGCONTRDP: <aid>,<bearer id>,<apn>,<local addr>,<gw>,<dns1>,<dns2>,...
+ * lists the PDNs bound to an interface. The network reports the APN with its
+ * operator suffix, e.g. "antel.lte.MNC001.MCC748.GPRS"; a dual stack PDN has
+ * one line per family. Returns the aid of the PDN for APN, or UNKNOWN_AID. */
+static guint
+parse_cgcontrdp (const gchar *response,
+                 const gchar *apn,
+                 GPtrArray   *dns4,
+                 GPtrArray   *dns6)
+{
+    g_auto(GStrv) lines = NULL;
+    guint         found = UNKNOWN_AID;
+    guint         i;
+
+    lines = g_strsplit (response, "\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_autoptr(GPtrArray) fields = NULL;
+        const gchar         *line;
+        guint                aid;
+        guint                j;
+
+        line = g_strstrip (lines[i]);
+        if (!g_str_has_prefix (line, "+CGCONTRDP:"))
+            continue;
+        fields = split_fields (line + strlen ("+CGCONTRDP:"));
+        if (fields->len < 3 || !mm_get_uint_from_str (g_ptr_array_index (fields, 0), &aid))
+            continue;
+        if (g_ascii_strncasecmp (g_ptr_array_index (fields, 2), apn, strlen (apn)) != 0)
+            continue;
+        if (found != UNKNOWN_AID && found != aid)
+            continue;
+        found = aid;
+
+        for (j = 5; dns4 && dns6 && j < 7 && j < fields->len; j++) {
+            gchar    *dns;
+            gboolean  ipv6 = FALSE;
+
+            dns = parse_address (g_ptr_array_index (fields, j), NULL, &ipv6);
+            if (dns)
+                g_ptr_array_add (ipv6 ? dns6 : dns4, dns);
+        }
+    }
+    return found;
+}
+
+static void
+stale_check_ready (MMBaseModem  *modem,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    ConnectContext *ctx;
+    const gchar    *response;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, NULL);
+    if (response)
+        ctx->stale_aid = parse_cgcontrdp (response, ctx->apn, NULL, NULL);
+    /* A PDN still bound from before (e.g. the daemon restarted while
+     * connected) must be released first, or the activation fails */
+    ctx->step = (ctx->stale_aid != UNKNOWN_AID) ? CONNECT_STEP_STALE_DEACTIVATE : CONNECT_STEP_EAPNACT;
+    connect_step (task);
+}
+
+static void
+stale_deactivate_ready (MMBaseModem  *modem,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    ConnectContext   *ctx;
+    g_autoptr(GError) error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't release stale PDN %u: %s",
+                    ctx->stale_aid, error->message);
+    ctx->step++;
+    connect_step (task);
+}
+
+static void
+confirm_up_ready (MMBaseModem  *modem,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    ConnectContext   *ctx;
+    g_autoptr(GError) error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't confirm interface %u up: %s",
+                    ctx->eif_id, error->message);
+    ctx->step++;
+    connect_step (task);
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    MMBroadbandBearerMtkCcci *self;
+    ConnectContext           *ctx;
+    const gchar              *response;
+    GError                   *error = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        g_prefix_error (&error, "couldn't read PDN parameters: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    ctx->aid = parse_cgcontrdp (response, ctx->apn, ctx->dns4, ctx->dns6);
+
+    if (ctx->aid == UNKNOWN_AID) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "no active PDN for APN '%s'", ctx->apn);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "PDN for APN '%s' is aid %u", ctx->apn, ctx->aid);
+    ctx->step++;
+    connect_step (task);
+}
+
+static void
+epdn_addr_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    ConnectContext *ctx;
+    const gchar    *response;
+    g_auto(GStrv)   lines = NULL;
+    GError         *error = NULL;
+    guint           i;
+
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        g_prefix_error (&error, "couldn't read PDN addresses: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* +EPDN: <aid>, "addr", <type>, "<address>" (one line per address) */
+    lines = g_strsplit (response, "\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_autoptr(GPtrArray) fields = NULL;
+        g_autofree gchar    *address = NULL;
+        const gchar         *line;
+        gboolean             ipv6 = FALSE;
+        guint                prefix = 0;
+
+        line = g_strstrip (lines[i]);
+        if (!g_str_has_prefix (line, "+EPDN:"))
+            continue;
+        fields = split_fields (line + strlen ("+EPDN:"));
+        if (fields->len < 4 || g_strcmp0 (g_ptr_array_index (fields, 1), "addr") != 0)
+            continue;
+        address = parse_address (g_ptr_array_index (fields, 3), &prefix, &ipv6);
+        if (!address)
+            continue;
+
+        if (!ipv6 && !ctx->ipv4_config) {
+            ctx->ipv4_config = mm_bearer_ip_config_new ();
+            mm_bearer_ip_config_set_method (ctx->ipv4_config, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (ctx->ipv4_config, address);
+            mm_bearer_ip_config_set_prefix (ctx->ipv4_config, 32);
+            if (ctx->dns4->len) {
+                g_ptr_array_add (ctx->dns4, NULL);
+                mm_bearer_ip_config_set_dns (ctx->ipv4_config, (const gchar **) ctx->dns4->pdata);
+                g_ptr_array_remove_index (ctx->dns4, ctx->dns4->len - 1);
+            }
+        } else if (ipv6 && !ctx->ipv6_config) {
+            /* A link-local address carries the interface identifier the
+             * network expects; the global address comes from SLAAC */
+            ctx->ipv6_config = mm_bearer_ip_config_new ();
+            mm_bearer_ip_config_set_method (ctx->ipv6_config, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (ctx->ipv6_config, address);
+            mm_bearer_ip_config_set_prefix (ctx->ipv6_config, prefix ? prefix : 64);
+            /* The modem reports no gateway, NetworkManager requires one.
+             * ccmni is a raw IP NOARP link, so any other link-local next
+             * hop reaches the network */
+            mm_bearer_ip_config_set_gateway (ctx->ipv6_config,
+                                             g_strcmp0 (address, "fe80::1") ? "fe80::1" : "fe80::2");
+            if (ctx->dns6->len) {
+                g_ptr_array_add (ctx->dns6, NULL);
+                mm_bearer_ip_config_set_dns (ctx->ipv6_config, (const gchar **) ctx->dns6->pdata);
+                g_ptr_array_remove_index (ctx->dns6, ctx->dns6->len - 1);
+            }
+        }
+    }
+
+    if (!ctx->ipv4_config && !ctx->ipv6_config) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "no address for PDN aid %u", ctx->aid);
+        g_object_unref (task);
+        return;
+    }
+
+    ctx->step++;
+    connect_step (task);
+}
+
+static void
+connect_step (GTask *task)
+{
+    MMBroadbandBearerMtkCcci *self;
+    ConnectContext           *ctx;
+    g_autofree gchar         *command = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+
+    switch (ctx->step) {
+    case CONNECT_STEP_FIRST:
+        ctx->step++;
+        /* fall through */
+
+    case CONNECT_STEP_EDALLOW:
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       "+EDALLOW=1",
+                                       10,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) edallow_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_STALE_CHECK:
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       "+CGCONTRDP",
+                                       10,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) stale_check_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_STALE_DEACTIVATE:
+        command = g_strdup_printf ("+EAPNACT=0,%u,0", ctx->stale_aid);
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       command,
+                                       MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) stale_deactivate_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_EAPNACT: {
+        g_autofree gchar *apn = NULL;
+
+        apn = mm_at_quote_string (ctx->apn);
+        command = g_strdup_printf ("+EAPNACT=1,%s,\"default\",0", apn);
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       command,
+                                       MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) eapnact_ready,
+                                       task);
+        return;
+    }
+
+    case CONNECT_STEP_CONFIRM_UP:
+        command = g_strdup_printf ("+EIF=%u, \"ifst\", \"up\", %u", ctx->eif_id, ctx->eif_type);
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       command,
+                                       10,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) confirm_up_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_CGCONTRDP:
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       "+CGCONTRDP",
+                                       10,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) cgcontrdp_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_EPDN_ADDR:
+        command = g_strdup_printf ("+EPDN=%u,\"addr\"", ctx->aid);
+        mm_base_modem_at_command_full (ctx->modem,
+                                       MM_IFACE_PORT_AT (ctx->primary),
+                                       command,
+                                       10,
+                                       FALSE, FALSE,
+                                       g_task_get_cancellable (task),
+                                       (GAsyncReadyCallback) epdn_addr_ready,
+                                       task);
+        return;
+
+    case CONNECT_STEP_LAST: {
+        g_autofree gchar *ifname = NULL;
+
+        ifname = g_strdup_printf ("ccmni%d", ctx->ifid);
+        ctx->data = mm_base_modem_get_port (ctx->modem, ifname);
+        if (!ctx->data || mm_port_get_port_type (ctx->data) != MM_PORT_TYPE_NET) {
+            g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                     "PDN aid %u is on %s, which isn't a port of this modem",
+                                     ctx->aid, ifname);
+            g_object_unref (task);
+            return;
+        }
+        self->priv->aid = ctx->aid;
+        mm_obj_msg (self, "PDN aid %u connected on %s", ctx->aid, mm_port_get_device (ctx->data));
+        g_task_return_pointer (task,
+                               mm_bearer_connect_result_new (ctx->data, ctx->ipv4_config, ctx->ipv6_config),
+                               (GDestroyNotify) mm_bearer_connect_result_unref);
+        g_object_unref (task);
+        return;
+    }
+
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+static void
+connect_3gpp (MMBroadbandBearer   *self,
+              MMBroadbandModem    *modem,
+              MMPortSerialAt      *primary,
+              MMPortSerialAt      *secondary,
+              GCancellable        *cancellable,
+              GAsyncReadyCallback  callback,
+              gpointer             user_data)
+{
+    ConnectContext *ctx;
+    GTask          *task;
+    const gchar    *apn;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+
+    apn = mm_bearer_properties_get_apn (mm_base_bearer_peek_config (MM_BASE_BEARER (self)));
+    if (!apn || !apn[0]) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "an APN is required");
+        g_object_unref (task);
+        return;
+    }
+
+    if (!mm_base_modem_peek_best_data_port (MM_BASE_MODEM (modem), MM_PORT_TYPE_NET)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_CONNECTED,
+                                 "couldn't connect: no net port available");
+        g_object_unref (task);
+        return;
+    }
+
+    ctx = g_slice_new0 (ConnectContext);
+    ctx->modem = MM_BASE_MODEM (g_object_ref (modem));
+    ctx->primary = g_object_ref (primary);
+    ctx->step = CONNECT_STEP_FIRST;
+    ctx->apn = g_strdup (apn);
+    ctx->ifid = -1;
+    ctx->stale_aid = UNKNOWN_AID;
+    ctx->aid = UNKNOWN_AID;
+    ctx->dns4 = g_ptr_array_new_with_free_func (g_free);
+    ctx->dns6 = g_ptr_array_new_with_free_func (g_free);
+
+    g_task_set_task_data (task, ctx, (GDestroyNotify) connect_context_free);
+    connect_step (task);
+}
+
+/*****************************************************************************/
+/* 3GPP Disconnect sequence */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+eapnact_deactivate_ready (MMBaseModem  *modem,
+                          GAsyncResult *res,
+                          GTask        *task)
+{
+    MMBroadbandBearerMtkCcci *self;
+    GError                   *error = NULL;
+
+    self = g_task_get_source_object (task);
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    self->priv->aid = UNKNOWN_AID;
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *_self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    MMBroadbandBearerMtkCcci *self = MM_BROADBAND_BEARER_MTK_CCCI (_self);
+    g_autofree gchar         *command = NULL;
+    GTask                    *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (self->priv->aid == UNKNOWN_AID) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
+    command = g_strdup_printf ("+EAPNACT=0,%u,0", self->priv->aid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   command,
+                                   MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
+                                   FALSE, FALSE,
+                                   NULL,
+                                   (GAsyncReadyCallback) eapnact_deactivate_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* Connection status monitoring */
+
+static MMBearerConnectionStatus
+load_connection_status_finish (MMBaseBearer  *self,
+                               GAsyncResult  *res,
+                               GError       **error)
+{
+    GError *inner_error = NULL;
+    gssize  value;
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return MM_BEARER_CONNECTION_STATUS_UNKNOWN;
+    }
+    return (MMBearerConnectionStatus) value;
+}
+
+static void
+cgact_query_ready (MMBaseModem  *modem,
+                   GAsyncResult *res,
+                   GTask        *task)
+{
+    MMBroadbandBearerMtkCcci *self;
+    const gchar              *response;
+    GError                   *error = NULL;
+    GList                    *list = NULL;
+    GList                    *l;
+    MMBearerConnectionStatus  status = MM_BEARER_CONNECTION_STATUS_DISCONNECTED;
+
+    self = g_task_get_source_object (task);
+
+    response = mm_base_modem_at_command_finish (modem, res, &error);
+    if (response)
+        list = mm_3gpp_parse_cgact_read_response (response, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    for (l = list; l; l = g_list_next (l)) {
+        MM3gppPdpContextActive *pdp = l->data;
+
+        if (pdp->cid == self->priv->aid && pdp->active) {
+            status = MM_BEARER_CONNECTION_STATUS_CONNECTED;
+            break;
+        }
+    }
+    mm_3gpp_pdp_context_active_list_free (list);
+
+    g_task_return_int (task, (gssize) status);
+    g_object_unref (task);
+}
+
+static void
+load_connection_status (MMBaseBearer        *_self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    MMBroadbandBearerMtkCcci *self = MM_BROADBAND_BEARER_MTK_CCCI (_self);
+    g_autoptr(MMBaseModem)    modem = NULL;
+    MMIfacePortAt            *port;
+    GTask                    *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (self->priv->aid == UNKNOWN_AID) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "couldn't load connection status: no active PDN");
+        g_object_unref (task);
+        return;
+    }
+
+    g_object_get (self, MM_BASE_BEARER_MODEM, &modem, NULL);
+    port = mm_base_modem_peek_best_at_port (modem, NULL);
+    if (!port) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                                 "couldn't load connection status: no control port available");
+        g_object_unref (task);
+        return;
+    }
+
+    mm_base_modem_at_command_full (modem,
+                                   port,
+                                   "+CGACT?",
+                                   3,
+                                   FALSE, FALSE,
+                                   NULL,
+                                   (GAsyncReadyCallback) cgact_query_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+
+static void
+report_connection_status (MMBaseBearer             *self,
+                          MMBearerConnectionStatus  status,
+                          const GError             *connection_error)
+{
+    if (status == MM_BEARER_CONNECTION_STATUS_DISCONNECTED)
+        MM_BROADBAND_BEARER_MTK_CCCI (self)->priv->aid = UNKNOWN_AID;
+
+    MM_BASE_BEARER_CLASS (mm_broadband_bearer_mtk_ccci_parent_class)->report_connection_status (
+        self, status, connection_error);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_mtk_ccci_new_finish (GAsyncResult  *res,
+                                         GError       **error)
+{
+    GObject *bearer;
+    GObject *source;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    /* Only export valid bearers */
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_mtk_ccci_new (MMBroadbandModemMtkCcci *modem,
+                                  MMBearerProperties      *config,
+                                  GCancellable            *cancellable,
+                                  GAsyncReadyCallback      callback,
+                                  gpointer                 user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_MTK_CCCI,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM,  modem,
+        MM_BIND_TO,            G_OBJECT (modem),
+        MM_BASE_BEARER_CONFIG, config,
+        NULL);
+}
+
+static void
+mm_broadband_bearer_mtk_ccci_init (MMBroadbandBearerMtkCcci *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self,
+                                              MM_TYPE_BROADBAND_BEARER_MTK_CCCI,
+                                              MMBroadbandBearerMtkCcciPrivate);
+    self->priv->aid = UNKNOWN_AID;
+}
+
+static void
+mm_broadband_bearer_mtk_ccci_class_init (MMBroadbandBearerMtkCcciClass *klass)
+{
+    GObjectClass           *object_class           = G_OBJECT_CLASS (klass);
+    MMBaseBearerClass      *base_bearer_class      = MM_BASE_BEARER_CLASS (klass);
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMBroadbandBearerMtkCcciPrivate));
+
+    base_bearer_class->load_connection_status = load_connection_status;
+    base_bearer_class->load_connection_status_finish = load_connection_status_finish;
+    base_bearer_class->report_connection_status = report_connection_status;
+#if defined WITH_SUSPEND_RESUME
+    base_bearer_class->reload_connection_status = load_connection_status;
+    base_bearer_class->reload_connection_status_finish = load_connection_status_finish;
+#endif
+
+    broadband_bearer_class->connect_3gpp = connect_3gpp;
+    broadband_bearer_class->connect_3gpp_finish = connect_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish = disconnect_3gpp_finish;
+}
