new file mode 100644
index 0000000..148b7ab
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-broadband-bearer-mtk-ccci.c
@@ -0,0 +1,875 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
