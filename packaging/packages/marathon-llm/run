#!/bin/sh
# Pilot's model server: llama-server on 127.0.0.1:8088, OpenAI-compatible.
# The model, Qwen3.5-2B (Apache-2.0) quantised by bartowski with llama.cpp,
# downloads on first start and is checked against its sha256.
set -eu

MODEL=Qwen_Qwen3.5-2B-Q4_K_M.gguf
URL=https://huggingface.co/bartowski/Qwen_Qwen3.5-2B-GGUF/resolve/main/$MODEL
SHA256=57a1085840f497d764a7fc5d346922dbde961efb54cc792ea81d694fd846a1d8
DIR="${XDG_DATA_HOME:-$HOME/.local/share}/marathon-llm"

mkdir -p "$DIR"
if [ ! -f "$DIR/$MODEL" ]; then
	wget -q -c -O "$DIR/$MODEL.part" "$URL"
	[ "$(sha256sum "$DIR/$MODEL.part" | cut -d' ' -f1)" = "$SHA256" ] || {
		rm -f "$DIR/$MODEL.part"
		echo "marathon-llm: $MODEL failed its checksum" >&2
		exit 1
	}
	mv "$DIR/$MODEL.part" "$DIR/$MODEL"
fi

exec llama-server --host 127.0.0.1 --port 8088 --model "$DIR/$MODEL" --alias qwen3.5-2b \
	--jinja --reasoning off --threads 4 --ctx-size 8192 --parallel 1 --flash-attn on \
	--cache-reuse 256 --no-webui
