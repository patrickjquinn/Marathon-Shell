#!/bin/sh
# Pilot's on-device models, each llama-server on a private port behind a
# socket-activated proxy that exits when idle (marathon-llm*.socket):
#   run chat    the model for tool calls and writing. With 8 GB of RAM,
#               dot-product instructions and marathon-llm-runtime: LFM2.5
#               1.2B Instruct (LFM Open License 1.0), Liquid's
#               quantization-aware Q4_0, on that package's llama-server. On
#               the Q25 it reads prompts at 95 tokens/s and writes at 17.7,
#               against Qwen3.5 2B's 50 and 12.5. Otherwise, or
#               with a file named legacy in the model directory: Qwen3 1.7B,
#               else 0.6B under 8 GB (bartowski's Q4_0 quants), on Alpine's
#               llama-server.
#               Flash attention off: on the Q25's CPU it made each token 2.8x
#               slower with Pilot's 2K-token prompt (llama-bench, tg32 @ d2048).
#               Prompts are read on every core, written on four.
#               Read 512 tokens a batch: Pilot shows how far it has read
#               after each (return_progress), and the CPU computes 512 at a
#               time anyway.
#   run embed   multilingual-e5-small (MIT), which picks the tools
#   run wait P  until the server on port P answers
#   run models  the files this phone needs, "PATH BYTES" a line
#   run download  fetches them, each checked against its sha256
# Nothing downloads on first use: pilotd runs `download` when the person
# asks, on an unmetered network with room for them.
set -eu

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/marathon-llm"

EMBED=multilingual-e5-small-xlmr-q8_0.gguf
EMBED_BYTES=132440608

PILOT_SERVER=/usr/libexec/marathon-llm/llama-server-pilot

# Each model samples as its card says; Pilot sends no sampling to the
# model on the phone. Qwen's, without reasoning: 0.7 / 0.8 / top-k 20.
QWEN_SAMPLING="--temp 0.7 --top-p 0.8 --top-k 20 --min-p 0"

chat_model() {
	sampling=$QWEN_SAMPLING
	big=$([ "$(awk '/^MemTotal/ { print $2 }' /proc/meminfo)" -ge 7500000 ] && echo 1 || true)
	if [ -n "$big" ] && [ -x "$PILOT_SERVER" ] && [ ! -e "$DIR/legacy" ] &&
		grep -q asimddp /proc/cpuinfo; then
		model=LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf family=LFM2.5-
		sha=bb741ebb106d543e9de114b843a3d3d73d51c74b5801e69da2abde821a0cb3e1
		bytes=695755488
		url=https://huggingface.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF/resolve/8ed288026e23958ad9dfa92d53ed773a8eee7125/$model
		url_sha=$sha
		server=$PILOT_SERVER
		# The model card's.
		sampling="--temp 0.1 --top-k 50 --repeat-penalty 1.05"
		return
	fi
	if [ -n "$big" ]; then
		size=1.7B sha=c470091d31c4ada174ee5c2547daa020e930593cbca5ca8ca385ce8ff59a2fdf
		bytes=1231813024
	else
		size=0.6B sha=4b78d8e3c61976cebb78ef5affe19d0eca75b1b47ec66f613a5a3245484758d5
		bytes=469671328
	fi
	model=Qwen_Qwen3-$size-Q4_0.gguf family=Qwen_Qwen3-
	url=https://huggingface.co/bartowski/Qwen_Qwen3-$size-GGUF/resolve/main/$model
	url_sha=$sha server=llama-server
}

fetch() { # file url sha256
	if [ -f "$DIR/$1" ]; then
		# A file already here counts only with the same checksum.
		[ "$(sha256sum "$DIR/$1" | cut -d' ' -f1)" = "$3" ] && return
		echo "marathon-llm: $1 failed its checksum; fetching it again" >&2
		rm -f "$DIR/$1"
	fi
	mkdir -p "$DIR"
	wget -q -c -O "$DIR/$1.part" "$2"
	[ "$(sha256sum "$DIR/$1.part" | cut -d' ' -f1)" = "$3" ] || {
		rm -f "$DIR/$1.part"
		echo "marathon-llm: $1 failed its checksum" >&2
		exit 1
	}
	mv "$DIR/$1.part" "$DIR/$1"
}

# fetch, for a model whose head is cut here: downloaded to file.part (so
# its progress shows), cut to Pilot's head, and checked again.
fetch_cut() { # file url url_sha256 sha256
	[ -f "$DIR/$1" ] && [ "$(sha256sum "$DIR/$1" | cut -d' ' -f1)" = "$4" ] && return
	rm -f "$DIR/$1"
	mkdir -p "$DIR"
	wget -q -c -O "$DIR/$1.part" "$2"
	[ "$(sha256sum "$DIR/$1.part" | cut -d' ' -f1)" = "$3" ] || {
		rm -f "$DIR/$1.part"
		echo "marathon-llm: $1's download failed its checksum" >&2
		exit 1
	}
	/usr/libexec/marathon-llm/gguf_recut "$DIR/$1.part" "$DIR/$1.cut" \
		/usr/share/marathon-llm/head-ids-pilot.txt >/dev/null
	rm -f "$DIR/$1.part"
	[ "$(sha256sum "$DIR/$1.cut" | cut -d' ' -f1)" = "$4" ] || {
		rm -f "$DIR/$1.cut"
		echo "marathon-llm: $1 failed its checksum once cut" >&2
		exit 1
	}
	mv "$DIR/$1.cut" "$DIR/$1"
}

need() { # file
	[ -f "$DIR/$1" ] || {
		echo "marathon-llm: $1 is not downloaded (run download)" >&2
		exit 1
	}
}

case "${1:-}" in
chat)
	chat_model
	need "$model"
	# Qwen3.5's hybrid state is kept by context checkpoints, not by
	# --cache-reuse, which it does not support.
	# A checkpoint at every user message: the pilot server's model is a
	# hybrid, which goes back only to one, and the next question leaves
	# the last prompt at its own message.
	# Four slots on the pilot server, 8,192 tokens each (~100 MB of cache
	# each for LFM2.5): Pilot's prompt with its tools, the one without (a
	# question answered from knowledge) and the short ones for a single
	# action, each kept read instead of evicting another.
	# A prompt goes to a slot only if half of it is already there: at
	# llama-server's 0.1 the one with tools (0.102 like the other) took
	# the plain one's slot.
	if [ "$server" = llama-server ]; then
		reuse="--cache-reuse 256 --ctx-size 8192 --parallel 1"
	else
		reuse="--checkpoint-min-step 0 --ctx-size 32768 --parallel 4 --slot-prompt-similarity 0.5"
	fi
	# shellcheck disable=SC2086
	exec "$server" --host 127.0.0.1 --port 8090 --model "$DIR/$model" --alias qwen3 \
		--jinja --reasoning off --threads 4 --threads-batch "$(nproc)" \
		--batch-size 512 --flash-attn off $sampling $reuse --no-webui
	;;
embed)
	need "$EMBED"
	exec llama-server --host 127.0.0.1 --port 8091 --model "$DIR/$EMBED" --alias e5-small \
		--embedding --pooling mean --threads 2 --ctx-size 512 --batch-size 512 --ubatch-size 512 \
		--parallel 1 --no-webui
	;;
models)
	chat_model
	echo "$DIR/$model $bytes"
	echo "$DIR/$EMBED $EMBED_BYTES"
	;;
download)
	chat_model
	if [ "$url_sha" != "$sha" ]; then
		fetch_cut "$model" "$url" "$url_sha" "$sha"
	else
		fetch "$model" "$url" "$sha"
	fi
	# Other sizes of the same model go, and Qwen3.5 2B, which LFM2.5
	# replaced; Qwen3 stays, for the fallback (legacy) to start at once.
	for old in "$DIR/$family"*.gguf "$DIR"/Qwen3.5-*.gguf; do
		[ "$old" = "$DIR/$model" ] || rm -f "$old"
	done
	# convert-e5.py's conversion, with the model's own XLM-R vocabulary: the
	# published GGUFs embedded every sentence alike.
	fetch "$EMBED" "https://github.com/patrickjquinn/Marathon-Shell/releases/download/marathon-llm-models-1/$EMBED" \
		37f2924392582027abaf43a0b2cc82726a1a3dae3da610f67ae61e89e3a4af54
	rm -f "$DIR/multilingual-e5-small-Q8_0.gguf"
	;;
wait)
	until wget -q -O /dev/null "http://127.0.0.1:$2/health"; do sleep 0.3; done
	;;
*)
	echo "usage: run chat|embed|models|download|wait PORT" >&2
	exit 2
	;;
esac
