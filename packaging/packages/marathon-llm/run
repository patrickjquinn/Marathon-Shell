#!/bin/sh
# Pilot's on-device models, each llama-server on a private port behind a
# socket-activated proxy that exits when idle (marathon-llm*.socket):
#   run chat    Qwen3 for tool calls and writing: 1.7B with 8 GB of RAM or
#               more, else 0.6B (Apache-2.0, bartowski's llama.cpp quants).
#               Q4_0, which llama.cpp repacks for Arm's dot-product kernels:
#               on the CM5 twice Q4_K_M's prompt speed.
#               A plain transformer, so the prompt cache holds across turns
#               (llama.cpp cannot reuse Qwen3.5's hybrid state).
#   run embed   multilingual-e5-small (MIT), which picks the tools
#   run wait P  until the server on port P answers
# A model downloads on first use and is checked against its sha256.
set -eu

DIR="${XDG_DATA_HOME:-$HOME/.local/share}/marathon-llm"

fetch() { # file url sha256
	[ -f "$DIR/$1" ] && return
	mkdir -p "$DIR"
	wget -q -c -O "$DIR/$1.part" "$2"
	[ "$(sha256sum "$DIR/$1.part" | cut -d' ' -f1)" = "$3" ] || {
		rm -f "$DIR/$1.part"
		echo "marathon-llm: $1 failed its checksum" >&2
		exit 1
	}
	mv "$DIR/$1.part" "$DIR/$1"
}

case "${1:-}" in
chat)
	if [ "$(awk '/^MemTotal/ { print $2 }' /proc/meminfo)" -ge 7500000 ]; then
		size=1.7B sha=c470091d31c4ada174ee5c2547daa020e930593cbca5ca8ca385ce8ff59a2fdf
	else
		size=0.6B sha=4b78d8e3c61976cebb78ef5affe19d0eca75b1b47ec66f613a5a3245484758d5
	fi
	model=Qwen_Qwen3-$size-Q4_0.gguf
	fetch "$model" "https://huggingface.co/bartowski/Qwen_Qwen3-$size-GGUF/resolve/main/$model" "$sha"
	for old in "$DIR"/Qwen_Qwen3-*.gguf; do
		[ "$old" = "$DIR/$model" ] || rm -f "$old"
	done
	exec llama-server --host 127.0.0.1 --port 8090 --model "$DIR/$model" --alias qwen3 \
		--jinja --reasoning off --threads 4 --ctx-size 8192 --parallel 1 --flash-attn on \
		--cache-reuse 256 --no-webui
	;;
embed)
	# convert-e5.py's conversion, with the model's own XLM-R vocabulary: the
	# published GGUFs embedded every sentence alike.
	model=multilingual-e5-small-xlmr-q8_0.gguf
	fetch "$model" "https://github.com/patrickjquinn/Marathon-Shell/releases/download/marathon-llm-models-1/$model" \
		37f2924392582027abaf43a0b2cc82726a1a3dae3da610f67ae61e89e3a4af54
	rm -f "$DIR/multilingual-e5-small-Q8_0.gguf"
	exec llama-server --host 127.0.0.1 --port 8091 --model "$DIR/$model" --alias e5-small \
		--embedding --pooling mean --threads 2 --ctx-size 512 --batch-size 512 --ubatch-size 512 \
		--parallel 1 --no-webui
	;;
wait)
	until wget -q -O /dev/null "http://127.0.0.1:$2/health"; do sleep 0.3; done
	;;
*)
	echo "usage: run chat|embed|wait PORT" >&2
	exit 2
	;;
esac
