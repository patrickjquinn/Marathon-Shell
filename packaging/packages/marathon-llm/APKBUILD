# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# Pilot's on-device models for pilotd's local mode, llama.cpp's
# llama-server (Alpine's), each started on first use and stopped when idle:
# Qwen3 (1.7B with 8 GB of RAM, else 0.6B) on 127.0.0.1:8088,
# OpenAI-compatible, and multilingual-e5-small embeddings on :8087, which
# pick the tools the model sees. Models download to
# ~/.local/share/marathon-llm on first use.
pkgname=marathon-llm
pkgver=0.1.0
pkgrel=2
pkgdesc="On-device language model server for Pilot"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="noarch"
license="Apache-2.0"
depends="llama-server wget"
_units="
	marathon-llm-chat.socket
	marathon-llm-chat-proxy.service
	marathon-llm-chat.service
	marathon-llm-embed.socket
	marathon-llm-embed-proxy.service
	marathon-llm-embed.service
	"
source="run $_units"
options="!check"

package() {
	install -Dm755 "$srcdir"/run "$pkgdir"/usr/libexec/marathon-llm/run
	local u
	for u in $_units; do
		install -Dm644 "$srcdir"/$u "$pkgdir"/usr/lib/systemd/user/$u
	done
	install -d "$pkgdir"/usr/lib/systemd/user/sockets.target.wants
	for u in chat embed; do
		ln -s ../marathon-llm-$u.socket \
			"$pkgdir"/usr/lib/systemd/user/sockets.target.wants/marathon-llm-$u.socket
	done
}

