[Unit]
Description=Pilot's on-device language model, started on first use
# The phone's user only: another user's manager (root's, over ssh) would
# find the port taken and log the socket as failed.
ConditionUser=!@system

[Socket]
ListenStream=127.0.0.1:8088
Service=marathon-llm-chat-proxy.service

[Install]
WantedBy=sockets.target
