[Unit]
Description=Pilot's on-device language model (llama.cpp)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server
# Gone once its proxy has been idle.
StopWhenUnneeded=yes
# Not downloaded yet (pilotd's DownloadModels): skipped, not failed, so a
# question gets a refused connection at once and no start limit is hit.
# Any chat model run chat may pick (run models).
ConditionPathExistsGlob=|%h/.local/share/marathon-llm/Qwen_Qwen3-*-Q4_0.gguf
ConditionPathExistsGlob=|%h/.local/share/marathon-llm/LFM2.5-*.gguf

[Service]
ExecStart=/usr/libexec/marathon-llm/run chat
ExecStartPost=/usr/libexec/marathon-llm/run wait 8090
# A phone reads a 1 GB model slowly.
TimeoutStartSec=infinity
# Behind the shell and the app in front, ahead of frozen apps under OOM.
Nice=5
CPUWeight=50
IOSchedulingClass=idle
OOMScoreAdjust=300
