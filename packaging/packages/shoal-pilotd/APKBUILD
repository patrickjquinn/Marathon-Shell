# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# pilotd, the session service of Pilot, Marathon's assistant (crates/pilotd).
# scripts/qemu/lib/build-pilot-apk.sh stages this repository's tree as the
# source tarball, so the URL below is fetched only by a standalone abuild,
# and it follows a branch.
#
# With org.marathonos.Shell on the bus pilotd uses the shell's services
# (clock, calendar, contacts, phone, radios); the shell admits it by its unit
# and executable (shoal-pilotd.service.json, installed to
# /usr/share/marathon-shell/services) with the permissions listed there.
# pilotd.toml (/etc/shoal-pilot) turns on local mode: the model is
# llama-server on the phone (marathon-llm), tools picked by an embedding
# model, web search on the phone (marathon-websearch). Speech (pilot-voice,
# pilot-tts) is not built.
pkgname=shoal-pilotd
pkgver=0.1.0
pkgrel=13
pkgdesc="Pilot assistant daemon for Marathon"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64 x86_64"
license="Apache-2.0"
depends="dbus systemd"
makedepends="cargo clang"
source="$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz"
builddir="$srcdir/Marathon-Shell-main"
# The tests need a session bus (dbus-daemon); they run on the build host.
options="!check net"

build() {
	cargo build --manifest-path crates/Cargo.toml --profile release-unwind --locked -p pilotd
}

package() {
	local d=crates/pilotd/data
	install -Dm755 crates/target/release-unwind/pilotd "$pkgdir"/usr/bin/pilotd
	install -Dm644 $d/shoal-pilotd.service "$pkgdir"/usr/lib/systemd/user/shoal-pilotd.service
	install -Dm644 $d/org.shipwright.Pilot.service \
		"$pkgdir"/usr/share/dbus-1/services/org.shipwright.Pilot.service
	install -Dm644 $d/pilotd.toml "$pkgdir"/etc/shoal-pilot/pilotd.toml
	install -Dm755 $d/marathon-open "$pkgdir"/usr/libexec/shoal-pilot/marathon-open
	install -Dm644 $d/shoal-pilotd.service.json \
		"$pkgdir"/usr/share/marathon-shell/services/shoal-pilotd.service.json
	install -Dm644 crates/pilotd/pilotd.example.toml \
		"$pkgdir"/usr/share/doc/shoal-pilot/pilotd.example.toml
	install -Dm644 apps/pilot/README.md "$pkgdir"/usr/share/doc/shoal-pilot/README.md
}

sha512sums="
SKIP  shoal-pilotd-0.1.0.tar.gz
"
