diff --git a/shoal/pilot/pilotd/src/jev.rs b/shoal/pilot/pilotd/src/jev.rs
index 8154d1d..7e88792 100644
--- a/shoal/pilot/pilotd/src/jev.rs
+++ b/shoal/pilot/pilotd/src/jev.rs
@@ -270,6 +270,222 @@ impl JevClient for HttpJev {
