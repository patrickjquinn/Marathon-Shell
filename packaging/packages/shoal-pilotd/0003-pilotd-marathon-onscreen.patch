 shoal/pilot/pilotd/src/dbus.rs              |  8 ++-
 shoal/pilot/pilotd/tests/marathon.rs        | 69 +++++++++++++++++++++
 3 files changed, 99 insertions(+), 2 deletions(-)

diff --git a/shoal/pilot/pilotd/src/adapters/marathon.rs b/shoal/pilot/pilotd/src/adapters/marathon.rs
index 7383214..66ac974 100644
--- a/shoal/pilot/pilotd/src/adapters/marathon.rs
+++ b/shoal/pilot/pilotd/src/adapters/marathon.rs
@@ -33,6 +33,30 @@ pub fn present(session: &zbus::Connection) -> bool {
     .unwrap_or(false)
 }
 
+/// The Keel app (`org.marathonos.<id>`) of a Marathon app's process, a
+/// `marathon-app-runner`. It has no desktop entry to match, and a pooled
+/// runner's command line names no app: the shell says which it is.
+pub async fn app_for_pid(session: &zbus::Connection, pid: u32) -> Option<crate::onscreen::App> {
+    let cmdline = std::fs::read(format!("/proc/{pid}/cmdline")).ok()?;
+    let argv0 = cmdline.split(|b| *b == 0).next()?;
+    if argv0 != b"marathon-app-runner" && !argv0.ends_with(b"/marathon-app-runner") {
+        return None;
+    }
+    let id: String = call(session, "Navigation", "AppIdForPid", &(pid,))
+        .await
+        .map_err(|e| log::info!("app of pid {pid}: {e}"))
+        .ok()?;
+    if id.is_empty() {
+        return None;
+    }
+    let id = format!("org.marathonos.{id}");
+    Some(crate::onscreen::App {
+        name: crate::onscreen::app_name(&id).unwrap_or_default(),
+        comment: crate::onscreen::app_comment(&id).unwrap_or_default(),
+        id,
+    })
+}
