# What every MediaTek Helio G99 (MT6789) phone runs above its kernel: the
# CONNSYS (WMT) bring-up and its Wi-Fi, Bluetooth and FM services, Panfrost's
# runtime PM and the MT6366 codec's module. Firmware, kernels, display,
# input, audio routes and power policy are the boards' (device-*-marathon).
pkgname=mt6789-platform
pkgver=1.0.0
pkgrel=0
pkgdesc="MediaTek MT6789 shared CONNSYS, GPU and codec services"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0 AND MIT"
options="!check"
depends="wpa_supplicant wpa_supplicant-systemd bluez-btmgmt"
makedepends="gcc musl-dev"
source="mt6789-wmt.c mt6789-connsys.service mt6789-wmt-launcher.service mt6789-wifi.service
 mt6789-wifi.system-sleep 50-mt6789-wpa_supplicant.conf mt6789-wlan.modprobe.conf mt6789-wifi-mac.nm.conf
 mt6789-bluetooth.service mt6789-bt-address mt6789-bt-address.service mt6789-fm.service 62-mt6789-fm.rules
 61-mt6789-gpu-autosuspend.rules mt6789-audio.modules-load.conf"
build() {
    mkdir -p "$builddir"
    ${CC:-gcc} $CFLAGS -Wall -Wextra -o "$builddir/mt6789-wmt" "$srcdir/mt6789-wmt.c" $LDFLAGS
}
package() {
    # Wi-Fi: CONNSYS bring-up, the WMT firmware patch server, then WLAN power.
    install -Dm755 "$builddir/mt6789-wmt" "$pkgdir/usr/libexec/marathon/mt6789-wmt"
    local unit
    for unit in mt6789-connsys mt6789-wmt-launcher mt6789-wifi mt6789-bluetooth mt6789-bt-address mt6789-fm; do
        install -Dm644 "$srcdir/$unit.service" "$pkgdir/usr/lib/systemd/system/$unit.service"
    done
    install -Dm755 "$srcdir/mt6789-wifi.system-sleep" "$pkgdir/usr/lib/systemd/system-sleep/mt6789-wifi"
    # wpa_cli and mt6789-wifi need the control socket; log to syslog.
    install -Dm644 "$srcdir/50-mt6789-wpa_supplicant.conf" "$pkgdir/usr/lib/systemd/system/wpa_supplicant.service.d/50-mt6789.conf"
    install -Dm644 "$srcdir/mt6789-wlan.modprobe.conf" "$pkgdir/usr/lib/modprobe.d/mt6789-wlan.conf"
    install -Dm644 "$srcdir/mt6789-wifi-mac.nm.conf" "$pkgdir/usr/lib/NetworkManager/conf.d/50-mt6789-wifi-mac.conf"

    # Bluetooth: the HCI driver over WMT/STP, once the patch server runs.
    install -Dm755 "$srcdir/mt6789-bt-address" "$pkgdir/usr/libexec/marathon/mt6789-bt-address"

    install -Dm644 "$srcdir/62-mt6789-fm.rules" "$pkgdir/usr/lib/udev/rules.d/62-mt6789-fm.rules"
    install -Dm644 "$srcdir/61-mt6789-gpu-autosuspend.rules" "$pkgdir/usr/lib/udev/rules.d/61-mt6789-gpu-autosuspend.rules"
    install -Dm644 "$srcdir/mt6789-audio.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/mt6789-audio.conf"

    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" "$pkgdir/usr/lib/systemd/system/bluetooth.target.wants"
    for unit in mt6789-connsys mt6789-wmt-launcher mt6789-wifi mt6789-bluetooth mt6789-bt-address mt6789-fm; do
        ln -s ../$unit.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/$unit.service"
    done
    for unit in mt6789-bluetooth mt6789-bt-address; do
        ln -s ../$unit.service "$pkgdir/usr/lib/systemd/system/bluetooth.target.wants/$unit.service"
    done
}
