[Unit]
Description=MT6789 Wi-Fi power (gen4m over WMT)
Requires=mt6789-wmt-launcher.service
After=mt6789-wmt-launcher.service
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/modprobe wlan_drv_gen4m_6789
ExecStart=/usr/libexec/marathon/mt6789-wmt wifi-on
ExecStop=/usr/libexec/marathon/mt6789-wmt wifi-off
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
