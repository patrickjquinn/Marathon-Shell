# Marathon fork of pmaports' pinephone-callaudiod. Same source; 0001 waits
# for the card's source after a profile switch, which PipeWire creates
# asynchronously: upstream took the first source at once, found none, and
# failed the first switch into call mode with StopIteration. Drop this fork
# when upstream fixes it.
maintainer="Patrick Quinn <patrick@jquinn.com>"
_pkgname=pinephone-callaudiod
pkgname=$_pkgname-marathon
pkgver=0.1.3
pkgrel=0
pkgdesc="Call audio routing daemon — Marathon fork that waits for the call source"
url="https://github.com/Arnavion/pinephone-callaudiod"
arch="noarch"
license="AGPL-3.0-only"
makedepends="make"
depends="
	python3
	py3-dasbus
	cmd:amixer
	cmd:pactl
	"
# r99 outranks pmaports' own pkgrel bumps of the same pkgver.
provides="$_pkgname=$pkgver-r99 callaudiod=$pkgver-r99"
replaces="$_pkgname"
provider_priority=200
source="
	$_pkgname-$pkgver.tar.gz::https://github.com/Arnavion/pinephone-callaudiod/archive/v$pkgver.tar.gz
	0001-wait-for-source-after-profile-switch.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"
# no tests
options="!check"

build() {
	return 0
}

package() {
	make DESTDIR="$pkgdir" prefix=/usr libexecdir=/usr/lib install
}

sha512sums="
ae70947ebb52849b0e5429d0740240986b832975e470bbbe7122c3be5eb25df6b725e44c50cfd33a239219172b9dc344f457e298dec9531791728ff33cf769ee  pinephone-callaudiod-0.1.3.tar.gz
872e880f9dc2a70acbd7b8fab027177dfbe437e78ae4dad1e092fb858bba86d38135932da197b4bed40889e189b6086b044ade54b22b18baaab352db320bdb48  0001-wait-for-source-after-profile-switch.patch
"
