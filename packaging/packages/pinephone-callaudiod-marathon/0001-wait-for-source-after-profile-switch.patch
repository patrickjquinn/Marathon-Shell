+	@staticmethod
+	def profile_source(profile: str) -> str:
+		# A profile switch recreates the card's nodes asynchronously: wait for
+		# the source of the profile just selected, not whichever is listed.
+		tag = '.' + profile.replace(' ', '_') + '__'
+		for _ in range(50):
+			source = next((s for s in Pactl.list_sources() if tag in s), None)
+			if source is not None:
+				return source
+			time.sleep(0.1)
+		raise RuntimeError(f'no {profile} source after switching profile')
