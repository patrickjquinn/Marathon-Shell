 WTF_MAKE_TZONE_ALLOCATED_IMPL(CachedPage);
 
+// Pacific (patch 0013): the HttpOnly cookies sent with requests for `url`,
+// as the network process has them (the ones a log-in or log-out changes;
+// pages' own scripts cannot set or see them, so analytics do not count).
+static String httpOnlyCookies(Page& page, Document& document, const URL& url)
+{
+    Vector<Cookie> cookies;
+    if (!page.cookieJar().getRawCookies(document, url, cookies))
+        return "unavailable"_s;
+    Vector<String> lines;
+    for (auto& cookie : cookies) {
+        if (cookie.httpOnly)
+            lines.append(makeString(cookie.domain, ' ', cookie.path, ' ', cookie.name, '=', cookie.value));
+    }
+    std::ranges::sort(lines, codePointCompareLessThan);
+    StringBuilder builder;
+    for (auto& line : lines) {
+        builder.append(line);
+        builder.append('\n');
+    }
+    return builder.toString();
+}
+
 CachedPage::CachedPage(Page& page)
     : m_page(page)
     , m_expirationTime(MonotonicTime::now() + page.settings().backForwardCacheExpirationInterval())
+    , m_noStore([&] {
+        RefPtr frame = page.localMainFrame();
+        RefPtr loader = frame ? frame->loader().documentLoader() : nullptr;
+        return loader && loader->response().cacheControlContainsNoStore();
+    }())
+    , m_noStoreURL([&] {
+        RefPtr frame = page.localMainFrame();
+        return m_noStore && frame && frame->document() ? frame->document()->url() : URL();
+    }())
+    , m_noStoreCookies([&] {
+        RefPtr frame = page.localMainFrame();
+        RefPtr document = frame ? frame->document() : nullptr;
+        return m_noStore && document ? httpOnlyCookies(page, *document, m_noStoreURL) : String();
+    }())
     , m_cachedMainFrame(makeUnique<CachedFrame>(protect(page.mainFrame())))
     , m_loadedSubresourceDomains([&] {
         RefPtr localFrame = page.localMainFrame();
@@ -235,7 +275,20 @@
 
 bool CachedPage::hasExpired() const
 {
-    return MonotonicTime::now() > m_expirationTime;
+    if (MonotonicTime::now() > m_expirationTime)
+        return true;
+    if (!m_noStore)
+        return false;
+    // Pacific (patch 0013), Chrome's rules for no-store pages: three
+    // minutes, and not if the site's HttpOnly cookies changed meanwhile.
+    // Asked through the page's current document (the cached one has no
+    // frame); a cross-site one may see other cookies, so the page is
+    // dropped, the safe way.
+    if (MonotonicTime::now() > m_expirationTime - m_page->settings().backForwardCacheExpirationInterval() + 3_min)
+        return true;
+    RefPtr frame = m_page->localMainFrame();
+    RefPtr document = frame ? frame->document() : nullptr;
+    return !document || httpOnlyCookies(m_page.get(), *document, m_noStoreURL) != m_noStoreCookies;
 }
 
