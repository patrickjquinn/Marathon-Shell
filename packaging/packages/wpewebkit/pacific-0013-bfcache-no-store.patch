#
# Back is instant on pages that say Cache-Control: no-store.
#
# WebKit never keeps an HTTPS no-store page in the back/forward cache, and
# most news sites send it (The Verge, OSNews). Back reloaded the page from
# the network: on the Jolla Phone the old page stayed on screen for about
# 2.5 s while the back button had already gone, and people took the button
# for broken. Chrome caches these pages since 2025 under conditions that
# keep a logged-out page from coming back; this does the same. A no-store
# page is restored only within three minutes and only if the HttpOnly
# cookies its URL would be sent are unchanged (sessions live in those;
# pages' scripts cannot set them, so analytics cookies do not count).
# PACIFIC_BFCACHE_NO_STORE=0 keeps WebKit's refusal.
#
--- a/Source/WebCore/history/BackForwardCache.cpp
+++ b/Source/WebCore/history/BackForwardCache.cpp
@@ -26,6 +26,9 @@
 #include "config.h"
 #include "BackForwardCache.h"
 
+#include <cstdlib>
+#include <cstring>
+
 #include "BackForwardController.h"
 #include "CachedPage.h"
 #include "DeviceMotionController.h"
@@ -153,7 +156,15 @@
         logBackForwardCacheFailureDiagnosticMessage(diagnosticLoggingClient, DiagnosticLoggingKeys::isErrorPageKey());
         isCacheable = false;
     }
-    if (frame.isMainFrame() && document && document->url().protocolIs("https"_s) && documentLoader->response().cacheControlContainsNoStore()) {
+    // Pacific (patch 0013): pages that say no-store are cached too, as
+    // Chrome does since 2025, under its conditions: CachedPage gives them
+    // three minutes and drops them if the site's HttpOnly cookies changed
+    // (a log-out). PACIFIC_BFCACHE_NO_STORE=0 keeps WebKit's refusal.
+    static const bool cacheNoStore = [] {
+        const char* env = getenv("PACIFIC_BFCACHE_NO_STORE");
+        return !env || strcmp(env, "0");
+    }();
+    if (!cacheNoStore && frame.isMainFrame() && document && document->url().protocolIs("https"_s) && documentLoader->response().cacheControlContainsNoStore()) {
         PCLOG("   -Frame is HTTPS, and cache control prohibits storing"_s);
         logBackForwardCacheFailureDiagnosticMessage(diagnosticLoggingClient, DiagnosticLoggingKeys::httpsNoStoreKey());
         isCacheable = false;
