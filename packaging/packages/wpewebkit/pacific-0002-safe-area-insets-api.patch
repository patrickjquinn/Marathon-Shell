     page->scalePageInViewCoordinates(scale, WebCore::IntPoint(static_cast<int>(centerX * anchor), static_cast<int>(centerY * anchor)));
 }
 
+// SFOS: the screen edges the page should keep its content clear of, in CSS
+// pixels: a notch or a rounded corner. Pages read them as
+// env(safe-area-inset-top) etc. (with viewport-fit=cover, as on iOS). The
+// embedder sets them again after a navigation that changes web process.
+extern "C" __attribute__((visibility("default")))
+void wpe_sfos_set_safe_area_insets(WebKitWebView* webView, double top, double right, double bottom, double left)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+    getPage(webView).setUnobscuredSafeAreaInsetsForEmbedder(WebCore::FloatBoxExtent(top, right, bottom, left));
+}
