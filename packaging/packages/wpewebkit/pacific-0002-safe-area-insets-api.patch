@@ -6675,6 +6675,17 @@
     return m_pageScaleFactor;
 }
 
+// SFOS: see wpe_sfos_set_safe_area_insets(). Sent to every process showing
+// the page; a page in a new process gets it again from the embedder.
+void WebPageProxy::setUnobscuredSafeAreaInsetsForEmbedder(const FloatBoxExtent& insets)
+{
+    if (!hasRunningProcess())
+        return;
+    forEachWebContentProcess([&] (auto& process, auto pageID) {
+        process.send(Messages::WebPage::SetUnobscuredSafeAreaInsets(insets), pageID);
+    });
+}
+
 void WebPageProxy::scalePage(double scale, const IntPoint& origin, CompletionHandler<void()>&& completionHandler)
 {
     ASSERT(scale > 0);
