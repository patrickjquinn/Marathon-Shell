#
# wpe_sfos_set_safe_area_insets(): env(safe-area-inset-*) for WPE.
#
# WebCore supports the CSS safe-area constants on every port
# (Page::setUnobscuredSafeAreaInsets feeds ConstantPropertyMap), but only
# Cocoa reaches them, through its visible-content-rect updates. Phones with
# a notch need them: Pacific keeps ordinary pages below the notch and gives
# viewport-fit=cover pages the whole screen with the notch as the top inset,
# as Safari does. A new WebPage message carries the insets; the embedder
# sets them again after a navigation that changes web process.
#
--- a/Source/WebKit/WebProcess/WebPage/WebPage.messages.in
+++ b/Source/WebKit/WebProcess/WebPage/WebPage.messages.in
@@ -706,6 +706,8 @@
 
     SetUseColorAppearance(bool useDarkAppearance, bool useElevatedUserInterfaceLevel)
 
+    SetUnobscuredSafeAreaInsets(WebCore::FloatBoxExtent insets)
+
 #if HAVE(APP_ACCENT_COLORS)
     SetAccentColor(WebCore::Color color)
 #endif
