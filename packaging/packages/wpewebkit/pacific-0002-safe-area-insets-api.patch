+// SFOS: env(safe-area-inset-*) from the embedder (wpe_sfos_set_safe_area_insets).
+void WebPage::setUnobscuredSafeAreaInsets(const FloatBoxExtent& insets)
+{
+    if (RefPtr page = m_page.get())
+        page->setUnobscuredSafeAreaInsets(insets);
+}
