+// Pacific (patch 0016): the wait adapts to how late the reports actually
+// arrive. Touches reach Pacific's UI thread with up to 12 ms of varying delay
+// (Lipstick, Wayland, Qt's event loop) and more on the way here, so a fixed
+// 16 ms often had only whole reports to show: a steady drag moved 0, 5.6,
+// 11.2 or 16.8 px a frame (whole reports). Waiting for the lateness seen
+// lately, plus a margin, gives every frame its share; 32 ms made those steps
+// 6-7.7 px. Never below the fixed latency, never above 40 ms.
+Seconds ThreadedScrollingTree::touchScrollLatency() const
+{
+    static const bool adaptive = [] {
+        const char* env = getenv("PACIFIC_SCROLL_RESAMPLE_ADAPTIVE");
+        return !env || strcmp(env, "0");
+    }();
+    auto base = touchScrollResampleLatency();
+    if (!adaptive)
+        return base;
+    // The report after the frame's time must be here too: lateness plus a
+    // report's interval, plus a little.
+    return std::clamp(Seconds::fromMilliseconds(m_touchLatenessMs + m_touchIntervalMs + 2), base, 40_ms);
+}
