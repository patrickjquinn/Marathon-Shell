+// Pacific: libhybris's EGL_HYBRIS_native_buffer2 (eglplatformcommon.cpp):
+// gralloc buffers the CPU can map and EGL can make an image of.
+namespace {
+using HybrisCreateNativeBuffer = unsigned (*)(int width, int height, int usage, int format, int* stride, void** buffer);
+using HybrisLockNativeBuffer = unsigned (*)(void* buffer, int usage, int left, int top, int width, int height, void** vaddr);
+using HybrisNativeBufferCall = unsigned (*)(void* buffer);
+// GRALLOC_USAGE_SW_READ_OFTEN | SW_WRITE_OFTEN: a cached mapping (Skia reads
+// the destination to blend); GRALLOC_USAGE_HW_TEXTURE.
+constexpr int kNativeBufferCPUUsage = 0x3 | 0x30;
+constexpr int kNativeBufferUsage = kNativeBufferCPUUsage | 0x100;
+constexpr int kHALPixelFormatBGRA8888 = 5;
+
+struct HybrisNativeBuffers {
+    HybrisCreateNativeBuffer create { nullptr };
+    HybrisLockNativeBuffer lock { nullptr };
+    HybrisNativeBufferCall unlock { nullptr };
+    HybrisNativeBufferCall release { nullptr };
+    bool available { false };
+};
+
+const HybrisNativeBuffers& hybrisNativeBuffers()
+{
+    static const HybrisNativeBuffers buffers = [] {
+        HybrisNativeBuffers b;
+        const char* env = getenv("PACIFIC_ZERO_COPY_TILES");
+        if (env && !strcmp(env, "0"))
+            return b;
+        b.create = reinterpret_cast<HybrisCreateNativeBuffer>(eglGetProcAddress("eglHybrisCreateNativeBuffer"));
+        b.lock = reinterpret_cast<HybrisLockNativeBuffer>(eglGetProcAddress("eglHybrisLockNativeBuffer"));
+        b.unlock = reinterpret_cast<HybrisNativeBufferCall>(eglGetProcAddress("eglHybrisUnlockNativeBuffer"));
+        b.release = reinterpret_cast<HybrisNativeBufferCall>(eglGetProcAddress("eglHybrisReleaseNativeBuffer"));
+        b.available = b.create && b.lock && b.unlock && b.release;
+        return b;
+    }();
+    return buffers;
+}
+} // namespace
