+// Pacific: gralloc tile memory, allocated once and reused, with its EGLImage
+// made once: allocating a buffer per tile cost the main thread a fifth of its
+// time and importing each one into the driver a third of the compositor's.
+class NativeTileMemory : public ThreadSafeRefCounted<NativeTileMemory> {
+public:
+    static RefPtr<NativeTileMemory> acquire(const IntSize&);
+
+    ~NativeTileMemory()
+    {
+        if (m_image)
+            destroyImage(m_image);
+        hybrisNativeBuffers().release(m_buffer);
+    }
+
+    void* buffer() const { return m_buffer; }
+    const IntSize& size() const { return m_size; }
+    int stride() const { return m_stride; }
+
+    void* image()
+    {
+        if (!m_image) {
+            constexpr unsigned nativeBufferTarget = 0x3140; // EGL_NATIVE_BUFFER_ANDROID
+            using CreateImageKHR = void* (*)(EGLDisplay, EGLContext, unsigned, EGLClientBuffer, const EGLint*);
+            static const auto createImage = reinterpret_cast<CreateImageKHR>(eglGetProcAddress("eglCreateImageKHR"));
+            // eglCreateImageKHR: the EGL 1.5 eglCreateImage makes an image of a
+            // native buffer the Mali driver then crashes on.
+            if (createImage)
+                m_image = createImage(PlatformDisplay::sharedDisplay().eglDisplay(), EGL_NO_CONTEXT, nativeBufferTarget, static_cast<EGLClientBuffer>(m_buffer), nullptr);
+        }
+        return m_image;
+    }
+
+private:
+    NativeTileMemory(void* buffer, const IntSize& size, int stride)
+        : m_buffer(buffer)
+        , m_size(size)
+        , m_stride(stride)
+    {
+    }
+
+    static void destroyImage(void* image)
+    {
+        using DestroyImageKHR = EGLBoolean (*)(EGLDisplay, void*);
+        static const auto destroy = reinterpret_cast<DestroyImageKHR>(eglGetProcAddress("eglDestroyImageKHR"));
+        if (destroy)
+            destroy(PlatformDisplay::sharedDisplay().eglDisplay(), image);
+    }
+
+    void* m_buffer { nullptr };
+    IntSize m_size;
+    int m_stride { 0 };
+    void* m_image { nullptr };
+    // When the pool first saw it unused; reused 50 ms later, after any frame
+    // still showing it has gone.
+    std::optional<MonotonicTime> m_freeSince;
+
+    friend struct NativeTilePool;
+};
+
+struct NativeTilePool {
+    static constexpr size_t maxFreeBytes = 48 * 1024 * 1024;
+    // Buffers in use are bounded too: each costs the process about three
+    // file descriptors (dma-buf, gralloc_extra and its mapping), and at the
+    // open-files limit the next frame buffer cannot be imported and the page
+    // stops updating. A sixth of the limit, and no more than 384 (a 512px
+    // tile is 1 MiB); tiles past it take the upload path.
+    static size_t maxBuffers()
+    {
+        static const size_t cap = [] {
+            struct rlimit files;
+            size_t byFiles = getrlimit(RLIMIT_NOFILE, &files) ? 170 : static_cast<size_t>(files.rlim_cur) / 6;
+            return std::min<size_t>(byFiles, 384);
+        }();
+        return cap;
+    }
+    Lock lock;
+    Vector<Ref<NativeTileMemory>> entries;
+};
+
+static NativeTilePool& nativeTilePool()
+{
+    static NeverDestroyed<NativeTilePool> pool;
+    return pool;
+}
+
+RefPtr<NativeTileMemory> NativeTileMemory::acquire(const IntSize& size)
+{
+    const auto& hybris = hybrisNativeBuffers();
+    if (!hybris.available)
+        return nullptr;
+    auto& pool = nativeTilePool();
+    const auto now = MonotonicTime::now();
+    {
+        Locker locker { pool.lock };
+        size_t freeBytes = 0;
+        RefPtr<NativeTileMemory> found;
+        for (auto& entry : pool.entries) {
+            if (entry->refCount() > 1) {
+                entry->m_freeSince = std::nullopt;
+                continue;
+            }
+            if (!entry->m_freeSince)
+                entry->m_freeSince = now;
+            if (!found && entry->m_size == size && now - *entry->m_freeSince >= 50_ms) {
+                found = entry.ptr();
+                entry->m_freeSince = std::nullopt;
+                continue;
+            }
+            freeBytes += entry->m_stride * entry->m_size.height();
+        }
+        // Oldest free entries go past the cap.
+        if (freeBytes > NativeTilePool::maxFreeBytes) {
+            pool.entries.removeAllMatching([&](auto& entry) {
+                if (freeBytes <= NativeTilePool::maxFreeBytes || entry->refCount() > 1 || entry.ptr() == found.get())
+                    return false;
+                freeBytes -= entry->m_stride * entry->m_size.height();
+                return true;
+            });
+        }
+        if (found)
+            return found;
+        if (pool.entries.size() >= NativeTilePool::maxBuffers())
+            return nullptr;
+    }
+    int stridePixels = 0;
+    void* buffer = nullptr;
+    if (!hybris.create(size.width(), size.height(), kNativeBufferUsage, kHALPixelFormatBGRA8888, &stridePixels, &buffer) || !buffer)
+        return nullptr;
+    Ref memory = adoptRef(*new NativeTileMemory(buffer, size, stridePixels * 4));
+    Locker locker { pool.lock };
+    pool.entries.append(memory.copyRef());
+    return memory;
+}
