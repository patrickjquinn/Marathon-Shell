+void CoordinatedUnacceleratedTileBuffer::completePainting()
+{
+    // Unlocking flushes the CPU's writes for the GPU.
+    if (m_mapped) {
+        m_surface = nullptr;
+        hybrisNativeBuffers().unlock(m_native->buffer());
+        m_mapped = nullptr;
+    }
+    CoordinatedTileBuffer::completePainting();
+}
+
+void* CoordinatedUnacceleratedTileBuffer::nativeImage()
+{
+    return m_native && !m_mapped ? m_native->image() : nullptr;
+}
+
+bool CoordinatedUnacceleratedTileBuffer::writeToNativeBuffer(const unsigned char* source, int sourceStride, const IntRect& rect)
+{
+    if (!m_native || m_mapped || rect.isEmpty())
+        return false;
+    if (rect.x() < 0 || rect.y() < 0 || rect.maxX() > m_size.width() || rect.maxY() > m_size.height())
+        return false;
+    const auto& hybris = hybrisNativeBuffers();
+    void* vaddr = nullptr;
+    if (!hybris.lock(m_native->buffer(), kNativeBufferCPUUsage, rect.x(), rect.y(), rect.width(), rect.height(), &vaddr) || !vaddr)
+        return false;
+    // The mapping is of the whole buffer whatever the locked region.
+    auto* base = static_cast<unsigned char*>(vaddr);
+    for (int row = 0; row < rect.height(); ++row)
+        memcpy(base + (rect.y() + row) * m_stride + rect.x() * 4, source + row * sourceStride, rect.width() * 4);
+    hybris.unlock(m_native->buffer());
+    return true;
+}
