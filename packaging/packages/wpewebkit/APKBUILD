prepare() {
	local p
	for p in $(sed -n '/WEBKIT_SOURCE_PATCHES=(/,/^)/p' \
			"$srcdir/atlantic-engine-$_atlantic/scripts/patches.sh" | grep -oE 'patches/webkit/[^"]+'); do
		case $p in
		# Sailfish only: an unconfined bwrap layout for libhybris, and
		# ICU 73's runtime.
		*/webkit-bubblewrap-sfos-sandbox.patch|*/webkit-icu-runtime-73.patch) continue ;;
		esac
		# Pacific's rebase of an Atlantic patch onto this WebKit replaces it.
		if [ -e "$srcdir/atlantic-${p##*/}.rebased" ]; then
			msg "atlantic: ${p##*/} (rebased)"
			patch -p1 -N -i "$srcdir/atlantic-${p##*/}.rebased"
			continue
		fi
		msg "atlantic: ${p##*/}"
		patch -p1 -N -i "$srcdir/atlantic-engine-$_atlantic/$p"
	done
	default_prepare
}

build() {
	export CC=clang
	export CXX=clang++
	export AR=llvm-ar
	export NM=llvm-nm
	export RANLIB=llvm-ranlib
	export LDFLAGS="$LDFLAGS -fuse-ld=lld"
	# Alpine builds with _FORTIFY_SOURCE, which WebKit trips: a failed check
	# traps, and the WebProcess died with SIGTRAP on every page load.
	# webkit2gtk-6.0 disables it on every arch for the same reason.
	export CFLAGS="$CFLAGS -g0 -U_FORTIFY_SOURCE"
	export CXXFLAGS="$CXXFLAGS -g0 -U_FORTIFY_SOURCE"

	cmake -B build -G Ninja \
		-DPORT=WPE \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_SKIP_RPATH=ON \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_WPE_LEGACY_API=ON \
		-DENABLE_WPE_PLATFORM=OFF \
		-DENABLE_GPU_PROCESS=OFF \
		-DENABLE_DOCUMENTATION=OFF \
		-DENABLE_INTROSPECTION=OFF \
		-DENABLE_JOURNALD_LOG=OFF \
		-DENABLE_MINIBROWSER=OFF \
		-DENABLE_WEBDRIVER=OFF \
		-DENABLE_SAMPLING_PROFILER=OFF \
		-DENABLE_SPEECH_SYNTHESIS=OFF \
		-DENABLE_SPELLCHECK=ON \
		-DENABLE_BUBBLEWRAP_SANDBOX=ON \
		-DENABLE_VIDEO=ON \
		-DENABLE_WEB_AUDIO=ON \
		-DENABLE_MEDIA_SOURCE=ON \
		-DENABLE_MEDIA_STREAM=ON \
		-DENABLE_WEB_RTC=ON \
		-DUSE_GSTREAMER_WEBRTC=ON \
		-DENABLE_ENCRYPTED_MEDIA=OFF \
		-DENABLE_GEOLOCATION=ON \
		-DENABLE_DEVICE_ORIENTATION=ON \
		-DENABLE_GAMEPAD=OFF \
		-DENABLE_XSLT=OFF \
		-DUSE_ATK=OFF \
		-DUSE_LCMS=OFF \
		-DUSE_LIBHYPHEN=OFF \
		-DUSE_OPENJPEG=OFF \
		-DUSE_LIBBACKTRACE=OFF \
		-DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
		-DUSE_WOFF2=ON \
		-DUSE_AVIF=ON
	# WebCore's unified sources take ~2 GB a clang job; ninja would run nproc+2.
	cmake --build build --parallel "${WPE_BUILD_JOBS:-6}"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

