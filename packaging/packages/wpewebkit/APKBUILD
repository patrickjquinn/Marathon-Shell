# Maintainer: Patrick Quinn <patrick@jquinn.com>
# WPE WebKit for Pacific, Marathon's browser. Alpine dropped wpewebkit in
# 2025; this follows its last recipe and webkit2gtk-6.0's, at the version
# and feature set Pacific's engine uses (shoal/pacific/engine/build/
# atlantic-wpe-features.cmake), with its patches: Atlantic's stack and
# Pacific's own (shoal/pacific/engine/build/patches, as pacific-*.patch).
pkgname=wpewebkit
pkgver=2.54.0
pkgrel=1
_atlantic=a91f8ecdea2e4fe8fa017d6a28503a4d01edf381
pkgdesc="WebKit port optimized for embedded devices"
url="https://wpewebkit.org/"
arch="aarch64 x86_64"
license="LGPL-2.0-or-later AND BSD-2-Clause"
depends="bubblewrap xdg-dbus-proxy"
makedepends="
	clang
	cmake
	enchant2-dev
	gperf
	gst-plugins-bad-dev
	gst-plugins-base-dev
	harfbuzz-dev
	libavif-dev
	libdrm-dev
	libepoxy-dev
	libgcrypt-dev
	libjxl-dev
	libnice-dev
	libseccomp-dev
	libsoup3-dev
	libtasn1-dev
	libwebp-dev
	libwpe-dev
	libwpebackend-fdo-dev
	libxkbcommon-dev
	lld
	llvm
	mesa-dev
	ninja
	openssl-dev
	perl
	ruby
	unifdef
	wayland-dev
	wayland-protocols
	woff2-dev
	"
subpackages="$pkgname-dev"
source="https://wpewebkit.org/releases/wpewebkit-$pkgver.tar.xz
	atlantic-engine-$_atlantic.tar.gz::https://github.com/specsierra/atlantic-engine/archive/$_atlantic.tar.gz
	gettext.patch
	pacific-0001-compositor-offscreen-animations-at-10hz.patch
	pacific-0002-safe-area-insets-api.patch
	pacific-0003-taps-never-press-the-scrollbar.patch
	pacific-0004-flings-never-throttled.patch
	pacific-0005-compositor-thread-realtime.patch
	pacific-0006-zero-copy-cpu-tiles.patch
	pacific-0007-frame-paced-scroll.patch
	pacific-0008-recorded-css-filters.patch
	pacific-0009-touch-scroll-resampling.patch
	pacific-0010-touch-slop.patch
	pacific-0011-single-scroll-clock.patch
	pacific-0012-obscured-content-insets.patch
	pacific-0013-bfcache-no-store.patch
	pacific-0014-find-match-cache.patch
	pacific-0015-one-finger-gestures.patch
	pacific-0016-even-drag-steps.patch
	pacific-0017-touch-scroll-prediction.patch
	pacific-0018-ios-fling-physics.patch
	pacific-0019-fling-carry-and-catch.patch
	pacific-0020-no-suspended-process-reuse.patch
	"
options="!check"

prepare() {
	local p
	for p in $(sed -n '/WEBKIT_SOURCE_PATCHES=(/,/^)/p' \
			"$srcdir/atlantic-engine-$_atlantic/scripts/patches.sh" | grep -oE 'patches/webkit/[^"]+'); do
		case $p in
		# Sailfish only: an unconfined bwrap layout for libhybris, and
		# ICU 73's runtime.
		*/webkit-bubblewrap-sfos-sandbox.patch|*/webkit-icu-runtime-73.patch) continue ;;
		esac
		msg "atlantic: ${p##*/}"
		patch -p1 -N -i "$srcdir/atlantic-engine-$_atlantic/$p"
	done
	default_prepare
}

build() {
	export CC=clang
	export CXX=clang++
	export AR=llvm-ar
	export NM=llvm-nm
	export RANLIB=llvm-ranlib
	export LDFLAGS="$LDFLAGS -fuse-ld=lld"
	# Alpine builds with _FORTIFY_SOURCE, which WebKit trips: a failed check
	# traps, and the WebProcess died with SIGTRAP on every page load.
	# webkit2gtk-6.0 disables it on every arch for the same reason.
	export CFLAGS="$CFLAGS -g0 -U_FORTIFY_SOURCE"
	export CXXFLAGS="$CXXFLAGS -g0 -U_FORTIFY_SOURCE"

	cmake -B build -G Ninja \
		-DPORT=WPE \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_SKIP_RPATH=ON \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_WPE_LEGACY_API=ON \
		-DENABLE_WPE_PLATFORM=OFF \
		-DENABLE_GPU_PROCESS=OFF \
		-DENABLE_DOCUMENTATION=OFF \
		-DENABLE_INTROSPECTION=OFF \
		-DENABLE_JOURNALD_LOG=OFF \
		-DENABLE_MINIBROWSER=OFF \
		-DENABLE_WEBDRIVER=OFF \
		-DENABLE_SAMPLING_PROFILER=OFF \
		-DENABLE_SPEECH_SYNTHESIS=OFF \
		-DENABLE_SPELLCHECK=ON \
		-DENABLE_BUBBLEWRAP_SANDBOX=ON \
		-DENABLE_VIDEO=ON \
		-DENABLE_WEB_AUDIO=ON \
		-DENABLE_MEDIA_SOURCE=ON \
		-DENABLE_MEDIA_STREAM=ON \
		-DENABLE_WEB_RTC=ON \
		-DUSE_GSTREAMER_WEBRTC=ON \
		-DENABLE_ENCRYPTED_MEDIA=OFF \
		-DENABLE_GEOLOCATION=ON \
		-DENABLE_DEVICE_ORIENTATION=ON \
		-DENABLE_GAMEPAD=OFF \
		-DENABLE_XSLT=OFF \
		-DUSE_ATK=OFF \
		-DUSE_LCMS=OFF \
		-DUSE_LIBHYPHEN=OFF \
		-DUSE_OPENJPEG=OFF \
		-DUSE_LIBBACKTRACE=OFF \
		-DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
		-DUSE_WOFF2=ON \
		-DUSE_AVIF=ON
	# WebCore's unified sources take ~2 GB a clang job; ninja would run nproc+2.
	cmake --build build --parallel "${WPE_BUILD_JOBS:-6}"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

