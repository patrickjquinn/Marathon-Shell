+void ThreadedCompositor::scrollingThreadDidApplyScroll()
+{
+    m_lastScrollingThreadScroll = MonotonicTime::now().secondsSinceEpoch().value();
+    // Throttled to 10 Hz: the step is shown now, and full rate resumes.
+    if (m_throttlingInvisibleAnimations.exchange(false))
+        requestComposition(CompositionReason::AsyncScrolling);
+}
