+#if USE(WPE_RENDERER)
+// Pacific (patch 0025): the record assumes the target holds the frame last
+// presented on it, true of the swap chains of shareable buffers, one
+// target per buffer. The WPEBackend's EGL window is one target for the
+// buffers its EGL implementation rotates, and a buffer's contents are
+// whatever frame it last held: drawing only the last frame's damage into
+// it left older frames on screen. With EGL_EXT_buffer_age the record
+// becomes what the frames since that one changed; without it, or older
+// than the history, the target is repainted in full.
+void AcceleratedSurface::SwapChainDamageTracker::applyBufferAge(RenderTarget& target, int bufferAge)
+{
+    if (bufferAge == 1)
+        return;
+
+    std::optional<Damage> record;
+    if (bufferAge > 1 && static_cast<size_t>(bufferAge - 1) <= m_presentedFrameDamage.size()) {
+        record = Damage(m_swapChain.size(), needsFineGrainedDamage() ? Damage::Mode::Rectangles : Damage::Mode::BoundingBox, Damage::NoMaxRectangles);
+        for (size_t i = m_presentedFrameDamage.size() - (bufferAge - 1); i < m_presentedFrameDamage.size(); ++i) {
+            if (!m_presentedFrameDamage[i]) {
+                record = std::nullopt;
+                break;
+            }
+            record->add(*m_presentedFrameDamage[i]);
+        }
+    }
+    target.setDamage(WTF::move(record));
+}
+
+static int currentEGLSurfaceBufferAge()
+{
+    EGLDisplay display = eglGetCurrentDisplay();
+    EGLSurface surface = eglGetCurrentSurface(EGL_DRAW);
+    if (display == EGL_NO_DISPLAY || surface == EGL_NO_SURFACE)
+        return 0;
+
+    static std::atomic<int> supported { -1 };
+    if (supported.load() < 0) {
+        const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
+        supported = extensions && strstr(extensions, "EGL_EXT_buffer_age") ? 1 : 0;
+    }
+    if (!supported.load())
+        return 0;
+
+    EGLint age = 0;
+    if (!eglQuerySurface(display, surface, EGL_BUFFER_AGE_EXT, &age))
+        return 0;
+    return age;
+}
+#endif
+
