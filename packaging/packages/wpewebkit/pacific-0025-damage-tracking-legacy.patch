 {
+#if USE(WPE_RENDERER)
+    if (m_swapChain.type() == SwapChain::Type::WPEBackend) {
+        // No frame damage recorded means nothing changed (an empty damage is not recorded).
+        std::optional<Damage> presented;
+        if (targetContents != TargetContents::Invalid)
+            presented = m_frameDamage ? *m_frameDamage : Damage(m_swapChain.size(), Damage::Mode::Rectangles, Damage::NoMaxRectangles);
+        if (m_presentedFrameDamage.size() == s_presentedFrameDamageHistory)
+            m_presentedFrameDamage.removeAt(0);
+        m_presentedFrameDamage.append(WTF::move(presented));
+    }
+#endif
+
     if (targetContents == TargetContents::Invalid) {
         // Nothing was drawn, so drop the record and let the target's next use repaint it fully.
         target.setDamage(std::nullopt);
@@ -1099,6 +1165,13 @@ void AcceleratedSurface::willRenderFrame(const IntSize& size)
