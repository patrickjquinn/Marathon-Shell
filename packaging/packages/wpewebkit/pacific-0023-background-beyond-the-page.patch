#
# The page's background goes on past the document, under the toolbar too.
#
# Pacific's toolbar floats over the bottom of the page and patch 0012
# keeps the layout viewport above it. On the Jolla Phone the view is 882
# CSS px tall and the layout viewport 817; on a short page with
# body { background: #2f3337 } the 65 px under the toolbar were white, so
# the frosted toolbar looked light grey on a dark site and a white band
# showed as it slid away. The same white showed past the end of any page
# scrolled to its end.
#
# WebKit already extends the root background beyond the document:
# Settings::backgroundShouldExtendBeyondPage() is on by default
# (WebPageProxy's m_backgroundExtendsBeyondPage starts true, on every
# port), RenderView paints the document's background colour where the
# base background would go, and RenderLayerCompositor keeps the colour as
# m_rootExtendedBackgroundColor. But past the document only the Cocoa
# ports show it: the Mac in its overhang areas layer (HAVE(RUBBER_BANDING))
# and WKWebView under the page. On WPE nothing was there but the
# compositor's clear colour. And LocalFrameView::insetClipLayerRect() cut
# the bottom and right obscured insets out of the frame's clip wherever
# they lay past the document, so nothing in the page could paint there.
#
# On WPE the clip now keeps those insets, and two layers with the extended
# background colour as solid contents sit against the document's top and
# bottom edges in the frame's scrolled contents layer, a view's height
# deep and at least a view wide. They move with the document on the
# scrolling thread, so the band is right during a fling too, and they
# paint nothing the document covers (no overdraw on the Adreno, which has
# no hidden-surface removal for it). The top one covers a scroll above the
# document's start; WPE does not rubber-band, so today that only happens
# with a top obscured inset. The colour is the page's
# underPageBackgroundColorOverride when set, else the document's
# background colour (the base background blended in), none for a
# transparent view.
#
--- a/Source/WebCore/page/LocalFrameView.cpp
+++ b/Source/WebCore/page/LocalFrameView.cpp
@@ -2746,6 +2746,15 @@ FloatRect LocalFrameView::insetClipLayerRect(const FloatPoint& scrollPosition, c
     if (obscuredContentInset.top())
         adjustedSize.setHeight(std::max(0.f, adjustedSize.height() - position.y()));
 
+    if (obscuredContentInset.left())
+        adjustedSize.setWidth(std::max(0.f, adjustedSize.width() - position.x()));
+
+    // Pacific (patch 0023): WPE keeps the bottom and right insets inside the
+    // clip, so the page's extended background shows under the embedder's
+    // controls past the end of the document (RenderLayerCompositor::
+    // updateExtendedBackgroundLayers()). The Mac clips it off and its view
+    // paints the colour there itself.
+#if !PLATFORM(WPE)
     if (obscuredContentInset.bottom()) {
         float visibleContentTop = std::max(0.f, scrollPosition.y());
         float visibleContentBottom = visibleContentTop + sizeForVisibleContent.height();
@@ -2755,9 +2764,6 @@ FloatRect LocalFrameView::insetClipLayerRect(const FloatPoint& scrollPosition, c
         adjustedSize.setHeight(std::max(0.f, adjustedSize.height() - obscuredInsetOverlap));
     }
 
-    if (obscuredContentInset.left())
-        adjustedSize.setWidth(std::max(0.f, adjustedSize.width() - position.x()));
-
     if (obscuredContentInset.right()) {
         float visibleContentLeft = std::max(0.f, scrollPosition.x());
         float visibleContentRight = visibleContentLeft + sizeForVisibleContent.width();
@@ -2766,6 +2772,9 @@ FloatRect LocalFrameView::insetClipLayerRect(const FloatPoint& scrollPosition, c
 
         adjustedSize.setWidth(std::max(0.f, adjustedSize.width() - obscureInsetOverlap));
     }
+#else
+    UNUSED_PARAM(totalContentsSize);
+#endif
 
     return { position, adjustedSize };
 }
