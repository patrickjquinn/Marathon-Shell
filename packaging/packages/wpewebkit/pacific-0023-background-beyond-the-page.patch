     GraphicsLayer::unparentAndClear(m_scrolledContentsLayer);
 
     GraphicsLayer::unparentAndClear(m_overflowControlsHostLayer);
@@ -2835,6 +2839,9 @@ void RenderLayerCompositor::frameViewDidChangeSize()
 
     if (m_scrolledContentsLayer) {
         updateScrollLayerClipping();
+#if PLATFORM(WPE)
+        updateExtendedBackgroundLayers();
+#endif
         frameViewDidScroll();
         updateOverflowControlsLayers();
 
@@ -2908,6 +2915,48 @@ void RenderLayerCompositor::updateScrollLayerClipping()
 #endif
 }
 
+#if PLATFORM(WPE)
+// Pacific (patch 0023): WebKit extends the page's background beyond the
+// document (Settings::backgroundShouldExtendBeyondPage(), which WebPageProxy
+// turns on by default) through m_rootExtendedBackgroundColor, but only the
+// Cocoa ports show it: the Mac paints it in its overhang areas layer and
+// WKWebView under the page. On WPE what the document did not cover was the
+// compositor's clear colour, white: the band under the embedder's toolbar
+// (the obscured content insets) at the end of a page, behind a short page,
+// and any overscroll. Two layers with the colour as solid contents sit
+// against the document's top and bottom edges in the scrolled contents, so
+// they move with it on the scrolling thread and paint nothing the document
+// covers. Each is a view's height deep, enough for any gap.
+void RenderLayerCompositor::updateExtendedBackgroundLayers()
+{
+    RefPtr above = m_layerForExtendedBackgroundAbove;
+    RefPtr below = m_layerForExtendedBackgroundBelow;
+    if (!above || !below || !m_rootContentsLayer)
+        return;
+
+    Color color;
+    if (m_renderView.settings().backgroundShouldExtendBeyondPage()) {
+        color = page().underPageBackgroundColorOverride();
+        if (!color.isValid())
+            color = m_rootExtendedBackgroundColor;
+    }
+
+    Ref frameView = m_renderView.frameView();
+    auto contentsSize = FloatSize(frameView->contentsSize());
+    auto viewSize = FloatSize(frameView->frameRect().size());
+    FloatSize bandSize { std::max(contentsSize.width(), viewSize.width()), viewSize.height() };
+    auto origin = RefPtr { m_rootContentsLayer }->position();
+
+    above->setPosition({ origin.x(), origin.y() - bandSize.height() });
+    below->setPosition({ origin.x(), origin.y() + contentsSize.height() });
+    for (RefPtr layer : { above, below }) {
+        layer->setSize(bandSize);
+        layer->setContentsRect({ { }, bandSize });
+        layer->setContentsToSolidColor(color.isVisible() ? color : Color());
+    }
+}
+#endif
+
 FloatRect RenderLayerCompositor::insetClipLayerRect() const
 {
     Ref frameView = m_renderView.frameView();
@@ -3252,6 +3301,9 @@ void RenderLayerCompositor::updateRootLayerPosition()
     }
 
     updateScrollLayerClipping();
+#if PLATFORM(WPE)
+    updateExtendedBackgroundLayers();
+#endif
 
 #if HAVE(RUBBER_BANDING)
     if (m_contentShadowLayer && m_rootContentsLayer) {
@@ -5035,6 +5087,9 @@ void RenderLayerCompositor::rootBackgroundColorOrTransparencyChanged()
         updateLayerForOverhangAreasBackgroundColor();
 #endif
         updateRootContentsLayerBackgroundColor();
+#if PLATFORM(WPE)
+        updateExtendedBackgroundLayers();
+#endif
     }
     
     rootLayerConfigurationChanged();
@@ -5232,6 +5287,21 @@ void RenderLayerCompositor::ensureRootLayer()
 
             RefPtr { m_scrolledContentsLayer }->addChild(*m_rootContentsLayer);
 
+#if PLATFORM(WPE)
+            if (isMainFrameCompositor()) {
+                m_layerForExtendedBackgroundAbove = GraphicsLayer::create(graphicsLayerFactory(), *this);
+                m_layerForExtendedBackgroundAbove->setName(MAKE_STATIC_STRING_IMPL("extended background above"));
+                m_layerForExtendedBackgroundBelow = GraphicsLayer::create(graphicsLayerFactory(), *this);
+                m_layerForExtendedBackgroundBelow->setName(MAKE_STATIC_STRING_IMPL("extended background below"));
+                for (RefPtr layer : { m_layerForExtendedBackgroundAbove, m_layerForExtendedBackgroundBelow }) {
+                    layer->setDrawsContent(false);
+                    layer->setAnchorPoint({ });
+                    RefPtr { m_scrolledContentsLayer }->addChildBelow(*layer, m_rootContentsLayer.get());
+                }
+                updateExtendedBackgroundLayers();
+            }
+#endif
+
             updateScrollLayerClipping();
             updateOverflowControlsLayers();
 
@@ -5245,6 +5315,10 @@ void RenderLayerCompositor::ensureRootLayer()
             GraphicsLayer::unparentAndClear(m_overflowControlsHostLayer);
             GraphicsLayer::unparentAndClear(m_clipLayer);
             GraphicsLayer::unparentAndClear(m_scrollContainerLayer);
+#if PLATFORM(WPE)
+            GraphicsLayer::unparentAndClear(m_layerForExtendedBackgroundAbove);
+            GraphicsLayer::unparentAndClear(m_layerForExtendedBackgroundBelow);
+#endif
             GraphicsLayer::unparentAndClear(m_scrolledContentsLayer);
         }
     }
@@ -5294,6 +5368,10 @@ void RenderLayerCompositor::destroyRootLayer()
         GraphicsLayer::unparentAndClear(m_overflowControlsHostLayer);
         GraphicsLayer::unparentAndClear(m_clipLayer);
         GraphicsLayer::unparentAndClear(m_scrollContainerLayer);
+#if PLATFORM(WPE)
+        GraphicsLayer::unparentAndClear(m_layerForExtendedBackgroundAbove);
+        GraphicsLayer::unparentAndClear(m_layerForExtendedBackgroundBelow);
+#endif
         GraphicsLayer::unparentAndClear(m_scrolledContentsLayer);
     }
     ASSERT(!m_scrolledContentsLayer);
