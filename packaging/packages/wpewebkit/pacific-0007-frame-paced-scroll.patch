#
# Scroll animations step with the frames, by whole refresh periods.
#
# Atlantic's independent scroll (webkit-independent-scroll.patch) ticks the
# scrolling thread on a free-running timer that drifts against the frames:
# some frames composite without a new scroll position and the next one moves
# twice as far. ThreadedCompositor::frameComplete(), which the embedder
# paces to the display, now ticks the scrolling tree (displayDidRefresh);
# the timer only covers a pause in the frames. Those acknowledgements jitter
# by a few ms, so each tick advances the animation by whole refresh periods
# (WEBKIT_INDEPENDENT_SCROLL_TICK_MS, which the webview sets from the
# display): one, or as many as passed after a missed frame, kept within a
# period of the real time and never backwards. Snapping to a fixed grid
# instead put two jittered ticks on the same point.
#
# Flinging on the Jolla Phone (90 Hz), frames composited without moving,
# 150-500 ms after each of eight flings, two runs: OSNews 0.0/3.3% against
# 8.5/7.9% on the timer, The Verge 1.8/0.9% against 8.0/59%, with 90
# composites a second on The Verge against 75/91.
# PACIFIC_FRAME_PACED_SCROLL=0 keeps the timer alone. With
# ATLANTIC_FRAME_TRACE=1 the compositor logs the scroll position of every
# frame it composites.
#
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp
@@ -651,6 +651,23 @@
     if (m_suspendedCount > 0)
         return;
 
+#if ENABLE(SCROLLING_THREAD)
+    // Shipwright (patch 0007): the scroll position each frame composites, to
+    // see judder (frames that do not move next to frames that move twice).
+    if (atlFrameTrace()) {
+        RefPtr<WebCore::ScrollingTree> scrollingTree;
+        {
+            Locker locker { m_scrollingTreeLock };
+            scrollingTree = m_scrollingTree;
+        }
+        if (scrollingTree) {
+            struct timespec ts;
+            clock_gettime(CLOCK_MONOTONIC, &ts);
+            fprintf(stderr, "[ftrace] web composite y=%.1f t=%.1f\n", scrollingTree->mainFrameScrollPosition().y(), ts.tv_sec * 1000.0 + ts.tv_nsec / 1.0e6);
+        }
+    }
+#endif
+
     OptionSet<CompositionReason> reasons;
     bool shouldNotifiyDidComposite = false;
     {
@@ -850,6 +867,26 @@
 {
     ASSERT(m_workQueue->runLoop().isCurrent());
 
+#if ENABLE(SCROLLING_THREAD)
+    // Shipwright (patch 0007): the embedder acknowledges a frame as the
+    // display takes it, so this is the display's rhythm: a running scroll
+    // animation steps here, once for every frame, instead of on a timer of
+    // its own that drifts against the frames.
+    static const bool framePacedScroll = [] {
+        const char* env = getenv("PACIFIC_FRAME_PACED_SCROLL");
+        return !env || strcmp(env, "0");
+    }();
+    if (framePacedScroll) {
+        RefPtr<WebCore::ScrollingTree> scrollingTree;
+        {
+            Locker locker { m_scrollingTreeLock };
+            scrollingTree = m_scrollingTree;
+        }
+        if (scrollingTree)
+            scrollingTree->displayDidRefresh(scrollingTree->displayID());
+    }
+#endif
+
     Locker locker { m_state.lock };
     WTFEmitSignpost(this, FrameComplete, "reasons: %s, state: %s, waiting for tiles: %s", reasonsToString(m_state.reasons).ascii().data(), stateToString(m_state.state).characters(), m_state.isWaitingForTiles ? "yes" : "no");
 
