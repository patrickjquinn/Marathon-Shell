-    serviceScrollAnimations(now);
+    // Shipwright (patch 0007): a frame is shown on the display's grid, not
+    // when its tick happens to run, so each tick advances the animation by
+    // whole refresh periods: one, or as many as passed after a missed frame.
+    // Ticks jitter with the embedder's acknowledgements and scroll positions
+    // did too. The animation time stays within a period of the real time and
+    // never goes backwards.
+    auto animationTime = now;
+    static const bool framePacedScroll = [] {
+        const char* env = getenv("PACIFIC_FRAME_PACED_SCROLL");
+        return !env || strcmp(env, "0");
+    }();
+    if (framePacedScroll && m_animationTime && now - m_animationTime < 100_ms) {
+        auto period = independentTickInterval();
+        double periods = std::max(1.0, std::round((now - m_animationTime) / period));
+        animationTime = std::clamp(m_animationTime + period * periods, now - period, now + period / 2);
+        if (animationTime < m_animationTime)
+            animationTime = m_animationTime;
+    }
+    m_animationTime = animationTime;
+    serviceScrollAnimations(animationTime);
 
