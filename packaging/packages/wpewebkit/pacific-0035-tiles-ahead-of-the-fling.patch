+float CoordinatedBackingStoreProxy::scrollVelocityY() const
+{
+    if (!velocityCoverEnabled() || MonotonicTime::now() - m_lastVisibleMoveTime > 150_ms)
+        return 0;
+    // Slower than this (about half a screen a second), the page is read, not
+    // flung: the cover stays around it.
+    return std::abs(m_scrollVelocityY) < 1000 ? 0 : m_scrollVelocityY;
+}
