     auto& base = latest ? *latest : *m_lastTouchMove;
@@ -1064,8 +1093,34 @@ void ThreadedScrollingTree::displayDidRefreshOnScrollingThread()
     // follows the compositor's uneven frame callbacks (8-14 ms apart on the
     // Jolla Phone), a steady drag moved 5.6 px in one frame and 11 in the
     // next.
-    if (advances)
-        applyTouchScroll((framePacedScroll ? animationTime : now) - touchScrollLatency());
+    if (advances) {
+        auto frameTime = framePacedScroll ? animationTime : now;
+        auto until = frameTime - touchScrollLatency();
+        // Patch 0033: at a drag's start, the slowed clock while it is ahead.
+        // It runs in the reports' own time from the first move's (the clock
+        // offset falls as reports come in less late than that one did), and
+        // its speed rises each frame so that, rising evenly, it reaches real
+        // time as the clock falls the wait behind; the gap is measured anew
+        // each frame, as the wait and the offset change.
+        if (m_touchScrollRampFrame) {
+            auto delayed = until - m_touchScrollClockOffset;
+            auto elapsed = frameTime - *m_touchScrollRampFrame;
+            auto gap = m_touchScrollRampAt - delayed;
+            if (elapsed > 0_s && gap > 0_s) {
+                double speed = m_touchScrollRampSpeed;
+                speed += (1 - speed) * (1 - speed) / (2 * gap.seconds()) * elapsed.seconds();
+                // Below real time, so the gap always closes.
+                m_touchScrollRampSpeed = std::min(speed, 0.97);
+                m_touchScrollRampAt += elapsed * m_touchScrollRampSpeed;
+                m_touchScrollRampFrame = frameTime;
+            }
+            if (m_touchScrollRampAt > delayed)
+                until = m_touchScrollRampAt + m_touchScrollClockOffset;
+            else
+                m_touchScrollRampFrame = std::nullopt;
+        }
+        applyTouchScroll(until, frameTime);
+    }
 
