#
# A drag starts at its pace, without a lurch and a stall (on top of patches
# 0009, 0016, 0017 and 0032).
#
# Every drag began with an uneven pair of frames. From rest on OSNews, the
# first frame moved 10-15 CSS px and the next 1-3; after a catch, 2 px and
# then nothing. Two causes:
#
# - The first move carried the whole slop: the gesture controller sent the
#   finger's movement since touch-down once it passed 8 dp. It now sends
#   the movement past the slop (as Android does), so the page starts from
#   where the finger crossed it. PACIFIC_TOUCH_SLOP_SUBTRACT=0 restores it.
#   And the gesture begins with the first move that has a length: the
#   scrolling tree latches a gesture only to a Began that scrolls, and a
#   Began of no length (the finger exactly at the slop, or a 200 ms rest)
#   left the drag unlatched, its moves out of the history the lift's fling
#   is taken from: the page followed the drag and stopped dead at the
#   lift (with the slop subtracted, a quarter of quick re-flicks on
#   OSNews). A lift before any move closes the gesture without a fling.
# - The first move (Began) is shown at once, the next ones a resampling
#   wait (16-40 ms) behind their time, so the frames in that wait had
#   nothing new to show. The moves after the first are now shown on a
#   clock that starts at the first move at 0.4 of real time and speeds up
#   evenly, reaching real time just as it falls the wait behind
#   (PACIFIC_SCROLL_START_RAMP, 0 for the wait from the start): the drag
#   eases into its pace instead of stopping. A fixed half speed was tried
#   first; its hand-over to full speed was a lurch of its own.
#   Touch prediction is timed by the frame itself, not by that clock.
#
--- a/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
+++ b/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
@@ -746,6 +746,25 @@ static bool touchScrollResampling()
     return enabled;
 }
 
+// Pacific (patch 0033): a drag's first move (Began) is shown at once, but
+// its next ones only a resampling wait (16-40 ms) behind their time: the
+// frames in that wait had nothing new to show, and the page stood still for
+// one or two frames right after it started to move. Now the clock the moves
+// are shown by starts at the first move, at this share of real time, and
+// speeds up evenly to real time just as it falls the wait behind: the frames
+// show the moves already here, and the drag eases into its pace. (At a fixed
+// half speed the hand-over to full speed was itself a lurch: frames of 2.4
+// CSS px, then 9.2.) PACIFIC_SCROLL_START_RAMP (default 0.4; 0: the wait
+// from the start).
+static double touchScrollStartRamp()
+{
+    static const double rate = [] {
+        const char* env = getenv("PACIFIC_SCROLL_START_RAMP");
+        return env ? std::clamp(atof(env), 0.0, 0.9) : 0.4;
+    }();
+    return rate;
+}
