 {
     ASSERT(ScrollingThread::isCurrentThread());
@@ -794,6 +813,14 @@ void ThreadedScrollingTree::touchScrollHandled(const PlatformWheelEvent& event,
     m_touchScrollAnchor = event.timestamp();
