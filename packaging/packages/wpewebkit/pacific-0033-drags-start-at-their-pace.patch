     m_touchScrollPartial = { };
+    // Patch 0033: a drag's first move is shown at once; its next ones follow
+    // it on a clock that slows into the resampling's wait.
+    m_touchScrollRampFrame = std::nullopt;
+    if (m_touchScrollQueueable && event.phase() == PlatformWheelEventPhase::Began && touchScrollStartRamp() > 0) {
+        m_touchScrollRampFrame = MonotonicTime::now();
+        m_touchScrollRampAt = event.timestamp();
+        m_touchScrollRampSpeed = touchScrollStartRamp();
+    }
 }
 
