+#pragma once
+
+#if USE(HARFBUZZ)
+
+#include <hb.h>
+#include <unicode/uscript.h>
+
+namespace WebCore {
+
+// HarfBuzz's script for an ICU script code, by its ISO 15924 code, as
+// harfbuzz-icu's hb_icu_script_to_script() computes it, without linking
+// libharfbuzz-icu (which Sailfish OS does not install on the phone).
+inline hb_script_t harfBuzzScriptFromICU(UScriptCode script)
+{
+    if (script == USCRIPT_INVALID_CODE)
+        return HB_SCRIPT_INVALID;
+    return hb_script_from_string(uscript_getShortName(script), -1);
+}
+
+} // namespace WebCore
+
+#endif // USE(HARFBUZZ)
