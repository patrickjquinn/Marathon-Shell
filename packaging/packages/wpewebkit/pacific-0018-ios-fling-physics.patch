+// Pacific (patch 0018): iOS's touch on a moving page. A finger landing on a
+// page still coasting from a fling stops it at once and is not a click (a
+// tap to stop a page must not open the link under it). Upstream only
+// stopped the fling when the next drag passed the touch slop (or 200 ms),
+// so a resting finger let the page coast on, and a tap clicked.
+//
+// The fling runs in the WebProcess; here it is modelled from the drag that
+// started it: the finger's speed over its last 50 ms, decaying as the
+// kinetic animation does (WEBKIT_KINETIC_DECEL_FRICTION), until it is
+// slower than the animation's own end (a pixel a frame at 90 Hz).
+static double kineticFriction()
+{
+    static const double friction = [] {
+        if (const char* env = getenv("WEBKIT_KINETIC_DECEL_FRICTION")) {
+            double v = atof(env);
+            if (v >= 0.3 && v <= 8.0)
+                return v;
+        }
+        return 4.0;
+    }();
+    return friction;
+}
+
+static constexpr uint32_t flingVelocityWindow { 50 };
+static constexpr float flingStoppedSpeed { 0.09f }; // px/ms
+
+void TouchGestureController::recordAxisMotion(uint32_t time, int32_t dx, int32_t dy)
+{
+    m_axisMotions.append({ time, dx, dy });
+    while (m_axisMotions.size() > 1 && time - m_axisMotions.first().time > 2 * flingVelocityWindow)
+        m_axisMotions.removeAt(0);
+}
+
+bool TouchGestureController::flingMovingAt(uint32_t time) const
+{
+    if (m_flingSpeed <= 0 || time < m_flingTime)
+        return false;
+    double seconds = (time - m_flingTime) / 1000.0;
+    return m_flingSpeed * std::exp(-kineticFriction() * seconds) > flingStoppedSpeed;
+}
+
+void TouchGestureController::catchFling(uint32_t downTime)
+{
+    m_flingSpeed = 0;
+    m_caughtDownTime = downTime;
+}
