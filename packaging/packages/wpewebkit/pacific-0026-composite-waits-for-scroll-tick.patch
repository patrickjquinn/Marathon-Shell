#
# A frame composites at the position its own scroll tick gives.
#
# Patch 0007 ticks the scrolling tree from ThreadedCompositor::
# frameComplete(); the tick runs on the scrolling thread. A rendering update
# that arrived while the last frame was in progress (ScheduledWhileInProgress)
# started the render timer in frameComplete() itself, so that composite ran
# ahead of the tick: the frame showed the last frame's scroll position, and
# the next one moved twice as far. Flinging OSNews on the Jolla Phone, 16 of
# 393 moving frames stood still and 20 jumped (ATLANTIC_FRAME_TRACE=1, the
# "web composite y=" markers).
#
# While the frame's tick runs, the composite now waits for it: the tick's end
# (or, at most 3 ms on, m_scrollTickTimer) starts the render timer, and a
# composite asked for meanwhile goes with the tick's position. No tick (no
# recent scrolling): nothing waits. PACIFIC_SCROLL_TICK_WAIT=0 composites at
# once, as before.
#
--- a/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
+++ b/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
@@ -1076,16 +1076,19 @@ void ThreadedScrollingTree::displayDidRefreshOnScrollingThread()
     }
 }
 
-void ThreadedScrollingTree::frameDidComplete()
+bool ThreadedScrollingTree::frameDidComplete(Function<void()>&& tickDone)
 {
     m_lastFrameTick = MonotonicTime::now().secondsSinceEpoch().value();
     if (!hasRecentActivity())
-        return;
-    ScrollingThread::dispatch([protectedThis = Ref { *this }]() {
+        return false;
+    ScrollingThread::dispatch([protectedThis = Ref { *this }, tickDone = WTF::move(tickDone)]() mutable {
         protectedThis->m_inFrameTick = true;
         protectedThis->displayDidRefreshOnScrollingThread();
         protectedThis->m_inFrameTick = false;
+        if (tickDone)
+            tickDone();
     });
+    return true;
 }
 
