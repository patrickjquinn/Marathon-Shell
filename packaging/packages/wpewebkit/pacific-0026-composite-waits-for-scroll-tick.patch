+#if ENABLE(SCROLLING_THREAD)
+bool ThreadedCompositor::waitForScrollTickEnabled()
+{
+    static const bool enabled = [] {
+        const char* env = getenv("PACIFIC_SCROLL_TICK_WAIT");
+        return !env || strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+// Scrolling thread (the tick's end) or compositor thread (m_scrollTickTimer):
+// the composite that waited for the tick goes now.
+void ThreadedCompositor::scrollTickDone()
+{
+    Locker locker { m_state.lock };
+    if (!m_state.isWaitingForScrollTick)
+        return;
+    m_state.isWaitingForScrollTick = false;
+    if (m_state.state == State::Scheduled && !m_state.isRenderTimerActive && !isOnlyRenderingUpdatePendingAndWaitingForTiles() && !m_suspendedCount.load())
+        startRenderTimer();
+}
+#endif
