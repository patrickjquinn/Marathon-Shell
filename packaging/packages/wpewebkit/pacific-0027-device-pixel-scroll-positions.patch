#
# Scroll positions snap to device pixels, not CSS pixels.
#
# ThreadedScrollingTreeScrollingNodeDelegate::adjustedScrollPosition()
# rounded every position the scrolling thread gives (drags, flings) to a
# whole CSS pixel. At the Jolla Phone's scale that is 2.5 of the panel's
# pixels, so a slow drag stepped unevenly and a fling ended in visible
# jumps (1 px, 1 px, none, 1 px). Positions now round to a device pixel
# (ThreadedScrollingTree::devicePixelScale(), which ThreadedCompositor sets
# from the page's device scale factor): every tile still lands on whole
# pixels, so text stays sharp. PACIFIC_DEVICE_PIXEL_SCROLL=0 rounds to CSS
# pixels, as upstream.
#
--- a/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
+++ b/Source/WebCore/page/scrolling/ThreadedScrollingTree.cpp
@@ -1076,6 +1076,19 @@ void ThreadedScrollingTree::displayDidRefreshOnScrollingThread()
     }
 }
 
+static std::atomic<float> s_devicePixelScale { 1 };
+
+void ThreadedScrollingTree::setDevicePixelScale(float scale)
+{
+    if (scale > 0)
+        s_devicePixelScale = scale;
+}
+
+float ThreadedScrollingTree::devicePixelScale()
+{
+    return s_devicePixelScale;
+}
+
 bool ThreadedScrollingTree::frameDidComplete(Function<void()>&& tickDone)
 {
     m_lastFrameTick = MonotonicTime::now().secondsSinceEpoch().value();
--- a/Source/WebCore/page/scrolling/ThreadedScrollingTree.h
+++ b/Source/WebCore/page/scrolling/ThreadedScrollingTree.h
@@ -61,6 +61,12 @@ public:
     // scrolling thread after it.
     bool frameDidComplete(Function<void()>&& tickDone = { });
 
+    // Pacific (patch 0027): device pixels per CSS pixel, which scroll
+    // positions snap to (ThreadedScrollingTreeScrollingNodeDelegate::
+    // adjustedScrollPosition); the compositor sets it from the page's scale.
+    WEBCORE_EXPORT static void setDevicePixelScale(float);
+    static float devicePixelScale();
+
     // Pacific (patch 0009): touch scrolling resampled to the display's
     // frames. A drag's moves arrive at the touchscreen's rate (110-125 Hz)
     // against a 90 Hz panel, so applying each as it came moved one frame by
