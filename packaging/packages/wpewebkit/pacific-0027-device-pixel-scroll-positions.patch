 namespace WebCore {
@@ -221,7 +224,19 @@ void ThreadedScrollingTreeScrollingNodeDelegate::removeWheelEventTestCompletionD
 
 FloatPoint ThreadedScrollingTreeScrollingNodeDelegate::adjustedScrollPosition(const FloatPoint& position) const
 {
-    return { roundf(position.x()), roundf(position.y()) };
+    // Pacific (patch 0027): to device pixels, not CSS pixels. At the Jolla
+    // Phone's scale a CSS pixel is 2.5 of the panel's, so a slow drag and a
+    // fling's last frames moved in visible jumps (1 px, then 2, then none);
+    // a device pixel still lands each tile on whole pixels, so text stays
+    // sharp. PACIFIC_DEVICE_PIXEL_SCROLL=0 rounds to CSS pixels, as upstream.
+    static const bool devicePixels = [] {
+        const char* env = getenv("PACIFIC_DEVICE_PIXEL_SCROLL");
+        return !env || strcmp(env, "0");
+    }();
+    float scale = devicePixels ? ThreadedScrollingTree::devicePixelScale() : 1;
+    if (scale <= 1)
+        return { roundf(position.x()), roundf(position.y()) };
+    return { roundf(position.x() * scale) / scale, roundf(position.y() * scale) / scale };
 }
 
