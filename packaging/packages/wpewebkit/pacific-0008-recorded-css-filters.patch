#
# CSS filters are recorded with the page, not applied on the main thread.
#
# A layer with a CSS filter (filter: drop-shadow(), blur(), saturate(), ...)
# was painted into a buffer and filtered there, on the main thread, each time
# a tile with it was recorded: flinging The Verge, half of the WebProcess
# main thread's time was Skia blurring drop shadows (FEDropShadowSkiaApplier).
# Apple's ports record such filters as a style on a transparency layer
# (FilterRenderingMode::GraphicsContext, CGStyle); with Skia that is
# saveLayer with an SkImageFilter, which runs when the recorded tile is
# played back on the painting threads. Drop-shadow, Gaussian blur and the
# matrix, saturate and hue-rotate colour matrices take that path when they
# work in sRGB (as CSS filter functions do; SVG filters, linearRGB by
# default, keep theirs). The style's radii are kernel sizes; Skia is given the
# standard deviation they came from. Rendering matched the old path to within
# blur rounding (at most 15/255).
#
# Flinging The Verge on the Jolla Phone: the main thread used 2.6 s of CPU in
# 7.8 s instead of 4.3 s, and 77 frames a second with no pause over 25 ms
# reached the screen while moving, against 74 with 7.
# PACIFIC_RECORDED_FILTERS=0 turns it off.
#
--- a/Source/WebCore/page/Page.cpp
+++ b/Source/WebCore/page/Page.cpp
@@ -4914,6 +4914,20 @@
         modes.add(FilterRenderingMode::Accelerated);
 #endif
 
+#if USE(SKIA)
+    // Pacific (patch 0008): a CSS drop-shadow, blur or colour-matrix filter is
+    // recorded as a Skia image filter on a transparency layer, and runs when
+    // the tile is painted (on the painting threads), instead of the layer
+    // being painted into a buffer and filtered on the main thread at once.
+    // PACIFIC_RECORDED_FILTERS=0 turns it off.
+    static const bool recordedFilters = [] {
+        const char* env = getenv("PACIFIC_RECORDED_FILTERS");
+        return !env || strcmp(env, "0");
+    }();
+    if (recordedFilters && !context.hasDropShadow() && context.renderingMode() != RenderingMode::PDFDocument)
+        modes.add(FilterRenderingMode::GraphicsContext);
+#endif
+
     UNUSED_PARAM(context);
 
 #if USE(GRAPHICS_CONTEXT_FILTERS)
