+// Pacific (patch 0008): the filter a GraphicsStyle stands for (a CSS filter
+// recorded with FilterRenderingMode::GraphicsContext). Its radii are kernel
+// sizes (FEGaussianBlur::calculateUnscaledKernelSize); Skia takes the
+// standard deviation.
+static sk_sp<SkImageFilter> imageFilterForStyle(const GraphicsStyle& style)
+{
+    static const float gaussianKernelFactor = 3 / 4.f * sqrtf(2 * std::numbers::pi_v<float>);
+    return WTF::switchOn(style,
+        [&](const GraphicsDropShadow& shadow) -> sk_sp<SkImageFilter> {
+            const float sigma = shadow.radius / gaussianKernelFactor;
+            const Color color = shadow.color.colorWithAlphaMultipliedBy(shadow.opacity);
+            return SkImageFilters::DropShadow(shadow.offset.width(), shadow.offset.height(), sigma, sigma, color, nullptr);
+        },
+        [&](const GraphicsGaussianBlur& blur) -> sk_sp<SkImageFilter> {
+            return SkImageFilters::Blur(blur.radius.width() / gaussianKernelFactor, blur.radius.height() / gaussianKernelFactor, nullptr);
+        },
+        [&](const GraphicsColorMatrix& matrix) -> sk_sp<SkImageFilter> {
+            return SkImageFilters::ColorFilter(SkColorFilters::Matrix(matrix.values.data()), nullptr);
+        });
+}
+
 void GraphicsContextSkia::beginTransparencyLayer(float opacity)
 {
     if (!makeGLContextCurrentIfNeeded())
         return;
 
     GraphicsContext::beginTransparencyLayer(opacity);
+    // The style applies to the layer as a whole when it ends, and not to
+    // what is drawn in it (as with CGContextSetStyle and CG layers).
+    if (auto style = this->style()) {
+        saveLayer(opacity, m_state.compositeMode(), imageFilterForStyle(*style));
+        setStyle(std::nullopt);
+        return;
+    }
     saveLayer(opacity, m_state.compositeMode());
 }
 
