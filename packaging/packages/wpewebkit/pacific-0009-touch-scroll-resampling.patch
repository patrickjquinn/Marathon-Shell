+// Pacific (patch 0009): see queueTouchScroll(). How far behind a frame the
+// finger's position is taken. A touch report reaches this thread through
+// Lipstick, Qt and the UI process (which sends one wheel event at a time
+// and merges the waiting ones), late by up to about a frame; behind that, a
+// frame nearly always falls between two reports that have both arrived, and
+// gets its share of the movement. Flinging and dragging on the Jolla Phone:
+// 6 and 12 ms left 6-9% of frames still, 16 ms 4-7%. Shorter is
+// PACIFIC_SCROLL_RESAMPLE_LATENCY_MS.
+static Seconds touchScrollResampleLatency()
+{
+    static const Seconds latency = [] {
+        if (const char* env = getenv("PACIFIC_SCROLL_RESAMPLE_LATENCY_MS")) {
+            double ms = atof(env);
+            if (ms >= 0 && ms <= 50)
+                return Seconds::fromMilliseconds(ms);
+        }
+        return 16_ms;
+    }();
+    return latency;
+}
+
+static bool touchScrollResampling()
+{
+    static const bool enabled = [] {
+        const char* env = getenv("PACIFIC_SCROLL_RESAMPLE");
+        return !env || strcmp(env, "0");
+    }();
+    return enabled;
+}
+
+bool ThreadedScrollingTree::queueTouchScroll(const PlatformWheelEvent& event, OptionSet<WheelEventProcessingSteps> steps)
+{
+    ASSERT(ScrollingThread::isCurrentThread());
+    if (!touchScrollResampling() || !m_touchScrollQueueable || !independentScrollEnabled())
+        return false;
+    if (event.phase() != PlatformWheelEventPhase::Changed || event.momentumPhase() != PlatformWheelEventPhase::None || !event.hasPreciseScrollingDeltas())
+        return false;
+    // Timed by the touch reports themselves: the UI process sends one wheel
+    // event at a time and merges those that wait, so they arrive in bursts.
+    m_touchScrollClockOffset = std::min(m_touchScrollClockOffset, MonotonicTime::now() - event.timestamp());
+    m_touchScrollQueue.append({ event.timestamp(), event, steps });
+    ensureIndependentTick();
+    return true;
+}
+
+void ThreadedScrollingTree::touchScrollHandled(const PlatformWheelEvent& event, const WheelEventHandlingResult& result)
+{
+    ASSERT(ScrollingThread::isCurrentThread());
+    const bool dragMove = (event.phase() == PlatformWheelEventPhase::Began || event.phase() == PlatformWheelEventPhase::Changed)
+        && event.momentumPhase() == PlatformWheelEventPhase::None && event.hasPreciseScrollingDeltas();
+    m_touchScrollQueueable = dragMove && result.wasHandled && !result.steps.contains(WheelEventProcessingSteps::SynchronousScrolling);
+    m_touchScrollAnchor = event.timestamp();
+    m_touchScrollClockOffset = MonotonicTime::now() - event.timestamp();
+    m_touchScrollPartial = { };
+}
+
+void ThreadedScrollingTree::flushTouchScroll()
+{
+    ASSERT(ScrollingThread::isCurrentThread());
+    // The reports still queued go as they came, each at its own time: the
+    // end of a drag sets the fling's velocity, which is measured from the
+    // last events' deltas and times; merged into one, it came out 5% faster.
+    while (!m_touchScrollQueue.isEmpty()) {
+        auto queued = m_touchScrollQueue.takeFirst();
+        auto delta = queued.event.delta() - m_touchScrollPartial;
+        m_touchScrollPartial = { };
+        m_touchScrollAnchor = queued.at;
+        if (!delta.isZero())
+            handleWheelEvent(queued.event.copyWithDeltaAndTimestamp(delta, queued.at), queued.steps);
+    }
+}
+
+void ThreadedScrollingTree::applyTouchScroll(std::optional<MonotonicTime> until)
+{
+    if (m_touchScrollQueue.isEmpty())
+        return;
+    // The finger's movement up to `until` (all of it without), as one event:
+    // each queued move covers the time since the one before it.
+    FloatSize total;
+    std::optional<QueuedTouchScroll> latest;
+    std::optional<MonotonicTime> untilEventTime;
+    if (until)
+        untilEventTime = *until - m_touchScrollClockOffset;
+    while (!m_touchScrollQueue.isEmpty()) {
+        auto& front = m_touchScrollQueue.first();
+        if (!untilEventTime || front.at <= *untilEventTime) {
+            total += front.event.delta() - m_touchScrollPartial;
+            m_touchScrollPartial = { };
+            m_touchScrollAnchor = front.at;
+            latest = m_touchScrollQueue.takeFirst();
+            continue;
+        }
+        auto span = front.at - m_touchScrollAnchor;
+        double share = span > 0_s ? std::clamp((*untilEventTime - m_touchScrollAnchor) / span, 0.0, 1.0) : 1.0;
+        auto applied = front.event.delta() * static_cast<float>(share);
+        total += applied - m_touchScrollPartial;
+        m_touchScrollPartial = applied;
+        if (!latest)
+            latest = front;
+        break;
+    }
+    if (!latest || total.isZero())
+        return;
+    // In the event clock, as the events the fling's velocity is measured with.
+    auto event = latest->event.copyWithDeltaAndTimestamp(total, untilEventTime.value_or(latest->at));
+    handleWheelEvent(event, latest->steps);
+}
