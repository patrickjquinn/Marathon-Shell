+// Pacific (patch 0019): the WebProcess's carry (ScrollAnimationKinetic),
+// so the model knows how fast a train of flicks really runs: modelled on
+// the flick alone, a page still coasting fast from the third flick was
+// taken as stopped, and the finger that landed on it long-pressed (text
+// selection) instead of catching it. Same environment variables.
+static double carryShare()
+{
+    static const double share = [] {
+        const char* env = getenv("PACIFIC_FLING_CARRY_SHARE");
+        return env ? std::clamp(atof(env), 0.0, 2.0) : 1.0;
+    }();
+    return share;
+}
+
+static double carryMinimum()
+{
+    static const double minimum = [] {
+        const char* env = getenv("PACIFIC_FLING_CARRY_MIN");
+        return env ? std::clamp(atof(env), 0.0, 2.0) : 0.5;
+    }();
+    return minimum;
+}
+
+static double carryFloor()
+{
+    static const double floor = [] {
+        const char* env = getenv("PACIFIC_FLING_CARRY_FLOOR");
+        return env ? std::clamp(atof(env), 0.0, 5000.0) : 350.0;
+    }();
+    return floor / 1000; // px/ms
+}
+
+static uint32_t carryPause()
+{
+    static const uint32_t ms = [] {
+        const char* env = getenv("PACIFIC_FLING_CARRY_PAUSE_MS");
+        return static_cast<uint32_t>(env ? std::clamp(atof(env), 0.0, 1000.0) : 100);
+    }();
+    return ms;
+}
