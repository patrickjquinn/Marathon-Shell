 WTF_MAKE_TZONE_ALLOCATED_IMPL(TouchGestureController);
 
+void TouchGestureController::trackFinger(const struct wpe_input_touch_event_raw* touchPoint)
+{
+    if (touchPoint->type == wpe_input_touch_event_type_down && !m_fingers.contains(touchPoint->id)) {
+        if (m_fingers.isEmpty())
+            m_primaryId = touchPoint->id;
+        m_fingers.append(touchPoint->id);
+    } else if (touchPoint->type == wpe_input_touch_event_type_up) {
+        m_fingers.removeFirst(touchPoint->id);
+        if (m_fingers.isEmpty())
+            m_multiTouch = false;
+    }
+}
+
 TouchGestureController::EventVariant TouchGestureController::handleEvent(const struct wpe_input_touch_event_raw* touchPoint)
 {
+    // Pacific (patch 0015): a gesture is one finger's. The controller took
+    // every finger's events as that one's, so a pinch scrolled the page by
+    // the jumps between the fingers, and a finger lifting ended the "scroll"
+    // with a fling. A second finger now ends any scroll without a fling
+    // (Cancelled: no kinetic animation) and nothing is gestured until every
+    // finger is up; the embedder pinches, the page still gets the touches.
+    switch (touchPoint->type) {
+    case wpe_input_touch_event_type_down:
+        if (m_fingers.isEmpty()) {
+            m_fingers.append(touchPoint->id);
+            m_primaryId = touchPoint->id;
+            m_multiTouch = false;
+            break;
+        }
+        if (!m_fingers.contains(touchPoint->id))
+            m_fingers.append(touchPoint->id);
+        if (touchPoint->id == m_primaryId || m_multiTouch)
+            return NoEvent { };
+        m_multiTouch = true;
+        if (m_gesturedEvent == GesturedEvent::Axis) {
+            m_gesturedEvent = GesturedEvent::None;
+            AxisEvent cancelled;
+            cancelled.phase = WebWheelEvent::Phase::Cancelled;
+#if WPE_CHECK_VERSION(1, 5, 0)
+            cancelled.event.base = {
+                static_cast<enum wpe_input_axis_event_type>(wpe_input_axis_event_type_mask_2d | wpe_input_axis_event_type_motion_smooth),
+                touchPoint->time, m_start.x, m_start.y,
+                0, 0, 0
+            };
+            cancelled.event.x_axis = cancelled.event.y_axis = 0;
+#else
+            cancelled.event = { wpe_input_axis_event_type_motion, touchPoint->time, m_start.x, m_start.y, 0, 0, 0 };
+#endif
+            return cancelled;
+        }
+        m_gesturedEvent = GesturedEvent::None;
+        return NoEvent { };
+    case wpe_input_touch_event_type_motion:
+        if (m_multiTouch || touchPoint->id != m_primaryId)
+            return NoEvent { };
+        break;
+    case wpe_input_touch_event_type_up:
+        m_fingers.removeFirst(touchPoint->id);
+        if (m_multiTouch) {
+            if (m_fingers.isEmpty())
+                m_multiTouch = false;
+            return NoEvent { };
+        }
+        if (touchPoint->id != m_primaryId)
+            return NoEvent { };
+        m_fingers.clear();
+        break;
+    default:
+        break;
+    }
