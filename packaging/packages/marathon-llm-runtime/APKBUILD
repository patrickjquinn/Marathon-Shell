# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# Pilot's llama-server: llama.cpp 0.8.0 with smolmaxxing's patch (pruned LM
# head, Arm kernels, fused DeltaNet), for Qwen3.5 with a head cut for Pilot
# (head-ids-pilot.txt, tools/bench/pilot/pilot_head.py). Beside Alpine's
# llama-server, which stays the fallback: marathon-llm's run picks this one
# when the phone has dot-product instructions and the RAM for it. gguf_recut
# cuts the downloaded model's head on the phone.
pkgname=marathon-llm-runtime
_llamacommit=8642541b255bfb5dc39cd351a178be09013a55d6
_smolcommit=79f860e92289d8480fff6f0e640cf33856783813
pkgver=0.8.0
pkgrel=1
pkgdesc="Pilot's llama.cpp server for its on-device model"
url="https://github.com/hyperionaidev/smolmaxxing"
arch="aarch64"
license="MIT"
makedepends="clang cmake samurai linux-headers"
install_if="marathon-llm"
source="llama.cpp-$_llamacommit.tar.gz::https://github.com/ggml-org/llama.cpp/archive/$_llamacommit.tar.gz
	smolmaxxing-tvbox.patch
	gguf_recut.c
	head-ids-pilot.txt
	LICENSE.smolmaxxing
	"
builddir="$srcdir/llama.cpp-$_llamacommit"
options="!check"

build() {
	# The Arm baseline every phone with dot-product instructions has
	# (Cortex-A55/A76 and later); run checks for them before using it.
	# llama-graph.cpp calls std::nth_element without <algorithm>, which
	# GCC 16's headers no longer bring in on their own.
	export CXXFLAGS="$CXXFLAGS -include algorithm"
	# Clang, tuned for the Cortex-A55, as smolmaxxing builds it (zig cc):
	# with GCC 16 the Q25 read prompts at 29.5 tokens/s instead of 48.8.
	export CC=clang CXX=clang++
	export CFLAGS="$CFLAGS -mtune=cortex-a55" CXXFLAGS="$CXXFLAGS -mtune=cortex-a55"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_CPU_ARM_ARCH=armv8.2-a+dotprod+fp16 \
		-DGGML_OPENMP=OFF \
		-DLLAMA_OPENSSL=OFF \
		-DLLAMA_BUILD_TESTS=OFF
	cmake --build build --target llama-server
	${CC:-gcc} $CFLAGS -O2 -o gguf_recut "$srcdir"/gguf_recut.c $LDFLAGS
}

package() {
	install -Dm755 build/bin/llama-server "$pkgdir"/usr/libexec/marathon-llm/llama-server-pilot
	install -Dm755 gguf_recut "$pkgdir"/usr/libexec/marathon-llm/gguf_recut
	install -Dm644 "$srcdir"/head-ids-pilot.txt "$pkgdir"/usr/share/marathon-llm/head-ids-pilot.txt
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.llama.cpp
	install -Dm644 "$srcdir"/LICENSE.smolmaxxing "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.smolmaxxing
}
