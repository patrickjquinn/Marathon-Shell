# Marathon fork of pmaports' linux-postmarketos-allwinner. Same source and
# patches; the config adds the A64 watchdog (SUNXI_WATCHDOG, fed by systemd
# from marathon-base-config) and the soft/hard lockup detectors with panic,
# so a hung PinePhone reboots by itself instead of staying dark. Hung-task
# detection logs only. pstore/ramoops (region reserved by marathon-boot.cmd)
# keeps the last kernel log across a watchdog or panic reboot, and
# PM_SLEEP_DEBUG adds pm_test, pm_wakeup_irq and suspend timing for
# diagnosing failed resumes. Drop this fork when pmaports enables the same.
# Co-Maintainer: Jan Jasper de Kroon <jajadekroon@gmail.com>
maintainer="Arnav Singh <me@arnavion.dev>"
_flavor=postmarketos-allwinner
_config="config-$_flavor.$CARCH"
pkgname=linux-$_flavor-marathon
pkgver=6.18.3_git20260105
pkgrel=1
_tag="orange-pi-6.18-20260105-0049"
pkgdesc="PinePhone kernel — Marathon fork with the A64 watchdog and lockup detection"
arch="aarch64"
url="https://megous.com/git/linux/"
license="GPL-2.0-only"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
	"
# Replace pmaports' linux-postmarketos-allwinner so device-pine64-pinephone
# installs this kernel; module paths stay 6.18.3 as upstream. r99 outranks
# pmaports' own pkgrel bumps of the same pkgver.
provides="linux-postmarketos-allwinner=$pkgver-r99"
replaces="linux-postmarketos-allwinner"
provider_priority=200
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
source="$pkgname-$_tag.tar.gz::https://github.com/Arnavion/linux/archive/refs/tags/$_tag.tar.gz
	config-$_flavor.aarch64
	0001-dts-add-dontbeevil-pinephone-devkit.patch
	0002-dts-add-pinetab-dev-old-display-panel.patch
	0003-dts-pinetab-add-missing-ohci1.patch
	0004-dts-pinetab-make-audio-routing-consistent-with-pinep.patch
	0005-dts-pinephone-drop-modem-power-node.patch
	0006-drm-panel-simple-Add-Hannstar-TQTM070CB501.patch
	0007-ARM-dts-sun6i-Add-GoClever-Orion-70L-tablet.patch
	0008-drm-panel-simple-Add-Hannstar-HSD070IDW1-A.patch
	0009-ARM-dts-sun6i-Add-Lark-FreeMe-70.2S-tablet.patch
	0010-eMMC-workaround.patch
	0011-arm64-dts-allwinner-orangepi-3-fix-ethernet.patch
	0012-staging-rtl8723cs-fix-CFI-signature-of-rtw_xmit_ent.patch
	"
builddir="$srcdir/linux-$_tag"

case "$CARCH" in
	aarch64*) _carch="arm64" ;;
	arm*) _carch="arm" ;;
esac


prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		CFLAGS_MODULE=-fno-pic \
		DTC_FLAGS="-@"
}

package() {
	make dtbs_install modules_install zinstall \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

