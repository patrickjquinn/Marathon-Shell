# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-hackberrypi-cm5-marathon
pkgdesc="HackberryPi CM5 enclosure layer for Marathon OS (panel + battery + BBQ kbd)"
pkgver=1.0.0
pkgrel=22
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
# Layered on top of the generic Pi 5 / CM5 base. Vanilla Pi 5 / CM5 dev
# boards don't install this; they get device-raspberry-pi5-marathon
# only and the include line in /boot/usercfg.txt silently no-ops.
depends="
	device-raspberry-pi5-marathon
"
# Takes over /etc/marathon/device-profile.conf from the Pi 5 base.
replaces="device-raspberry-pi5-marathon"
makedepends="dtc"
source="
	hackberrypi.dts
	usercfg-hackberrypi.txt
	90-marathon-irq-dwc2.rules
	marathon-irq-dwc2
	marathon-cm5-fuelgauge.conf
	marathon-waydroid.conf
	marathon-waydroid-session
	marathon-waydroid.service
	marathon-waydroid.tmpfiles
	waydroid.cfg
	hackberrypi.modules
	device-profile.conf
	marathon-hackberry-speaker
	marathon-hackberry-speaker.service
	"

build() {
	# Compile the device-tree overlay. We ship .dts (the source of
	# truth) and build .dtbo here so source review catches DT changes,
	# not opaque binary diffs. abuild doesn't auto-create $builddir for
	# noarch-style aports with no archive — make it ourselves.
	mkdir -p "$builddir"
	dtc -@ -I dts -O dtb -o "$builddir/hackberrypi.dtbo" \
		"$srcdir/hackberrypi.dts"
}

package() {
	# Device tree overlay — HyperPixel panel + edt-ft5x06 touch +
	# MAX17048 fuel gauge + pwm-backlight on rp1_pwm0 ch3 / GPIO19.
	install -Dm644 "$builddir/hackberrypi.dtbo" \
		"$pkgdir/boot/overlays/hackberrypi.dtbo"

	# Enclosure-specific config.txt fragment. /boot/usercfg.txt
	# (shipped by device-raspberry-pi5-marathon) ends with
	#   include usercfg-hackberrypi.txt
	# which Pi firmware loads from /boot/. Silently skipped if this
	# file isn't shipped (vanilla CM5 dev board).
	install -Dm644 "$srcdir/usercfg-hackberrypi.txt" \
		"$pkgdir/boot/usercfg-hackberrypi.txt"

	# dwc2 USB IRQ steering, run when the driver binds.
	install -Dm644 "$srcdir/90-marathon-irq-dwc2.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-marathon-irq-dwc2.rules"
	install -Dm755 "$srcdir/marathon-irq-dwc2" \
		"$pkgdir/usr/libexec/marathon-irq-dwc2"

	# Panel, DPI and backlight drivers in the initramfs, so its splash
	# has a framebuffer instead of timing out waiting for /dev/fb0, and
	# the keyboard's USB host (dwc2), so the PIN can be typed there.
	install -Dm644 "$srcdir/hackberrypi.modules" \
		"$pkgdir/usr/share/mkinitfs/modules/10-hackberrypi.modules"

	# The speakers are a Bluetooth module: pair it on first boot.
	install -Dm755 "$srcdir/marathon-hackberry-speaker" \
		"$pkgdir/usr/libexec/marathon-hackberry-speaker"
	install -Dm644 "$srcdir/marathon-hackberry-speaker.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-hackberry-speaker.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -sf ../marathon-hackberry-speaker.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/marathon-hackberry-speaker.service"

	# Force-load the MAX17048 fuel-gauge module at boot. udev modalias
	# matching is unreliable on linux-rpi here (the i2c-gpio bus
	# enumerates after the modules-load.d phase on cold boot).
	install -Dm644 "$srcdir/marathon-cm5-fuelgauge.conf" \
		"$pkgdir/usr/lib/modules-load.d/marathon-cm5-fuelgauge.conf"
	install -Dm644 "$srcdir/marathon-waydroid.conf" \
		"$pkgdir/usr/lib/modules-load.d/marathon-waydroid.conf"

	# Waydroid: seed config ("waydroid init" keeps its properties), and a
	# user unit that runs the session with the host's time zone.
	install -Dm644 "$srcdir/waydroid.cfg" \
		"$pkgdir/usr/share/marathon/waydroid.cfg"
	install -Dm644 "$srcdir/marathon-waydroid.tmpfiles" \
		"$pkgdir/usr/lib/tmpfiles.d/marathon-waydroid.conf"
	install -Dm755 "$srcdir/marathon-waydroid-session" \
		"$pkgdir/usr/libexec/marathon-waydroid-session"
	install -Dm644 "$srcdir/marathon-waydroid.service" \
		"$pkgdir/usr/lib/systemd/user/marathon-waydroid.service"

	# Generated from devices/hackberrypi/cm5/device.toml.
	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf"
}

