#!/bin/sh
# Runs this user's Waydroid session and gives Android the host's time zone.
# MARATHON_WAYDROID names another waydroid launcher (Deckard's).
set -u

# The container is intentionally absent from the boot transaction. Polkit
# permits the active phone user to start this exact unit and nothing else.
: > "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/marathon-waydroid-requested"
systemctl start waydroid-container.service || exit 1

"${MARATHON_WAYDROID:-waydroid}" session start &
session=$!

booted=
for _ in $(seq 180); do
	kill -0 "$session" 2>/dev/null || exit 1
	if [ "$(waydroid prop get sys.boot_completed 2>/dev/null)" = 1 ]; then
		booted=1
		break
	fi
	sleep 1
done

tz=$(timedatectl show -p Timezone --value 2>/dev/null)
if [ -n "$booted" ] && [ -n "$tz" ]; then
	waydroid prop set persist.sys.timezone "$tz"
fi

wait "$session"
