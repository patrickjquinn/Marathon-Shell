# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-purism-librem5-marathon
pkgdesc="Purism Librem 5 device package for Marathon OS"
pkgver=1.0.0
pkgrel=31
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
# Upstream device-purism-librem5 depends on `pulseaudio<9990` to mark a
# generic-pulseaudio sound stack. apk picks
# `postmarketos-base-ui-audio-backend-pulseaudio` to satisfy it — but
# that package carries `[!pipewire-pulse]` (conflicts-with). Marathon's
# audio stack wants pipewire-pulse (which itself provides=pulseaudio).
# Stub-provide the conflicting package at a sky-high version so apk
# never installs the real one, leaving pipewire-pulse free to satisfy
# the pulseaudio dep cleanly. Same pattern as our unl0kr-agent stub on
# device-raspberry-pi5-marathon's marathon-base-config.
#
# greetd-agreety-config ships /etc/greetd/config.toml which
# marathon-base-config already owns (with our greetd-marathon.toml
# content). Without this stub, apk pulls greetd-agreety-config via the
# upstream device-purism-librem5 dep chain and errors with
# "trying to overwrite etc/greetd/config.toml owned by
# marathon-base-config". Marathon owns the config; greetd-agreety
# itself isn't pulled (Marathon doesn't use the agreety greeter — the
# shell IS the greeter via greetd-marathon.toml's autologin command).
provides="
	postmarketos-base-ui-audio-backend-pulseaudio=999.0.0-r0
	greetd-agreety-config=999.0.0-r0
"
# Notes on the depends list:
#   - device-purism-librem5 pulls the upstream pmaports DTBs +
#     deviceinfo for the i.MX 8M Quad Librem 5. We layer Marathon on
#     top rather than overriding it. Note: it would normally pull in
#     the upstream linux-purism-librem5 kernel, but our
#     linux-purism-librem5-marathon dep below provides+replaces it at
#     a higher provider_priority so apk picks our patched build.
#   - linux-purism-librem5-marathon: our fork of pmaports'
#     linux-purism-librem5 carrying a kCFI fix for the out-of-tree
#     Silicon Labs RS9116 redpine driver. Without that patch, three
#     kthreads die at module load (CFI signature mismatch) and wlan0
#     never registers. See the package's APKBUILD header.
#   - u-boot-librem5 ships /usr/share/u-boot/librem5/phone-boot.img.
#     Both the on-device boot flow AND the host-side `flash-librem5.sh
#     emmc` path need this artifact.
#   - The Librem 5's BroadMobi BM818 modem is handled by
#     ModemManager's `broadmobi` plugin (in mainline MM since 1.12)
#     out of the box — NO eg25-manager. eg25-manager is the Quectel
#     EG25-G state machine for PinePhone / PinePhone Pro and does not
#     apply here. Earlier r2 of this aport incorrectly depended on
#     eg25-manager + enabled it in post-install; removed in r3.
#   - iwd intentionally absent — NetworkManager uses wpa_supplicant.
#     iwd auto-enables a colliding nl80211 client. Same boundary as
#     device-raspberry-pi5-marathon r7.
#   - The rest of the runtime stack mirrors device-oneplus-enchilada-
#     marathon line-for-line to keep the device experiences in sync.
depends="
	device-purism-librem5
	device-purism-librem5-nonfree-firmware
	firmware-siliconlabs-rs9116
	linux-purism-librem5-marathon
	u-boot-librem5
	u-boot-tools
	librem5-vivante-blobs
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	greetd
	greetd-systemd
	networkmanager
	networkmanager-wifi
	networkmanager-cli
	modemmanager
	mobile-broadband-provider-info
	upower
	wireless-tools
	wpa_supplicant
	bluez
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
	linux-firmware-imx
"
makedepends=""
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	greetd-l5-env.conf
	eglfs-kms.json
	journald-l5.conf
	marathon-boot.cmd
	marathon-wifi-recovery.sh
	marathon-wifi-recovery.service
	95-marathon-wifi-rfkill.rules
	90-marathon-modem-wakeup.rules
	50-marathon-l5-default-sink.conf
	marathon-modem-location.service
	marathon-cellular.nmconnection
	device-profile.conf
	marathon-gpu.modprobe.conf
	marathon-gpu-select.sh
	marathon-gpu-select.service
	"

package() {
	# Install greetd config for Marathon Shell autologin. The actual
	# greetd.service unit comes from the greetd-systemd subpackage we
	# depend on — don't ship our own (r4 did and apk errored:
	# `device-purism-librem5-marathon: trying to overwrite usr/lib/
	# systemd/system/greetd.service owned by greetd-systemd`).
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# Install logind config to let Marathon Shell handle power button
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"

	# Qt EGLFS_KMS JSON config — only sanctioned way to pick a DRM
	# device per Qt6 docs. Read by marathon-shell-bin via the
	# QT_QPA_EGLFS_KMS_CONFIG env var (set in the greetd drop-in).
	install -Dm644 "$srcdir/eglfs-kms.json" \
		"$pkgdir/etc/marathon/eglfs-kms.json"

	# Device profile — the shell (DeviceProfile) and marathon-shell-session
	# read this to pick GPU stack / GLES level / render node / governor for
	# the Librem 5. Matches the shell's built-in defaults today; flip
	# GPU_STACK/GLES_LEVEL when the Vivante blob overlay is installed.
	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf"

	# greetd service drop-in: point Qt at the JSON above so EGLFS_KMS
	# opens /dev/dri/card1 (LCDIF + DSI panel) instead of card0
	# (etnaviv render-only).
	install -Dm644 "$srcdir/greetd-l5-env.conf" \
		"$pkgdir/etc/systemd/system/greetd.service.d/10-marathon-l5.conf"

	# Persistent journald on L5 (overrides marathon-base-config's
	# volatile journal during early bring-up so post-mortem logs survive
	# the next reboot).
	install -Dm644 "$srcdir/journald-l5.conf" \
		"$pkgdir/etc/systemd/journald.conf.d/90-marathon-l5.conf"

	# CPU governor: marathon-base-config's 60-marathon-cpufreq.rules
	# sets schedutil. The L5 keeps that default — the previous
	# 99-marathon-cpufreq-l5.rules pinned `performance` to (allegedly)
	# fix Marathon's cold-start lag, but left the device welded at
	# 1.5 GHz on the lockscreen 24/7 (battery 56 °C, ~5× idle drain).
	# Removed 2026-06-30 — if cold-start lag returns, tune schedutil's
	# rate_limit_us or fall through to ondemand, do NOT re-pin perf.

	# Mask iio-sensor-proxy.service: the lsm9ds1 accel driver hangs in
	# st_lsm6dsx_read_raw on this hardware. iio-sensor-proxy independently
	# wedges in kernel D-state polling that driver, accumulates context
	# switches forever, and pegs load avg ~1.0. We blacklist the driver
	# at kernel cmdline (see marathon-boot.cmd) AND mask the service so
	# nothing tries to re-instantiate orientation work. The mask is a
	# symlink to /dev/null per systemd convention.
	install -d "$pkgdir/etc/systemd/system"
	ln -sf /dev/null "$pkgdir/etc/systemd/system/iio-sensor-proxy.service"

	# Marathon-customized U-Boot boot script source. Compiled to
	# /boot/boot.scr by mkosi.finalize (which has u-boot-tools
	# available via the u-boot-librem5 dep chain). Upstream
	# u-boot-librem5 ships a minimal boot.cmd that omits `splash`,
	# `quiet`, and `console=tty1` — Plymouth never engages and kernel
	# msgs flood tty. Marathon replaces it at finalize time.
	install -Dm644 "$srcdir/marathon-boot.cmd" \
		"$pkgdir/usr/share/marathon/marathon-boot.cmd"

	# RS9116 wifi recovery — the in-kernel SDIO probe on mmc1
	# occasionally times out at boot (-110 ETIMEDOUT) and the kernel
	# does not retry, so wlan never enumerates. The script tries to
	# unbind+rebind the sdhci-esdhc-imx driver to re-run the pwrseq
	# and re-probe the chip. The service runs once at boot; the udev
	# rule re-runs it when the user toggles the wifi kill switch
	# off→on, so the documented physical recovery actually works.
	install -Dm755 "$srcdir/marathon-wifi-recovery.sh" \
		"$pkgdir/usr/lib/marathon/marathon-wifi-recovery.sh"
	install -Dm644 "$srcdir/marathon-wifi-recovery.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-wifi-recovery.service"
	install -Dm644 "$srcdir/95-marathon-wifi-rfkill.rules" \
		"$pkgdir/usr/lib/udev/rules.d/95-marathon-wifi-rfkill.rules"

	# Modem USB autosuspend/wakeup enable (PWR-6). Without `wakeup=enabled`
	# the kernel refuses to runtime-suspend the modem (suspended device
	# can't wake host without a wake source). Result is the modem stays
	# `runtime_status: active` 99% of uptime with ~36 xhci interrupts/sec
	# and ~0.1-0.2 W continuous draw. Rule lets the modem suspend between
	# tower polls while still being able to wake on incoming traffic.
	install -Dm644 "$srcdir/90-marathon-modem-wakeup.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-marathon-modem-wakeup.rules"

	# Auto-enable the service at first boot. The systemd preset gets
	# applied by marathon-base-config's preset file or directly via
	# this symlink.
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -sf ../marathon-wifi-recovery.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/marathon-wifi-recovery.service"

	# Enable ModemManager GPS location sources at boot so geoclue + the
	# shell LocationManager have a position source (Maps, weather, etc).
	# The modem ships with location gathering disabled by default.
	# Enabled via `systemctl enable` in .post-install (same as the other
	# services) so `is-enabled` reports correctly.
	install -Dm644 "$srcdir/marathon-modem-location.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-modem-location.service"

	# Autoconnect cellular data profile. gsm.auto-config=true resolves the
	# APN from mobile-broadband-provider-info by the SIM operator, so LTE
	# data works out of the box with no manual APN entry — and stays a
	# fallback below Wi-Fi (route-metric 700 vs Wi-Fi's 600). NM ignores
	# system-connection keyfiles that aren't 0600 root-owned.
	install -Dm600 "$srcdir/marathon-cellular.nmconnection" \
		"$pkgdir/etc/NetworkManager/system-connections/marathon-cellular.nmconnection"

	# Wireplumber rule: prefer built-in speaker over HDMI for the
	# default sink. Without it the L5 boots routing every system
	# sound to the (usually unconnected) HDMI port and the user
	# hears silence. /etc/wireplumber/wireplumber.conf.d/ is the
	# canonical drop-in path read by wireplumber 0.5+.
	install -Dm644 "$srcdir/50-marathon-l5-default-sink.conf" \
		"$pkgdir/etc/wireplumber/wireplumber.conf.d/50-marathon-l5-default-sink.conf"

	# GPU driver arbitration (etnaviv vs Vivante galcore). The GC7000Lite
	# can only be bound by one at a time; udev must not autoload either
	# (the modprobe blacklist) — marathon-gpu-select.service picks the one
	# named by GPU_STACK in device-profile.conf at boot, before greetd, with
	# a hard fallback to etnaviv so a bad Vivante state can never wedge the
	# device. See docs/DEVICE_OVERLAYS.md.
	install -Dm644 "$srcdir/marathon-gpu.modprobe.conf" \
		"$pkgdir/etc/modprobe.d/marathon-gpu.conf"
	install -Dm755 "$srcdir/marathon-gpu-select.sh" \
		"$pkgdir/usr/lib/marathon/marathon-gpu-select.sh"
	install -Dm644 "$srcdir/marathon-gpu-select.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-gpu-select.service"
	# Enable it via a shipped wants-symlink, NOT a post-install
	# `systemctl enable` — the latter is a no-op in the mkosi buildroot
	# (no running systemd), same as marathon-wifi-recovery above. Without
	# this, etnaviv (blacklisted in marathon-gpu.conf) never loads and the
	# shell falls back to software render.
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -sf ../marathon-gpu-select.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/marathon-gpu-select.service"
}

