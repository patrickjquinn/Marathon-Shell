From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Tue, 24 Nov 2026 19:59:20 +0000
Subject: [PATCH 43/43] arm64: dts: mediatek: mp01: Light the keyboard

The MP01's keyboard light hangs off the AW9523B that scans the keys.
The stock driver lights it by writing the same level to the LED current
registers of P0_0, P0_1, P1_0 and P1_1, at the chip's full 37 mA, so
describe one keyboard backlight LED on those four outputs.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6789-minimal-mp01.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6789-minimal-mp01.dts b/arch/arm64/boot/dts/mediatek/mt6789-minimal-mp01.dts
index 2c1d72c..4806284 100644
--- a/arch/arm64/boot/dts/mediatek/mt6789-minimal-mp01.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6789-minimal-mp01.dts
@@ -971,6 +971,15 @@
 		pinctrl-0 = <&keyboard_pins>;
 		/* The driver drives RSTN's level: high runs the chip. */
 		reset-gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* The keyboard light: P0_0, P0_1, P1_0 and P1_1, lit together. */
+		led@0 {
+			reg = <0>;
+			led-sources = <0>, <1>, <8>, <9>;
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+		};
 	};
 };
 
