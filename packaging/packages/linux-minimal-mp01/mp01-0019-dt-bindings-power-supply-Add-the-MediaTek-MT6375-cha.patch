From 6d27fd624d321398fc46316762815d271acf7bbd Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Mon, 23 Nov 2026 22:00:00 +0000
Subject: [PATCH 1/5] dt-bindings: power: supply: Add the MediaTek MT6375
 charger

The MT6375 SubPMIC has a single cell switching charger with BC1.2 port
detection. Its limits come from the battery it charges, so the node
needs only its monitored battery; its interrupts come from the MT6375
itself, which the parent device hands out.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 .../power/supply/mediatek,mt6375-charger.yaml | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml b/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml
new file mode 100644
index 0000000..6054dc0
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6375-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 Battery Charger
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The switching charger of the MT6375 SubPMIC. It charges a single cell
+  battery within the limits of its monitored battery and detects the type
+  of USB port it is attached to with BC1.2. Its interrupts come from the
+  MT6375 itself.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6375-charger
+
+  monitored-battery: true
+
+required:
+  - compatible
+  - monitored-battery
+
+unevaluatedProperties: false
-- 
