From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Sun, 22 Nov 2026 21:00:00 +0000
Subject: [PATCH] dt-bindings: display: panel: Add the Minimal Z10 e-paper
 display

Add the 4.3" 600x800 e-paper display of the Minimal Phone MP01. A Pango
CPLD takes 800x600 DSI video on four lanes and drives the panel. Its I2C
port selects the waveform and clears the panel, so the I2C device is the
node and the DSI input is its port, the way I2C-controlled DSI bridges are
described. The CPLD and the panel are one unit, which is why this is a
panel and not a bridge followed by a panel.

The CPLD's three rails are separate GPIO load switches on the board, so
they are described as supplies.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 Documentation/devicetree/bindings/display/panel/minimal,z10-eink.yaml |  88 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/minimal,z10-eink.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/minimal,z10-eink.yaml b/Documentation/devicetree/bindings/display/panel/minimal,z10-eink.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/minimal,z10-eink.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/minimal,z10-eink.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Minimal Company Z10 4.3" e-paper display module
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description: |
+  The 600x800 electrophoretic display of the Minimal Phone MP01 (Z10). A
+  Pango PGC4KL CPLD receives the picture as MIPI DSI video, 800x600 on four
+  data lanes at a nominal 60 Hz, and drives the e-paper waveforms itself:
+  it updates the panel wherever the incoming frames change. Its I2C port
+  takes the waveform choice and a clear command; that port is the node
+  described here, and the DSI input is its port.
+
+  The CPLD also has a configuration interface on the same I2C address that
+  can erase and reprogram its flash. Nothing in this binding describes or
+  enables it.
+
+  The module is scanned out in landscape and mounted in portrait, so
+  boards set rotation.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: minimal,z10-eink
+
+  reg:
+    maxItems: 1
+
+  vdd12-supply:
+    description: 1.2 V module supply
+
+  vdd18-supply:
+    description: 1.8 V module supply
+
+  vdd33-supply:
+    description: 3.3 V module supply
+
+  reset-gpios: true
+  backlight: true
+  rotation: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vdd12-supply
+  - vdd18-supply
+  - vdd33-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        display@4b {
+            compatible = "minimal,z10-eink";
+            reg = <0x4b>;
+
+            vdd12-supply = <&eink_vdd12>;
+            vdd18-supply = <&eink_vdd18>;
+            vdd33-supply = <&eink_vdd33>;
+            reset-gpios = <&pio 85 GPIO_ACTIVE_LOW>;
+            backlight = <&frontlight>;
+            rotation = <90>;
+
+            port {
+                eink_in: endpoint {
+                    remote-endpoint = <&dsi_out>;
+                };
+            };
+        };
+    };
+...
-- 
