# The MP01's differences from config-zinwa-q25.aarch64.
CONFIG_LOCALVERSION="-mp01"
# Keyboard: AW9523B GPIO expander scanned by gpio-matrix-keypad.
CONFIG_PINCTRL_AW9523=m
CONFIG_KEYBOARD_MATRIX=m
# FocalTech FT5446U touchscreen.
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
# NXP PN8x NFC controller.
CONFIG_NFC_NXP_NCI=m
CONFIG_NFC_NXP_NCI_I2C=m
# Frontlight on DISP_PWM.
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=m
CONFIG_BACKLIGHT_PWM=m
# The phone has no UART and no early display: keep the console in the
# ramoops region LK reserves, built in so an early crash is caught.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# The e-paper module: a Pango CPLD fed over DSI, controlled over I2C.
CONFIG_DRM_PANEL_MINIMAL_Z10_EINK=m
