 drivers/gpu/drm/panel/Kconfig                                 |  12 ++++++++++++
 drivers/gpu/drm/panel/Makefile                                |   1 +
 drivers/gpu/drm/panel/panel-minimal-z10-eink.c                | 575 ++++++++++++++++++++++++++++++++++++++++
 5 files changed, 623 insertions(+)
 create mode 100644 Documentation/ABI/testing/sysfs-driver-panel-minimal-z10-eink
