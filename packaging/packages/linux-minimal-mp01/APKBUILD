# Minimal Phone MP01 (board Z10) kernel: the MT6789 tree linux-zinwa-q25
# builds (ellyq's mtk_g99-mainline at 978b8b67), with the SoC and MT6366
# patches of that package's series taken by reference ($_mt6789, applied
# without their Zinwa Q25 board-DTS hunks), then this package's mp01-*
# series and config fragment, plus the CONNSYS, modem and audio modules of
# linux-zinwa-q25/modules built for this board. devices/minimal/mp01/kernel/
# README.md says what is shared, what is board, and what is untested.
pkgname=linux-minimal-mp01
pkgver=7.0.0
pkgrel=0
_commit=978b8b672d68e43b08c891132b974255489889aa
_mindone=9cd73c15f312cfd1e40a22d871de65a2fb2c5791
_sound=996ec48145f6746ecc664e92c6e5892b6978e3ae
_gigaset=6a574a88769691ee4d1da23c80226cf5e237f607
_afe="
