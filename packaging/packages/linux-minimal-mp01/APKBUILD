	android_kernel_ikko_mindone-$_mindone.tar.gz::https://github.com/iasnezhkov/android_kernel_ikko_mindone/archive/$_mindone.tar.gz
	android_kernel_gigaset_mt6789-extras-$_gigaset.tar.gz::https://github.com/Gigaset-dev/android_kernel_gigaset_mt6789-extras/archive/$_gigaset.tar.gz
