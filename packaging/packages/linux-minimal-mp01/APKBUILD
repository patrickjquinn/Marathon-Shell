for _f in $_mt6789; do
	source="$source $_q25/$_f"
done
for _f in $_afe; do
	source="$source $_f::https://raw.githubusercontent.com/linux-mediatek/linux/$_sound/sound/soc/mediatek/mt6789/$_f"
done
builddir="$srcdir/mtk_g99-mainline-$_commit"
_dtb=mediatek/mt6789-minimal-mp01.dtb

unpack() {
	tar -C "$srcdir" -xzf "$SRCDEST/mtk_g99-mainline-$_commit.tar.gz"
	tar -C "$srcdir" -xzf "$SRCDEST/android_kernel_ikko_mindone-$_mindone.tar.gz" \
		"android_kernel_ikko_mindone-$_mindone/mindone/modules"
	tar -C "$srcdir" -xzf "$SRCDEST/android_kernel_gigaset_mt6789-extras-$_gigaset.tar.gz" \
		"android_kernel_gigaset_mt6789-extras-$_gigaset/connectivity/fmradio"
}

prepare() {
	cd "$builddir"
	local p
	# Without their hunks to the Q25's board DT, which only its package builds.
	for p in $_mt6789; do
		msg "$p"
		awk '/^diff /{skip = index($0, "mt8781-zinwa-q25.dts") > 0} !skip' \
			"$srcdir/$p" | patch -p1 -N --no-backup-if-mismatch
	done
	for p in $_board; do
		msg "$p"
		patch -p1 -N --no-backup-if-mismatch -i "$srcdir/$p"
	done
	cp "$srcdir/config-zinwa-q25.aarch64" .config
	ARCH=arm64 scripts/kconfig/merge_config.sh -m .config \
		"$srcdir/config-minimal-mp01.fragment"
	make ARCH=arm64 LLVM=1 olddefconfig
	local afe="$srcdir/mt6789-sound/sound/soc/mediatek/mt6789" f
	mkdir -p "$afe"
	for f in $_afe; do
		cp "$srcdir/$f" "$afe/"
	done
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH")"
	make ARCH=arm64 LLVM=1 Image vmlinuz.efi modules $_dtb
	[ "$(cat include/config/kernel.release)" = "$_release" ]
	_vendor_dtb
	BOARD=mp01 MT6789_SOUND="$srcdir/mt6789-sound" JOBS="${JOBS:-2}" \
		FMRADIO="$srcdir/android_kernel_gigaset_mt6789-extras-$_gigaset/connectivity/fmradio" \
		sh "$startdir/$_q25/modules/build.sh" "$builddir" "$builddir" \
		"$srcdir/android_kernel_ikko_mindone-$_mindone" "$srcdir/mp01-modules"
}

# The board DTB with the vendor-driver nodes merged in, for images that
# ship mp01-kernel-modules; the modem overlay is built but not merged.
_vendor_dtb() {
	local o="$srcdir/overlays" d
	mkdir -p "$o"
	for d in mp01-connsys mp01-modem; do
		cpp -nostdinc -undef -x assembler-with-cpp -P -I include \
			"$srcdir/$d.dtso" > "$o/$d.dts"
		scripts/dtc/dtc -q -@ -I dts -O dtb -o "$o/$d.dtbo" "$o/$d.dts"
	done
	fdtoverlay -i arch/arm64/boot/dts/$_dtb -o "$o/mt6789-minimal-mp01-vendor.dtb" \
		"$o/mp01-connsys.dtbo"
}

package() {
	make ARCH=arm64 LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/usr/lib/modules/$_release/build
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/linux.efi
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/Image "$pkgdir"/usr/lib/modules/$_release/vmlinuz
	install -Dm644 arch/arm64/boot/dts/$_dtb "$pkgdir"/boot/dtbs/$_dtb
	install -Dm644 "$srcdir"/overlays/mt6789-minimal-mp01-vendor.dtb \
		"$pkgdir"/boot/dtbs/mediatek/mt6789-minimal-mp01-vendor.dtb
	install -Dm644 include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/minimal-mp01/kernel.release
}

# Out-of-tree modules by directory under extra/; every built module is listed.
_connsys="connadp btif_drv wmt_drv wmt_chrdev_wifi wlan_drv_gen4m_6789
	q25-btmtk-stp mtk-connsys-gnss fmradio_drv_mt6631_6635"
_audio="snd-soc-mt6358 snd-soc-mtk-common snd-soc-mt6789-afe
	q25-mt6366-card q25-mt6358-accdet"
_modem="ccci_util_lib ccmni ccci_md_all ccci_ccif ccci_dpmaif"

_modules() {
	pkgdesc="Minimal Phone MP01 out-of-tree drivers for linux-minimal-mp01"
	depends="kmod $pkgname=$pkgver-r$pkgrel"
	local out="$srcdir/mp01-modules" extra="$subpkgdir/usr/lib/modules/$_release/extra"
	local d m n=0
	for d in connsys audio modem; do
		local list
		eval "list=\$_$d"
		for m in $list; do
			install -Dm644 "$out/modules/$m.ko" "$extra/mp01-$d/$m.ko"
			n=$((n + 1))
		done
	done
	[ "$n" = "$(ls "$out"/modules/*.ko | wc -l)" ]
	install -Dm644 "$srcdir"/overlays/mp01-modem.dtbo \
		"$subpkgdir"/usr/lib/firmware/mp01-modem.dtbo
}

