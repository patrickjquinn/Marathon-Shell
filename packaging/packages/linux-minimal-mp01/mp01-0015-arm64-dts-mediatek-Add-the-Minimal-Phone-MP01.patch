+&pio {
+	disp_pwm_pins: disp-pwm-default-state {
+		pins-pwm {
+			pinmux = <PINMUX_GPIO84__FUNC_DISP_PWM>;
+		};
+	};
+
+	keypad_pins: keypad-default-state {
+		pins-cols {
+			pinmux = <PINMUX_GPIO66__FUNC_KPCOL0>,
+				 <PINMUX_GPIO67__FUNC_KPCOL1>;
+			input-enable;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+
+	keyboard_pins: keyboard-default-state {
+		pins-irq {
+			pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	touchscreen_pins: touchscreen-default-state {
+		pins-irq {
+			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+};
+
+/* FocalTech FT5446U, 600x800 in the panel's portrait orientation. */
+&i2c0 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	touchscreen@38 {
+		compatible = "focaltech,ft5426";
+		reg = <0x38>;
+		interrupts-extended = <&pio 9 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchscreen_pins>;
+		reset-gpios = <&pio 152 GPIO_ACTIVE_LOW>;
+		touchscreen-size-x = <600>;
+		touchscreen-size-y = <800>;
+	};
+};
+
+/* NXP PN8x NCI controller; GPIO12 is its VEN line (see the board README). */
+&i2c3 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	nfc@28 {
+		compatible = "nxp,nxp-nci-i2c";
+		reg = <0x28>;
+		interrupts-extended = <&pio 1 IRQ_TYPE_EDGE_RISING>;
+		enable-gpios = <&pio 12 GPIO_ACTIVE_HIGH>;
+		firmware-gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&i2c6 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	/* The keyboard matrix scanner; INTN is the only user of GPIO5. */
+	keyboard_expander: gpio@5b {
+		compatible = "awinic,aw9523-pinctrl";
+		reg = <0x5b>;
+		interrupts-extended = <&pio 5 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&keyboard_expander 0 0 16>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&keyboard_pins>;
+		/* The driver drives RSTN's level: high runs the chip. */
+		reset-gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * The panel module: a Pango controller that takes the DSI video and drives
+ * the e-paper, controlled over I2C at its factory 1 MHz. It registers its
+ * DSI device on the host its port leads to.
+ */
+&i2c7 {
+	clock-frequency = <1000000>;
+	status = "okay";
+
+	display@4b {
+		compatible = "minimal,z10-eink";
+		reg = <0x4b>;
+		vdd12-supply = <&epd_1v2>;
+		vdd18-supply = <&epd_1v8>;
+		vdd33-supply = <&epd_3v3>;
+		reset-gpios = <&pio 85 GPIO_ACTIVE_LOW>;
+		backlight = <&frontlight>;
+		rotation = <270>;
+
+		port {
+			eink_in: endpoint {
+				remote-endpoint = <&dsi_out>;
+			};
+		};
+	};
+};
+
+/* Volume down and the refresh key between the volume keys. */
+&keypad {
+	pinctrl-names = "default";
+	pinctrl-0 = <&keypad_pins>;
+	keypad,num-rows = <1>;
+	keypad,num-columns = <2>;
+	debounce-delay-ms = <32>;
+	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)
+			MATRIX_KEY(0, 1, KEY_REFRESH)>;
+	status = "okay";
+};
+
+&mfg0 {
+	domain-supply = <&mt6366_vsram_gpu_reg>;
+};
+
+&mfg1 {
+	domain-supply = <&mt6366_vgpu_reg>;
+};
+
+&gpu {
+	mali-supply = <&mt6366_vgpu_reg>;
+	status = "okay";
+};
+
+&ufsphy {
+	status = "okay";
+};
+
+&ufs {
+	vcc-supply = <&mt6366_vemc_reg>;
+	status = "okay";
+};
