+/*
+ * 800x600 RGB888 video on four lanes, data lanes 2 and 3 crossed on the
+ * board (the vendor's lane_swap table).
+ */
+&dsi0 {
+	status = "okay";
+
+	port {
+		dsi_out: endpoint {
+			remote-endpoint = <&eink_in>;
+			data-lanes = <1 2 4 3>;
+		};
+	};
+};
