# postmarketOS's systemd build of UPower plus one patch: power_supply
# devices that udev tags UPOWER_IGNORE=1 are not enumerated. The Q25's
# bq256xx charger registers a second, unusable battery next to the gauge;
# device-zinwa-q25-marathon tags it. Untagged systems behave as before.
# It replaces upower and upower-systemd; keep pkgver with postmarketOS's.
pkgname=upower-q25
pkgver=1.91.0
pkgrel=0
pkgdesc="Power Management Services, with udev UPOWER_IGNORE support"
url="https://upower.freedesktop.org"
arch="aarch64"
license="GPL-2.0-or-later"
provides="upower=9999$pkgver-r99 upower-systemd=9999$pkgver-r99"
provider_priority=200
replaces="upower upower-systemd"
makedepends="
	docbook-xsl
	glib-dev
	gobject-introspection-dev
	gtk-doc
	libgudev-dev
	libxslt
	meson
	udev-dev
	polkit-dev
	"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang"
options="!check"
source="https://gitlab.freedesktop.org/upower/upower/-/archive/v$pkgver/upower-v$pkgver.tar.gz
	0001-linux-skip-power-supplies-tagged-UPOWER_IGNORE.patch
	"
builddir="$srcdir/upower-v$pkgver"

build() {
	abuild-meson \
		-Dudevhwdbdir=/usr/lib/udev/hwdb.d/ \
		-Dudevrulesdir=/usr/lib/udev/rules.d \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Dman=true \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	rm -rf "$pkgdir/usr/libexec/upower/" \
		"$pkgdir/usr/share/installed-tests/"
}

