6d740304978f9e74c669beb6e6aef28e796e79ad804959dd32b398500333596417de33085d1cb905a5b8e4a97aec42676aa53a961d80d4201edb10bd467d2734  0001-linux-skip-power-supplies-tagged-UPOWER_IGNORE.patch
"
