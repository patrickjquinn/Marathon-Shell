[Unit]
Description=Marathon — MM + I/O scheduler tuning
# Applies verified Pixel-parity kernel tunings from AOSP init.hardware.rc:
#   vm.swappiness = 100  (was 180 default from pmOS — too aggressive)
#   vm.page-cluster = 0  (single-page swap for zram — already set)
#   eMMC scheduler = mq-deadline (Kyber is not the AOSP-inherited choice)
#
# The XDA folklore knobs (watermark_scale_factor=200, sched_migration_cost_ns
# etc.) do NOT appear in any Pixel init.hardware.rc — they are not applied.
# See docs/UI_DESIGN_SYSTEM.md §12 for the research trail.
DefaultDependencies=no
After=local-fs.target
Before=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
  echo 100 > /proc/sys/vm/swappiness; \
  echo 0   > /proc/sys/vm/page-cluster; \
  modprobe mq-deadline 2>/dev/null || true; \
  for q in /sys/block/mmcblk0/queue/scheduler; do \
    grep -q mq-deadline "$q" && echo mq-deadline > "$q"; \
  done; \
  true'

[Install]
WantedBy=multi-user.target
