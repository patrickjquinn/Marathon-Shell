# The shell source is this repo. scripts/qemu/lib/build-marathon-shell-apk.sh
# stages the working tree into /var/cache/distfiles as
# marathon-shell-$pkgver.tar.gz and re-runs `abuild -F checksum`, so the URL
# below is NEVER fetched on the normal build path — what ships is the tree you
# built from. The URL exists only so a standalone `abuild` outside that script
# still resolves. It tracks a moving branch and is therefore NOT reproducible:
# prefer the build script, or pin this to a commit before relying on it.
source="
	$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/ux-overhaul.tar.gz
	asyncfuture.tar.gz::https://github.com/vpicaver/asyncfuture/archive/master.tar.gz
	marathon-shell-session
	marathon-touchctl
	marathon-shell-oom-pin
	systemd/marathon-shell-oom.service
	marathon-iw-setcap.service
	marathon-cpu-governor.service
	marathon-mm-tune.service
	pam-marathon-shell
	90-backlight.rules
	99-marathon-rtprio.conf
	marathon-shell-tmpfiles.conf
	"
builddir="$srcdir/Marathon-Shell-main"
options="!check"

prepare() {
	default_prepare

	# Extract asyncfuture submodule.
	# When pmbootstrap --src copies the host repo, third-party/asyncfuture/
	# is already populated from the git submodule, so the tarball unpack
	# is skipped by abuild — in that case the cp would fail. Only copy
	# when the submodule slot is empty.
	mkdir -p "$builddir/third-party/asyncfuture"
	if [ -z "$(ls -A "$builddir/third-party/asyncfuture" 2>/dev/null)" ]; then
		cp -r "$srcdir"/asyncfuture-master/* "$builddir/third-party/asyncfuture/"
	fi

	# Note: do NOT inject NO_CACHEGEN into qt6_add_qml_module() blocks.
	# r184 and earlier did, to save peak build RAM, but that ships the
	# .apk without .qmlc bytecode and every QML file gets parsed + JIT-
	# compiled at runtime on the device's CPU. On i.MX 8M Quad that
	# means each OOBE page transition is paying full V4 JIT cost on
	# already-saturated cores — measurable contributor to the r11/r12
	# perf complaints. The build host has enough RAM; let Qt cachegen
	# do its job.

	# EMERGENCY FIX: strip heavy assets from resources.qrc to prevent OOM during ARM build
	sed -i '/sounds\//d' "$builddir/shell/resources.qrc"
	sed -i '/wallpapers\//d' "$builddir/shell/resources.qrc"

	find "$builddir" -exec touch {} +
}

build() {
	cd "$builddir"
	rm -rf build build-apps build-dmabuf

	# Disable QML cache to reduce memory usage during build
	export QML_DISABLE_DISK_CACHE=1
	export QT_DISABLE_QML_CACHE=1

	# Release build with -O3 + auto-vectorisation. NEON is mandatory in
	# ARMv8 (always on aarch64), so the win comes from -ftree-vectorize
	# firing on hot loops the size-target -Os would have left scalar.
	# -ffp-contract=fast lets GCC fuse mul+add into FMA where the
	# hardware supports it (Cortex-A76 and Kryo-385 both do).
	local _opt_flags="-O3 -DNDEBUG -ftree-vectorize -ffp-contract=fast"

	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$_opt_flags" \
		-DCMAKE_CXX_FLAGS_RELEASE="$_opt_flags" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_BUILD_RPATH=TRUE \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE \
		-DCMAKE_INSTALL_RPATH=\$ORIGIN \
		-DQt6_DIR=/usr/lib/cmake/Qt6
	cmake --build build

	cmake -B build-apps -S apps -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$_opt_flags" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DMARATHON_APPS_DIR=/usr/share/marathon-apps \
		-DCMAKE_SKIP_BUILD_RPATH=TRUE \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE \
		-DCMAKE_INSTALL_RPATH=\$ORIGIN \
		-DQt6_DIR=/usr/lib/cmake/Qt6
	cmake --build build-apps

	# linux-dmabuf-v1 v4 compositor plugin (etnaviv HW app rendering). A
	# standalone Qt client-buffer-integration that advertises the render
	# device via v4 main_device feedback AND imports dmabuf buffers — stock
	# Qt only ships a v3 plugin (no feedback) so Mesa 26.1+ on etnaviv can't
	# discover renderD128 and falls back to llvmpipe (software). Loaded at
	# runtime via QT_WAYLAND_HARDWARE_INTEGRATION=linux-dmabuf-v1. See
	# shell/wayland-plugins/dmabuf-v1/CMakeLists.txt for the C+CXX rationale.
	cmake -B build-dmabuf -S shell/wayland-plugins/dmabuf-v1 -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$_opt_flags" \
		-DCMAKE_CXX_FLAGS_RELEASE="$_opt_flags" \
		-DQt6_DIR=/usr/lib/cmake/Qt6
	cmake --build build-dmabuf
}

package() {
	cd "$builddir"

	# Main shell + apps
	DESTDIR="$pkgdir" cmake --install build
	DESTDIR="$pkgdir" cmake --install build-apps

	# linux-dmabuf-v1 v4 compositor plugin -> Qt's server-side integration dir.
	install -Dm755 build-dmabuf/libqt-wayland-compositor-linux-dmabuf-v1.so \
		"$pkgdir/usr/lib/qt6/plugins/wayland-graphics-integration-server/libqt-wayland-compositor-linux-dmabuf-v1.so"

	# cmake doesn't install app shared libs
	for lib in build-apps/*/lib*.so; do
		if [ -f "$lib" ]; then
			appname=$(basename "$lib")
			install -Dm755 "$lib" "$pkgdir/usr/lib/$appname"
		fi
	done

	for plugindir in build-apps/apps/*/MarathonApp/*; do
		if [ -d "$plugindir" ]; then
			appname=$(basename "$plugindir")
			appname_lower=$(echo "$appname" | tr '[:upper:]' '[:lower:]')
			plugin="$plugindir/lib${appname_lower}plugin.so"
			if [ -f "$plugin" ]; then
				install -Dm755 "$plugin" \
					"$pkgdir/usr/share/marathon-apps/MarathonApp/$appname/$(basename $plugin)"
			fi
			qmldir="$plugindir/qmldir"
			if [ -f "$qmldir" ]; then
				install -Dm644 "$qmldir" \
					"$pkgdir/usr/share/marathon-apps/MarathonApp/$appname/qmldir"
			fi
		fi
	done

	# Optional shell config
	if [ -f "$builddir/marathon-config.json" ]; then
		install -Dm644 "$builddir/marathon-config.json" \
			"$pkgdir/usr/share/marathon-shell/marathon-shell.json"
	fi

	# Session script (overrides whatever upstream cmake install dropped under
	# /usr/local -- make sure /usr/bin/marathon-shell-session is OUR pmOS one).
	install -Dm755 "$srcdir/marathon-shell-session" \
		"$pkgdir/usr/bin/marathon-shell-session"

	# Do NOT setcap marathon-shell-bin. File caps mark the process
	# non-dumpable (kernel sets AT_SECURE=1), which puts libdbus into
	# secure mode — and libdbus's session-bus connect refuses to trust
	# DBUS_SESSION_BUS_ADDRESS from the environment when AT_SECURE is on.
	# Net effect: QDBusConnection::sessionBus().isConnected() returns
	# false, ShellIpcServer can't register org.marathonos.Shell, every
	# app→shell IPC breaks, LocationManager/Telephony/etc all fail.
	#
	# What we give up: writing oom_score_adj < 0 (PERSISTENT_PROC bias);
	# SCHED_RR via cap_sys_nice (was already blocked at cgroup level by
	# user.slice's RT runtime constraint anyway — so the cap was inert).
	# Both losses are acceptable trades for a working session bus.
	#
	# Future: bind a small system-level marathon-shell-oom.service that
	# finds the shell PID and writes oom_score_adj — keeps caps off the
	# binary while restoring OOM ranking.
	:

	# QEMU/test-only synthetic touch driver. Creates a virtual touchscreen
	# via /dev/uinput so the QEMU automation harness can drive real
	# evdev events into libinput → the Wayland compositor, instead of
	# the virtio-tablet "mouse" path which mis-tests touch gestures.
	install -Dm755 "$srcdir/marathon-touchctl" \
		"$pkgdir/usr/bin/marathon-touchctl"

	# OOM-score pinning sidecar (PWR-2). The shell needs oom_score_adj
	# = -800 so apps + services get reaped before the shell itself, but
	# user-instance systemd lacks CAP_SYS_RESOURCE — see the rationale
	# block in marathon-shell-session around "Do NOT setcap" — so we
	# ship a tiny system-level service that polls for the shell PID
	# and writes the score directly. Enabled by post-install.
	install -Dm755 "$srcdir/marathon-shell-oom-pin" \
		"$pkgdir/usr/libexec/marathon-shell-oom-pin"
	install -Dm644 "$srcdir/marathon-shell-oom.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-shell-oom.service"

	# Marathon-Doze needs cap_net_admin on /usr/sbin/iw so the shell
	# (uid 1000) can flip wifi PSM on Doze enter / exit. Set on every
	# boot via a oneshot to survive `apk upgrade iw` (which strips
	# caps). Enabled by the post-install hook.
	install -Dm644 "$srcdir/marathon-iw-setcap.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-iw-setcap.service"

	# Ondemand cpufreq governor — schedutil boosts to max on any
	# RT-task wake, and the L5 stack has ~25 SCHED_FIFO threaded
	# IRQ handlers firing ~1000 IRQs/s. Under schedutil the cluster
	# sits at 1.5 GHz 58.8% of active time (measured 2026-07-01);
	# under ondemand that drops to 11.7%. Estimated 500-800 mW save.
	install -Dm644 "$srcdir/marathon-cpu-governor.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-cpu-governor.service"

	# MM + I/O scheduler boot-time tuning (verified Pixel parity, not
	# XDA folklore). Swappiness 100, page-cluster 0. (I/O scheduler is
	# set by 60-marathon-iosched.rules — udev is the winning mechanism,
	# it re-fires on device add/change and overrides any service write.)
	install -Dm644 "$srcdir/marathon-mm-tune.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-mm-tune.service"

	# Enable the boot-tuning + oom services via /usr symlinks, NOT the
	# post-install `systemctl enable` (which writes /etc symlinks). On
	# the immutable duranium image /etc is a systemd-confext overlay whose
	# runtime .wants symlinks are NOT honored at boot — systemd computes
	# its transaction before/independent of the mutable /etc layer, so an
	# /etc-enabled service silently never starts (verified 2026-07-01:
	# governor stuck at schedutil, swappiness at kernel default, across
	# clean reboots). Baked /usr .wants symlinks ARE honored (same as
	# ModemManager et al). This is the deterministic, immutable-friendly
	# enablement.
	mkdir -p "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	for _svc in marathon-shell-oom marathon-iw-setcap marathon-cpu-governor marathon-mm-tune; do
		ln -sf "../$_svc.service" \
			"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/$_svc.service"
	done

	# PAM stack -- required for screen unlock + biometric auth.
	# Ships under /usr/share/factory/etc/... so Duranium-style immutable
	# images (postmarketOS Duranium) keep /usr verifiable. A tmpfiles.d
	# snippet symlinks the real path into /etc at first boot; on non-
	# immutable images the same symlink exists and resolves through /usr.
	install -Dm644 "$srcdir/pam-marathon-shell" \
		"$pkgdir/usr/share/factory/etc/pam.d/marathon-shell"

	# Backlight udev rule -- non-root brightness control.
	install -Dm644 "$srcdir/90-backlight.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-backlight.rules"

	# rtprio limit so app render threads can elevate to SCHED_RR without
	# requiring per-binary setcap. Also factory-symlinked into /etc.
	install -Dm644 "$srcdir/99-marathon-rtprio.conf" \
		"$pkgdir/usr/share/factory/etc/security/limits.d/99-marathon-rtprio.conf"

	# tmpfiles.d creates the /etc symlinks pointing at the factory files
	# in /usr at first boot. Works identically on Duranium and standard
	# postmarketOS images.
	install -Dm644 "$srcdir/marathon-shell-tmpfiles.conf" \
		"$pkgdir/usr/lib/tmpfiles.d/marathon-shell.conf"

	# MarathonUI ships qmlcachegen bytecode inside each submodule's pure-QML
	# plugin .so; the generated qmldir carries `prefer :/qt/qml/MarathonUI/<Mod>/`
	# to redirect Qt to that compiled copy instead of parsing the loose .qml at
	# every process start. Stripping those lines (the old default) forced Qt to
	# recompile all 9 submodules from source on every app launch -- the primary
	# cause of the ~10s cold-start. Production keeps them so the bytecode is used.
	# The pure-QML plugin loads via the identical mechanism the per-app plugins
	# already use successfully. Set MARATHON_STRIP_QML_PREFER=1 only for the dev
	# hot-deploy loop, where loose-.qml override on-device needs `prefer` gone.
	if [ "${MARATHON_STRIP_QML_PREFER:-0}" = "1" ]; then
		for qmldir in "$pkgdir"/usr/lib/qt6/qml/MarathonUI/*/qmldir; do
			if [ -f "$qmldir" ]; then
				sed -i '/^linktarget /d; /^optional plugin /d; /^prefer /d' "$qmldir"
			fi
		done
	fi

}

