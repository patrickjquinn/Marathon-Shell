[Unit]
Description=Marathon — set cpufreq governor to ondemand
# Marathon-Doze investigation (2026-07-01) discovered that schedutil on
# imx8mq's coupled A53 cluster BOOSTS to max frequency (1.5 GHz) any
# time an RT-priority task wakes. The L5 stack has ~25+ SCHED_FIFO
# threaded IRQ handlers (PMIC, RTC, fuel gauge, touch, wifi/mmc SDIO,
# GPU thread, migration threads) firing ~1000 IRQs/s. Net effect:
# under schedutil the cluster is at 1.5 GHz 58.8% of active time even
# with load < 0.5 — wasting an estimated 500-800 mW continuously.
#
# ondemand doesn't have the RT-boost behavior. It just samples load
# every ~100 ms. Verified live: same 20 s window, 1.5 GHz residency
# drops from 58.8% → 11.7%, min-freq residency rises from 29.8% → 73.5%.
# Doze enter/wake timing unchanged (~300 ms). WiFi ping in Doze
# with PSM on: 10/10 packets, 14-39 ms RTT (same as schedutil).
#
# Downside: 100 ms sampling means UI touch-to-frame latency may add
# up to one sample if the CPU has to ramp from 100 MHz. Not observed
# in visual testing so far. If it becomes a problem, revert to
# schedutil OR patch the kernel's schedutil to skip RT boost for
# non-DL tasks.
DefaultDependencies=no
After=local-fs.target
Before=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo ondemand > "$g" 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target
