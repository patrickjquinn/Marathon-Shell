#!/bin/sh
# marathon-shell post-install
#
# - Refresh ld cache (Marathon ships extra .so libs under /usr/lib).
# - Reload udev so the 90-backlight.rules apply on the running system.
# - setcap cap_sys_nice,cap_sys_resource on marathon-shell-bin:
#     * cap_sys_resource — oom_score_adj=-800 (PERSISTENT_PROC bias)
#     * cap_sys_nice     — QSGRenderThread elevation to SCHED_RR.
#   Setting this in the APKBUILD's package() does work (apk preserves file
#   caps via xattrs since 2.13) but doing it here is belt-and-braces against
#   xattr stripping on weird rootfs (and idempotent).
#
# Note: /etc/security/limits.d/99-marathon-rtprio.conf grants rtprio via
# pam_limits — but the greetd PAM chain (base-session) does NOT include
# pam_limits, so the limits.d file never takes effect for the shell. File
# caps are the only reliable path for RT scheduling here.

if command -v ldconfig >/dev/null 2>&1; then
    ldconfig
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
fi

# DO NOT setcap marathon-shell-bin. File caps break libdbus session bus
# connect (kernel sets AT_SECURE=1 → libdbus secure mode → refuses the
# DBUS_SESSION_BUS_ADDRESS env), which kills shell IPC, LocationManager,
# Telephony, etc. See APKBUILD comment for full reasoning.

# Refresh the AT-SPI bus so accessibility comes up on first boot.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true
fi

# Enable + start the OOM-score pinning sidecar (PWR-2). Polls for
# marathon-shell-bin and writes oom_score_adj=-800 because the
# user-instance systemd that spawns the shell scope can't set
# negative values (no CAP_SYS_RESOURCE in user mode).
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable marathon-shell-oom.service 2>/dev/null || true
    systemctl start marathon-shell-oom.service 2>/dev/null || true
fi

# Enable the iw setcap oneshot so Marathon-Doze's wifi PSM toggle
# works from the shell (uid 1000). Re-runs every boot in case `apk
# upgrade iw` stripped the cap.
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable marathon-iw-setcap.service 2>/dev/null || true
    systemctl start marathon-iw-setcap.service 2>/dev/null || true
fi

# Set cpufreq governor to ondemand — schedutil boosts to max on RT
# task wakes and the L5 has ~25 threaded IRQ handlers running at
# SCHED_FIFO. Ondemand cuts max-freq residency from 58.8% to 11.7%.
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable marathon-cpu-governor.service 2>/dev/null || true
    systemctl start marathon-cpu-governor.service 2>/dev/null || true
fi

# MM + eMMC I/O scheduler tuning (Pixel-parity). Idempotent; runs each
# boot in case another package overwrote the values.
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable marathon-mm-tune.service 2>/dev/null || true
    systemctl start marathon-mm-tune.service 2>/dev/null || true
fi

# Mask power-profiles-daemon if it slipped in via another dep. On
# this hardware the ppd 'balanced'/'power-saver' profiles have a
# PlatformDriver: placeholder — they don't actually change anything.
# Keeping the daemon running just wastes ~1 MB RAM and an idle
# DBus connection. Mask is no-op if ppd isn't installed.
if command -v systemctl >/dev/null 2>&1; then
    systemctl mask power-profiles-daemon.service 2>/dev/null || true
fi

exit 0
