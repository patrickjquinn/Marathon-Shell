#!/bin/sh
# marathon-shell-oom-pin — system-level OOM-score pinning sidecar.
#
# The shell process needs oom_score_adj=-800 (PERSISTENT_PROC bias) so
# systemd-oomd + the kernel OOM killer reap apps and services BEFORE
# reaping the shell itself. The user-instance systemd that spawns the
# shell scope lacks CAP_SYS_RESOURCE, so --property=OOMScoreAdjust=-800
# fails to apply (and the shell never launches if you try). See the
# rationale comment in marathon-shell-session for the full story.
#
# This sidecar runs as root in the system slice, waits for the
# marathon-shell-bin PID, and writes -800 to /proc/<pid>/oom_score_adj.
# It rewrites after every shell restart (greetd's Restart=on-failure or
# a manual `systemctl restart greetd`) without needing greetd to know.
#
# While the shell runs it forks nothing on a timer: inotifyd reports each
# new app cgroup, and a builtin read timeout checks the shell PID every
# 30 s.

set -eu

TARGET_SCORE=-800
CHECK_INTERVAL=30

# Chown newly-created cpu.* controller files on marathon-app cgroups
# to uid 1000. When CgroupManager enables `+cpu` in the marathon.slice
# subtree_control at shell startup, the kernel creates cpu.* files
# on child cgroups with default owner root:root — even though the
# parent slice is delegated to user:user. This blocks the shell's
# uclamp.min write path (mainline "touch boost"). Iterate every poll
# and re-chown the files that are not yet user-owned.
chown_cpu_files() {
    for slice in \
        /sys/fs/cgroup/user.slice/user-*.slice/user@*.service/marathon.slice; do
        [ -d "$slice/marathon-apps" ] || continue
        # Extract the uid from user-<UID>.slice
        uid=${slice#*/user-}
        uid=${uid%%.slice*}
        [ -z "$uid" ] && continue
        find "$slice/marathon-apps" -mindepth 2 -maxdepth 2 \
            -path '*/marathon-app-*/cpu.*' \( -name cpu.uclamp.min -o \
            -name cpu.uclamp.max -o -name cpu.weight -o -name cpu.weight.nice \
            -o -name cpu.max -o -name cpu.max.burst -o -name cpu.idle \) \
            ! -user "$uid" -exec chown "$uid:$uid" {} + 2>/dev/null || true
    done
}

pin() {
    for pid in $(pgrep -f marathon-shell-bin 2>/dev/null); do
        score_path="/proc/$pid/oom_score_adj"
        [ -w "$score_path" ] || continue
        read -r cur < "$score_path" 2>/dev/null || cur="?"
        if [ "$cur" != "$TARGET_SCORE" ]; then
            echo "$TARGET_SCORE" > "$score_path" 2>/dev/null || continue
            logger -t marathon-shell-oom \
                "pinned PID $pid oom_score_adj $cur → $TARGET_SCORE"
        fi
        echo "$pid"
        return
    done
}

events=/run/marathon-shell-oom-pin.fifo
while true; do
    pinned=$(pin)
    apps=$(echo /sys/fs/cgroup/user.slice/user-*.slice/user@*.service/marathon.slice/marathon-apps)
    if [ -z "$pinned" ] || [ ! -d "$apps" ]; then
        sleep 2
        continue
    fi
    chown_cpu_files
    rm -f "$events"
    mkfifo "$events"
    inotifyd - "$apps:n" > "$events" &
    watcher=$!
    exec 3< "$events"
    while [ -d "/proc/$pinned" ]; do
        # A line is a new app cgroup; a timeout rechecks the shell; end of
        # file means inotifyd stopped (marathon-apps went away), so start over.
        rc=0
        read -r -t "$CHECK_INTERVAL" _ <&3 || rc=$?
        if [ "$rc" -eq 0 ]; then
            chown_cpu_files
        elif [ "$rc" -le 128 ]; then
            break
        fi
    done
    exec 3<&-
    kill "$watcher" 2>/dev/null || true
done
