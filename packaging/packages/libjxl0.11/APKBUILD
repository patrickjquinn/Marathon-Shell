# Libraries only, for wpewebkit built against libjxl 0.11 after Alpine
# moved to 0.12. Drop once wpewebkit is rebuilt.
pkgname=libjxl0.11
pkgver=0.11.2
pkgrel=0
pkgdesc="JPEG XL reference implementation, 0.11 libraries"
url="https://jpeg.org/jpegxl/"
arch="all"
license="Apache-2.0"
makedepends="
	brotli-dev
	clang
	cmake
	highway-dev
	lcms2-dev
	lld
	samurai
	"
options="!check"
source="https://github.com/libjxl/libjxl/archive/v$pkgver/libjxl-v$pkgver.tar.gz
	0002-highway-1.3.0.patch
	"
builddir="$srcdir/libjxl-$pkgver"

build() {
	export CC=clang CXX=clang++ LDFLAGS="$LDFLAGS -fuse-ld=lld"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_TESTING=OFF \
		-DJPEGXL_ENABLE_TOOLS=OFF \
		-DJPEGXL_ENABLE_JPEGLI=OFF \
		-DJPEGXL_ENABLE_PLUGINS=OFF \
		-DJPEGXL_ENABLE_BENCHMARK=OFF \
		-DJPEGXL_ENABLE_EXAMPLES=OFF \
		-DJPEGXL_ENABLE_FUZZERS=OFF \
		-DJPEGXL_ENABLE_SJPEG=OFF \
		-DJPEGXL_ENABLE_SKCMS=OFF \
		-DJPEGXL_ENABLE_VIEWERS=OFF \
		-DJPEGXL_ENABLE_DOXYGEN=OFF \
		-DJPEGXL_ENABLE_MANPAGES=OFF \
		-DJPEGXL_FORCE_SYSTEM_BROTLI=ON \
		-DJPEGXL_FORCE_SYSTEM_HWY=ON \
		-DJPEGXL_FORCE_SYSTEM_LCMS2=ON
	cmake --build build
}

package() {
	DESTDIR="$builddir/inst" cmake --install build
	mkdir -p "$pkgdir"/usr/lib
	cp -P "$builddir"/inst/usr/lib/lib*.so.0.11* "$pkgdir"/usr/lib/
}

