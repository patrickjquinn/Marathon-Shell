#!/bin/sh
# Opens the encrypted /home (docs/ENCRYPTION.md): a LUKS2 container in a file
# beside the root image on the carrier, so the person's data outlives a new
# root. It opens with the empty passphrase until a PIN is set. Then the PIN
# is asked for where it can be typed: Plymouth's prompt with a keyboard, the
# shell's PIN pad without one, unl0kr's on-screen keyboard if the pad cannot
# start. A developer image also takes it over the USB network
# (marathon-carrier-home-unlock). The first boot makes the container and
# copies /home in. The Q25's q25-home-crypt, for every carrier device.
set -u
conf=/usr/share/marathon/carrier.conf
carrier=$(sed -n 's/^CARRIER_NAME=//p' "$conf" | tail -n 1)
case $carrier in '' | *[!a-z0-9]*) echo "home-crypt: no CARRIER_NAME in $conf" > /dev/kmsg; exit 1 ;; esac
name=$carrier-home
mapper=/dev/mapper/$name
remote=/run/marathon-carrier/remote-unlock
pad=/run/marathon-carrier/pin-pad.pid
touch_rule=/run/udev/rules.d/71-marathon-touch.rules

log() {
	echo "$carrier-home-crypt: $*" > /dev/kmsg
}

dev=$(findmnt -no SOURCE /)
case "$dev" in /dev/loop*) ;; *) exit 0 ;; esac
img=$(cat "/sys/block/${dev#/dev/}/loop/backing_file")
dir=$(dirname "$img")
container=$dir/home.luks
open="cryptsetup open --allow-discards --perf-no_read_workqueue --perf-no_write_workqueue $container $name"

# Something with letter keys (KEY_A and KEY_Z), not just power or volume.
has_keyboard() {
	for caps in /sys/class/input/input*/capabilities/key; do
		[ -r "$caps" ] || continue
		read -r bits < "$caps"
		low=${bits##* }
		[ $((0x$low >> 30 & 1)) = 1 ] && [ $((0x$low >> 44 & 1)) = 1 ] && return 0
	done
	return 1
}

has_touchscreen() {
	for ev in /dev/input/event*; do
		[ -e "$ev" ] || continue
		udevadm info -q property -n "$ev" 2> /dev/null | grep -qx ID_INPUT_TOUCHSCREEN=1 && return 0
	done
	return 1
}

# Developer images only (MARATHON_DEV_SSH_KEY): sshd on the USB network
# address the initramfs gave usb0, for the build's key alone, while the PIN
# is asked for. Its client runs marathon-carrier-home-unlock.
dev_image() {
	[ -e /usr/share/factory/etc/ssh/sshd_config.d/99-marathon-dev.conf ]
}

remote_start() {
	dev_image && [ -x /usr/sbin/sshd ] || return 0
	mkdir -p "${remote%/*}"
	ssh-keygen -A > /dev/null 2>&1
	/usr/sbin/sshd -o PidFile="$remote.sshd.pid" -o ListenAddress=172.16.42.1 \
		-o PermitRootLogin=prohibit-password -o PasswordAuthentication=no \
		-o KbdInteractiveAuthentication=no \
		-o "AuthorizedKeysFile=.ssh/authorized_keys /usr/share/factory/root/.ssh/authorized_keys" &&
		log "developer image: unlock over USB with ssh root@172.16.42.1 marathon-carrier-home-unlock"
}

remote_stop() {
	[ -r "$remote.sshd.pid" ] || return 0
	kill "$(cat "$remote.sshd.pid")" 2> /dev/null
	rm -f "$remote.sshd.pid"
}

# marathon-shell-bin's PIN pad on the screen the shell will use: eglfs on the
# card driving a panel, at the device profile's scale. It runs $open with
# each PIN and returns once one opens /home.
pin_pad() {
	[ -x /usr/bin/marathon-shell-bin ] || return 1
	card=
	for status in /sys/class/drm/card*-*/status; do
		[ "$(cat "$status" 2> /dev/null)" = connected ] || continue
		card=${status#/sys/class/drm/}
		card=${card%%-*}
		break
	done
	[ -n "$card" ] || return 1
	mkdir -p "${pad%/*}"
	printf '{"device":"/dev/dri/%s","hwcursor":false}\n' "$card" > "${pad%/*}/eglfs-kms.json"
	dpi=$(sed -n 's/^[[:space:]]*FORCE_DPI[[:space:]]*=[[:space:]]*//p' \
		/etc/marathon/device-profile.conf 2> /dev/null | tr -d '"' | head -n 1)
	# shellcheck disable=SC2086 # $open is a command line
	env QT_QPA_PLATFORM=eglfs QT_QPA_EGLFS_INTEGRATION=eglfs_kms QT_QPA_EGLFS_KMS_ATOMIC=1 \
		QT_QPA_EGLFS_ALWAYS_SET_MODE=1 QT_QPA_EGLFS_HIDECURSOR=1 \
		QT_QPA_EGLFS_KMS_CONFIG="${pad%/*}/eglfs-kms.json" ${dpi:+MARATHON_FORCE_DPI=$dpi} \
		/usr/bin/marathon-shell-bin --home-unlock -- $open &
	echo $! > "$pad"
	wait $!
	ok=$?
	rm -f "$pad"
	return $ok
}

# unl0kr reads touchscreens through libinput, which 71-marathon-touch.rules
# keeps away from them for the shell's own reader.
touch_for_libinput() {
	[ -L "$touch_rule" ] && return 0
	mkdir -p "${touch_rule%/*}"
	ln -s /dev/null "$touch_rule"
	udevadm control --reload
	udevadm trigger --action=change --subsystem-match=input --property-match=ID_INPUT_TOUCHSCREEN=1 --settle
}

touch_for_shell() {
	[ -L "$touch_rule" ] || return 0
	rm -f "$touch_rule"
	udevadm control --reload
	udevadm trigger --action=change --subsystem-match=input --property-match=ID_INPUT_TOUCHSCREEN=1 --settle
}

unlock() {
	# Already open: a failed attempt left it, or the initramfs debug shell
	# opened it over USB for an unattended test boot.
	cryptsetup status "$name" > /dev/null 2>&1 && return 0
	echo | $open 2> /dev/null && return 0
	# The input drivers may still be probing.
	n=0
	while ! has_keyboard && ! has_touchscreen && [ $n -lt 20 ]; do
		sleep 0.5
		n=$((n + 1))
	done
	remote_start
	# Plymouth reads only keyboards.
	if ! has_keyboard; then
		plymouth quit 2> /dev/null
	fi
	prompt="Enter PIN"
	while :; do
		if [ -e "$remote" ]; then
			pin_typed=1
			return 0
		fi
		cryptsetup status "$name" > /dev/null 2>&1 && return 0
		if plymouth --ping 2> /dev/null; then
			plymouth ask-for-password --prompt="$prompt" --number-of-tries=1 --command="$open" && pin_typed=1 && return 0
		elif [ -z "${pad_failed:-}" ]; then
			pin_pad && pin_typed=1 && return 0
			# A PIN opened /home and the pad died on its way out.
			if cryptsetup status "$name" > /dev/null 2>&1; then
				pin_typed=1
				return 0
			fi
			# Stopped by marathon-carrier-home-unlock, or failed.
			if [ ! -e "$remote" ]; then
				log "the PIN pad failed; unl0kr asks instead"
				pad_failed=1
			fi
			continue
		elif command -v unl0kr > /dev/null; then
			touch_for_libinput
			unl0kr | $open && pin_typed=1 && return 0
		elif [ ! -r "$remote.sshd.pid" ]; then
			return 1
		fi
		prompt="Wrong PIN. Try again"
		sleep 1
	done
}

# On the phone, so each one gets its own volume key. The file is sparse and
# leaves the carrier room for two root images.
create() {
	umask 077
	free=$(($(stat -f -c %a "$dir") * $(stat -f -c %S "$dir")))
	size=$((free - (72 << 30)))
	[ "$size" -ge $((8 << 30)) ] || size=$((8 << 30))
	[ "$free" -gt "$size" ] || return 1
	log "making $container, $((size >> 30)) GiB"
	rm -f "$container.new"
	truncate -s "$size" "$container.new" &&
		echo | cryptsetup -q --force-password luksFormat --type luks2 \
			--pbkdf pbkdf2 --pbkdf-force-iterations 1000 "$container.new" &&
		mv "$container.new" "$container" &&
		echo | $open && mke2fs -q -t ext4 "$mapper"
}

if [ -e "$container" ]; then
	unlock
	ok=$?
	remote_stop
	touch_for_shell
	[ "$ok" = 0 ] || {
		log "no way to ask for the PIN; /home stays on the root"
		exit 1
	}
elif ! create; then
	log "cannot make $container; /home stays on the root"
	cryptsetup close "$name" 2> /dev/null
	rm -f "$container.new"
	exit 1
fi

e2fsck -p "$mapper"
[ $? -lt 4 ] || {
	log "$mapper has errors"
	exit 1
}
mount -t ext4 -o noatime "$mapper" /home || exit 1
if [ ! -e /home/.marathon-seeded ]; then
	log "copying /home in"
	# The root's own /home, under the new mount.
	mnt=/run/marathon-carrier/root
	mkdir -p "$mnt"
	mount --bind / "$mnt" &&
		cp -a "$mnt/home/." /home/ && touch /home/.marathon-seeded
	seeded=$?
	umount "$mnt"
	[ "$seeded" = 0 ] || {
		log "cannot copy /home in"
		umount /home
		exit 1
	}
fi
# marathon-data-key keeps its device key on the encrypted volume. The PIN
# was given here: the shell starts unlocked this once
# (marathon-data-key consume-boot-unlock).
mkdir -p /home/.marathon-data-key /var/lib/marathon-data-key
chmod 755 /home/.marathon-data-key
mount --bind /home/.marathon-data-key /var/lib/marathon-data-key
if [ -n "${pin_typed:-}" ]; then
	(umask 077 && cat /proc/sys/kernel/random/boot_id > /var/lib/marathon-data-key/boot-unlocked)
fi
