# The userdata carrier's runtime, for every phone whose root is an ext4 file
# on a carrier partition beside an ESP (devices/*/*/device.toml
# [boot.carrier]): the encrypted /home, root growth and direct I/O, the
# over-the-air root install and its boot counting. The names come from
# /usr/share/marathon/carrier.conf, which build-image.sh writes. These are
# the Q25's q25-* units made generic; the Q25 still ships its own.
pkgname=marathon-carrier
pkgver=1.0.0
pkgrel=0
pkgdesc="Marathon userdata carrier: encrypted /home, root growth and over-the-air root install"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="noarch"
license="Apache-2.0"
options="!check"
depends="cryptsetup e2fsprogs e2fsprogs-extra findmnt losetup unl0kr"
source="
	marathon-carrier-home-crypt
	marathon-carrier-home-crypt.service
	marathon-carrier-home-unlock
	marathon-carrier-unl0kr.conf
	marathon-carrier-root-dio.service
	marathon-carrier-root-grow
	marathon-carrier-root-grow.service
	marathon-carrier-esp-readonly.service
	marathon-carrier-root-install
	marathon-carrier-root-arm.service
	marathon-carrier-boot-check.service
	marathon-carrier-boot-bless
	marathon-carrier-boot-bless.service
"

package() {
	local f unit
	for f in marathon-carrier-home-crypt marathon-carrier-root-grow marathon-carrier-root-install marathon-carrier-boot-bless; do
		install -Dm755 "$srcdir/$f" "$pkgdir/usr/libexec/marathon/$f"
	done
	# Run over ssh on a developer image; refuses on any other.
	install -Dm755 "$srcdir/marathon-carrier-home-unlock" "$pkgdir/usr/bin/marathon-carrier-home-unlock"
	install -Dm644 "$srcdir/marathon-carrier-unl0kr.conf" "$pkgdir/etc/unl0kr.conf.d/90-marathon-carrier.conf"
	for unit in home-crypt root-dio root-grow esp-readonly root-arm boot-check boot-bless; do
		install -Dm644 "$srcdir/marathon-carrier-$unit.service" \
			"$pkgdir/usr/lib/systemd/system/marathon-carrier-$unit.service"
	done
	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants" \
		"$pkgdir/usr/lib/systemd/system/local-fs.target.wants" \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants" \
		"$pkgdir/usr/lib/systemd/system/graphical.target.wants" \
		"$pkgdir/usr/lib/systemd/system/boot-complete.target.requires"
	for unit in root-dio root-grow esp-readonly; do
		ln -s ../marathon-carrier-$unit.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/"
	done
	# /home is a LUKS2 file beside the root image (docs/ENCRYPTION.md).
	ln -s ../marathon-carrier-home-crypt.service "$pkgdir/usr/lib/systemd/system/local-fs.target.wants/"
	# Over the air, systemd-sysupdate writes the next root beside the running
	# one; marathon-carrier-root-arm boots it, counted, at the next restart,
	# and a boot that reaches the session blesses it (docs/OTA.md).
	ln -s ../marathon-carrier-root-arm.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	ln -s ../marathon-carrier-boot-check.service "$pkgdir/usr/lib/systemd/system/boot-complete.target.requires/"
	ln -s ../marathon-carrier-boot-bless.service "$pkgdir/usr/lib/systemd/system/graphical.target.wants/"
	# The root is an ext4 file inside userdata, behind an ESP whose loader
	# only the root install changes: nothing may repartition or touch the
	# loader, and /etc is not a confext.
	install -d "$pkgdir/etc/systemd/system"
	for unit in systemd-repart.service systemd-repart.socket systemd-repart@.service systemd-boot-update.service systemd-confext.service; do
		ln -s /dev/null "$pkgdir/etc/systemd/system/$unit"
	done
}

