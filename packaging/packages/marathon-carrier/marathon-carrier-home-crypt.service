[Unit]
Description=Open the encrypted /home on the carrier
DefaultDependencies=no
Wants=systemd-udev-trigger.service
After=systemd-modules-load.service systemd-udev-trigger.service systemd-remount-fs.service plymouth-start.service marathon-carrier-root-grow.service
Before=local-fs.target systemd-user-sessions.service
ConditionPathIsMountPoint=!/home

[Service]
Type=oneshot
RemainAfterExit=yes
# A PIN prompt waits for the person.
TimeoutStartSec=infinity
# A charger turned the phone on: it shows the charging screen, no PIN.
ExecCondition=/bin/sh -c '! marathon-charger boot-mode charger 2>/dev/null'
ExecStart=/usr/libexec/marathon/marathon-carrier-home-crypt

[Install]
WantedBy=local-fs.target
