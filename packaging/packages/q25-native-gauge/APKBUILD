# Q25 battery estimate from the MT6358 gauge: q25-mt6358-live (in
# q25-kernel-modules) snapshots current and CAR; this service fits the
# stock battery profile and commits capacity back to fuel-gauge.
pkgname=q25-native-gauge
pkgver=1.0.0
pkgrel=2
pkgdesc="Zinwa Q25 provisional native battery gauge"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="noarch"
license="GPL-2.0-only"
options="!check"
depends="python3 kmod q25-kernel-modules>=7.0.0-r13"
source="q25_gauge_service.py q25_soc.py stock-profile0.json q25-native-gauge.service
 q25-gauge-model.conf battery-model-experimental 90-q25-battery-model.conf"

package() {
	local f
	for f in q25_gauge_service.py q25_soc.py stock-profile0.json; do
		install -Dm644 "$srcdir/$f" "$pkgdir/usr/libexec/q25-native-gauge/$f"
	done
	install -Dm644 "$srcdir/q25-native-gauge.service" "$pkgdir/usr/lib/systemd/system/q25-native-gauge.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../q25-native-gauge.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/q25-native-gauge.service"
	install -Dm644 "$srcdir/q25-gauge-model.conf" "$pkgdir/etc/marathon/q25-gauge-model.conf"
	# The estimate is uncalibrated: the shell and UPower must not shut the
	# phone down on it.
	install -Dm644 "$srcdir/battery-model-experimental" "$pkgdir/etc/marathon/battery-model-experimental"
	install -Dm644 "$srcdir/90-q25-battery-model.conf" "$pkgdir/etc/UPower/UPower.conf.d/90-q25-battery-model.conf"
}

