[Unit]
Description=Q25 provisional native battery model
After=systemd-udev-settle.service
StartLimitIntervalSec=300
StartLimitBurst=3
ConditionPathExists=/etc/marathon/battery-model-experimental
ConditionPathExists=/etc/marathon/q25-gauge-model.conf

[Service]
Type=simple
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/marathon/q25-gauge-model.conf
ExecStartPre=/bin/sh -c 'test -e /sys/bus/platform/devices/q25-mt6358-live/snapshot || exec modprobe q25_mt6358_live enable_snapshot=1 parent_name=10026000.pmic-wrapper:pmic max_samples=0'
ExecStart=/usr/bin/python3 -I -u /usr/libexec/q25-native-gauge/q25_gauge_service.py --model-margin-bp ${MODEL_MARGIN_BP} --runtime-seconds 0
ExecStopPost=/usr/bin/python3 -I /usr/libexec/q25-native-gauge/q25_gauge_service.py --invalidate-only
Restart=on-failure
RestartSec=10
TimeoutStopSec=12
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices /run

[Install]
WantedBy=multi-user.target
