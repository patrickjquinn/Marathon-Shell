[Unit]
Description=Q25 MD1: SIM power-up and LTE attach APN, before ModemManager takes ttyC0
Requires=q25-ccci-mdinit.service
After=q25-ccci-mdinit.service
Before=ModemManager.service
PartOf=q25-modem.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/bin/systemctl stop ModemManager.service
ExecStartPre=/usr/libexec/q25-modem/q25-modem-up wait
ExecStart=/usr/libexec/q25-modem/q25-modem-init
ExecStartPost=/bin/systemctl start --no-block ModemManager.service
