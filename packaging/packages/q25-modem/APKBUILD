# Q25 MD1 cellular modem, opt-in: systemctl enable --now q25-modem.target on a
# boot entry whose DTB carries the modem nodes (q25-modem.dtbo, from
# devices/zinwa/q25/modem/dt). The daemons build from userspace/ here; the
# ECCCI modules are prebuilt like q25-kernel-modules (sources and rebuild:
# devices/zinwa/q25/modules, modem/), pinned to the prebuilt kernel.
pkgname=q25-modem
pkgver=1.0.0
pkgrel=0
pkgdesc="Zinwa Q25 MD1 modem stack: ECCCI modules, CCCI daemons, services"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="GPL-2.0-only AND Apache-2.0"
options="!check !strip !tracedeps"
depends="kmod util-linux q25-kernel-modules>=7.0.0-r6 linux-postmarketos-mediatek-g99=7.0-r1000
 modemmanager-mtk-ccci"
makedepends="gcc make musl-dev linux-headers zstd"
install="$pkgname.post-install $pkgname.post-upgrade"
_modules="ccci_util_lib ccmni ccci_md_all ccci_ccif ccci_dpmaif"
_units="q25-modem.target q25-modem-owner.service q25-modem-stack.service q25-modem-nv.service
 q25-ccci-rpcd.service q25-ccci-fsd.service q25-ccci-mdinit.service q25-modem-init.service"
source="SHA256SUMS q25-modem-up q25-modem-nv q25-modem-init properties modem.conf
 78-q25-modem.rules q25-modem.conf.modprobe q25-modem.dtbo $_units"
for _m in $_modules; do
    source="$source $_m.ko.zst"
done

prepare() {
    default_prepare
    mkdir -p "$builddir"
    cp -r "$startdir/userspace/." "$builddir/"
}

build() {
    make -C "$builddir" CC="${CC:-gcc}"
}

package() {
    local extra="$pkgdir/usr/lib/modules/7.0.0-q25-cfi-test/extra/q25-modem"
    local x="$pkgdir/usr/libexec/q25-modem" m u
    install -d "$extra"
    for m in $_modules; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/$m.ko"
    done
    chmod 0644 "$extra"/*.ko
    (cd "$pkgdir" && sed 's#  /#  #' "$srcdir/SHA256SUMS" | sha256sum -c >/dev/null)
    install -Dm644 "$srcdir/SHA256SUMS" "$pkgdir/usr/share/doc/$pkgname/SHA256SUMS"

    for m in ccci_mdinit ccci_fsd ccci_rpcd q25-speech; do
        install -Dm755 "$builddir/out/$m" "$x/$m"
    done
    install -d "$pkgdir/usr/bin"
    ln -s ../libexec/q25-modem/q25-speech "$pkgdir/usr/bin/q25-speech"
    for m in q25-modem-up q25-modem-nv q25-modem-init; do
        install -Dm755 "$srcdir/$m" "$x/$m"
    done
    install -Dm644 "$srcdir/properties" "$pkgdir/etc/q25-modem/properties"
    install -Dm644 "$srcdir/modem.conf" "$pkgdir/etc/q25-modem/modem.conf"
    install -Dm644 "$srcdir/78-q25-modem.rules" "$pkgdir/usr/lib/udev/rules.d/78-q25-modem.rules"
    install -Dm644 "$srcdir/q25-modem.conf.modprobe" "$pkgdir/usr/lib/modprobe.d/q25-modem.conf"
    install -Dm644 "$srcdir/q25-modem.dtbo" "$pkgdir/usr/share/$pkgname/q25-modem.dtbo"
    # Opt-in: nothing is enabled. The owner unit's ExecStop powers MD1 off.
    for u in $_units; do
        install -Dm644 "$srcdir/$u" "$pkgdir/usr/lib/systemd/system/$u"
    done
}
