# Q25 MD1 cellular modem. udev starts q25-modem.target at boot on an entry
# whose DTB carries the modem nodes (q25-modem.dtbo, from
# devices/zinwa/q25/modem/dt). The daemons build from userspace/ here; the
# ECCCI modules are built with the kernel and ship in q25-kernel-modules.
pkgname=q25-modem
pkgver=1.0.0
pkgrel=10
pkgdesc="Zinwa Q25 MD1 modem stack: CCCI daemons and services"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="GPL-2.0-only AND Apache-2.0"
options="!check !strip !tracedeps"
depends="kmod util-linux q25-kernel-modules>=7.0.0-r27 modemmanager-mtk-ccci"
makedepends="gcc make musl-dev linux-headers"
_units="q25-modem.target q25-modem-owner.service q25-modem-stack.service q25-modem-nv.service
 q25-ccci-rpcd.service q25-ccci-fsd.service q25-ccci-mdinit.service q25-modem-init.service
 q25-modem-reset.path q25-modem-reset.service q25-md1-firmware.service"
source="q25-modem-up q25-modem-nv q25-modem-init properties modem.conf
 78-q25-modem.rules q25-modem.conf.modprobe q25-modem.dtbo q25-md1-firmware $_units"

prepare() {
    default_prepare
    mkdir -p "$builddir"
    cp -r "$startdir/userspace/." "$builddir/"
}

build() {
    make -C "$builddir" CC="${CC:-gcc}"
}

package() {
    local x="$pkgdir/usr/libexec/q25-modem" m u
    for m in ccci_mdinit ccci_fsd ccci_rpcd q25-speech; do
        install -Dm755 "$builddir/out/$m" "$x/$m"
    done
    install -d "$pkgdir/usr/bin"
    ln -s ../libexec/q25-modem/q25-speech "$pkgdir/usr/bin/q25-speech"
    for m in q25-modem-up q25-modem-nv q25-modem-init q25-md1-firmware; do
        install -Dm755 "$srcdir/$m" "$x/$m"
    done
    # q25-md1-firmware.service copies the image there on first boot.
    install -d "$pkgdir/usr/lib/firmware/q25-md1"
    ln -s /var/lib/q25-md1/md1img.img "$pkgdir/usr/lib/firmware/q25-md1/md1img.img"
    install -Dm644 "$srcdir/properties" "$pkgdir/etc/q25-modem/properties"
    install -Dm644 "$srcdir/modem.conf" "$pkgdir/etc/q25-modem/modem.conf"
    install -Dm644 "$srcdir/78-q25-modem.rules" "$pkgdir/usr/lib/udev/rules.d/78-q25-modem.rules"
    install -Dm644 "$srcdir/q25-modem.conf.modprobe" "$pkgdir/usr/lib/modprobe.d/q25-modem.conf"
    install -Dm644 "$srcdir/q25-modem.dtbo" "$pkgdir/usr/share/$pkgname/q25-modem.dtbo"
    # 78-q25-modem.rules pulls the target in. The owner unit's ExecStop
    # powers MD1 off.
    for u in $_units; do
        install -Dm644 "$srcdir/$u" "$pkgdir/usr/lib/systemd/system/$u"
    done
}
