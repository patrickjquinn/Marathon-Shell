[Unit]
Description=Q25 IMS: SIP stack (volte_stack)
Requires=q25-ims-runtime.service
Wants=q25-ims-logd.service
After=q25-ims-logd.service 
PartOf=q25-modem.target

[Service]
ExecStart=/usr/libexec/q25-modem/q25-ims-runtime run  -- /q25-ims-exec -s volte_stack:stream:660 -- /vendor/bin/volte_stack
Restart=always
RestartSec=2
