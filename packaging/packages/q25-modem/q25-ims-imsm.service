[Unit]
Description=Q25 IMS: manager: SIM and PDN for IMS (volte_imsm_93)
Requires=q25-ims-runtime.service
Wants=q25-ims-logd.service q25-ims-propd.service q25-ims-imcb.service
After=q25-ims-logd.service q25-ims-propd.service q25-ims-imcb.service
PartOf=q25-modem.target

[Service]
ExecStartPre=/usr/libexec/q25-modem/q25-modem-up wait
ExecStart=/usr/libexec/q25-modem/q25-ims-runtime run +CAP_NET_RAW +CAP_NET_ADMIN ccci_imsm -- /vendor/bin/volte_imsm_93
Restart=always
RestartSec=2
