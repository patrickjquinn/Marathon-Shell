[Unit]
Description=Q25 IMS: user agent (volte_ua)
Requires=q25-ims-runtime.service
Wants=q25-ims-logd.service q25-ims-stack.service
After=q25-ims-logd.service q25-ims-stack.service
PartOf=q25-modem.target

[Service]
ExecStart=/usr/libexec/q25-modem/q25-ims-runtime run  -- /q25-ims-exec -s volte_ua:stream:660 -- /vendor/bin/volte_ua
Restart=always
RestartSec=2
