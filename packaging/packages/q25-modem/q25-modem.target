[Unit]
Description=Q25 MD1 cellular modem stack
ConditionPathExists=/proc/device-tree/soc/mddriver
# Wants, not Requires: the reset path restarts q25-modem-init, and a
# requirement would carry that restart up to the target and, through
# PartOf, to fsd, rpcd and mdinit while MD1 reboots.
Wants=q25-modem-owner.service q25-modem-stack.service q25-modem-nv.service q25-ccci-rpcd.service q25-ccci-fsd.service q25-ccci-mdinit.service q25-modem-init.service
Wants=q25-modem-reset.path q25-call-audio.service
After=q25-modem-init.service

[Install]
WantedBy=multi-user.target
