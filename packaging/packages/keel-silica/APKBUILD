# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
pkgname=keel-silica
pkgver=0.1.0
pkgrel=16
_qtver=6.12.0
pkgdesc="Marathon Silica: Sailfish Silica QML components for Qt 6, from Keel"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="MIT AND BSD-3-Clause AND LGPL-2.1-only"
depends="qt6-qtdeclarative~$_qtver mlite dconf"
subpackages="$pkgname-dev"
makedepends="
	cargo
	cmake
	samurai
	mlite-dev
	dconf-dev
	pkgconf
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	"
# Marathon Silica is keel-silica/ in this repo, Marathon's fork of Keel.
# scripts/qemu/lib/build-keel-silica-apk.sh stages its committed tree into
# /var/cache/distfiles as keel-silica-$pkgver.tar.gz and re-runs
# `abuild -F checksum`, so the URL below is never fetched on the normal build
# path. It tracks a moving branch and exists only for a standalone `abuild`.
source="$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz"
# Keel's tests need a session bus and qmltestrunner, which abuild has not.
options="net !check"
builddir="$srcdir/Marathon-Shell-main/keel-silica"

prepare() {
	default_prepare
	cargo fetch --manifest-path silica/plugin/Cargo.toml --locked
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DKEEL_QML_INSTALL_DIR=/usr/lib/qt6/qml \
		-DKEEL_BUILD_NEMO_COMPAT=ON \
		-DKEEL_REQUIRE_MLITE=ON \
		-DKEEL_BUILD_SAILFISHAPP=ON \
		-DKEEL_BUILD_PLATFORM=ON \
		-DKEEL_PLATFORM_WEBVIEW=OFF \
		-DKEEL_QML_DISCARD_SOURCES=OFF \
		-DKEEL_PLATFORM_SECRETS=OFF \
		-DKEEL_PLATFORM_ACCOUNTS=OFF \
		-DKEEL_PLATFORM_SAILFISH_ACCOUNTS=OFF \
		-DKEEL_BUILD_ACTIONS=ON \
		-DKEEL_BUILD_BOOSTER=OFF \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# /usr/lib/keel holds qt5compat, which Sailfish apps' QML imports first.
	rm -rf "$pkgdir"/usr/lib/qt6/qml/Nemo/Policy \
		"$pkgdir"/usr/lib/qt6/qml/org/nemomobile/policy
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 silica/upstream/sailfishsilica-qt5-1.2.156/LICENSE.BSD \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE.BSD
	install -Dm644 silica/upstream/sailfishsilica-qt5-1.2.156/LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/sailfishsilica.LICENSE
	install -Dm644 nemo-compat/upstream-licenses/* \
		-t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
SKIP  keel-silica-$pkgver.tar.gz
"
