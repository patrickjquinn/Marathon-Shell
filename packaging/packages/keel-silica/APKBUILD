# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
pkgname=keel-silica
pkgver=0.1.0
pkgrel=10
_commit=5c0911292f2d062dace3ea7c51785a17a8c9a39d
_qtver=6.11.1
pkgdesc="Keel: Sailfish Silica QML components for Qt 6"
url="https://github.com/patrickjquinn/shipwright-open"
arch="aarch64"
license="MIT AND BSD-3-Clause AND LGPL-2.1-only"
depends="qt6-qtdeclarative~$_qtver mlite dconf"
subpackages="$pkgname-dev"
makedepends="
	cargo
	cmake
	samurai
	mlite-dev
	dconf-dev
	pkgconf
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	"
source="$pkgname-$_commit.tar.gz::https://github.com/patrickjquinn/shipwright-open/archive/$_commit.tar.gz"
# Keel's tests need a session bus and qmltestrunner; they run in Shipwright's CI.
options="net !check"
builddir="$srcdir/shipwright-open-$_commit/keel"

prepare() {
	default_prepare
	cargo fetch --manifest-path silica/plugin/Cargo.toml --locked
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DKEEL_QML_INSTALL_DIR=/usr/lib/qt6/qml \
		-DKEEL_BUILD_NEMO_COMPAT=ON \
		-DKEEL_REQUIRE_MLITE=ON \
		-DKEEL_BUILD_SAILFISHAPP=ON \
		-DKEEL_BUILD_PLATFORM=ON \
		-DKEEL_PLATFORM_WEBVIEW=OFF \
		-DKEEL_PLATFORM_SECRETS=OFF \
		-DKEEL_PLATFORM_ACCOUNTS=OFF \
		-DKEEL_PLATFORM_SAILFISH_ACCOUNTS=OFF \
		-DKEEL_BUILD_ACTIONS=ON \
		-DKEEL_BUILD_BOOSTER=OFF \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# /usr/lib/keel holds qt5compat, which Sailfish apps' QML imports first.
	rm -rf "$pkgdir"/usr/lib/qt6/qml/Nemo/Policy \
		"$pkgdir"/usr/lib/qt6/qml/org/nemomobile/policy
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 silica/upstream/sailfishsilica-qt5-1.2.156/LICENSE.BSD \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE.BSD
	install -Dm644 silica/upstream/sailfishsilica-qt5-1.2.156/LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/sailfishsilica.LICENSE
	install -Dm644 nemo-compat/upstream-licenses/* \
		-t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
SKIP  keel-silica-$_commit.tar.gz
"
