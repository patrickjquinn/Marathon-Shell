# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# keel-mcp (crates/keel-mcp): the MCP server for the Keel Actions of the apps
# on the device. pilotd starts /usr/bin/keel-mcp --stdio when it is
# installed; keel-mcp.service serves other clients on
# $XDG_RUNTIME_DIR/keel-mcp.sock.
# scripts/qemu/lib/build-pilot-apk.sh stages this repository's tree as the
# source tarball, so the URL below is fetched only by a standalone abuild,
# and it follows a branch.
pkgname=keel-mcp
pkgver=0.1.0
pkgrel=6
pkgdesc="MCP server for the Keel Actions of Marathon apps"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64 x86_64"
license="MIT"
depends="dbus"
makedepends="cargo"
source="$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz"
builddir="$srcdir/Marathon-Shell-main"
# The tests run with the workspace's (crates/), on the build host.
options="!check net"

build() {
	cargo build --manifest-path crates/Cargo.toml --profile release-unwind --locked -p keel-mcp
}

package() {
	install -Dm755 crates/target/release-unwind/keel-mcp "$pkgdir"/usr/bin/keel-mcp
	install -d "$pkgdir"/usr/share/keel/actions
	# Not started with the session: Pilot runs its own keel-mcp, and the socket
	# is for a developer's MCP client (systemctl --user enable keel-mcp).
	install -Dm644 crates/keel-mcp/data/keel-mcp.service \
		"$pkgdir"/usr/lib/systemd/user/keel-mcp.service
	install -Dm644 crates/keel-mcp/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
SKIP  keel-mcp-0.1.0.tar.gz
"
