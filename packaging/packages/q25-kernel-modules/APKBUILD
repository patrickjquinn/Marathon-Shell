# Q25 out-of-tree and unconfigured in-tree modules, as loaded on the device.
# Sources and the rebuild check: devices/zinwa/q25/modules (build.sh).
# The bytes are pinned to the linux-zinwa-q25 build they load into.
pkgname=q25-kernel-modules
pkgver=7.0.0
pkgrel=22
pkgdesc="Zinwa Q25 hardware modules for linux-zinwa-q25"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="GPL-2.0-only AND GPL-2.0-or-later AND (BSD-3-Clause OR GPL-2.0-only)"
options="!check !strip !tracedeps"
depends="kmod linux-zinwa-q25=7.0.0-r0"
makedepends="zstd"
install="$pkgname.post-install $pkgname.post-upgrade"
_extra="q25-bbq-keys q25-keyboard-led q25-md1-owner inv-icm42607 inv-icm42607-spi spi-mt65xx q25-panel-doze q25-vsyncdrm q25-i2c-clk mmc5633 hx32062se q25-mt6358-live q25-haptic regulator-haptic"
_connsys="q25-conn-pd rfkill cfg80211 connadp btif_drv wmt_drv wmt_chrdev_wifi wlan_drv_gen4m_6789 bluetooth q25-btmtk-stp"
_audio="snd-timer snd-pcm snd-jack snd-soc-core snd-soc-mt6358 snd-soc-mtk-common snd-soc-mt6789-afe q25-audio-pd q25-oca72390 q25-mt6366-card q25-mt6366-irqfix q25-mt6358-accdet"
_camera="q25-cam-pd q25-cam-dt wl2868c-regulator mc videodev v4l2-async v4l2-fwnode v4l2-cci videobuf2-common videobuf2-memops videobuf2-v4l2 videobuf2-dma-contig phy-mtk-mipi-csi-2-1 mtk-seninf6s mtk-camsv6s imx111 s5kjn1"
_net="llc stp bridge veth tun nfnetlink x_tables xt_tcpudp xt_CHECKSUM xt_MASQUERADE nf_defrag_ipv4 nf_defrag_ipv6 nf_conntrack nf_nat nf_tables nft_compat nft_chain_nat nft_masq nft_ct nf_reject_ipv4 nf_reject_ipv6 ip_tables ip6_tables iptable_filter iptable_nat iptable_mangle iptable_raw ip6table_filter ip6table_nat ip6table_mangle ip6table_raw ipt_REJECT ip6t_REJECT xt_mark xt_conntrack xt_comment xt_multiport xt_tcpmss xt_TCPMSS xt_addrtype xt_REDIRECT xt_connmark xt_bpf xt_owner xt_u32 xt_state xt_pkttype xt_limit xt_quota xt_hashlimit xt_iprange xt_length xt_IDLETIMER xt_NFLOG nfnetlink_log xt_CT dummy"
source="SHA256SUMS q25-camera.dtbo"
for _m in $_extra $_connsys $_audio $_camera $_net; do
    source="$source $_m.ko.zst"
done
package() {
    local extra="$pkgdir/usr/lib/modules/7.0.0-q25-cfi-test/extra" m
    install -d "$extra/q25-connsys" "$extra/q25-audio" "$extra/q25-camera" "$extra/q25-net"
    for m in $_extra; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/$m.ko"
    done
    for m in $_connsys; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/q25-connsys/$m.ko"
    done
    for m in $_audio; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/q25-audio/$m.ko"
    done
    for m in $_camera; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/q25-camera/$m.ko"
    done
    for m in $_net; do
        zstd -q -d < "$srcdir/$m.ko.zst" > "$extra/q25-net/$m.ko"
    done
    chmod 0644 "$extra"/*.ko "$extra"/q25-connsys/*.ko "$extra"/q25-audio/*.ko "$extra"/q25-camera/*.ko "$extra"/q25-net/*.ko
    install -Dm644 "$srcdir/q25-camera.dtbo" "$pkgdir/usr/lib/firmware/q25-camera.dtbo"
    (cd "$pkgdir" && sed 's#  /#  #' "$srcdir/SHA256SUMS" | sha256sum -c >/dev/null)
    install -Dm644 "$srcdir/SHA256SUMS" "$pkgdir/usr/share/doc/$pkgname/SHA256SUMS"
}
