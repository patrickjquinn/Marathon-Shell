# Contributor: Patrick Quinn <patrick@jquinn.com>
# Maintainer: Patrick Quinn <patrick@jquinn.com>
pkgname=marathon-base-config
pkgver=1.0.0
pkgrel=60
pkgdesc="Marathon OS base system configuration and tuning"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="all"
license="Apache-2.0"
# Marathon doesn't ship full-disk encryption (Pi 5 / CM5 with HyperPixel
# has no UI for it pre-shell). Stub-provide unl0kr-agent so apk doesn't
# pull unl0kr-3.5.1, which would conflict with f0rmz-3.4.2 that
# postmarketos-duranium 11-r0 requires. Upstream pmaports bumped unl0kr
# to 3.5.1 without bumping f0rmz; this resolves the conflict locally.
provides="unl0kr-agent=999.0.0-r0"
depends="
	systemd
	dbus
	dbus-systemd
	mesa-gbm
	mesa-egl
	mesa-dri-gallium
	mesa-gles
	mesa-va-gallium
	mesa-utils
	pipewire
	pipewire-pulse
	wireplumber
	modemmanager
	networkmanager
	mobile-broadband-provider-info
	e2fsprogs
	f2fs-tools
	zram-init-systemd
	htop
	iw
	nano
	tmux
	font-noto
	font-noto-emoji
	ttf-dejavu
        greetd
	gpg
	tuned-ppd
"
# tuned-ppd: power profiles (Battery Saver) over power-profiles-daemon's
# D-Bus API, with tuned owning the CPU governor through the profiles below.
# power-profiles-daemon itself has no driver for these SoCs' cpufreq
# (placeholder only), so its power-saver would change nothing.
# font-noto-emoji: colour emoji for Marathon (fontconfig's "emoji") and, as
# the same NotoColorEmoji.ttf, for Android apps (deckard-fonts-sync).
# gpg: systemd-pull runs it to check an OTA feed's SHA256SUMS.gpg against
# /usr/lib/systemd/import-pubring.pgp; without it every update is refused.
# Comments must live outside the depends="..."
# string -- abuild splits the whole quoted block on whitespace and
# turns `# callaudiod handles modem-to-codec` into separate fake
# package names (`#`, `handles`, `modem-to-codec`), which then make
# the apk solver either skip them silently (mkosi build) or refuse
# to install (apk add). r30 shipped with that bug; r31 corrects it.
install="$pkgname.post-install"
options="!check"
source="
	99-marathon.conf
	50-marathon-zram.conf
	60-marathon-cpufreq.rules
	61-marathon-iosched.rules
	60-gpu-acceleration.rules
	50-marathon-limits.conf
	50-pipewire-priority.conf
	50-modemmanager-priority.conf
	device-profile.conf
	20-modesetting.conf
	greetd-marathon.toml
	marathon.slice
	marathon-session.target
	marathon-portals.conf
	50-marathon-timedate.rules
	50-marathon-watchdog.conf
	marathon-sleep-log
	marathon-modem-sleep
	marathon-modem-sleep.service
	marathon-power-profiles.service
	marathon-power-profiles.timer
	marathon-flatpak-gc.service
	marathon-flatpak-gc.timer
	marathon-power-profiles-on-demand.conf
	tuned-balanced.conf
	tuned-balanced-battery.conf
	tuned-powersave.conf
	tuned-throughput-performance.conf
"
package() {
	install -Dm644 "$srcdir/50-marathon-watchdog.conf" \
		"$pkgdir/etc/systemd/system.conf.d/50-marathon-watchdog.conf"
	install -Dm755 "$srcdir/marathon-sleep-log" \
		"$pkgdir/usr/lib/systemd/system-sleep/marathon-sleep-log"
	# Not enabled here: overlays for modems without their own manager add
	# it to sleep.target.wants.
	install -Dm755 "$srcdir/marathon-modem-sleep" \
		"$pkgdir/usr/libexec/marathon-modem-sleep"
	install -Dm644 "$srcdir/marathon-modem-sleep.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-modem-sleep.service"
	install -Dm644 "$srcdir/99-marathon.conf" \
		"$pkgdir/etc/sysctl.d/99-marathon.conf"
	install -Dm644 "$srcdir/50-marathon-zram.conf" \
		"$pkgdir/etc/systemd/zram-generator.conf.d/50-marathon.conf"
	install -Dm644 "$srcdir/60-marathon-cpufreq.rules" \
		"$pkgdir/etc/udev/rules.d/60-marathon-cpufreq.rules"
	# tuned-ppd maps power-saver/balanced/performance to these tuned profile
	# names (balanced becomes balanced-battery on battery). /etc/tuned/profiles
	# overrides the stock ones, which also touch USB autosuspend, disks and
	# the like; these set only the CPU governor.
	local _profile
	for _profile in balanced balanced-battery powersave throughput-performance; do
		install -Dm644 "$srcdir/tuned-$_profile.conf" \
			"$pkgdir/etc/tuned/profiles/$_profile/tuned.conf"
	done
	# tuned takes about twelve seconds to import its Python plugins on the
	# CM5. It remains D-Bus activatable, but starts after the shell instead
	# of holding multi-user.target and graphical.target open.
	install -Dm644 "$srcdir/marathon-power-profiles.timer" \
		"$pkgdir/usr/lib/systemd/system/marathon-power-profiles.timer"
	install -Dm644 "$srcdir/marathon-power-profiles.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-power-profiles.service"
	for _unit in tuned tuned-ppd; do
		install -Dm644 "$srcdir/marathon-power-profiles-on-demand.conf" \
			"$pkgdir/usr/lib/systemd/system/$_unit.service.d/marathon-on-demand.conf"
	done
	install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
	ln -sf ../marathon-power-profiles.timer \
		"$pkgdir/usr/lib/systemd/system/timers.target.wants/marathon-power-profiles.timer"
	# In /usr: udev's coldplug runs before the /etc confext merges, so a rule
	# in /etc took the image's old copy at boot. 61 sorts after that copy.
	install -Dm644 "$srcdir/61-marathon-iosched.rules" \
		"$pkgdir/usr/lib/udev/rules.d/61-marathon-iosched.rules"
	install -Dm644 "$srcdir/60-gpu-acceleration.rules" \
		"$pkgdir/etc/udev/rules.d/60-gpu-acceleration.rules"
	install -Dm644 "$srcdir/50-marathon-limits.conf" \
		"$pkgdir/etc/security/limits.d/50-marathon.conf"
	install -d "$pkgdir"/etc/systemd/system/pipewire.service.d
	install -Dm644 "$srcdir/50-pipewire-priority.conf" \
		"$pkgdir/etc/systemd/system/pipewire.service.d/50-priority.conf"
	install -d "$pkgdir"/etc/systemd/system/ModemManager.service.d
	install -Dm644 "$srcdir/50-modemmanager-priority.conf" \
		"$pkgdir/etc/systemd/system/ModemManager.service.d/50-priority.conf"
	# Device-agnostic default device profile, shipped as an .example. Device
	# overlays (packages/device-*-marathon) install the real
	# /etc/marathon/device-profile.conf; absent that, the shell falls back to
	# its built-in defaults. GPU driver env is NOT global — it moved to the
	# per-device overlays (the Adreno/freedreno env now lives in the OnePlus
	# overlay, not here where it shipped wrongly to every device).
	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf.example"
	install -d "$pkgdir"/etc/X11/xorg.conf.d
	install -Dm644 "$srcdir/20-modesetting.conf" \
		"$pkgdir/etc/X11/xorg.conf.d/20-modesetting.conf"

	# Enable user-systemd linger for `user` at first boot. Equivalent to
	# `loginctl enable-linger user` — systemd-logind reads this marker
	# during boot and starts user@<uid>.service immediately, populating
	# XDG_RUNTIME_DIR + the user-bus socket so apps that need them
	# (Mail's marathon-maild, MPRIS clients, future Wallet) can
	# talk to the user manager from any session, including non-tty SSH.
	#
	# Without this, pmOS+greetd auto-login doesn't trigger pam_systemd,
	# the user manager never starts, and `systemctl --user` hangs.
	install -d "$pkgdir/var/lib/systemd/linger"
	touch "$pkgdir/var/lib/systemd/linger/user"

	# User-level slice with Delegate=yes — the shell carves marathon-apps
	# subgroups under this for per-app cgroup.freeze (Phase B perf
	# overhaul). See marathon-shell-session for the systemd-run hook.
	install -Dm644 "$srcdir/marathon.slice" \
		"$pkgdir/usr/lib/systemd/user/marathon.slice"
	install -Dm644 "$srcdir/marathon-session.target" \
		"$pkgdir/usr/lib/systemd/user/marathon-session.target"
	# Unused runtimes pile up as apps are updated and removed.
	install -Dm644 "$srcdir/marathon-flatpak-gc.service" \
		"$pkgdir/usr/lib/systemd/user/marathon-flatpak-gc.service"
	install -Dm644 "$srcdir/marathon-flatpak-gc.timer" \
		"$pkgdir/usr/lib/systemd/user/marathon-flatpak-gc.timer"
	install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
	ln -sf ../marathon-flatpak-gc.timer \
		"$pkgdir/usr/lib/systemd/user/timers.target.wants/marathon-flatpak-gc.timer"
	install -Dm644 "$srcdir/marathon-portals.conf" \
		"$pkgdir/usr/share/xdg-desktop-portal/marathon-portals.conf"
	install -Dm644 "$srcdir/50-marathon-timedate.rules" \
		"$pkgdir/usr/share/polkit-1/rules.d/50-marathon-timedate.rules"
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/config.toml"
	install -d "$pkgdir"/etc/systemd/system/graphical.target.wants
	ln -sf /usr/lib/systemd/system/greetd.service \
		"$pkgdir/etc/systemd/system/graphical.target.wants/greetd.service"
	# Avoid console login racing with greetd on tty1.
	# Use /usr/lib/systemd/system-preset rather than an /etc/systemd/system
	# mask symlink: mkosi's apk install runs systemd-preset as a trigger
	# during install, BEFORE mkosi.postinst can clean up. A /etc-level mask
	# makes preset-all emit "Failed to preset unit: ... is masked" which
	# apk counts toward its exit-code-2 error tally and aborts the entire
	# image build. Preset-based disable is cleaner anyway: reversible at
	# runtime with `systemctl enable getty@tty1`.
	install -dm755 "$pkgdir/usr/lib/systemd/system-preset"
	cat > "$pkgdir/usr/lib/systemd/system-preset/10-marathon-no-getty-tty1.preset" <<'PRESET'
# Marathon owns tty1 via greetd; don't auto-spawn getty there.
disable getty@tty1.service

# NetworkManager-wait-online blocks network-online.target until NM
# reports a connection. On first boot before WiFi associates, it waits
# up to 90 seconds before timing out — visible to the user as a 1–2
# minute kernel-log freeze at boot. Marathon services don't actually
# need network-online.target as a hard dep (NM up + DHCP later is
# fine), so disable it. If a future service genuinely needs network
# before starting, fix that service to use After=NetworkManager.service
# instead of network-online.target.
disable NetworkManager-wait-online.service

# iwd is pulled in by postmarketos-base-ui-wifi-iwd as a sibling of
# wpa_supplicant. NetworkManager uses wpa_supplicant, not iwd —
# leaving iwd auto-enabled wastes 5–10 MB RSS + 350 ms boot time and
# both daemons race for nl80211 on the same wiphy. wpa_supplicant
# stays enabled.
disable iwd.service

# Power profiles are available shortly after login, without making TuneD's
# Python startup a prerequisite for the display manager.
disable tuned.service
disable tuned-ppd.service
PRESET

	# User-scope preset: no socket-activated gnome-keyring. The session
	# script starts the daemon itself with the login keyring it prepares
	# (marathon-shell-session); the socket in basic.target.wants started it
	# early and unprepared, spamming "couldn't unlock the login keyring".
	install -dm755 "$pkgdir/usr/lib/systemd/user-preset"
	cat > "$pkgdir/usr/lib/systemd/user-preset/10-marathon-no-keyring.preset" <<'PRESET'
# marathon-shell-session starts gnome-keyring with the prepared keyring.
disable gnome-keyring-daemon.service
disable gnome-keyring-daemon.socket

# Marathon is not a wlroots compositor; the wlr portal can't work here.
disable xdg-desktop-portal-wlr.service
PRESET

	# The wlr portal is D-Bus activatable regardless of presets, so mask it.
	# xdg-desktop-portal and its GTK backend stay live: flatpak apps need
	# them, and marathon-session.target now brings up the
	# graphical-session.target they require.
	install -d "$pkgdir/etc/systemd/user"
	ln -sf /dev/null "$pkgdir/etc/systemd/user/xdg-desktop-portal-wlr.service"

	# A foreign resolv.conf at boot gets imported by resolved as a global DNS server.
	ln -sf ../run/systemd/resolve/stub-resolv.conf "$pkgdir/etc/resolv.conf"

	# plymouth-start.service drop-in: wait for /dev/fb0 to exist before
	# launching plymouthd. drm-rp1-dpi binds at the same instant
	# plymouth-start fires; without this the fbdev backend opens nothing
	# and the splash silently disappears. 3 s cap so a broken panel
	# never wedges boot.
	install -d "$pkgdir/etc/systemd/system/plymouth-start.service.d"
	cat > "$pkgdir/etc/systemd/system/plymouth-start.service.d/10-marathon-wait-fb.conf" <<'EOF'
[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -e /dev/fb0 ] && exit 0; sleep 0.05; done; exit 0'
EOF

	# systemd 262's coredump manager needs PIDFD_INFO_COREDUMP (Linux 6.16).
	# On older kernels its ExecCondition fails and it is retried on every
	# login; the core_pattern pipe still records crashes.
	local unit
	for unit in systemd-coredumpd systemd-coredump-register; do
		install -d "$pkgdir/usr/lib/systemd/system/$unit.service.d"
		cat > "$pkgdir/usr/lib/systemd/system/$unit.service.d/10-marathon-kernel.conf" <<'EOF'
[Unit]
ConditionKernelVersion=>=6.16
EOF
	done

	# Cores of big processes (a WebProcess, Android's system_server) are
	# gigabytes; writing them to SD/eMMC stalls every app for minutes.
	# Three WebProcesses dying together took 50 s each at 512M and froze
	# the shell, so cores stay small and are handled at idle priority.
	install -d "$pkgdir/usr/lib/systemd/coredump.conf.d"
	cat > "$pkgdir/usr/lib/systemd/coredump.conf.d/50-marathon.conf" <<'EOF'
[Coredump]
ProcessSizeMax=64M
ExternalSizeMax=64M
MaxUse=256M
KeepFree=1G
EOF
	install -d "$pkgdir/usr/lib/systemd/system/systemd-coredump@.service.d"
	cat > "$pkgdir/usr/lib/systemd/system/systemd-coredump@.service.d/50-marathon-idle.conf" <<'EOF'
[Service]
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
EOF

    # Delegate the host's real I/O controller to the user manager. Without
    # this, native app scopes have cpu.weight but no BFQ weight interface.
    install -d "$pkgdir/usr/lib/systemd/system/user@.service.d"
    cat > "$pkgdir/usr/lib/systemd/system/user@.service.d/60-marathon-io.conf" <<'EOF'
[Service]
Delegate=cpu cpuset io memory pids
IOAccounting=yes
EOF

	# A memory floor for the shell: reclaim takes from apps first. Each
	# ancestor needs the same floor for the scope's to count, and with
	# memory_recursiveprot the scope claims all of it, so apps get none.
	local d
	for d in system/user.slice.d system/user-.slice.d system/user@.service.d \
		user/marathon.slice.d user/marathon-shell-.scope.d; do
		install -d "$pkgdir/usr/lib/systemd/$d"
		printf '[%s]\nMemoryLow=400M\n' "$(case $d in *service.d) echo Service ;; *scope.d) echo Scope ;; *) echo Slice ;; esac)" \
			> "$pkgdir/usr/lib/systemd/$d/50-marathon-shell-floor.conf"
	done

	# avahi-daemon drop-in: start after NetworkManager so /etc/resolv.conf
	# (which NM writes) exists when avahi opens it. Without this we log
	# "Failed to open /etc/resolv.conf: Invalid argument" on cold boot
	# because avahi races NM and tries to read a half-broken symlink.
	install -d "$pkgdir/etc/systemd/system/avahi-daemon.service.d"
	cat > "$pkgdir/etc/systemd/system/avahi-daemon.service.d/10-marathon-order.conf" <<'EOF'
[Unit]
After=NetworkManager.service
Wants=NetworkManager.service
EOF

	# Persistent journald. A volatile journal lost every hang's record on
	# the reboot that followed it. After a long-press power-off journald
	# reports the last file "uncleanly shut down", sets it aside and
	# starts a fresh one; at most the last seconds are lost. Synced often
	# so the lines before a hang reach the disk.
	install -d "$pkgdir/usr/lib/systemd/journald.conf.d"
	cat > "$pkgdir/usr/lib/systemd/journald.conf.d/50-marathon.conf" <<'EOF'
[Journal]
Storage=persistent
SystemMaxUse=200M
SyncIntervalSec=15s
RuntimeMaxUse=32M
RuntimeKeepFree=64M
RuntimeMaxFileSize=8M
RuntimeMaxFiles=4
MaxLevelStore=info
MaxLevelSyslog=info
ForwardToSyslog=no
ForwardToWall=no
Compress=yes
Seal=no
SplitMode=none
EOF

	# Narrow Qt logging — *.warning=true on the device floods the
	# journal with every Qt category warning across every subsystem.
	# Phosh, Lomiri, Sailfish all default Qt-quiet in production.
	# marathon.* keep their info/warning/critical channels so our
	# shell-side diagnostics remain visible.
	install -d "$pkgdir/etc/environment.d"
	cat > "$pkgdir/etc/environment.d/50-marathon-qt.conf" <<'EOF'
QT_LOGGING_RULES=*.debug=false;*.info=false;qt.qpa.*=false;qt.scenegraph.*=false;qt.quick.*=false;qt.qml.*=false;qt.text.*=false;qt.accessibility.*=false;qt.widgets.*=false;qt.gui.*=false;qt.network.*=false;qt.svg.*=false;marathon.*.warning=true;marathon.*.critical=true
EOF

	# Enable graphical target by default
	ln -sf /usr/lib/systemd/system/graphical.target \
		"$pkgdir/etc/systemd/system/default.target"
}
