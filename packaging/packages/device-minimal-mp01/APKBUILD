# MP01 deviceinfo, initramfs modules and kernel command line. The kernel is
# its own aport; scripts/build-minimal-mp01-image.sh names it from here.
pkgname=device-minimal-mp01
pkgdesc="Minimal Phone MP01"
pkgver=1
pkgrel=3
url="https://github.com/patrickjquinn/Marathon-Shell"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Kernel release 7.0.0-mp01; its out-of-tree modules carry that vermagic.
_kernel=linux-minimal-mp01
depends="
	$_kernel>=7.0.0
	postmarketos-base
	make-dynpart-mappings
	systemd-boot
	python3
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	mp01-mark-boot-successful
	mp01-mark-boot-successful.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/mp01-mark-boot-successful" "$pkgdir/usr/libexec/marathon/mp01-mark-boot-successful"
	install -Dm644 "$srcdir/mp01-mark-boot-successful.service" "$pkgdir/usr/lib/systemd/system/mp01-mark-boot-successful.service"
	install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
	ln -s ../mp01-mark-boot-successful.service "$pkgdir/usr/lib/systemd/system/graphical.target.wants/mp01-mark-boot-successful.service"
}

