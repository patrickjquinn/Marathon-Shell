# MP01 deviceinfo, initramfs modules and kernel command line. The kernel is
# its own aport; scripts/build-minimal-mp01-image.sh names it from here.
pkgname=device-minimal-mp01
pkgdesc="Minimal Phone MP01"
pkgver=1
pkgrel=0
url="https://github.com/patrickjquinn/Marathon-Shell"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Kernel release 7.0.0-mp01; its out-of-tree modules carry that vermagic.
_kernel=linux-minimal-mp01
depends="
	$_kernel>=7.0.0
	postmarketos-base
	make-dynpart-mappings
	systemd-boot
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

