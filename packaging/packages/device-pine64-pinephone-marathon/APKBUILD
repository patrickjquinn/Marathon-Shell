# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-pine64-pinephone-marathon
pkgdesc="PINE64 PinePhone device package for Marathon OS"
pkgver=1.0.0
pkgrel=0
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
# device-pine64-pinephone (pmaports testing) brings the kernel, DTBs,
# U-Boot, the modem stack (eg25-manager) and the stock boot.scr; the
# pipeline's U-Boot boot path (pipeline patch 0022) lays out the disk.
# This overlay only adds Marathon's settings for the device.
depends="
	device-pine64-pinephone
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	u-boot-tools
"
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	device-profile.conf
	marathon-boot.cmd
	"

package() {
	# greetd autologin with the PinePhone display environment (DPI, no
	# MSAA layers). The post-install points /etc/greetd/config.toml,
	# owned by marathon-base-config, at it.
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# The shell handles the power key (lock / power menu). Left to
	# logind's default, a press powers the phone off.
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"

	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf"

	# U-Boot script with splash enabled. mkosi.finalize compiles it to
	# /boot/boot.scr with mkimage (u-boot-tools), replacing the stock one.
	install -Dm644 "$srcdir/marathon-boot.cmd" \
		"$pkgdir/usr/share/marathon/marathon-boot.cmd"
}

sha512sums="
