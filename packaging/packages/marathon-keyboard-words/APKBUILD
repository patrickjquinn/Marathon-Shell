# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# The on-screen keyboard's words: how common each is and what usually
# follows it, for suggestions, autocorrection and swipe typing. Built from
# the AOSP word lists HeliBoard keeps (see NOTICE).
pkgname=marathon-keyboard-words
pkgver=0.1.0
pkgrel=0
_commit=ff0cd52be8d9530200fefe8b296c53d4f662091e
pkgdesc="Word lists for Marathon's on-screen keyboard"
url="https://codeberg.org/Helium314/aosp-dictionaries"
arch="noarch"
license="Apache-2.0 AND CC-BY-4.0"
makedepends="python3"
source="
	main_en_US-$_commit.combined::https://codeberg.org/Helium314/aosp-dictionaries/raw/commit/$_commit/wordlists/main_en_US.combined
	main_en_GB-$_commit.combined::https://codeberg.org/Helium314/aosp-dictionaries/raw/commit/$_commit/wordlists/main_en_GB__experimental.combined
	build-lexicon.py
	NOTICE
	"
options="!check"

build() {
	python3 "$srcdir"/build-lexicon.py \
		"$srcdir"/main_en_US-$_commit.combined \
		"$srcdir"/main_en_GB-$_commit.combined \
		"$builddir"/out
}

package() {
	install -Dm644 -t "$pkgdir"/usr/share/marathon/keyboard "$builddir"/out/*.lex
	install -Dm644 "$srcdir"/NOTICE "$pkgdir"/usr/share/licenses/$pkgname/NOTICE
}

sha512sums="
