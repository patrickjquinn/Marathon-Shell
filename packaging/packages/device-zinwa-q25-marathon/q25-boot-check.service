[Unit]
Description=Q25: check that this boot reached a working session
After=greetd.service q25-gpu-prepare.service sshd.service q25-splash-handover.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl -q is-active greetd.service
ExecStart=/usr/bin/systemctl -q is-active q25-gpu-prepare.service
ExecStart=/bin/sh -c '! systemctl -q is-enabled sshd.service || systemctl -q is-active sshd.service'
# A panel that never presented a frame leaves the OS up behind a black
# screen; that boot must not be blessed.
ExecStart=/bin/sh -c '! systemctl -q is-failed q25-splash-handover.service'
ExecStart=/bin/sh -c '! journalctl -b -k -q -o cat | grep -q "flip_done timed out"'

[Install]
RequiredBy=boot-complete.target
