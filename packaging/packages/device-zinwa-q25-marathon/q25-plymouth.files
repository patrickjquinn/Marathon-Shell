# Plymouth starts in the initramfs and asks for the /home PIN after
# switch_root with the keymap it loaded there: give it the Q25 layout.
/etc/vconsole.conf
/usr/share/q25-keyboard/xkb/symbols/q25:/usr/share/X11/xkb/symbols/q25
/usr/share/X11/xkb/symbols/level3
/usr/share/X11/xkb/symbols/level5
# Plymouth's text (the wordmark, the PIN prompt) falls back to this file when
# fontconfig has no config, as in the initramfs.
/usr/share/fonts/marathon/Sora-Regular.ttf:/usr/share/fonts/Plymouth.ttf
