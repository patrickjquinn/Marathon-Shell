#!/bin/sh
# NetworkManager WirelessEnabled (Marathon's Wi-Fi toggle) -> CONNSYS Wi-Fi
# power: off stops q25-wifi.service (q25-wmt wifi-off, CONN can power down
# if BT is also off), on starts it. NM keeps owning the interfaces.
nm_wireless() {
	busctl --system get-property org.freedesktop.NetworkManager \
		/org/freedesktop/NetworkManager org.freedesktop.NetworkManager \
		WirelessEnabled 2>/dev/null
}
apply() {
	case "$(nm_wireless)" in
	"b true")  systemctl start q25-wifi.service ;;
	"b false") systemctl stop q25-wifi.service ;;
	esac
}
apply
busctl --system monitor --match "type='signal',sender='org.freedesktop.NetworkManager',path='/org/freedesktop/NetworkManager',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" 2>/dev/null |
while read -r line; do
	case "$line" in *WirelessEnabled*) apply ;; esac
done
