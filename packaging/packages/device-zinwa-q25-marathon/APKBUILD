# Q25 UI overlay only; parent image owns kernel/module/CPU0/graphics policies.
pkgname=device-zinwa-q25-marathon
pkgver=1.0.0
pkgrel=1
pkgdesc="Zinwa Q25 Marathon UI device profile and greetd session"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0"
options="!check"
depends="device-mediatek-g99 marathon-shell marathon-base-config greetd"
install="$pkgname.post-install $pkgname.post-upgrade"
source="device-profile.conf greetd-marathon.toml"

package() {
    install -Dm644 "$srcdir/device-profile.conf" "$pkgdir/etc/marathon/device-profile.conf"
    install -Dm644 "$srcdir/greetd-marathon.toml" "$pkgdir/etc/greetd/marathon-config.toml"
}

