# Q25 session/profile policy; kernel, firmware and image layout are separate.
pkgname=device-zinwa-q25-marathon
pkgver=1.0.0
pkgrel=56
pkgdesc="Zinwa Q25 Marathon session, UI profile and hardware services"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="Apache-2.0"
options="!check"
depends="device-zinwa-q25 marathon-base-config marathon-shell greetd q25-gpu-render
 q25-kernel-modules>=7.0.0-r40 q25-connsys-firmware wpa_supplicant wpa_supplicant-systemd bluez-btmgmt alsa-ucm-conf
 upower-q25 q25-modem q25-gnss-firmware marathon-gnssd libcamera>=99990.8.0 libcamera-gstreamer
 cryptsetup e2fsprogs plymouth marathon-plymouth-theme nftables"
makedepends="gcc musl-dev"
install="$pkgname.post-install"
# The private generic-G99 trial overlay also owned this same generated profile.
replaces="device-mediatek-g99-marathon"
source="device-profile.conf q25-shell-session q25-shell-session.software greetd-q25.toml 50-q25-session.conf q25-session.conf.example
 q25-md1-off.service q25-wmt.c q25-connsys.service q25-wmt-launcher.service q25-wifi.service
 q25-wifi.system-sleep 50-q25-wpa_supplicant.conf
 q25-bluetooth.service q25-bt-address q25-bt-address.service q25-audio.modules-load.conf q25-audio.modprobe.conf q25-mt6366.conf HiFi.conf VoiceCall.conf 61-q25-sensor-local.rules 61-q25-gpu-autosuspend.rules q25-wlan.modprobe.conf
 unudhcpd-usb0.conf q25.preset
 q25-usb-gadget q25-usb-gadget.service q25-root-dio.service q25-root-grow q25-root-grow.service
 q25-home-crypt q25-home-crypt.service
 q25-platform-prepare q25-platform-prepare.service q25-carrier-root
 q25-zram-swap.service q25-logind.conf q25-hardening.sysctl q25-power.sysctl q25-firewall.nft q25-firewall.service q25-esp-readonly.service q25-boot-check.service q25-boot-bless.service q25-boot-bless q25-root-install q25-root-arm.service q25-lk-update q25-lk-update.service
 q25.xkb-symbols q25-keyboard-layout.env q25-vconsole.conf q25-plymouth-keyboard.conf q25-plymouth.files q25-plymouth-newroot.hook
 q25-splash-handover q25-splash-handover.service q25-splash-greetd.conf q25-splash-plymouth-quit.conf q25-splash-plymouth-quit-wait.conf q25-splash-plymouth-start.conf
 q25-usb-recovery.nm.conf 90-q25-recovery-console.rules
 q25-power-supply-ignore 99-q25-upower-duplicate.rules 90-q25-battery-model.conf 61-q25-charge-voltage.rules q25-deckard.modules-load.conf q25-haptic.modules-load.conf q25-camera.modules-load.conf q25-camera.modprobe.conf deckard.cfg marathon-deckard.tmpfiles 50-marathon-deckard.rules q25-geoclue.conf"
build() {
    mkdir -p "$builddir"
    ${CC:-gcc} $CFLAGS -Wall -Wextra -o "$builddir/q25-wmt" "$srcdir/q25-wmt.c" $LDFLAGS
}
package() {
    install -Dm644 "$srcdir/device-profile.conf" "$pkgdir/etc/marathon/device-profile.conf"
    install -Dm755 "$srcdir/q25-shell-session" "$pkgdir/usr/libexec/marathon/q25-shell-session"
    install -Dm755 "$srcdir/q25-shell-session.software" "$pkgdir/usr/libexec/marathon/q25-shell-session.software"
    install -Dm644 "$srcdir/greetd-q25.toml" "$pkgdir/etc/greetd/q25-config.toml"
    install -Dm644 "$srcdir/50-q25-session.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/50-q25-session.conf"
    install -Dm644 "$srcdir/q25-logind.conf" "$pkgdir/usr/lib/systemd/logind.conf.d/50-q25.conf"
    install -Dm644 "$srcdir/q25-hardening.sysctl" "$pkgdir/usr/lib/sysctl.d/60-q25-hardening.conf"
    install -Dm644 "$srcdir/q25-power.sysctl" "$pkgdir/usr/lib/sysctl.d/60-q25-power.conf"
    install -Dm644 "$srcdir/q25-firewall.nft" "$pkgdir/usr/share/marathon/q25-firewall.nft"
    install -Dm644 "$srcdir/q25-firewall.service" "$pkgdir/usr/lib/systemd/system/q25-firewall.service"
    install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
    ln -s ../q25-firewall.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/q25-firewall.service"
    install -Dm644 "$srcdir/q25-session.conf.example" "$pkgdir/usr/share/doc/$pkgname/q25-session.conf.example"
    # The session sources the env file; it selects the printed legends
    # (Alt symbols, Sym navigation) in place of a US layout.
    install -Dm644 "$srcdir/q25.xkb-symbols" "$pkgdir/usr/share/q25-keyboard/xkb/symbols/q25"
    install -Dm644 "$srcdir/q25-keyboard-layout.env" "$pkgdir/etc/q25/keyboard-layout-preview.env"
    # The same layout for Plymouth's PIN prompt.
    install -Dm644 "$srcdir/q25-vconsole.conf" "$pkgdir/etc/vconsole.conf"
    install -Dm644 "$srcdir/q25-plymouth-keyboard.conf" "$pkgdir/usr/lib/systemd/system/plymouth-start.service.d/50-q25-keyboard.conf"
    # And for the initramfs's Plymouth, which stays up to ask for the PIN.
    install -Dm644 "$srcdir/q25-plymouth.files" "$pkgdir/usr/share/mkinitfs/files/50-q25-plymouth.files"
    install -Dm755 "$srcdir/q25-plymouth-newroot.hook" "$pkgdir/usr/share/mkinitfs/hooks-cleanup/90-q25-plymouth-newroot.sh"
    # Plymouth moves into the root before the PIN prompt; its text needs the
    # same font there.
    install -d "$pkgdir/usr/share/fonts"
    ln -s marathon/Sora-Regular.ttf "$pkgdir/usr/share/fonts/Plymouth.ttf"
    # One Plymouth from the initramfs to the shell, which takes the display
    # over from it before it exits.
    install -Dm644 "$srcdir/q25-splash-plymouth-start.conf" "$pkgdir/usr/lib/systemd/system/plymouth-start.service.d/60-q25-initramfs.conf"
    install -Dm644 "$srcdir/q25-splash-greetd.conf" "$pkgdir/usr/lib/systemd/system/greetd.service.d/60-q25-splash.conf"
    install -Dm644 "$srcdir/q25-splash-plymouth-quit.conf" "$pkgdir/usr/lib/systemd/system/plymouth-quit.service.d/60-q25-splash.conf"
    install -Dm644 "$srcdir/q25-splash-plymouth-quit-wait.conf" "$pkgdir/usr/lib/systemd/system/plymouth-quit-wait.service.d/60-q25-splash.conf"
    install -Dm644 "$srcdir/q25-splash-handover.service" "$pkgdir/usr/lib/systemd/system/q25-splash-handover.service"
    install -Dm755 "$srcdir/q25-splash-handover" "$pkgdir/usr/libexec/marathon/q25-splash-handover"
    # Doze puts the keyboard light out, so a level saved at shutdown is usually 0.
    install -d "$pkgdir/usr/lib/systemd/system"
    ln -s /dev/null "$pkgdir/usr/lib/systemd/system/systemd-backlight@leds:6-001f::kbd_backlight.service"

    # The preloader leaves the unbooted MD1 modem domain powered.
    install -Dm644 "$srcdir/q25-md1-off.service" "$pkgdir/usr/lib/systemd/system/q25-md1-off.service"

    # Wi-Fi: CONNSYS bring-up, the WMT firmware patch server, then WLAN power.
    install -Dm755 "$builddir/q25-wmt" "$pkgdir/usr/libexec/marathon/q25-wmt"
    local unit
    for unit in q25-connsys q25-wmt-launcher q25-wifi; do
        install -Dm644 "$srcdir/$unit.service" "$pkgdir/usr/lib/systemd/system/$unit.service"
    done
    install -Dm755 "$srcdir/q25-wifi.system-sleep" "$pkgdir/usr/lib/systemd/system-sleep/q25-wifi"
    # wpa_cli and q25-wifi need the control socket; log to syslog.
    install -Dm644 "$srcdir/50-q25-wpa_supplicant.conf" "$pkgdir/usr/lib/systemd/system/wpa_supplicant.service.d/50-q25.conf"

    # Bluetooth: the HCI driver over WMT/STP, once the patch server runs.
    install -Dm644 "$srcdir/q25-bluetooth.service" "$pkgdir/usr/lib/systemd/system/q25-bluetooth.service"
    install -Dm755 "$srcdir/q25-bt-address" "$pkgdir/usr/libexec/marathon/q25-bt-address"
    install -Dm644 "$srcdir/q25-bt-address.service" "$pkgdir/usr/lib/systemd/system/q25-bt-address.service"

    # Audio: the codec has no OF match, and the AFE needs its power domain first.
    install -Dm644 "$srcdir/q25-audio.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/q25-audio.conf"
    install -Dm644 "$srcdir/q25-audio.modprobe.conf" "$pkgdir/usr/lib/modprobe.d/q25-audio.conf"
    install -Dm644 "$srcdir/q25-mt6366.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/q25-mt6366/q25-mt6366.conf"
    install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Zinwa/Q25/HiFi.conf"
    install -Dm644 "$srcdir/VoiceCall.conf" "$pkgdir/usr/share/alsa/ucm2/Zinwa/Q25/VoiceCall.conf"

    # bq256xx-battery is the charger's configuration proxy, not a battery:
    # hide it from UPower and from the shell's own gauge reader.
    install -Dm644 "$srcdir/99-q25-upower-duplicate.rules" "$pkgdir/usr/lib/udev/rules.d/99-q25-upower-duplicate.rules"
    install -Dm644 "$srcdir/q25-power-supply-ignore" "$pkgdir/etc/marathon/power-supply-ignore"
    # The kernel's MT6358 gauge is not trusted yet: the shell and UPower must
    # not shut the phone down on it.
    install -Dm644 "$srcdir/90-q25-battery-model.conf" "$pkgdir/etc/UPower/UPower.conf.d/90-q25-battery-model.conf"
    install -Dm644 "$srcdir/q25-geoclue.conf" "$pkgdir/etc/geoclue/conf.d/91-q25.conf"
    install -Dm644 "$srcdir/61-q25-charge-voltage.rules" "$pkgdir/usr/lib/udev/rules.d/61-q25-charge-voltage.rules"

    # The IMU is mounted rotated 180 degrees about Z.
    install -Dm644 "$srcdir/61-q25-sensor-local.rules" "$pkgdir/usr/lib/udev/rules.d/61-q25-sensor-local.rules"
    install -Dm644 "$srcdir/61-q25-gpu-autosuspend.rules" "$pkgdir/usr/lib/udev/rules.d/61-q25-gpu-autosuspend.rules"
    install -Dm644 "$srcdir/q25-wlan.modprobe.conf" "$pkgdir/usr/lib/modprobe.d/q25-wlan.conf"

    install -Dm644 "$srcdir/q25-deckard.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/q25-deckard.conf"
    install -Dm644 "$srcdir/q25-haptic.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/q25-haptic.conf"
    install -Dm644 "$srcdir/q25-camera.modules-load.conf" "$pkgdir/usr/lib/modules-load.d/q25-camera.conf"
    install -Dm644 "$srcdir/q25-camera.modprobe.conf" "$pkgdir/usr/lib/modprobe.d/q25-camera.conf"
    install -Dm644 "$srcdir/deckard.cfg" "$pkgdir/usr/share/marathon/deckard.cfg"
    install -Dm644 "$srcdir/marathon-deckard.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/marathon-deckard.conf"
    install -Dm644 "$srcdir/50-marathon-deckard.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-marathon-deckard.rules"

    # USB networking starts when the gadget's usb0 appears and stops when it
    # goes, instead of retrying a missing interface every second while no
    # cable is attached. The preset keeps it out of multi-user.target, which
    # would otherwise wait for the device at boot.
    install -Dm644 "$srcdir/unudhcpd-usb0.conf" "$pkgdir/usr/lib/systemd/system/unudhcpd@usb0.service.d/50-q25-usb0.conf"
    install -Dm644 "$srcdir/q25.preset" "$pkgdir/usr/lib/systemd/system-preset/05-q25.preset"
    install -d "$pkgdir/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants"
    ln -s ../unudhcpd@.service "$pkgdir/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants/unudhcpd@usb0.service"
    # The initramfs makes the USB network gadget only if a UDC exists when it
    # looks, which a boot without the cable has missed; make it here once the
    # UDC exists, and unudhcpd then follows usb0.
    # unudhcpd serves usb0, and ttyGS0 is the recovery console when the
    # gadget has an ACM function: keep NetworkManager and ModemManager off.
    install -Dm644 "$srcdir/q25-usb-recovery.nm.conf" "$pkgdir/usr/lib/NetworkManager/conf.d/90-q25-usb-recovery.conf"
    install -Dm644 "$srcdir/90-q25-recovery-console.rules" "$pkgdir/usr/lib/udev/rules.d/90-q25-recovery-console.rules"
    install -Dm755 "$srcdir/q25-usb-gadget" "$pkgdir/usr/libexec/marathon/q25-usb-gadget"
    install -Dm644 "$srcdir/q25-usb-gadget.service" "$pkgdir/usr/lib/systemd/system/q25-usb-gadget.service"
    install -d "$pkgdir/usr/lib/systemd/system/usb-gadget.target.wants"
    ln -s ../q25-usb-gadget.service "$pkgdir/usr/lib/systemd/system/usb-gadget.target.wants/q25-usb-gadget.service"

    install -Dm644 "$srcdir/q25-root-dio.service" "$pkgdir/usr/lib/systemd/system/q25-root-dio.service"
    install -Dm755 "$srcdir/q25-root-grow" "$pkgdir/usr/libexec/marathon/q25-root-grow"
    install -Dm644 "$srcdir/q25-root-grow.service" "$pkgdir/usr/lib/systemd/system/q25-root-grow.service"
    install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
    ln -s ../q25-root-dio.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/q25-root-dio.service"
    ln -s ../q25-root-grow.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/q25-root-grow.service"
    # /home is a LUKS2 file beside the root image, opened with the PIN
    # (docs/ENCRYPTION.md).
    install -Dm755 "$srcdir/q25-home-crypt" "$pkgdir/usr/libexec/marathon/q25-home-crypt"
    install -Dm644 "$srcdir/q25-home-crypt.service" "$pkgdir/usr/lib/systemd/system/q25-home-crypt.service"
    install -d "$pkgdir/usr/lib/systemd/system/local-fs.target.wants"
    ln -s ../q25-home-crypt.service "$pkgdir/usr/lib/systemd/system/local-fs.target.wants/q25-home-crypt.service"

    # CPU0 stays offline unless U-Boot handed off through BL31.
    install -Dm755 "$srcdir/q25-platform-prepare" "$pkgdir/usr/libexec/marathon/q25-platform-prepare"
    install -Dm644 "$srcdir/q25-platform-prepare.service" "$pkgdir/usr/lib/systemd/system/q25-platform-prepare.service"
    ln -s ../q25-platform-prepare.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/q25-platform-prepare.service"
    install -Dm644 "$srcdir/q25-carrier-root" "$pkgdir/etc/marathon/q25-carrier-root"
    # The root is an ext4 file inside userdata, behind an ESP that the
    # stock layout shares: nothing may repartition, or touch the ESP's
    # loader, and /etc is not a confext.
    install -d "$pkgdir/etc/systemd/system"
    for unit in systemd-repart.service systemd-repart.socket systemd-repart@.service systemd-boot-update.service systemd-confext.service; do
        ln -s /dev/null "$pkgdir/etc/systemd/system/$unit"
    done

    # The ESP holds the stock and fallback entries too: keep it read-only
    # except while q25-boot-bless renames the booted counted entry, after
    # q25-boot-check has passed.
    install -Dm644 "$srcdir/q25-esp-readonly.service" "$pkgdir/usr/lib/systemd/system/q25-esp-readonly.service"
    ln -s ../q25-esp-readonly.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/q25-esp-readonly.service"
    install -Dm755 "$srcdir/q25-boot-bless" "$pkgdir/usr/libexec/marathon/q25-boot-bless"
    # Over the air, systemd-sysupdate writes the next root beside the running
    # one; q25-root-arm boots it, counted, at the next restart (docs/OTA.md).
    install -Dm755 "$srcdir/q25-root-install" "$pkgdir/usr/libexec/marathon/q25-root-install"
    install -Dm644 "$srcdir/q25-root-arm.service" "$pkgdir/usr/lib/systemd/system/q25-root-arm.service"
    # The U-Boot the image build put in this root goes into lk_a once a boot
    # of it is blessed; the replaced lk_a stays on the carrier (docs/OTA.md).
    install -Dm755 "$srcdir/q25-lk-update" "$pkgdir/usr/libexec/marathon/q25-lk-update"
    for unit in q25-boot-check q25-boot-bless q25-lk-update; do
        install -Dm644 "$srcdir/$unit.service" "$pkgdir/usr/lib/systemd/system/$unit.service"
    done
    install -d "$pkgdir/usr/lib/systemd/system/boot-complete.target.requires" "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
    ln -s ../q25-boot-check.service "$pkgdir/usr/lib/systemd/system/boot-complete.target.requires/q25-boot-check.service"
    ln -s ../q25-boot-bless.service "$pkgdir/usr/lib/systemd/system/graphical.target.wants/q25-boot-bless.service"
    ln -s ../q25-lk-update.service "$pkgdir/usr/lib/systemd/system/graphical.target.wants/q25-lk-update.service"

    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    install -Dm644 "$srcdir/q25-zram-swap.service" "$pkgdir/usr/lib/systemd/system/q25-zram-swap.service"
    for unit in q25-md1-off q25-connsys q25-wmt-launcher q25-wifi q25-bluetooth q25-bt-address q25-root-arm q25-zram-swap; do
        ln -s ../$unit.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/$unit.service"
    done
    install -d "$pkgdir/usr/lib/systemd/system/bluetooth.target.wants"
    for unit in q25-bluetooth q25-bt-address; do
        ln -s ../$unit.service "$pkgdir/usr/lib/systemd/system/bluetooth.target.wants/$unit.service"
    done
}
