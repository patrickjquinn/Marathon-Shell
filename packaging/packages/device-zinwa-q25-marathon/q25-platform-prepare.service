[Unit]
Description=Q25 CPU0: keep it offline unless U-Boot handed off through BL31
DefaultDependencies=no
Before=systemd-udevd.service sysinit.target greetd.service
[Service]
Type=oneshot
ExecStart=/usr/libexec/marathon/q25-platform-prepare
RemainAfterExit=yes
TimeoutStartSec=15
[Install]
WantedBy=sysinit.target
