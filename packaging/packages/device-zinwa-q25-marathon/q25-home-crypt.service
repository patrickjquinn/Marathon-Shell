[Unit]
Description=Q25: open the encrypted /home
DefaultDependencies=no
Wants=systemd-udev-trigger.service
After=systemd-modules-load.service systemd-udev-trigger.service systemd-remount-fs.service plymouth-start.service q25-root-grow.service
Before=local-fs.target systemd-user-sessions.service
ConditionPathIsMountPoint=!/home

[Service]
Type=oneshot
RemainAfterExit=yes
# A PIN prompt waits for the person.
TimeoutStartSec=infinity
# A charger turned the phone on: it shows the charging screen, no PIN.
ExecCondition=/bin/sh -c '! marathon-charger boot-mode charger 2>/dev/null'
ExecStart=/usr/libexec/marathon/q25-home-crypt

[Install]
WantedBy=local-fs.target
