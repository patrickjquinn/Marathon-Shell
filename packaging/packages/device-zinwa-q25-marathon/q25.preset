disable unudhcpd@.service
# q25-modem-init starts it once the modem is up; enabled, multi-user.target
# waits for the modem bring-up it is ordered after.
disable ModemManager.service
# q25-zram-swap.service sets it up off the boot path.
disable postmarketos-zram-swap.service
# Nothing on the phone uses mDNS; it would announce the phone on every
# network it joins. Sorts before 10-marathon.preset, which enables it.
disable avahi-daemon.service
disable avahi-daemon.socket
# D-Bus activates it for the rare client; nothing needs it at boot.
disable udisks2.service
