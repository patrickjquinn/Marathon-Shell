# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# The Pilot app (apps/pilot): a Keel app (CXX-Qt) run under
# marathon-keel-host, talking to pilotd (shoal-pilotd). Started by the
# shell, it makes its overlay (ui/Overlay.qml) titled keel:dialog:pilot, which
# the compositor shows over the app on screen.
# scripts/qemu/lib/build-pilot-apk.sh stages this repository's tree as the
# source tarball, so the URL below is fetched only by a standalone abuild,
# and it follows a branch.
pkgname=shoal-pilot
pkgver=0.1.0
pkgrel=4
pkgdesc="Pilot assistant for Marathon"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64 x86_64"
license="Apache-2.0"
depends="
	keel-silica
	qt6-qtdeclarative
	qt6-qtmultimedia
	shoal-pilotd
	"
makedepends="
	cargo
	clang
	keel-silica-dev
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz"
builddir="$srcdir/Marathon-Shell-main"
options="!check net"

build() {
	export QMAKE=/usr/lib/qt6/bin/qmake
	export KEEL_SAILFISHAPP_INCLUDEDIR=/usr/include/keel/sailfishapp
	export KEEL_SAILFISHAPP_LIBDIR=/usr/lib
	cargo build --release --locked --manifest-path apps/pilot/Cargo.toml
}

package() {
	local a=apps/pilot
	install -Dm755 $a/target/release/libshoal_pilot.so "$pkgdir"/usr/bin/shoal-pilot
	install -d "$pkgdir"/usr/share/shoal-pilot/qml
	cp -R $a/ui/. "$pkgdir"/usr/share/shoal-pilot/qml/
	install -Dm644 $a/shoal-pilot.desktop "$pkgdir"/usr/share/applications/shoal-pilot.desktop
	local s
	for s in 86 108 128 172; do
		install -Dm644 $a/icons/${s}x$s/shoal-pilot.png \
			"$pkgdir"/usr/share/icons/hicolor/${s}x$s/apps/shoal-pilot.png
	done
}

sha512sums="
SKIP  shoal-pilot-0.1.0.tar.gz
"
