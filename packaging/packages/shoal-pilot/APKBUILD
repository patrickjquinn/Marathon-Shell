# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
# The Pilot app (shoal/pilot/app and ui), Shipwright's assistant, for
# Marathon: a Keel app (CXX-Qt) run under marathon-keel-host, talking to
# pilotd (shoal-pilotd). Built from a Shipwright commit like pacific;
# scripts/qemu/lib/build-pilot-apk.sh stages a local checkout.
# 0001 makes the overlay (ui/Overlay.qml) under Marathon's Keel host,
# titled keel:dialog:pilot so the compositor shows it over the app on
# screen.
pkgname=shoal-pilot
pkgver=0.1.0
pkgrel=0
_commit=6e194e7e2a495e9b368dcc31e1b7cceac5ba7712
pkgdesc="Pilot assistant for Marathon"
url="https://github.com/patrickjquinn/shipwright-open"
arch="aarch64 x86_64"
license="LicenseRef-Shipwright-Proprietary"
depends="
	keel-silica
	qt6-qtdeclarative
	qt6-qtmultimedia
	shoal-pilotd
	"
makedepends="
	cargo
	clang
	keel-silica-dev
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	"
source="shoal-pilot-$_commit.tar.gz::https://github.com/patrickjquinn/shipwright-open/archive/$_commit.tar.gz
	0001-shoal-pilot-overlay-under-marathon-keel-host.patch
	shoal-pilot.desktop
	"
builddir="$srcdir/shipwright-open-$_commit"
options="!check net"

build() {
	export CARGO_TARGET_DIR="$builddir/target"
	export QMAKE=/usr/lib/qt6/bin/qmake
	export KEEL_SAILFISHAPP_INCLUDEDIR=/usr/include/keel/sailfishapp
	export KEEL_SAILFISHAPP_LIBDIR=/usr/lib
	cargo build --release --locked --manifest-path shoal/pilot/app/Cargo.toml
}

package() {
	install -Dm755 target/release/libshoal_pilot.so "$pkgdir"/usr/bin/shoal-pilot
	install -d "$pkgdir"/usr/share/shoal-pilot/qml
	cp -R shoal/pilot/ui/. "$pkgdir"/usr/share/shoal-pilot/qml/
	install -Dm644 "$srcdir"/shoal-pilot.desktop "$pkgdir"/usr/share/applications/shoal-pilot.desktop
	local s
	for s in 86 108 128 172; do
		install -Dm644 icons/hicolor/${s}x$s/apps/shoal-pilot.png \
			"$pkgdir"/usr/share/icons/hicolor/${s}x$s/apps/shoal-pilot.png
	done
}

sha512sums="
SKIP  shoal-pilot-$_commit.tar.gz
"
