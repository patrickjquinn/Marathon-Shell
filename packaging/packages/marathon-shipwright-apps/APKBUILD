# Maintainer: Patrick Quinn <patrick@jquinn.com>
# Marathon's closed app from Shipwright: Pacific. It is published prebuilt
# (packaging/vendor/shipwright.lock); with it in the repository apk installs
# this alongside the UI, and without it an image builds and runs without it.
pkgname=marathon-shipwright-apps
pkgver=1.0.0
pkgrel=1
pkgdesc="Marathon's Shipwright app: Pacific"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="noarch"
license="Apache-2.0"
depends="pacific"
install_if="postmarketos-ui-marathon"
options="!check"

package() {
	mkdir -p "$pkgdir"
}
