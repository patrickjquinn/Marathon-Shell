+/**
+ * \brief Initialise the algorithm from the tuning data
+ * \param[in] tuningData The tuning data of the algorithm
+ * \param[in] lensControls The lens controls
+ *
+ * Calling this function is optional: without it, the algorithm uses the
+ * default tuning parameters.
+ *
+ * \return 0 on success, a negative error code otherwise
+ */
+int AfAlgorithm::init(const ValueNode &tuningData, const ControlInfoMap &lensControls)
+{
+	coarseStep_ = tuningData["coarse-step"].get<uint32_t>(kCoarseSearchStep);
+	fineStep_ = tuningData["fine-step"].get<uint32_t>(kFineSearchStep);
+	maxChange_ = tuningData["max-change"].get<double>(kMaxChange);
+	skipFrames_ = tuningData["skip-frames"].get<uint32_t>(kIgnoreFrame);
+
+	if (!coarseStep_ || !fineStep_) {
+		LOG(Af, Error) << "Invalid scan steps";
+		return -EINVAL;
+	}
+
+	if (tuningData.contains("map")) {
+		std::optional<Pwl> map = tuningData["map"].get<Pwl>();
+		if (!map || map->size() < 2 || !map->inverse().second) {
+			LOG(Af, Error) << "Invalid lens position map";
+			return -EINVAL;
+		}
+
+		map_ = std::move(*map);
+		tunedMap_ = true;
+	}
+
+	setLensLimits(lensControls);
+
+	LOG(Af, Debug)
+		<< "Coarse step " << coarseStep_ << ", fine step " << fineStep_
+		<< ", max change " << maxChange_ << ", skip frames " << skipFrames_
+		<< ", lens map " << map_.toString();
+
+	return 0;
+}
+
+void AfAlgorithm::setLensLimits(const ControlInfoMap &lensControls)
+{
+	int32_t lensMin = 0;
+	int32_t lensMax = kMaxFocusSteps;
+	int32_t lensDefault = 0;
+
+	const auto it = lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it != lensControls.end()) {
+		const ControlInfo &focusInfo = it->second;
+		if (!focusInfo.min().isNone())
+			lensMin = focusInfo.min().get<int32_t>();
+		if (!focusInfo.max().isNone())
+			lensMax = focusInfo.max().get<int32_t>();
+		if (!focusInfo.def().isNone())
+			lensDefault = focusInfo.def().get<int32_t>();
+	}
+
+	lensMin = std::max(lensMin, 0);
+	lensMax = std::max(lensMax, lensMin);
+
+	if (!tunedMap_) {
+		map_.clear();
+		map_.append(0.0, lensMin);
+		map_.append(kDefaultMaxDioptres, lensMax);
+	}
+	inverseMap_ = map_.inverse().first;
+
+	const Pwl::Interval range = map_.range();
+	minFocus_ = std::clamp<int32_t>(std::lround(range.start), lensMin, lensMax);
+	maxFocus_ = std::clamp<int32_t>(std::lround(range.end), minFocus_, lensMax);
+	defaultFocus_ = std::clamp<int32_t>(lensDefault, minFocus_, maxFocus_);
+}
+
+/**
+ * \brief Retrieve the control information of the LensPosition control
+ *
+ * The range covers the dioptre map, and the default is the lens default
+ * position.
+ *
+ * \return The LensPosition control information
+ */
+ControlInfo AfAlgorithm::lensPositionInfo() const
+{
+	const Pwl::Interval domain = map_.domain();
+
+	return ControlInfo(static_cast<float>(domain.start),
+			   static_cast<float>(domain.end),
+			   static_cast<float>(inverseMap_.eval(defaultFocus_)));
+}
