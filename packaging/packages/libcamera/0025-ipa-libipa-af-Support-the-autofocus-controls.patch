+/**
+ * \brief Retrieve the lens position in dioptres, for the LensPosition metadata
+ * \param[in] state The autofocus state
+ * \return The lens position in dioptres
+ */
+float AfAlgorithm::lensPosition(const af::ActiveState &state) const
+{
+	return inverseMap_.eval(state.focus);
+}
