diff --git a/test/ipa/libipa/af.cpp b/test/ipa/libipa/af.cpp
new file mode 100644
index 00000000..534fa164
--- /dev/null
+++ b/test/ipa/libipa/af.cpp
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, Patrick Quinn
+ *
+ * Autofocus algorithm tests
+ */
+
+#include "../src/ipa/libipa/af.h"
+
+#include <cmath>
+#include <iostream>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+
+#include <libcamera/base/file.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "test.h"
+
+using namespace std;
+using namespace libcamera;
+using namespace ipa;
+
+#define ASSERT_TRUE(cond)                                             \
+	if (!(cond)) {                                                \
+		std::cout << "Failed: " #cond " at line " << __LINE__ \
+			  << std::endl;                               \
+		return TestFail;                                      \
+	}
+
+class AfTest : public Test
+{
+protected:
+	/* A contrast curve peaking at the lens position peak_. */
+	double variance(uint32_t focus) const
+	{
+		const double d = (static_cast<double>(focus) - peak_) / 80.0;
+		return flat_ ? 0.0 : 1.0 / (1.0 + d * d);
+	}
+
+	/* Run the algorithm until it leaves the scanning state. */
+	unsigned int run(AfAlgorithm &af, af::ActiveState &state, unsigned int frames)
+	{
+		unsigned int i;
+		for (i = 0; i < frames; i++) {
+			af.process(state, variance(state.focus));
+			if (af.afState() != controls::AfStateScanning)
+				break;
+		}
+		return i;
+	}
+
+	std::unique_ptr<ValueNode> parse(const std::string &content)
+	{
+		std::string filename = "/tmp/libcamera.test.af.XXXXXX";
+		int fd = mkstemp(&filename.front());
+		if (fd == -1)
+			return nullptr;
+
+		ssize_t ret = write(fd, content.c_str(), content.size());
+		close(fd);
+
+		std::unique_ptr<ValueNode> root;
+		if (ret == static_cast<ssize_t>(content.size())) {
+			File file{ filename };
+			if (file.open(File::OpenModeFlag::ReadOnly))
+				root = YamlParser::parse(file);
+		}
+
+		unlink(filename.c_str());
+		return root;
+	}
+
+	int runTuned()
+	{
+		AfAlgorithm af;
+		af::ActiveState state{};
+
+		std::unique_ptr<ValueNode> tuning =
+			parse("coarse-step: 80\n"
+			      "fine-step: 20\n"
+			      "skip-frames: 1\n"
+			      "map: [ 0.0, 100, 8.0, 900 ]\n");
+		ASSERT_TRUE(tuning);
+		ASSERT_TRUE(af.init(*tuning, ControlInfoMap{}) == 0);
+
+		const ControlInfo info = af.lensPositionInfo();
+		ASSERT_TRUE(info.min().get<float>() == 0.0f);
+		ASSERT_TRUE(info.max().get<float>() == 8.0f);
+
+		/* The scan stays within the map, and finds the peak. */
+		af.configure(state, ControlInfoMap{});
+		ASSERT_TRUE(state.focus == 100);
+		peak_ = 650;
+		unsigned int frames = run(af, state, 1000);
+		ASSERT_TRUE(af.afState() == controls::AfStateFocused);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 650) <= 20);
+		ASSERT_TRUE(frames < 20);
+
+		af.setMode(state, controls::AfModeManual);
+		af.setLensPosition(state, 20.0f);
+		ASSERT_TRUE(state.focus == 900);
+
+		/* A map with less than two points is refused. */
+		AfAlgorithm bad;
+		tuning = parse("map: [ 0.0, 100 ]\n");
+		ASSERT_TRUE(tuning);
+		ASSERT_TRUE(bad.init(*tuning, ControlInfoMap{}) < 0);
+
+		return TestPass;
+	}
+
+	int run() override
+	{
+		if (runTuned() != TestPass)
+			return TestFail;
+
+		AfAlgorithm af;
+		af::ActiveState state{};
+
+		/* The default mode scans continuously, over 0 to 1023. */
+		af.configure(state, ControlInfoMap{});
+		ASSERT_TRUE(af.mode() == controls::AfModeContinuous);
+		ASSERT_TRUE(af.afState() == controls::AfStateScanning);
+
+		peak_ = 400;
+		run(af, state, 1000);
+		ASSERT_TRUE(af.afState() == controls::AfStateFocused);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 400) <= 2);
+
+		/* A scene change starts a new scan. */
+		peak_ = 700;
+		for (unsigned int i = 0; i < 20; i++)
+			af.process(state, variance(state.focus));
+		ASSERT_TRUE(af.afState() == controls::AfStateScanning);
+		run(af, state, 1000);
+		ASSERT_TRUE(af.afState() == controls::AfStateFocused);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 700) <= 2);
+
+		/* Pausing stops the lens, resuming carries on. */
+		peak_ = 300;
+		af.meteringChanged(state);
+		for (unsigned int i = 0; i < 15; i++)
+			af.process(state, variance(state.focus));
+		af.setPause(controls::AfPauseImmediate);
+		ASSERT_TRUE(af.pauseState() == controls::AfPauseStatePaused);
+		const uint32_t paused = state.focus;
+		for (unsigned int i = 0; i < 20; i++)
+			af.process(state, variance(state.focus));
+		ASSERT_TRUE(state.focus == paused);
+		af.setPause(controls::AfPauseResume);
+		run(af, state, 1000);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 300) <= 2);
+
+		/* The auto mode only scans on a trigger, once. */
+		af.setMode(state, controls::AfModeAuto);
+		ASSERT_TRUE(af.afState() == controls::AfStateIdle);
+		peak_ = 500;
+		for (unsigned int i = 0; i < 20; i++)
+			af.process(state, variance(state.focus));
+		ASSERT_TRUE(af.afState() == controls::AfStateIdle);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 300) <= 2);
+
+		af.setTrigger(state, controls::AfTriggerStart);
+		ASSERT_TRUE(af.afState() == controls::AfStateScanning);
+		run(af, state, 1000);
+		ASSERT_TRUE(af.afState() == controls::AfStateFocused);
+		ASSERT_TRUE(std::abs(static_cast<int>(state.focus) - 500) <= 2);
+
+		peak_ = 100;
+		for (unsigned int i = 0; i < 20; i++)
+			af.process(state, variance(state.focus));
+		ASSERT_TRUE(af.afState() == controls::AfStateFocused);
+
+		/* A scan with no contrast fails. */
+		flat_ = true;
+		af.setTrigger(state, controls::AfTriggerStart);
+		run(af, state, 1000);
+		ASSERT_TRUE(af.afState() == controls::AfStateFailed);
+		flat_ = false;
+
+		/* The manual mode maps 0 to 10 dioptres over the lens range. */
+		af.setMode(state, controls::AfModeManual);
+		ASSERT_TRUE(af.afState() == controls::AfStateIdle);
+		af.setLensPosition(state, 5.0f);
+		ASSERT_TRUE(state.focus == 512);
+		ASSERT_TRUE(std::abs(af.lensPosition(state) - 5.0f) < 0.01f);
+		af.setLensPosition(state, 20.0f);
+		ASSERT_TRUE(state.focus == 1023);
+
+		/* The lens position is ignored outside of the manual mode. */
+		af.setMode(state, controls::AfModeAuto);
+		af.setLensPosition(state, 0.0f);
+		ASSERT_TRUE(state.focus == 1023);
+
+		const ControlInfo info = af.lensPositionInfo();
+		ASSERT_TRUE(info.min().get<float>() == 0.0f);
+		ASSERT_TRUE(info.max().get<float>() == 10.0f);
+
+		return TestPass;
+	}
+
+private:
+	double peak_ = 0.0;
+	bool flat_ = false;
+};
+
+TEST_REGISTER(AfTest)
