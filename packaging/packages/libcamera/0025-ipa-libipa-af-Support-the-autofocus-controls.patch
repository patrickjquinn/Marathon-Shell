+/**
+ * \brief Set the autofocus mode
+ * \param[in] state The autofocus state
+ * \param[in] mode The AfMode
+ *
+ * The AfModeContinuous mode starts a scan right away, the AfModeAuto mode
+ * waits for an AfTriggerStart.
+ */
+void AfAlgorithm::setMode(af::ActiveState &state, controls::AfModeEnum mode)
+{
+	if (mode == mode_)
+		return;
+
+	LOG(Af, Debug) << "Mode " << mode_ << " -> " << mode;
+
+	mode_ = mode;
+	pauseState_ = controls::AfPauseStateRunning;
+
+	if (mode_ == controls::AfModeContinuous)
+		startScan(state);
+	else
+		afState_ = controls::AfStateIdle;
+}
+
+/**
+ * \brief Start or cancel a scan in the AfModeAuto mode
+ * \param[in] state The autofocus state
+ * \param[in] trigger The AfTrigger
+ */
+void AfAlgorithm::setTrigger(af::ActiveState &state, controls::AfTriggerEnum trigger)
+{
+	if (mode_ != controls::AfModeAuto) {
+		LOG(Af, Debug) << "Ignoring AfTrigger outside of AfModeAuto";
+		return;
+	}
+
+	switch (trigger) {
+	case controls::AfTriggerStart:
+		startScan(state);
+		break;
+	case controls::AfTriggerCancel:
+		if (afState_ == controls::AfStateScanning)
+			afState_ = controls::AfStateIdle;
+		break;
+	}
+}
+
+/**
+ * \brief Pause or resume the AfModeContinuous mode
+ * \param[in] pause The AfPause
+ */
+void AfAlgorithm::setPause(controls::AfPauseEnum pause)
+{
+	if (mode_ != controls::AfModeContinuous) {
+		LOG(Af, Debug) << "Ignoring AfPause outside of AfModeContinuous";
+		return;
+	}
+
+	switch (pause) {
+	case controls::AfPauseImmediate:
+		pauseState_ = controls::AfPauseStatePaused;
+		break;
+	case controls::AfPauseDeferred:
+		if (afState_ == controls::AfStateScanning)
+			pauseState_ = controls::AfPauseStatePausing;
+		else
+			pauseState_ = controls::AfPauseStatePaused;
+		break;
+	case controls::AfPauseResume:
+		pauseState_ = controls::AfPauseStateRunning;
+		break;
+	}
+}
+
+/**
+ * \brief Move the lens in the AfModeManual mode
+ * \param[in] state The autofocus state
+ * \param[in] position The LensPosition, in dioptres
+ */
+void AfAlgorithm::setLensPosition(af::ActiveState &state, float position)
+{
+	if (mode_ != controls::AfModeManual) {
+		LOG(Af, Debug) << "Ignoring LensPosition outside of AfModeManual";
+		return;
+	}
+
+	state.focus = std::clamp<int64_t>(std::lround(map_.eval(position)),
+					  minFocus_, maxFocus_);
+
+	LOG(Af, Debug) << "Lens position " << position << " -> " << state.focus;
+}
+
+/**
+ * \brief Notify the algorithm that the variance measures another area
+ * \param[in] state The autofocus state
+ *
+ * In the AfModeContinuous mode, start a new scan unless paused, as the
+ * focused position is unlikely to suit the new area. Call it when the
+ * AfMetering or AfWindows controls change.
+ */
+void AfAlgorithm::meteringChanged(af::ActiveState &state)
+{
+	if (mode_ == controls::AfModeContinuous &&
+	    pauseState_ == controls::AfPauseStateRunning)
+		startScan(state);
+}
+
+/**
+ * \brief Start a scan from the lower end of the lens range
+ * \param[in] state The autofocus state
+ */
+void AfAlgorithm::startScan(af::ActiveState &state)
+{
+	state.maxVariance = 0;
+	state.focus = minFocus_;
+	state.stable = false;
+	focus_ = minFocus_;
+	bestFocus_ = minFocus_;
+	maxStep_ = maxFocus_;
+	coarseCompleted_ = false;
+	ignoreCounter_ = skipFrames_;
+	afState_ = controls::AfStateScanning;
+}
+
+/**
+ * \brief Run a scan step
+ * \param[in] state The autofocus state
+ */
+void AfAlgorithm::scan(af::ActiveState &state)
+{
+	if (!coarseCompleted_) {
+		afCoarseScan(state);
+		return;
+	}
+
+	afFineScan(state);
+	if (!state.stable)
+		return;
+
+	afState_ = state.maxVariance > 0.0 ? controls::AfStateFocused
+					   : controls::AfStateFailed;
+	afIgnoreFrameReset();
+	if (pauseState_ == controls::AfPauseStatePausing)
+		pauseState_ = controls::AfPauseStatePaused;
+}
