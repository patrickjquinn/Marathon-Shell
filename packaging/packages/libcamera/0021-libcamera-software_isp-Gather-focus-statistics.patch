diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
index 4fb834f8..bf702c0c 100644
--- a/src/ipa/softisp/algorithms/af.cpp
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -40,7 +40,20 @@ void Af::process(IPAContext &context,
 		 const SwIspStats *stats,
 		 [[maybe_unused]] ControlList &metadata)
 {
-	const double variance = stats->variance;
+	uint64_t contrast = 0;
+	uint64_t sum = 0;
+	uint64_t count = 0;
+	for (const SwIspStats::FocusZone &zone : stats->focus) {
+		contrast += zone.contrast;
+		sum += zone.sum;
+		count += zone.count;
+	}
+
+	/* Normalise to the brightness so that exposure changes don't count. */
+	double variance = 0.0;
+	if (sum)
+		variance = static_cast<double>(contrast) * count / sum / sum;
+
 	LOG(IPASoftIspAf, Debug) << "Focus stats: " << variance;
 	afAlgo_.process(context.activeState.af, variance);
 }
