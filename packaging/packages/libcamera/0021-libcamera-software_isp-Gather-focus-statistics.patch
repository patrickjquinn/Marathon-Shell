 .../internal/software_isp/swstats_cpu.h       | 23 ++---
 src/ipa/softisp/algorithms/af.cpp             | 15 +++-
 src/libcamera/software_isp/swstats_cpu.cpp    | 83 ++++++++++++-------
 4 files changed, 114 insertions(+), 43 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index a0f6f4a7..54ec8f4e 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -27,7 +27,11 @@ namespace libcamera {
  * - The histogram groups pixels in bins based on their luminance and counts
  *   the number of pixels in each bin. Saturated pixels are included.
  *
- * - The variance value for autofocus.
+ * - The focus statistics divide the statistics window in a grid of
+ *   kFocusZonesX x kFocusZonesY zones. Each zone sums the squared differences
+ *   between horizontally neighbouring green samples, a measure of the image
+ *   contrast that peaks when the image is in focus. Samples next to a
+ *   saturated one are skipped as clipping hides their real contrast.
  *
  * The value types are large enough to not overflow. Should they still overflow
  * for some reason, no check is performed and they wrap around.
@@ -59,9 +63,35 @@ struct SwIspStats {
 	 */
 	Histogram yHistogram;
 	/**
-	 * \brief A variance value for the autofocus algorithm
+	 * \brief Number of focus zones horizontally
 	 */
-	double variance;
+	static constexpr unsigned int kFocusZonesX = 8;
+	/**
+	 * \brief Number of focus zones vertically
+	 */
+	static constexpr unsigned int kFocusZonesY = 8;
+	/**
+	 * \brief Focus statistics of one zone
+	 */
+	struct FocusZone {
+		/**
+		 * \brief Sum of the squared differences of neighbouring
+		 * green samples
+		 */
+		uint64_t contrast;
+		/**
+		 * \brief Sum of the green samples accumulated in \a contrast
+		 */
+		uint64_t sum;
+		/**
+		 * \brief Number of differences accumulated in \a contrast
+		 */
+		uint32_t count;
+	};
+	/**
+	 * \brief Focus statistics of the zones, in raster order
+	 */
+	std::array<FocusZone, kFocusZonesX * kFocusZonesY> focus;
 };
 
 } /* namespace libcamera */
