index 55187092..9695e772 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -95,6 +95,7 @@ private:
 	void statsBGGR10Line0(const uint8_t *src[], SwIspStats &stats);
 	/* Bayer 12 bpp unpacked */
 	void statsBGGR12Line0(const uint8_t *src[], SwIspStats &stats);
+	void statsBGGR14Line0(const uint8_t *src[], SwIspStats &stats);
 	/* Bayer 10 bpp packed */
 	void statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats);
 	void statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats);
diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index be2f89dd..fb9b28d7 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -52,6 +52,9 @@ void main(void) {
     #elif defined(RAW12P)
     #define pixel(p) p.r / 16.0 + p.g * 16.0
     #define fetch(x, y) pixel(texture2D(tex_y, vec2(x, y)))
+    #elif defined(RAW14)
+    #define pixel(p) p.r / 64.0 + p.g * 4.0
+    #define fetch(x, y) pixel(texture2D(tex_y, vec2(x, y)))
     #else
     #define fetch(x, y) texture2D(tex_y, vec2(x, y)).r
     #endif
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index 91867baa..dd53cc17 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -263,6 +263,30 @@ void DebayerCpu::debayer12_GRGR_BGR888(uint8_t *dst, const uint8_t *src[])
 	}
 }
 
+template<bool addAlphaByte, bool ccmEnabled>
+void DebayerCpu::debayer14_BGBG_BGR888(uint8_t *dst, const uint8_t *src[])
+{
+	DECLARE_SRC_POINTERS(uint16_t)
+
+	for (int x = 0; x < (int)window_.width;) {
+		/* divide values by 64 for 14 -> 8 bpp value */
+		BGGR_BGR888(1, 1, 64)
+		GBRG_BGR888(1, 1, 64)
+	}
+}
+
+template<bool addAlphaByte, bool ccmEnabled>
+void DebayerCpu::debayer14_GRGR_BGR888(uint8_t *dst, const uint8_t *src[])
+{
+	DECLARE_SRC_POINTERS(uint16_t)
+
+	for (int x = 0; x < (int)window_.width;) {
+		/* divide values by 64 for 14 -> 8 bpp value */
+		GRBG_BGR888(1, 1, 64)
+		RGGB_BGR888(1, 1, 64)
+	}
+}
+
 template<bool addAlphaByte, bool ccmEnabled>
 void DebayerCpu::debayer10P_BGBG_BGR888(uint8_t *dst, const uint8_t *src[])
 {
@@ -440,7 +464,8 @@ int DebayerCpu::getInputConfig(PixelFormat inputFormat, DebayerInputConfig &conf
 						   formats::XBGR8888,
 						   formats::ABGR8888 };
 
-	if ((bayerFormat.bitDepth == 8 || bayerFormat.bitDepth == 10 || bayerFormat.bitDepth == 12) &&
+	if ((bayerFormat.bitDepth == 8 || bayerFormat.bitDepth == 10 ||
+	     bayerFormat.bitDepth == 12 || bayerFormat.bitDepth == 14) &&
 	    bayerFormat.packing == BayerFormat::Packing::None &&
 	    isStandardBayerOrder(bayerFormat.order)) {
 		config.bpp = (bayerFormat.bitDepth + 7) & ~7;
@@ -561,7 +586,8 @@ int DebayerCpu::setDebayerFunctions(PixelFormat inputFormat,
 		return invalidFmt();
 	}
 
-	if ((bayerFormat.bitDepth == 8 || bayerFormat.bitDepth == 10 || bayerFormat.bitDepth == 12) &&
+	if ((bayerFormat.bitDepth == 8 || bayerFormat.bitDepth == 10 ||
+	     bayerFormat.bitDepth == 12 || bayerFormat.bitDepth == 14) &&
 	    bayerFormat.packing == BayerFormat::Packing::None &&
 	    isStandardBayerOrder(bayerFormat.order)) {
 		switch (bayerFormat.bitDepth) {
@@ -574,6 +600,9 @@ int DebayerCpu::setDebayerFunctions(PixelFormat inputFormat,
 		case 12:
 			SET_DEBAYER_METHODS(debayer12_BGBG_BGR888, debayer12_GRGR_BGR888)
 			break;
+		case 14:
+			SET_DEBAYER_METHODS(debayer14_BGBG_BGR888, debayer14_GRGR_BGR888)
+			break;
 		}
 		setupStandardBayerOrder(bayerFormat.order);
 		return 0;
