 		firstRed_x_ = 0.0;
 		firstRed_y_ = 0.0;
 		break;
@@ -242,6 +256,16 @@ int DebayerEGL::initBayerShaders(PixelFormat inputFormat, PixelFormat outputForm
 			shaderStridePixels_ = width_;
 		}
 		break;
