From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Wed, 18 Nov 2026 21:26:06 +0000
Subject: [PATCH] libcamera: camera_sensor: Honour a minimum vertical blanking
 for the IMX111

The software ISP AGC now programs the vertical blanking. In the IMX111's
3280x2464 mode its default 15 to 30 fps frame duration range is out of
reach, so it clamps the frame to the sensor minimum, and with the
driver's minimum vertical blanking of 16 lines the sensor stops
streaming after two or three frames. On a Zinwa Q25 the mode streams
with 26 lines, its default, and more, and stalls with 16, 20 and 24, at
any exposure.

Add an optional minimum vertical blanking to the sensor properties and
raise the minimum frame length reported to the IPA to it, and set it to
26 lines for the IMX111. The proper fix is a larger minimum in the
driver; this keeps the camera working until then.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 include/libcamera/internal/camera_sensor_properties.h |  1 +
 src/libcamera/sensor/camera_sensor_legacy.cpp         |  5 ++++-
 src/libcamera/sensor/camera_sensor_properties.cpp     | 11 +++++++++++
 src/libcamera/sensor/camera_sensor_raw.cpp            |  5 ++++-
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/include/libcamera/internal/camera_sensor_properties.h b/include/libcamera/internal/camera_sensor_properties.h
index d7d4dab6..e2737189 100644
--- a/include/libcamera/internal/camera_sensor_properties.h
+++ b/include/libcamera/internal/camera_sensor_properties.h
@@ -29,6 +29,7 @@ struct CameraSensorProperties {
 	Size unitCellSize;
 	std::map<controls::draft::TestPatternModeEnum, int32_t> testPatternModes;
 	SensorDelays sensorDelays;
+	uint32_t minVerticalBlanking = 0;
 };
 
 } /* namespace libcamera */
diff --git a/src/libcamera/sensor/camera_sensor_legacy.cpp b/src/libcamera/sensor/camera_sensor_legacy.cpp
index 0e2085d9..7192fe5d 100644
--- a/src/libcamera/sensor/camera_sensor_legacy.cpp
+++ b/src/libcamera/sensor/camera_sensor_legacy.cpp
@@ -943,7 +943,10 @@ int CameraSensorLegacy::sensorInfo(IPACameraSensorInfo *info) const
 	info->maxLineLength = info->outputSize.width + hblank.max().get<int32_t>();
 
 	const ControlInfo vblank = ctrls.infoMap()->at(V4L2_CID_VBLANK);
-	info->minFrameLength = info->outputSize.height + vblank.min().get<int32_t>();
+	uint32_t minVblank = vblank.min().get<int32_t>();
+	if (staticProps_)
+		minVblank = std::max(minVblank, staticProps_->minVerticalBlanking);
+	info->minFrameLength = info->outputSize.height + minVblank;
 	info->maxFrameLength = info->outputSize.height + vblank.max().get<int32_t>();
 
 	return 0;
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index 7cae3d98..3741cc83 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -49,6 +49,15 @@ LOG_DEFINE_CATEGORY(CameraSensorProperties)
  * available or have not been measured.
  */
 
+/**
+ * \var CameraSensorProperties::minVerticalBlanking
+ * \brief The smallest vertical blanking the sensor works with, in lines
+ *
+ * Some sensors stop streaming with a vertical blanking their driver allows.
+ * When set, this raises the minimum frame length reported to the IPA, so that
+ * algorithms never program a shorter frame. Zero leaves the driver's limit.
+ */
+
 /**
  * \struct CameraSensorProperties::SensorDelays
  * \brief Sensor control application delay values
@@ -193,6 +202,8 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.vblankDelay = 2,
 				.hblankDelay = 2
 			},
+			/* 3280x2464 stops streaming below 26 lines. */
+			.minVerticalBlanking = 26,
 		} },
 		{ "imx214", {
 			.unitCellSize = { 1120, 1120 },
diff --git a/src/libcamera/sensor/camera_sensor_raw.cpp b/src/libcamera/sensor/camera_sensor_raw.cpp
index 5caa9122..20ed5d49 100644
--- a/src/libcamera/sensor/camera_sensor_raw.cpp
+++ b/src/libcamera/sensor/camera_sensor_raw.cpp
@@ -1057,7 +1057,10 @@ int CameraSensorRaw::sensorInfo(IPACameraSensorInfo *info) const
 	info->maxLineLength = info->outputSize.width + hblank.max().get<int32_t>();
 
 	const ControlInfo vblank = ctrls.infoMap()->at(V4L2_CID_VBLANK);
-	info->minFrameLength = info->outputSize.height + vblank.min().get<int32_t>();
+	uint32_t minVblank = vblank.min().get<int32_t>();
+	if (staticProps_)
+		minVblank = std::max(minVblank, staticProps_->minVerticalBlanking);
+	info->minFrameLength = info->outputSize.height + minVblank;
 	info->maxFrameLength = info->outputSize.height + vblank.max().get<int32_t>();
 
 	return 0;
