 include/libcamera/ipa/softisp.mojom                 |  3 ++-
 src/ipa/softisp/ipa_context.h                       |  1 +
 src/ipa/softisp/softisp.cpp                         |  7 ++++++-
 src/libcamera/pipeline/simple/simple.cpp            | 13 +++++++++++--
 src/libcamera/software_isp/software_isp.cpp         |  4 ++--
