 src/libcamera/software_isp/debayer.h          |  1 +
 src/libcamera/software_isp/debayer_cpu.cpp    |  1 +
 src/libcamera/software_isp/debayer_egl.cpp    |  1 +
 src/libcamera/software_isp/software_isp.cpp   | 26 ++++++++++++++++---
 7 files changed, 42 insertions(+), 6 deletions(-)

