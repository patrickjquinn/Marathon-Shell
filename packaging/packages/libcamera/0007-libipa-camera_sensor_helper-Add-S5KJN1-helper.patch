From: Patrick Quinn <patrick.jm.quinn@gmail.com>
Date: Sun, 1 Nov 2026 16:35:51 +0000
Subject: [PATCH 07/29] libipa: camera_sensor_helper: Add S5KJN1 helper

The s5kjn1 driver's analogue gain control is the gain register code,
where 32 is unity, from 32 to 2048. The black level, 64 at 10 bits, is
Samsung's usual value and matches a dark frame from a Zinwa Q25 module.

Without the helper the software ISP's AGC has no gain model and the
image stays dark.

The exposure margin is the larger of the driver's two modes, 22 and
44 lines.

Signed-off-by: Patrick Quinn <patrick.jm.quinn@gmail.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index e555899e..055e15bc 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -966,6 +966,21 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperS5kjn1 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5kjn1()
+	{
+		/* Samsung's usual 64 at 10bits; a Zinwa Q25 dark frame agrees. */
+		blackLevel_ = 4096;
+		/* The driver's control is the register code: 32 is 1x. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+		/* The larger of the driver's two modes, 22 and 44 lines. */
+		exposureMargin_ = 44;
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5kjn1", CameraSensorHelperS5kjn1)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
