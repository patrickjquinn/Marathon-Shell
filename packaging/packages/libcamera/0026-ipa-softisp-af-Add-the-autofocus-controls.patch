 #pragma once
 
+#include <array>
+#include <vector>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+
 #include "libipa/af.h"
 
 #include "algorithm.h"
@@ -25,13 +33,26 @@ public:
 	int init(IPAContext &context, const ValueNode &tuningData) override;
 	int configure(IPAContext &context,
 		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
 	void process(IPAContext &context, const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
 
 private:
+	static constexpr unsigned int kZones =
+		SwIspStats::kFocusZonesX * SwIspStats::kFocusZonesY;
+
+	void updateWeights();
+	double variance(const SwIspStats *stats) const;
+
 	AfAlgorithm afAlgo_;
+	controls::AfMeteringEnum metering_ = controls::AfMeteringAuto;
+	std::vector<Rectangle> windows_;
+	Rectangle scalerCrop_;
+	std::array<double, kZones> weights_ = {};
 };
 
 } /* namespace ipa::softisp::algorithms */
