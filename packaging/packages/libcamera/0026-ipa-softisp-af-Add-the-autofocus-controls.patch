@@ -17,10 +19,45 @@ namespace libcamera {
 
 namespace ipa::softisp::algorithms {
 
+/**
+ * \class Af
+ * \brief Contrast detection autofocus
+ *
+ * The algorithm measures the contrast in the focus zones of the statistics
+ * and runs the libipa AfAlgorithm on it. It is only enabled when the camera
+ * has a focus lens, and takes the AfAlgorithm tuning parameters.
+ *
+ * With AfMetering set to AfMeteringAuto, it measures the centre quarter of the
+ * image. With AfMeteringWindows, it measures the focus zones the AfWindows
+ * cover, weighted by the area they cover; the windows are in the coordinates
+ * of the sensor pixel array, as the ScalerCrop.
+ */
+
 LOG_DEFINE_CATEGORY(IPASoftIspAf)
 
-int Af::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+int Af::init(IPAContext &context, const ValueNode &tuningData)
 {
+	if (context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE) ==
+	    context.lensControls.end()) {
+		LOG(IPASoftIspAf, Info) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	int ret = afAlgo_.init(tuningData, context.lensControls);
+	if (ret)
+		return ret;
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    static_cast<int32_t>(controls::AfModeContinuous));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+	context.ctrlMap[&controls::AfMetering] = ControlInfo(controls::AfMeteringValues);
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle{}, Rectangle(65535, 65535, 65535, 65535),
+			    std::span<const Rectangle, 1>{ { Rectangle{} } });
+	context.ctrlMap[&controls::LensPosition] = afAlgo_.lensPositionInfo();
+
 	/* Informs that lens controls can get focus data */
 	context.afEnabled = true;
 
@@ -29,33 +66,153 @@ int Af::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
 
 int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
 {
+	if (!context.afEnabled)
+		return 0;
+
 	afAlgo_.configure(context.activeState.af, configInfo.lensControls);
 
+	scalerCrop_ = configInfo.scalerCrop;
+	metering_ = controls::AfMeteringAuto;
+	windows_.clear();
+	updateWeights();
+
 	return 0;
 }
 
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.afEnabled)
+		return;
+
+	ipa::af::ActiveState &state = context.activeState.af;
+	bool meteringChanged = false;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode)
+		afAlgo_.setMode(state, static_cast<controls::AfModeEnum>(*mode));
+
+	const auto &metering = controls.get(controls::AfMetering);
+	if (metering && *metering != metering_) {
+		metering_ = static_cast<controls::AfMeteringEnum>(*metering);
+		meteringChanged = true;
+	}
+
+	const auto &windows = controls.get(controls::AfWindows);
+	if (windows) {
+		windows_.assign(windows->begin(), windows->end());
+		meteringChanged |= metering_ == controls::AfMeteringWindows;
+	}
+
+	if (meteringChanged) {
+		updateWeights();
+		afAlgo_.meteringChanged(state);
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger)
+		afAlgo_.setTrigger(state, static_cast<controls::AfTriggerEnum>(*trigger));
+
+	const auto &pause = controls.get(controls::AfPause);
+	if (pause)
+		afAlgo_.setPause(static_cast<controls::AfPauseEnum>(*pause));
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition)
+		afAlgo_.setLensPosition(state, *lensPosition);
+}
+
+/*
+ * Weigh the focus zones by the area of the AfWindows they contain, or use the
+ * centre zones when there are no windows.
+ */
+void Af::updateWeights()
+{
+	constexpr unsigned int zonesX = SwIspStats::kFocusZonesX;
+	constexpr unsigned int zonesY = SwIspStats::kFocusZonesY;
+
+	weights_.fill(0.0);
+
+	if (metering_ == controls::AfMeteringWindows) {
+		double total = 0.0;
+
+		for (unsigned int y = 0; y < zonesY; y++) {
+			for (unsigned int x = 0; x < zonesX; x++) {
+				const int x0 = scalerCrop_.x + scalerCrop_.width * x / zonesX;
+				const int x1 = scalerCrop_.x + scalerCrop_.width * (x + 1) / zonesX;
+				const int y0 = scalerCrop_.y + scalerCrop_.height * y / zonesY;
+				const int y1 = scalerCrop_.y + scalerCrop_.height * (y + 1) / zonesY;
+				const Rectangle zone(x0, y0, x1 - x0, y1 - y0);
+
+				double &weight = weights_[y * zonesX + x];
+				for (const Rectangle &window : windows_) {
+					const Rectangle area = window.boundedTo(zone);
+					weight += static_cast<double>(area.width) * area.height;
+				}
+				total += weight;
+			}
+		}
+
+		if (total > 0.0)
+			return;
+
+		LOG(IPASoftIspAf, Debug)
+			<< "No AfWindows in the image, measuring the centre";
+	}
+
+	for (unsigned int y = zonesY / 4; y < zonesY * 3 / 4; y++) {
+		for (unsigned int x = zonesX / 4; x < zonesX * 3 / 4; x++)
+			weights_[y * zonesX + x] = 1.0;
+	}
+}
+
+/*
+ * Compute the mean squared difference of the green samples in the weighted
+ * zones, normalised to their mean so that exposure changes don't count.
+ */
+double Af::variance(const SwIspStats *stats) const
+{
+	double contrast = 0.0;
+	double sum = 0.0;
+	double count = 0.0;
+
+	for (unsigned int i = 0; i < kZones; i++) {
+		const SwIspStats::FocusZone &zone = stats->focus[i];
+
+		contrast += weights_[i] * zone.contrast;
+		sum += weights_[i] * zone.sum;
+		count += weights_[i] * zone.count;
+	}
+
+	if (sum <= 0.0)
+		return 0.0;
+
+	return contrast * count / (sum * sum);
+}
+
 void Af::process(IPAContext &context,
 		 [[maybe_unused]] const uint32_t frame,
 		 [[maybe_unused]] IPAFrameContext &frameContext,
 		 const SwIspStats *stats,
-		 [[maybe_unused]] ControlList &metadata)
+		 ControlList &metadata)
 {
-	uint64_t contrast = 0;
-	uint64_t sum = 0;
-	uint64_t count = 0;
-	for (const SwIspStats::FocusZone &zone : stats->focus) {
-		contrast += zone.contrast;
-		sum += zone.sum;
-		count += zone.count;
-	}
+	if (!context.afEnabled)
+		return;
 
-	/* Normalise to the brightness so that exposure changes don't count. */
-	double variance = 0.0;
-	if (sum)
-		variance = static_cast<double>(contrast) * count / sum / sum;
+	ipa::af::ActiveState &state = context.activeState.af;
+
+	/* The statistics are only computed every few frames. */
+	if (stats->valid) {
+		const double focusVariance = variance(stats);
+		LOG(IPASoftIspAf, Debug) << "Focus stats: " << focusVariance;
+		afAlgo_.process(state, focusVariance);
+	}
 
-	LOG(IPASoftIspAf, Debug) << "Focus stats: " << variance;
-	afAlgo_.process(context.activeState.af, variance);
+	metadata.set(controls::AfState, afAlgo_.afState());
+	metadata.set(controls::AfPauseState, afAlgo_.pauseState());
+	metadata.set(controls::LensPosition, afAlgo_.lensPosition(state));
 }
 
 REGISTER_IPA_ALGORITHM(Af, "Af")
