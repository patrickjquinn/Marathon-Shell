# Maintainer: Patrick Quinn <patrick@jquinn.com>
# libcamera for Marathon's camera apps. Follows Alpine's community/libcamera
# recipe (0.7.2-r1) at an upstream master snapshot after 0.8.0 (for the AGC
# frame duration and vblank work), without qcam, the Python bindings and
# the docs, and with the patches the Zinwa Q25's MediaTek camera needs
# (software ISP for its 14-bit unpacked RAW, the simple pipeline on
# mtk-seninf, autofocus); each is written for upstream. 0013-0020 are
# Milan Zamazal's software ISP autofocus series v2, still in review.
# 99999 so it outranks postmarketOS's own fork (99990.<version>), which
# otherwise takes the same version and wins. _git sorts above 0.8.0 and
# below the next release.
pkgname=libcamera
_pkgver=0.8.0
_commit=5efdc682e5b54f7b9f793b1fbf99884d522fd9f9
_gitdate=20261118
pkgver=99999${_pkgver}_git$_gitdate
pkgrel=2
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="aarch64 x86_64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	eudev-dev
	glib-dev
	gnutls-dev
	gst-plugins-base-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	linux-headers
	mesa-dev
	meson
	py3-jinja2
	py3-ply
	py3-yaml
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-gstreamer
	$pkgname-v4l2
	$pkgname-tools
	"
source="libcamera-$_commit.tar.gz::https://gitlab.freedesktop.org/camera/libcamera/-/archive/$_commit/libcamera-$_commit.tar.gz
	0001-libcamera-software_isp-Support-unpacked-14-bit-Bayer.patch
	0002-libcamera-shaders-Sample-the-texel-the-Bayer-phase-i.patch
	0003-pipeline-simple-Allow-the-software-ISP-on-mtk-seninf.patch
	0004-libipa-camera_sensor_helper-Add-IMX111-helper.patch
	0005-pipeline-simple-Skip-capture-sizes-the-video-node-do.patch
	0006-pipeline-simple-Complete-requests-on-stop-when-the-I.patch
	0007-libipa-camera_sensor_helper-Add-S5KJN1-helper.patch
	0008-gstreamer-Disconnect-requestCompleted-when-closing-t.patch
	0009-pipeline-simple-Keep-the-largest-size-when-merging-r.patch
	0010-libcamera-camera_sensor-Add-S5KJN1-sensor-properties.patch
	0011-ipa-softisp-adjust-Read-the-default-contrast-and-sat.patch
	0012-libcamera-camera_sensor-Add-IMX111-sensor-properties.patch
	0013-libcamera-software_isp-Let-a-single-point-decide-abo.patch
	0014-ipa-ipu3-Move-non-specific-parts-of-Af-to-libipa.patch
	0015-ipa-libipa-Add-af-prepareControls.patch
	0016-libcamera-software_isp-Add-variance-to-stats.patch
	0017-ipa-softisp-Remove-unused-imports-from-ipa_context.h.patch
	0018-ipa-softisp-Add-Af-algorithm.patch
	0019-libcamera-software_isp-Add-autofocus-controls.patch
	0020-ipa-libipa-Use-autofocus-limits-if-available.patch
	0021-libcamera-software_isp-Gather-focus-statistics.patch
	0022-libcamera-software_isp-debayer_egl-Gather-statistics.patch
	0023-pipeline-simple-Report-the-sensor-area-the-software-.patch
	0024-pipeline-simple-Move-the-lens-when-the-sensor-has-a-.patch
	0025-ipa-libipa-af-Support-the-autofocus-controls.patch
	0026-ipa-softisp-af-Add-the-autofocus-controls.patch
	0027-gstreamer-Protect-the-controls-with-the-state-lock.patch
	0028-ipa-softisp-Keep-the-AGC-and-AWB-state-across-the-sa.patch
	0029-gstreamer-Expose-the-autofocus-trigger-pause-and-sta.patch
	0031-ipa-libipa-agc_mean_luminance-Don-t-wind-up-the-expo.patch
	s5kjn1.yaml
	imx111.yaml
	"
builddir="$srcdir/$pkgname-$_commit"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
aarch64)
	subpackages="$subpackages $pkgname-raspberrypi"
	;;
esac

depends="$pkgname-ipa=$pkgver-r$pkgrel"
subpackages="$subpackages $pkgname-ipa"

# What "auto" picks, less the virtual test camera: it needs libyuv, which
# Alpine ships as headers only.
case "$CARCH" in
aarch64) _pipelines="imx8-isi,mali-c55,rkisp1,rpi/pisp,rpi/vc4,simple,uvcvideo" ;;
x86_64) _pipelines="ipu3,simple,uvcvideo" ;;
esac

build() {
	abuild-meson \
		-Dpipelines="$_pipelines" \
		-Dandroid=disabled \
		-Dv4l2=enabled \
		-Dwerror=false \
		-Ddocumentation=disabled \
		-Dqcam=disabled \
		-Dpycamera=disabled \
		-Dtest=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	# The Q25's cameras: tuned colour and contrast for the software ISP.
	install -Dm644 -t "$pkgdir"/usr/share/libcamera/ipa/softisp \
		"$srcdir"/s5kjn1.yaml "$srcdir"/imx111.yaml

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends=""
	amove usr/lib/libcamera
	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
}

