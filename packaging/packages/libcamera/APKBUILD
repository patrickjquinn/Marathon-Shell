# Maintainer: Patrick Quinn <patrick@jquinn.com>
# libcamera for Marathon's camera apps. Follows Alpine's community/libcamera
# recipe (0.7.2-r1) at a newer release, without qcam, the Python bindings
# and the docs, and with the patches the Zinwa Q25's MediaTek camera needs
# (software ISP for its 14-bit unpacked RAW, the simple pipeline on
# mtk-seninf); each is written for upstream.
# 9999 as postmarketOS's own fork (99990.7.2) has it: apk takes the higher.
pkgname=libcamera
_pkgver=0.8.0
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="aarch64 x86_64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	eudev-dev
	glib-dev
	gnutls-dev
	gst-plugins-base-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	linux-headers
	mesa-dev
	meson
	py3-jinja2
	py3-ply
	py3-yaml
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-gstreamer
	$pkgname-v4l2
	$pkgname-tools
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-libcamera-software_isp-Support-unpacked-14-bit-Bayer.patch
	0002-libcamera-shaders-Sample-the-texel-the-Bayer-phase-i.patch
	0003-pipeline-simple-Allow-the-software-ISP-on-mtk-seninf.patch
	0004-libipa-camera_sensor_helper-Add-IMX111-helper.patch
	0005-pipeline-simple-Skip-capture-sizes-the-video-node-do.patch
	0006-pipeline-simple-Complete-requests-on-stop-when-the-I.patch
	0007-libipa-camera_sensor_helper-Add-S5KJN1-helper.patch
	0008-gstreamer-Disconnect-requestCompleted-when-closing-t.patch
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
aarch64)
	subpackages="$subpackages $pkgname-raspberrypi"
	;;
esac

depends="$pkgname-ipa=$pkgver-r$pkgrel"
subpackages="$subpackages $pkgname-ipa"

# What "auto" picks, less the virtual test camera: it needs libyuv, which
# Alpine ships as headers only.
case "$CARCH" in
aarch64) _pipelines="imx8-isi,mali-c55,rkisp1,rpi/pisp,rpi/vc4,simple,uvcvideo" ;;
x86_64) _pipelines="ipu3,simple,uvcvideo" ;;
esac

build() {
	abuild-meson \
		-Dpipelines="$_pipelines" \
		-Dandroid=disabled \
		-Dv4l2=enabled \
		-Dwerror=false \
		-Ddocumentation=disabled \
		-Dqcam=disabled \
		-Dpycamera=disabled \
		-Dtest=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends=""
	amove usr/lib/libcamera
	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
}

