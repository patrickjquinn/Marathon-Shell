From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 1 Nov 2026 12:56:09 +0000
Subject: [PATCH 4/6] libipa: camera_sensor_helper: Add IMX111 helper

The analogue gain follows the usual Sony 256 / (256 - code) model. The
black level, 64 at 10 bits, was measured on a Zinwa Q25 module.
---
 src/ipa/libipa/camera_sensor_helper.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 359040ec..4abb4711 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -529,6 +529,18 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("hm1246", CameraSensorHelperHm1246)
 
+class CameraSensorHelperImx111 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx111()
+	{
+		/* Measured: 64 at 10bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 256, -1, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx111", CameraSensorHelperImx111)
+
 class CameraSensorHelperImx214 : public CameraSensorHelper
 {
 public:
