From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 18 Oct 2026 09:00:00 +0100
Subject: [PATCH] fix(pi): keep fbcon off tty1 so the splash survives greetd

greetd's session worker sets tty1 to KD_TEXT before it starts the
session. With fbcon bound to tty1 that unblanks the console with
FB_ACTIVATE_KD_TEXT, and drm_fb_helper_set_par then force-restores the
fbdev mode even over an active DRM master, so the panel goes black from
greetd until the shell's first frame however long Plymouth stays up.

fbcon=vc:2-63 leaves tty1 on dummycon: greetd's KD_TEXT and clear on
tty1 change nothing on screen, and Plymouth's last frame stays until the
shell replaces it. The kernel console is tty3 and stays on fbcon; tty1
never showed text (quiet, console=tty3, greetd owns it).
---
 mkosi.finalize | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/mkosi.finalize b/mkosi.finalize
--- a/mkosi.finalize
+++ b/mkosi.finalize
@@ -663,6 +663,8 @@
                 #   vt.global_cursor_default=0 — hide the blinking VT cursor
                 #   console=tty3       — kernel msgs go to tty3, NOT tty1
                 #                        (plymouth owns tty1 / the panel fb)
+                #   fbcon=vc:2-63      — no fbcon on tty1: greetd's KD_TEXT
+                #                        there would repaint it over the splash
                 #   console=ttyAMA10   — UART debug still works
                 # dwc_otg.lpm_enable=0 keeps the HackberryPi USB keyboard
                 # responsive. systemd.gpt_auto=no — Pi MBR is not GPT.
@@ -673,7 +675,7 @@
                 #   the DTB-set disable; it landed in 6.12.3+ so 6.12.85
                 #   has it. Without this, Phase B lifecycle policy is a
                 #   no-op on Pi 5 / CM5.
-                echo "splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 systemd.gpt_auto=no pmos.force-partition-resize" \
+                echo "splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 fbcon=vc:2-63 systemd.gpt_auto=no pmos.force-partition-resize" \
                     > "$BUILDROOT/boot/cmdline.txt"
                 rm -f "$BUILDROOT/boot/cmdline.txt.raw"
                 echo "info: Pi-firmware UKI has no .cmdline section, wrote default /boot/cmdline.txt"
@@ -952,7 +954,7 @@
             # USB OTG LPM (HackberryPi keyboard requirement). console=tty1
             # routes the framebuffer console to the HyperPixel panel.
             cat > "$BUILDROOT/boot/cmdline.txt" <<'EOF'
-splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 systemd.gpt_auto=no pmos.force-partition-resize
+splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 fbcon=vc:2-63 systemd.gpt_auto=no pmos.force-partition-resize
 EOF
             echo "info: wrote /boot/cmdline.txt"
             fi  # end "Pi-only: HyperPixel DTB merge + config.txt + cmdline.txt"
-- 
2.51.0

