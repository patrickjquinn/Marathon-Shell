From e53e66730a5cf5cf9527454173104b20e4c2cc82 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 14 Oct 2026 06:08:44 +0100
Subject: [PATCH] fix(cm5): actually layer the HackberryPi overlay

PMOS_DEVICE is raspberry-pi5, never raspberry-pi5-marathon, so the
check never matched and no image ever got device-hackberrypi-cm5-
marathon (panel, touch, fuel gauge, BBQ keyboard, usercfg).
---
 scripts/mkosi-configure.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/mkosi-configure.py b/scripts/mkosi-configure.py
index b3bbcd3..af38514 100755
--- a/scripts/mkosi-configure.py
+++ b/scripts/mkosi-configure.py
@@ -121,12 +121,12 @@ def main() -> int:
         if device.startswith("raspberry-pi") or device.startswith("rpi"):
             extra_overlays.extend(["linux-rpi=6.12.85-r0",
                                    "linux-rpi-dev=6.12.85-r0"])
-        # Layer-2 enclosure overlay: for raspberry-pi5-marathon, pull in
+        # Layer-2 enclosure overlay: for raspberry-pi5, pull in
         # device-hackberrypi-cm5-marathon when its APK is present in
         # mkosi.packages/. Vanilla Pi 5 / CM5 dev boards skip building
         # that APK and the include directive in /boot/usercfg.txt
         # silently no-ops on the missing usercfg-hackberrypi.txt file.
-        if device == "raspberry-pi5-marathon":
+        if device == "raspberry-pi5":
             hbp = "device-hackberrypi-cm5-marathon"
             hbp_prefix = f"{hbp}-"
             has_hbp = os.path.isdir(pkg_dir) and any(
-- 
