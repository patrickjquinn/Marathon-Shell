diff --git a/scripts/build-image.py b/scripts/build-image.py
index fe81ff8..00d84c5 100755
--- a/scripts/build-image.py
+++ b/scripts/build-image.py
@@ -42,6 +42,26 @@ def validate_and_extract_components(components):
     return device_name, ui_name
 
 
+def record_fat32_starts(raw_path):
+    """Write each FAT32 partition's start into its BPB hidden sectors (and
+    the backup boot sector), as the Pi's MBR layout does for its one FAT."""
+    import json
+    table = json.loads(subprocess.run(
+        ["sfdisk", "--json", raw_path],
+        capture_output=True, text=True, check=True).stdout)["partitiontable"]
+    sector_size = table.get("sectorsize", 512)
+    with open(raw_path, "r+b") as f:
+        for part in table["partitions"]:
+            start = part["start"]
+            f.seek(start * sector_size + 0x52)
+            if f.read(8) != b"FAT32   ":
+                continue
+            for sector in (0, 6):
+                f.seek((start + sector) * sector_size + 0x1C)
+                f.write(start.to_bytes(4, "little"))
+            print(f"Pi: FAT32 at sector {start} records its start")
+
+
 def build_image(components: List[str], extra_args: List[str]):
     start_time = time.time()
 
@@ -326,6 +346,11 @@ def build_image(components: List[str], extra_args: List[str]):
             )
             if not os.path.exists(raw_path):
                 print(f"warning: expected raw output not found at {raw_path}; skipping Pi MBR step")
+            elif os.environ.get("MARATHON_IMAGE_LAYOUT") == "ab":
+                # A/B keeps the GPT: systemd-sysupdate only writes GPT
+                # partitions.
+                record_fat32_starts(raw_path)
+                print("Pi: A/B GPT kept")
             else:
                 print(f"Pi: converting {raw_path} GPT → pure MBR")
                 # Read the image as a file we can seek into. Don't loop-mount
diff --git a/scripts/mkosi-configure.py b/scripts/mkosi-configure.py
index 6a196b2..ee6b7a0 100755
--- a/scripts/mkosi-configure.py
+++ b/scripts/mkosi-configure.py
@@ -6,9 +6,13 @@ import os
 import subprocess
 import sys
 
-# Devices that boot UEFI -> systemd-boot -> UKI, so systemd-boot's boot
-# counting can roll an A/B image back.
-AB_DEVICES = ("qemu-aarch64",)
+# Devices whose boot chain can try a slot and fall back, and their A/B
+# partition layout. QEMU: UEFI -> systemd-boot -> UKI with boot counting.
+# Pi 5: firmware autoboot.txt tryboot_a_b picks one of two boot partitions.
+AB_DEVICES = {
+    "qemu-aarch64": "mkosi.repart.ab",
+    "raspberry-pi5": "mkosi.repart.ab-pi",
+}
 
 
 def main() -> int:
@@ -108,7 +112,7 @@ def main() -> int:
             if len(repart) != 1:
                 print(f"Error: expected one repart directory, got {repart}", file=sys.stderr)
                 return 1
-            config["RepartDirectories"] = [os.path.join(os.path.dirname(repart[0]), "mkosi.repart.ab")]
+            config["RepartDirectories"] = [os.path.join(os.path.dirname(repart[0]), AB_DEVICES[device])]
         elif layout != "single":
             print(f"Error: MARATHON_IMAGE_LAYOUT={layout}; expected single or ab", file=sys.stderr)
             return 1
