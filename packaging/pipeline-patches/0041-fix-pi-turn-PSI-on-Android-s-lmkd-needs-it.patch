From 4a8e97d22ff186e95ec435b2cedbcac9b9990455 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 18 Oct 2026 19:41:31 +0100
Subject: [PATCH 41/42] fix(pi): turn PSI on, Android's lmkd needs it

linux-rpi 6.12.85 is built with CONFIG_PSI_DEFAULT_DISABLED, so
/proc/pressure does not exist on the Pi 5 / CM5 unless the command line
says psi=1. cgroup_enable=memory alone does not bring it back.

Without PSI, lmkd in the Waydroid container exits at start, and Android's
init gives up after "critical process 'lmkd' exited 4 times before boot
completed". The shell's PSI-driven freezer policy has nothing to read
either.

Checked on the HackberryPi: psi=1 boots, /proc/pressure/{cpu,io,memory}
appear, and lmkd stays up.
---
 mkosi.finalize | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/mkosi.finalize b/mkosi.finalize
index 227dabb..04c09d3 100755
--- a/mkosi.finalize
+++ b/mkosi.finalize
@@ -675,7 +675,9 @@ CONFIG
                 #   the DTB-set disable; it landed in 6.12.3+ so 6.12.85
                 #   has it. Without this, Phase B lifecycle policy is a
                 #   no-op on Pi 5 / CM5.
-                echo "splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 plymouth.ignore-serial-consoles systemd.gpt_auto=no pmos.force-partition-resize" \
+                # psi=1 — linux-rpi defaults PSI off; Waydroid's lmkd and
+                #   the PSI-driven app freezer need /proc/pressure.
+                echo "splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 plymouth.ignore-serial-consoles psi=1 systemd.gpt_auto=no pmos.force-partition-resize" \
                     > "$BUILDROOT/boot/cmdline.txt"
                 rm -f "$BUILDROOT/boot/cmdline.txt.raw"
                 echo "info: Pi-firmware UKI has no .cmdline section, wrote default /boot/cmdline.txt"
@@ -954,7 +956,7 @@ EOF
             # USB OTG LPM (HackberryPi keyboard requirement). console=tty1
             # routes the framebuffer console to the HyperPixel panel.
             cat > "$BUILDROOT/boot/cmdline.txt" <<'EOF'
-splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 plymouth.ignore-serial-consoles systemd.gpt_auto=no pmos.force-partition-resize
+splash quiet loglevel=3 vt.global_cursor_default=0 cgroup_enable=memory dwc_otg.lpm_enable=0 console=ttyAMA10,115200 console=tty3 plymouth.ignore-serial-consoles psi=1 systemd.gpt_auto=no pmos.force-partition-resize
 EOF
             echo "info: wrote /boot/cmdline.txt"
             fi  # end "Pi-only: HyperPixel DTB merge + config.txt + cmdline.txt"
