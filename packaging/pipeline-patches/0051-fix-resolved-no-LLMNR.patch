From f95563e62dbfe6db63bfb06a1e4c576115b3eec6 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Tue, 27 Oct 2026 22:50:22 +0000
Subject: [PATCH 51/51] fix(resolved): no LLMNR

systemd-resolved answered LLMNR on every interface (port 5355): on a
shared network any host can answer a phone's lookups through it. Off;
avahi still advertises marathon.local over mDNS.
---
 .../usr/lib/systemd/resolved.conf.d/50-marathon.conf          | 4 ++++
 1 file changed, 4 insertions(+)
 create mode 100644 mkosi.images/base/mkosi.extra/usr/lib/systemd/resolved.conf.d/50-marathon.conf

diff --git a/mkosi.images/base/mkosi.extra/usr/lib/systemd/resolved.conf.d/50-marathon.conf b/mkosi.images/base/mkosi.extra/usr/lib/systemd/resolved.conf.d/50-marathon.conf
new file mode 100644
index 0000000..0a27747
--- /dev/null
+++ b/mkosi.images/base/mkosi.extra/usr/lib/systemd/resolved.conf.d/50-marathon.conf
@@ -0,0 +1,4 @@
+# Name resolution over LLMNR answers anyone on the network, the classic
+# spoofing vector on shared Wi-Fi; mDNS (avahi) covers marathon.local.
+[Resolve]
+LLMNR=no
-- 
2.55.0

