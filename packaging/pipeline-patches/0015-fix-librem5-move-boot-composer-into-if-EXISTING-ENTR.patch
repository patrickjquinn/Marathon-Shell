From 813dd6b43684f766e9b1c4aaff0dde3afc27a6cc Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sat, 20 Jun 2026 11:01:55 +0100
Subject: [PATCH 15/15] fix(librem5): move boot composer into if-EXISTING-ENTRY
 branch + bump boot part to 512 MiB
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mkosi.finalize: the L5 vmlinuz/initramfs/DTB staging code lived in the
`else` branch of `if [ -f "$EXISTING_ENTRY" ]`, but mkosi.finalize always
synthesizes a loader entry for L5 (since `pmOS edge` leaves
loader/entries empty), so the else branch never fires. Net effect: every
build shipped a `/boot/` with `boot.scr` + `EFI/` but no kernel, no
initramfs, and no flat DTBs — boot.scr's `ext2load` would fail
immediately.

Move the L5 staging into the if-branch, right after the systemd-boot
processing finishes:
  1. Restore /boot/vmlinuz from /usr/lib/modules/$KVER/vmlinuz (the
     systemd-boot block deleted /boot/vmlinuz at the end).
  2. Run chroot mkinitfs to build a real duranium-initramfs at
     /boot/initramfs (the UKI's .initrd is kmods-only).
  3. Stage the three board-rev DTBs; trust boot-deploy's earlier copies
     when present, fall back to the kernel pkg dir otherwise.
Drop the dead UKI-extract block in the else branch.

build-image.py: a real duranium-initramfs is ~150 MiB. Combined with
kernel + DTBs + boot.scr + EFI/ + ext4 metadata, /boot weighs in at
~243 MiB. The 256 MiB boot partition was too tight (cp failed mid-copy
with ENOSPC). Bump to 512 MiB — still well clear of the root partition
which lives at sector 2099200 (1 GiB into the disk).

Verified end-to-end:
  • partition 1 = 512 MiB pmOS_boot ext4 at sector 4096
  • partition 2 = 5 GiB pmOS_root ext4 at sector 2099200
  • phone-boot.img at byte 33 KiB (SPL/U-Boot entry)
  • /boot/{vmlinuz (22M), initramfs (14M), boot.scr (1.9K), imx8mq-librem5-r{2,3,4}.dtb (58K each)}
  • root pkg DB: marathon-shell, linux-purism-librem5, u-boot-librem5,
    device-purism-librem5*, etc.
---
 mkosi.finalize         | 158 ++++++++++++++++++++++++++-----------
 scripts/build-image.py | 173 ++++++++++++++++++++++++++---------------
 2 files changed, 222 insertions(+), 109 deletions(-)

diff --git a/mkosi.finalize b/mkosi.finalize
index 72768f5..a78632b 100755
--- a/mkosi.finalize
+++ b/mkosi.finalize
@@ -495,6 +495,108 @@ CONFIG
 
         # Note: /boot/dtbs is preserved
 
+        # Librem 5 staging — boot.scr expects /boot/vmlinuz, /boot/initramfs,
+        # and /boot/imx8mq-librem5-r{2,3,4}.dtb (flat, NOT under
+        # dtbs/freescale/). The systemd-boot processing above moved
+        # vmlinuz into /usr/lib/modules/$KVER/vmlinuz and deleted it from
+        # /boot. Restore it, build a real duranium-initramfs via chroot
+        # mkinitfs (the UKI's .initrd is kmods-only), and stage the three
+        # board-rev DTBs alongside.
+        if [ -n "${LIBREM5_UBOOT_BOOT:-}" ]; then
+            LIBREM5_KVER=$(ls "$BUILDROOT/usr/lib/modules/" 2>/dev/null | grep librem5 | head -1)
+            if [ -z "$LIBREM5_KVER" ]; then
+                LIBREM5_KVER=$(ls "$BUILDROOT/usr/lib/modules/" 2>/dev/null | head -1)
+            fi
+            if [ -n "$LIBREM5_KVER" ] \
+               && [ -f "$BUILDROOT/usr/lib/modules/$LIBREM5_KVER/vmlinuz" ]; then
+                cp "$BUILDROOT/usr/lib/modules/$LIBREM5_KVER/vmlinuz" \
+                   "$BUILDROOT/boot/vmlinuz"
+                echo "info: Librem 5 staged /boot/vmlinuz from /usr/lib/modules/$LIBREM5_KVER/"
+            else
+                echo "warning: Librem 5 could not find vmlinuz under /usr/lib/modules/"
+            fi
+
+            # Run chroot mkinitfs to produce /boot/initramfs. Mirrors the
+            # legacy mkinitfs block in the else branch (stash + restore
+            # /usr/lib/systemd/boot/efi so boot-deploy's *.efi glob inside
+            # the chroot doesn't try to copy anything into /boot; transient
+            # /etc copy so mkinitfs reads /etc/os-release correctly).
+            rm -f "$BUILDROOT/in-pmbootstrap"
+            BOOT_EFI_STASH=""
+            if [ -d "$BUILDROOT/usr/lib/systemd/boot/efi" ]; then
+                BOOT_EFI_STASH=$(mktemp -d)
+                mv "$BUILDROOT/usr/lib/systemd/boot/efi" "$BOOT_EFI_STASH/efi"
+            fi
+            if [ -n "$LIBREM5_KVER" ]; then
+                echo "info: Librem 5 running mkinitfs in chroot for $LIBREM5_KVER"
+                mkdir -p "$BUILDROOT/proc" "$BUILDROOT/sys" "$BUILDROOT/dev"
+                mount --bind /proc "$BUILDROOT/proc" 2>/dev/null || true
+                mount --bind /sys  "$BUILDROOT/sys"  2>/dev/null || true
+                mount --bind /dev  "$BUILDROOT/dev"  2>/dev/null || true
+                ETC_RESTORE=""
+                CONFEXT_ETC="$BUILDROOT/usr/lib/confexts/duranium-base-config/etc"
+                if [ ! -e "$BUILDROOT/etc" ] && [ -d "$CONFEXT_ETC" ]; then
+                    cp -a "$CONFEXT_ETC" "$BUILDROOT/etc"
+                    ETC_RESTORE=1
+                fi
+                chroot "$BUILDROOT" /sbin/mkinitfs 2>&1 \
+                    | sed 's/^/  mkinitfs: /' \
+                    || echo "warning: Librem 5 mkinitfs non-zero exit"
+                [ -n "$ETC_RESTORE" ] && rm -rf "$BUILDROOT/etc"
+                umount "$BUILDROOT/proc" 2>/dev/null || true
+                umount "$BUILDROOT/sys"  2>/dev/null || true
+                umount "$BUILDROOT/dev"  2>/dev/null || true
+            fi
+            if [ -n "$BOOT_EFI_STASH" ] && [ -d "$BOOT_EFI_STASH/efi" ]; then
+                mv "$BOOT_EFI_STASH/efi" "$BUILDROOT/usr/lib/systemd/boot/efi"
+                rmdir "$BOOT_EFI_STASH"
+            fi
+            INITRD_SRC=""
+            for cand in \
+                "$BUILDROOT/boot/initramfs" \
+                "$BUILDROOT/boot/$PMOS_DEVICE/initrd" \
+                "$BUILDROOT/boot/${PMOS_DEVICE%-marathon}/initrd"
+            do
+                [ -f "$cand" ] && INITRD_SRC="$cand" && break
+            done
+            if [ -n "$INITRD_SRC" ] && [ "$INITRD_SRC" != "$BUILDROOT/boot/initramfs" ]; then
+                cp "$INITRD_SRC" "$BUILDROOT/boot/initramfs"
+                echo "info: Librem 5 promoted $INITRD_SRC -> /boot/initramfs"
+            elif [ -f "$BUILDROOT/boot/initramfs" ]; then
+                echo "info: Librem 5 /boot/initramfs in place ($(stat -c %s "$BUILDROOT/boot/initramfs") bytes)"
+            else
+                echo "warning: Librem 5 mkinitfs produced no /boot/initramfs — boot will fail"
+            fi
+
+            # Stage the three board-rev DTBs. mkinitfs's boot-deploy hook
+            # (above) already installs them at /boot/imx8mq-librem5-r{2,3,4}.dtb
+            # for the common case; this loop is the fallback for when
+            # boot-deploy is disabled or fails. Warn only if BOTH
+            # /boot and the kernel-pkg source are missing the DTB.
+            for r in r2 r3 r4; do
+                DST="$BUILDROOT/boot/imx8mq-librem5-$r.dtb"
+                if [ -f "$DST" ]; then
+                    echo "info: Librem 5 DTB imx8mq-librem5-$r.dtb already at /boot/ (boot-deploy)"
+                    continue
+                fi
+                SRC=""
+                if [ -n "$LIBREM5_KVER" ]; then
+                    SRC="$BUILDROOT/usr/lib/modules/$LIBREM5_KVER/dtb/freescale/imx8mq-librem5-$r.dtb"
+                fi
+                if [ -n "$SRC" ] && [ -f "$SRC" ]; then
+                    cp "$SRC" "$DST"
+                    echo "info: Librem 5 staged DTB imx8mq-librem5-$r.dtb from kernel pkg"
+                else
+                    echo "warning: Librem 5 DTB imx8mq-librem5-$r.dtb absent (neither /boot/ nor kernel pkg)"
+                fi
+            done
+            if [ -f "$BUILDROOT/boot/boot.scr" ]; then
+                echo "info: Librem 5 boot.scr present at /boot/boot.scr"
+            else
+                echo "warning: /boot/boot.scr missing — u-boot-librem5 pkg should have installed it"
+            fi
+        fi
+
     else
         # No systemd-boot loader entries AND not a Pi-firmware-or-L5 device.
         # Hard fail.
