From 0d2f58849fc292d97612b271ec7e69bb4a358bb6 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Thu, 26 Nov 2026 14:20:21 +0000
Subject: [PATCH] fix(build): developer SSH key reaches the base image's
 postinst

The environment file from 4886e3f never reached the subimages: mkosi
passes a subimage only the Environment= entries that PassEnvironment
names, and an --env-file's variables are not Environment= entries. The
base postinst saw no MARATHON_DEV_SSH_KEY, so the Jolla JP2601's
developer image disabled sshd and shipped no authorized_keys.

build-image.py now passes each variable by bare name, --environment=VAR:
mkosi takes the value from its own environment, so the key's spaces are
never split, and it lands in Environment=, which PassEnvironment
forwards to every subimage. With no key set, nothing is passed, as
before.
---
 scripts/build-image.py | 24 +++++++-----------------
 1 file changed, 7 insertions(+), 17 deletions(-)

diff --git a/scripts/build-image.py b/scripts/build-image.py
index 7d34de6..8ebb18e 100755
--- a/scripts/build-image.py
+++ b/scripts/build-image.py
@@ -147,26 +147,16 @@ def build_image(components: List[str], extra_args: List[str]):
             f"--environment=MARATHON_IMAGE_DEVICE={image_device}",
             f"--environment=PMOS_VARIANT={ui_name}",
         ] + extra_args
-        # PassEnvironment forwards only mkosi's own environment, not ours.
-        # mkosi splits --environment on spaces, which cut an SSH public key
-        # to its first word; an environment file is read a line at a time.
-        env_lines = [f"{var}={value}" for var in ("MARATHON_IMAGE_LAYOUT", "MARATHON_DEV_SSH_KEY")
-                     if (value := os.environ.get(var))]
-        env_file = None
-        if env_lines:
-            import tempfile
-            with tempfile.NamedTemporaryFile("w", prefix="marathon-env.", suffix=".env", delete=False) as f:
-                f.write("\n".join(env_lines) + "\n")
-                env_file = f.name
-            mkosi_cmd.insert(len(mkosi_cmd) - len(extra_args), f"--env-file={env_file}")
+        # PassEnvironment forwards only Environment= to subimages, never
+        # --env-file. A bare name takes its value from our environment, so
+        # an SSH key's spaces never meet mkosi's space-split of the setting.
+        for var in ("MARATHON_IMAGE_LAYOUT", "MARATHON_DEV_SSH_KEY"):
+            if os.environ.get(var):
+                mkosi_cmd.insert(len(mkosi_cmd) - len(extra_args), f"--environment={var}")
 
         print(f"Executing: {' '.join(mkosi_cmd)}")
 
-        try:
-            subprocess.run(mkosi_cmd, check=True)
-        finally:
-            if env_file:
-                os.unlink(env_file)
+        subprocess.run(mkosi_cmd, check=True)
 
         # Pi 5 BootROM on shipped CM5 EEPROMs reads MBR, not GPT. mkosi emits
         # a pure GPT layout (protective MBR slot 1 is type 0xEE, no bootable
-- 
2.55.0

