From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Sun, 4 Oct 2026 10:17:09 +0100
Subject: [PATCH] fix(store): run the store handler outside the app sandbox,
 report progress

Syncs marathon-extras/marathon-store-handler and
marathon-store-refresh-state with scripts/store in the Marathon-Shell
repo.

xdg-open runs the handler inside the calling app's bwrap sandbox, where
/home/user is a private tmpfs, so every Store install landed in a
throwaway home. Inside a sandbox the handler now hands the URL to the
shell's AppStore1.RunStoreUrl, which checks the caller holds "system" and
runs it from outside; there it re-runs itself as a transient systemd user
unit. "open" launches through the shell's Navigation1.LaunchApp.

It also ran under errexit, so a failing flatpak pipeline ended it before
it could write a "failed" state and the Store waited on "pending"
forever. Installs went to the user installation with no user remote,
single-app updates passed the remote name where flatpak update expects
refs, uninstall reported no state, and progress never appeared: flatpak
only prints percentages on a terminal.

run_op drives install, update and uninstall with errexit off under
script(1) for a pty, folds each step's percentage into one figure,
records flatpak's error line on failure, and adds the user flathub remote
from the shipped .flatpakrepo before installing. update-all updates each
app through the same path. refresh-state finds icons at any exported
size, including the scalable SVG most GNOME apps ship.
---
 marathon-extras/marathon-store-handler       | 132 +++++++++++++------
 marathon-extras/marathon-store-refresh-state |   8 +-
 2 files changed, 97 insertions(+), 43 deletions(-)

diff --git a/marathon-extras/marathon-store-handler b/marathon-extras/marathon-store-handler
index 72c95d2..a543fbe 100755
--- a/marathon-extras/marathon-store-handler
+++ b/marathon-extras/marathon-store-handler
@@ -49,67 +49,117 @@ if [ "$verb" != "refresh-state" ] && [ "$verb" != "update-all" ]; then
     fi
 fi
 
+# xdg-open runs this inside the calling app's sandbox, where /home/user is a
+# private tmpfs (flatpak --user would install into a throwaway home) and
+# systemd won't take requests from the sandbox's PID namespace. There, PID 1
+# is bwrap: hand the URL to the shell, which checks the caller holds the
+# "system" permission and runs this handler from outside. In the session,
+# re-run as a transient unit so the work outlives xdg-open and stays out of
+# the shell's process tree. Validation above has already run.
+if [ -z "${MARATHON_STORE_UNIT:-}" ]; then
+    if [ "$(cat /proc/1/comm 2>/dev/null)" != systemd ]; then
+        exec busctl --user call org.marathonos.Shell /org/marathonos/Shell/AppStore \
+            org.marathonos.Shell.AppStore1 RunStoreUrl s "$url"
+    fi
+    exec systemd-run --user --quiet --collect --setenv=MARATHON_STORE_UNIT=1 \
+        "$(readlink -f "$0")" "$url"
+fi
+
 write_state() {
-    local appid=$1 state=$2 pct=$3
+    local appid=$1 state=$2 pct=$3 msg=${4:-}
     local target="$STATE_DIR/install-progress-${appid}.json"
     local tmp
+    # The message is flatpak's own error text: keep it printable and free of
+    # the two characters that could break out of the JSON string.
+    msg=$(printf '%s' "$msg" | tr -d '"\\' | tr -c '[:print:]' ' ' | cut -c1-400)
     tmp=$(mktemp "${target}.XXXXXX")
-    printf '{"appId":"%s","state":"%s","percent":%s,"ts":%s}\n' \
-        "$appid" "$state" "$pct" "$(date +%s)" > "$tmp"
+    printf '{"appId":"%s","state":"%s","percent":%s,"error":"%s","ts":%s}\n' \
+        "$appid" "$state" "$pct" "$msg" "$(date +%s)" > "$tmp"
     mv "$tmp" "$target"
 }
 
-run_flatpak_progress() {
-    local op=$1 appid=$2
+# User installs need a user remote; the image only registers Flathub for the
+# system installation.
+ensure_remote() {
+    local repo=/etc/flatpak/remotes.d/flathub.flatpakrepo
+    [ -f "$repo" ] || repo=https://dl.flathub.org/repo/flathub.flatpakrepo
+    flatpak --user remote-add --if-not-exists "$REMOTE" "$repo"
+}
+
+# install / update / uninstall one app, reporting progress through the state
+# file the QML polls. Runs with errexit off: under -e a failing flatpak ended
+# the script before it could record the failure, so the UI waited on
+# "pending" forever.
+run_op() {
+    local op=$1 appid=$2 log rc=0 busy done_state="done" cmd
+    case "$op" in
+        install)   cmd="flatpak --user install -y $REMOTE $appid"; busy=installing ;;
+        update)    cmd="flatpak --user update -y $appid"; busy=installing ;;
+        uninstall) cmd="flatpak --user uninstall -y $appid"; busy=removing; done_state=removed ;;
+    esac
+    log=$(mktemp "$STATE_DIR/log.XXXXXX")
+    set +e
     write_state "$appid" pending -1
-    # --ostree-verbose unlocks the 'Receiving N%' progress lines. flatpak emits
-    # carriage-return-overwritten progress, so we tr \r -> \n to make it line-
-    # oriented before grepping percentages. PIPESTATUS[0] is the flatpak rc;
-    # we use bash so this is reliable.
-    flatpak --ostree-verbose --user "$op" -y --noninteractive "$REMOTE" "$appid" 2>&1 \
-        | tr '\r' '\n' \
-        | while IFS= read -r line; do
-            pct=$(printf '%s\n' "$line" | sed -n 's/.* \([0-9]\{1,3\}\)%.*/\1/p' | head -1)
-            case "$line" in
-                *Receiving*)              write_state "$appid" downloading "${pct:--1}" ;;
-                *Installing*|*Updating*)  write_state "$appid" downloading "${pct:--1}" ;;
-                *Deploying*|*Pulling*)    write_state "$appid" deploying "${pct:--1}" ;;
-                *Already*installed*)      write_state "$appid" done 100 ;;
-            esac
-        done
+    [ "$op" = install ] && ensure_remote >>"$log" 2>&1
+    # flatpak only draws progress ("Installing 2/3… 45%") on a terminal, so
+    # it runs under script(1) for a pty; -e passes its exit status through.
+    # Each redraw ends in a carriage return, so read on those: a tr/sed pipe
+    # would block-buffer and deliver every percentage at once at the end.
+    # Each step's percentage folds into one figure across all the steps.
+    script -q -e -c "$cmd" /dev/null 2>&1 | while IFS= read -r -d $'\r' chunk || [ -n "$chunk" ]; do
+        printf '%s\n' "$chunk" >> "$log"
+        if [[ $chunk =~ ([0-9]+)/([0-9]+)….*[^0-9]([0-9]{1,3})% ]]; then
+            write_state "$appid" "$busy" \
+                $(( ((BASH_REMATCH[1] - 1) * 100 + BASH_REMATCH[3]) / BASH_REMATCH[2] ))
+        fi
+    done
     rc=${PIPESTATUS[0]}
-    if [ "$rc" = "0" ]; then
-        write_state "$appid" done 100
+    if [ "$rc" = 0 ]; then
+        write_state "$appid" "$done_state" 100
     else
-        write_state "$appid" failed -1
+        # flatpak's own reason, without the terminal escapes and progress
+        # redraws that share its line.
+        write_state "$appid" failed -1 "$(sed -e 's/\x1b\][^\x1b]*\x1b\\//g' -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$log" \
+            | grep -o 'error: .*' | tail -1 | sed 's/^error: //')"
     fi
-    /usr/libexec/marathon-store-refresh-state || true
+    rm -f "$log"
+    /usr/libexec/marathon-store-refresh-state
+    set -e
+}
+
+update_all() {
+    flatpak --user remote-ls --updates --columns=application 2>/dev/null \
+        | grep -vE '\.(Locale|Sources|Debug)$' \
+        | while read -r app; do run_op update "$app"; done
 }
 
+# arg has already been validated against REF_RE, so nothing shell-meaningful
+# survives into flatpak's argv. The QML polls the per-app state files. Inside
+# the transient unit the work runs in the foreground: systemd kills a unit's
+# leftover processes once its main process exits. Without systemd, detach so
+# xdg-open returns at once.
 case "$verb" in
-    install)
-        # Detach so xdg-open returns immediately. No terminal window pops up;
-        # the QML polls per-appid state files for progress. arg has already
-        # been validated against REF_RE so no shell-meaningful characters
-        # can survive into this exec.
-        (run_flatpak_progress install "$arg" </dev/null >/dev/null 2>&1 &)
-        ;;
-    update)
-        (run_flatpak_progress update "$arg" </dev/null >/dev/null 2>&1 &)
-        ;;
-    uninstall)
-        flatpak --user uninstall -y "$arg" >/dev/null 2>&1 || true
-        write_state "$arg" done 0
-        /usr/libexec/marathon-store-refresh-state || true
+    install|update|uninstall)
+        if [ -n "${MARATHON_STORE_UNIT:-}" ]; then
+            run_op "$verb" "$arg"
+        else
+            (run_op "$verb" "$arg" </dev/null >/dev/null 2>&1 &)
+        fi
         ;;
     update-all)
-        flatpak --user update -y --noninteractive >/dev/null 2>&1 || true
-        /usr/libexec/marathon-store-refresh-state || true
+        if [ -n "${MARATHON_STORE_UNIT:-}" ]; then
+            update_all
+        else
+            (update_all </dev/null >/dev/null 2>&1 &)
+        fi
         ;;
     refresh-state)
         exec /usr/libexec/marathon-store-refresh-state
         ;;
+    # Launch through the shell like a home-screen tap, so the app gets the
+    # compositor's socket and a place in the task switcher.
     open)
-        exec flatpak --user run "$arg"
+        exec busctl --user call org.marathonos.Shell /org/marathonos/Shell/Navigation \
+            org.marathonos.Shell.Navigation1 LaunchApp s "$arg"
         ;;
 esac
diff --git a/marathon-extras/marathon-store-refresh-state b/marathon-extras/marathon-store-refresh-state
index bc9f195..b6d1928 100755
--- a/marathon-extras/marathon-store-refresh-state
+++ b/marathon-extras/marathon-store-refresh-state
@@ -17,8 +17,12 @@ emit_installed() {
     local first=1
     while IFS=$'\t' read -r app_id version name; do
         [ -z "$app_id" ] && continue
-        local icon="$HOME/.local/share/flatpak/exports/share/icons/hicolor/128x128/apps/$app_id.png"
-        [ -f "$icon" ] || icon=""
+        local icons="$HOME/.local/share/flatpak/exports/share/icons/hicolor" icon=""
+        for candidate in 128x128/apps/$app_id.png 256x256/apps/$app_id.png \
+                         512x512/apps/$app_id.png scalable/apps/$app_id.svg \
+                         64x64/apps/$app_id.png; do
+            [ -f "$icons/$candidate" ] && { icon="$icons/$candidate"; break; }
+        done
         [ "$first" = 1 ] || printf ','
         first=0
         printf '{"app_id":%s,"name":%s,"version":%s,"icon":%s}' \
-- 
2.55.0

