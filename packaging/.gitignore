# Marathon OS - Git Ignore File

# Build artifacts and logs
*.log
*.pid
build/
build-*/
.cache/

# Temporary debug/test files
*.txt
!BUILD_INSTRUCTIONS.txt
!CONTRIBUTING.txt
# Aport source files under packages/ are not scratch — usercfg.txt,
# config.txt, CMakeLists.txt etc. ship inside .apk's. Without this
# negation a new aport adding a *.txt source silently fails to be
# tracked (caught 2026-06-19: device-hackberrypi-cm5-marathon's
# usercfg-hackberrypi.txt + the long-orphaned device-raspberry-pi5-
# marathon usercfg.txt).
!packages/**/*.txt

# Temporary progress tracking files (vibe coding prevention)
*BUILD_COMPLETE*.md
*BUILD_SUMMARY*.md
*LATEST_BUILD*.md
*VALIDATION_REPORT*.md
*PERFORMANCE_TUNING*.md
*RT_KERNEL_TODO*.md
*FLASH_INSTRUCTIONS*.md
*ISSUES_ANALYSIS*.md

# Package build artifacts
packages/*/build/
packages/*/pkg/
packages/*/src/
packages/*/*.tar.gz

# Output images (too large for git)
out/
*.img
*.iso

# pmbootstrap cache and chroots
.pmbootstrap/
chroot_*/

# Kernel build artifacts
*.o
*.ko
*.mod.c
.tmp_versions/
Module.symvers
modules.order

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/

# Backup files
*.bak
*.backup
*-old
*-backup

# Temporary files
tmp/
temp/
*.tmp

# Marathon Shell embedded repo (if present)
packages/marathon-shell/shell/
packages/marathon-shell/apps/
packages/marathon-shell/.git/
packages/marathon-shell/build/
packages/marathon-shell/build-apps/

# oneplus-enchilada pmaports (if copied)
oneplus-enchilada/

# Shared/mounted directories
mnt-share/
personal/
