# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-raspberry-pi5-marathon
pkgdesc="Raspberry Pi 5 / HackberryPi CM5 - Marathon OS Edition"
pkgver=1.0.0
pkgrel=4
url="https://github.com/patrickjquinn/Marathon-Image"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Override /boot/usercfg.txt that device-raspberry-pi5 ships (a stub
# that just suggests where user configs go). We need ours to take
# precedence so the HyperPixel + KMS overlays land in /boot.
replaces="device-raspberry-pi5"
# Notes on the depends list:
#   - device-raspberry-pi5 pulls postmarketos-base + raspberrypi-bootloader
#     + linux-rpi. The CM5 uses the same BCM2712 as the Pi 5, so this is
#     the right base.
#   - The HyperPixel-style DPI panel + RP2040 USB-HID keyboard come from
#     the ZitaoTech HackberryPi CM5 carrier. The panel is driven via the
#     hackberrypi.dtbo overlay (vendored, applied at firmware stage); the
#     keyboard works out of the box as USB HID.
#   - marathon-shell + marathon-base-config + marathon-boot-logo +
#     marathon-plymouth-theme + plymouth + the runtime stack mirror the
#     OnePlus 6 / Librem 5 overlay aports for consistency across all
#     Marathon devices.
depends="
	device-raspberry-pi5
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	greetd
	greetd-systemd
	networkmanager
	networkmanager-wifi
	networkmanager-cli
	modemmanager
	upower
	iwd
	wireless-tools
	wpa_supplicant
	bluez
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
"
makedepends=""
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	usercfg.txt
	hackberrypi.dtbo
	"

package() {
	# greetd autologin → marathon-shell-session. Drop ONLY the Marathon-
	# specific config; the greetd.service systemd unit comes from the
	# greetd-systemd subpackage we depend on (don't ship our own).
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# Let Marathon Shell own the power button (logind hands off)
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"

	# HyperPixel + KMS overlay activation via standard Raspberry Pi
	# firmware include chain (raspberrypi-bootloader's /boot/config.txt
	# sources /boot/usercfg.txt). device-raspberry-pi5 ships a stub
	# usercfg.txt; we OVERRIDE it (replaces= directive above) to enable
	# Marathon's overlays.
	install -Dm644 "$srcdir/usercfg.txt" \
		"$pkgdir/boot/usercfg.txt"

	# hackberrypi.dtbo: Marathon's compiled overlay (hackberrypi.dts
	# in this aport). Equivalent to ZitaoTech's stock for the 720x720
	# HyperPixel + edt-ft5x06 touch on GPIO 10/11 i2c-gpio, PLUS adds
	# the MAX17048 fuel gauge node (compatible="maxim,max17048" @ 0x36
	# on the same bus). ZitaoTech's stock dtbo omits the fuel gauge
	# which is why on-CM5 Marathon kept showing 0% in the status bar —
	# diagnosed 2026-05-20.
	install -Dm644 "$srcdir/hackberrypi.dtbo" \
		"$pkgdir/boot/overlays/hackberrypi.dtbo"

	# Auto-load the MAX17040/MAX17048 fuel-gauge driver at boot. The
	# kernel ships it as CONFIG_BATTERY_MAX17040=m and the dtoverlay
	# declares the chip on i2c-1 @ 0x36, but the module isn't loaded
	# by udev modalias matching alone in some pmOS configs. Forcing
	# the load via modules-load.d guarantees /sys/class/power_supply/
	# gets a battery entry that UPower picks up and Marathon shows
	# in the status bar (was sitting at 0% because no power_supply
	# node existed — diagnosed on real CM5 hardware 2026-05-20).
	mkdir -p "$pkgdir/usr/lib/modules-load.d"
	cat > "$pkgdir/usr/lib/modules-load.d/marathon-cm5-fuelgauge.conf" <<-EOF
		# MAX17048 LiPo fuel-gauge on the Hackberry CM5 — i2c-1 @ 0x36.
		# CONFIG_BATTERY_MAX17040=m in linux-rpi.
		max17040_battery
	EOF
}

