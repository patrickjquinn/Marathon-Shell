# Maintainer: Patrick Quinn <patrick@jquinn.com>
pkgname=marathon-plymouth-theme
pkgver=1.0.0
pkgrel=3
pkgdesc="Marathon OS boot splash for plymouth"
url="https://github.com/patrickjquinn/Marathon-Image"
license="MIT"
arch="noarch"
options="!check"
depends="plymouth"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	marathon.plymouth
	marathon.script
	marathon-logo.png
	progress-track.png
	progress-fill.png
	"

package() {
	# Install the theme files into plymouth's themes directory.
	install -Dm644 "$srcdir/marathon.plymouth" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon.plymouth"
	install -Dm644 "$srcdir/marathon.script" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon.script"
	install -Dm644 "$srcdir/marathon-logo.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/marathon-logo.png"
	install -Dm644 "$srcdir/progress-track.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/progress-track.png"
	install -Dm644 "$srcdir/progress-fill.png" \
		"$pkgdir/usr/share/plymouth/themes/marathon/progress-fill.png"

	# Ship /usr/share/factory/etc/plymouth/plymouthd.conf with
	# Theme=marathon. duranium's base systemd-tmpfiles ruleset copies
	# the factory tree into /etc on first boot before user-facing
	# services start, giving Plymouth the explicit override in the
	# /etc location it reads first.
	#
	# We can't overwrite /usr/share/plymouth/plymouthd.defaults — the
	# upstream plymouth apk owns it. The cmdline.txt `plymouth.splash=
	# marathon` override (set in scripts/build-image.sh) covers the
	# very-first-boot case where plymouth-start may run before
	# systemd-tmpfiles-setup.
	install -d "$pkgdir/usr/share/factory/etc/plymouth"
	cat > "$pkgdir/usr/share/factory/etc/plymouth/plymouthd.conf" <<-EOF
		[Daemon]
		Theme=marathon
	EOF
	chmod 644 "$pkgdir/usr/share/factory/etc/plymouth/plymouthd.conf"

	install -d "$pkgdir/usr/lib/tmpfiles.d"
	cat > "$pkgdir/usr/lib/tmpfiles.d/marathon-plymouth.conf" <<-EOF
		C /etc/plymouth/plymouthd.conf 0644 - - - /usr/share/factory/etc/plymouth/plymouthd.conf
	EOF
	chmod 644 "$pkgdir/usr/lib/tmpfiles.d/marathon-plymouth.conf"
}

