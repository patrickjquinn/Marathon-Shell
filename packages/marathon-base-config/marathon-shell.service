[Unit]
Description=Marathon Shell Wayland Compositor
After=systemd-user-sessions.service plymouth-quit-wait.service dbus.socket
After=systemd-logind.service
After=getty@tty7.service
Conflicts=getty@tty7.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
ExecStart=/usr/sbin/greetd --config /etc/greetd/config.toml
Restart=always
RestartSec=3
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# Allow greetd to manage PAM sessions
PAMName=greetd

# Environment
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=greeter

[Install]
WantedBy=graphical.target
Alias=display-manager.service
