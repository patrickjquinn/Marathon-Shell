[Unit]
Description=Marathon Shell — Wayland compositor + mobile UI
Documentation=https://github.com/patrickjquinn/Marathon-Shell
# greetd is the actual login manager; this unit just provides a clean
# alias / hook target so other services can WantedBy=marathon-shell.target
# in the future. greetd-marathon launches marathon-shell-session itself
# under the auto-login user.
Requires=dbus.service
After=dbus.service systemd-user-sessions.service
After=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true

[Install]
WantedBy=graphical.target
