# Contributor: Patrick Quinn <patrick@jquinn.com>
# Maintainer: Patrick Quinn <patrick@jquinn.com>
pkgname=marathon-base-config
pkgver=1.0.0
pkgrel=17
pkgdesc="Marathon OS base system configuration and tuning"
url="https://github.com/patrickjquinn/Marathon-Image"
arch="all"
license="MIT"
depends="
	systemd
	dbus
	dbus-systemd
	eudev
	mesa-gbm
	mesa-egl
	mesa-dri-gallium
	mesa-gles
	mesa-va-gallium
	mesa-utils
	pipewire
	pipewire-pulse
	wireplumber
	modemmanager
	networkmanager
	mobile-broadband-provider-info
	e2fsprogs
	f2fs-tools
	zram-init-systemd
	htop
	iw
	nano
	tmux
	font-noto
	ttf-dejavu
        greetd
"
install="$pkgname.post-install"
options="!check"
source="
	99-marathon.conf
	50-marathon-zram.conf
	60-marathon-cpufreq.rules
	60-marathon-iosched.rules
	60-gpu-acceleration.rules
	50-marathon-limits.conf
	50-pipewire-priority.conf
	50-modemmanager-priority.conf
	50-gpu-acceleration.conf
	20-modesetting.conf
	marathon-shell.service
	marathon-mailserver.service
	greetd-marathon.toml
	marathon.slice
"
package() {
	install -Dm644 "$srcdir/99-marathon.conf" \
		"$pkgdir/etc/sysctl.d/99-marathon.conf"
	install -Dm644 "$srcdir/50-marathon-zram.conf" \
		"$pkgdir/etc/systemd/zram-generator.conf.d/50-marathon.conf"
	install -Dm644 "$srcdir/60-marathon-cpufreq.rules" \
		"$pkgdir/etc/udev/rules.d/60-marathon-cpufreq.rules"
	install -Dm644 "$srcdir/60-marathon-iosched.rules" \
		"$pkgdir/etc/udev/rules.d/60-marathon-iosched.rules"
	install -Dm644 "$srcdir/60-gpu-acceleration.rules" \
		"$pkgdir/etc/udev/rules.d/60-gpu-acceleration.rules"
	install -Dm644 "$srcdir/50-marathon-limits.conf" \
		"$pkgdir/etc/security/limits.d/50-marathon.conf"
	install -d "$pkgdir"/etc/systemd/system/pipewire.service.d
	install -Dm644 "$srcdir/50-pipewire-priority.conf" \
		"$pkgdir/etc/systemd/system/pipewire.service.d/50-priority.conf"
	install -d "$pkgdir"/etc/systemd/system/ModemManager.service.d
	install -Dm644 "$srcdir/50-modemmanager-priority.conf" \
		"$pkgdir/etc/systemd/system/ModemManager.service.d/50-priority.conf"
	install -d "$pkgdir"/etc/environment.d
	install -Dm644 "$srcdir/50-gpu-acceleration.conf" \
		"$pkgdir/etc/environment.d/50-gpu-acceleration.conf"
	install -d "$pkgdir"/etc/X11/xorg.conf.d
	install -Dm644 "$srcdir/20-modesetting.conf" \
		"$pkgdir/etc/X11/xorg.conf.d/20-modesetting.conf"

	install -Dm644 "$srcdir/marathon-shell.service" \
		"$pkgdir/usr/lib/systemd/system/marathon-shell.service"

	# QMF messageserver5 — user-scope long-lived sync daemon.
	# WantedBy=marathon-shell.service so it activates with the shell.
	install -Dm644 "$srcdir/marathon-mailserver.service" \
		"$pkgdir/usr/lib/systemd/user/marathon-mailserver.service"

	# Enable user-systemd linger for `user` at first boot. Equivalent to
	# `loginctl enable-linger user` — systemd-logind reads this marker
	# during boot and starts user@<uid>.service immediately, populating
	# XDG_RUNTIME_DIR + the user-bus socket so apps that need them
	# (Mail's marathon-mailserver, MPRIS clients, future Wallet) can
	# talk to the user manager from any session, including non-tty SSH.
	#
	# Without this, pmOS+greetd auto-login doesn't trigger pam_systemd,
	# the user manager never starts, and `systemctl --user` hangs.
	install -d "$pkgdir/var/lib/systemd/linger"
	touch "$pkgdir/var/lib/systemd/linger/user"

	# User-level slice with Delegate=yes — the shell carves marathon-apps
	# subgroups under this for per-app cgroup.freeze (Phase B perf
	# overhaul). See marathon-shell-session for the systemd-run hook.
	install -Dm644 "$srcdir/marathon.slice" \
		"$pkgdir/usr/lib/systemd/user/marathon.slice"
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/config.toml"
	install -d "$pkgdir"/etc/systemd/system/graphical.target.wants
	ln -sf /usr/lib/systemd/system/greetd.service \
		"$pkgdir/etc/systemd/system/graphical.target.wants/greetd.service"
	# Avoid console login racing with greetd on tty1.
	ln -sf /dev/null "$pkgdir/etc/systemd/system/getty@tty1.service"

	# Enable graphical target by default
	ln -sf /usr/lib/systemd/system/graphical.target \
		"$pkgdir/etc/systemd/system/default.target"
}
