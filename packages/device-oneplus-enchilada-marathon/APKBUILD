# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-oneplus-enchilada-marathon
pkgdesc="OnePlus 6 - Marathon OS Edition"
pkgver=1.0.0
pkgrel=7
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
depends="
	device-oneplus-enchilada
	linux-marathon
	marathon-shell
	marathon-base-config
	marathon-boot-logo
	marathon-plymouth-theme
	plymouth
	greetd
	greetd-agreety
	networkmanager
	networkmanager-wifi
	networkmanager-cli
	modemmanager
	upower
	iwd
	wireless-tools
	wpa_supplicant
	bluez
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
"
makedepends=""
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	greetd.service
	50-gpu-acceleration.conf
	"

package() {
	# Install greetd config for Marathon Shell autologin
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"
	
	# Install logind config to let Marathon Shell handle power button
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"
	
	# Install greetd systemd service file
	install -Dm644 "$srcdir/greetd.service" \
		"$pkgdir/usr/lib/systemd/system/greetd.service"

	# GPU acceleration env for the Adreno 630 / freedreno stack. This
	# lived (wrongly) in marathon-base-config where it shipped to every
	# device; it is device-specific to the OnePlus 6 (enchilada) and now
	# lives here. Only devices that actually use freedreno get it.
	install -Dm644 "$srcdir/50-gpu-acceleration.conf" \
		"$pkgdir/etc/environment.d/50-gpu-acceleration.conf"
}

