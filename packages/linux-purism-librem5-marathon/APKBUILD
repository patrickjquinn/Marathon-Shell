# Reference: <https://postmarketos.org/vendorkernel>
# Contributor: Patrick Quinn <patrick@jquinn.com>
# Maintainer: Patrick Quinn <patrick@jquinn.com>
#
# Marathon fork of pmaports' linux-purism-librem5 with a kCFI fix for the
# out-of-tree Silicon Labs RS9116 driver. Three of redpine's kthread
# functions (rsi_tx_scheduler_thread, rsi_coex_scheduler_thread,
# rsi_sdio_rx_thread) are declared with the wrong signature and crash on
# load via "Internal error: Oops - CFI" — once for each, killing the
# thread. The driver finishes probing (BT comes up) but no wlan0 ever
# registers because TX and RX are gone. See 0001-redpine-fix-kthread-
# signatures-for-cfi.patch for the change and rationale.
#
# Mirrors pmaports' linux-purism-librem5 at pkgver 6.6.139. Drop this fork
# the moment pmaports' linux-purism-librem5 carries the same patch.
pkgname=linux-purism-librem5-marathon
pkgver=6.6.139
pkgrel=2
_purismrel=1
# Vivante galcore GPU kernel module, built out-of-tree against this kernel and
# shipped in modules/<kver>/extra/. Not auto-loaded — the L5 device overlay
# activates it (and blacklists etnaviv) only when GPU_STACK=vivante-blob. Its
# ABI base (6.4.11) matches the librem5-vivante-blobs userspace; the p3.0
# source is the first with kernel 6.6 support. See docs/DEVICE_OVERLAYS.md.
_galcorever=6.4.11.p3.0
_galcoredir="kernel-module-imx-gpu-viv-upstream-$_galcorever"
_purismver=${pkgver}pureos$_purismrel
pkgdesc="Purism Librem 5 kernel — Marathon fork with RS9116 kCFI fix"
arch="aarch64"
_carch="arm64"
_flavor="purism-librem5"
url="https://source.puri.sm/Librem5/linux"
license="GPL-2.0-only"
# Replace pmaports' linux-purism-librem5 so device-purism-librem5 (the
# upstream device package) installs THIS kernel instead. Higher provider
# priority breaks ties in our favour. /usr/lib/modules/<KVER> still ends
# up as 6.6.139-purism-librem5 to match upstream paths exactly.
provides="linux-purism-librem5=$pkgver-r$pkgrel"
replaces="linux-purism-librem5"
provider_priority=200
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-librem5
	"
makedepends="
	bison
	clang
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	zstd
	"
install="$pkgname.post-upgrade"

_config="config-$_flavor.$arch"

source="
	$pkgname-$_purismver.tar.gz::https://source.puri.sm/Librem5/linux/-/archive/pureos/$_purismver/linux-pureos-$_purismver.tar.gz
	$_config
	treewide-remove-unnecessary-linux-version.h-inclusion.patch
	0001-redpine-fix-kthread-signatures-for-cfi.patch
	0002-librem5-usdhc2-non-removable.patch
	imx-gpu-viv-galcore-$_galcorever.tar.gz::https://github.com/Freescale/kernel-module-imx-gpu-viv/archive/refs/tags/upstream/$_galcorever.tar.gz
	galcore-busfreq-imx-stub.diff
"
builddir="$srcdir/linux-pureos-$_purismver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config

	# galcore's i.MX platform glue #includes NXP's downstream-only
	# <linux/busfreq-imx.h>; Purism's mainline-based 6.6 kernel has no
	# bus-freq API. Stub the GPU bus-freq hints (a power optimisation, not
	# required for correct operation) so galcore compiles. Shipped as a
	# .diff (not .patch) so abuild's default_prepare doesn't try to apply it
	# to the kernel tree — it targets the galcore source tree only. VALIDATED:
	# with this stub galcore 6.4.11.p3.0 compiles clean against 6.6.139.
	( cd "$srcdir/$_galcoredir" \
		&& patch -p1 -i "$srcdir/galcore-busfreq-imx-stub.diff" )
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-marathon"

	# Vivante galcore, out-of-tree against the kernel tree we just built.
	# LLVM=1 must match the kernel's toolchain or module symbol versions
	# won't line up. Command-line ARCH/LLVM propagate to galcore's inner
	# `make -C $KERNEL_SRC` via MAKEFLAGS.
	msg "Building Vivante galcore $_galcorever against $_purismver"
	# galcore's Makefile derives AQROOT from ${PWD}, so it MUST run with the
	# galcore dir as cwd — `make -C` doesn't update the recipe shell's PWD and
	# AQROOT resolves wrong (config not found). cd in instead.
	( cd "$srcdir/$_galcoredir" \
		&& make KERNEL_SRC="$builddir" ARCH="$_carch" LLVM=1 )
}

package() {
	make dtbs_install install modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release

	# Ship galcore in modules/<kver>/extra/ and refresh modules.dep so the L5
	# overlay can `modprobe galcore`. Not auto-loaded (no modules-load.d here).
	local _kver
	_kver="$(cat "$builddir"/include/config/kernel.release)"
	install -Dm644 "$srcdir/$_galcoredir/kernel-module-imx-gpu-viv-src/galcore.ko" \
		"$pkgdir/usr/lib/modules/$_kver/extra/galcore.ko"
	depmod -b "$pkgdir/usr" "$_kver"
}

