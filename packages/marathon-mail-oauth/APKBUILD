# Contributor: Patrick Quinn <patrick.jm.quinn@gmail.com>
# Maintainer: Patrick Quinn <patrick.jm.quinn@gmail.com>
pkgname=marathon-mail-oauth
pkgver=0.1.0
pkgrel=0
pkgdesc="OAuth2 PKCE + Secret-Service credential helper for Marathon Mail (QMF)"
url="https://github.com/patrickjquinn/Marathon-Shell"
# rustls-tls path is pure Rust — no musl-specific build break on aarch64
# tested via tokio 1.42 + zbus 5.x + reqwest 0.11.
arch="aarch64"
license="MIT"
makedepends="cargo cargo-auditable"
# Runtime: requires a session-bus Secret Service provider so the helper
# can read/write OAuth refresh tokens and classic-password creds.
# gnome-keyring is the canonical provider used by phosh / GNOME / and
# matches the Secret Service spec; kwallet works too but pulls KDE.
depends="dbus gnome-keyring"
source="$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz"
options="net"   # cargo fetch reaches crates.io

builddir="$srcdir/Marathon-Shell-main/tools/marathon-mail-oauth"

prepare() {
	default_prepare
	cd "$builddir"
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cd "$builddir"
	cargo auditable build --frozen --release
}

# No `check()` — the crate has no tests yet. Don't fake-pass an empty
# `cargo test`; either add real tests or omit per CODING_RULES A2.

package() {
	cd "$builddir"
	install -Dm755 "target/release/$pkgname" \
		-t "$pkgdir"/usr/bin/
}
