# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Patrick Quinn <patrick@jquinn.com>

pkgname=device-purism-librem5-marathon
pkgdesc="Purism Librem 5 — Marathon OS port"
pkgver=1.0.0
pkgrel=5
url="https://github.com/patrickjquinn/Marathon-Image"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Upstream device-purism-librem5 depends on `pulseaudio<9990` to mark a
# generic-pulseaudio sound stack. apk picks
# `postmarketos-base-ui-audio-backend-pulseaudio` to satisfy it — but
# that package carries `[!pipewire-pulse]` (conflicts-with). Marathon's
# audio stack wants pipewire-pulse (which itself provides=pulseaudio).
# Stub-provide the conflicting package at a sky-high version so apk
# never installs the real one, leaving pipewire-pulse free to satisfy
# the pulseaudio dep cleanly. Same pattern as our unl0kr-agent stub on
# device-raspberry-pi5-marathon's marathon-base-config.
#
# greetd-agreety-config ships /etc/greetd/config.toml which
# marathon-base-config already owns (with our greetd-marathon.toml
# content). Without this stub, apk pulls greetd-agreety-config via the
# upstream device-purism-librem5 dep chain and errors with
# "trying to overwrite etc/greetd/config.toml owned by
# marathon-base-config". Marathon owns the config; greetd-agreety
# itself isn't pulled (Marathon doesn't use the agreety greeter — the
# shell IS the greeter via greetd-marathon.toml's autologin command).
provides="
	postmarketos-base-ui-audio-backend-pulseaudio=999.0.0-r0
	greetd-agreety-config=999.0.0-r0
"
# Notes on the depends list:
#   - device-purism-librem5 pulls the upstream pmaports kernel + DTBs +
#     deviceinfo for the i.MX 8M Quad Librem 5. We layer Marathon on
#     top rather than overriding it.
#   - u-boot-librem5 ships /usr/share/u-boot/librem5/phone-boot.img.
#     Both the on-device boot flow AND the host-side `flash-librem5.sh
#     emmc` path need this artifact.
#   - The Librem 5's BroadMobi BM818 modem is handled by
#     ModemManager's `broadmobi` plugin (in mainline MM since 1.12)
#     out of the box — NO eg25-manager. eg25-manager is the Quectel
#     EG25-G state machine for PinePhone / PinePhone Pro and does not
#     apply here. Earlier r2 of this aport incorrectly depended on
#     eg25-manager + enabled it in post-install; removed in r3.
#   - iwd intentionally absent — NetworkManager uses wpa_supplicant.
#     iwd auto-enables a colliding nl80211 client. Same boundary as
#     device-raspberry-pi5-marathon r7.
#   - The rest of the runtime stack mirrors device-oneplus-enchilada-
#     marathon line-for-line to keep the device experiences in sync.
depends="
	device-purism-librem5
	u-boot-librem5
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	greetd
	greetd-systemd
	networkmanager
	networkmanager-wifi
	networkmanager-cli
	modemmanager
	upower
	wireless-tools
	wpa_supplicant
	bluez
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
"
makedepends=""
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	"

package() {
	# Install greetd config for Marathon Shell autologin. The actual
	# greetd.service unit comes from the greetd-systemd subpackage we
	# depend on — don't ship our own (r4 did and apk errored:
	# `device-purism-librem5-marathon: trying to overwrite usr/lib/
	# systemd/system/greetd.service owned by greetd-systemd`).
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# Install logind config to let Marathon Shell handle power button
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"
}

sha512sums="
