#!/bin/sh
# Marathon Shell session entry point (postmarketOS).
#
# Run as the auto-login user via greetd. Sets up the Wayland compositor
# environment, picks the right QPA backend for the target hardware, and
# execs the shell binary.

# ---- Session identity --------------------------------------------------------

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=marathon
export XDG_CURRENT_DESKTOP=marathon

# ---- Marathon paths ----------------------------------------------------------

export MARATHON_PREFIX="${MARATHON_PREFIX:-/usr}"
export MARATHON_APPS_DIR="${MARATHON_APPS_DIR:-/usr/share/marathon-apps}"
export MARATHON_DATA_DIR="${MARATHON_DATA_DIR:-/usr/share/marathon-shell}"

# QML modules ship under /usr/lib/qt6/qml on Alpine.
export QML_IMPORT_PATH="/usr/lib/qt6/qml:${QML_IMPORT_PATH:-}"
export QML2_IMPORT_PATH="/usr/lib/qt6/qml:${QML2_IMPORT_PATH:-}"

# ---- QPA platform selection --------------------------------------------------
#
# OVERRIDE order:
#   1. $QT_QPA_PLATFORM already exported by the caller — respected.
#   2. /sys/class/drm/card*/device/uevent contains "DRIVER=virtio_gpu"
#      → QEMU VM, prefer "kms" (DRM-KMS direct rendering).
#   3. Otherwise → "eglfs" (real phone hardware).
#
# Marathon Shell IS the compositor; we never want a Wayland-CLIENT plugin here.

IS_VIRTIO_GPU=0
# Detect QEMU virtio-gpu by PCI vendor:device, which is populated by the
# kernel as soon as the bus enumerates — well before greetd spawns us, and
# regardless of whether the virtio_gpu *driver* has bound yet (the driver
# can autoload lazily when /dev/dri/card0 is first opened). Checking via
# /sys/class/drm/.../uevent has a race we don't want to hit.
if grep -qsE '^PCI_ID=1AF4:1050' /sys/bus/pci/devices/*/uevent 2>/dev/null; then
    IS_VIRTIO_GPU=1
fi

if [ -z "${QT_QPA_PLATFORM:-}" ]; then
    # eglfs+eglfs_kms is the right combo on both real phone hardware and on
    # QEMU virtio-gpu — Qt has no standalone "kms" platform plugin.
    export QT_QPA_PLATFORM=eglfs
    export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
    export QT_QPA_EGLFS_ALWAYS_SET_MODE=1
fi

# QEMU virtio-gpu reports a fake desktop-monitor physical size in EDID, so Qt
# derives ~108 DPI for a phone-shaped 720x1440 canvas and the shell renders at
# desktop scale. Inject the DPI override here (read by ScreenMetrics::computeDpi)
# so QEMU validation matches phone-hardware proportions. Unset on real devices.
#
# 240 DPI (scaleFactor 1.5) corresponds to a 5" 720x1440 budget phone, which is
# what the QEMU canvas actually approximates. Higher (e.g. 400 = 2.5x for a
# OnePlus 6) over-fills the 720-wide canvas because the design assumes a
# 1080-wide screen at that scale -- content collides with chrome on small
# pages. Real phones with correct EDID don't need this override at all.
if [ "$IS_VIRTIO_GPU" = 1 ] && [ -z "${MARATHON_FORCE_DPI:-}" ]; then
    export MARATHON_FORCE_DPI=240
fi

# Skip the lock screen on startup under QEMU. We have no good way to drive
# the swipe-to-unlock gesture from a virtio-tablet test harness, and the
# point of the QEMU image is to validate the shell + apps -- not the
# unlock pipeline that real phone hardware exercises every day. The env
# is honored by SessionStore::reset(); on real phones it stays unset and
# the shell boots locked as usual.
if [ "$IS_VIRTIO_GPU" = 1 ] && [ -z "${MARATHON_NO_INITIAL_LOCK:-}" ]; then
    export MARATHON_NO_INITIAL_LOCK=1
fi

# ---- Qt-wide env -------------------------------------------------------------

export QT_MEDIA_BACKEND=gstreamer
export QT_WEBENGINE_DISABLE_SANDBOX=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QUICK_CONTROLS_STYLE=Basic

# Disable Qt's HiDPI auto-scaling — Marathon does its own scale factor work
# via Constants.scaleFactor and DEVICE_DPI.
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_ENABLE_HIGHDPI_SCALING=0

# Threaded scenegraph (uses additional cores for paint/upload).
export QSG_RENDER_LOOP=threaded

# QML disk cache for fast cold-start.
export QT_QML_DISK_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/marathon-qml"
mkdir -p "$QT_QML_DISK_CACHE_PATH"

# ---- Wayland runtime ---------------------------------------------------------

export WAYLAND_DISPLAY=wayland-0
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# ---- Logging -----------------------------------------------------------------
# MARATHON_DEBUG=1 turns on full Qt logging. Without it, only warnings + the
# marathon.* info channel reach the journal.

if [ "${MARATHON_DEBUG:-0}" = "1" ]; then
    export QT_LOGGING_RULES="*.debug=true;*.info=true;qt.qpa.input=true;marathon.*.info=true"
else
    export QT_LOGGING_RULES="*.warning=true;marathon.*.info=true"
fi

# ---- Accessibility -----------------------------------------------------------
# AT-SPI bridge enabled by default so Orca / accerciser see the shell. Set
# MARATHON_NO_A11Y=1 in the user's environment to opt out (e.g. tiny systems
# where at-spi2-core isn't installed).

if [ "${MARATHON_NO_A11Y:-0}" = "1" ]; then
    export NO_AT_BRIDGE=1
    export GTK_A11Y=none
    export QT_ACCESSIBILITY=0
else
    export QT_ACCESSIBILITY=1
fi

# ---- GIO / dconf fallback ---------------------------------------------------

export GIO_USE_VFS=local
export GSETTINGS_BACKEND=memory

# ---- D-Bus session bus -------------------------------------------------------
# Prefer dbus-run-session (provided by the regular dbus package on Alpine).

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- /usr/bin/marathon-shell-bin "$@"
fi

# ---- Launch ------------------------------------------------------------------

exec /usr/bin/marathon-shell-bin "$@"
