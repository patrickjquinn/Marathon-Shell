pkgname=marathon-shell
pkgver=1.0.0
pkgrel=13
pkgdesc="Marathon Shell - Modern Wayland compositor with Qt6/QML"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="MIT"
depends="
	qt6-qtbase
	qt6-qtbase-sqlite
	qt6-qtdeclarative
	qt6-qtwayland
	qt6-qtwebengine
	qt6-qtmultimedia
	qt6-qtsensors
	qt6-qtsvg
	qt6-qtvirtualkeyboard
	qt6-qtlocation
	qt6-qtpositioning
	hunspell
	hunspell-en-us
	libpulse
	wayland
	wayland-protocols
	mesa
	mesa-gbm
	mesa-egl
	mesa-gl
	mesa-dri-gallium
	mesa-gles
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
	networkmanager
	upower
	modemmanager
	geoclue
	bluez
	iio-sensor-proxy
	bash
	coreutils
	util-linux
	dbus
	polkit
	greetd
	ffmpeg
	gst-plugins-base
	gst-plugins-good
	"
makedepends="
	cmake
	samurai
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtwayland-dev
	qt6-qtwebengine-dev
	qt6-qtmultimedia-dev
	qt6-qtsensors-dev
	qt6-qtsvg-dev
	qt6-qtlocation-dev
	qt6-qtpositioning-dev
	hunspell-dev
	pulseaudio-dev
	wayland-dev
	wayland-protocols
	mesa-dev
	dbus-dev
	eudev-dev
	libinput-dev
	git
	linux-pam-dev
	"
install=""
subpackages="$pkgname-doc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/patrickjquinn/Marathon-Shell/archive/main.tar.gz
	asyncfuture.tar.gz::https://github.com/vpicaver/asyncfuture/archive/master.tar.gz
	"
builddir="$srcdir/Marathon-Shell-main"
options="!check"

prepare() {
	default_prepare
	
	# Extract asyncfuture submodule
	mkdir -p "$builddir/third-party/asyncfuture"
	cp -r "$srcdir"/asyncfuture-master/* "$builddir/third-party/asyncfuture/"
	
	# Disable QML cache generation to save memory during build
	# Add NO_CACHEGEN to all qt6_add_qml_module calls
	sed -i '/qt6_add_qml_module/,/^)/ { /^)/i\    NO_CACHEGEN
	}' "$builddir/shell/CMakeLists.txt"
	
	# EMERGENCY FIX: Strip heavy assets (sounds/wallpapers) from resources.qrc to prevent OOM
	# This removes the lines referencing these files from the qrc file
	sed -i '/sounds\//d' "$builddir/shell/resources.qrc"
	sed -i '/wallpapers\//d' "$builddir/shell/resources.qrc"
	
	# Fix timestamps from GitHub archive
	find "$builddir" -exec touch {} +
}

build() {
	cd "$builddir"
	
	# Clean any existing build directories
	rm -rf build build-apps
	
	# Disable QML cache to reduce memory usage during build
	export QML_DISABLE_DISK_CACHE=1
	export QT_DISABLE_QML_CACHE=1
	
	# Build main shell with SINGLE CORE and MinSizeRel to reduce memory
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_SKIP_BUILD_RPATH=TRUE \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE \
		-DCMAKE_INSTALL_RPATH=\$ORIGIN \
		-DQt6_DIR=/usr/lib/cmake/Qt6
	
	cmake --build build
	
	# Build apps with single core
	cmake -B build-apps -S apps -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DMARATHON_APPS_DIR=/usr/share/marathon-apps \
		-DCMAKE_SKIP_BUILD_RPATH=TRUE \
		-DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE \
		-DCMAKE_INSTALL_RPATH=\$ORIGIN \
		-DQt6_DIR=/usr/lib/cmake/Qt6
	cmake --build build-apps
}

package() {
	cd "$builddir"
	
	# Install main shell
	DESTDIR="$pkgdir" cmake --install build
	
	# Install apps
	DESTDIR="$pkgdir" cmake --install build-apps
	
	# cmake doesn't install app shared libs
	for lib in build-apps/*/lib*.so; do
		if [ -f "$lib" ]; then
			appname=$(basename "$lib")
			install -Dm755 "$lib" "$pkgdir/usr/lib/$appname"
		fi
	done
	
	for plugindir in build-apps/apps/*/MarathonApp/*; do
		if [ -d "$plugindir" ]; then
			appname=$(basename "$plugindir")
			appname_lower=$(echo "$appname" | tr '[:upper:]' '[:lower:]')
			plugin="$plugindir/lib${appname_lower}plugin.so"
			if [ -f "$plugin" ]; then
				install -Dm755 "$plugin" \
					"$pkgdir/usr/share/marathon-apps/MarathonApp/$appname/$(basename $plugin)"
			fi
			qmldir="$plugindir/qmldir"
			if [ -f "$qmldir" ]; then
				install -Dm644 "$qmldir" \
					"$pkgdir/usr/share/marathon-apps/MarathonApp/$appname/qmldir"
			fi
		fi
	done
	
	# marathon-config.json was removed upstream; install it only if present
	if [ -f "$builddir/marathon-config.json" ]; then
		install -Dm644 "$builddir/marathon-config.json" \
			"$pkgdir/usr/share/marathon-shell/marathon-config.json"
	fi

	# Ensure we ship the correct session script for the packaged install prefix (/usr),
	# rather than whatever upstream might install (often /usr/local).
	install -Dm755 "$startdir/marathon-shell-session" \
		"$pkgdir/usr/bin/marathon-shell-session"
	
	# Qt6 auto-generates invalid plugin refs for pure-QML modules
	for qmldir in "$pkgdir"/usr/lib/qt6/qml/MarathonUI/*/qmldir; do
		if [ -f "$qmldir" ]; then
			sed -i '/^linktarget /d; /^optional plugin /d; /^prefer /d' "$qmldir"
		fi
	done
}

