	hunspell-en-us
	libpulse
	wayland
	wayland-protocols
	mesa
	mesa-gbm
	mesa-egl
	mesa-gl
	mesa-dri-gallium
	mesa-gles
	pipewire
	pipewire-pulse
	wireplumber
	pulseaudio-utils
	networkmanager
	upower
	power-profiles-daemon
	modemmanager
	mmsd-tng
	mobile-broadband-provider-info
	geoclue
	bluez
	iio-sensor-proxy
	at-spi2-core
	bash
	coreutils
	util-linux
	dbus
	polkit
