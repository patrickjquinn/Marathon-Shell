pkgname=marathon-shell
pkgver=1.0.0
pkgrel=14
pkgdesc="Marathon Shell - Modern Wayland compositor with Qt6/QML"
url="https://github.com/patrickjquinn/Marathon-Shell"
arch="aarch64"
license="MIT"
depends="
	qt6-qtbase
	qt6-qtbase-sqlite
	qt6-qtdeclarative
	qt6-qtwayland
	qt6-qtwebengine
	qt6-qtmultimedia
	qt6-qtsensors
