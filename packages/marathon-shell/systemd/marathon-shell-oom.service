[Unit]
Description=Marathon Shell OOM-score pinning sidecar
Documentation=https://github.com/patrickjquinn/Marathon-Shell
# Want greetd up first so there's something to pin. Not strict — the
# sidecar polls every 5 s and pins whenever it finds the PID.
After=greetd.service
Wants=greetd.service

[Service]
Type=simple
ExecStart=/usr/libexec/marathon-shell-oom-pin
Restart=always
RestartSec=10
# Root needed for CAP_SYS_RESOURCE to write negative oom_score_adj.
# The pinned target is bounded (PWR-1 ladder: -800 ≤ adj ≤ 0) and
# only the marathon-shell-bin PID is touched.
User=root
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Read-only filesystem except /proc/<shell-pid>/oom_score_adj which
# we need to write. ProtectKernelTunables=yes would block /proc/sys
# but not /proc/<pid>/, so we keep it.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
