#!/usr/bin/env python3
"""Publish signed Marathon OS images for systemd-sysupdate.

  marathon-ota keygen  --gnupghome DIR --export KEY.asc
  marathon-ota publish --image-dir mkosi.output/<image-id> --version V --feed DIR
                       [--gnupghome DIR] [--key ID] [--notes FILE] [--keep N]
                       [--upload RSYNC-DEST | --github OWNER/REPO [--channel C]]
  marathon-ota github-sync --feed DIR --image-id ID --github OWNER/REPO [--channel C]

The feed is laid out as the image's sysupdate.d transfers expect: one
directory per image id holding each kept version's payload, a SHA256SUMS
manifest, its detached signature SHA256SUMS.gpg, and an AppStream catalog
with each release's download size and notes. The payload is the UKI and the
zstd-compressed /usr and verity partitions, on the Raspberry Pi the
compressed boot and root slot partitions, and on the Zinwa Q25 the
compressed root file. With --github the feed directory becomes the assets
of the release <channel>/<image id> on that repository, which sysupdate
reads from https://github.com/OWNER/REPO/releases/download/<channel>/<image
id>/. See docs/OTA.md.
"""

import argparse
import hashlib
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path
from xml.sax.saxutils import escape, quoteattr

CATALOG = "marathon-os.metainfo.xml"
MANIFEST = "SHA256SUMS"
SIGNATURE = "SHA256SUMS.gpg"
KEY_UID = "Marathon OS updates <updates@thrivelobal.com>"
# GitHub refuses release assets of 2 GiB or more.
GITHUB_ASSET_MAX = 2 * 1024**3 - 1


def fail(message):
    print(f"marathon-ota: {message}", file=sys.stderr)
    sys.exit(1)


def gpg(gnupghome, *args, **kwargs):
    cmd = ["gpg", "--batch", "--quiet"]
    if gnupghome:
        cmd += ["--homedir", str(gnupghome)]
    return subprocess.run(cmd + list(args), check=True, **kwargs)


def find_artifacts(image_dir, image_id, version):
    """The partition images mkosi split out, plus the UKI where one boots.

    The Q25 boots a root file, <stem>.ext4 (build-zinwa-q25-image.sh). The
    Pi firmware boots a whole boot partition, so a Pi image is its boot
    and root slots; every other A/B image is a UKI, /usr and its verity."""
    stem = f"{image_id}_{version}"
    root_file = image_dir / f"{stem}.ext4"
    if root_file.is_file():
        return [root_file]
    slots = {}
    slot = re.compile(re.escape(stem) + r"\.(boot|root)\.[0-9a-f]{32}\.raw$")
    for f in image_dir.iterdir():
        m = slot.match(f.name)
        if m:
            slots[m.group(1)] = f
    if slots:
        for kind in ("root", "boot"):
            if kind not in slots:
                fail(f"no {kind} slot image for {stem} in {image_dir}")
        return [slots["root"], slots["boot"]]
    uki = image_dir / f"{stem}.efi"
    if not uki.is_file():
        fail(f"no UKI {uki}")
    parts = {}
    pattern = re.compile(re.escape(stem) + r"\.(usr-[a-z0-9_]+?)(-verity)?\.([0-9a-f]{32})\.raw$")
    for f in image_dir.iterdir():
        m = pattern.match(f.name)
        if m:
            parts["verity" if m.group(2) else "usr"] = f
    for kind in ("usr", "verity"):
        if kind not in parts:
            fail(f"no {kind} partition image for {stem} in {image_dir} "
                 "(was the image built with MARATHON_IMAGE_LAYOUT=ab?)")
    return [uki, parts["usr"], parts["verity"]]


# What a developer image has (MARATHON_DEV_SSH_KEY, pipeline patch 0050),
# relative to /usr.
DEV_KEY = "share/factory/root/.ssh/authorized_keys"
PRESET = "lib/systemd/system-preset/10-marathon.preset"


def image_has(image, path, erofs):
    if erofs:
        out = subprocess.run(["dump.erofs", f"--path={path}", str(image)], capture_output=True).stdout
        return out.startswith(b"Path :")
    out = subprocess.run(["debugfs", "-R", f"stat {path}", str(image)], capture_output=True).stdout
    return b"Inode:" in out


def image_cat(image, path, erofs):
    cmd = ["dump.erofs", "--cat", f"--path={path}"] if erofs else ["debugfs", "-R", f"cat {path}"]
    return subprocess.run(cmd + [str(image)], capture_output=True, check=True).stdout


def refuse_dev_access(artifacts):
    """A feed reaches everyone's phone, so its images must trust no
    builder's key: refuse one built with MARATHON_DEV_SSH_KEY, and one this
    cannot read to check."""
    for image in artifacts:
        if image.suffix == ".ext4" or re.search(r"\.root\.[0-9a-f]{32}\.raw$", image.name):
            erofs, usr = False, "/usr/"
        elif re.search(r"\.usr-[a-z0-9_]+\.[0-9a-f]{32}\.raw$", image.name):
            erofs, usr = True, "/"
        else:
            continue
        if not image_has(image, "/", erofs):
            fail(f"cannot read {image.name} to check it for developer SSH access")
        preset = image_cat(image, usr + PRESET, erofs).splitlines() if image_has(image, usr + PRESET, erofs) else []
        if image_has(image, usr + DEV_KEY, erofs) or b"enable sshd.service" in preset:
            fail(f"{image.name} lets the builder's SSH key in; build the release with MARATHON_DEV_SSH_KEY= (empty)")


def versions_in(feed_dir, image_id):
    found = set()
    pattern = re.compile(re.escape(image_id) + r"_([^._+]+)\.(?:efi|boot\.[0-9a-f]{32}\.raw\.zst|ext4\.zst)$")
    for f in feed_dir.iterdir():
        m = pattern.match(f.name)
        if m:
            found.add(m.group(1))
    return found


def version_key(version):
    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", version)]


def files_of(feed_dir, image_id, version):
    prefix = f"{image_id}_{version}."
    return sorted(f for f in feed_dir.iterdir() if f.name.startswith(prefix))


def stage(artifacts, feed_dir):
    for src in artifacts:
        if src.suffix == ".efi":
            dest = feed_dir / src.name
            tmp = dest.with_name(dest.name + ".part")
            shutil.copyfile(src, tmp)
        else:
            dest = feed_dir / (src.name + ".zst")
            tmp = dest.with_name(dest.name + ".part")
            subprocess.run(["zstd", "-q", "-f", "-T0", "-9", str(src), "-o", str(tmp)], check=True)
        os.replace(tmp, dest)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def description_markup(notes):
    """AppStream description markup: "- " and "* " lines start list items,
    blank lines end paragraphs, and other lines continue the current one."""
    blocks = []
    open_block = False
    for line in (raw.strip() for raw in notes.splitlines()):
        if not line:
            open_block = False
        elif line[:2] in ("- ", "* "):
            blocks.append(("li", [line[2:].strip()]))
            open_block = True
        elif open_block:
            blocks[-1][1].append(line)
        else:
            blocks.append(("p", [line]))
            open_block = True
    markup = ""
    for tag, group in itertools.groupby(blocks, key=lambda b: b[0]):
        items = "".join(f"<{tag}>{escape(' '.join(words))}</{tag}>" for _, words in group)
        markup += f"<ul>{items}</ul>" if tag == "li" else items
    return markup


def write_catalog(feed_dir, image_id, versions):
    releases = []
    for v in sorted(versions, key=version_key, reverse=True):
        payload = [f for f in files_of(feed_dir, image_id, v) if not f.name.endswith(".notes")]
        size = sum(f.stat().st_size for f in payload)
        notes_file = feed_dir / f"{image_id}_{v}.notes"
        markup = description_markup(notes_file.read_text()) if notes_file.exists() else ""
        description = f"\n        <description>{markup}</description>" if markup else ""
        releases.append(
            f"      <release version={quoteattr(v)}>{description}\n"
            f"        <artifacts>\n"
            f"          <artifact type=\"binary\"><size type=\"download\">{size}</size></artifact>\n"
            f"        </artifacts>\n"
            f"      </release>\n")
    catalog = (
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        f"<components version=\"0.16\" origin={quoteattr(image_id)}>\n"
        "  <component merge=\"append\">\n"
        "    <id>org.marathonos.MarathonOS</id>\n"
        "    <releases>\n"
        f"{''.join(releases)}"
        "    </releases>\n"
        "    <bundle type=\"systemd\" class=\"sysupdate\"/>\n"
        "  </component>\n"
        "</components>\n")
    (feed_dir / CATALOG).write_text(catalog)


def write_manifest(feed_dir):
    names = sorted(f.name for f in feed_dir.iterdir()
                   if f.is_file() and f.name not in (MANIFEST, SIGNATURE) and not f.name.endswith(".part"))
    tmp = feed_dir / (MANIFEST + ".part")
    tmp.write_text("".join(f"{sha256(feed_dir / n)}  {n}\n" for n in names))
    return tmp


def publish(args):
    image_dir = Path(args.image_dir).resolve()
    image_id = image_dir.name
    feed_dir = Path(args.feed).resolve() / image_id
    feed_dir.mkdir(parents=True, exist_ok=True)

    artifacts = find_artifacts(image_dir, image_id, args.version)
    refuse_dev_access(artifacts)
    published = versions_in(feed_dir, image_id)
    if args.version in published:
        fail(f"{image_id} {args.version} is already in the feed")
    newest = max(published, key=version_key, default=None)
    if newest and version_key(args.version) < version_key(newest):
        fail(f"{args.version} is older than {newest}; sysupdate would never offer it")

    stage(artifacts, feed_dir)
    if args.notes:
        shutil.copyfile(args.notes, feed_dir / f"{image_id}_{args.version}.notes")

    kept = sorted(published | {args.version}, key=version_key, reverse=True)[:args.keep]
    for old in published - set(kept):
        for f in files_of(feed_dir, image_id, old):
            f.unlink()

    write_catalog(feed_dir, image_id, kept)
    manifest = write_manifest(feed_dir)
    signature = feed_dir / (SIGNATURE + ".part")
    sign = ["--yes", "--detach-sign", "--output", str(signature)]
    if args.key:
        sign += ["--local-user", args.key]
    gpg(args.gnupghome, *sign, str(manifest))
    gpg(args.gnupghome, "--verify", str(signature), str(manifest), stderr=subprocess.DEVNULL)
    # Payload first, manifest last: a client never sees a version whose
    # files are not all in place.
    os.replace(manifest, feed_dir / MANIFEST)
    os.replace(signature, feed_dir / SIGNATURE)
    print(f"published {image_id} {args.version} to {feed_dir} (keeping {', '.join(kept)})")

    if args.github:
        github_sync(feed_dir, args.github, f"{args.channel}/{image_id}", args.channel != "stable")

    if args.upload:
        dest = args.upload.rstrip("/") + f"/{image_id}/"
        src = str(feed_dir) + "/"
        subprocess.run(["rsync", "-a", f"--exclude={MANIFEST}", f"--exclude={SIGNATURE}",
                        f"--exclude={CATALOG}", src, dest], check=True)
        subprocess.run(["rsync", "-a", "--delete-after", src, dest], check=True)
        print(f"uploaded to {dest}")


def gh(*args, **kwargs):
    return subprocess.run(["gh", *args], check=True, text=True, **kwargs)


def release_assets(repo, tag):
    """{name: (id, size)} of the release's assets, or None if there is no release."""
    r = subprocess.run(["gh", "api", f"repos/{repo}/releases/tags/{tag}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        if "Not Found" in r.stdout + r.stderr:
            return None
        fail(f"gh api: {r.stderr.strip()}")
    return {a["name"]: (a["id"], a["size"]) for a in json.loads(r.stdout)["assets"]}


def github_sync(feed_dir, repo, tag, prerelease):
    """Mirror feed_dir onto the release `tag`: payloads first, then the
    manifest, signature and catalog, each uploaded under a temporary name and
    renamed over the old one, then the pruned versions' assets go."""
    files = {f.name: f for f in feed_dir.iterdir() if f.is_file() and not f.name.endswith(".part")}
    for f in files.values():
        if f.stat().st_size > GITHUB_ASSET_MAX:
            fail(f"{f.name} is {f.stat().st_size} bytes; GitHub release assets must be under 2 GiB")
    assets = release_assets(repo, tag)
    if assets is None:
        gh("release", "create", tag, "--repo", repo, "--title", tag, "--latest=false",
           "--notes", f"systemd-sysupdate feed {tag}; every asset is listed in the signed SHA256SUMS.",
           *(["--prerelease"] if prerelease else []), stdout=subprocess.DEVNULL)
        assets = {}
    last = (CATALOG, MANIFEST, SIGNATURE)
    payload = [f for n, f in sorted(files.items())
               if n not in last and (n not in assets or assets[n][1] != f.stat().st_size)]
    if payload:
        gh("release", "upload", tag, "--repo", repo, "--clobber", *map(str, payload))
    with tempfile.TemporaryDirectory() as tmp:
        staged = []
        for name in last:
            new = Path(tmp) / f"{name}.new"
            shutil.copyfile(files[name], new)
            staged.append(new)
        gh("release", "upload", tag, "--repo", repo, "--clobber", *map(str, staged))
    assets = release_assets(repo, tag)
    for name in last:
        if name in assets:
            gh("api", "-X", "DELETE", f"repos/{repo}/releases/assets/{assets[name][0]}")
        gh("api", "-X", "PATCH", f"repos/{repo}/releases/assets/{assets[name + '.new'][0]}",
           "-f", f"name={name}", stdout=subprocess.DEVNULL)
    for name, (asset_id, _) in release_assets(repo, tag).items():
        if name not in files:
            gh("api", "-X", "DELETE", f"repos/{repo}/releases/assets/{asset_id}")
    # Downloads lag a replaced asset; until both are served a phone may see
    # the old manifest, or the new manifest with the old signature.
    base = f"https://github.com/{repo}/releases/download/{tag}/"
    start = time.monotonic()
    while any(served(base + n) != files[n].read_bytes() for n in (MANIFEST, SIGNATURE)):
        if time.monotonic() - start > 600:
            fail(f"{base}{MANIFEST} is still not the new one after 10 minutes")
        time.sleep(5)
    print(f"synced to https://github.com/{repo}/releases/tag/{tag}; "
          f"served after {time.monotonic() - start:.0f}s")


def served(url):
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            return r.read()
    except OSError:
        return None


def keygen(args):
    home = Path(args.gnupghome)
    home.mkdir(parents=True, exist_ok=True)
    home.chmod(0o700)
    gpg(home, "--passphrase", "", "--pinentry-mode", "loopback",
        "--quick-generate-key", args.uid, "ed25519", "sign", "never")
    with open(args.export, "wb") as out:
        gpg(home, "--armor", "--export", args.uid, stdout=out)
    print(f"key in {home}; public key exported to {args.export}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("publish", help="add an image version to a signed feed")
    p.add_argument("--image-dir", required=True, help="mkosi.output/<image-id>")
    p.add_argument("--version", required=True, help="IMAGE_VERSION to publish")
    p.add_argument("--feed", required=True, help="local feed root (one directory per image id)")
    p.add_argument("--gnupghome", help="GnuPG home holding the signing key")
    p.add_argument("--key", help="signing key id (default: the home's default key)")
    p.add_argument("--notes", help="release notes: paragraphs split by blank lines, \"- \" list items")
    p.add_argument("--keep", type=int, default=2, help="versions to keep in the feed (default 2)")
    p.add_argument("--upload", help="rsync destination of the feed root, e.g. user@thrivelobal.com:updates")
    p.add_argument("--github", metavar="OWNER/REPO",
                   help="also mirror the feed onto that repository's release <channel>/<image id>")
    p.add_argument("--channel", default="stable",
                   help="release channel for --github: stable, or test (a pre-release) (default stable)")
    p.set_defaults(run=publish)

    g = sub.add_parser("github-sync", help="mirror a published feed onto its GitHub release again")
    g.add_argument("--feed", required=True, help="local feed root (one directory per image id)")
    g.add_argument("--image-id", required=True, help="e.g. zinwa-q25_marathon_edge")
    g.add_argument("--github", required=True, metavar="OWNER/REPO")
    g.add_argument("--channel", default="stable", help="stable or test (default stable)")
    g.set_defaults(run=lambda a: github_sync(Path(a.feed).resolve() / a.image_id, a.github,
                                             f"{a.channel}/{a.image_id}", a.channel != "stable"))

    k = sub.add_parser("keygen", help="create an Ed25519 signing key and export its public half")
    k.add_argument("--gnupghome", required=True)
    k.add_argument("--export", required=True, help="where to write the armored public key")
    k.add_argument("--uid", default=KEY_UID)
    k.set_defaults(run=keygen)

    args = parser.parse_args()
    if getattr(args, "keep", 1) < 1:
        fail("--keep must be at least 1")
    if getattr(args, "upload", None) and getattr(args, "github", None):
        fail("--upload and --github are separate feeds; publish to one at a time")
    if getattr(args, "channel", "stable") not in ("stable", "test"):
        fail("--channel must be stable or test")
    for tool in (("gpg", "zstd") + (("rsync",) if getattr(args, "upload", None) else ())
                 + (("gh",) if getattr(args, "github", None) else ())):
        if not shutil.which(tool):
            fail(f"{tool} is not installed")
    args.run(args)


if __name__ == "__main__":
    main()
