#!/bin/bash
# Marathon App Store URL-scheme handler.
#
# Invoked via xdg-open marathon-store://<verb>/<arg>. The verb-arg pairs are
# strictly enumerated; anything else is rejected before we touch flatpak.
#
# Security:
#   - Refs match a strict RDN regex (Flathub appstream-id shape) and reject any
#     '..' substring to defeat path-traversal in the state file name.
#   - The only remote we talk to is 'flathub'.
#   - flatpak is invoked via exec with a fixed argv — no user input ever reaches
#     a shell. State files are written atomically (write-then-rename).
#   - Per-appid state files prevent concurrent installs from racing each other.
set -euo pipefail

REF_RE='^[A-Za-z][A-Za-z0-9]*(\.[A-Za-z0-9][A-Za-z0-9_-]*)+$'
REMOTE=flathub
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
STATE_DIR="$RUNTIME_DIR/marathon-store-state"
mkdir -p "$STATE_DIR"

url=${1:-}
verb=$(printf '%s\n' "$url" | sed -n 's|^marathon-store://\([^/]*\)/.*|\1|p')
arg=$(printf '%s\n' "$url" | sed -n 's|^marathon-store://[^/]*/\(.*\)$|\1|p')

if [ -z "$verb" ]; then
    printf 'marathon-store-handler: bad url: %s\n' "$url" >&2
    exit 2
fi

case "$verb" in
    install|update|uninstall|open|refresh-state|update-all) ;;
    *)
        printf 'marathon-store-handler: unknown verb: %s\n' "$verb" >&2
        exit 2
        ;;
esac

if [ "$verb" != "refresh-state" ] && [ "$verb" != "update-all" ]; then
    case "$arg" in
        *..*)
            printf 'marathon-store-handler: rejecting traversal: %s\n' "$arg" >&2
            exit 3
            ;;
    esac
    if ! printf '%s' "$arg" | grep -qE "$REF_RE"; then
        printf 'marathon-store-handler: rejecting ref: %s\n' "$arg" >&2
        exit 3
    fi
fi

# xdg-open runs this inside the calling app's sandbox, where /home/user is a
# private tmpfs (flatpak --user would install into a throwaway home) and
# systemd won't take requests from the sandbox's PID namespace. There, PID 1
# is bwrap: hand the URL to the shell, which checks the caller holds the
# "system" permission and runs this handler from outside. In the session,
# re-run as a transient unit so the work outlives xdg-open and stays out of
# the shell's process tree. Validation above has already run.
if [ -z "${MARATHON_STORE_UNIT:-}" ]; then
    if [ "$(cat /proc/1/comm 2>/dev/null)" != systemd ]; then
        exec busctl --user call org.marathonos.Shell /org/marathonos/Shell/AppStore \
            org.marathonos.Shell.AppStore1 RunStoreUrl s "$url"
    fi
    exec systemd-run --user --quiet --collect --setenv=MARATHON_STORE_UNIT=1 \
        "$(readlink -f "$0")" "$url"
fi

write_state() {
    local appid=$1 state=$2 pct=$3 msg=${4:-}
    local target="$STATE_DIR/install-progress-${appid}.json"
    local tmp
    # The message is flatpak's own error text: keep it printable and free of
    # the two characters that could break out of the JSON string.
    msg=$(printf '%s' "$msg" | tr -d '"\\' | tr -c '[:print:]' ' ' | cut -c1-400)
    tmp=$(mktemp "${target}.XXXXXX")
    printf '{"appId":"%s","state":"%s","percent":%s,"error":"%s","ts":%s}\n' \
        "$appid" "$state" "$pct" "$msg" "$(date +%s)" > "$tmp"
    mv "$tmp" "$target"
}

# User installs need a user remote; the image only registers Flathub for the
# system installation.
ensure_remote() {
    local repo=/etc/flatpak/remotes.d/flathub.flatpakrepo
    [ -f "$repo" ] || repo=https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak --user remote-add --if-not-exists "$REMOTE" "$repo"
}

# install / update / uninstall one app, reporting progress through the state
# file the QML polls. Runs with errexit off: under -e a failing flatpak ended
# the script before it could record the failure, so the UI waited on
# "pending" forever.
run_op() {
    local op=$1 appid=$2 log rc=0 busy done_state="done" cmd
    case "$op" in
        install)   cmd="flatpak --user install -y $REMOTE $appid"; busy=installing ;;
        update)    cmd="flatpak --user update -y $appid"; busy=installing ;;
        uninstall) cmd="flatpak --user uninstall -y $appid"; busy=removing; done_state=removed ;;
    esac
    log=$(mktemp "$STATE_DIR/log.XXXXXX")
    set +e
    write_state "$appid" pending -1
    [ "$op" = install ] && ensure_remote >>"$log" 2>&1
    # flatpak only draws progress ("Installing 2/3… 45%") on a terminal, so
    # it runs under script(1) for a pty; -e passes its exit status through.
    # Each redraw ends in a carriage return, so read on those: a tr/sed pipe
    # would block-buffer and deliver every percentage at once at the end.
    # Each step's percentage folds into one figure across all the steps.
    script -q -e -c "$cmd" /dev/null 2>&1 | while IFS= read -r -d $'\r' chunk || [ -n "$chunk" ]; do
        printf '%s\n' "$chunk" >> "$log"
        if [[ $chunk =~ ([0-9]+)/([0-9]+)….*[^0-9]([0-9]{1,3})% ]]; then
            write_state "$appid" "$busy" \
                $(( ((BASH_REMATCH[1] - 1) * 100 + BASH_REMATCH[3]) / BASH_REMATCH[2] ))
        fi
    done
    rc=${PIPESTATUS[0]}
    if [ "$rc" = 0 ]; then
        write_state "$appid" "$done_state" 100
    else
        # flatpak's own reason, without the terminal escapes and progress
        # redraws that share its line.
        write_state "$appid" failed -1 "$(sed -e 's/\x1b\][^\x1b]*\x1b\\//g' -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$log" \
            | grep -o 'error: .*' | tail -1 | sed 's/^error: //')"
    fi
    rm -f "$log"
    /usr/libexec/marathon-store-refresh-state
    set -e
}

update_all() {
    flatpak --user remote-ls --updates --columns=application 2>/dev/null \
        | grep -vE '\.(Locale|Sources|Debug)$' \
        | while read -r app; do run_op update "$app"; done
}

# arg has already been validated against REF_RE, so nothing shell-meaningful
# survives into flatpak's argv. The QML polls the per-app state files. Inside
# the transient unit the work runs in the foreground: systemd kills a unit's
# leftover processes once its main process exits. Without systemd, detach so
# xdg-open returns at once.
case "$verb" in
    install|update|uninstall)
        if [ -n "${MARATHON_STORE_UNIT:-}" ]; then
            run_op "$verb" "$arg"
        else
            (run_op "$verb" "$arg" </dev/null >/dev/null 2>&1 &)
        fi
        ;;
    update-all)
        if [ -n "${MARATHON_STORE_UNIT:-}" ]; then
            update_all
        else
            (update_all </dev/null >/dev/null 2>&1 &)
        fi
        ;;
    refresh-state)
        exec /usr/libexec/marathon-store-refresh-state
        ;;
    # Launch through the shell like a home-screen tap, so the app gets the
    # compositor's socket and a place in the task switcher.
    open)
        exec busctl --user call org.marathonos.Shell /org/marathonos/Shell/Navigation \
            org.marathonos.Shell.Navigation1 LaunchApp s "$arg"
        ;;
esac
