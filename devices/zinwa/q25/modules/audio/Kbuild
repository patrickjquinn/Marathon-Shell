# Out-of-tree ALSA/ASoC stack for the running 7.0.0-q25-cfi-test kernel,
# whose .config has CONFIG_SND_SOC unset. CONFIG_SND_PCM/TIMER are =m there.
# CONFIG_SND_JACK is also unset; snd-jack.ko (core/) supplies it.
subdir-ccflags-y += -DCONFIG_SND_SOC_MODULE=1 -DCONFIG_SND_JACK=1 -DCONFIG_SND_JACK_INPUT_DEV=1
obj-m += core/ soc/ codecs/ mediatek/ q25/ q25accdet/ q25irqfix/
