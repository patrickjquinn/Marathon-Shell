--- a/btif_drv/mtk_btif.c
+++ b/btif_drv/mtk_btif.c
@@ -227,7 +227,7 @@ const struct dev_pm_ops mtk_btif_drv_pm_ops = {
 
 struct platform_driver mtk_btif_dev_drv = {
 	.probe = mtk_btif_probe,
-	.remove_new = mtk_btif_remove,
+	.remove = mtk_btif_remove,
 #ifdef CONFIG_PM
 	.suspend = mtk_btif_suspend,
 	.resume = mtk_btif_resume,
@@ -245,6 +245,8 @@ struct platform_driver mtk_btif_dev_drv = {
 };
 
 static int btif_probed;
+/* 5 s in 100 ms steps for a deferred probe */
+#define BTIF_PROBE_WAIT_STEPS 50
 static DEFINE_SPINLOCK(g_bbs_lock);
 
 #define BTIF_STATE_RELEASE(x) _btif_state_release(x)
@@ -262,7 +264,15 @@ static int mtk_btif_probe(struct platform_device *pdev)
 	g_btif[0].private_data = (struct device *)&pdev->dev;
 
 #if !defined(CONFIG_MTK_CLKMGR)
-	hal_btif_clk_get_and_prepare(pdev);
+	{
+		int ret = hal_btif_clk_get_and_prepare(pdev);
+
+		if (ret) {
+			platform_set_drvdata(pdev, NULL);
+			g_btif[0].private_data = NULL;
+			return ret;
+		}
+	}
 #endif
 
 	btif_probed = 1;
@@ -3308,16 +3318,26 @@ static int BTIF_init(void)
 		BTIF_ERR_FUNC("BTIF pdriver_create_file failed, ret(%d)\n",
 				i_ret);
 
-	/* we keep waiting because KE happens if probe function is not called. */
-	while (btif_probed == 0)
-		msleep(500);
+	/*
+	 * Probe runs synchronously for an existing node; allow a bounded
+	 * window for a deferred probe, then fail closed. Without a probed
+	 * device nothing below may touch BTIF.
+	 */
+	for (index = 0; index < BTIF_PROBE_WAIT_STEPS && !btif_probed; index++)
+		msleep(100);
+	if (!btif_probed) {
+		BTIF_ERR_FUNC("no BTIF device probed (mediatek,btif node missing or probe failed)\n");
+		i_ret = -ENODEV;
+		goto err_unregister;
+	}
 
 /*SW init*/
 	for (index = 0; index < BTIF_PORT_NR; index++) {
 		p_btif_buffer = kmalloc(BTIF_RX_BUFFER_SIZE, GFP_ATOMIC);
 		if (!p_btif_buffer) {
 			BTIF_ERR_FUNC("p_btif_buffer kmalloc memory fail\n");
-			return -1;
+			i_ret = -ENOMEM;
+			goto err_exit2;
 		}
 		BTIF_INFO_FUNC("p_btif_buffer get memory 0x%p\n",
 				p_btif_buffer);
@@ -3327,7 +3347,8 @@ static int BTIF_init(void)
 		if (!p_tx_queue) {
 			BTIF_ERR_FUNC("p_tx_queue kmalloc memory fail\n");
 			kfree(p_btif_buffer);
-			return -1;
+			i_ret = -ENOMEM;
+			goto err_exit2;
 		}
 		BTIF_INFO_FUNC("p_tx_queue get memory 0x%p\n", p_tx_queue);
 		p_rx_queue = kmalloc_array(BTIF_LOG_ENTRY_NUM,
@@ -3337,7 +3358,8 @@ static int BTIF_init(void)
 			BTIF_ERR_FUNC("p_rx_queue kmalloc memory fail\n");
 			kfree(p_btif_buffer);
 			kfree(p_tx_queue);
-			return -1;
+			i_ret = -ENOMEM;
+			goto err_exit2;
 		}
 		BTIF_INFO_FUNC("p_rx_queue get memory 0x%p\n", p_rx_queue);
 
@@ -3504,12 +3526,20 @@ err_exit2:
 #endif
 		g_btif[index].open_counter = 0;
 		g_btif[index].enable = false;
-	}
+		kfree(g_btif[index].btif_buf.p_buf);
+		g_btif[index].btif_buf.p_buf = NULL;
+		kfree(g_btif[index].tx_log.p_queue);
+		g_btif[index].tx_log.p_queue = NULL;
+		kfree(g_btif[index].rx_log.p_queue);
+		g_btif[index].rx_log.p_queue = NULL;
+	}
+err_unregister:
 	driver_remove_file(&mtk_btif_dev_drv.driver, &driver_attr_flag);
 	platform_driver_unregister(&mtk_btif_dev_drv);
 
 err_exit1:
-	i_ret = -1;
+	if (i_ret >= 0)
+		i_ret = -EIO;
 	BTIF_DBG_FUNC("--\n");
 	return i_ret;
 }
