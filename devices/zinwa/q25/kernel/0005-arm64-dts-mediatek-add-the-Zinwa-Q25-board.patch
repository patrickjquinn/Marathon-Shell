+/* ------------------------------------------------------------------ *
+ * Touchscreen — Synaptics S2716B on I2C0 @ 0x67 (CONFIRMED, LineageOS
+ * q20_v12_factory.dts). 720x720, 5-point. irq=GPIO9 (active-low),
+ * reset=GPIO152 (active-low), power=GPIO27 (active-high). Mainline: rmi4-i2c.
+ * ------------------------------------------------------------------ */
+&i2c0 {
+	status = "okay";
+
+	touchscreen@67 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x67>;
+
+		interrupt-parent = <&pio>;
+		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
+
+		/*
+		 * Power = GPIO27 (active-high). Modeled as an always-on enable
+		 * regulator feeding vdd-supply; reset = GPIO152 (active-low).
+		 * rmi4-i2c has no reset-gpios property — verify on-device whether
+		 * a gpio-hog on 152 or a regulator ramp is needed. syna,reset-
+		 * delay-ms covers the post-reset settle.
+		 */
+		syna,reset-delay-ms = <200>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+			/* 720x720 on a 3.5" square panel ≈ 63 mm/side */
+			touchscreen-x-mm = <63>;
+			touchscreen-y-mm = <63>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ *
+ * Charger — Unisemipower UPM6922 on I2C5 @ 0x6B (stock DTBO fragment@36).
+ * Register-compatible BQ25601 clone (REG0B PN=2), driven by the mainline
+ * bq256xx driver. INT = GPIO37. vindpm 4.6 V from the vendor DT; iindpm
+ * left at the chip/driver default until BC1.2/Type-C negotiation is wired.
+ * This is what lets the phone charge while booted: the bootloader hands the
+ * charger over parked-disabled, and the 0003 patch re-enables it at probe.
+ * ------------------------------------------------------------------ */
+&i2c5 {
+	status = "okay";
+
+	charger: charger@6b {
+		compatible = "ti,bq25601";
+		reg = <0x6b>;
+		interrupts-extended = <&pio 37 IRQ_TYPE_EDGE_FALLING>;
+		input-voltage-limit-microvolt = <4600000>;
+		monitored-battery = <&battery>;
+	};
+};
+
+/* ================================================================== *
+ * Native GPU-accelerated display (mtk-drm), replacing simpledrm.
+ *
+ * The MT6789 display IP is an mt8186-generation clone: the mtk-drm main DDP
+ * path OVL0 -> RDMA0 -> COLOR0 -> CCORR -> AAL0 -> GAMMA -> POSTMASK0 ->
+ * DITHER0 -> DSI0 is identical. mt6789 SoC support is added by the companion
+ * kernel patch (0001-drm-mediatek-add-mt6789-display-support.patch): it wires
+ * "mediatek,mt6789-mmsys" (reusing the mt8186 routing table + the mt6789 MM
+ * clock driver) and "mediatek,mt6789-dsi" (reusing mt8186 DSI driver-data).
+ *
+ * ellyq's mt6789.dtsi declares only ovl0/rdma0/dither0/dsi0 (+mutex/dsc); the
+ * five in-pipeline processors below (color/ccorr/aal/gamma/postmask) are added
+ * here from the vendor base DTB addresses/IRQs + mt8186.dtsi structure. Each
+ * disp node carries the mt8192/mt8173/mt8183 fallback compatible its component
+ * driver already matches, so no per-component driver change is needed.
+ * ================================================================== */
+
+/* The five in-pipeline processors ellyq's dtsi omitted. Addresses + SPI IRQs
+ * from the vendor base DTB; clocks/PD/gce mirror the existing mt6789 ovl0. */
+&{/soc} {
+	color0: color@14009000 {
+		compatible = "mediatek,mt6789-disp-color", "mediatek,mt8173-disp-color";
+		reg = <0 0x14009000 0 0x1000>;
+		interrupts = <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
+		clocks = <&mmsys CLK_MM_DISP_COLOR0>;
+		mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x9000 0x1000>;
+		status = "okay";
+	};
+
+	ccorr0: ccorr@1400b000 {
+		compatible = "mediatek,mt6789-disp-ccorr", "mediatek,mt8192-disp-ccorr";
+		reg = <0 0x1400b000 0 0x1000>;
+		interrupts = <GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
+		clocks = <&mmsys CLK_MM_DISP_CCORR0>;
+		mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xb000 0x1000>;
+		status = "okay";
+	};
+
+	aal0: aal@1400c000 {
+		compatible = "mediatek,mt6789-disp-aal", "mediatek,mt8183-disp-aal";
+		reg = <0 0x1400c000 0 0x1000>;
+		interrupts = <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
+		clocks = <&mmsys CLK_MM_DISP_AAL0>;
+		mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xc000 0x1000>;
+		status = "okay";
+	};
+
+	gamma0: gamma@1400d000 {
+		compatible = "mediatek,mt6789-disp-gamma", "mediatek,mt8183-disp-gamma";
+		reg = <0 0x1400d000 0 0x1000>;
+		interrupts = <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
+		clocks = <&mmsys CLK_MM_DISP_GAMMA0>;
+		mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xd000 0x1000>;
+		status = "okay";
+	};
+
+	postmask0: postmask@1400e000 {
+		compatible = "mediatek,mt6789-disp-postmask", "mediatek,mt8192-disp-postmask";
+		reg = <0 0x1400e000 0 0x1000>;
+		interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+		power-domains = <&spm MT6789_POWER_DOMAIN_DISP>;
+		clocks = <&mmsys CLK_MM_DISP_POSTMASK0>;
+		mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0xe000 0x1000>;
+		status = "okay";
+	};
+
+	/*
+	 * ocp2131 DSI panel bias (+/-AVDD/AVEE). The bootloader already programs
+	 * its I2C registers; hold its enable (GPIO84) high so the rails stay up
+	 * across the mtk-drm panel re-init. (A full ocp2131 i2c driver can replace
+	 * this later for runtime power management.)
+	 */
+	panel_bias_en: panel-bias-enable {
+		compatible = "regulator-fixed";
+		regulator-name = "panel-bias-en";
+		gpio = <&pio 84 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+
+/* Enable the pipeline components already present in mt6789.dtsi and give the
+ * three that lacked a fallback the compatible their driver matches. */
+&ovl0 {
+	compatible = "mediatek,mt6789-disp-ovl", "mediatek,mt8192-disp-ovl";
+	status = "okay";
+};
+
+&rdma0 {
+	compatible = "mediatek,mt6789-disp-rdma", "mediatek,mt8183-disp-rdma";
+	status = "okay";
+};
+
+&dither0 {
+	compatible = "mediatek,mt6789-disp-dither", "mediatek,mt8183-disp-dither";
+	status = "okay";
+};
+
+&mutex {
+	compatible = "mediatek,mt6789-disp-mutex", "mediatek,mt8186-disp-mutex";
+	status = "okay";
+};
+
+/* MIPI D-PHY (already has an mt8183 fallback in the dtsi). */
+&mipi_tx0 {
+	status = "okay";
+};
+
+/* DSI host + the Zinwa q20_v12 720x720 video-mode panel. */
+&dsi0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	panel@0 {
+		compatible = "zinwa,q20-hd720";
+		reg = <0>;
+
+		/* reset = GPIO85, avdd/enable = GPIO156 (vendor q20_v12). Raw
+		 * sequence in the panel driver expects active-high semantics. */
+		reset-gpios = <&pio 85 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&pio 156 GPIO_ACTIVE_HIGH>;
+
+		/* TODO: backlight = <&...>; the vendor uses a mediatek,i2c-leds
+		 * controller. The bootloader leaves the backlight on, so first
+		 * light does not require it; add for brightness control later. */
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi_out>;
+			};
+		};
+	};
+
+	ports {
+		port {
+			dsi_out: endpoint {
+				remote-endpoint = <&panel_in>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ *
+ * GPU — Mali-G57 (Valhall, job-manager). Panfrost + mt6789 GPU support is
+ * already in ellyq's tree; the node just needs enabling and its supplies. The
+ * vgpu / vsram_gpu rails are coupled (see the mt6366 regulators above).
+ * ------------------------------------------------------------------ */
+&gpu {
+	mali-supply = <&mt6366_vgpu_reg>;
+	sram-supply = <&mt6366_vsram_gpu_reg>;
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ *
+ * Internal storage — UFS on ufs@11270000 (+ its PHY) and the peripheral
+ * USB2 controller. The SoC mt6789.dtsi defines both fully (incl. the
+ * mediatek,ufs-disable-mcq + ufs-broken-vcc quirks) but leaves them
+ * status="disabled"; the board must enable them. Without this, the compiled
+ * DTB ships with UFS/USB off and Linux never enumerates storage (the initramfs
+ * then times out with no root). Same enable pattern as the vicky sibling board.
+ * ------------------------------------------------------------------ */
+&ufsphy {
+	status = "okay";
+};
+
+&ufs {
+	status = "okay";
+};
+
+&usb2 {
+	status = "okay";
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+/* ------------------------------------------------------------------ *
+ * Physical QWERTY: RP2040 USB-HID — enumerates over USB, remapped by keyd.
+ * No DT node.
+ * ------------------------------------------------------------------ */
