From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Fri, 30 Oct 2026 23:59:00 +0000
Subject: [PATCH] arm64: dts: mediatek: add the Zinwa Q25 board

Bring the board DTS that the linux-postmarketos-mediatek-g99 recipe
copies into the tree (pmaports mt6789-zinwa-q25.dts, sha512 a242ca0b...)
under version control, so the Q25 DT changes below are reviewable as
source patches. A recipe applying this series must drop its own copy.

Compiled with the 978b8b67 mt6789.dtsi it differs from the DTB the
kernel APK shipped (0c3ee49c...) only in the chosen framebuffer, the
ramoops carveout, two I2C enables and the touch reset; the next patch
reconciles those.
---
 arch/arm64/boot/dts/mediatek/Makefile             |    1 
 arch/arm64/boot/dts/mediatek/mt6789-zinwa-q25.dts |  836 +++++++++++++++++++++
 2 files changed, 837 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index 8fc177c..06c62d3 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -3,6 +3,7 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6779-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6789-motorola-vicky.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6789-zinwa-q25.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6797-evb.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6789-zinwa-q25.dts b/arch/arm64/boot/dts/mediatek/mt6789-zinwa-q25.dts
new file mode 100644
index 0000000..4189072
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6789-zinwa-q25.dts
@@ -0,0 +1,836 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Zinwa Q25 (BlackBerry Classic restomod) — MediaTek Helio G99 (MT6789).
+ *
+ * Modeled on mt6789-motorola-vicky.dts (ellyq/mtk_g99-mainline). This boots on
+ * ellyq's generic mediatek-g99 base via EFI (systemd-boot → vmlinuz.efi EFI
+ * stub); the framebuffer comes from EFI GOP → sysfb/simpledrm (kernel has
+ * CONFIG_EFI/EFI_STUB/FB_EFI/SYSFB_SIMPLEFB/DRM_SIMPLEDRM), so NO device-tree
+ * framebuffer node is needed.
+ *
+ * Hardware translated from LineageOS downstream (q20_v12_factory.dts) + the
+ * MT6789 SoC carveout map (shared with vicky). The only things NOT derivable
+ * off-device are boot verification and the preloader/partition map for
+ * flashing (see ~/zinwa-q25-port/SETUP.md).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/regulator/mediatek,mt6397-regulator.h>
+#include <dt-bindings/pinctrl/mediatek,mt6789-pinfunc.h>
+#include <dt-bindings/iio/adc/mediatek,mt6358-auxadc.h>
+#include "mt6789.dtsi"
+
+/ {
+	model = "Zinwa Q25";
+	chassis-type = "handset";
+	compatible = "zinwa,q25", "mediatek,mt6789";
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:921600n1";
+		/* Framebuffer is EFI-GOP-provided (simpledrm); no fb node here. */
+	};
+
+	/*
+	 * MT6789 SoC/firmware-fixed reserved regions, adopted from
+	 * mt6789-motorola-vicky.dts (same SoC + preloader family). These MUST
+	 * be described or the kernel corrupts BL31/TEE/SCP/modem firmware. The
+	 * addresses are SoC-level and not board-specific; the framebuffer
+	 * carveout (fe0d0000) matches the bootloader fb region.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi_mem:     wifi@bf000000        { reg = <0 0xbf000000 0 0x600000>;  no-map; };
+		consys_emi:   consys_emi@7d000000  { reg = <0 0x7d000000 0 0x500000>;  no-map; };
+		sspm_ap_mem:  sspm_ap@9f560000     { reg = <0 0x9f560000 0 0x110000>;  no-map; };
+		apmdc_mem:    ap_md_c_smem@8c000000  { reg = <0 0x8c000000 0 0x16a0000>; no-map; };
+		apmdnc_mem:   ap_md_nc_smem@8e000000 { reg = <0 0x8e000000 0 0xe00000>;  no-map; };
+		md_mem:       md_mem@e3200000      { reg = <0 0xe3200000 0 0xe00000>;  no-map; };
+		md2_mem:      md_mem2@de800000     { reg = <0 0xde800000 0 0x2b10000>; no-map; };
+		md3_mem:      md_mem3@ddc00000     { reg = <0 0xddc00000 0 0x430000>;  no-map; };
+		md4_mem:      md_mem4@dc000000     { reg = <0 0xdc000000 0 0x1490000>; no-map; };
+		ccci_mem:     ccci_tag@bf9f0000    { reg = <0 0xbf9f0000 0 0x10000>;   no-map; };
+		scp_mem:      scp_share@8f000000   { reg = <0 0x8f000000 0 0x5a0000>;  compatible = "shared-dma-pool"; no-map; };
+		scp_res_mem:  scp@bfa00000         { reg = <0 0xbfa00000 0 0x400000>;  no-map; };
+		dfdmcu_mem:   dfdmcu_dump@fd000000 { reg = <0 0xfd000000 0 0x100000>;  no-map; };
+		crypto_mem:   crypto_hw@48401000   { reg = <0 0x48401000 0 0x1000>;    no-map; };
+		tee_mem:      tee@70000000         { reg = <0 0x70000000 0 0x4600000>; no-map; };
+		tee_sec_mem:  tee_sec@7de00000     { reg = <0 0x7de00000 0 0x800000>;  no-map; };
+		mcupm_mem:    mcupm@7feb0000       { reg = <0 0x7feb0000 0 0x100000>;  no-map; };
+		sspm_mem:     sspm@9fe70000        { reg = <0 0x9fe70000 0 0x180000>;  no-map; };
+		bl31_mem:     bl31@48200000        { reg = <0 0x48200000 0 0x200000>;  no-map; };
+		fb_mem:       framebuffer@fe0d0000 { reg = <0 0xfe0d0000 0 0x1f2f000>; no-map; };
+		aee_lk_mem:   aee_lk@50700000      { reg = <0 0x50700000 0 0x800000>;  no-map; };
+
+		/*
+		 * ramoops persistent crash recorder. Placed in the 2 MiB hole at
+		 * the top of the declared RAM window (memory@ = 0x40000000 +
+		 * 0x80000000 = ends 0xc0000000; the last SoC carveout scp@bfa00000
+		 * ends at 0xbfe00000), so it collides with nothing above and the
+		 * MTK watchdog warm-reset (WATCHDOG_HANDLE_BOOT_ENABLED, 31 s)
+		 * preserves DRAM across a hang -> the last kernel console lines
+		 * survive to /sys/fs/pstore on the next boot. This is the "never
+		 * silently brick again" net: an early driver hang (e.g. the scpsys
+		 * pm-domains probe that wedged the boot with zero disk/journal
+		 * trace) now leaves console-ramoops behind. Requires the built-in
+		 * (=y, not =m) CONFIG_PSTORE_RAM + CONFIG_PSTORE_CONSOLE in config.
+		 * NOT no-map: ramoops memremaps the region as normal RAM.
+		 */
+		ramoops@bfe00000 {
+			compatible = "ramoops";
+			reg = <0 0xbfe00000 0 0x100000>;
+			console-size = <0x80000>;
+			record-size = <0x40000>;
+			pmsg-size = <0x20000>;
+			max-reason = <5>; /* KMSG_DUMP_OOPS and worse */
+		};
+	};
+
+	/*
+	 * Main system rail feeding the MT6366 PMIC. Fixed/always-on: it is
+	 * hardwired live by the preloader (which is why the device boots with
+	 * the regulator subsystem previously compiled out). Every mt6366
+	 * vsys-*-supply below hangs off this. Board-specific panel/sensor
+	 * fixed-regulators (avdd/vci/dvdd, which have GPIO enables) are added
+	 * with the display bring-up, not here.
+	 */
+	reg_vsys: regulator-vsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vsys";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Battery — 3000 mAh Li-ion pack. Values from the stock DTBO
+	 * (upm6922 vreg 4440 mV, ichg 3000 mA, iprechg 180 mA, iterm 200 mA;
+	 * pack design_cap 3000 mAh; gauge shutdown floor 3.4 V).
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <3000000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4440000>;
+		constant-charge-current-max-microamp = <3000000>;
+		constant-charge-voltage-max-microvolt = <4440000>;
+		precharge-current-microamp = <180000>;
+		charge-term-current-microamp = <200000>;
+	};
+
+	/*
+	 * Voltage-only fuel gauge: the MT6366 AUXADC BATADC channel surfaced
+	 * as a battery power_supply (generic-adc-battery). The MT6366
+	 * coulomb-counter gauge has no mainline driver; % is derived from
+	 * voltage in userspace for now.
+	 *
+	 * NB: deliberately NO `power-supplies = <&charger>` here. Linking the
+	 * adc-battery's supplied_from to the bq256xx charger makes
+	 * power_supply_changed_work -> __power_supply_am_i_supplied walk the
+	 * supply list and strcmp() a NULL supplier name the instant the charger
+	 * comes online -> NULL-deref Oops (observed 2x at ~4s probe on-device).
+	 * The voltage gauge polls the ADC independently, so it needs no supply
+	 * notifications. Do not re-add the link.
+	 */
+	fuel_gauge: fuel-gauge {
+		compatible = "adc-battery";
+		io-channels = <&pmic_adc MT6358_AUXADC_BATADC>;
+		io-channel-names = "voltage";
+		monitored-battery = <&battery>;
+	};
+};
+
+/* ------------------------------------------------------------------ *
+ * PMIC — MT6366 (mt6358 family) over the SoC pwrap. Cribbed verbatim from
+ * mt6789-motorola-vicky.dts (same SoC + PMIC). Without this node the pwrap
+ * driver probes the bare SoC node, finds no PMIC child, and fails -EINVAL
+ * (-22) — which starved every regulator, the RTC, and the power key. Needs
+ * CONFIG_REGULATOR + CONFIG_REGULATOR_MT6358 (added to the kernel config).
+ * Keys: power = KEY_POWER (universal); the HOME pin keycode is provisional
+ * and will be reconciled with the Q25's physical buttons later.
+ * ------------------------------------------------------------------ */
+&pwrap {
+	status = "okay";
+
+	pmic: pmic {
+		compatible = "mediatek,mt6358";
+		interrupt-controller;
+		interrupts-extended = <&pio 137 IRQ_TYPE_LEVEL_HIGH>;
+		#interrupt-cells = <2>;
+
+		mt6366_regulator: mt6366-regulator {
+			compatible = "mediatek,mt6366-regulator", "mediatek,mt6358-regulator";
+
+			vsys-ldo1-supply = <&reg_vsys>;
+			vsys-ldo2-supply = <&reg_vsys>;
+			vsys-ldo3-supply = <&reg_vsys>;
+			vsys-vs1-supply = <&reg_vsys>;
+			vsys-vs2-supply = <&reg_vsys>;
+			vsys-vdram1-supply = <&reg_vsys>;
+			vsys-vcore-supply = <&reg_vsys>;
+			vsys-vpa-supply = <&reg_vsys>;
+			vsys-vproc11-supply = <&reg_vsys>;
+			vsys-vproc12-supply = <&reg_vsys>;
+			vsys-vgpu-supply = <&reg_vsys>;
+			vsys-vmodem-supply = <&reg_vsys>;
+			vs1-ldo1-supply = <&mt6366_vs1_reg>;
+			vs2-ldo1-supply = <&mt6366_vdram1_reg>;
+			vs2-ldo2-supply = <&mt6366_vs2_reg>;
+			vs2-ldo3-supply = <&mt6366_vs2_reg>;
+
+			mt6366_vdram1_reg: vdram1 {
+				regulator-name = "vdram1";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <2087500>;
+				regulator-ramp-delay = <12500>;
+				regulator-enable-ramp-delay = <0>;
+				regulator-always-on;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vcore_reg: vcore {
+				regulator-name = "vcore";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1293750>;
+				regulator-ramp-delay = <6250>;
+				regulator-enable-ramp-delay = <200>;
+				regulator-always-on;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vpa_reg: vpa {
+				regulator-name = "vpa";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <3650000>;
+				regulator-ramp-delay = <50000>;
+				regulator-enable-ramp-delay = <250>;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vproc11_reg: vproc11 {
+				regulator-name = "vproc11";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1293750>;
+				regulator-ramp-delay = <6250>;
+				regulator-enable-ramp-delay = <200>;
+				regulator-always-on;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vproc12_reg: vproc12 {
+				regulator-name = "vproc12";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1293750>;
+				regulator-ramp-delay = <6250>;
+				regulator-enable-ramp-delay = <200>;
+				regulator-always-on;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vgpu_reg: vgpu {
+				regulator-name = "vgpu";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1293750>;
+				regulator-ramp-delay = <6250>;
+				regulator-enable-ramp-delay = <200>;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+
+				regulator-coupled-with = <&mt6366_vsram_gpu_reg>;
+				regulator-coupled-max-spread = <100000>;
+			};
+
+			mt6366_vs2_reg: vs2 {
+				regulator-name = "vs2";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <2087500>;
+				regulator-ramp-delay = <12500>;
+				regulator-enable-ramp-delay = <0>;
+				regulator-always-on;
+			};
+
+			mt6366_vmodem_reg: vmodem {
+				regulator-name = "vmodem";
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1293750>;
+				regulator-ramp-delay = <6250>;
+				regulator-enable-ramp-delay = <900>;
+				regulator-always-on;
+				regulator-allowed-modes = <MT6397_BUCK_MODE_AUTO
+				                           MT6397_BUCK_MODE_FORCE_PWM>;
+			};
+
+			mt6366_vs1_reg: vs1 {
+				regulator-name = "vs1";
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <2587500>;
+				regulator-ramp-delay = <12500>;
+				regulator-enable-ramp-delay = <0>;
+				regulator-always-on;
+			};
+
+			/* LPDDR4X, always on */
+			mt6366_vdram2_reg: vdram2 {
+				regulator-name = "vdram2";
+				regulator-min-microvolt = <600000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-enable-ramp-delay = <3300>;
+				regulator-always-on;
+			};
+
+			mt6366_vsim1_reg: vsim1 {
+				regulator-name = "vsim1";
+				regulator-min-microvolt = <1700000>;
+				regulator-max-microvolt = <3100000>;
+				regulator-enable-ramp-delay = <540>;
+			};
+
+			mt6366_vibr_reg: vibr {
+				regulator-name = "vibr";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-enable-ramp-delay = <60>;
+			};
+
+			mt6366_vrf12_reg: vrf12 {
