From 85f67c2ad189023a42725e13d3f7d27c3b32faf8 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 09:14:19 +0000
Subject: [PATCH 12/13] dt-bindings: gnss: add MediaTek MT6789 CONNSYS GNSS

The MT6789 connectivity subsystem has a GNSS function next to Wi-Fi and
Bluetooth. Its DSP is loaded by the host and reached through the CONNSYS
firmware, so the node has no registers and sits under the CONNSYS node.
The only board wiring the host controls is the LNA enable pin, which
the DSP drives once the pin is muxed to it: two pinctrl states describe
that.
---
 .../bindings/gnss/mediatek,mt6789-gnss.yaml   | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gnss/mediatek,mt6789-gnss.yaml

diff --git a/Documentation/devicetree/bindings/gnss/mediatek,mt6789-gnss.yaml b/Documentation/devicetree/bindings/gnss/mediatek,mt6789-gnss.yaml
new file mode 100644
index 0000000..17e1573
--- /dev/null
+++ b/Documentation/devicetree/bindings/gnss/mediatek,mt6789-gnss.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gnss/mediatek,mt6789-gnss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6789 CONNSYS GNSS receiver
+
+maintainers:
+  - Patrick Quinn <patrick.jm.quinn@gmail.com>
+
+description:
+  The GNSS function of the MT6789 connectivity subsystem (CONNSYS), which
+  also holds the Wi-Fi and Bluetooth functions. A DSP in CONNSYS, loaded by
+  the host at every power-on, tracks the satellites; the host reaches it
+  through the CONNSYS firmware, so the node has no registers of its own and
+  sits under the CONNSYS node. The antenna's low-noise amplifier is enabled
+  by a pin that the DSP drives once the pin is muxed to it.
+
+allOf:
+  - $ref: gnss-common.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6789-gnss
+
+  pinctrl-names:
+    description:
+      The default state holds the LNA enable pin low as a GPIO; the active
+      state muxes it to the GNSS DSP while the receiver is on.
+    items:
+      - const: default
+      - const: active
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    gnss {
+        compatible = "mediatek,mt6789-gnss";
+        pinctrl-names = "default", "active";
+        pinctrl-0 = <&gnss_lna_off_pins>;
+        pinctrl-1 = <&gnss_lna_dsp_pins>;
+    };
-- 
