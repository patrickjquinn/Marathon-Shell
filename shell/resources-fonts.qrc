<RCC>
    <!--
        Fonts qrc kept SEPARATE from resources.qrc so the alias mapping
        between the canonical names that QML FontLoader uses (Sora.ttf,
        Slate-Light.ttf, …) and the on-disk filenames (Sora[wght].ttf,
        SlateLight.TTF, …) survives. qt_add_resources's FILES form
        cannot express `alias=` and the brackets in `Sora[wght].ttf`
        broke the prefix-mapped lookup, so the shell silently fell
        back to a system serif. This qrc restores the named lookups.
    -->
    <qresource prefix="/fonts">
        <file alias="Sora.ttf">resources/fonts/Sora[wght].ttf</file>
        <file alias="JetBrainsMono-Medium.ttf">resources/fonts/JetBrainsMono-Medium.ttf</file>
        <file alias="Slate-Light.ttf">resources/fonts/SlateLight.TTF</file>
        <file alias="Slate-LightItalic.ttf">resources/fonts/SlateLightIt.TTF</file>
        <file alias="Slate-Book.ttf">resources/fonts/SlateBook.TTF</file>
        <file alias="Slate-BookItalic.ttf">resources/fonts/SlateBookIt.TTF</file>
        <file alias="Slate-Regular.ttf">resources/fonts/SlateRg.TTF</file>
        <file alias="Slate-RegularItalic.ttf">resources/fonts/SlateRgIt.TTF</file>
        <file alias="Slate-Medium.ttf">resources/fonts/SlateMedium.TTF</file>
        <file alias="Slate-MediumItalic.ttf">resources/fonts/SlateMedIt.TTF</file>
        <file alias="Slate-Bold.ttf">resources/fonts/SlateBold.TTF</file>
        <file alias="Slate-BoldItalic.ttf">resources/fonts/SlateBoldIt.TTF</file>
    </qresource>
</RCC>
