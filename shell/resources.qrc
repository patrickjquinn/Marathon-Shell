<RCC>
    <!--
        Sounds-only qrc. The small UI assets (icons, wallpapers, fonts)
        are embedded via the explicit FILES form of qt_add_resources in
        shell/CMakeLists.txt — that path is reliable across Qt versions,
        whereas a mixed-content qrc through qt6_add_big_resources lost
        every .svg/.png entry under Alpine's Qt 6.10 toolchain.
    -->
    <qresource prefix="/sounds">
        <file>resources/sounds/alarms/alarm_antelope.wav</file>
