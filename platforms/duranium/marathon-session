#!/bin/sh
# Marathon split-process session entrypoint.
#
# greetd's default_session.command should point at this script. It
# starts the marathon-session.target as a user unit, blocks until
# the target is active, and exits — letting the per-service Restart=
# policies handle subsequent compositor / shell failures.
set -e

systemctl --user start marathon-session.target
exec systemctl --user --wait is-active marathon-session.target
