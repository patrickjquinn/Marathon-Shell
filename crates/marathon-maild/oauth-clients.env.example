# Marathon Mail's OAuth client IDs, baked in at build time.
#
# Copy to oauth-clients.env (gitignored) and fill in the IDs registered per
# docs/MAIL_OAUTH_REGISTRATION.md; scripts/qemu/lib/build-marathon-shell-apk.sh
# passes them to cargo, where option_env!() in src/oauth.rs reads them.
# They are not secrets (PKCE replaces the client secret). Left empty, Mail
# offers only the password setup.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Desktop app), e.g. 842XXXXXXX-XXXXXXXXXXX.apps.googleusercontent.com
MARATHON_DEFAULT_GOOGLE_CLIENT_ID=""

# Microsoft Entra → App registrations → Application (client) ID.
MARATHON_DEFAULT_MICROSOFT_CLIENT_ID=""
