# Session-bus activation: the first call to org.shipwright.Pilot starts
# pilotd through systemd, so activated and manual starts are one unit.
[D-BUS Service]
Name=org.shipwright.Pilot
Exec=/usr/bin/pilotd
SystemdService=shoal-pilotd.service
