#!/bin/sh
# pilotd's open_command on Marathon. $1 is the app, which pilotd checks is
# not already running; the shell starts it behind the app on screen, which
# Pilot's overlay then shows over.
exec busctl --user call org.marathonos.Shell /org/marathonos/Shell/Navigation \
	org.marathonos.Shell.Navigation1 StartAppInBackground s shoal-pilot
