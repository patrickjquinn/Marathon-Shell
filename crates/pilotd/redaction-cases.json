{
  "about": "Redaction cases shared by pilotd (src/redact.rs) and Pilot Lite (lite/qml/lite/redact.js); both test suites run every case, so the two redactors cannot drift apart. `contacts` are the address-book names the redactor knows (Lite has none, but its redactor takes the same list).",
  "cases": [
    {"input": "call +358 40 123 4567 now", "output": "call <PHONE_1> now"},
    {"input": "call +44 (0)20 7946 0958 now", "output": "call <PHONE_1> now"},
    {"input": "call 0044 20 7946 0958 now", "output": "call <PHONE_1> now"},
    {"input": "call 040-123 4567 now", "output": "call <PHONE_1> now"},
    {"input": "call (01) 234 5678 now", "output": "call <PHONE_1> now"},
    {"input": "call 087 123 4567 now", "output": "call <PHONE_1> now"},
    {"input": "set a timer for 25 minutes", "output": "set a timer for 25 minutes"},
    {"input": "alarm at 07:30", "output": "alarm at 07:30"},
    {"input": "what happened in 1999", "output": "what happened in 1999"},
    {"input": "I walked 12000 steps", "output": "I walked 12000 steps"},
    {"input": "turn volume to 40", "output": "turn volume to 40"},
    {"input": "mail anna.v+work@example.co.uk and ANNA.V+WORK@example.co.uk", "output": "mail <EMAIL_1> and <EMAIL_1>"},
    {"input": "meet at 221B Baker Street, London NW1 6XE", "output": "meet at <ADDRESS_1>, London <ADDRESS_2>"},
    {"input": "deliver to Mannerheimintie 12 B 7, 00100 Helsinki", "output": "deliver to <ADDRESS_1>, <ADDRESS_2>"},
    {"input": "send it to Östra Långgatan 4, 40213 Göteborg", "output": "send it to <ADDRESS_1>, <ADDRESS_2>"},
    {"input": "the office is in 40100 Jyväskylä", "output": "the office is in <ADDRESS_1>"},
    {"input": "my Eircode is D02 X285", "output": "my Eircode is <ADDRESS_1>"},
    {"input": "the café on rue de la Paix", "output": "the café on <ADDRESS_1>"},
    {"input": "pay to IBAN FI21 1234 5600 0007 85 today", "output": "pay to IBAN <ACCOUNT_1> today"},
    {"input": "card 4111 1111 1111 1111 expires", "output": "card <ACCOUNT_1> expires"},
    {"input": "my account number is 12345678 and sort code 12-34-56", "output": "my account number is <ACCOUNT_1> and sort code <ACCOUNT_2>"},
    {"input": "order 4111111111111112", "output": "order 4111111111111112"},
    {"input": "email anna@example.org or call +358401234567", "output": "email <EMAIL_1> or call <PHONE_1>"},
    {"input": "remind me to ring Anna when I get home, and tell anna virtanen too",
     "contacts": ["Anna Virtanen", "Seán Ó Briain", "Bo"],
     "output": "remind me to ring <CONTACT_1> when I get home, and tell <CONTACT_1> too"},
    {"input": "text Seán Ó Briain; Annabel is someone else",
     "contacts": ["Anna Virtanen", "Seán Ó Briain", "Bo"],
     "output": "text <CONTACT_1>; Annabel is someone else"},
    {"input": "Bo", "contacts": ["Anna Virtanen", "Seán Ó Briain", "Bo"], "output": "<CONTACT_1>"},
    {"input": "a boat", "contacts": ["Anna Virtanen", "Seán Ó Briain", "Bo"], "output": "a boat"}
  ]
}
