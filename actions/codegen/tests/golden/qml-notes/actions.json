      "name": "org.example.notes/notes.share",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
