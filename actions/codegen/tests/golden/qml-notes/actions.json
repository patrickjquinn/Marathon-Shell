{
  "appId": "org.example.notes",
  "context": {
    "uri": "keel://org.example.notes/context"
  },
  "entities": [
    {
      "description": "A note: a title and a body of text, with tags.",
      "findTool": "org.example.notes/note.find",
      "schema": {
        "$defs": {
          "org.example.notes.note": {
            "format": "uri",
            "maxLength": 286,
            "pattern": "^keel://org\\.example\\.notes/note/[^/?#\\s]{1,256}$",
            "type": "string",
            "x-keel-entity": "org.example.notes/note"
          }
        },
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 20000,
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "maxLength": 32,
            "type": "string",
            "x-keel-indexable": true,
            "x-keel-summarisable": true
          },
          "id": {
            "maxLength": 256,
            "type": "string"
          },
          "tags": {
            "items": {
              "maxLength": 40,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array",
            "x-keel-indexable": true,
            "x-keel-summarisable": true
          },
          "title": {
            "maxLength": 512,
            "type": "string"
          },
          "uri": {
            "$ref": "#/$defs/org.example.notes.note"
          }
        },
        "required": [
          "uri",
          "id",
          "title"
        ],
        "type": "object"
      },
      "title": "Note",
      "type": "note",
      "uriTemplate": "keel://org.example.notes/note/{id}"
    }
  ],
  "prompts": [
    {
      "_meta": {
        "org.shipwright.keel/steps": [
          {
            "arguments": {
              "body": "{{items}}",
              "title": "Shopping"
            },
            "tool": "org.example.notes/notes.create"
          }
        ]
      },
      "arguments": [
        {
          "description": "What to buy",
          "name": "items",
          "required": true
        }
      ],
      "description": "Create a note titled Shopping with the items given.",
      "name": "org.example.notes/shopping-list",
      "title": "New shopping list"
    }
  ],
  "tools": [
    {
      "_meta": {
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/find": "note",
        "org.shipwright.keel/result": "object",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Find Note items by text. Returns references (uri, id, title) for later steps. A note: a title and a body of text, with tags.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Text to look for; empty for the most recent.",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "org.example.notes/note.find",
      "outputSchema": {
        "$defs": {
          "org.example.notes.note": {
            "format": "uri",
            "maxLength": 286,
            "pattern": "^keel://org\\.example\\.notes/note/[^/?#\\s]{1,256}$",
            "type": "string",
            "x-keel-entity": "org.example.notes/note"
          }
        },
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "created": {
                  "format": "date-time",
                  "maxLength": 32,
                  "type": "string",
                  "x-keel-indexable": true,
                  "x-keel-summarisable": true
                },
                "id": {
                  "maxLength": 256,
                  "type": "string"
                },
                "tags": {
                  "items": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "maxItems": 20,
                  "type": "array",
                  "x-keel-indexable": true,
                  "x-keel-summarisable": true
                },
                "title": {
                  "maxLength": 512,
                  "type": "string"
                },
                "uri": {
                  "$ref": "#/$defs/org.example.notes.note"
                }
              },
              "required": [
                "uri",
                "id",
                "title"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "title": "Find Note"
    },
    {
