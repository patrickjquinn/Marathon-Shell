    },
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.share",
        "org.shipwright.keel/confirm": true,
        "org.shipwright.keel/notDestructiveBecause": "It sends a copy; the note itself is unchanged.",
        "org.shipwright.keel/result": "wrapped",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 200
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Send a note's text to a contact by e-mail. The note leaves the device.",
      "inputSchema": {
        "$defs": {
          "org.example.contacts.contact": {
            "format": "uri",
            "maxLength": 292,
            "pattern": "^keel://org\\.example\\.contacts/contact/[^/?#\\s]{1,256}$",
            "type": "string",
            "x-keel-entity": "org.example.contacts/contact"
          },
          "org.example.notes.note": {
            "format": "uri",
            "maxLength": 286,
            "pattern": "^keel://org\\.example\\.notes/note/[^/?#\\s]{1,256}$",
            "type": "string",
            "x-keel-entity": "org.example.notes/note"
          }
        },
        "additionalProperties": false,
        "properties": {
          "note": {
            "$ref": "#/$defs/org.example.notes.note"
          },
