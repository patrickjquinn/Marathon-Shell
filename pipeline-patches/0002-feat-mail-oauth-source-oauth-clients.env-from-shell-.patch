From a7e23c19d137ff543b2807f1c4aadd156a6d360e Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Tue, 19 May 2026 21:46:34 +0100
Subject: [PATCH 02/10] feat(mail-oauth): source oauth-clients.env from shell
 src tree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

If the source-tree path tools/marathon-mail-oauth/oauth-clients.env
exists (gitignored — see Marathon-Shell oauth-clients.env.example),
source it before invoking podman and pass
MARATHON_DEFAULT_GOOGLE_CLIENT_ID / MARATHON_DEFAULT_MICROSOFT_CLIENT_ID
through to the container's environment. The APKBUILD's build()
then forwards them to cargo, where option_env! in src/main.rs bakes
the values as &'static str constants.

The wrapper prints "oauth bake: gmail=set, microsoft=set" (or
"none") when starting, so each build's actual configuration is
visible in the log — no silent fall-through to community-apk mode
when the file was expected.

End-to-end smoke-tested with fake values: cargo binary contains
the baked IDs in its .rodata segment (verifiable via
`strings target/release/marathon-mail-oauth | grep <fake-id>`).
---
 .../build-marathon-mail-oauth-apk.sh          | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/marathon-extras/build-marathon-mail-oauth-apk.sh b/marathon-extras/build-marathon-mail-oauth-apk.sh
index cf46ccb..c43288c 100755
--- a/marathon-extras/build-marathon-mail-oauth-apk.sh
+++ b/marathon-extras/build-marathon-mail-oauth-apk.sh
@@ -43,6 +43,27 @@ if [ -n "$MARATHON_SHELL_SRC" ]; then
     SHELL_MOUNT_ARGS=(-v "$MARATHON_SHELL_SRC:/shellsrc:z,ro")
 fi
 
+# Per-deployment OAuth client IDs. Source oauth-clients.env if the
+# project maintainer has copied + filled in the .example template;
+# otherwise build a community apk that emits oauth_not_configured at
+# runtime. Either way is fine — see docs/MAIL_OAUTH_REGISTRATION.md.
+GOOGLE_CID=""
+MS_CID=""
+OAUTH_ENV_FILE=""
+if [ -n "$MARATHON_SHELL_SRC" ] && \
+   [ -f "$MARATHON_SHELL_SRC/tools/marathon-mail-oauth/oauth-clients.env" ]; then
+    OAUTH_ENV_FILE="$MARATHON_SHELL_SRC/tools/marathon-mail-oauth/oauth-clients.env"
+    # shellcheck disable=SC1090
+    . "$OAUTH_ENV_FILE"
+    GOOGLE_CID="${MARATHON_DEFAULT_GOOGLE_CLIENT_ID:-}"
+    MS_CID="${MARATHON_DEFAULT_MICROSOFT_CLIENT_ID:-}"
+fi
+if [ -n "$GOOGLE_CID" ] || [ -n "$MS_CID" ]; then
+    echo "oauth bake: gmail=$([ -n "$GOOGLE_CID" ] && echo set || echo unset), microsoft=$([ -n "$MS_CID" ] && echo set || echo unset)"
+else
+    echo "oauth bake: none — community apk (set via $MARATHON_SHELL_SRC/tools/marathon-mail-oauth/oauth-clients.env if you want IDs baked)"
+fi
+
 # --net=host is needed because `options="net"` in the APKBUILD tells
 # abuild to allow network in build() (cargo fetch). Without --net=host
 # abuild still tries to use its own networking but inside the rootless
@@ -56,6 +77,8 @@ podman run --rm -i \
     -e PKGVER="$PKGVER" \
     -e PKGREL="$PKGREL" \
     -e TARGET="$TARGET" \
+    -e MARATHON_DEFAULT_GOOGLE_CLIENT_ID="$GOOGLE_CID" \
+    -e MARATHON_DEFAULT_MICROSOFT_CLIENT_ID="$MS_CID" \
     -v "$APORTS_SRC:/aports-src:z,ro" \
     -v "$MKOSI_PKG_DIR:/out:z" \
     "${SHELL_MOUNT_ARGS[@]}" \
-- 
