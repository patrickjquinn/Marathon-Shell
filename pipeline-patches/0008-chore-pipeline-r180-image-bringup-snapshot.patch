diff --git a/scripts/build-image.py b/scripts/build-image.py
index f1234a0..954aa95 100755
--- a/scripts/build-image.py
+++ b/scripts/build-image.py
@@ -85,6 +85,62 @@ def build_image(components: List[str], extra_args: List[str]):
 
         subprocess.run(mkosi_cmd, check=True)
 
+        # Pi 5 BootROM on shipped CM5 EEPROMs reads MBR, not GPT. mkosi emits
+        # a pure GPT layout (protective MBR slot 1 is type 0xEE, no bootable
+        # flag), which the BootROM silently ignores. Even a *hybrid* MBR
+        # didn't boot reliably — some EEPROM revisions peek at LBA 1 for
+        # the GPT primary header and treat the disk as GPT-only when found.
+        # Force pure MBR: wipe GPT headers + write a clean MBR via sfdisk.
+        #
+        # Trade-off: we lose systemd-gpt-auto-generator's auto-discovery,
+        # so we ALSO need the rootfs filesystem to carry a `pmOS_root` FS
+        # label (set via SYSTEMD_REPART_MKFS_OPTIONS_EXT4 in mkosi.conf).
+        # postmarketos-mkinitfs's init.sh looks for it via `blkid --label`.
+        # See [[duranium-pi5-boot-recipe]] for the full stack.
+        if device_name.startswith("raspberry-pi") or device_name.startswith("rpi"):
+            raw_path = os.path.join(
+                "mkosi.output", image_id,
+                f"{image_id}_{open('mkosi.version').read().strip()}.raw"
+            )
+            if not os.path.exists(raw_path):
+                print(f"warning: expected raw output not found at {raw_path}; skipping Pi MBR step")
+            else:
+                print(f"Pi: converting {raw_path} GPT → pure MBR")
+                # Read the image as a file we can seek into. Don't loop-mount
+                # since sfdisk expects a real device-or-image arg.
+                # 1. Wipe GPT primary header + partition table at LBA 1..33.
+                # 2. Wipe GPT backup header at last 33 sectors of the data range.
+                # 3. Write a clean MBR partition table via sfdisk (preserves
+                #    the boot code in bytes 0..445).
+                with open(raw_path, "r+b") as f:
+                    # GPT primary header is at LBA 1; partition table at LBA 2..33.
+                    f.seek(1 * 512); f.write(b"\x00" * (33 * 512))
+                # mkosi sizes the disk to the end of the last partition + 1 MiB.
+                # GPT backup header lives in the last 33 sectors.
+                raw_size = os.path.getsize(raw_path)
+                # Don't read raw_size into Python — just compute the offset.
+                backup_offset = raw_size - (33 * 512)
+                with open(raw_path, "r+b") as f:
+                    f.seek(backup_offset); f.write(b"\x00" * (33 * 512))
+                # Rewrite the MBR. The two partitions are at known LBA ranges
+                # because mkosi.repart is deterministic: ESP 2048..2099199 (1 GiB),
+                # root 2099200..(2099200+10485760-1) (5 GiB). Type 0x0e is
+                # FAT16 LBA (matches the FAT16 ESP forced via mkosi.conf).
+                # Type 0x83 is plain Linux.
+                sfdisk_input = (
+                    "label: dos\n"
+                    "unit: sectors\n"
+                    "\n"
+                    "start=2048,    size=2097152,  type=e, bootable\n"
+                    "start=2099200, size=10485760, type=83\n"
+                )
+                subprocess.run(
+                    ["sfdisk", "--no-reread", "--no-tell-kernel", raw_path],
+                    input=sfdisk_input.encode(),
+                    check=True,
+                )
+                print("Pi: pure MBR written (bootable FAT16 LBA + Linux ext4)")
+
         duration = time.time() - start_time
         print(f"Built device: {device}, ui: {ui}, release: {release} in {duration}s")
         return
