+# pmOS edge regression chain that broke Pi 5 Marathon builds mid-Jun 2026:
+#   1. pmOS edge commented out `layout=bls` in /usr/lib/kernel/install.conf.
+#      Result: systemd-kernel-install's 90-loaderentry hook exits silently
+#      without writing /boot/loader/entries/*.conf when the kernel is
+#      installed by apk.
+#   2. duranium's mkosi.skeleton/in-pmbootstrap drops the /in-pmbootstrap
+#      marker. The postmarketos-mkinitfs apk trigger short-circuits when
+#      it sees the marker, so no initrd is written under /boot/$device/.
+#   3. mkosi.finalize's Pi-firmware path (commit 95cd8ba) then can't find
+#      either loader/entries OR initrd, so the ESP ends up without
+#      /initramfs-rpi and the Pi BootROM has nothing to load post-kernel.
+# Repair the chain here: restore layout=bls, drop the in-pmbootstrap
+# marker, re-invoke kernel-install for the kernel that's already on disk.
+if [ -f "$BUILDROOT/usr/lib/kernel/install.conf" ]; then
+    sed -i 's/^#\s*layout=.*/layout=bls/' "$BUILDROOT/usr/lib/kernel/install.conf"
+    grep -q '^layout=bls' "$BUILDROOT/usr/lib/kernel/install.conf" \
+        || echo "layout=bls" >> "$BUILDROOT/usr/lib/kernel/install.conf"
+fi
+rm -f "$BUILDROOT/in-pmbootstrap"
+# Debug: show what we see in /usr/lib/modules at postinst time. Earlier
+# runs silently no-op'd the mkinitfs block because KVER was empty; the
+# echo below pinpoints whether the dir is missing, empty, or contains
+# the kernel modules we expect.
+echo "POSTINST-DEBUG: ls /buildroot/usr/lib/modules/ = $(ls "$BUILDROOT/usr/lib/modules/" 2>&1 || echo ENOENT)"
+KVER=$(ls "$BUILDROOT/usr/lib/modules/" 2>/dev/null | head -1)
+echo "POSTINST-DEBUG: KVER=[$KVER]"
