diff --git a/marathon-extras/build-and-boot-phaseB.sh b/marathon-extras/build-and-boot-phaseB.sh
index ac913f3..187fca8 100755
--- a/marathon-extras/build-and-boot-phaseB.sh
+++ b/marathon-extras/build-and-boot-phaseB.sh
@@ -35,7 +35,16 @@ IMG="$(ls -1t "$OUT_BASE"/qemu-aarch64_marathon_edge_*.raw 2>/dev/null \
 [ -z "$IMG" ] && { echo "no raw image found" >&2; exit 1; }
 echo "==> image: $IMG"
 
-qemu-img resize -f raw -q "$IMG" 20G 2>/dev/null || true
+# Pad the raw out to 20G ONLY for QEMU runs -- the guest disk needs slack to
+# grow (var, /home, journal, etc) and mkosi's 6.4G output would fill instantly.
+# Skip when BUILD_FOR_SD=1: SD card flashes don't need the padding (dd would
+# write 14G of zeros for nothing) and we shouldn't be leaving 20G-apparent
+# sparse files around in the cache for daily SD-flash workflows.
+if [ "${BUILD_FOR_SD:-0}" != "1" ]; then
+    qemu-img resize -f raw -q "$IMG" 20G 2>/dev/null || true
+else
+    echo "==> BUILD_FOR_SD=1: skipping 20G resize (raw stays at mkosi's native size)"
+fi
 
 cp /usr/share/edk2/aarch64/QEMU_EFI-qemuvars-pflash.qcow2 "$EFI_VARS"
 rm -f "$SERIAL" "$MONITOR" "$QMP"
