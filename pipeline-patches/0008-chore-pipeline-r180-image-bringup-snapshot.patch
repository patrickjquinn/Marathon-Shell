diff --git a/mkosi.conf b/mkosi.conf
index a623a8c..6d81ebc 100644
--- a/mkosi.conf
+++ b/mkosi.conf
@@ -20,7 +20,24 @@ Incremental=no
 ToolsTreePackages=
 	erofs-utils
 	ukify
+	# binutils for objcopy: mkosi.finalize extracts UKI .linux + .initrd
+	# sections to /boot/kernel_2712.img + /boot/initramfs_2712 for Pi
+	# firmware boot (no UEFI on Pi 5, so the UKI itself isn't loaded —
+	# we ship the extracted sections instead).
+	binutils
 Environment=SYSTEMD_REPART_MKFS_OPTIONS_EROFS="-b 4096"
+# Pi 5 BootROM on shipped CM5 EEPROMs reads FAT16 reliably; FAT32 on this
+# hardware is silently rejected. Working pmbootstrap reference image uses
+# FAT16. mkfs.vfat defaults to FAT32 for partitions > 16 MB, so force FAT16
+# with 32 KB clusters (1 GB / 32 KB = 32768 clusters, within FAT16's 65525
+# limit). `-n pmOS_boot` sets the FS label so the postmarketos-mkinitfs
+# init script's `find_partition` (uses blkid --label) can locate it.
+# Pairs with the hybrid-MBR injection in scripts/build-image.py.
+Environment=SYSTEMD_REPART_MKFS_OPTIONS_VFAT="-F 16 -s 64 -n pmOS_boot"
+# Mirror for the ext4 root: FS label = pmOS_root for blkid --label
+# discovery. systemd-repart's Label= directive sets the GPT partition
+# entry name, not the filesystem label — those are separate.
+Environment=SYSTEMD_REPART_MKFS_OPTIONS_EXT4="-L pmOS_root"
 
 [Output]
 OutputDirectory=mkosi.output/%i
diff --git a/mkosi.extra/etc/kernel/install.conf b/mkosi.extra/etc/kernel/install.conf
new file mode 100644
index 0000000..fdcd568
--- /dev/null
+++ b/mkosi.extra/etc/kernel/install.conf
@@ -0,0 +1,6 @@
+# Marathon override — pmOS edge ships /usr/lib/kernel/install.conf with
+# layout=bls commented out. That breaks systemd-kernel-install's
+# 90-loaderentry hook (no /boot/loader/entries written) and the whole
+# downstream initramfs deployment pipeline. /etc takes precedence over
+# /usr/lib, so this restores the expected behavior at kernel-install time.
+layout=bls
