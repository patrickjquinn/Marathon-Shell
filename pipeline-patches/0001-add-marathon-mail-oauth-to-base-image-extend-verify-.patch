diff --git a/marathon-extras/verify-dynamic.sh b/marathon-extras/verify-dynamic.sh
new file mode 100644
index 0000000..c6924b3
--- /dev/null
+++ b/marathon-extras/verify-dynamic.sh
@@ -0,0 +1,156 @@
+#!/usr/bin/env bash
+# Dynamic lifecycle verification. Runs as root over SSH; drives the
+# shell over DBus to launch apps, then inspects per-app cgroup + oom
+# state for each. Tests the Foreground / BackgroundActive / BackgroundIdle
+# / Frozen transitions wired in Phase A+B.
+set -u
+
+USER_NAME="$(cat /etc/default_user 2>/dev/null || echo user)"
+USER_UID="$(id -u "$USER_NAME")"
+APPS_ROOT="/sys/fs/cgroup/user.slice/user-${USER_UID}.slice/user@${USER_UID}.service/marathon.slice/marathon-apps"
+
+PASS=0; FAIL=0
+ok()   { echo "✓ $*"; PASS=$((PASS+1)); }
+fail() { echo "✗ $*"; FAIL=$((FAIL+1)); }
+
+dbus_launch() {
+    local app="$1"
+    # Need the user's runtime dir + bus. su -s shell doesn't set them.
+    su -s /bin/sh "$USER_NAME" -c "
+        export XDG_RUNTIME_DIR=/run/user/${USER_UID}
+        export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus
+        busctl --user call \
+            org.marathonos.Shell /org/marathonos/Shell/Navigation \
+            org.marathonos.Shell.Navigation1 LaunchApp s '$app' 2>&1
+    "
+}
+
+show_app() {
+    local appid="$1"
+    local cg="$APPS_ROOT/marathon-app-$appid"
+    if [ ! -d "$cg" ]; then
+        printf "  %-12s cgroup MISSING\n" "$appid"
+        return 1
+    fi
+    local freeze; freeze="$(cat "$cg/cgroup.freeze" 2>/dev/null || echo '?')"
+    local pids;   pids="$(grep -c . "$cg/cgroup.procs" 2>/dev/null || echo 0)"
+    local pid;    pid="$(head -1 "$cg/cgroup.procs" 2>/dev/null)"
+    local oom='-'
+    [ -n "$pid" ] && oom="$(cat /proc/$pid/oom_score_adj 2>/dev/null || echo '?')"
+    printf "  %-12s pid=%s pids=%s freeze=%s oom_score_adj=%s\n" \
+        "$appid" "${pid:--}" "$pids" "$freeze" "$oom"
+}
+
+echo "== Dynamic lifecycle exercise =="
+echo "apps_root: $APPS_ROOT"
+test -d "$APPS_ROOT" && ok "apps_root exists pre-launch" \
+                     || fail "apps_root missing (CgroupManager init failed?)"
+
+echo
+echo "-- launching calculator --"
+dbus_launch calculator
+sleep 8
+ls "$APPS_ROOT" 2>/dev/null
+show_app calculator
+
+echo
+echo "-- launching music (calculator should demote to BackgroundIdle) --"
+dbus_launch music
+sleep 4
+echo "right after switch (calculator should be BgIdle, music Foreground):"
+show_app calculator; show_app music
+
+echo
+echo "-- waiting 12s for 10s idle-freeze debounce + slack --"
+sleep 12
+echo "after debounce:"
+show_app calculator; show_app music
+
+echo
+echo "-- bringing calculator back (should thaw + Foreground) --"
+dbus_launch calculator
+sleep 4
+echo "after re-foreground:"
+show_app calculator; show_app music
+
+echo
+echo "-- capability-protection test --"
+# Launch music + claim audio-playback via DBus (simulates what the
+# BackgroundTaskObserver would do automatically when MPRIS2 reports
+# isPlaying=true). MARATHON_TEST_TRUSTED admits us so we can poke
+# AppLifecycle directly.
+echo "claiming audio-playback for music…"
+HANDLE_LINE="$(su -s /bin/sh "$USER_NAME" -c "
+    export XDG_RUNTIME_DIR=/run/user/${USER_UID}
+    export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus
+    busctl --user call \
+        org.marathonos.Shell /org/marathonos/Shell/AppLifecycle \
+        org.marathonos.Shell.AppLifecycle1 \
+        BeginBackgroundTask ss audio-playback 'qemu-verify' 2>&1
+")"
+echo "begin reply: $HANDLE_LINE"
+HANDLE=$(echo "$HANDLE_LINE" | awk '/^u / {print $2}')
+echo "handle: ${HANDLE:-<none>}"
+if [ -z "$HANDLE" ]; then
+    fail "BeginBackgroundTask returned no handle"
+else
+    ok "BeginBackgroundTask returned handle=$HANDLE"
+    echo "switching to calculator so music goes background WITH capability…"
+    dbus_launch calculator
+    sleep 12
+    echo "after 12s (music should NOT freeze because audio-playback is held):"
+    show_app music; show_app calculator
+    M_FREEZE=$(cat "$APPS_ROOT/marathon-app-music/cgroup.freeze" 2>/dev/null || echo '?')
+    if [ "$M_FREEZE" = "0" ]; then
+        ok "music NOT frozen with audio-playback held (BackgroundActive protection works)"
+    else
+        fail "music freeze=$M_FREEZE while audio-playback held — protection broken"
+    fi
+    echo "releasing audio-playback…"
+    su -s /bin/sh "$USER_NAME" -c "
+        export XDG_RUNTIME_DIR=/run/user/${USER_UID}
+        export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus
+        busctl --user call \
+            org.marathonos.Shell /org/marathonos/Shell/AppLifecycle \
+            org.marathonos.Shell.AppLifecycle1 \
+            EndBackgroundTask u $HANDLE 2>&1
+    "
+    echo "waiting 12s for music to drop to BgIdle and freeze…"
+    sleep 12
+    show_app music; show_app calculator
+    M2_FREEZE=$(cat "$APPS_ROOT/marathon-app-music/cgroup.freeze" 2>/dev/null || echo '?')
+    if [ "$M2_FREEZE" = "1" ]; then
+        ok "music froze after capability released (state machine routes correctly)"
+    else
+        fail "music freeze=$M2_FREEZE after release — debounce or transition broken"
+    fi
+fi
+
+echo
+echo "-- manifest-gate test (music declaring active-call must be rejected) --"
+DENY=$(su -s /bin/sh "$USER_NAME" -c "
+    export XDG_RUNTIME_DIR=/run/user/${USER_UID}
+    export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus
+    busctl --user call \
+        org.marathonos.Shell /org/marathonos/Shell/AppLifecycle \
+        org.marathonos.Shell.AppLifecycle1 \
+        BeginBackgroundTask ss active-call 'qemu-verify' 2>&1
+")"
+echo "$DENY"
+case "$DENY" in
+    *AccessDenied*|*"not declared in manifest"*)
+        ok "manifest gate rejected unauthorized category" ;;
+    *)
+        fail "manifest gate should have rejected unauthorized category" ;;
+esac
+
+echo
+echo "-- all per-app cgroups --"
+for d in "$APPS_ROOT"/*/; do
+    [ -d "$d" ] || continue
+    show_app "$(basename "$d" | sed 's/^marathon-app-//')"
+done
+
+echo
+echo "== summary: ${PASS} pass / ${FAIL} fail =="
+[ "$FAIL" -eq 0 ]
diff --git a/marathon-extras/verify-lifecycle.sh b/marathon-extras/verify-lifecycle.sh
new file mode 100755
index 0000000..52f0cdd
--- /dev/null
+++ b/marathon-extras/verify-lifecycle.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# Verify Phase A+B lifecycle stack on a booted duranium image.
+# Runs as root over SSH; resolves the marathon user via /etc/default_user
+# and reads cgroups via the actual shell PID (TASK_COMM_LEN=16 makes
+# `pgrep -x marathon-shell-bin` miss the truncated comm — use -f).
+set -u
+PASS=0; FAIL=0
+check() {
+    local label="$1"; shift
+    if "$@" >/dev/null 2>&1; then
+        echo "✓ $label"; PASS=$((PASS+1))
+    else
+        echo "✗ $label"; FAIL=$((FAIL+1))
+    fi
+}
+
+# /etc/default_user → marathon user. UID is what user@<uid>.service uses.
+MARATHON_USER="$(cat /etc/default_user 2>/dev/null || echo user)"
+MARATHON_UID="$(id -u "$MARATHON_USER" 2>/dev/null || echo 0)"
+CG_BASE="/sys/fs/cgroup/user.slice/user-${MARATHON_UID}.slice/user@${MARATHON_UID}.service"
+
+echo "== Marathon lifecycle / freezer verification =="
+echo "user:    $MARATHON_USER (uid $MARATHON_UID)"
+echo "cgroup:  $CG_BASE"
+echo
+
+echo "-- slice + shell placement --"
+check "user@${MARATHON_UID}.service cgroup exists"    test -d "$CG_BASE"
+# pgrep -f matches against the full cmdline so we don't get bitten by
+# TASK_COMM_LEN truncation that hides 'marathon-shell-bin' from -x.
+SHELL_PID="$(pgrep -f '^/usr/bin/marathon-shell-bin' | head -1)"
+echo "shell pid: ${SHELL_PID:-<none>}"
+check "marathon-shell-bin process found"             test -n "${SHELL_PID:-}"
+if [ -n "${SHELL_PID:-}" ]; then
+    SHELL_CG="$(awk -F: '/^0::/ {print $3}' /proc/${SHELL_PID}/cgroup)"
+    echo "shell cgroup: ${SHELL_CG}"
+    case "$SHELL_CG" in
+      */marathon.slice/*) echo "✓ shell lives in marathon.slice"; PASS=$((PASS+1)) ;;
+      *) echo "✗ shell NOT in marathon.slice (got: $SHELL_CG)"; FAIL=$((FAIL+1)) ;;
+    esac
+fi
+
+SLICE_CG="$CG_BASE/marathon.slice"
+check "marathon.slice cgroup dir present"             test -d "$SLICE_CG"
+APPS_ROOT=""
+if [ -d "$SLICE_CG" ]; then
+    SHELL_SCOPE="$(ls -d "$SLICE_CG"/marathon-shell-*.scope 2>/dev/null | head -1 || true)"
+    echo "shell scope: ${SHELL_SCOPE:-<none>}"
+    check "shell scope dir present"                   test -n "${SHELL_SCOPE:-}"
+    # CgroupManager creates marathon-apps as a SIBLING of the shell scope
+    # under marathon.slice (cleaner than nesting it under the shell scope,
+    # which hits a permission race and the cgroup v2 no-internal-processes
+    # rule).
+    APPS_ROOT="${SLICE_CG}/marathon-apps"
+    check "marathon-apps sibling root (Delegate=yes worked)" test -d "$APPS_ROOT"
+    echo "apps root:   ${APPS_ROOT}"
+fi
+
+echo
+echo "-- per-app cgroups --"
+if [ -n "${APPS_ROOT:-}" ] && [ -d "$APPS_ROOT" ]; then
+    found=0
+    for d in "$APPS_ROOT"/*/; do
+        [ -d "$d" ] || continue
+        found=1
+        name="$(basename "$d")"
+        freeze="$(cat "$d/cgroup.freeze" 2>/dev/null || echo '?')"
+        procs="$(wc -l < "$d/cgroup.procs" 2>/dev/null || echo 0)"
+        printf "  %-32s freeze=%s pids=%s\n" "$name" "$freeze" "$procs"
+    done
+    [ "$found" = 0 ] && echo "  (no apps launched yet — directory empty)"
+else
+    echo "  (no marathon-apps root visible — Delegate=yes probably not applied)"
+fi
+
+echo
+echo "-- lifecycle log (last 30 marathon.lifecycle events) --"
+journalctl --no-pager -t marathon-shell-bin --since "10 minutes ago" 2>/dev/null \
+  | grep -E 'marathon\.lifecycle' | tail -30 || true
+journalctl --user-machine="${MARATHON_UID}@.host" --no-pager --since "10 minutes ago" 2>/dev/null \
+  | grep -E 'marathon\.lifecycle' | tail -30 || true
+
+echo
+echo "-- oom_score_adj per running app --"
+APP_PIDS="$(pgrep -f '^/usr/bin/marathon-app-runner' || true)"
+if [ -z "$APP_PIDS" ]; then
+    echo "  (no app-runners — nothing has been launched yet)"
+else
+    for pid in $APP_PIDS; do
+        cmdline="$(tr '\0' ' ' </proc/$pid/cmdline 2>/dev/null)"
+        appid="$(echo "$cmdline" | grep -oE -- '--app-id [^ ]+' | awk '{print $2}')"
+        score="$(cat /proc/$pid/oom_score_adj 2>/dev/null || echo '?')"
+        printf "  pid=%-7s appId=%-14s oom_score_adj=%s\n" "$pid" "${appid:-?}" "$score"
+    done
+fi
+
+echo
+echo "-- PSI memory pressure --"
+if [ -r /proc/pressure/memory ]; then
+    grep '^some' /proc/pressure/memory
+    check "PSI memory readable" true
+else
+    echo "✗ /proc/pressure/memory not readable"; FAIL=$((FAIL+1))
+fi
+
+echo
+echo "== summary: ${PASS} pass / ${FAIL} fail =="
+[ "$FAIL" -eq 0 ]
diff --git a/marathon-extras/verify-mail.sh b/marathon-extras/verify-mail.sh
new file mode 100755
index 0000000..fec39b1
--- /dev/null
+++ b/marathon-extras/verify-mail.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# Marathon Mail verification harness — runs inside the QEMU guest.
+#
+# Runs as ROOT over the QEMU SSH path (boot-and-verify-mail.sh logs in
+# as root with the documented `marathon` password). To query / drive
+# `user`'s user-systemd we use systemctl's --machine=user@.host --user
+# bus cross-over rather than dropping uid (sshpass-as-user isn't set
+# up on the QEMU image; only root has a password).
+#
+# Exit codes (parsed by callers):
+#   0  all checks pass
+#   1  qmf-libs / messageserver missing
+#   2  marathon-mailserver.service not loaded
+#   3  messageserver fails to start
+#   4  ldd reports missing shared lib (the most likely musl gotcha)
+#   5  user@1000.service is not active (auto-login + linger both failed)
+
+set -u
+RC=0
+say()  { printf '  %s\n' "$1"; }
+fail() { echo "FAIL: $1" >&2; RC=$2; }
+
+# Helper — same string both times.
+USER_BUS='systemctl --machine=user@.host --user'
+
+echo "==> 1. QMF artefacts on disk"
+test -f /usr/lib/libQmfClient.so.4.0.4         && say "libQmfClient.so.4.0.4 ✓"        || fail "libQmfClient missing"          1
+test -f /usr/lib/libQmfMessageServer.so.4.0.4  && say "libQmfMessageServer.so.4.0.4 ✓" || fail "libQmfMessageServer missing"   1
+test -x /usr/bin/messageserver                 && say "/usr/bin/messageserver ✓"      || fail "messageserver binary missing"  1
+
+echo "==> 2. Plugin directories present"
+ls -1d /usr/lib/qt6/plugins/messagingframework/messageservices 2>/dev/null | head -1 \
+    && say "messageservices/ ✓" \
+    || fail "messageservices plugin dir missing" 1
+ls -1d /usr/lib/qt6/plugins/messagingframework/contentmanagers 2>/dev/null | head -1 \
+    && say "contentmanagers/ ✓" \
+    || fail "contentmanagers plugin dir missing" 1
+
+echo "==> 2b. Marathon credential plugins + QML module"
+test -f /usr/lib/qt6/plugins/messagingframework/credentials/libmarathonoauth.so \
+    && say "marathonoauth credential plugin ✓" \
+    || fail "marathonoauth.so missing" 1
+test -f /usr/lib/qt6/plugins/messagingframework/credentials/libmarathonclassic.so \
+    && say "marathonclassic credential plugin ✓" \
+    || fail "marathonclassic.so missing" 1
+test -f /usr/lib/qt6/qml/MarathonOS/Services/qmldir \
+    && say "MarathonOS.Services qmldir ✓" \
+    || fail "MarathonOS.Services qmldir missing" 1
+test -x /usr/bin/marathon-mail-oauth \
+    && say "marathon-mail-oauth helper ✓" \
+    || fail "marathon-mail-oauth helper missing" 1
+
+echo "==> 2c. marathon-mail-oauth helper smoke check"
+# Run with the permission gate explicitly cleared so the helper exits
+# with its structured "permission_denied" envelope rather than touching
+# Secret-Service. Confirms the binary loads cleanly under musl + the
+# clap CLI parser is wired up.
+if HELPER_OUT=$(env -u MARATHON_PERM_SECRET_SERVICE /usr/bin/marathon-mail-oauth token \
+        --account-id smoke-test 2>&1); then
+    say "marathon-mail-oauth unexpectedly succeeded without permission gate"
+elif echo "$HELPER_OUT" | grep -q 'permission_denied'; then
+    say "marathon-mail-oauth refuses without permission gate ✓"
+else
+    fail "marathon-mail-oauth produced unexpected output: $HELPER_OUT" 1
+fi
+
+echo "==> 3. Shared-library resolution under musl"
+LDD_BAD="$(ldd /usr/bin/messageserver 2>&1 | grep -E 'not found|undefined' || true)"
+if [ -z "$LDD_BAD" ]; then
+    say "ldd messageserver clean ✓"
+else
+    fail "ldd reports missing deps:" 4
+    echo "$LDD_BAD" >&2
+fi
+
+echo "==> 4. user@1000.service is active (precondition for --user work)"
+if systemctl is-active --quiet user@1000.service; then
+    say "user@1000.service active ✓"
+else
+    fail "user@1000.service not active — auto-login did not bring up user session" 5
+    systemctl status user@1000.service --no-pager 2>&1 | head -10 >&2
+fi
+
+echo "==> 5. marathon-mailserver.service is registered in user manager"
+if $USER_BUS list-unit-files marathon-mailserver.service 2>/dev/null | grep -q marathon-mailserver.service; then
+    say "marathon-mailserver.service registered ✓"
+else
+    fail "marathon-mailserver.service NOT in user manager" 2
+    $USER_BUS list-unit-files 2>&1 | tail -10 >&2
+fi
+
+echo "==> 6. messageserver dry-launch (5 second window)"
+$USER_BUS start marathon-mailserver.service 2>/dev/null || true
+sleep 5
+if $USER_BUS is-active --quiet marathon-mailserver.service; then
+    say "marathon-mailserver.service active ✓"
+    journalctl --machine=user@.host --user-unit marathon-mailserver.service --no-pager --since "10 seconds ago" 2>/dev/null \
+        | tail -10 | sed 's/^/    /' || true
+else
+    fail "marathon-mailserver.service failed to stay running" 3
+    journalctl --machine=user@.host --user-unit marathon-mailserver.service --no-pager --since "1 minute ago" 2>/dev/null \
+        | tail -15 | sed 's/^/    /' >&2 || true
+fi
+
+echo "==> 7. Tear-down"
+$USER_BUS stop marathon-mailserver.service 2>/dev/null || true
+
+echo "==> done (rc=$RC)"
+exit $RC
