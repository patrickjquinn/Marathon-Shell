+        // here and replicate the lift/press behaviour ourselves. Radius is
+        // the system "small" token (4px); the rest of Marathon (Calculator,
+        // Calendar cards, lists) uses Sharp/Small, not iOS-style 16-22px.
+        Rectangle {
+            id: aotd
