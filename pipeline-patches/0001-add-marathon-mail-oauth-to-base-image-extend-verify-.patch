index 0000000..72c95d2
--- /dev/null
+++ b/marathon-extras/marathon-store-handler
@@ -0,0 +1,115 @@
+#!/bin/bash
+# Marathon App Store URL-scheme handler.
+#
+# Invoked via xdg-open marathon-store://<verb>/<arg>. The verb-arg pairs are
+# strictly enumerated; anything else is rejected before we touch flatpak.
+#
+# Security:
+#   - Refs match a strict RDN regex (Flathub appstream-id shape) and reject any
+#     '..' substring to defeat path-traversal in the state file name.
+#   - The only remote we talk to is 'flathub'.
+#   - flatpak is invoked via exec with a fixed argv — no user input ever reaches
+#     a shell. State files are written atomically (write-then-rename).
+#   - Per-appid state files prevent concurrent installs from racing each other.
+set -euo pipefail
+
+REF_RE='^[A-Za-z][A-Za-z0-9]*(\.[A-Za-z0-9][A-Za-z0-9_-]*)+$'
+REMOTE=flathub
+RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+STATE_DIR="$RUNTIME_DIR/marathon-store-state"
+mkdir -p "$STATE_DIR"
+
+url=${1:-}
+verb=$(printf '%s\n' "$url" | sed -n 's|^marathon-store://\([^/]*\)/.*|\1|p')
+arg=$(printf '%s\n' "$url" | sed -n 's|^marathon-store://[^/]*/\(.*\)$|\1|p')
+
+if [ -z "$verb" ]; then
+    printf 'marathon-store-handler: bad url: %s\n' "$url" >&2
+    exit 2
+fi
+
+case "$verb" in
+    install|update|uninstall|open|refresh-state|update-all) ;;
+    *)
+        printf 'marathon-store-handler: unknown verb: %s\n' "$verb" >&2
+        exit 2
+        ;;
+esac
+
+if [ "$verb" != "refresh-state" ] && [ "$verb" != "update-all" ]; then
+    case "$arg" in
+        *..*)
+            printf 'marathon-store-handler: rejecting traversal: %s\n' "$arg" >&2
+            exit 3
+            ;;
+    esac
+    if ! printf '%s' "$arg" | grep -qE "$REF_RE"; then
+        printf 'marathon-store-handler: rejecting ref: %s\n' "$arg" >&2
+        exit 3
+    fi
+fi
+
+write_state() {
+    local appid=$1 state=$2 pct=$3
+    local target="$STATE_DIR/install-progress-${appid}.json"
+    local tmp
+    tmp=$(mktemp "${target}.XXXXXX")
+    printf '{"appId":"%s","state":"%s","percent":%s,"ts":%s}\n' \
+        "$appid" "$state" "$pct" "$(date +%s)" > "$tmp"
+    mv "$tmp" "$target"
+}
+
+run_flatpak_progress() {
+    local op=$1 appid=$2
+    write_state "$appid" pending -1
+    # --ostree-verbose unlocks the 'Receiving N%' progress lines. flatpak emits
+    # carriage-return-overwritten progress, so we tr \r -> \n to make it line-
+    # oriented before grepping percentages. PIPESTATUS[0] is the flatpak rc;
+    # we use bash so this is reliable.
+    flatpak --ostree-verbose --user "$op" -y --noninteractive "$REMOTE" "$appid" 2>&1 \
+        | tr '\r' '\n' \
+        | while IFS= read -r line; do
+            pct=$(printf '%s\n' "$line" | sed -n 's/.* \([0-9]\{1,3\}\)%.*/\1/p' | head -1)
+            case "$line" in
+                *Receiving*)              write_state "$appid" downloading "${pct:--1}" ;;
+                *Installing*|*Updating*)  write_state "$appid" downloading "${pct:--1}" ;;
+                *Deploying*|*Pulling*)    write_state "$appid" deploying "${pct:--1}" ;;
+                *Already*installed*)      write_state "$appid" done 100 ;;
+            esac
+        done
+    rc=${PIPESTATUS[0]}
+    if [ "$rc" = "0" ]; then
+        write_state "$appid" done 100
+    else
+        write_state "$appid" failed -1
+    fi
+    /usr/libexec/marathon-store-refresh-state || true
+}
+
+case "$verb" in
+    install)
+        # Detach so xdg-open returns immediately. No terminal window pops up;
+        # the QML polls per-appid state files for progress. arg has already
+        # been validated against REF_RE so no shell-meaningful characters
+        # can survive into this exec.
+        (run_flatpak_progress install "$arg" </dev/null >/dev/null 2>&1 &)
+        ;;
+    update)
+        (run_flatpak_progress update "$arg" </dev/null >/dev/null 2>&1 &)
+        ;;
+    uninstall)
+        flatpak --user uninstall -y "$arg" >/dev/null 2>&1 || true
+        write_state "$arg" done 0
+        /usr/libexec/marathon-store-refresh-state || true
+        ;;
+    update-all)
+        flatpak --user update -y --noninteractive >/dev/null 2>&1 || true
+        /usr/libexec/marathon-store-refresh-state || true
+        ;;
+    refresh-state)
+        exec /usr/libexec/marathon-store-refresh-state
+        ;;
+    open)
+        exec flatpak --user run "$arg"
+        ;;
+esac
diff --git a/marathon-extras/marathon-store-refresh-state b/marathon-extras/marathon-store-refresh-state
new file mode 100755
index 0000000..bc9f195
--- /dev/null
+++ b/marathon-extras/marathon-store-refresh-state
@@ -0,0 +1,54 @@
+#!/bin/bash
+# Marathon App Store state dumper. Emits two JSON files into XDG_RUNTIME_DIR
+# that StoreApp.qml reads. We never expose CLI output to QML directly — the
+# JSON is the contract. Strings are escaped via python3 because flatpak app
+# names can legitimately contain quotes, backslashes, and unicode.
+set -euo pipefail
+RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+STATE_DIR="$RUNTIME_DIR/marathon-store-state"
+mkdir -p "$STATE_DIR"
+
+json_string() {
+    python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
+}
+
+emit_installed() {
+    printf '{"installed":['
+    local first=1
+    while IFS=$'\t' read -r app_id version name; do
+        [ -z "$app_id" ] && continue
+        local icon="$HOME/.local/share/flatpak/exports/share/icons/hicolor/128x128/apps/$app_id.png"
+        [ -f "$icon" ] || icon=""
+        [ "$first" = 1 ] || printf ','
+        first=0
+        printf '{"app_id":%s,"name":%s,"version":%s,"icon":%s}' \
+            "$(json_string "$app_id")" \
+            "$(json_string "$name")" \
+            "$(json_string "$version")" \
+            "$(json_string "${icon:+file://$icon}")"
+    done < <(flatpak --user list --app --columns=application,version,name 2>/dev/null || true)
+    printf '],"ts":%s}\n' "$(date +%s)"
+}
+
+emit_updates() {
+    printf '{"updates":['
+    local first=1
+    # timeout — flatpak remote-ls can hang on flaky networks. 20s is generous
+    # for an updates-only query against flathub.
+    while read -r app_id; do
+        [ -z "$app_id" ] && continue
+        case "$app_id" in *.Locale|*.Sources|*.Debug) continue ;; esac
+        [ "$first" = 1 ] || printf ','
+        first=0
+        printf '{"app_id":%s}' "$(json_string "$app_id")"
+    done < <(timeout 20 flatpak --user remote-ls --updates --columns=application 2>/dev/null || true)
+    printf '],"ts":%s}\n' "$(date +%s)"
+}
+
+tmp_inst=$(mktemp "$STATE_DIR/installed.json.XXXXXX")
+emit_installed > "$tmp_inst"
+mv "$tmp_inst" "$STATE_DIR/installed.json"
+
+tmp_upd=$(mktemp "$STATE_DIR/updates.json.XXXXXX")
+emit_updates > "$tmp_upd"
+mv "$tmp_upd" "$STATE_DIR/updates.json"
