+                Rectangle {
+                    Layout.fillWidth: true
+                    Layout.margins: MSpacing.md
+                    Layout.preferredHeight: Math.round(88 * root.sf)
+                    radius: Constants.borderRadiusSmall
+                    color: MColors.bb10Elevated
