prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@KEEL_SECRETS_INCLUDEDIR@

Name: lib@KEEL_PC_NAME@
Description: Sailfish OS @_what@ API for Qt 6 (Keel build of sailfish-secrets)
Version: @KEEL_SECRETS_VERSION@
Requires: Qt6Core Qt6DBus
Libs: -L${libdir} -l@KEEL_PC_NAME@
Cflags: -I${includedir} -I${includedir}/@_what_cap@
