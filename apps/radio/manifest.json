{
  "manifestVersion": 1,
  "id": "radio",
  "name": "Radio",
  "version": "1.0.0",
  "description": "Listen to FM radio, with wired headphones as the aerial",
  "icon": "assets/icon.svg",
  "entryPoint": "RadioApp.qml",
  "categories": ["Entertainment"],
