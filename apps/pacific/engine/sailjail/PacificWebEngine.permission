# -*- mode: sh -*-
# SPDX-FileCopyrightText: 2026 Atlantic Browser contributors (atlantic-engine sailjail/atlantic-browser.permission)
# SPDX-FileCopyrightText: 2026 Patrick Quinn
# SPDX-License-Identifier: MPL-2.0
#
# Sailjail permission for apps that embed Pacific's WebKit engine
# (shipwright-pacific-engine). An app lists it with the standard ones in its
# .desktop file:
#
#   [X-Sailjail]
#   Permissions=Internet;Downloads;Pictures;Audio;Camera;Microphone;Location;PacificWebEngine
#
# Sailjail includes this after Base.permission. It adds only what the engine
# needs beyond those: its own files, the GPU and libhybris device nodes the
# WebProcess renders through, and the Wayland socket. Network, sound, the
# camera, location and the Downloads/Pictures folders come from their own
# permissions; the app's data and cache directories from OrganizationName
# and ApplicationName.

# x-sailjail-translation-catalog = sailjail-permissions
# x-sailjail-translation-key-description = permission-la-pacific-web-engine
# x-sailjail-description = Web content engine
# x-sailjail-translation-key-long-description = permission-la-pacific-web-engine_description
# x-sailjail-long-description = Render web pages with the GPU: the web engine's files and the graphics devices

# The engine: libraries, WebProcess/NetworkProcess, shims, environment.
noblacklist /opt/pacific
whitelist /opt/pacific
noblacklist /usr/libexec/pacific

# GPU and libhybris (Android HAL). Mali: /dev/mali0 and the DMA heaps;
# Atlantic's Adreno list kept for other phones.
noblacklist /dev/mali0
noblacklist /dev/dma_heap
noblacklist /dev/dri
noblacklist /dev/ion
noblacklist /dev/kgsl-3d0
noblacklist /dev/hwbinder
noblacklist /dev/binder
noblacklist /dev/vndbinder
noblacklist /dev/__properties__
noblacklist /odm
noblacklist /vendor/firmware_mnt
noblacklist /usr/libexec/droid-hybris

# Wayland: Lipstick's socket, /run/display, is already in every sandbox
# (WPEBackend-fdo's own socket lives in the app's runtime directory). Never
# whitelist anything under /run: Firejail then replaces /run with a tmpfs
# holding only the whitelisted entries, which hid systemd-resolved's
# resolv.conf (no DNS: "Temporary failure in name resolution" on the Jolla
# Phone), the system bus and the rest of /run.
