#
# Pacific asks for clock floors here (pacific-boostd.c); the daemon starts on
# the first request and exits a minute after the last.
[Unit]
Description=Pacific touch and scroll clock boost requests

[Socket]
ListenDatagram=@org.shipwright.pacific.boost
PassCredentials=yes
# Started at boot by the sockets.target.wants link the package installs.
