#
# Takes the clock floors pacific-boostd puts back, once at boot, before
# anyone touches the screen (pacific-boostd.c: some kernels raise the floor
# for a moment on every touch, and the daemon starts with a touch).
[Unit]
Description=Pacific touch boost: the clocks to put back
DefaultDependencies=no
Before=pacific-boost.socket sockets.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/pacific/pacific-boostd --baseline
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=pacific-boost
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/pacific-boost
# Started at boot by the sockets.target.wants link the package installs.
