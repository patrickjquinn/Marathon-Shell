#
# Pacific, the web browser, on Keel. /usr/bin/shipwright-pacific is the app
# binary (Sailjail starts only ELF programs); it re-execs itself through the
# engine's pacific-env (library path, WebKit and GPU settings), so
# booster-keel cannot be used: the environment must be set before the
# process starts. Sailjail
# permissions, each needed by a feature:
#   Internet          loading pages (and filter-list updates, suggestions)
#   Downloads         saving downloads to ~/Downloads
#   Pictures          saving images, uploading photos to pages
#   Audio             page audio and video
#   Camera Microphone pages that ask for them (asked per site)
#   Location          pages that ask for it (asked per site)
#   PacificWebEngine  the web engine's processes and GPU access (installed by
#                     shipwright-pacific-engine)
#   ShoalKeysAutofill filling and saving logins with Shoal Keys (installed by
#                     Shoal Keys; without it the login bar never appears)
# Default browser: the MIME types below, and org.shipwright.pacific.ui
# openUrl (src/dbus.rs), which Lipstick calls for a running instance.
# Profile data lives in ~/.local/share/org.shipwright/pacific and the cache
# in ~/.cache/org.shipwright/pacific.
[Desktop Entry]
Type=Application
Name=Pacific
Comment=Browse the web
Icon=shipwright-pacific
Exec=/usr/bin/shipwright-pacific %U
X-Nemo-Application-Type=no-invoker
X-Nemo-Single-Instance=yes
X-Maemo-Service=org.shipwright.pacific.ui
X-Maemo-Object-Path=/ui
X-Maemo-Method=org.shipwright.pacific.ui.openUrl
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;
Categories=Network;WebBrowser;

[X-Sailjail]
OrganizationName=org.shipwright
ApplicationName=pacific
Permissions=Internet;Downloads;Pictures;Audio;Camera;Microphone;Location;PacificWebEngine;ShoalKeysAutofill
ExecDBus=/usr/bin/shipwright-pacific --keel-actions
