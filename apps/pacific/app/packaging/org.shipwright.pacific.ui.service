#
# Starts Pacific when another app asks it to open a link, or the launcher
# opens it, and it is not running (src/dbus.rs), through Sailjail as the
# launcher would: as the prestart service, so there is one way it runs
# (shipwright-pacific-prestart.service).
[D-BUS Service]
Name=org.shipwright.pacific.ui
Exec=/usr/bin/sailjail -p shipwright-pacific.desktop /usr/bin/shipwright-pacific
SystemdService=shipwright-pacific-prestart.service
