{
  "manifestVersion": 1,
  "id": "shipwright-pacific",
  "name": "Pacific",
  "version": "0.1.0",
  "entryPoint": "ui/qml/shipwright-pacific.qml",
  "icon": "icons/shipwright-pacific.svg",
  "author": "Marathon OS",
  "description": "Browse the web",
  "dbus": { "talk": ["org.shipwright.shoal-keys.Autofill", "org.freedesktop.Tracker3.Miner.Files"], "own": ["org.shipwright.pacific.ui"] },
  "permissions": ["network", "storage", "location", "camera", "microphone", "notifications", "sensors"],
  "permissionReasons": {
    "storage": "Saves downloads to Downloads and lets pages upload your photos and files",
    "location": "Tells a website where you are, only when it asks and you allow it",
    "camera": "Lets a website use the camera for a video call or a photo, when you allow it",
    "microphone": "Lets a website hear you for a call or voice input, when you allow it"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Productivity"],
  "handlesUriSchemes": ["http", "https"],
  "defaultFor": ["browser"],
  "shareMethods": [
    { "name": "link", "title": "Open in Pacific", "mimeTypes": ["text/x-url", "text/plain"] }
  ],
  "searchKeywords": ["browser", "web", "internet", "search", "url", "bookmarks", "history", "pacific"],
  "deepLinks": {
    "new-tab": { "title": "New tab", "description": "Open a new tab in Pacific", "keywords": ["tab", "open"] },
    "private": { "title": "New private tab", "description": "Browse without keeping history", "keywords": ["incognito", "private"] },
    "bookmarks": { "title": "Bookmarks", "description": "Pages you saved in Pacific", "keywords": ["favourites", "saved"] },
    "history": { "title": "History", "description": "Pages you visited in Pacific", "keywords": ["visited", "recent"] },
    "downloads": { "title": "Downloads", "description": "Files you downloaded in Pacific", "keywords": ["files"] }
  },
  "backgroundCapabilities": ["download", "audio-playback"],
  "webEngine": "webkit",
  "environment": {
    "QSG_RHI_BACKEND": "opengl",
    "QML_NO_TOUCH_COMPRESSION": "1",
    "WEBKIT_GST_ENABLE_HLS_SUPPORT": "1",
    "JSC_numberOfFTLCompilerThreads": "2",
    "JSC_numberOfDFGCompilerThreads": "2",
    "JSC_numberOfBaselineCompilerThreads": "2",
    "JSC_numberOfGCMarkers": "2",
    "JSC_maxNumberOfWorklistThreads": "4",
    "WEBKIT_MEMORY_POLL_INTERVAL_MS": "3000",
    "WEBKIT_TEXTURE_POOL_CAP_MB": "64",
    "WEBKIT_URL_CACHE_DISK_CAPACITY_MB": "100",
    "WEBKIT_LOWRES_TILE_SCALE": "0.3",
    "WEBKIT_LOWRES_SCROLL_SPEED": "120",
    "WEBKIT_CHECKERBOARD_DURING_SCROLL": "800",
    "WEBKIT_CHECKERBOARD_SETTLE_MS": "200",
    "WEBKIT_COVER_AREA_MULTIPLIER": "2",
    "WEBKIT_LOWRES_COST_TRIGGER": "1",
    "WEBKIT_LOWRES_COST_BUDGET_MS": "11",
    "WEBKIT_LOWRES_SHARPEN_VIEWPORT_ONLY": "1",
    "WEBKIT_LOWRES_SHARPEN_MARGIN_PX": "512",
    "WEBKIT_NO_FAKE_MOUSE_MOVE": "1",
    "WEBKIT_FORCE_ASYNC_SCROLL": "1",
    "WEBKIT_INDEPENDENT_SCROLL": "1",
    "WEBKIT_KINETIC_DECEL_FRICTION": "2",
    "WEBKIT_SKIP_ROOT_CUSTOMPROP_REPAINT": "1",
    "WEBKIT_COMPOSITE_SKIP_LOCKED_LAYERS": "1",
    "WEBKIT_TILE_UPLOAD_BUDGET_MB": "6",
    "WEBKIT_TILE_UPLOAD_BUDGET_SCROLL_ONLY": "1",
    "WEBKIT_TILE_UPLOAD_SCROLL_SETTLE_MS": "800",
    "WEBKIT_TILE_UPLOAD_REST_BUDGET_MB": "16",
    "WEBKIT_LOADING_TIMER_ALIGNMENT_MS": "50",
    "WEBKIT_PARSER_TIME_LIMIT_MS": "100",
    "WEBKIT_TOUCH_ACK_TIMEOUT_MS": "100",
    "WEBKIT_SCROLLBAR_SCALE": "1",
    "WEBKIT_SCROLLBAR_SPRITE": "1",
    "WEBKIT_SCROLLBAR_SMOOTHING": "0.4",
    "WEBKIT_SCROLLBAR_NO_HOVER": "1",
    "WEBKIT_LAYERS_TILE_SIZE": "1024"
  },
  "testedOn": { "widths": [540, 720], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
