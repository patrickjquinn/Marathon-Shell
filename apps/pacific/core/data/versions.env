#
# Third-party data Pacific bundles at package time (shoal/pacific/rpm/prebuild.sh
# downloads and checks it; pacific-core reads the pins with include_str!).
# Idea and layout from Atlantic's versions.env (atlantic-engine, MPL-2.0).
#
# DuckDuckGo autoconsent (MPL-2.0): the self-initialising standalone build,
# dist/autoconsent.standalone.js, from the npm tarball. To bump: change the
# version, then re-pin both hashes (the tarball and the file inside it).
AUTOCONSENT_VERSION=16.45.0
AUTOCONSENT_URL=https://registry.npmjs.org/@duckduckgo/autoconsent/-/autoconsent-16.45.0.tgz
AUTOCONSENT_TGZ_SHA256=adc0ad9a880e594624e0960777c1bdfff11ddb117f72ffb9a4e876ecf3b12f0e
AUTOCONSENT_JS_SHA256=9315fe6073e4bed402200ea897e33183aced689479688ece4f5213579f001795

# Brave's adblock-resources (MPL-2.0): redirect surrogates and Brave's
# scriptlets, dist/resources.json at a pinned commit.
ADBLOCK_RESOURCES_COMMIT=6da9b247c3368baa8b4f24cd02046e18702a6527
ADBLOCK_RESOURCES_URL=https://raw.githubusercontent.com/brave/adblock-resources/6da9b247c3368baa8b4f24cd02046e18702a6527/dist/resources.json
ADBLOCK_RESOURCES_SHA256=d085eb0754b7a54d9e1a18a0314b1946b066f61a15457de834d98beb53b4e40f
