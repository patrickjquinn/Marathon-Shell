{
  "manifestVersion": 1,
  "id": "clock",
  "name": "Clock",
  "version": "1.0.0",
  "entryPoint": "ClockApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["notifications", "storage", "alarms"],
  "permissionReasons": {
    "storage": "Saves your world clocks, timers and stopwatch"
  },
  "backgroundCapabilities": ["countdown-timer"],
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Utility"],
  "handlesUriSchemes": [],
  "defaultFor": [],
  "searchKeywords": [
    "clock",
    "alarm",
    "timer",
    "stopwatch",
    "time",
    "world clock"
  ],
  "deepLinks": {},
  "testedOn": { "widths": [540], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
