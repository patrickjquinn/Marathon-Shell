import QtQuick
import QtTest
import Keel.Actions 1.0
import Marathon.Platform 1.0
import ".."

TestCase {
    id: testCase

    name: "ClockActions"
    when: windowShown
    visible: true
    width: 540
    height: 1140

    property var app

    Component {
        id: appComponent
        ClockApp {
            width: 540
            height: 1140
        }
    }

    function initTestCase() {
        Alarms.reset();
        Settings.values = {};
        app = appComponent.createObject(testCase);
    }

    function cleanupTestCase() {
        app.destroy();
    }

    function init() {
        app.countdown.reset();
        Alarms.reset();
    }

    function invoke(name, args) {
        const call = KeelActions.invoke(name, args);
        verify(call.succeeded, call.errorMessage);
        return call.result;
    }

    function test_createAndList() {
        const a = invoke("alarms.create", {
            time: "06:45",
            label: " Gym ",
            repeat: [5, 1, 1]
        });
        const b = invoke("alarms.create", {
            time: "22:00"
        });
        verify(a.id !== b.id);
        compare(invoke("alarms.list", {}).result, [
            {
                id: a.id,
                time: "06:45",
                label: "Gym",
                repeat: [1, 5],
                enabled: true
            },
            {
                id: b.id,
                time: "22:00",
                label: "Alarm",
                repeat: [],
                enabled: true
            }
        ]);
    }

    function test_createRefusesBadArguments_data() {
        return [
            {
                tag: "time",
                args: {
                    time: "7:00"
                }
            },
            {
                tag: "day",
                args: {
                    time: "07:00",
                    repeat: [7]
                }
            }
        ];
    }

    function test_createRefusesBadArguments(data) {
        compare(KeelActions.invoke("alarms.create", data.args).errorCode, "InvalidArguments");
        compare(Alarms.alarms.length, 0);
    }

    function test_createFailureIsReported() {
        Alarms.fail = true;
        compare(KeelActions.invoke("alarms.create", {
            time: "07:00"
        }).errorCode, "Failed");
    }

    function test_switch() {
        const id = invoke("alarms.create", {
            time: "07:00"
        }).id;
        invoke("alarms.switch", {
            id: id,
            enabled: false
        });
        compare(Alarms.alarms[0].enabled, false);
        invoke("alarms.switch", {
            id: id,
            enabled: false
        });
        compare(Alarms.alarms[0].enabled, false);
        invoke("alarms.switch", {
            id: id,
            enabled: true
        });
        compare(Alarms.alarms[0].enabled, true);
        compare(KeelActions.invoke("alarms.switch", {
            id: "missing",
            enabled: true
        }).errorCode, "InvalidArguments");
    }

    function test_timer() {
        const before = Date.now();
        const ends = Date.parse(invoke("timer.start", {
            seconds: 90
        }).endsAt);
        verify(app.countdown.running);
        compare(app.countdown.total, 90);
        verify(ends >= before + 90000 && ends <= Date.now() + 90000);
        compare(Alarms.hidden.length, 1);
        compare(KeelActions.invoke("timer.start", {
            seconds: 10
        }).errorCode, "Failed");
        compare(app.countdown.total, 90);
    }

    // keel-actions.json is generated by `keel actions`; it must match the
    // declarations.
    function test_manifestMatchesDeclarations() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../keel-actions.json"), false);
        xhr.send();
        const manifest = JSON.parse(xhr.responseText);
        compare(manifest.appId, "org.marathonos.clock");
        const live = KeelActions.describe();
        const prefix = live.appId + "/";
        const tools = live.tools.map(t => Object.assign({}, t, {
                name: "org.marathonos.clock/" + t.name.substring(prefix.length)
            }));
        compare(JSON.stringify(tools), JSON.stringify(manifest.tools));
    }
}
