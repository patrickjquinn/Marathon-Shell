import QtQuick
import QtTest
import Keel.Actions 1.0
import ".."

TestCase {
    name: "TerminalActions"
    when: windowShown
    visible: true
    width: 540
    height: 1140

    // One app for the case: a second one's actions would be declared twice.
    TerminalApp {
        id: app
        width: 540
        height: 1140
    }

    function test_openStartsANewSession() {
        app.seen = true;
        const before = app.sessions.length;
        const call = KeelActions.invoke("terminal.open", {});
        verify(call.succeeded, call.errorMessage);
        compare(app.sessions.length, before + 1);
        compare(app.currentIndex, before);
        compare(app.currentSession.starts, 1);
        compare(app.currentSession.sent, []);
    }

    function test_openUsesTheUntouchedFirstSession() {
        app.seen = false;
        const before = app.sessions.length;
        verify(KeelActions.invoke("terminal.open", {}).succeeded);
        compare(app.sessions.length, before);
        app.seen = true;
    }

    function test_openTakesNoArguments() {
        compare(KeelActions.invoke("terminal.open", {
            command: "ls"
        }).errorCode, "InvalidArguments");
    }

    // keel-actions.json is generated by `keel actions`; it must match the
    // declarations.
    function test_manifestMatchesDeclarations() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../keel-actions.json"), false);
        xhr.send();
        const manifest = JSON.parse(xhr.responseText);
        compare(manifest.appId, "org.marathonos.terminal");
        const live = KeelActions.describe();
        const prefix = live.appId + "/";
        const tools = live.tools.map(t => Object.assign({}, t, {
                name: "org.marathonos.terminal/" + t.name.substring(prefix.length)
            }));
        compare(JSON.stringify(tools), JSON.stringify(manifest.tools));
    }
}
