{
  "manifestVersion": 1,
  "id": "terminal",
  "name": "Terminal",
  "version": "1.0.0",
  "entryPoint": "TerminalApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["storage", "terminal"],
  "permissionReasons": {
    "storage": "Lets the commands you run read and write your files",
    "terminal": "Runs a shell with your user's access to the system"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["System"],
  "handlesUriSchemes": [],
  "defaultFor": [],
  "searchKeywords": ["terminal", "shell", "command", "bash", "zsh", "console", "cli"],
  "deepLinks": {
    "new-tab": {
      "title": "New Terminal Tab",
      "description": "Open a new terminal tab",
      "keywords": ["new", "tab", "session"]
    }
  },
  "testedOn": { "widths": [540], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
