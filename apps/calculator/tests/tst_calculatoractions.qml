import QtQuick
import QtTest
import Keel.Actions 1.0
import ".."

TestCase {
    name: "CalculatorActions"

    Calculator {
        id: calc
    }

    CalculatorActions {
        calc: calc
    }

    function init() {
        calc.clear();
    }

    function evaluate(expression) {
        return KeelActions.invoke("calc.evaluate", { expression: expression });
    }

    function test_evaluate_data() {
        return [
            { tag: "add", expression: "12 + 3", value: 15, text: "15" },
            { tag: "ascii", expression: "7/2", value: 3.5, text: "3.5" },
            { tag: "keypad signs", expression: "6 × 7 − 2", value: 40, text: "40" },
            { tag: "left to right", expression: "2 + 3 * 4", value: 20, text: "20" },
            { tag: "negative", expression: "-5 + 3", value: -2, text: "-2" },
            { tag: "function after number", expression: "9 sqrt + 1", value: 4, text: "4" },
            { tag: "degrees", expression: "30 sin", value: 0.5, text: "0.5" },
            { tag: "mod", expression: "7 mod 3", value: 1, text: "1" },
            { tag: "grouped", expression: "1000 * 1000", value: 1000000, text: "1,000,000" }
        ];
    }

    function test_evaluate(data) {
        const call = evaluate(data.expression);
        verify(call.succeeded, call.errorMessage);
        fuzzyCompare(call.result.value, data.value, 1e-9);
        compare(call.result.text, data.text);
    }

    function test_evaluateLeavesTheAppAlone() {
        calc.press("8");
        verify(evaluate("1 + 1").succeeded);
        compare(calc.display, "8");
        compare(calc.history.length, 0);
    }

    function test_divideByZeroFails() {
        const call = evaluate("1 / 0");
        compare(call.errorCode, "Failed");
        compare(call.errorMessage, "Can't divide by 0");
    }

    function test_unknownTokenRefused() {
        compare(evaluate("2 ^ 3").errorCode, "InvalidArguments");
        compare(evaluate("ans + 1").errorCode, "InvalidArguments");
    }

    function test_history() {
        for (const k of ["1", "2", "+", "3", "=", "×", "2", "="])
            calc.press(k);
        const call = KeelActions.invoke("calc.history", {});
        verify(call.succeeded, call.errorMessage);
        compare(call.result.result, [{ expression: "12 + 3", value: 15 }, { expression: "15 × 2", value: 30 }]);
    }

    // keel-actions.json is generated by `keel actions`; it must match the
    // declarations.
    function test_manifestMatchesDeclarations() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../keel-actions.json"), false);
        xhr.send();
        const manifest = JSON.parse(xhr.responseText);
        compare(manifest.appId, "org.marathonos.calculator");
        const live = KeelActions.describe();
        const prefix = live.appId + "/";
        const tools = live.tools.map(t => Object.assign({}, t, { name: "org.marathonos.calculator/" + t.name.substring(prefix.length) }));
        compare(JSON.stringify(tools), JSON.stringify(manifest.tools));
    }
}
