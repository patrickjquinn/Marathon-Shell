{
  "manifestVersion": 1,
  "id": "camera",
  "name": "Camera",
  "version": "1.0.0",
  "entryPoint": "CameraApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["camera", "storage"],
  "permissionReasons": {
    "camera": "Takes photos and records videos",
    "storage": "Saves photos and videos to Pictures and DCIM"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Entertainment"],
  "handlesUriSchemes": [],
  "defaultFor": ["camera"],
  "searchKeywords": ["camera", "photo", "video", "capture", "picture"],
  "deepLinks": {},
  "backgroundCapabilities": ["recording"],
  "testedOn": { "widths": [540, 720], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
