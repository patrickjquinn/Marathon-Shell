import QtQuick
import QtTest
import Keel.Actions 1.0
import Marathon.Platform 1.0
import "../CalendarLogic.js" as Logic
import ".."

TestCase {
    name: "CalendarActions"

    CalendarActions {}

    function init() {
        Calendar.reset([
            { id: 1, title: "Standup", date: "2026-10-19", time: "09:30", endTime: "09:45", allDay: false, recurring: "weekly", location: "", description: "" },
            { id: 2, title: "Dentist", date: "2026-10-21", time: "14:00", endTime: "15:00", allDay: false, recurring: "none", location: "High St", description: "bring card" },
            { id: 3, title: "Holiday", date: "2026-10-21", time: "00:00", allDay: true, recurring: "none" }
        ]);
    }

    function list(args) {
        const call = KeelActions.invoke("events.list", args);
        verify(call.succeeded, call.errorMessage);
        return call.result.result;
    }

    function test_listRange() {
        const found = list({ from: "2026-10-19", days: 9 });
        compare(found.map(e => e.id + "@" + e.date), ["1@2026-10-19", "3@2026-10-21", "2@2026-10-21", "1@2026-10-26"]);
        compare(found[2], { id: 2, title: "Dentist", date: "2026-10-21", start: "14:00", end: "15:00", allDay: false, location: "High St", notes: "bring card" });
        compare(found[1].start, undefined);
        compare(found[1].allDay, true);
    }

    function test_listOneDay() {
        compare(list({ from: "2026-10-20" }).length, 0);
        compare(list({ from: "2026-10-21" }).map(e => e.id), [3, 2]);
    }

    function test_listDefaultsToToday() {
        Calendar.reset([{ id: 7, title: "Today", date: Logic.dateKey(new Date()), time: "10:00", allDay: false, recurring: "none" }]);
        compare(list({}).map(e => e.id), [7]);
    }

    function test_listRefusesAMadeUpDay() {
        compare(KeelActions.invoke("events.list", { from: "2026-02-30" }).errorCode, "InvalidArguments");
    }

    function test_createTimed() {
        const call = KeelActions.invoke("events.create", { title: " Lunch ", date: "2026-10-22", start: "12:30", location: "Cafe", notes: "with Ann" });
        verify(call.succeeded, call.errorMessage);
        const e = Calendar.events.find(x => x.id === call.result.id);
        compare(e.title, "Lunch");
        compare(e.date, "2026-10-22");
        compare(e.time, "12:30");
        compare(e.endTime, "13:30");
        compare(e.allDay, false);
        compare(e.reminder, 0);
        compare(e.location, "Cafe");
        compare(e.description, "with Ann");
        compare(list({ from: "2026-10-22" })[0].end, "13:30");
    }

    function test_createWithEnd() {
        const call = KeelActions.invoke("events.create", { title: "Late shift", date: "2026-10-22", start: "22:00", end: "06:00" });
        verify(call.succeeded, call.errorMessage);
        verify(Logic.endsNextDay(Calendar.events.find(x => x.id === call.result.id)));
    }

    function test_createAllDay() {
        const call = KeelActions.invoke("events.create", { title: "Birthday", date: "2026-11-12" });
        verify(call.succeeded, call.errorMessage);
        const e = Calendar.events.find(x => x.id === call.result.id);
        compare(e.allDay, true);
        compare(e.reminder, -1);
    }

    function test_createRefusesBadArguments_data() {
        return [
            { tag: "made-up day", args: { title: "x", date: "2026-02-30" } },
            { tag: "time", args: { title: "x", date: "2026-10-22", start: "25:00" } },
            { tag: "blank title", args: { title: "  ", date: "2026-10-22" } },
            { tag: "no date", args: { title: "x" } }
        ];
    }

    function test_createRefusesBadArguments(data) {
        compare(KeelActions.invoke("events.create", data.args).errorCode, "InvalidArguments");
        compare(Calendar.events.length, 3);
    }

    function test_createFailureIsReported() {
        Calendar.fail = true;
        compare(KeelActions.invoke("events.create", { title: "x", date: "2026-10-22" }).errorCode, "Failed");
    }

    // keel-actions.json is generated by `keel actions`; it must match the
    // declarations.
    function test_manifestMatchesDeclarations() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../keel-actions.json"), false);
        xhr.send();
        const manifest = JSON.parse(xhr.responseText);
        compare(manifest.appId, "org.marathonos.calendar");
        const live = KeelActions.describe();
        const prefix = live.appId + "/";
        const tools = live.tools.map(t => Object.assign({}, t, { name: "org.marathonos.calendar/" + t.name.substring(prefix.length) }));
        compare(JSON.stringify(tools), JSON.stringify(manifest.tools));
    }
}
