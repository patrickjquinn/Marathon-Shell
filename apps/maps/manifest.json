{
  "id": "maps",
  "name": "Maps",
  "version": "1.0.0",
  "entryPoint": "MapsApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["location", "network"],
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Productivity"],
  "handlesUriSchemes": ["geo"],
  "defaultFor": [],
  "searchKeywords": ["maps", "navigation", "location", "directions", "places"],
  "deepLinks": {},
  "backgroundCapabilities": ["active-navigation", "location-tracking"],
  "requiresQtModules": ["webengine"],
  "chromiumFlags": "--use-gl=egl --use-cmd-decoder=validating --disable-webgl2 --disable-features=Vulkan,UseSkiaRenderer,WebGL2 --ignore-gpu-blocklist"
}

