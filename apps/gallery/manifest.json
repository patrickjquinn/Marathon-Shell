{
  "manifestVersion": 1,
  "id": "gallery",
  "name": "Gallery",
  "version": "1.0.0",
  "entryPoint": "GalleryApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["storage"],
  "permissionReasons": {
    "storage": "Shows and deletes the photos and videos in Pictures, Videos and DCIM"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Entertainment"],
  "handlesUriSchemes": [],
  "defaultFor": ["gallery"],
  "searchKeywords": ["gallery", "photos", "images", "pictures", "media"],
  "deepLinks": {},
  "testedOn": { "widths": [540, 720], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
