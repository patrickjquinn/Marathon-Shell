{
  "manifestVersion": 1,
  "id": "notes",
  "name": "Notes",
  "version": "1.0.0",
  "entryPoint": "NotesApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["storage"],
  "permissionReasons": {
    "storage": "Imports the notes the previous Notes app saved"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "categories": ["Productivity"],
  "handlesUriSchemes": [],
  "shareMethods": [
    { "name": "text", "title": "New note", "mimeTypes": ["text/plain", "text/x-url"] }
  ],
  "defaultFor": [],
  "searchKeywords": [
    "notes",
    "memo",
    "text",
    "write",
    "editor",
    "document"
  ],
  "deepLinks": {},
  "testedOn": { "widths": [540], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
