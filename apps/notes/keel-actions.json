{
  "appId": "org.marathonos.notes",
  "entities": [],
  "prompts": [],
  "tools": [
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.create",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "object",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a note in Marathon Notes. The title becomes the note's first line, followed by the body. Returns the new note's id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "description": "Text of the note",
            "maxLength": 20000,
            "type": "string"
          },
          "title": {
            "description": "Title of the note",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/notes.create",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "title": "Create note"
    },
    {
      "_meta": {
        "org.shipwright.keel/action": "notes.search",
        "org.shipwright.keel/confirm": false,
        "org.shipwright.keel/result": "wrapped",
        "org.shipwright.keel/sensitive": false,
        "org.shipwright.keel/timeoutMs": 25000
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search Marathon Notes for text in a note's title or body; an empty query lists every note. Returns up to `limit` notes, pinned first, then the most recently changed, each with its id, title, text (the first 2000 characters) and when it was last changed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "org.marathonos.notes/notes.search",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "id": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "modified": {
                  "format": "date-time",
                  "maxLength": 32,
                  "type": "string"
                },
                "title": {
                  "maxLength": 200,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "body",
                "modified"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "title": "Search notes"
    }
  ],
  "version": 1
}
