import QtQuick
import QtTest
import Sailfish.Silica 1.0
import Marathon.Silica 1.0
import Keel.Actions 1.0
import ".."
import "Fixtures.js" as Fixtures

TestCase {
    name: "StoreActions"
    when: windowShown
    visible: true
    width: 540
    height: 1140

    // One app for the case: a second one's actions would be declared twice.
    StoreApp {
        id: app
        width: 540
        height: 1140
        store: TestBackend {
            property var hits: []
            property string error: ""
            property string searched: ""
            function searchApps(query, cb) {
                searched = query;
                cb(error ? [] : hits, error);
            }
        }
    }

    function init() {
        app.store.hits = [
            Fixtures.app("org.gnome.Maps", "Maps"),
            Fixtures.app("org.example.Chat", "Chat", { "developer_name": undefined }),
            Fixtures.app("../evil", "Evil")
        ];
        app.store.error = "";
        app.store.jobs = {};
        app.store.opened = [];
        tryVerify(() => app.store.installedEntry("org.gnome.Maps") !== null);
        app.pageStack.pop(null, PageStackAction.Immediate);
    }

    function test_search() {
        const call = KeelActions.invoke("apps.search", { query: "maps" });
        verify(call.succeeded, call.errorMessage);
        compare(app.store.searched, "maps");
        compare(call.result.result, [
            { id: "org.gnome.Maps", name: "Maps", summary: "Maps for your phone", developer: "Maps Developers", installed: true },
            { id: "org.example.Chat", name: "Chat", summary: "Chat for your phone", developer: "", installed: false }
        ]);
        compare(KeelActions.invoke("apps.search", { query: "maps", limit: 1 }).result.result.length, 1);
    }

    function test_searchOffline() {
        app.store.error = "timeout";
        compare(KeelActions.invoke("apps.search", { query: "maps" }).errorCode, "Failed");
    }

    function test_show() {
        const call = KeelActions.invoke("apps.show", { id: "org.example.Chat" });
        verify(call.succeeded, call.errorMessage);
        tryCompare(app.pageStack, "depth", 2);
        compare(app.pageStack.currentPage.appId, "org.example.Chat");
        compare(KeelActions.invoke("apps.show", { id: "../evil" }).errorCode, "InvalidArguments");
    }

    function test_install() {
        const call = KeelActions.invoke("apps.install", { id: "org.example.Chat" });
        verify(call.succeeded, call.errorMessage);
        verify(app.store.opened.some(u => u.indexOf("marathon-store://install/org.example.Chat?name=") === 0));
        tryCompare(app.pageStack, "depth", 2);
        compare(app.pageStack.currentPage.appId, "org.example.Chat");
        compare(KeelActions.invoke("apps.install", { id: "org.example.Chat" }).errorMessage, "already being installed");
    }

    function test_installRefused() {
        compare(KeelActions.invoke("apps.install", { id: "org.gnome.Maps" }).errorMessage, "already installed");
        compare(KeelActions.invoke("apps.install", { id: "../evil" }).errorCode, "InvalidArguments");
        compare(app.store.opened.filter(u => u.indexOf("marathon-store://install/") === 0), []);
    }

    // keel-actions.json is generated by `keel actions`; it must match the
    // declarations.
    function test_manifestMatchesDeclarations() {
        const xhr = new XMLHttpRequest();
        xhr.open("GET", Qt.resolvedUrl("../keel-actions.json"), false);
        xhr.send();
        const manifest = JSON.parse(xhr.responseText);
        compare(manifest.appId, "org.marathonos.store");
        const live = KeelActions.describe();
        const prefix = live.appId + "/";
        const tools = live.tools.map(t => Object.assign({}, t, { name: "org.marathonos.store/" + t.name.substring(prefix.length) }));
        compare(JSON.stringify(tools), JSON.stringify(manifest.tools));
    }
}
