{
  "manifestVersion": 1,
  "id": "store",
  "name": "App Store",
  "version": "1.0.0",
  "entryPoint": "StoreApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": [
    "network",
    "system"
  ],
  "permissionReasons": {
    "system": "Installs, updates and removes apps"
  },
  "minShellVersion": "1.0.0",
  "protected": true,
  "searchKeywords": ["apps", "install", "download", "software", "store"],
  "categories": ["System"],
  "backgroundCapabilities": ["download"],
  "testedOn": { "widths": [540, 720], "inputModes": ["touch"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove" }
}
