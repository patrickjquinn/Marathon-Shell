{
  "manifestVersion": 1,
  "id": "email",
  "name": "Mail",
  "version": "1.0.0",
  "entryPoint": "EmailApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["network", "storage", "secret-service"],
  "permissionReasons": {
    "storage": "Saves attachments to Downloads",
    "secret-service": "Keeps your account passwords and sign-in tokens in the keyring"
  },
  "minShellVersion": "1.0.0",
  "protected": false,
  "categories": ["Productivity"],
  "handlesUriSchemes": ["mailto"],
  "defaultFor": ["email"],
  "searchKeywords": [
    "mail",
    "email",
    "inbox",
    "gmail",
    "outlook",
    "fastmail",
    "messages",
    "compose"
  ],
  "deepLinks": {},
  "backgroundCapabilities": ["download", "periodic-sync"],
  "requiresQtModules": [],
  "testedOn": { "widths": [540], "inputModes": ["touch"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "secrets": "remove", "userFiles": "preserve" }
}
