{
  "id": "browser",
  "name": "Browser",
  "version": "1.0.0",
  "entryPoint": "BrowserApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["network", "storage"],
  "minShellVersion": "1.0.0",
  "protected": false,
  "categories": ["Productivity"],
  "handlesUriSchemes": ["http", "https"],
  "defaultFor": ["browser"],
  "searchKeywords": [
    "browser",
    "web",
    "internet",
    "search",
    "url",
    "bookmarks",
    "history",
    "online"
  ],
  "deepLinks": {},
  "requiresQtModules": ["webengine"],
  "chromiumFlags": "--disable-gpu --use-gl=swiftshader --use-cmd-decoder=validating --disable-webgl2 --disable-features=Vulkan,UseSkiaRenderer,WebGL2 --ignore-gpu-blocklist"
}