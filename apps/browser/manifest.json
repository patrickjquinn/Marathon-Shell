{
  "manifestVersion": 1,
  "id": "browser",
  "name": "Browser",
  "version": "1.0.0",
  "entryPoint": "BrowserApp.qml",
  "icon": "assets/icon.svg",
  "author": "Marathon OS",
  "permissions": ["network", "storage"],
  "permissionReasons": {
    "storage": "Imports the bookmarks, history and tabs the previous Browser saved"
  },
  "minShellVersion": "1.0.0",
  "protected": false,
  "categories": ["Productivity"],
  "handlesUriSchemes": ["http", "https"],
  "defaultFor": ["browser"],
  "searchKeywords": [
    "browser",
    "web",
    "internet",
    "search",
    "url",
    "bookmarks",
    "history",
    "online"
  ],
  "deepLinks": {},
  "requiresQtModules": ["webengine"],
  "testedOn": { "widths": [540], "inputModes": ["touch", "keyboard"] },
  "dataLifecycle": { "appData": "remove", "cache": "remove", "userFiles": "preserve" }
}
